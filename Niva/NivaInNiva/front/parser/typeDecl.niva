extend mut Parser [
  /// `name: String`
  on typeFields -> List::TypeField = [
    .peek kind == TokenType.IdentifierColon ifFalse: [^ {}]
    result::mut List::TypeField = {}!

    [
      tok = .peek
      tok kind == TokenType.IdentifierColon ifTrue: [
        .step // skip

        astType = .parseType
        type_field = TypeField name: (tok lexeme) astType: astType
        result add: (type_field)
        .peek kind == TokenType.IdentifierColon
      ] ifFalse: [
        false
      ]
    ] whileTrue: []

    ^ result toList
  ]

  on declarationGenericParams -> List(String) = [
    .match: TokenType.OpenParen, ifFalse: [^ {}]

    params::mut List(String) = {}!
    [
      tok = .matchAssertAnyIdent: "generic param name expected"
      params add: tok lexeme
      .match: TokenType.Comma
    ] whileTrue: []

    .matchAssert: TokenType.CloseParen
    ^ params toList
  ]

  /// type ^name (field1: astType)*
  on typeDeclaration(tok): Token -> TypeDecl = [
    nameTok = .step

    res = TypeDecl
      name: nameTok lexeme
      genericParams: (.declarationGenericParams)
      fields: (.typeFields)
      token: tok
    ^ res
  ]
  /// union name = (| (field1: astType)*)*
  /// union Color = Red | Blue | Green
  /// union Car genericField = Foo field1: Int | Bar field2: Int
  /// union Vehicle = ^Car | Plane
  on unionTypeDeclaration(tok): Token -> UnionDecl = [
    name = .step lexeme
    genericParams = .declarationGenericParams
    commonUnionFields = .typeFields

    .matchAssert: TokenType.Assign
    .matchString: "|" // first optional pipe

    branches:: mut List::UnionBranch = {}
    [
      mut isInclude = false
      .peek kind == TokenType.Return ifTrue: [
        .step // consume ^
        isInclude <- true
      ]

      .peek kind == TokenType.Identifier ifTrue: [
        nameTok = .step
        fields = .typeFields
        branch = UnionBranch
          name: nameTok lexeme
          fields: fields
          isInclude: isInclude
          token: nameTok
        branches add: branch
        .match: TokenType.If
      ] ifFalse: [
        false
      ]
    ] whileTrue: []



    res = UnionDecl name: name genericParams: genericParams commonUnionFields: commonUnionFields branches: branches token: tok


    ^ res
  ]

]
