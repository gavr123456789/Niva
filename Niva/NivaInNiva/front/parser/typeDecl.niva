extend mut Parser [
  /// `name: String`
  on typeFields -> List::TypeField = [
    result::mut List::TypeField = {}!

    this peek kind == TokenType.IdentifierColon ifTrue: [
      [
        tok = this peek
        tok kind == TokenType.IdentifierColon ifTrue: [
          this step // skip

          astType = this parseType
          type_field = TypeField name: (tok lexeme) astType: astType
          result add: (type_field)
          this peek kind == TokenType.IdentifierColon
        ] ifFalse: [
          false
        ]
      ] whileTrue: []
    ]

    result toList
  ]

  on declarationGenericParams -> List(String) = [
    params::mut List(String) = {}!
    this match: TokenType.OpenParen, ifTrue: [
      [
        tok = this matchAssertAnyIdent: "generic param name expected"
        params add: tok lexeme
        this match: TokenType.Comma
      ] whileTrue: []

      this matchAssert: TokenType.CloseParen
    ]
    params toList
  ]

  /// type ^name (field1: astType)*
  on typeDeclaration(tok): Token -> TypeDecl = [
    nameTok = this step

    res = TypeDecl
      token: tok
      name: nameTok lexeme
      genericParams: (this declarationGenericParams)
      fields: (this typeFields)
    ^ res
  ]

  /// enum Color = Red | Green | Blue
  on enumDeclaration(tok): Token -> EnumDecl = [
    nameTok = this step
    this matchAssert: TokenType.Assign

    values::mut List(String) = {}!
    firstValue = this matchAssertAnyIdent: "name of the enum value expected"
    values add: firstValue lexeme

    [
      this match: TokenType.If, ifTrue: [
        valueTok = this matchAssertAnyIdent: "name of the enum value expected"
        values add: valueTok lexeme
        true
      ] ifFalse: [
        false
      ]
    ] whileTrue: []

    ^ EnumDecl token: tok name: nameTok lexeme values: values toList
  ]

  /// union name = (| (field1: astType)*)*
  /// union Color = Red | Blue | Green
  /// union Car genericField = Foo field1: Int | Bar field2: Int
  /// union Vehicle = ^Car | Plane
  on unionTypeDeclaration(tok): Token -> UnionDecl = [
    name = this step lexeme
    genericParams = this declarationGenericParams
    commonUnionFields = this typeFields

    this matchAssert: TokenType.Assign
    this matchString: "|" // first optional pipe

    branches:: mut List::UnionBranch = {}
    [
      mut isInclude = false
      this peek kind == TokenType.Return ifTrue: [
        this step // consume ^
        isInclude <- true
      ]

      this peek kind == TokenType.Identifier ifTrue: [
        nameTok = this step
        fields = this typeFields
        branch = UnionBranch
          name: nameTok lexeme
          fields: fields
          isInclude: isInclude
          token: nameTok
        branches add: branch
        this match: TokenType.If
      ] ifFalse: [
        false
      ]
    ] whileTrue: []



    res = UnionDecl token: tok name: name genericParams: genericParams commonUnionFields: commonUnionFields branches: branches


    ^ res
  ]

]
