

// type itself + number of flags
type TypeInfo t: NivaType isMut: Bool listOfErrors: List::NivaType

extend TypeInfo [
  on toString =
    t toString +
      (| isMut | true => " mut" |=> "") +
      (listOfErrors isEmpty ifTrue: [""] ifFalse: [" !{" + (listOfErrors joinWith: " " transform: [it name]) + "}"])
]

NivaType toTypeInfoDefault -> TypeInfo = [^ TypeInfo t: this isMut: false listOfErrors: {}!]
// constructor TypeInfo default: t::NivaType =
//   TypeInfo :t isMut: false

type MatchBranchT
  condition: TypedExpr2
  additionalConditions: TypedBody
  body: TypedBody

enum AssignKind = TO_THIS_FIELD | TO_LOCAL_MUT

type DestructureBindingT
  localName: String
  fieldName: String
  isUsed: Bool

union TypedExpr2 token: Token typeInfo: TypeInfo =
| ^LiteralExprT
| IdentifierT        name: String path: List?(String) isNameOfTheType: Bool
| ExprInBracketsT    value: TypedExpr2
| VarDeclarationT    name: String value: TypedExpr2 astType: AstType2? isMut: Bool isUsed: Bool
| AssignT            name: String value: TypedExpr2 kind: AssignKind
| DestructingAssignT bindings: List(DestructureBindingT) value: TypedExpr2 // {name} = person, {local = field} = person

| ^CollectionLiteralT
| ^MessageSendT
| ReturnStatementT   value: TypedExpr2?
// only one of the lists can be non empty
// [a, b -> a + b] has `untyped args`, but not `args`
// [a::Int, b::Int -> a + b] // the opposite
| CodeBlockT args: List(NameAndAstType) typedArgs: List(IdentifierT) body: TypedBody
| MatchT
  subject: TypedExpr2
  branches: List(MatchBranchT)
  elseBranch: TypedBody? // possible body

IdentifierT toString -> String = [
    pathMaybe = path
    pathStr = | pathMaybe
      | null => ""
      |=> pathMaybe toString
    isType = isNameOfTheType ifTrue: [" (Type)"] ifFalse: [""]
    ^ pathStr + name + isType
]

type NameAndExprT name: Identifier expr: TypedExpr2 dbMsg: NivaMethod?

type TypedBody
  v: List(TypedExpr2)
  t: NivaType
  listOfErrors: List::NivaType

// brackets only group, (x) is x
TypedExpr2 withoutBrackets -> TypedExpr2 =
  | this
  | ExprInBracketsT => value withoutBrackets
  |=> this

TypedBody containsNonLocalReturn -> Bool = [
  v any: [it containsNonLocalReturn]
]

TypedExpr2 containsNonLocalReturn -> Bool = [
  | this
  | ReturnStatementT => true
  | CodeBlockT => false
  | ExprInBracketsT => value containsNonLocalReturn
  | VarDeclarationT => value containsNonLocalReturn
  | AssignT => value containsNonLocalReturn
  | DestructingAssignT => value containsNonLocalReturn
  | CollectionLiteralT => elements containsNonLocalReturn
  | MatchT => [
    mut found = subject containsNonLocalReturn
    branches forEach: [branch ->
      found ifFalse: [
        found <- branch condition containsNonLocalReturn
        found ifFalse: [found <- branch additionalConditions containsNonLocalReturn]
        found ifFalse: [found <- branch body containsNonLocalReturn]
      ]
    ]
    elseBranchMaybe = elseBranch
    found ifFalse: [
      | elseBranchMaybe
      | null => []
      |=> found <- elseBranchMaybe containsNonLocalReturn
    ]
    found
  ]
  | MessageSendT => [
    mut found = receiver containsNonLocalReturn
    inlineCall = dbMsg isInline
    visitArgument = [argExpr::TypedExpr2 ->
      found ifFalse: [
        | argExpr
        | CodeBlockT => inlineCall ifTrue: [found <- argExpr body containsNonLocalReturn]
        |=> found <- argExpr containsNonLocalReturn
      ]
    ]
    visitArgument argExpr: receiver
    | this
    | BinaryMsgT => args forEach: [arg -> visitArgument argExpr: arg expr]
    | KeywordMsgT => args forEach: [arg -> visitArgument argExpr: arg expr]
    |=> []
    found
  ]
  |=> false
]

TypedBody collectNonLocalReturnTypesInto(returns): mut List(NivaType) -> Unit = [
  v forEach: [expr ->
    | expr
    | ReturnStatementT => [
      valueMaybe = expr value
      | valueMaybe
      | null => [
        returns add: (expr typeInfo t)
        ()
      ]
      |=> [
        returns add: (valueMaybe typeInfo t)
        valueMaybe collectNonLocalReturnTypesInto: returns
      ]
    ]
    |=> expr collectNonLocalReturnTypesInto: returns
  ]
]

TypedExpr2 collectNonLocalReturnTypesInto(returns): mut List(NivaType) -> Unit = [
  | this
  | ReturnStatementT => [
    valueMaybe = value
    | valueMaybe
    | null => []
    |=> valueMaybe collectNonLocalReturnTypesInto: returns
  ]
  | CodeBlockT => []
  | ExprInBracketsT => value collectNonLocalReturnTypesInto: returns
  | VarDeclarationT => value collectNonLocalReturnTypesInto: returns
  | AssignT => value collectNonLocalReturnTypesInto: returns
  | DestructingAssignT => value collectNonLocalReturnTypesInto: returns
  | CollectionLiteralT => elements collectNonLocalReturnTypesInto: returns
  | MatchT => [
    subject collectNonLocalReturnTypesInto: returns
    branches forEach: [branch ->
      branch condition collectNonLocalReturnTypesInto: returns
      branch additionalConditions collectNonLocalReturnTypesInto: returns
      branch body collectNonLocalReturnTypesInto: returns
    ]
    elseBranchMaybe = elseBranch
    | elseBranchMaybe
    | null => []
    |=> elseBranchMaybe collectNonLocalReturnTypesInto: returns
  ]
  | MessageSendT => [
    inlineCall = dbMsg isInline
    visitArgument = [argExpr::TypedExpr2 ->
      | argExpr
      | CodeBlockT => inlineCall ifTrue: [argExpr body collectNonLocalReturnTypesInto: returns]
      |=> argExpr collectNonLocalReturnTypesInto: returns
    ]
    visitArgument argExpr: receiver
    | this
    | BinaryMsgT => args forEach: [arg -> visitArgument argExpr: arg expr]
    | KeywordMsgT => args forEach: [arg -> visitArgument argExpr: arg expr]
    |=> []
  ]
  |=> []
]

type NameAndTypeInfo name: String typeInfo: TypeInfo

type TypeFieldT name: String typeInfo: TypeInfo

type UnionBranchT
  name: String
  fields: List::TypeFieldT
  isInclude: Bool
  token: Token

union TypedDeclaration token: Token =
| TypeDeclT name: String genericParams: List(String) fields: List::TypeFieldT
| EnumDeclT name: String values: List(String)
| UnionDeclT
  name: String
  genericParams: List(String)
  commonUnionFields: List::TypeFieldT
  branches: List::UnionBranchT
| ExtendDeclT
  receiver: NivaType
  messages: List::MessageDeclT
| MessageDeclT
  receiver: NivaType
  name: String
  args: List::NameAndTypeInfo
  returnType: TypeInfo
  body: TypedBody
  isSingleExpr: Bool
  isConstructor: Bool

union TypedStatement token: Token =
| ^TypedExpr2
| ^TypedDeclaration


union LiteralExprT token: Token typeInfo: TypeInfo =
| CharExprT
| IntExprT
| FloatExprT
| DoubleExprT
| StringExprT
| BooleanExprT
| NullExprT
| UnitExprT
| AtomExprT name: String // #red -> name = "red"


union CollectionLiteralT token: Token elements: TypedBody typeInfo: TypeInfo =
| ListLiteralT
| SetLiteralT
| MapLiteralT



union MessageSendT receiver: TypedExpr2 token: Token typeInfo: TypeInfo dbMsg: NivaMethod =
// args: List::NameAndExpr // expr and name are the same Identifiers, this is done to be able to replace exprs with typed ones
| UnaryMsgT
  selector: Identifier // no need for type here
  kind: MessageSendKind
| BinaryMsgT
  args: List(NameAndExprT) // expr - Primary or UnaryMsg
| KeywordMsgT
  args: List(NameAndExprT) // expr - Primary or UnaryMsg or BinaryMsg
  kind: MessageSendKind
