
type KeywordDeclParts
  args: List::NameAndAstType
  nameParts: List(String)

type KeywordDeclArg
  arg: NameAndAstType
  namePart: String

// optional return arrow of a message declaration
mut Parser messageDeclReturnType -> AstType2? = [
  ^ this match: TokenType.ReturnArrow, ifTrue: [this parseType] ifFalse: [null]
]

// optional `^` right before `=` marks a message declaration as inline
mut Parser messageDeclInline -> Bool =
  this match: TokenType.Return, ifTrue: [true] ifFalse: [false]

// read the body and build the declaration while the caller handles the assign
mut Parser messageDeclFrom(tok): Token receiver: AstType2 name: String args: List(NameAndAstType) returnType: AstType2? isConstructor: Bool isInline: Bool -> MessageDecl = [
  isSingleExpr = this peek kind != TokenType.OpenBracket
  body = this parseBodyOrSingleExpr
  ^ MessageDecl
    token: tok
    receiver: receiver
    name: name
    args: args
    returnType: returnType
    body: body
    isSingleExpr: isSingleExpr
    isConstructor: isConstructor
    isInline: isInline
]

mut Parser
  messageDeclarationOrExpression(tok): Token
  savedPosition(savePosition): Int
  isConstructor: Bool -> Statement = [

  // change current position back to parse receiver
  this stepBack
  receiverType = this parseType

  // Int^ inc =
  // Int^ a::Int b::Int =
  // Int^ a: q::Int b::Int =
  // Int^ + a::Int =
  tok2 = this step
  result::Statement = | tok2 kind
  | TokenType.Identifier|TokenType.IdentifierDoubleColon|TokenType.IdentifierColon => [
    // Int inc^ ->? = []
    // Int inc^::Int b::Int =
    kwSavePoint = this current
    kwParts = this parseKeywordDeclArgsFrom: tok2
    kwPartsMaybe = kwParts
    kwParts == null ifTrue: [
      tok2 kind == TokenType.Identifier ifFalse: [
        this restoreFrom: savePosition
        ^ this nextExpression: this step
      ]
      this restoreFrom: kwSavePoint
      returnType = this messageDeclReturnType
      name = tok2 lexeme
      isInline = this messageDeclInline

      this match: TokenType.Assign, ifFalse: [
        this restoreFrom: savePosition
        ^ this nextExpression: this step
      ]
      // Int inc ->? = ^[]
      this messageDeclFrom: tok receiver: receiverType name: name args: {} returnType: returnType isConstructor: isConstructor isInline: isInline
    ] ifFalse: [
      kwParts2 = kwPartsMaybe expect: "Expected keyword declaration arguments"
      returnType = this messageDeclReturnType
      isInline = this messageDeclInline

      this match: TokenType.Assign, ifFalse: [
        this restoreFrom: savePosition
        ^ this nextExpression: this step
      ]

      kwName = kwParts2 nameParts joinWith: "__" transform: [
        it
      ]
      this messageDeclFrom: tok receiver: receiverType name: kwName args: kwParts2 args returnType: returnType isConstructor: isConstructor isInline: isInline
    ]
  ]
  | TokenType.BinarySymbol => [
    // Int +^ a::Int -> Int=

    // if its not binary declaration then parse expression
    arg = this step
    isArgName =
      (arg kind == TokenType.IdentifierDoubleColon) ||
      (arg kind == TokenType.IdentifierColon)
    isArgName ifFalse: [
      this restoreFrom: savePosition
      ^this nextExpression: this step
    ]
    argType = this parseType


    returnType = this messageDeclReturnType
    name = tok2 lexeme
    isInline = this messageDeclInline

    this matchAssert: TokenType.Assign
    // Int inc ->? = ^[]

    this messageDeclFrom: tok
      receiver: receiverType
      name: name
      args: {(NameAndAstType name: arg lexeme astType: argType)}
      returnType: returnType
      isConstructor: isConstructor
      isInline: isInline
  ]
  |=> [
    this restoreFrom: savePosition
    ^this nextExpression: this step
  ]

  ^ result
]

extend mut Parser [
  on parseConstructorGroup(tok): Token -> ExtendDecl = [
    receiverType = this parseType
    this matchAssert: TokenType.OpenBracket

    decls::mut List::MessageDecl = {}!
    [
      this peek kind == TokenType.CloseBracket ifTrue: [
        this step
        false
      ] ifFalse: [
        onTok = this matchAssert: TokenType.On
        decls add: (this parseMessageDeclForReceiver: receiverType token: onTok isConstructor: true)
        true
      ]
    ] whileTrue: []

    ^ ExtendDecl token: tok receiver: receiverType messages: decls toList
  ]

  on parseExtendBlock(tok): Token -> ExtendDecl = [
    receiverType = this parseType

    this matchAssert: TokenType.OpenBracket

    decls::mut List::MessageDecl = {}!
    [
      this peek kind == TokenType.CloseBracket ifTrue: [
        this step
        false
      ] ifFalse: [
        onTok = this matchAssert: TokenType.On
        decls add: (this parseMessageDeclForReceiver: receiverType token: onTok isConstructor: false)
        true
      ]
    ] whileTrue: []

    ^ ExtendDecl token: tok receiver: receiverType messages: decls toList
  ]

  on parseMessageDeclForReceiver(receiverType): AstType2 token: Token isConstructor: Bool -> MessageDecl = [
    tok2 = this step
    result = | tok2 kind
    | TokenType.Identifier => [
      kwSavePoint = this current
      kwParts = this parseKeywordDeclArgsFrom: tok2

      | kwParts
      | null => [
        this restoreFrom: kwSavePoint
        returnType = this messageDeclReturnType
        name = tok2 lexeme
        isInline = this messageDeclInline

        this matchAssert: TokenType.Assign
        this messageDeclFrom: token
          receiver: receiverType
          name: name
          args: {}
          returnType: returnType
          isConstructor: isConstructor
          isInline: isInline
      ]
      |=> [
        returnType = this messageDeclReturnType
        isInline = this messageDeclInline

        this matchAssert: TokenType.Assign

        kwName = kwParts nameParts joinWith: "__" transform: [
          it
        ]
        this messageDeclFrom: token
          receiver: receiverType
          name: kwName
          args: kwParts args
          returnType: returnType
          isConstructor: isConstructor
          isInline: isInline
      ]
    ]
    | TokenType.IdentifierDoubleColon | TokenType.IdentifierColon => [
      kwParts = this parseKeywordDeclArgsFrom: tok2
      kwParts == null ifTrue: [
        ^ TO DO: "keyword message declaration expected after `on`"
      ]
      kwPartsMaybe = kwParts
      kwParts2 = kwPartsMaybe expect: "Expected keyword declaration arguments"

      returnType = this messageDeclReturnType
      isInline = this messageDeclInline

      this matchAssert: TokenType.Assign

      kwName = kwParts2 nameParts joinWith: "__" transform: [
        it
      ]
      this messageDeclFrom: token
        receiver: receiverType
        name: kwName
        args: kwParts2 args
        returnType: returnType
        isConstructor: isConstructor
        isInline: isInline
    ]
    | TokenType.BinarySymbol => [
      arg = this step
      isArgName =
        (arg kind == TokenType.IdentifierDoubleColon) ||
        (arg kind == TokenType.IdentifierColon)
      isArgName ifFalse: [
        ^ TO DO: "binary message declaration expected after `on`"
      ]
      argType = this parseType

      returnType = this messageDeclReturnType
      name = tok2 lexeme
      isInline = this messageDeclInline

      this matchAssert: TokenType.Assign

      args = {(NameAndAstType name: arg lexeme astType: argType)}
      this messageDeclFrom: token
        receiver: receiverType
        name: name
        args: args
        returnType: returnType
        isConstructor: isConstructor
        isInline: isInline
    ]
    |=> [
      TO DO: "message declaration expected after `on`"
    ]

    ^ result
  ]

  on isTypeStartToken(tok): Token -> Bool =
    | tok kind
    | TokenType.Identifier
    | TokenType.IdentifierDoubleColon
    | TokenType.NullableIdentifier
    | TokenType.Mut
    | TokenType.OpenBracket => true
    |=> false


  on parseKeywordDeclArgsFrom(firstTok): Token -> KeywordDeclParts? = [
    args::mut List::NameAndAstType = {}!
    nameParts::mut List(String) = {}!

    firstArg = this parseKeywordDeclArgFrom: firstTok
    firstArg == null ifTrue: [^ null]
    firstArgMaybe = firstArg
    firstArg2 = firstArgMaybe expect: "Expected first keyword declaration argument"
    args add: firstArg2 arg
    nameParts add: firstArg2 namePart

    [
      nextArg = this tryParseKeywordDeclArg
      nextArg == null ifTrue: [
        false
      ] ifFalse: [
        nextArgMaybe = nextArg
        nextArg2 = nextArgMaybe expect: "Expected keyword declaration argument"
        args add: nextArg2 arg
        nameParts add: nextArg2 namePart
        true
      ]
    ] whileTrue: []

    ^ KeywordDeclParts args: args toList nameParts: nameParts toList
  ]

  on tryParseKeywordDeclArg -> KeywordDeclArg? = [
    savePoint = current
    tok = this step
    arg = this parseKeywordDeclArgFrom: tok
    | arg
    | null => [
      this restoreFrom: savePoint
      null
    ]
    |=> arg
  ]

  // shared tail for parsing a keyword arg with known type
  on parseTypedKeywordDeclArg(name): String namePart: String -> KeywordDeclArg? = [
    isTypeStart = this isTypeStartToken: this peek
    isTypeStart ifFalse: [^ null]
    argType = this parseType
    KeywordDeclArg
      arg: (NameAndAstType name: name astType: argType)
      namePart: namePart
  ]

  on parseKeywordDeclArgFrom(tok): Token -> KeywordDeclArg? = [
    ^| tok kind
    | TokenType.IdentifierDoubleColon => [
      externalName = tok lexeme
      this parseTypedKeywordDeclArg: externalName namePart: externalName
    ]
    | TokenType.IdentifierColon => [
      externalName = tok lexeme
      nextTok = this peek
      mut isOldRename = false
      nextTok kind == TokenType.IdentifierDoubleColon ifTrue: [
        localName = nextTok lexeme
        firstChar = localName at: 0
        isOldRename <- (firstChar isLowerCase) || (firstChar == '_')
      ]

      isOldRename ifTrue: [
        localTok = this step
        this parseTypedKeywordDeclArg: (localTok lexeme) namePart: externalName
      ] ifFalse: [
        this parseTypedKeywordDeclArg: externalName namePart: externalName
      ]
    ]
    | TokenType.Identifier => [
      externalName = tok lexeme

      mut ok = this match: TokenType.OpenParen
      mut localTok = Token eof
      ok ifTrue: [
        localTok <- this peek
        ok <- (localTok kind == TokenType.Identifier)
        ok ifTrue: [
          this step
          ok <- (this match: TokenType.CloseParen) && (this match: TokenType.Colon)
          ok <- ok && (this isTypeStartToken: this peek)
        ]
      ]

      ok ifTrue: [
        this parseTypedKeywordDeclArg: (localTok lexeme) namePart: externalName
      ] ifFalse: [
        null
      ]
    ]
    |=> [
      null
    ]
  ]
]
