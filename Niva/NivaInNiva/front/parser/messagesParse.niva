extend mut Parser [

  /// inc inc inc
  on parseManyIdentSeparated(sep): TokenType? -> mut List(Identifier) = [
    result::mut List(Identifier) = {}!

    [
      tok = this peek

      | tok kind
      | TokenType.Identifier => [
        // stop if new unary on new line
        result isNotEmpty && (tok line > result last token line), ifTrue: [
          false
        ] ifFalse: [
          identifier = this step
          expr = (this parseDotSeparatedIdentifier: tok)
          result add: expr
          sepMaybe = sep
          | sepMaybe
          | null => false
          |=> this match: sepMaybe
          true
        ]
      ]
      |=> [
        false
      ]
    ] whileTrue: []
    ^ result
  ]

  /// + 2 inc inc + 3 dec dec
  on parseManyBinary -> List(NameAndExpr) = [
      result::mut List(NameAndExpr) = {}!
      [
        tok = this peek
        | tok kind
        | TokenType.BinarySymbol => [
          binarySymbol = this step
          rhsTok = this step
          receiver =
            | rhsTok kind
            | TokenType.OpenParen => [
              inner = this nextExpression: this step
              this matchAssert: TokenType.CloseParen
              ExprInBrackets token: rhsTok value: inner
            ]
            |=> [
              primaryMaybe = this primary: rhsTok
              | primaryMaybe
              | null => TO DO: "Cant find primary"
              |=> primaryMaybe
            ]
          unaryList = this peek line == receiver token line, ifTrue: [
            this parseManyIdentSeparated: null
          ] ifFalse: [{}!]


          unaryList isEmpty, ifTrue: [
            binSymbol = Identifier fromToken: binarySymbol
            result add: (NameAndExpr name: (binSymbol) expr: receiver)
          ] ifFalse: [
            args = unaryList map: [
              NameAndExpr name: it expr: it
            ]
            mut tempUnary = UnaryMsg
              :receiver
              token: tok
              selector: unaryList first
              kind: MessageSendKind.Call

            unaryList drop: 1, forEach: [
              newUnary = UnaryMsg
                receiver: tempUnary
                token: tok
                selector: it
                kind: MessageSendKind.Call
              tempUnary <- newUnary
            ]

            unary = tempUnary

            binSymbol = Identifier fromToken: binarySymbol
            result add: (NameAndExpr name: (binSymbol) expr: unary)
          ]

          true
        ]
        |=> [
          false
        ]
      ] whileTrue: []
      ^ result toList
    ]
]
