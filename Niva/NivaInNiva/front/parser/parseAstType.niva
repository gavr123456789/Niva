extend mut Parser [
  on parseTypeErrors -> AstTypeErrors? = [
    | true
    | (this match: TokenType.Bang) not => null
    |=> [
      this match: TokenType.OpenBrace, ifTrue: [
        names::mut List(String) = {}!
        [
          tok = this peek
          tok kind == TokenType.CloseBrace ifTrue: [
            false
          ] ifFalse: [
            nameTok = this matchAssertAnyIdent: "error name expected"
            names add: nameTok lexeme
            this match: TokenType.Comma
            true
          ]
        ] whileTrue: []

        names isEmpty ifTrue: [TO DO: "error list cannot be empty"]
        this matchAssert: TokenType.CloseBrace
        AstTypeErrors kind: AstTypeErrorsKind.List names: names toList
      ] ifFalse: [
        tok = this peek
        tok isIdentifier ifTrue: [
          nameTok = this step
          AstTypeErrors kind: AstTypeErrorsKind.Single names: {(nameTok lexeme)}!
        ] ifFalse: [
          AstTypeErrors kind: AstTypeErrorsKind.Any names: {}
        ]
      ]
    ]
  ]

  /// List::Set::Int
  /// Map(String, Int)
  /// identifier ("(" | "::")
  /// Int!{Err1, Err2}
  /// Int!
  /// Int!Err1
  on parseGenericType -> AstType2 = [

    isMut = this match: TokenType.Mut
    pos = this peek toPosition
    identifier = this matchAssertAnyIdent: "in type declaration identifier expected, but got " + this peek toString + "\n" + pos
    mut isNullable::Bool = identifier kind == TokenType.NullableIdentifier
    name = identifier lexeme


    genericParams::mut List(AstType2) = {}!
    isListLike = identifier kind == TokenType.IdentifierDoubleColon
    isListLike ifTrue: [genericParams add: this parseGenericType]

    isMapLike = isListLike not && (this match: TokenType.OpenParen)
    isMapLike ifTrue: [
      [
        genericParams add: this parseGenericType
        this match: TokenType.Comma
      ] whileTrue: []
      this matchAssert: TokenType.CloseParen
    ]

    // nullable suffix after generic params so List(Int)? parses
    (this peek lexeme == "?") ifTrue: [
      isNullable <- true
      this step
    ]

    AstType
        tok: identifier
        name: name
        isNullable: isNullable
        genericParams: genericParams toList
        isMut: isMut
        errors: this parseTypeErrors
  ]

  on parseType -> AstType2 = [
    itLambda = this match: TokenType.OpenBracket

    itLambda
        ifTrue: [
          // [Int, String -> Int]
          // [ -> ]

          args::mut List(AstType2) = {}!

          // skip the loop when there are no args so empty lambda types parse
          (this peek kind != TokenType.ReturnArrow) ifTrue: [
          [ argType = this parseGenericType
            args add: argType
            this match: TokenType.Comma
          ] whileTrue: []
          ]

          this matchAssert: TokenType.ReturnArrow
          returnType = this parseType
          lastBracketTok = this matchAssert: TokenType.CloseBracket
          AstLambdaType tok: lastBracketTok name: "[$args -> ]" args: args toList returnType: returnType
        ]
        ifFalse: [this parseGenericType]

  ]
]
