Test parseType -> Unit = [
  input = """
    type Person
      name: String
      age: Int
      intList: List(Int)
      nullableInt: Int?
      lambdaType: [Int -> Int]
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  typeDecl = statements at: 0, asTypeDecl
  Assert that: typeDecl name equals: "Person"
  Assert that: typeDecl fields count equals: 5

  name = typeDecl fields at: 0
  age = typeDecl fields at: 1
  intList = typeDecl fields at: 2
  nullableInt = typeDecl fields at: 3
  lambda = typeDecl fields at: 4

  Assert that: name name equals: "name"
  Assert that: age name equals: "age"
  Assert that: intList name equals: "intList"
  Assert that: nullableInt name equals: "nullableInt"

  Assert that: ((name astType) asAstType) name equals: "String"
  Assert that: ((age astType) asAstType) name equals: "Int"

  listType = (intList astType) asAstType
  Assert that: listType name equals: "List"
  Assert that: listType genericParams count equals: 1
  Assert that: listType isNullable equals: false
  Assert that: ((listType genericParams at: 0) asAstType) name equals: "Int"

  nullableType = (nullableInt astType) asAstType
  Assert that: nullableType name equals: "Int"
  Assert that: nullableType isNullable equals: true

  lambdaType = (lambda astType) asAstLambdaType
  Assert that: lambdaType args count equals: 1
  Assert that: lambdaType returnType name equals: "Int"
]

Test parseTypeWithNoFields -> Unit = [
  input = """
    type Person
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  typeDecl = statements at: 0, asTypeDecl
  Assert that: typeDecl name equals: "Person"
  Assert that: typeDecl fields count equals: 0
]

Test parseUnion -> Unit = [
  input = """
    union Color = Red | Blue | Green

    union Figure size: Int =
    | Circle r: Int
    | Rectangle width: Int heigth: Int


  """ trimIndent

  statements = TestParse withInput: input expectedCount: 2
  keyword = statements at: 0, asUnionDecl
]

Test parseEnum -> Unit = [
  input = """
    enum Color = Red | Blue | Green
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  enumDecl = statements first asEnumDecl
  Assert that: enumDecl name equals: "Color"
  Assert that: enumDecl values equals: {"Red" "Blue" "Green"}
]

Test parseTypeDeclarationGenerics -> Unit = [
  input = """
    type Box(T, G) x: T y: G
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  typeDecl = statements at: 0, asTypeDecl
  Assert that: typeDecl name equals: "Box"
  Assert that: typeDecl genericParams count equals: 2
  Assert that: (typeDecl genericParams at: 0) equals: "T"
  Assert that: (typeDecl genericParams at: 1) equals: "G"
  Assert that: typeDecl fields count equals: 2
]

Test parseUnionDeclarationGenerics -> Unit = [
  input = """
    union Result(T) =
    | Ok t: T
    | Baad x: T
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  unionDecl = statements at: 0, asUnionDecl
  Assert that: unionDecl name equals: "Result"
  Assert that: unionDecl genericParams count equals: 1
  Assert that: (unionDecl genericParams first) equals: "T"
  Assert that: unionDecl branches count equals: 2
]


Test parseUnaryConstructor -> Unit = [
  input = """
    constructor Int theAnswer = 42
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  cnstr = statements at: 0, asMessageDecl
  Assert that: cnstr isConstructor equals: true
]

Test parseUnaryDecl -> Unit = [
  input = """
    Int inc -> Bool = [
      1
    ]
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  unaryDecl = statements at: 0, asMessageDecl
  Assert that: unaryDecl name equals: "inc"
  Assert that: unaryDecl args count equals: 0
  receiver = (unaryDecl receiver) asAstType
  Assert that: receiver name equals: "Int"
  Assert that: (unaryDecl returnType) toString equals: "Bool"
]

Test parseBinaryDecl -> Unit = [
  input = """
    Int + inc::String -> Bool = [
      1
    ]
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  binary = statements at: 0, asMessageDecl
  Assert that: binary name equals: "+"
  Assert that: binary args count equals: 1
  receiver = (binary receiver) asAstType
  Assert that: receiver name equals: "Int"
  Assert that: (binary returnType) toString equals: "Bool"
]

Test parseKeywordDecl -> Unit = [
  input = """
    Int from::Int to::Int -> Bool = [
      true
    ]
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  keyword = statements at: 0, asMessageDecl
  Assert that: keyword name equals: "from__to"
  Assert that: keyword args count equals: 2
  receiver = (keyword receiver) asAstType
  Assert that: receiver name equals: "Int"
  Assert that: (keyword returnType) toString equals: "Bool"
]

Test parseRealWorldExample -> Unit = [
  input = """

    type Person name: String age: Int
    Person sleep = "hii" echo

  """ trimIndent

  statements = TestParse withInput: input expectedCount: 2
  keyword = statements at: 0, asTypeDecl
]


Test parseKeywordDeclWithBody -> Unit = [
  input = """
    Money make: Int sas: String -> Int = [
      x = 42
      1 inc
      2 dec
    ]
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  kwDecl = statements at: 0, asMessageDecl
  receiver = (kwDecl receiver) asAstType
  Assert that: receiver name equals: "Money"
  Assert that: (kwDecl returnType) toString equals: "Int"

  body = kwDecl body unTypedBody
  Assert that: body count equals: 3
  Assert that: ((body at: 0) asVarDeclaration) name equals: "x"
  Assert that: ((body at: 1) asUnaryMsg) selector name equals: "inc"
  Assert that: ((body at: 2) asUnaryMsg) selector name equals: "dec"
]
