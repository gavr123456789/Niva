Test someExpressions -> Unit = [
  input = """
    1 + 2
    1 inc
    1 inc + 2
    1 + 2 inc
    a + b
    a + b inc
    a + b inc + c
    a + b inc + c dec
    a + b inc + c dec * d
    a + b inc + c dec * d / e

    // collections receivers
    {1 2 3} inc
    #{1 2 3 4} from: 5
    #(1 2 3) + #(3 4 5)

    [a b c] do
    [a b c] from: 1 to: 2
    [a b c] + 3
  """ trimIndent
  statements = TestParse withInput: input expectedCount: 16

]

Test pipesAgain = [

  input = """
    1 to: 2, to: 3
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
]

Test pipes = [

  input = """
    1 to: 2, inc echo
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 1
  first = statements at: 0, asUnaryMsg
  Assert that: first selector name equals: "echo"

  receiver = first receiver asUnaryMsg
  keyword = (receiver receiver asExprInBrackets) value asKeywordMsg
  Assert that: keyword args count equals: 1
  arg = keyword args at: 0
  Assert that: arg name token lexeme equals: "to"
  Assert that: arg expr token lexeme equals: "2"
]

Test colonKeyShorthand = [
  msg = (TestParse expression: "obj :name :age") asKeywordMsg
  Assert that: msg args count equals: 2
  Assert that: ((msg args at: 0) name name) equals: "name"
  Assert that: (((msg args at: 0) expr asIdentifier) name) equals: "name"
  Assert that: ((msg args at: 1) name name) equals: "age"
  Assert that: (((msg args at: 1) expr asIdentifier) name) equals: "age"
  Assert that: ((msg receiver asIdentifier) name) equals: "obj"
]

Test colonKeyShorthandMixed = [
  msg = (TestParse expression: "obj :name age: 12") asKeywordMsg
  Assert that: msg args count equals: 2
  Assert that: ((msg args at: 0) name name) equals: "name"
  Assert that: ((msg args at: 1) name name) equals: "age"
  Assert that: ((msg args at: 1) expr asIntExpr) num equals: 12
]

Test pipesMany -> Unit = [
  input = """
    1 to: 2, inc echo
    1 to: 2, inc + 3
    1 to: 2, inc + 3 dec
    1 to: 2, inc + 3 dec * 4

    1 inc, dec
    1 inc, + 2
  """ trimIndent

  statements = TestParse withInput: input expectedCount: 6

]

Test pipedUnaryOnNewLine = [
  input = """
    1 inc,
      inc
  """ trimIndent

  statements = TestParse withInput: input expectedCount: -1
  Assert that: statements count equals: 1

]

Test parseSimbleBinaryMsg -> Unit = [
  msgSend = (TestParse expression: "a + b") asBinaryMsg
  Assert that: msgSend args count equals: 1

  first = msgSend args at: 0
  Assert that: first name token lexeme equals: "+"
  Assert that: (first expr asIdentifier) name equals: "b"
  Assert that: (msgSend receiver asIdentifier) name equals: "a"
]

Test parseRangeToExclusiveMsg -> Unit = [
  msgSend = (TestParse expression: "1..<3") asBinaryMsg
  Assert that: msgSend args count equals: 1

  first = msgSend args at: 0
  Assert that: first name token lexeme equals: "..<"
  Assert that: (first expr asIntExpr) num equals: 3
  Assert that: (msgSend receiver asIntExpr) num equals: 1
]

Test parseBinaryMsgWithUnary -> Unit = [
  msgSend = TestParse expression: "1 + 2 inc"
  Assert that: msgSend toString equals: "IntExpr 1 + UnaryMsg Call(IntExpr 2 inc)"
]

Test parseBinaryMsgWithUnary2 -> Unit = [
  msgSend = (TestParse expression: "1 inc + 2") asBinaryMsg
  Assert that: msgSend args count equals: 1

  first = msgSend args at: 0
  Assert that: first name token lexeme equals: "+"

  // "+ 2" arg
  Assert that: (first expr asIntExpr) num equals: 2

  // "1 inc" receiver
  receiver = msgSend receiver asUnaryMsg
  Assert that: receiver selector name equals: "inc"
  Assert that: (receiver receiver asIntExpr) num equals: 1
]

/// a msg after a multiline primary belongs to it, and is not a new statement
Test parseUnaryAfterMultilineCodeblock -> Unit = [
  input = """
    [
      a = 1
      a echo
    ] do
  """

  statements = TestParse withInput: input expectedCount: 1

  first = statements at: 0, asUnaryMsg
  Assert that: first selector name equals: "do"
  Assert that: ((first receiver asCodeBlock) body unTypedBody) count equals: 2
]

Test parseBinaryAfterMultilineCodeblock -> Unit = [
  input = """
    [
      5
    ] do + 1
  """

  statements = TestParse withInput: input expectedCount: 1

  first = statements at: 0, asBinaryMsg
  Assert that: first args count equals: 1
  Assert that: (first receiver asUnaryMsg) selector name equals: "do"
]

Test parseUnaryAfterMultilineCollection -> Unit = [
  input = """
    {1 2
     3} count
  """

  statements = TestParse withInput: input expectedCount: 1

  first = statements at: 0, asUnaryMsg
  Assert that: first selector name equals: "count"
  Assert that: ((first receiver asListLiteral) elements unTypedBody) count equals: 3
]
