type TestParse
constructor TestParse withInput: String expectedCount: Int -> mut List::Statement = [
  tokens = Lexer get-tokens: withInput
  parser = Parser newParseTokens: tokens
  statements::mut List(Statement) = parser statements

  expectedCount > 0 ifTrue: [
    Assert that: statements count equals: expectedCount
  ]

  ^statements
]

constructor TestParse withInput(content): String file(sf): SourceFile expectedCount: Int -> mut List::Statement = [
  tokens = Lexer get-tokens: content file: sf
  parser = Parser newParseTokens: tokens
  statements::mut List(Statement) = parser statements

  expectedCount > 0 ifTrue: [
    Assert that: statements count equals: expectedCount
  ]

  ^statements
]

constructor TestParse expression::String -> Expr = [
  expr = Parser newParseTokens: (Lexer get-tokens: expression), statements at: 0

  ^ | expr
    | Expr => expr
      |=> [TO DO: "It should be Expr, but it " + expr toString]
]

Test parserPeekAtOutOfBoundsReturnsEof = [
  tokens = Lexer get-tokens: "1"
  parser::mut Parser = Parser tokens: tokens current: 0 statements: {}!

  beforeStart = parser peekAt: -1
  afterEnd = parser peekAt: tokens count
  Assert that: beforeStart kind equals: TokenType.EndOfFile
  Assert that: afterEnd kind equals: TokenType.EndOfFile
]

Test varDeclarationWithAstType  = [
  input = """
    x::Int = 42
  """
  statements = TestParse withInput: input expectedCount: 1
  vardecl = statements at: 0, asVarDeclaration
  astType = (vardecl astType) expect: "Missing variable type"
  Assert that: astType name equals: "Int"
  Assert that: vardecl name equals: "x"
]

Test varDeclarationWithAstType2 = [

  input = """
    Money make::Int sas::String -> Unit = [
      x::Int = 42
    ]
  """
  statements = TestParse withInput: input expectedCount: 1

]


Test comments = [
  input = """
    1 + 2
    //sas
    // uu
    3 / 4
  """
  statements = TestParse withInput: input expectedCount: 2

]


Test parseNumber = [
  input = """
  123
  """ trimIndent

  tokens = Lexer get-tokens: input
  statements::mut List::Statement = {}!
  parser:: mut Parser = Parser tokens: tokens current: 0 statements: statements
  intExprMaybe = parser literalExprFrom: tokens first
  intExpr = (intExprMaybe expect: "Missing integer expression") asIntExpr
  Assert that: intExpr num equals: 123
]

Test parseNumberWithUnderscore = [
  input = """
  1_000_000
  """ trimIndent

  tokens = Lexer get-tokens: input
  statements::mut List::Statement = {}!
  parser:: mut Parser = Parser tokens: tokens current: 0 statements: statements
  intExprMaybe = parser literalExprFrom: tokens first
  intExpr = (intExprMaybe expect: "Missing integer expression") asIntExpr
  Assert that: intExpr num equals: 1000000
]

Test parseString = [
  tokens = Lexer get-tokens: """ "sas" """
  statements::mut List::Statement = {}!
  parser:: mut Parser = Parser tokens: tokens current: 0 statements: statements
  stringExprMaybe = parser literalExprFrom: tokens first
  stringExpr = (stringExprMaybe expect: "Missing string expression") asStringExpr
  Assert that: stringExpr token lexeme equals: "\"sas\""
]




Test parseAstTypeList = [
  input = """
    List(List(Int))
  """ trimIndent

  tokens = Lexer get-tokens: input
  statements::mut List::Statement = {}!
  parser:: mut Parser = Parser tokens: tokens current: 0 statements: statements
  astType = (parser parseType) asAstType
  Assert that: astType genericParams count equals: 1
  list = (astType genericParams at: 0) asAstType
  Assert that: list name equals: "List"
]

Test parseAstTypeMap = [
  input = """
    Map(Int, String)
  """ trimIndent

  tokens = Lexer get-tokens: input
  statements::mut List::Statement = {}!
  parser:: mut Parser = Parser tokens: tokens current: 0 statements: statements
  astType = (parser parseType) asAstType
  Assert that: astType genericParams count equals: 2
  Assert that: ((astType genericParams at: 0) asAstType) name equals: "Int"
  Assert that: ((astType genericParams at: 1) asAstType) name equals: "String"
]

Test parseAstTypeErrorAny = [
  input = """
    Int!
  """ trimIndent

  tokens = Lexer get-tokens: input
  statements::mut List::Statement = {}!
  parser:: mut Parser = Parser tokens: tokens current: 0 statements: statements
  astType = (parser parseType) asAstType
  errors = (astType errors) expect: "Missing type errors"
  Assert that: errors kind equals: AstTypeErrorsKind.Any
  Assert that: errors names count equals: 0
]

Test parseAstTypeErrorSingle = [
  input = """
    Int!OutOfMemory
  """ trimIndent

  tokens = Lexer get-tokens: input
  statements::mut List::Statement = {}!
  parser:: mut Parser = Parser tokens: tokens current: 0 statements: statements
  astType = (parser parseType) asAstType
  errors = (astType errors) expect: "Missing type errors"
  Assert that: errors kind equals: AstTypeErrorsKind.Single
  Assert that: errors names count equals: 1
  Assert that: errors names first equals: "OutOfMemory"
]

Test parseAstTypeErrorList = [
  input = """
    Int!{Error1 Error2 Error3}
  """ trimIndent

  tokens = Lexer get-tokens: input
  statements::mut List::Statement = {}!
  parser:: mut Parser = Parser tokens: tokens current: 0 statements: statements
  astType = (parser parseType) asAstType
  errors = (astType errors) expect: "Missing type errors"
  Assert that: errors kind equals: AstTypeErrorsKind.List
  Assert that: errors names count equals: 3
  Assert that: (errors names at: 0) equals: "Error1"
  Assert that: (errors names at: 1) equals: "Error2"
  Assert that: (errors names at: 2) equals: "Error3"
]

Test parseExtendMessageDeclarations = [
  input = """
    extend FooBar [
      on foo: Int bar: Int = []
      on foo = []
      on + x: Int = []
    ]
  """

  statements = TestParse withInput: input expectedCount: 1
  extendDecl = statements at: 0, asExtendDecl
  Assert that: extendDecl receiver name equals: "FooBar"
  Assert that: extendDecl messages count equals: 3

  first = extendDecl messages at: 0
  second = extendDecl messages at: 1
  third = extendDecl messages at: 2

  Assert that: first receiver name equals: "FooBar"
  Assert that: first name equals: "foo__bar"
  Assert that: second receiver name equals: "FooBar"
  Assert that: second name equals: "foo"
  Assert that: third receiver name equals: "FooBar"
  Assert that: third name equals: "+"
]

Test parseNullableReceiverMessageDeclarations = [
  input = """
    T? ensure -> T = [this]
    Int? orZero: default::Int -> Int = [42]
  """

  statements = TestParse withInput: input expectedCount: 2

  unary = statements at: 0, asMessageDecl
  Assert that: unary name equals: "ensure"
  receiver = (unary receiver) asAstType
  Assert that: receiver name equals: "T"
  Assert that: receiver isNullable equals: true

  kw = statements at: 1, asMessageDecl
  Assert that: kw name equals: "orZero"
  Assert that: kw args count equals: 1
  kwReceiver = (kw receiver) asAstType
  Assert that: kwReceiver name equals: "Int"
  Assert that: kwReceiver isNullable equals: true
]
