/// dollars inside these inputs are built by concatenation
/// so that the kotlin bootstrap compiler does not interpolate them
Test interpolatedNameParts = [
  dollar = "$"
  expr = TestParse expression: "\"" + dollar + "name\""
  | expr
  | InterpolatedString => [
    Assert that: expr parts count equals: 1
    part = expr parts first
    | part
    | Identifier => Assert that: part name equals: "name"
    |=> [TO DO: "identifier part expected"]
  ]
  |=> [TO DO: "interpolated string expected"]
]

Test interpolatedBracketsWithText = [
  dollar = "$"
  src = "\"" + dollar + "[1 + 2] items\""
  expr = TestParse expression: src
  | expr
  | InterpolatedString => [
    Assert that: expr parts count equals: 2
    first = expr parts at: 0
    | first
    | BinaryMsg => []
    |=> [TO DO: "binary expr part expected"]
    last = expr parts at: 1
    | last
    | StringExpr => Assert that: last token lexeme equals: "\" items\""
    |=> [TO DO: "literal part expected"]
  ]
  |=> [TO DO: "interpolated string expected"]
]

Test dollarWithoutNameStaysPlainLiteral = [
  dollar = "$"
  expr = TestParse expression: "\"" + dollar + "0 and 100" + dollar + "\""
  | expr
  | StringExpr => Assert that: expr token lexeme equals: "\"$0 and 100$\""
  |=> [TO DO: "plain string literal expected"]
]

Test interpolatedRawString = [
  dollar = "$"
  quote = "\""
  triple = quote + quote + quote
  expr = TestParse expression: triple + "a" + dollar + "x" + triple
  | expr
  | InterpolatedString => [
    Assert that: expr parts count equals: 2
    first = expr parts at: 0
    | first
    | StringExpr => Assert that: first token lexeme equals: triple + "a" + triple
    |=> [TO DO: "raw literal part expected"]
    last = expr parts at: 1
    | last
    | Identifier => []
    |=> [TO DO: "identifier part expected"]
  ]
  |=> [TO DO: "interpolated string expected"]
]

Test nestedStringInsideInterpolation = [
  dollar = "$"
  escapedQuote = "\\\""
  src = "\"" + dollar + "[ " + escapedQuote + "ab]c" + escapedQuote + " ] x\""
  expr = TestParse expression: src
  | expr
  | InterpolatedString => [
    Assert that: expr parts count equals: 2
    first = expr parts at: 0
    | first
    | StringExpr => []
    |=> [TO DO: "string part from nested literal expected"]
    last = expr parts at: 1
    | last
    | StringExpr => Assert that: last token lexeme equals: "\" x\""
    |=> [TO DO: "literal part expected"]
  ]
  |=> [TO DO: "interpolated string expected"]
]



Test unclosedBracketStaysPlainLiteral = [
  dollar = "$"
  expr = TestParse expression: "\"" + dollar + "[1 + 2" + "\""
  | expr
  | StringExpr => Assert that: expr token lexeme equals: "\"" + dollar + "[1 + 2" + "\""
  |=> [TO DO: "plain string literal expected"]
]




/// a backslash is a plain text char, it does not escape a dollar
Test backslashDoesNotEscapeDollar = [
  dollar = "$"
  bs = "\\"
  expr = TestParse expression: "\"" + bs + dollar + "x" + "\""
  | expr
  | InterpolatedString => [
    Assert that: expr parts count equals: 2
    first = expr parts at: 0
    | first
    | StringExpr => Assert that: first token lexeme equals: "\"" + bs + "\""
    |=> [TO DO: "text part with a backslash expected"]
    last = expr parts at: 1
    | last
    | Identifier => Assert that: last name equals: "x"
    |=> [TO DO: "identifier part expected"]
  ]
  |=> [TO DO: "interpolated string expected"]
]
