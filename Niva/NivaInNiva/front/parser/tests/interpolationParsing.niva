/// dollars inside these inputs are built by concatenation
/// so that the kotlin bootstrap compiler does not interpolate them
Test interpolatedNameParts = [
  dollar = "$"
  expr = (TestParse expression: "\"" + dollar + "name\"") asInterpolatedString
  Assert that: expr parts count equals: 1
  Assert that: (expr parts first asIdentifier) name equals: "name"
]

Test interpolatedBracketsWithText = [
  dollar = "$"
  src = "\"" + dollar + "[1 + 2] items\""
  expr = (TestParse expression: src) asInterpolatedString
  Assert that: expr parts count equals: 2
  Assert that: ((expr parts at: 0) asBinaryMsg) args count equals: 1
  Assert that: ((expr parts at: 1) asStringExpr) token lexeme equals: "\" items\""
]

Test dollarWithoutNameStaysPlainLiteral = [
  dollar = "$"
  expr = (TestParse expression: "\"" + dollar + "0 and 100" + dollar + "\"") asStringExpr
  Assert that: expr token lexeme equals: "\"$0 and 100$\""
]

Test interpolatedRawString = [
  dollar = "$"
  quote = "\""
  triple = quote + quote + quote
  expr = (TestParse expression: triple + "a" + dollar + "x" + triple) asInterpolatedString
  Assert that: expr parts count equals: 2
  Assert that: ((expr parts at: 0) asStringExpr) token lexeme equals: triple + "a" + triple
  Assert that: ((expr parts at: 1) asIdentifier) name equals: "x"
]

Test nestedStringInsideInterpolation = [
  dollar = "$"
  escapedQuote = "\\\""
  src = "\"" + dollar + "[ " + escapedQuote + "ab]c" + escapedQuote + " ] x\""
  expr = (TestParse expression: src) asInterpolatedString
  Assert that: expr parts count equals: 2
  (expr parts at: 0) asStringExpr
  Assert that: ((expr parts at: 1) asStringExpr) token lexeme equals: "\" x\""
]



Test unclosedBracketStaysPlainLiteral = [
  dollar = "$"
  expr = (TestParse expression: "\"" + dollar + "[1 + 2" + "\"") asStringExpr
  Assert that: expr token lexeme equals: "\"" + dollar + "[1 + 2" + "\""
]




/// a backslash before a dollar escapes it, the dollar stays plain text
Test backslashEscapesDollar = [
  dollar = "$"
  bs = "\\"
  expr = (TestParse expression: "\"" + bs + dollar + "x" + "\"") asInterpolatedString
  Assert that: expr parts count equals: 1
  Assert that: (expr parts first asStringExpr) token lexeme equals: "\"" + dollar + "x\""
]

/// an escaped dollar stays text while a real dollar still interpolates
Test backslashEscapesDollarBeforeInterpolation = [
  dollar = "$"
  bs = "\\"
  src = "\"" + bs + dollar + "x " + dollar + "y\""
  expr = (TestParse expression: src) asInterpolatedString
  Assert that: expr parts count equals: 2
  Assert that: ((expr parts at: 0) asStringExpr) token lexeme equals: "\"" + dollar + "x \""
  Assert that: ((expr parts at: 1) asIdentifier) name equals: "y"
]

/// a raw literal keeps a backslash as a plain char, the dollar still interpolates
Test rawBackslashDoesNotEscapeDollar = [
  dollar = "$"
  bs = "\\"
  quote = "\""
  triple = quote + quote + quote
  expr = (TestParse expression: triple + bs + dollar + "x" + triple) asInterpolatedString
  Assert that: expr parts count equals: 2
  Assert that: ((expr parts at: 0) asStringExpr) token lexeme equals: triple + bs + triple
  Assert that: ((expr parts at: 1) asIdentifier) name equals: "x"
]
