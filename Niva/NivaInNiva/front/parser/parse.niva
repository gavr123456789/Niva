type Parser
  tokens: List::Token
  current: Int
  statements: mut List::Statement

constructor Parser newParseTokens: List(Token) -> Parser = [
  statements::mut List::Statement = {}!
  parser2::mut Parser = Parser tokens: newParseTokens current: 0 statements: statements

  [ parser2 done not ] whileTrue: [
    parser2 statements add: parser2 nextStatement
  ]
  parser2
]


type TypeField name: String astType: AstType2
TypeField toString -> String =  "$name: $astType"

extend mut Parser [
  on isLiteralExpr(tok): Token -> Bool = [
   ^| tok kind
    | TokenType.Integer
    | TokenType.String
    | TokenType.RawString
    | TokenType.True|TokenType.False
    | TokenType.Char
    | TokenType.Float
    | TokenType.Double
    | TokenType.UnitTok
    | TokenType.Null => true
    |=> false
  ]

  on parseReturnExpr(tok): Token -> ReturnStatement = [
    tok kind == TokenType.Return ifFalse: [TO DO: "^ expected"]

    savePosition = current
    isThereAValue = (.peek kind == TokenType.If) || ((.primary: .peek) != null)
    .restoreFrom: savePosition

    value = isThereAValue ifTrue: [.nextExpression: .step] ifFalse: [null]
    result = ReturnStatement value: value token: tok
    result
  ]

  /// tok is identifier
  /// pasre: x = expr
  on parseVarDeclExpr(token): Token name::String isMut::Bool -> VarDeclaration = [
    astType = token kind == TokenType.IdentifierDoubleColon ifTrue: [
      .parseType
    ] ifFalse: [null]

    .matchAssert: TokenType.Assign
    value = .nextExpression: .step
    result = VarDeclaration :name :value :token :astType :isMut
    result
  ]

  /// {a b} = expr
  /// {local = field} = expr
  on tryParseDestructingAssign(tok): Token -> Expr? = [
    | true
    | tok kind != TokenType.OpenBrace => null
    |=> [
      savePosition = current

      bindings::mut List(DestructureBinding) = {}!
      mut invalid = false
      [
        nextTok = .peek
        | nextTok kind
        | TokenType.Identifier
        | TokenType.NullableIdentifier => [
          localName = .step lexeme
          mut fieldName = localName
          .match: TokenType.Assign, ifTrue: [
              fieldTok = .step
              | fieldTok kind
              | TokenType.Identifier
              | TokenType.NullableIdentifier => [fieldName <- fieldTok lexeme]
              |=> [
                .restoreFrom: savePosition
                invalid <- true
              ]
          ]
          bindings add: (DestructureBinding :localName :fieldName)
          .match: TokenType.Comma
          true
        ]
        | TokenType.CloseBrace => [
          false
        ]
        |=> [
          false
        ]
      ] whileTrue: []

      | true
      | invalid => null
      |=> [
        closeBrace = .match: TokenType.CloseBrace
        | true
        | closeBrace not => [
          .restoreFrom: savePosition
          null
        ]
        | bindings isEmpty => [
          .restoreFrom: savePosition
          null
        ]
        |=> [
          assign = .match: TokenType.Assign
          | true
          | assign not => [
            .restoreFrom: savePosition
            null
          ]
          |=> [
            value = .nextExpression: .step
            DestructingAssign bindings: bindings toList value: value token: tok
          ]
        ]
      ]
    ]
  ]

  /// a^.b.c
  on parseDotSeparatedIdentifier(tok): Token -> Identifier = [
    ^ .match: TokenType.Dot, ifTrue: [

      path = {(tok lexeme)}!
      [
        ident = .matchAssert: TokenType.Identifier
        path add: ident lexeme
        .match: TokenType.Dot
      ] whileTrue: []
      Identifier name: tok lexeme token: tok path: path
    ] ifFalse: [
      Identifier name: tok lexeme token: tok path: null
    ]

  ]

  /// "", 1, 1.1, true, []
  on literalExprFrom(tok): Token -> LiteralExpr? = [

    x = | tok kind
    | TokenType.Integer => [
      numStr = tok lexeme replace: "_" with: ""
      IntExpr num: numStr toInt token: tok
    ]

    | TokenType.String|TokenType.RawString =>
      StringExpr token: tok

    | TokenType.True|TokenType.False =>
      BooleanExpr token: tok

    | TokenType.Char =>
      CharExpr token: tok

    | TokenType.Float =>
      FloatExpr token: tok

    | TokenType.Double =>
      DoubleExpr token: tok

    | TokenType.Null =>
      NullExpr token: tok

    | TokenType.UnitTok =>
      UnitExpr token: tok

    |=> [null]
    x
  ]

  /// single element of a collection literal
  /// primary(including nested collections) or expression in brackets `(1 inc)`
  on parseCollectionElement(tok): Token -> Expr? = [
    tok kind == TokenType.OpenParen ifTrue: [
      inner = .nextExpression: .step
      .matchAssert: TokenType.CloseParen
      ^ ExprInBrackets value: inner token: tok
    ]

    ^ .primary: tok
  ]

  /// elements of a collection literal until `end` token(not eaten)
  on parseCollectionBody(end): TokenType -> Body = [
    body::mut List::Expr = {}!

    [
      peekKind = .peek kind
      (peekKind == end) || (peekKind == TokenType.EndOfFile), ifTrue: [
        false
      ] ifFalse: [
        tok2 = .step
        pr = .parseCollectionElement: tok2
        | pr
        | null => [
          // not an element, let the caller report unclosed collection
          .stepBack
          false
        ]
        |=> [
          body add: pr
          .match: TokenType.Comma
          true
        ]
      ]
    ] whileTrue: []
    Body unTypedBody: body
  ]

  /// if starts from { #{ #(, then return collection
  /// tok already eaten outside
  on parseCollection(tok): Token -> CollectionLiteral? = [
   ^| tok kind
    | TokenType.OpenBrace => [
      body = .parseCollectionBody: TokenType.CloseBrace
      .matchAssert: TokenType.CloseBrace
      ListLiteral token: tok elements: body
    ]
    | TokenType.OpenBraceHash => [
      body = .parseCollectionBody: TokenType.CloseBrace
      .matchAssert: TokenType.CloseBrace

      body unTypedBody count % 2 != 0 ifTrue: [
        TO DO: "elements count in Map should be even"
      ]

      MapLiteral token: tok elements: body
    ]
    | TokenType.OpenParenHash => [
      body = .parseCollectionBody: TokenType.CloseParen
      .matchAssert: TokenType.CloseParen
      SetLiteral token: tok elements: body
    ]
    |=> null
  ]


  /// collection {} #{} #()
  /// lambda
  /// or identifier | nullableIdentifier
  /// simple literal 1 "" '' true false 1.1 1.1f
  on primary(tok): Token -> Expr? = [

    .literalExprFrom: tok, unpack: [
      ^it
    ]

    tok isNullOrIdentifier ifTrue: [
      ^.parseDotSeparatedIdentifier: tok
    ]

    tok kind == TokenType.AtomIdentifier ifTrue: [
      // lexeme includes the leading '#'
      name = tok lexeme substring: 1
      ^ AtomIdentifier name: name token: tok
    ]

    .parseCollection: tok, unpack: [
      ^it
    ]

    tok kind == TokenType.OpenBracket ifTrue: [
      ^ .parseCodeBlock: tok
    ]

    ^ null
  ]

  // `[` already eaten
  on parseCodeBlock(tok): Token -> CodeBlock = [
    args <- List(NameAndAstType) val: {} // [a::Int -> a inc]
    untypedArgs <- List(Identifier) val: {} // [a, b -> a + b]
    savePoint = current

    | .peek kind
    | TokenType.IdentifierDoubleColon | TokenType.IdentifierColon => [
      identsWithAst = .parseNameSingleOrDoubleColonAstTypePair: .step separatedBy: TokenType.Comma
      args <- identsWithAst
    ]
    | TokenType.Identifier => [
      idents = .parseManyIdentSeparated: TokenType.Comma
      untypedArgs <- idents
    ]
    |=> []

    wasArrow = .match: TokenType.ReturnArrow

    wasArrow not && untypedArgs isNotEmpty ifTrue: [
      .restoreFrom: savePoint
      untypedArgs <- {}
    ]

    body = .parseManyExprUntilTok: TokenType.CloseBracket split: null

    result = CodeBlock
      args: args
      untypedArgs: untypedArgs
      body: body
      token: tok

    result
  ]


  on parseManyExprUntilTok(until): TokenType split: TokenType? -> Body = [
    body::mut List::Expr = {}!

    [
      tok = .peek
      tok kind == until ifTrue: [
        .step // skip
        false
      ] ifFalse: [
        nextTok = .step
        statement = .nextExpression: nextTok
        split unpack: [.match: it]
        body add: statement
        true
      ]
    ] whileTrue: []

    result = Body unTypedBody: body

    result
  ]
  on parseManyExprSplitBy(split): TokenType -> List::Expr = [
    body::mut List::Expr = {}!

    [
      nextTok = .step
      statement = .nextExpression: nextTok
      body add: statement

      .match: split
    ] whileTrue: []

    body
  ]


  // return body untyped
  on parseBodyOrSingleExpr -> Body = [
    ^ .match: TokenType.OpenBracket, ifTrue: [
      .parseManyExprUntilTok: TokenType.CloseBracket split: null
    ] ifFalse: [
      Body unTypedBody: {(.nextExpression: .step)}!
    ]
  ]

  /// a::Int (sep)? b::String
  on parseNameSingleOrDoubleColonAstTypePair(tok): Token separatedBy(sep): TokenType? -> List::NameAndAstType = [

    firstArg = NameAndAstType name: tok lexeme astType: .parseType
    sep unpack: [.match: it]

    kwArgs = {firstArg}!

    [
      tok = .peek
      singleOrDoubleColon = tok kind == TokenType.IdentifierDoubleColon || (tok kind == TokenType.IdentifierColon)
        singleOrDoubleColon ifTrue: [
        arg = NameAndAstType name: .step lexeme astType: .parseType
        sep unpack: [.match: it]

        kwArgs add: arg
        true
      ] ifFalse: [
        false
      ]
    ] whileTrue: []
    ^ kwArgs
  ]

  on restoreFrom(position): Int = [
    current <- position
  ]

  on parseMatch(tok): Token -> Match = [
    branches::mut List::MatchBranch = {}!
    mut elseBranch::Body? = null
    subject = .nextExpression: .step

    parseBranches = [
      [
        .match: TokenType.If
        exprs = .parseManyExprSplitBy: TokenType.If
        exprs isEmpty ifTrue: [TO DO: "One or more additionalConditions (separated by `|`) expected"]

        .matchAssert: TokenType.Then

        body = .parseBodyOrSingleExpr
        additionalConditions = Body unTypedBody: (exprs drop: 1, toMutableList)
        mb = MatchBranch condition: exprs first additionalConditions: additionalConditions body: body
        branches add: mb

        .match: TokenType.If
      ] whileTrue: []
      .match: TokenType.Else, ifTrue: [
        elseBranch <- .parseBodyOrSingleExpr
      ]

    ] do

    Match subject: subject branches: branches elseBranch: elseBranch token: tok
  ]
  on nextStatement -> Statement = [
    savePosition = current

    tokens isEmpty ifTrue: [TO DO: "no tokens, file is empty"]
    tok = .step

    .isLiteralExpr: tok, ifTrue: [
      ^ .nextExpression: tok
    ]

    ^ | tok kind
      | TokenType.Type => [.typeDeclaration: tok]
      | TokenType.Union => [.unionTypeDeclaration: tok]
      | TokenType.ErrorDomain => [.unionTypeDeclaration: tok]
      | TokenType.Extend => [
        .parseExtendBlock: tok
      ]
      | TokenType.Constructor => [
        .messageDeclarationOrExpression: .step savedPosition: savePosition isConstructor: true
      ]
      // `Int inc = []` or `T? unpack = []`
      | TokenType.Identifier
      | TokenType.NullableIdentifier => [
        firstChar = tok lexeme first
        isTypeName = firstChar isUpperCase
        isTypeName ifTrue: [
          .messageDeclarationOrExpression: tok savedPosition: savePosition isConstructor: false
        ] ifFalse: [
          .nextExpression: tok
        ]
      ]
      | TokenType.Mut => [
        nextTok = .peek
        isTypeName = | nextTok kind
                    | TokenType.Identifier
                    | TokenType.NullableIdentifier
                    | TokenType.IdentifierDoubleColon => [
                      firstChar = nextTok lexeme first
                      firstChar isUpperCase
                    ]
                    |=> false
        isTypeName ifTrue: [
          .messageDeclarationOrExpression: tok savedPosition: savePosition isConstructor: false
        ] ifFalse: [
          .nextExpression: tok
        ]
      ]
      | TokenType.If => [
        .parseMatch: tok
      ]
      | TokenType.Return => [
        .parseReturnExpr: tok
      ]
      | TokenType.EndOfFile => [
        TO DO: "its impossible to be here, whileTrue from top stack goes until `done`"
      ]
      | TokenType.Invalid => [
        prevPrev = .peekAt: -2
        prev = .peekAt: -1
        cur = .peek
        pos = cur toPosition
        TO DO: pos + "Got invalid token after $prevPrev $prev $cur"
      ]
      | TokenType.IdentifierDoubleColon => [
        .parseVarDeclExpr: tok name: tok lexeme isMut: false // `::` for IdentifierDoubleColon is removed in lexer
      ]

      |=> [
        .nextExpression: tok
      ]

  ]
  // msg, msg, msg -> (((msg) msg) msg)
  on commaChainedExprs(tok): Token receiver: Expr = [
     firstExpr = .nextExpression2: tok receiver: receiver
     mut expr = firstExpr
     [
       .peek kind == TokenType.Comma, ifTrue: [
          commaTok = .step // skip comma

          expr <- .nextExpression2: commaTok receiver: (ExprInBrackets value: expr token: commaTok)
          true
        ] ifFalse: [
          false
        ]
     ] whileTrue: []

     ^ expr
  ]

  /// `^ expr` | `expr`
  on nextExpression(tok): Token -> Expr = [
    // return expr
   ^| tok kind
   | TokenType.Return => [
      e = .parseReturnExpr: tok
      e
    ]
   | TokenType.Mut => [
        name = .step // tok is mut here, so we need name
        .parseVarDeclExpr: name name: name lexeme isMut: true
    ]
   | TokenType.OpenParen => [
        inner = .nextExpression: .step
        .matchAssert: TokenType.CloseParen

        exprInBrackets = ExprInBrackets value: inner token: tok

        comma-chained-expr1 = .commaChainedExprs: tok receiver: exprInBrackets
        comma-chained-expr1
   ]
   | TokenType.If => .parseMatch: tok
   | TokenType.IdentifierDoubleColon => .parseVarDeclExpr: tok name: tok lexeme isMut: false // VarDeclaration: `x::Int`
   |=> [

     tok kind == TokenType.OpenBrace ifTrue: [
        .tryParseDestructingAssign: tok, unpack: [^ it]
     ]

     tok-pos = tok toPosition
     primaryReceiver = .primary: tok, unpackOrMsg: tok-pos + "  nextExpression: no primary1 ($tok)"
     // assign
     .peek kind == TokenType.Assign, ifTrue: [
       ^.parseVarDeclExpr: tok name: primaryReceiver token lexeme isMut: false
     ]

     .peek kind == TokenType.AssignArrow, ifTrue: [
       .step
       value = .nextExpression: .step
       | primaryReceiver
       | Identifier => [
         ^ Assign name: primaryReceiver name value: value token: tok
       ]
       |=> [
         TO DO: "<- expected identifier on the left side"
       ]
     ]
     // any expr
     comma-chained-expr2 = .commaChainedExprs: tok receiver: primaryReceiver

     // x wallet money value <- 13
     // copy var from kotlin basically
     .peek kind == TokenType.AssignArrow, ifTrue: [
       .step
       | comma-chained-expr2
       | UnaryMsg => [
         copyValue = .nextExpression: .step
         ^ ImmutableCopyUpdate target: comma-chained-expr2 value: copyValue token: tok
       ]
       |=> [
         TO DO: "<- immutable copy update expects a non-empty unary getter chain"
       ]
     ]

     comma-chained-expr2
    ]
  ]

  on nextExpression2(tok): Token receiver: Expr? -> Expr = [
    // return expr
    tok kind == TokenType.Return ifTrue: [
      ^ .parseReturnExpr: tok
    ]
    // message expr
    primaryUnaryBinary = .parsePrimaryOrUnaryOrBinary: tok receiver: receiver
   ^| .peek kind
    | TokenType.IdentifierColon => [

      result::mut List::NameAndExpr = {}!
      // parse keyword
      [
        colon = .peek
        | colon kind
        | TokenType.IdentifierColon => [
          result add:
            (NameAndExpr
              name: (Identifier fromToken: .step)
              expr: (.parsePrimaryOrUnaryOrBinary: .step))
          true
        ]
        |=> [
          false
        ]
      ] whileTrue: []
      KeywordMsg
        args: result toList
        receiver: primaryUnaryBinary
        token: tok
        kind: MessageSendKind.Call

    ]
    |=> primaryUnaryBinary
  ]


  // returns
  // Primary
  // UnaryMsg
  // BinaryMsg
  on parsePrimaryOrUnaryOrBinary(tok): Token -> Expr = .parsePrimaryOrUnaryOrBinary: tok receiver: null
  on parsePrimaryOrUnaryOrBinary(tok): Token receiver: Expr? -> Expr = [
    maybePrimary =  | receiver
                    | null => [
                      tok kind == TokenType.OpenParen ifTrue: [
                        inner = .nextExpression: .step
                        .matchAssert: TokenType.CloseParen
                        ExprInBrackets value: inner token: tok
                      ] ifFalse: [
                        .primary: tok, unpackOrMsg: "nextExpression: no primary2 ($tok)"
                      ]
                    ]
                    |=> receiver

    next = .peek

    // single primary before new line
    // or in other words just `42`

    // here, we need to know that it is not a `p` unary for "Ada", but new msg
    //        Person name: "Ada"
    //        p greet
    // the last token of the primary and not `tok`, because the primary itself can be
    // multiline, and then the msg is on the line of its last token(`[\n 1 echo \n] do`)
    lastTokOfPrimary = .peekAt: -1
    (next line > lastTokOfPrimary line) && (lastTokOfPrimary lexeme != ","),
      ifTrue: [
        ^ maybePrimary
      ]

    // 1 ^

    | next kind
    // 1 ^inc
    | TokenType.Identifier => [
      // primary identifier

      // while there are identifiers - parse and save them, its a begining of unary
      tok = .peek
      | tok kind
      | TokenType.Identifier => [
        unaryList = .parseManyIdentSeparated: null

        mut tempUnary = UnaryMsg
          selector: unaryList first
          kind: MessageSendKind.Call
          receiver: maybePrimary
          token: tok

        unaryList drop: 1, forEach: [
          newUnary = UnaryMsg
            selector: it
            kind: MessageSendKind.Call
            receiver: tempUnary
            token: tok
          tempUnary <- newUnary
        ]

        unary = tempUnary

        // 1 inc inc^
        .peek kind == TokenType.BinarySymbol, ifTrue: [
          // 1 inc inc^ + 2
          binaryList = .parseManyBinary
          binary = BinaryMsg
            args: binaryList toList
            receiver: unary
            token: maybePrimary token
          ^binary
        ]
        ^ unary
        Unit
      ]
      | TokenType.BinarySymbol => [
        binaryList = .parseManyBinary

        binary = BinaryMsg
          args: binaryList toList
          receiver: maybePrimary
          token: maybePrimary token

        ^ binary
        ()
      ] |=> ()


      TO DO: "parse unary"
    ]
    | TokenType.BinarySymbol => [
      // primary binary
      // 1 + 1 + 1
      // 1 + 1 sas: 2


      // 1 + ^2
      binaryList = .parseManyBinary

      binary = BinaryMsg
        args: binaryList
        receiver: maybePrimary
        token: maybePrimary token
      // statements add: binary

      // .peek kind == TokenType.IdentifierColon, ifTrue: [
      // ]

      ^ binary
      // kw possible
      // if while parsing binary got keyword than continue keyword parsing
    ]
    |=> []

    maybePrimary
  ]



  // / x| probably not just identifier without anything
  // / x = ...
  // / x inc ...
  // / X inc = []
  // / x + ...
  // / X + y::Int = []
  // / x that: ...
  // / X from::Int = []
  // / X from y:Int = []



  on match::TokenType -> Bool = [
    .peek kind == match, ifTrue: [
      .step
      ^ true
    ]

    false
  ]

  /// match Identifier|Nullable|Error
  on matchAssertAnyIdent(error): String -> Token = [
    tok = .peek

    ^ tok isIdentifier ifTrue: [
      .step
      tok
    ] ifFalse: [
      TO DO: error
    ]
  ]

  on matchAssert::TokenType -> Token = [
    peek = .peek
    peek kind == matchAssert, ifTrue: [
      ^ .step
    ]
    {line start} = peek
    TO DO: "$matchAssert expected but got $peek at: $line:$start"
  ]

  on matchString::String -> Bool = [
    .peek lexeme == matchString, ifTrue: [
      .step
      ^ true
    ]

    ^ false
  ]

  on check(kind): TokenType = .peek kind == kind

  on done = .check: TokenType.EndOfFile

  on step -> Token = [
    x = .peek
    x kind == TokenType.EndOfFile, ifTrue: [
      TO DO: "step: EOF"
    ]
    current <- current inc
    ^ x
  ]
  on stepBack -> Token = [
    x = .peekAt: -1
    current <- current dec
    ^ x
  ]

  /// if current is out of bounds returns EOF
  /// otherwise returns token at current position
  on peek -> Token = [
    // current >= tokens count, ifTrue: [
    //   ^ EOF_TOKEN
    // ]

    tokens at: current
  ]
  on peekAt(distance): Int -> Token = [
    realDistance = current + distance
    tokens at: realDistance
  ]
]
