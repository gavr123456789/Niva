type Parser
  tokens: List::Token
  current: Int
  statements: mut List::Statement

constructor Parser newParseTokens: List(Token) -> Parser = [
  statements::mut List::Statement = {}!
  parser2::mut Parser = Parser tokens: newParseTokens current: 0 statements: statements

  [ parser2 done not ] whileTrue: [
    parser2 statements add: parser2 nextStatement
  ]
  parser2
]


type TypeField name: String astType: AstType2
TypeField toString -> String =  "$name: $astType"

extend mut Parser [
  on isLiteralExpr(tok): Token -> Bool = [
   ^| tok kind
    | TokenType.Integer
    | TokenType.String
    | TokenType.RawString
    | TokenType.True|TokenType.False
    | TokenType.Char
    | TokenType.Float
    | TokenType.Double
    | TokenType.UnitTok
    | TokenType.Null => true
    |=> false
  ]

  on parseReturnExpr(tok): Token -> ReturnStatement = [
    tok kind == TokenType.Return ifFalse: [TO DO: "^ expected"]

    savePosition = current
    nextKind = this peek kind
    isThereAValue = nextKind == TokenType.If
      ifTrue: [true]
      ifFalse: [
        nextKind == TokenType.Dot
          ifTrue: [true]
          ifFalse: [((this primary: this step) != null)]
      ]
    this restoreFrom: savePosition

    value = isThereAValue ifTrue: [this nextExpression: this step] ifFalse: [null]
    result = ReturnStatement token: tok value: value
    result
  ]

  /// tok is identifier
  /// pasre: x = expr
  on parseVarDeclExpr(token): Token name::String isMut::Bool -> VarDeclaration = [
    astType = token kind == TokenType.IdentifierDoubleColon ifTrue: [
      this parseType
    ] ifFalse: [null]

    this matchAssert: TokenType.Assign
    value = this nextExpression: this step
    result = VarDeclaration token: token name: name value: value astType: astType isMut: isMut
    result
  ]

  /// {a b} = expr
  /// {local = field} = expr
  on tryParseDestructingAssign(tok): Token -> Expr? = [
    | true
    | tok kind != TokenType.OpenBrace => null
    |=> [
      savePosition = current

      bindings::mut List(DestructureBinding) = {}!
      mut invalid = false
      [
        nextTok = this peek
        | nextTok kind
        | TokenType.Identifier
        | TokenType.NullableIdentifier => [
          localName = this step lexeme
          mut fieldName = localName
          this match: TokenType.Assign, ifTrue: [
              fieldTok = this step
              | fieldTok kind
              | TokenType.Identifier
              | TokenType.NullableIdentifier => [fieldName <- fieldTok lexeme]
              |=> [
                this restoreFrom: savePosition
                invalid <- true
              ]
          ]
          bindings add: (DestructureBinding localName: localName fieldName: fieldName)
          this match: TokenType.Comma
          true
        ]
        | TokenType.CloseBrace => [
          false
        ]
        |=> [
          false
        ]
      ] whileTrue: []

      | true
      | invalid => null
      |=> [
        closeBrace = this match: TokenType.CloseBrace
        | true
        | closeBrace not => [
          this restoreFrom: savePosition
          null
        ]
        | bindings isEmpty => [
          this restoreFrom: savePosition
          null
        ]
        |=> [
          assign = this match: TokenType.Assign
          | true
          | assign not => [
            this restoreFrom: savePosition
            null
          ]
          |=> [
            value = this nextExpression: this step
            result::Expr = DestructingAssign token: tok bindings: bindings toList value: value
            result
          ]
        ]
      ]
    ]
  ]

  /// a^.b.c
  on parseDotSeparatedIdentifier(tok): Token -> Identifier = [
    ^ this match: TokenType.Dot, ifTrue: [

      path = {(tok lexeme)}!
      [
        ident = this matchAssert: TokenType.Identifier
        path add: ident lexeme
        this match: TokenType.Dot
      ] whileTrue: []
      Identifier token: tok name: tok lexeme path: path
    ] ifFalse: [
      Identifier token: tok name: tok lexeme path: null
    ]

  ]

  /// "", 1, 1.1, true, []
  on literalExprFrom(tok): Token -> LiteralExpr? = [

    x = | tok kind
    | TokenType.Integer => [
      numStr = tok lexeme replace: "_" with: ""
      IntExpr token: tok num: numStr toInt
    ]

    | TokenType.String|TokenType.RawString =>
      StringExpr token: tok

    | TokenType.True|TokenType.False =>
      BooleanExpr token: tok

    | TokenType.Char =>
      CharExpr token: tok

    | TokenType.Float =>
      FloatExpr token: tok

    | TokenType.Double =>
      DoubleExpr token: tok

    | TokenType.Null =>
      NullExpr token: tok

    | TokenType.UnitTok =>
      UnitExpr token: tok

    |=> [null]
    x
  ]

  /// single element of a collection literal
  /// primary(including nested collections) or expression in brackets `(1 inc)`
  on parseCollectionElement(tok): Token -> Expr? = [
    tok kind == TokenType.OpenParen ifTrue: [
      inner = this nextExpression: this step
      this matchAssert: TokenType.CloseParen
      ^ ExprInBrackets token: tok value: inner
    ]

    ^ this primary: tok
  ]

  /// elements of a collection literal until `end` token(not eaten)
  on parseCollectionBody(end): TokenType -> Body = [
    body::mut List::Expr = {}!

    [
      peekKind = this peek kind
      shouldStop = peekKind == end
        ifTrue: [true]
        ifFalse: [peekKind == TokenType.EndOfFile]
      shouldStop ifTrue: [
        false
      ] ifFalse: [
        tok2 = this step
        pr = this parseCollectionElement: tok2
        | pr
        | null => [
          // not an element, let the caller report unclosed collection
          this stepBack
          false
        ]
        |=> [
          body add: pr
          this match: TokenType.Comma
          true
        ]
      ]
    ] whileTrue: []
    Body unTypedBody: body
  ]

  /// if starts from { #{ #(, then return collection
  /// tok already eaten outside
  on parseCollection(tok): Token -> CollectionLiteral? = [
   ^| tok kind
    | TokenType.OpenBrace => [
      body = this parseCollectionBody: TokenType.CloseBrace
      this matchAssert: TokenType.CloseBrace
      isMutable = this match: TokenType.Bang
      ListLiteral token: tok elements: body isMutable: isMutable
    ]
    | TokenType.OpenBraceHash => [
      body = this parseCollectionBody: TokenType.CloseBrace
      this matchAssert: TokenType.CloseBrace
      isMutable = this match: TokenType.Bang

      body unTypedBody count % 2 != 0 ifTrue: [
        TO DO: "elements count in Map should be even"
      ]

      MapLiteral token: tok elements: body isMutable: isMutable
    ]
    | TokenType.OpenParenHash => [
      body = this parseCollectionBody: TokenType.CloseParen
      this matchAssert: TokenType.CloseParen
      isMutable = this match: TokenType.Bang
      SetLiteral token: tok elements: body isMutable: isMutable
    ]
    |=> null
  ]


  /// collection {} #{} #()
  /// lambda
  /// or identifier | nullableIdentifier
  /// simple literal 1 "" '' true false 1.1 1.1f
  on primary(tok): Token -> Expr? = [
    literalExprMaybe = this literalExprFrom: tok
    literalExpr = | literalExprMaybe
      | null => null
      |=> literalExprMaybe
    literalExpr != null ifTrue: [^ literalExpr]

    tok isNullOrIdentifier ifTrue: [
      ^this parseDotSeparatedIdentifier: tok
    ]

    tok kind == TokenType.AtomIdentifier ifTrue: [
      // lexeme includes the leading '#'
      name = tok lexeme drop: 1
      ^ AtomIdentifier token: tok name: name
    ]

    collectionMaybe = this parseCollection: tok
    collection = | collectionMaybe
      | null => null
      |=> collectionMaybe
    collection != null ifTrue: [^ collection]

    tok kind == TokenType.OpenBracket ifTrue: [
      ^ this parseCodeBlock: tok
    ]

    ^ null
  ]

  // `[` already eaten
  on parseCodeBlock(tok): Token -> CodeBlock = [
    args::mut List::NameAndAstType = {}!
    untypedArgs::mut List::Identifier = {}!
    savePoint = current

    | this peek kind
    | TokenType.IdentifierDoubleColon | TokenType.IdentifierColon => [
      identsWithAst = this parseNameSingleOrDoubleColonAstTypePair: this step separatedBy: TokenType.Comma
      args addAll: identsWithAst
    ]
    | TokenType.Identifier => [
      idents = this parseManyIdentSeparated: TokenType.Comma
      untypedArgs addAll: idents
    ]
    |=> []

    wasArrow = this match: TokenType.ReturnArrow

    hasArgs = untypedArgs isNotEmpty ifTrue: [true] ifFalse: [args isNotEmpty]
    (wasArrow not && hasArgs) ifTrue: [
      this restoreFrom: savePoint
      args clear
      untypedArgs clear
    ]

    body = this parseManyExprUntilTok: TokenType.CloseBracket split: null

    result = CodeBlock
      token: tok
      args: args
      untypedArgs: untypedArgs
      body: body

    result
  ]


  on parseManyExprUntilTok(until): TokenType split: TokenType? -> Body = [
    body::mut List::Expr = {}!

    [
      tok = this peek
      tok kind == until ifTrue: [
        this step // skip
        false
      ] ifFalse: [
        nextTok = this step
        statement = this nextExpression: nextTok
        splitMaybe = split
        | splitMaybe
        | null => false
        |=> this match: splitMaybe
        body add: statement
        true
      ]
    ] whileTrue: []

    result = Body unTypedBody: body

    result
  ]
  on parseManyExprSplitBy(split): TokenType -> List::Expr = [
    body::mut List::Expr = {}!

    [
      nextTok = this step
      statement = this nextExpression: nextTok
      body add: statement

      this match: split
    ] whileTrue: []

    body
  ]


  // return body untyped
  on parseBodyOrSingleExpr -> Body = [
    ^ this match: TokenType.OpenBracket, ifTrue: [
      this parseManyExprUntilTok: TokenType.CloseBracket split: null
    ] ifFalse: [
      Body unTypedBody: {(this nextExpression: this step)}!
    ]
  ]

  /// a::Int (sep)? b::String
  on parseNameSingleOrDoubleColonAstTypePair(tok): Token separatedBy(sep): TokenType? -> List::NameAndAstType = [

    firstArg = NameAndAstType name: tok lexeme astType: this parseType
    sepMaybe = sep
    | sepMaybe
    | null => false
    |=> this match: sepMaybe

    kwArgs = {firstArg}!

    [
      tok = this peek
      singleOrDoubleColon = tok kind == TokenType.IdentifierDoubleColon
        ifTrue: [true]
        ifFalse: [tok kind == TokenType.IdentifierColon]
        singleOrDoubleColon ifTrue: [
        arg = NameAndAstType name: this step lexeme astType: this parseType
        sepMaybe = sep
        | sepMaybe
        | null => false
        |=> this match: sepMaybe

        kwArgs add: arg
        true
      ] ifFalse: [
        false
      ]
    ] whileTrue: []
    ^ kwArgs
  ]

  on restoreFrom(position): Int -> Unit = [
    current <- position
    ()
  ]

  on parseMatch(tok): Token -> Match = [
    branches::mut List::MatchBranch = {}!
    mut elseBranch::Body? = null
    subject = this nextExpression: this step

    [
      this match: TokenType.If
      exprs = this parseManyExprSplitBy: TokenType.If
      exprs isEmpty ifTrue: [TO DO: "One or more additionalConditions (separated by `|`) expected"]

      this matchAssert: TokenType.Then

      body = this parseBodyOrSingleExpr
      additionalConditions = Body unTypedBody: (exprs drop: 1, toMutableList)
      mb = MatchBranch condition: exprs first additionalConditions: additionalConditions body: body
      branches add: mb

      this match: TokenType.If
    ] whileTrue: []
    this match: TokenType.Else, ifTrue: [
      elseBranch <- this parseBodyOrSingleExpr
    ]

    Match token: tok subject: subject branches: branches elseBranch: elseBranch
  ]
  on nextStatement -> Statement = [
    savePosition = current

    tokens isEmpty ifTrue: [TO DO: "no tokens, file is empty"]
    tok = this step

    this isLiteralExpr: tok, ifTrue: [
      ^ this nextExpression: tok
    ]

    ^ | tok kind
      | TokenType.Type => [this typeDeclaration: tok]
      | TokenType.Union => [this unionTypeDeclaration: tok]
      | TokenType.Enum => [this enumDeclaration: tok]
      | TokenType.ErrorDomain => [this unionTypeDeclaration: tok]
      | TokenType.Extend => [
        this parseExtendBlock: tok
      ]
      | TokenType.Constructor => [
        constructorStart = this current
        receiverType = this parseType
        isConstructorGroup = this peek kind == TokenType.OpenBracket
        this restoreFrom: constructorStart
        isConstructorGroup ifTrue: [
          this parseConstructorGroup: tok
        ] ifFalse: [
          this messageDeclarationOrExpression: this step savedPosition: savePosition isConstructor: true
        ]
      ]
      // `Int inc = []` or `T? unpack = []`
      | TokenType.Identifier
      | TokenType.NullableIdentifier => [
        firstChar = tok lexeme first
        isTypeName = firstChar isUpperCase
        isTypeName ifTrue: [
          this messageDeclarationOrExpression: tok savedPosition: savePosition isConstructor: false
        ] ifFalse: [
          this nextExpression: tok
        ]
      ]
      | TokenType.Mut => [
        nextTok = this peek
        isTypeName = | nextTok kind
                    | TokenType.Identifier
                    | TokenType.NullableIdentifier
                    | TokenType.IdentifierDoubleColon => [
                      firstChar = nextTok lexeme first
                      firstChar isUpperCase
                    ]
                    |=> false
        isTypeName ifTrue: [
          this messageDeclarationOrExpression: tok savedPosition: savePosition isConstructor: false
        ] ifFalse: [
          this nextExpression: tok
        ]
      ]
      | TokenType.If => [
        this parseMatch: tok
      ]
      | TokenType.Return => [
        this parseReturnExpr: tok
      ]
      | TokenType.EndOfFile => [
        TO DO: "its impossible to be here, whileTrue from top stack goes until `done`"
      ]
      | TokenType.Invalid => [
        prevPrev = this peekAt: -2
        prev = this peekAt: -1
        cur = this peek
        pos = cur toPosition
        TO DO: pos + "Got invalid token after $prevPrev $prev $cur"
      ]
      | TokenType.IdentifierDoubleColon => [
        this parseVarDeclExpr: tok name: tok lexeme isMut: false // `::` for IdentifierDoubleColon is removed in lexer
      ]

      |=> [
        this nextExpression: tok
      ]

  ]
  // msg, msg, msg -> (((msg) msg) msg)
  on commaChainedExprs(tok): Token receiver: Expr -> Expr = [
     firstExpr = this nextExpression2: tok receiver: receiver
     mut expr = firstExpr
     [
       this peek kind == TokenType.Comma, ifTrue: [
          commaTok = this step // skip comma

          expr <- this nextExpression2: commaTok receiver: (ExprInBrackets token: commaTok value: expr)
          true
        ] ifFalse: [
          false
        ]
     ] whileTrue: []

     ^ expr
  ]

  /// `^ expr` | `expr`
  on nextExpression(tok): Token -> Expr = [
    mut result::Expr = NullExpr token: tok
    | tok kind
    | TokenType.Return => result <- this parseReturnExpr: tok
    | TokenType.Mut => [
      nextTok = this peek
      isTypeName = | nextTok kind
                  | TokenType.Identifier
                  | TokenType.NullableIdentifier
                  | TokenType.IdentifierDoubleColon => nextTok lexeme first isUpperCase
                  |=> false

      | isTypeName
      | true => [
        typeIdentifier = this parseDotSeparatedIdentifier: this step
        mutableType = MutableTypeIdentifier token: tok identifier: typeIdentifier
        result <- this commaChainedExprs: tok receiver: mutableType
      ]
      | false => [
        name = this step
        result <- this parseVarDeclExpr: name name: name lexeme isMut: true
      ]
    ]
    | TokenType.OpenParen => [
      inner = this nextExpression: this step
      this matchAssert: TokenType.CloseParen
      exprInBrackets = ExprInBrackets token: tok value: inner
      result <- this commaChainedExprs: tok receiver: exprInBrackets
    ]
    | TokenType.Dot => [
      thisIdentifier = Identifier token: tok name: "this" path: null
      result <- this commaChainedExprs: tok receiver: thisIdentifier
    ]
    | TokenType.If => result <- this parseMatch: tok
    | TokenType.IdentifierDoubleColon => result <- this parseVarDeclExpr: tok name: tok lexeme isMut: false
    |=> [
      destructuring = tok kind == TokenType.OpenBrace ifTrue: [
        this tryParseDestructingAssign: tok
      ] ifFalse: [null]
      result <- | destructuring
        | null => this nextExpressionFromPrimary: tok
        |=> destructuring
    ]
    result
  ]

  on nextExpressionFromPrimary(tok): Token -> Expr = [
    tok-pos = tok toPosition
    primaryMaybe = this primary: tok
    primaryReceiver = | primaryMaybe
      | null => [
        true ifTrue: [TO DO: tok-pos + "  nextExpression: no primary1 ($tok)"]
        NullExpr token: tok
      ]
      |=> primaryMaybe
    mut result::Expr = NullExpr token: tok
    | this peek kind
      | TokenType.Assign => result <- this parseVarDeclExpr: tok name: primaryReceiver token lexeme isMut: false
      | TokenType.AssignArrow => [
        this step
        value = this nextExpression: this step
        | primaryReceiver
        | Identifier => result <- Assign token: tok name: primaryReceiver name value: value
        |=> [
          true ifTrue: [TO DO: "<- expected identifier on the left side"]
          result <- NullExpr token: tok
        ]
      ]
      |=> [
        commaChainedExpr2 = this commaChainedExprs: tok receiver: primaryReceiver
        result <- commaChainedExpr2
        | this peek kind
        | TokenType.AssignArrow => [
          this step
          | commaChainedExpr2
          | UnaryMsg => [
            copyValue = this nextExpression: this step
            result <- ImmutableCopyUpdate token: tok target: commaChainedExpr2 value: copyValue
          ]
          |=> [
            true ifTrue: [TO DO: "<- immutable copy update expects a non-empty unary getter chain"]
            result <- NullExpr token: tok
          ]
        ]
        |=> []
      ]
    result
  ]

  on nextExpression2(tok): Token receiver: Expr? -> Expr = [
    // return expr
    tok kind == TokenType.Return ifTrue: [
      ^ this parseReturnExpr: tok
    ]
    // message expr
    primaryUnaryBinary = this parsePrimaryOrUnaryOrBinary: tok receiver: receiver
   ^| this peek kind
    | TokenType.IdentifierColon => [

      result::mut List::NameAndExpr = {}!
      // parse keyword
      [
        colon = this peek
        | colon kind
        | TokenType.IdentifierColon => [
          result add:
            (NameAndExpr
              name: (Identifier fromToken: this step)
              expr: (this parsePrimaryOrUnaryOrBinary: this step))
          true
        ]
        |=> [
          false
        ]
      ] whileTrue: []
      KeywordMsg
        receiver: primaryUnaryBinary
        token: tok
        args: result toList
        kind: MessageSendKind.Call

    ]
    |=> primaryUnaryBinary
  ]


  // returns
  // Primary
  // UnaryMsg
  // BinaryMsg
  on parsePrimaryOrUnaryOrBinary(tok): Token -> Expr = this parsePrimaryOrUnaryOrBinary: tok receiver: null
  on parsePrimaryOrUnaryOrBinary(tok): Token receiver: Expr? -> Expr = [
    maybePrimary =  | receiver
                    | null => [
                      tok kind == TokenType.OpenParen ifTrue: [
                        inner = this nextExpression: this step
                        this matchAssert: TokenType.CloseParen
                        ExprInBrackets token: tok value: inner
                      ] ifFalse: [
                        primaryMaybe = this primary: tok
                        | primaryMaybe
                        | null => [
                          true ifTrue: [TO DO: "nextExpression: no primary2 ($tok)"]
                          NullExpr token: tok
                        ]
                        |=> primaryMaybe
                      ]
                    ]
                    |=> receiver

    next = this peek

    // single primary before new line
    // or in other words just `42`

    // here, we need to know that it is not a `p` unary for "Ada", but new msg
    //        Person name: "Ada"
    //        p greet
    // the last token of the primary and not `tok`, because the primary itself can be
    // multiline, and then the msg is on the line of its last token(`[\n 1 echo \n] do`)
    lastTokOfPrimary = this peekAt: -1
    shouldReturnPrimary = (next line > lastTokOfPrimary line) && (lastTokOfPrimary lexeme != ",")
    mut result::Expr = maybePrimary
    shouldReturnPrimary ifFalse: [
      | next kind
      | TokenType.Identifier => [
        tok = this peek
        | tok kind
        | TokenType.Identifier => [
          unaryList = this parseManyIdentSeparated: null

          mut tempUnary = UnaryMsg
            receiver: maybePrimary
            token: tok
            selector: unaryList first
            kind: MessageSendKind.Call

          unaryList drop: 1, forEach: [
            newUnary = UnaryMsg
              receiver: tempUnary
              token: tok
              selector: it
              kind: MessageSendKind.Call
            tempUnary <- newUnary
          ]

          result <- tempUnary
          this peek kind == TokenType.BinarySymbol, ifTrue: [
            binaryList = this parseManyBinary
            result <- BinaryMsg
              receiver: tempUnary
              token: maybePrimary token
              args: binaryList toList
          ]
        ]
        | TokenType.BinarySymbol => [
          binaryList = this parseManyBinary
          result <- BinaryMsg
            receiver: maybePrimary
            token: maybePrimary token
            args: binaryList toList
        ]
        |=> []
      ]
      | TokenType.BinarySymbol => [
        binaryList = this parseManyBinary
        result <- BinaryMsg
          receiver: maybePrimary
          token: maybePrimary token
          args: binaryList
      ]
      |=> []
    ]

    result
  ]



  // / x| probably not just identifier without anything
  // / x = ...
  // / x inc ...
  // / X inc = []
  // / x + ...
  // / X + y::Int = []
  // / x that: ...
  // / X from::Int = []
  // / X from y:Int = []



  on match::TokenType -> Bool = [
    this peek kind == match, ifTrue: [
      this step
      ^ true
    ]

    false
  ]

  /// match Identifier|Nullable|Error
  on matchAssertAnyIdent(error): String -> Token = [
    tok = this peek

    ^ tok isIdentifier ifTrue: [
      this step
      tok
    ] ifFalse: [
      TO DO: error
    ]
  ]

  on matchAssert::TokenType -> Token = [
    peek = this peek
    peek kind == matchAssert, ifTrue: [
      ^ this step
    ]
    {line start} = peek
    TO DO: "$matchAssert expected but got $peek at: $line:$start"
  ]

  on matchString::String -> Bool = [
    this peek lexeme == matchString, ifTrue: [
      this step
      ^ true
    ]

    ^ false
  ]

  on check(kind): TokenType = this peek kind == kind

  on done = this check: TokenType.EndOfFile

  on step -> Token = [
    x = this peek
    x kind == TokenType.EndOfFile, ifTrue: [
      TO DO: "step: EOF"
    ]
    current <- current inc
    ^ x
  ]
  on stepBack -> Token = [
    x = this peekAt: -1
    current <- current dec
    ^ x
  ]

  /// if current is out of bounds returns EOF
  /// otherwise returns token at current position
  on peek -> Token = [
    outOfBounds = (current < 0) || (current >= tokens count)
    ^ outOfBounds ifTrue: [Token eof] ifFalse: [tokens at: current]
  ]
  on peekAt(distance): Int -> Token = [
    realDistance = current + distance
    outOfBounds = (realDistance < 0) || (realDistance >= tokens count)
    ^ outOfBounds ifTrue: [Token eof] ifFalse: [tokens at: realDistance]
  ]
]
