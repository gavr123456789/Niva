enum TokenType =
  |EndOfFile


  // Literal types
  |Integer
  |String
  |Char
  |Float // 4.2f
  |Double // 4.2
  |Identifier|NullableIdentifier|IdentifierColon|IdentifierDoubleColon
//    Binary| Octal| Hex|

  // Keywords
  |Type|Union|Constructor|Enum|Mut|ErrorDomain|Extend
  |True|False|Null
  |On // on for many messages declarations

  |Return // ^
  |ReturnArrow // -> for return types
  |AssignArrow // <-


  |If // |
  |Then // =>
  |Else // |=>

  // brackets
  |OpenParen|CloseParen // ()
  |OpenBrace|CloseBrace // {}
  |OpenBracket|CloseBracket // []
  |OpenBraceHash // #{
  |OpenParenHash // #(

  |UnitTok // ()

  // punctuation
  |Dot| Cascade| Comma| Colon// . :
  |Ampersand // &

  |DocComment   // Useful for documentation comments| pragmas| etc.
  |BinarySymbol    // A generic symbol
  |Assign // =

  |InlineReplWithNum // >Number| >3
  |InlineReplWithQuestion // >?
  |Bang // !
  |Invalid // used for identifiers

type Token
  kind: TokenType
  lexeme: String
  line: Int
  start: Int end: Int // at line

Token toString = "$kind($lexeme)"
Token toPosition = "testss.niva:" + line toString + ":" + start toString // TODO add file path

constructor Token fake = Token
  kind: TokenType.Identifier
  lexeme: "FakeToken"
  line: 1
  start: 0 end: 1

constructor Token eof = Token
  kind: TokenType.EndOfFile
  lexeme: ""
  line: 1
  start: 0 end: 1

extend Token [
  on isIdentifier =
    (kind == TokenType.Identifier) ||
    (kind == TokenType.NullableIdentifier) ||
    (kind == TokenType.IdentifierDoubleColon)
  on isNullOrIdentifier =
    (kind == TokenType.Identifier) ||
    (kind == TokenType.NullableIdentifier)

]

static Token lookupKeyword: String -> TokenType = | lookupKeyword
| "type" => TokenType.Type
| "mut" => TokenType.Mut
| "union" => TokenType.Union
| "enum" => TokenType.Enum
| "constructor" | "static" => TokenType.Constructor
| "errordomain" => TokenType.ErrorDomain
| "extend" => TokenType.Extend
| "on" => TokenType.On

| "true" => TokenType.True
| "false" => TokenType.False
| "null" => TokenType.Null
|=> TokenType.Identifier
