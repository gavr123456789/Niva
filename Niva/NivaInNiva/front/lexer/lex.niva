/// example
/// abcd
/// __^
/// pos = 2,
/// readPos = 3, because it one step ahead
/// ch = 'c'
type Lexer
  input: String
  pos: Int // updates when new token read
  readPos: Int // updates every step
  ch: Char
  line: Int
  posOnLine: Int
  file: SourceFile

constructor Lexer lex-input(input): String file(sf): SourceFile -> mut Lexer = [
  l::mut Lexer = Lexer input: input pos: 0 readPos: 0 ch: '\u0000' line: 1 posOnLine: 0 file: sf
  l step // add EOF, probably
  ^ l
]

constructor Lexer lex-input: String -> mut Lexer =
  Lexer lex-input: lex-input file: (SourceFile fake)


constructor Lexer get-tokens(input): String -> List(Token) = [
  lexer::mut Lexer = Lexer lex-input: input
  ^ lexer lex toList
]

constructor Lexer get-tokens(input): String file(sf): SourceFile -> List(Token) = [
  lexer::mut Lexer = Lexer lex-input: input file: sf
  ^ lexer lex toList
]

extend mut Lexer [
  on step = [
    readPos >= input count
      ifTrue: [ch <- '\u0000']
      ifFalse: [ch <- input at: readPos]

    pos       <- readPos
    readPos   <- readPos inc
    posOnLine <- posOnLine inc // resets to 0 on \n
  ]

  on peekChar = readPos == input count
    ifTrue:  ['\u0000']
    ifFalse: [input at: (this readPos)]

  on peekSecondChar = (readPos + 1) >= input count
    ifTrue:  ['\u0000']
    ifFalse: [input at: (readPos + 1)]

  on match(char): Char -> Bool =
    this ch == char
      ifTrue: [
        this step
        true
      ] ifFalse: [
        false
      ]

  on stepMatch(char): Char -> Bool = [
    this step
    ^this match: char
  ]

  on createToken(kind): TokenType lexeme: String -> Token = [
    tok = Token
      kind: kind
      lexeme: lexeme
      line: line
      start: posOnLine - lexeme count end: posOnLine//lexeme count
      file: file
    pos <- readPos
    ^ tok
  ]

  on nextToken -> Token = [
    this skipWhiteSpaces
    this skipComments




    l = ch toString


    tok = | ch
    | '\u0000' => [
      ^this createToken: TokenType.EndOfFile lexeme: l]
    | '=' => [
      this peekChar == '=', ifTrue: [
        this step
        this createToken: TokenType.BinarySymbol lexeme: "=="
      ] ifFalse: [
        this peekChar == '>', ifTrue: [
          this step
          this createToken: TokenType.Then lexeme: "=>"
        ] ifFalse: [
          this createToken: TokenType.Assign lexeme: "="
        ]
      ]
    ]

    | '|' => [
      this peekChar == '=', ifTrue: [
        this step
        this peekChar == '>', ifTrue: [
          this step
          this createToken: TokenType.Else lexeme: "|=>"
        ] ifFalse: [
          Error throwWithMessage: "expected |=>", orPANIC
        ]
      ] ifFalse: [
        this peekChar == '|', ifTrue: [
          this step
          this createToken: TokenType.BinarySymbol lexeme: "||"
        ] ifFalse: [
          this createToken: TokenType.If lexeme: "|"
        ]
      ]
    ]

    | '"' => [
      result = this parseStringLike: '"'
      kind = (result startsWith: "\"\"\"")
        ifTrue: [TokenType.RawString]
        ifFalse: [TokenType.String]
      ^ this createToken: kind lexeme: result
    ]
    | '\'' => [
      result = this parseStringLike: '\''
      ^ this createToken: TokenType.Char lexeme: result
    ]

    | '/' => this createToken: TokenType.BinarySymbol lexeme: l


    | '!' => [
      this peekChar == '=', ifTrue: [
        this step // consume '='
        this createToken: TokenType.BinarySymbol lexeme: "!="
      ] ifFalse: [
        this createToken: TokenType.Bang lexeme: "!"
      ]
    ]
    | '&' => [
      this peekChar == '&', ifTrue: [
        this step
        this createToken: TokenType.BinarySymbol lexeme: "&&"
      ] ifFalse: [
        this createToken: TokenType.Ampersand lexeme: "&"
      ]
    ]

    | '(' => [
      // avoid consuming the next char unless it's a unit "()"
      this peekChar == ')', ifTrue: [
        this step // move to ')'
        this createToken: TokenType.UnitTok lexeme: "()"
      ] ifFalse: [
        this createToken: TokenType.OpenParen lexeme: "("
      ]
    ]
    | ')' => this createToken: TokenType.CloseParen  lexeme: l
    | '[' => this createToken: TokenType.OpenBracket   lexeme: l
    | ']' => this createToken: TokenType.CloseBracket  lexeme: l
    | '{' => this createToken: TokenType.OpenBrace   lexeme: l
    | '}' => this createToken: TokenType.CloseBrace  lexeme: l
    | '#' => [
      this step
      | ch
      | '{' => this createToken: TokenType.OpenBraceHash lexeme: "#{"
      | '(' => this createToken: TokenType.OpenParenHash lexeme: "#("
      |=> [
        (ch isLetter || (ch == '_')) ifTrue: [
          lit = this readIdentifier
          ^ this createToken: TokenType.AtomIdentifier lexeme: "#" + lit
        ]
        Error throwWithMessage: "only { or ( or identifier can be after #", orPANIC
      ]
    ]


    | '-' => ^ this peekChar isDigit ifTrue: [
      this step // skip minus
      this numberTokenWithPrefix: "-"
    ] ifFalse: [
      this stepMatch: '>',
        ifTrue:  [this createToken: TokenType.ReturnArrow lexeme: "->"]
        ifFalse: [this createToken: TokenType.BinarySymbol lexeme: "-"]
    ]

    |'<' => [
      this peekChar == '=', ifTrue: [
        this step
        this createToken: TokenType.BinarySymbol lexeme: "<="
      ] ifFalse: [
        this peekChar == '-', ifTrue: [
          this step
          this createToken: TokenType.AssignArrow lexeme: "<-"
        ] ifFalse: [
          this createToken: TokenType.BinarySymbol lexeme: "<"
        ]
      ]
    ]

    |'>' => [
      this peekChar == '=', ifTrue: [
        this step
        this createToken: TokenType.BinarySymbol lexeme: ">="
      ] ifFalse: [
        this createToken: TokenType.BinarySymbol lexeme: ">"
      ]
    ]


    | '+' => this createToken: TokenType.BinarySymbol lexeme: l
    | '*' => this createToken: TokenType.BinarySymbol lexeme: l
    | '%' => this createToken: TokenType.BinarySymbol lexeme: l
    | ',' =>     this createToken: TokenType.Comma lexeme: l
    | '.' => [
      this peekChar == '.', ifTrue: [
        this step // consume second dot
        this createToken: TokenType.BinarySymbol lexeme: ".."
      ] ifFalse: [
        this createToken: TokenType.Dot lexeme: l
      ]
    ]
    | ':' =>     this createToken: TokenType.Colon lexeme: l
    | '^' =>     this createToken: TokenType.Return  lexeme: l

    |=> [
      ch isLetter || (ch == '_') ifTrue: [
        pos == readPos ifTrue: [
          pos <- pos dec
        ]
        lit = this readIdentifier
        tt = Token lookupKeyword: lit

        ch isDigit ifTrue: [
          litDigit = this parseNumber
          ^ this createToken: TokenType.Identifier lexeme: lit + litDigit
        ]


        ^| ch
        | ':' => [
          this step
          | ch
          | ':' => [
            this step
            this createToken: TokenType.IdentifierDoubleColon lexeme: lit
          ]
          |=> this createToken: TokenType.IdentifierColon lexeme: lit
        ]
        | '?' => [
          this step
          this createToken: TokenType.NullableIdentifier lexeme: lit
        ]
        |=> [
          this createToken: tt lexeme: lit
        ]
      ]
      ch isDigit ifTrue: [
        ^ this numberTokenWithPrefix: ""
      ]

      this createToken: TokenType.Invalid lexeme: l
    ]

    this step
    ^ tok
  ]

  on lex -> mut List(Token) = [
    mut newTok = this nextToken
    mut tokens::mut List(Token) = {newTok}!

    [newTok kind != TokenType.EndOfFile] whileTrue: [
      newTok <- this nextToken
      tokens add: newTok
    ]
    ^ tokens
  ]
  /// skip symbols until line end
  on skipCurrentLine = [
    [(ch != '\n') && (ch != '\u0000')] whileTrue: [
      this step
    ]
    this match: '\n', ifTrue: [
      line <- line inc
      posOnLine <- 0
    ]
  ]
]



/// delimiter was already eaten
mut Lexer parseStringLike(delimiter): Char -> String = [
  mut escaped = false
  localPos = pos

  isRaw = (delimiter == '"') && (this peekChar == '"') && (this peekSecondChar == '"')
  ^ isRaw ifTrue: [
    mut found = false
    this match: '"'
    this match: '"'
    this match: '"'
    [(ch != '\u0000') && (found == false)] whileTrue: [
      ((ch == '"') && (this peekChar == '"') && (this peekSecondChar == '"')) ifTrue: [
        found <- true
      ] ifFalse: [
        this step
      ]
    ]
    found == false ifTrue: [
      TO DO: "unterminated string literal"
    ]
    this match: '"'
    this match: '"'
    this match: '"'
    input slice: localPos..(pos - 1)
  ] ifFalse: [
    this match: delimiter
    [(ch != delimiter) || escaped] whileTrue: [
      ch == '\u0000' ifTrue: [
        TO DO: "unterminated string literal"
      ]

      escaped ifTrue: [
        escaped <- false
        this step
      ] ifFalse: [
        ch == '\\' ifTrue: [
          escaped <- true
          this step
        ] ifFalse: [
          this step
        ]
      ]
    ]

    this match: delimiter
    input slice: localPos..(pos - 1)
  ]
]

mut Lexer readIdentifier -> String = [
  localPos = pos

  [ch isLetter || ch isDigit || (ch == '_') || (ch == '-')] whileTrue: [
    this step
  ]

  // A bang is part of a value identifier only when it is adjacent to it and
  // really terminates the identifier. Uppercase names are types, where `!`
  // is the existing error-type separator (`Int!Error`, `Int!{Error}`).
  firstChar = input at: localPos
  nextChar = readPos >= input count ifTrue: ['\u0000'] ifFalse: [this peekChar]
  nextIsIdentifierChar = nextChar isLetter || nextChar isDigit ||
    (nextChar == '_') || (nextChar == '-')
  isBangSuffix = (ch == '!') &&
    (firstChar isLowerCase || (firstChar == '_')) &&
    (nextChar != '=') && nextIsIdentifierChar not && (nextChar != '{')
  isBangSuffix ifTrue: [
    this step
  ]

  result = input slice: localPos..(pos - 1) //readPos dec
  ^result
]

mut Lexer parseNumber -> String = [
  localPos = pos
  [ch isDigit || ((ch == '_') && (this peekChar isDigit))] whileTrue: [
    this step
  ]

  result = input slice: localPos..(pos - 1) // readPos dec
  ^result
]

mut Lexer numberTokenWithPrefix(prefix): String -> Token = [
  intPart = this parseNumber
  mut full = prefix + intPart

  ch == '.' ifTrue: [
    this peekChar isDigit ifTrue: [
      this step // consume '.'
      frac = this parseNumber
      full <- full + "." + frac
      | ch
      | 'f' => [
        this step
        ^ this createToken: TokenType.Float lexeme: full + "f"
      ]
      |=> [^ this createToken: TokenType.Double lexeme: full]
    ]
  ]

  ^ this createToken: TokenType.Integer lexeme: full
]

mut Lexer skipWhiteSpaces = [
  [(ch == ' ') || (ch == '\t') || (ch == '\n') || (ch == '\r')] whileTrue: [

    ch == '\n' ifTrue: [
      line <- line inc
      posOnLine <- 0
    ]
    this step

  ]

]

mut Lexer skipComments = [
  [
    this skipWhiteSpaces

    savePoint = readPos
    |ch
    | '/' => [
      this peekChar == '/',
        ifTrue: [
          this skipCurrentLine
          true
        ]
        ifFalse: [
          false
        ]
    ]
    |=> [
      false
    ]
  ] whileTrue: []
]
