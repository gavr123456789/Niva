// why is these good? - some errors can contain second place in code to show!
union ResolveErrors tok: Token msg: String =
| ErrorNoSuchType
| ErrorWrongArgType
| ErrorWrongArgCount
| ErrorInvalidTry
| LazyError

ResolveErrors toConsoleMsg -> String = [
  pos = tok toPosition
  ^ pos + " " + msg
]

union AstVisitor =
| PrintingVisitor
| TypeDeclVisitor db: TyperDB
| MsgDeclVisitor

PrintingVisitor visit(st): Statement = [
  st echo
  "--------------" echo
]

/// returns pkg to message decl
/// entryPointStatements just all statements from the main.niva
/// not only expr
TypeDeclVisitor
  visitAllTypesThenTypesAndMethods(fileToStatements): Map(String, List(Statement))
  entryPointStatements: List(Statement)
  -> Map(String, List(MessageDecl)) = [

  pkgTotypeDecls2::mut List(Tuple(String, TypeDecl)) = {}!
  noFieldsTypes::mut Map(String, TypeT) = #{}!
  msgDeclsByPkg::mut Map(String, mut List(MessageDecl)) = #{}!
  unionIncludes::mut Map(String, mut List(Tuple(String, Token))) = #{}!
  unionRoots::mut Set(String) = #()!

  // collect union roots before processing branches
  fileToStatements forEach: [file, statements ->
    statements forEach: [
      | it | UnionDecl => [
        rootId = file + "." + it name
        unionRoots add: rootId
      ] |=> []
    ]
  ]

  addMsgDecl = [pkg::String, msgDecl::MessageDecl ->
    newList::mut List(MessageDecl) = {}!
    listMaybe = msgDeclsByPkg at: pkg
    | listMaybe
    | null => ()
    |=> [
      listMaybe forEach: [existing -> newList add: existing]
      ()
    ]
    newList add: msgDecl
    msgDeclsByPkg at: pkg put: newList
  ]

  processDeclarations = [file::String, statements::List(Statement) ->
    pkgName = file

    db addNewPkgIfNotExists: pkgName

    // save all types (without fields), and msg decls
    statements forEach: [
      | it
      | TypeDecl => [
        noFieldsType = TypeT noFieldsWithName: it name :pkgName
        it genericParams forEach: [genericParam ->
          genericArg::NivaType = UnresolvedGenericT name: genericParam
          noFieldsType genericArgs add: genericArg
        ]
        isBind = db isBindStatement: it
        isBind ifTrue: [
          db markBindTypeId: (noFieldsType toMangledName)
        ]
        noFieldsTypes at: it name put: noFieldsType
        pkgTotypeDecls2 add: (Tuple x: pkgName y: it)
        ()
      ]
      | MessageDecl => [
        addMsgDecl pkg: pkgName msg: it
        ()
      ]
      | ExtendDecl => [
        it messages forEach: [
          addMsgDecl pkg: pkgName msg: it
        ]
      ]
      | UnionDecl => [
        isErrorDomain = it token kind == TokenType.ErrorDomain
        common = it commonUnionFields

        rootId = pkgName + "." + it name

        rootDecl = TypeDecl
          token: it token
          name: it name
          genericParams: it genericParams
          fields: common
        rootStub = TypeT noFieldsWithName: rootDecl name :pkgName
        it genericParams forEach: [genericParam ->
          genericArg::NivaType = UnresolvedGenericT name: genericParam
          rootStub genericArgs add: genericArg
        ]
        isBind = db isBindStatement: it
        isBind ifTrue: [
          db markBindTypeId: (rootStub toMangledName)
        ]
        noFieldsTypes at: rootDecl name put: rootStub
        pkgTotypeDecls2 add: (Tuple x: pkgName y: rootDecl)

        branchNames::mut List(String) = {}!
        it branches forEach: [branch ->
          branchNames add: branch name
          branchId = pkgName + "." + branch name
          branch isInclude ifTrue: [
            unionRoots contains: branchId, ifFalse: [
              db addErrorMessage: (LazyError tok: branch token msg: "Union include branch " + branch name + " must be a union")
            ]
            branch fields isNotEmpty ifTrue: [
              db addErrorMessage: (LazyError tok: branch token msg: "Union include branch " + branch name + " can't declare fields")
            ]

            includesMaybe = unionIncludes at: rootId
            includes::mut List(Tuple(String, Token)) =
              | includesMaybe
              | null => {}!
              |=> includesMaybe
            includes add: (Tuple x: branchId y: branch token)
            unionIncludes at: rootId put: includes
            ()
          ] ifFalse: [
            fields::mut List::TypeField = {}!
            common forEach: [fields add: it]
            branch fields forEach: [fields add: it]

            fullDecl = TypeDecl
              token: branch token
              name: branch name
              genericParams: it genericParams
              fields: fields toList

            noFieldsType = TypeT noFieldsWithName: fullDecl name :pkgName
            it genericParams forEach: [genericParam ->
              genericArg::NivaType = UnresolvedGenericT name: genericParam
              noFieldsType genericArgs add: genericArg
            ]
            isBind = db isBindStatement: it
            isBind ifTrue: [
              db markBindTypeId: (noFieldsType toMangledName)
            ]
            noFieldsTypes at: fullDecl name put: noFieldsType
            pkgTotypeDecls2 add: (Tuple x: pkgName y: fullDecl)
            ()
          ]
        ]

        db registerUnion: it name inPkg: pkgName branches: branchNames toList
        isErrorDomain ifTrue: [
          db registerUnionIds: "core.Error" branches: {rootId}
        ]
      ]
      | EnumDecl => [
        noFieldsType = TypeT noFieldsWithName: it name :pkgName
        noFieldsTypes at: it name put: noFieldsType
        db addNewType: noFieldsType inPkg: pkgName
        db registerTypeDeclaration: noFieldsType token: it token
        db addNewConstructor: noFieldsType generateDefaultConstructor forType: noFieldsType
        ()
      ]
      |=> []
    ]
  ]

  // first iteration, fill the lists of statements, create pkgs
  fileToStatements forEach: [file, statements ->
    processDeclarations :file :statements
  ]

  fillTypesAndMessages = [
    pkgTotypeDecls2 forEach: [ tuple ->
      pkgName = tuple x
      typeDecl = tuple y

      readyToAddToDBTypeMaybe = this fillFields: typeDecl knownTypes: noFieldsTypes
      | readyToAddToDBTypeMaybe
      | null => [
        name = typeDecl name
        TO DO: "cant fill fields for $name"
        ()
      ]
      |=> [
        resolvedType = readyToAddToDBTypeMaybe

        db
          addNewType: resolvedType
          inPkg: pkgName
        db registerTypeDeclaration: resolvedType token: typeDecl token

        // add fields

        db
          addNewConstructor: resolvedType generateDefaultConstructor
          forType: resolvedType


        // это снова происходит внутри  .fillFields
        // нет, это нельзя делать в фил филдс потому что addNewMethod использует уже добавленый тип, а там все на стабах недобавленных
        addFields = [
          resolvedType fields forEach: [ field ->

            getter = NivaMethod
              name: field name
              receiverType: resolvedType
              args: {}
              returnType: field typeT
              returnErrors: {}!
              forMut: false // false because its getter
              possibleErrors: {}
              kind: MessageSendKind.Getter
              decl: null
              protocolName: "getters"
              pkgName: "core" // this is getter
              isInline: false

            db addNewMethod: getter forType: resolvedType inProtocol: "getters"

          ]
        ] do
        ()
      ]
  ]


  sameFieldsAs = [rootType::TypeT, includedType::TypeT ->
    rootType fields count > includedType fields count ifTrue: [false] ifFalse: [
      mut allOk = true
      rootType fields forEach: [f ->
        allOk ifTrue: [
          incField = includedType findField: f name
          | incField
          | null => allOk <- false
          |=> [
            db isAssignable: (f typeT) toExpected: (incField typeT), ifFalse: [
              allOk <- false
            ]
          ]
        ]
      ]
      allOk
    ]
  ]

  // validate union includes (same fields as root)
  validateUnionIncludes = [
    unionIncludes forEach: [rootId, includes ->
      rootTypeMaybe = db typesById at: rootId
      rootTypeMaybe ifNotNull: [rootTypeValue ->
        includes forEach: [inc ->
          includedId = inc x
          tok = inc y
          includedTypeMaybe = db typesById at: includedId
          | includedTypeMaybe
          | null => []
          |=> [
            sameFieldsAs rootType: rootTypeValue includedType: includedTypeMaybe, ifFalse: [
              msg = "Union include " + includedTypeMaybe name + " must have the same fields as " + rootTypeValue name
              db addErrorMessage: (LazyError :tok :msg)
            ]
          ]
        ]
      ]
    ]
  ] do

  // msg decls resolving
  // here we should have all the types resolved

// first resolve all the declarations
// then resolve all others method's bodies
    msgDeclsByPkg forEach: [pkg, msgList ->
    msgList forEach: [ msg ->

      // get real type for receiver

      receiverAst = msg receiver
      receiverType = receiverAst toNivaTypefromDB: db inPkg: null

      checkThatReceiverSpecifiedGenerics = [
        receiverNeedsGenerics = | receiverType
                                | TypeT => receiverType genericArgs isNotEmpty
                                |=> false

        receiverDeclaresGenerics = | receiverAst
                                   | AstType => receiverAst genericParams isNotEmpty
                                   |=> false

        receiverNeedsGenerics && receiverDeclaresGenerics not ifTrue: [
          db addErrorFromTok: receiverAst tok
            withMsg: "Receiver type " + receiverType name + " requires generic params"
        ]
      ] do


      // get real type for each arg
      argsT = msg args map: [ arg ->
        argType = arg astType toNivaTypefromDB: db inPkg: null // we cant know the concrete pkg here
        argTypeInfo = arg astType toTypeInfoFromDb: db inPkg: null
        TypeTField name: arg name typeT: argType isMut: argTypeInfo isMut
      ]


      astOfReceiver = msg receiver
      isMutable = | astOfReceiver
                  | AstType => astOfReceiver isMut
                  | AstLambdaType => false


      msg isConstructor ifTrue: [
        constructorMethod = NivaMethod
          defaultConstructorWithName: msg name
          :receiverType
          args: argsT
          returnType: (msg getReturnTypeIfDeclaredOrUnknown: db)
          decl: msg
          protocolName: "constructors"
          pkgName: pkg

        db addNewConstructor: constructorMethod forType: receiverType
        ()
      ] ifFalse: [
        msgReturnTypeMaybe = msg returnType
        returnErrors::List(NivaType) = | msgReturnTypeMaybe
          | null => {}
          |=> msgReturnTypeMaybe toErrorsFromDb: db inPkg: null

        method = NivaMethod
          name: msg name
          :receiverType
          args: argsT
          returnType: (msg getReturnTypeIfDeclaredOrUnknown: db) // if generic need to resolve
          :returnErrors
          forMut: isMutable
          possibleErrors: {}
          kind: MessageSendKind.Call
          decl: msg
          protocolName: "common"
          pkgName: pkg
          isInline: msg isInline

        db registerMethodDeclaration: receiverType name: msg name token: msg token
        db addNewMethod: method forType: receiverType inProtocol: null
        ()
      ]
    ]]

// resolve main
  ] do
  ^ msgDeclsByPkg
]

/// infer return type when declaration omits one
MessageDecl getReturnTypeIfDeclaredOrUnknown(db): TyperDB -> NivaType = [
  rt = returnType
  ^ | rt
      | null => [
        | isSingleExpr
        | true => Unknown new
        | false => db dtc unit
      ]
    |=> rt toNivaTypefromDB: db inPkg: null
]

/// returns a type with fields filled with real types, ready to add to db
/// find type or record an error
TypeDeclVisitor fillFields(st): TypeDecl knownTypes::mut Map(String, TypeT) -> TypeT? = [
  name = st name
  typeStub = knownTypes at: name

  | typeStub
  | null => [
    resolveError::ResolveErrors = ErrorNoSuchType tok: st token msg: "type $name not found"
    db addErrorMessage: resolveError

    null
  ]
  |=> [


    st fields forEach: [
      fieldType = it astType toNivaTypefromDBWithKnown: db :knownTypes
      astFieldType = it astType
      isMut = | astFieldType
              | AstType => astFieldType isMut
              | AstLambdaType => false

      field = TypeTField name: it name typeT: fieldType :isMut
      typeStub fields add: field

    ]


    // Keep explicitly declared generics and add any field-inferred generics that
    // old syntax relied on.
    knownGenerics::mut Set(String) = #()!
    typeStub genericArgs forEach: [knownGenerics add: it name]
    typeStub collectGenerics forEach: [
      knownGenerics contains: it name, ifFalse: [
        knownGenerics add: it name
        typeStub genericArgs add: it
      ]
    ]
    typeStub
  ]
]

MsgDeclVisitor processBodyes(pkg2Msg): Map(String, List(MessageDecl)) db::TyperDB = [
  pkg2Msg forEach: [pkgStr, msgList ->
    pkgMaybe = db packages at: pkgStr
    pkg = pkgMaybe expect: "Missing package $pkgStr"

    msgList forEach: [msgDecl ->
      receiverType = msgDecl receiver toNivaTypefromDB: db inPkg: null
      extraTypes::mut Map(String, NivaType) =
        | receiverType
        | TypeT => [
          generics::mut Map(String, NivaType) = #{}!
          receiverType genericArgs forEach: [
            generics at: it name put: it
          ]
          generics
        ] |=> #{}!
      msgDecl resolveBodyWithDb: db :pkg :extraTypes
    ]
  ]
]

MessageDecl resolveBodyWithDb(db): TyperDB pkg: NivaPkg extraTypes: mut Map(String, NivaType) -> TypedBody = [
  receiverType = receiver toNivaTypefromDB: db inPkg: null
  cachedBodyMaybe = db typedBodiesCache at: (this messageDeclKey)
  ^ | cachedBodyMaybe
    | null => [
      resolveBody = [
  // put extra types to db
  previousGenericScope::mut Map(String, NivaType) = #{}!
  db localGenericScope forEach: [name, genericValue ->
    previousGenericScope at: name put: genericValue
  ]
  extraTypes forEach: [name, valueT -> db localGenericScope at: name put: valueT]

  methodFromDb = db declToMethod at: (this messageDeclKey)
  resolvedArgsFromDb = | methodFromDb
    | null => null
    |=> methodFromDb args
  canUseDbArgs =
    | resolvedArgsFromDb
    | null => false
    |=> resolvedArgsFromDb count == args count
  returnTypeMaybe = returnType
  expectedReturnType = | returnTypeMaybe
    | null => null
    |=> returnTypeMaybe toNivaTypefromDB: db inPkg: null

  createContextWithThisAndArgs = [
    c = Context rootWithPkg: pkg returnType: expectedReturnType
    receiverType name == "Nothing" ifTrue: [
      TO DO: "You cant declare methods for Nothing type"
    ]

    c defineVar: "this" withType: (receiver toTypeInfoFromDb: db inPkg: null)


    args forEachIndexed: [i, it ->
      argTypeInfoFromAst = it astType toTypeInfoFromDb: db inPkg: null
      argType =
        | resolvedArgsFromDb
        | null => argTypeInfoFromAst t
        |=> [
          canUseDbArgs
            ifTrue: [resolvedArgsFromDb at: i, typeT]
            ifFalse: [argTypeInfoFromAst t]
        ]

      errorsList = it astType toErrorsFromDb: db inPkg: null
      c defineVar: it name withType: (TypeInfo t: argType isMut: argTypeInfoFromAst isMut listOfErrors: errorsList)
    ]

    receiverFields::mut List(TypeTField) =
      | receiverType
      | Complex => receiverType fields
      |=> {}!

    receiverFields forEach: [
      existingArg = c vars at: it name
      existingArg == null ifTrue: [
        c defineVar: it name withType: (TypeInfo t: it typeT isMut: it isMut listOfErrors: {})
      ]
    ]

    c
  ]
  // resolve body
  c = createContextWithThisAndArgs do

  typedBody = body resolveBody2: db withContext: c expectedType: expectedReturnType includeNonLocalReturns: true

  finalTypedBody =
    isSingleExpr ifTrue: [
      bodyExprs::mut List::TypedExpr2 = typedBody v toMutableList
      bodyExprs isNotEmpty ifTrue: [
        lastExpr = bodyExprs last
        | lastExpr
        | ReturnStatementT => []
        | VarDeclarationT
        | AssignT
        | DestructingAssignT => [
          returnStatement::TypedExpr2 = ReturnStatementT
            token: lastExpr token
            typeInfo: db dtc unit toTypeInfoDefault
            value: null
          bodyExprs add: returnStatement
          ()
        ]
        |=> [
          newBody::mut List(TypedExpr2) = (bodyExprs dropLast: 1, toMutableList)
          returnStatement::TypedExpr2 = ReturnStatementT
            token: lastExpr token
            typeInfo: lastExpr typeInfo
            value: lastExpr
          newBody add: returnStatement
          bodyExprs clear
          bodyExprs addAll: newBody
          ()
        ]
      ]
      TypedBody v: bodyExprs toList t: typedBody t listOfErrors: typedBody listOfErrors
    ] ifFalse: [typedBody]

  noDeclaredReturnType = returnType == null
  shouldInferSingleExprReturnType =
    isConstructor ifTrue:  [false]
                  ifFalse: [isSingleExpr && noDeclaredReturnType && finalTypedBody v isNotEmpty]

  shouldInferSingleExprReturnType ifTrue: [
    methodsMaybe = db typeToMethodNameToMethod at: (receiverType toMangledName)
    | methodsMaybe
    | null => ()
    |=> [
      existingMethodMaybe = methodsMaybe at: name
      | existingMethodMaybe
      | null => []
      |=> [
        | existingMethodMaybe returnType
        | Unknown => [
          inferredRt = finalTypedBody t
          updatedMethod = existingMethodMaybe copyWithDifferentReturnType: inferredRt
          db replaceMethod: updatedMethod inType: receiverType
        ]
        |=> []
      ]
    ]
  ]

  actualReturnErrors = finalTypedBody listOfErrors
  hasAnyReturnErrors = | returnTypeMaybe
    | null => false
    |=> returnTypeMaybe hasAnyErrorMarker
  declaredReturnErrors =
    hasAnyReturnErrors
      ifTrue: [actualReturnErrors]
      ifFalse: [
        | returnTypeMaybe
        | null => {}
        |=> returnTypeMaybe toErrorsFromDb: db inPkg: null
      ]

  // check the inferred body type explicitly after the body has been resolved
  // since single expr bodies can omit the return type

  // check that last expr type == return type declared
  // so skipping
  // empty declaration in a .bind.niva file is implemented by the target runtime, so its synthetic Unit body must not be checked as the function's declared return type.
  isBindDeclaration = db isBindMessageDecl: this
  isExternalBind = isBindDeclaration && (isSingleExpr not) && (body unTypedBody isEmpty)

  declaresErrorEffect = hasAnyReturnErrors || declaredReturnErrors isNotEmpty
  (declaresErrorEffect && actualReturnErrors isEmpty && (isBindDeclaration not)) ifTrue: [
    declaredShown = hasAnyReturnErrors
      ifTrue: ["! (at least one inferred error)"]
      ifFalse: [declaredReturnErrors errorsToString]
    db addErrorMessage: (LazyError
      tok: token
      msg: "Function " + name + " declares error effects " + declaredShown + ", but its body cannot produce an error")
  ]

  (hasAnyReturnErrors not) && (isExternalBind not), ifTrue: [
    declaredReturnTypeMaybe = expectedReturnType
    | declaredReturnTypeMaybe
    | null => ()
    |=> [
      // generic return types are checked after method specialization,
      // when their concrete mapping is known
      declaredReturnTypeMaybe isContainsUnresolvedGenerics ifFalse: [
        actualReturnType = finalTypedBody t
        actualReturnType isAssignableTo: declaredReturnTypeMaybe :db, ifFalse: [
          db addErrorMessage: (ErrorWrongArgType
            tok: token
            msg: "Function " + name + " returns " + actualReturnType toString + ", but " + declaredReturnTypeMaybe toString + " is declared")
        ]
      ]
    ]
  ]

  hasAnyReturnErrors ifTrue: [
    methodFromDbMaybe = methodFromDb
    methodFromDbMaybe ifNotNull: [methodFromDbValue ->
      updatedMethod = methodFromDbValue copyWithDifferentReturnErrors: actualReturnErrors
      db replaceMethod: updatedMethod inType: updatedMethod receiverType
    ]
  ]

  (hasAnyReturnErrors not) && (declaredReturnErrors errorListCovers: actualReturnErrors :db, not), ifTrue: [
    declaredStr = declaredReturnErrors errorsToString
    actualStr = actualReturnErrors errorsToString
    declaredShown = declaredStr == "" ifTrue: ["none"] ifFalse: [declaredStr]
    actualShown = actualStr == "" ifTrue: ["none"] ifFalse: [actualStr]
    db addErrorMessage: (LazyError
      tok: token
      msg: "Function " + name + " error effects mismatch: declared " + declaredShown + ", actual " + actualShown)
  ]

  db localGenericScope clear
  previousGenericScope forEach: [name, genericValue ->
    db localGenericScope at: name put: genericValue
  ]
  db typedBodiesCache at: (this messageDeclKey) put: finalTypedBody
        finalTypedBody
      ]
      resolveBody do
    ]
    |=> cachedBodyMaybe
]




AstVisitor visit(st): Statement = [
  | this
  | PrintingVisitor => this visit: st
  | TypeDeclVisitor => [

    | st
    | TypeDecl => this visit: st
    |=>[]
    ()
  ]
  | MsgDeclVisitor => [
    TO DO: "msg visitor is not implemented"
  ]

]
