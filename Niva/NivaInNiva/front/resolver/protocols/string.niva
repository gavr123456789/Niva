constructor NivaProtocol stringFromDefaultTypes(dtc): DefaultTypesContainer  -> mut Map(String, NivaMethod) = [
  {int str bool char unit list intRange double} = dtc

  strProto = NivaProtocol common
  // unary
  strProto addMethod: (NivaMethod unary: "toInt" receiverType: str returnT: int)
  strProto addMethod: (NivaMethod unary: "toDouble" receiverType: str returnT: double)
  strProto addMethod: (NivaMethod unary: "first" receiverType: str returnT: char)
  strProto addMethod: (NivaMethod unary: "count" receiverType: str returnT: int)
  strProto addMethod: (NivaMethod unary: "reversed" receiverType: str returnT: str)
  strProto addMethod: (NivaMethod unary: "lowercase" receiverType: str returnT: str)
  strProto addMethod: (NivaMethod unary: "trimIndent" receiverType: str returnT: str)
  strProto addMethod: (NivaMethod unary: "isEmpty" receiverType: str returnT: bool)
  strProto addMethod: (NivaMethod unary: "isNotEmpty" receiverType: str returnT: bool)
  // binary
  strProto addMethod: (NivaMethod binary: "+" receiverType: str argT: str returnT: str)

  strProto addMethod: (NivaMethod binary: "==" receiverType: str argT: str returnT: bool)
  strProto addMethod: (NivaMethod binary: "!=" receiverType: str argT: str returnT: bool)
  strProto addMethod: (NivaMethod binary: "<" receiverType: str argT: str returnT: bool)
  strProto addMethod: (NivaMethod binary: ">" receiverType: str argT: str returnT: bool)
  strProto addMethod: (NivaMethod binary: "<=" receiverType: str argT: str returnT: bool)
  strProto addMethod: (NivaMethod binary: ">=" receiverType: str argT: str returnT: bool)

  // keyword
  strProto addMethod: (NivaMethod singleArgKw: "at" receiverType: str argT: int returnT: char )
  strProto addMethod: (NivaMethod singleArgKw: "slice" receiverType: str argT: intRange returnT: str)
  strProto addMethod: (NivaMethod singleArgKw: "contains" receiverType: str argT: str returnT: bool )
  strProto addMethod: (NivaMethod singleArgKw: "repeat" receiverType: str argT: int returnT: str)
  strProto addMethod: (NivaMethod singleArgKw: "startsWith" receiverType: str argT: str returnT: bool)
  strProto addMethod: (NivaMethod singleArgKw: "endsWith" receiverType: str argT: str returnT: bool)
  strProto addMethod: (NivaMethod singleArgKw: "substringAfter" receiverType: str argT: str returnT: str)
  strProto addMethod: (NivaMethod singleArgKw: "substringBefore" receiverType: str argT: str returnT: str)
  strProto addMethod: (NivaMethod singleArgKw: "substringAfterLast" receiverType: str argT: str returnT: str)
  strProto addMethod: (NivaMethod singleArgKw: "substringBeforeLast" receiverType: str argT: str returnT: str)
  strProto addMethod: (NivaMethod singleArgKw: "drop" receiverType: str argT: int returnT: str )
  strProto addMethod: (NivaMethod singleArgKw: "dropLast" receiverType: str argT: int returnT: str )
  strProto addMethod: (NivaMethod singleArgKw: "split" receiverType: str argT: str returnT: (ListT t: str) )

  itArg = TypeTField name: "it" typeT: char isMut: false
  foreachBlock = FuntionT
                fields: { itArg }!
                  name: "forEach"
           genericArgs: {}!
               pkgName: "core"
            returnType: unit
  strProto addMethod: ((NivaMethod singleArgKw: "forEach" receiverType: str argT: foreachBlock returnT: unit) markedInline)

  filterBlock = FuntionT
                fields: { itArg }!
                  name: "filter"
           genericArgs: {}!
               pkgName: "core"
            returnType: bool
  strProto addMethod: (NivaMethod singleArgKw: "filter" receiverType: str argT: filterBlock returnT: str)

  mapBlock = FuntionT
           fields: { (TypeTField name: "it" typeT: char isMut: false) }!
             name: "map"
      genericArgs: {}!
          pkgName: "core"
       returnType: str

  strProto addMethod: (NivaMethod singleArgKw: "map"
                receiverType: str
                        argT: mapBlock
                        returnT: str)

  args = {(TypeTField name: "replace" typeT: str isMut: false)
          (TypeTField name: "with" typeT: str isMut: false)}
  strProto addMethod: (NivaMethod manyArgKw: args receiverType: str returnT: str )

  ^ strProto methods
]
