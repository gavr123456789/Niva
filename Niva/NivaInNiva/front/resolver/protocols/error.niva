// helper to build a throwing method shared by all error domain protocols
constructor NivaMethod errorThrowMethod(name): String errorType: NivaType nothing: NivaType str: NivaType hasArg: Bool =
  NivaMethod
    :name
    receiverType: errorType
    genericTypeArgs: {}
    args: (hasArg ifTrue: [{(TypeTField :name typeT: str isMut: false)}] ifFalse: [{}])
    returnType: nothing
    returnErrors: {errorType}
    forMut: false
    possibleErrors: {}
    kind: MessageSendKind.Call
    decl: null
    protocolName: "common"
    pkgName: "core"
    isInline: false

constructor NivaProtocol errorFromDefaultTypes(dtc): DefaultTypesContainer errorType::NivaType -> mut Map(String, NivaMethod) = [
  {str nothing} = dtc

  errProto = NivaProtocol common
  errProto addMethod: (NivaMethod errorThrowMethod: "throw" :errorType :nothing :str hasArg: false)
  errProto addMethod: (NivaMethod errorThrowMethod: "throwWithMsg" :errorType :nothing :str hasArg: true)
  errProto addMethod: (NivaMethod errorThrowMethod: "throwWithMessage" :errorType :nothing :str hasArg: true)

  ^ errProto methods
]
