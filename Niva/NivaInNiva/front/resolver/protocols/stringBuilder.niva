constructor NivaProtocol stringBuilderFromDefaultTypes(dtc): DefaultTypesContainer sb: NivaType -> mut Map(String, NivaMethod) = [
  {str int} = dtc

  sbProtocol = NivaProtocol name: "arithmetic"

  // unary
  sbProtocol addMethod: (NivaMethod unary: "count" receiverType: sb returnT: int)
  sbProtocol addMethod: (NivaMethod unary: "clear" receiverType: sb returnT: sb)
  sbProtocol addMethod: (NivaMethod unary: "toString" receiverType: sb returnT: str)
  sbProtocol addMethod: (NivaMethod unary: "trim" receiverType: sb returnT: str)
  // keyword
  sbProtocol addMethod: (NivaMethod singleArgKw: "append" receiverType: sb argT: str returnT: sb )
  sbProtocol addMethod: (NivaMethod singleArgKw: "appendLine" receiverType: sb argT: str returnT: sb )

  ^ sbProtocol methods
]
