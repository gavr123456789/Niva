

// collect names used in body
Expr collectExprRefNames(refs): mut Set(String) -> Unit = [
  | this
  | Identifier => [ name first isUpperCase ifFalse: [refs add: name] ]
  | ExprInBrackets => value collectExprRefNames: refs
  | VarDeclaration => value collectExprRefNames: refs
  | Assign => value collectExprRefNames: refs
  | ImmutableCopyUpdate => [
    target collectExprRefNames: refs
    value collectExprRefNames: refs
  ]
  | DestructingAssign => value collectExprRefNames: refs
  | ReturnStatement => [
    returnValue = value
    | returnValue
    | null => []
    |=> returnValue collectExprRefNames: refs
  ]
  | UnaryMsg => [
    // compile time info about type
    (selector name == "info") || (selector name == "infoFull")
      ifFalse: [receiver collectExprRefNames: refs]
  ]
  | BinaryMsg => [
    receiver collectExprRefNames: refs
    args forEach: [it expr collectExprRefNames: refs]
  ]
  | KeywordMsg => [
    receiver collectExprRefNames: refs
    args forEach: [it expr collectExprRefNames: refs]
  ]
  | MessageSend => [ receiver collectExprRefNames: refs ]
  | CodeBlock => body unTypedBody forEach: [it collectExprRefNames: refs]
  | Match => [
    subject collectExprRefNames: refs
    branches forEach: [br ->
      br condition collectExprRefNames: refs
      br additionalConditions unTypedBody forEach: [it collectExprRefNames: refs]
      br body unTypedBody forEach: [it collectExprRefNames: refs]
    ]
    elseBranchMaybe = elseBranch
    | elseBranchMaybe
    | null => []
    |=> elseBranchMaybe unTypedBody forEach: [it collectExprRefNames: refs]
  ]
  | CollectionLiteral => elements unTypedBody forEach: [it collectExprRefNames: refs]
  | LiteralExpr => []
  | TypedExpr => exprAst collectExprRefNames: refs
  |=> []
]

// find first non generated getter in update target
UnaryMsgT firstNonGetterInCopyUpdate -> Token? = [
  | true
  | kind != MessageSendKind.Getter => selector token
  |=> [
    localReceiver = receiver
    | localReceiver
      | UnaryMsgT => localReceiver firstNonGetterInCopyUpdate
      |=> null
  ]
]

// expand chained update syntax
// x wallet money value <- v into
UnaryMsg expandImmutableCopyUpdate(value): Expr -> Expr = [
  localReceiver = receiver
  shadowCopy = KeywordMsg
    receiver: localReceiver
    token: token
    args: {(NameAndExpr name: selector expr: value)}
    kind: MessageSendKind.Call

  | localReceiver
    | UnaryMsg => localReceiver expandImmutableCopyUpdate: shadowCopy
    |=> shadowCopy
]

extend Body [
  on resolveBody2(db): TyperDB withContext(upperContext): Context  -> TypedBody =
    this resolveBody2: db withContext: upperContext expectedType: null

  /// resolve body inside expressions
  /// expected type comes from surrounding expression
  on resolveBody2(db): TyperDB withContext(upperContext): Context expectedType: NivaType? -> TypedBody = [

    c = Context fromParent: upperContext

    unTypedBody forEach: [it collectExprRefNames: c currentBlockRefNames]

    unTypedBody isEmpty ifTrue: [
      ^ TypedBody v: {} t: db dtc unit listOfErrors: {}
    ]

    lastIndex = unTypedBody count - 1
    listOfTypedExpr2 = unTypedBody mapIndexed: [ i, expr ->
      isLast = i == lastIndex
      expectedForExpr =
        | expectedType
        | null => null
        |=> [
          | expr
          | ReturnStatement => expectedType
          |=> (isLast ifTrue: [expectedType] ifFalse: [null])
        ]

      typed = expr toTypedExprFromDb2: db withContext: c expectedType: expectedForExpr
      typeOfExpr = typed typeInfo t
      | typeOfExpr | Unknown => [
        TO DO: "Unknown type of expr is not possible $expr"
      ] |=> []

      typed
    ]


    returnTypes::mut List(NivaType) = {}!
    listOfTypedExpr2 forEach: [expr ->
      | expr
      | ReturnStatementT => returnTypes add: expr typeInfo t
      |=> []
    ]

    bodyErrors::mut List(NivaType) = {}!
    listOfTypedExpr2 forEach: [expr ->
      expr typeInfo listOfErrors forEach: [bodyErrors add: it]
    ]

    bodyType =
      returnTypes isNotEmpty
        ifTrue: [
          merged = db mergeTypesByUnion: returnTypes
          | merged
          | null => returnTypes first
          |=> merged
        ]
        ifFalse: [listOfTypedExpr2 last typeInfo t]

    TypedBody v: listOfTypedExpr2
                t: bodyType
                listOfErrors: (bodyErrors normalizeErrorList)
  ]

  /// resolve collection elements with expected type
  on resolveCollectionElements(db): TyperDB withContext(upperContext): Context expectedEven: NivaType? expectedOdd: NivaType? -> TypedBody = [
    (expectedEven == null) && (expectedOdd == null) ifTrue: [
      ^ this resolveBody2: db withContext: upperContext
    ]

    c = Context fromParent: upperContext
    unTypedBody forEach: [it collectExprRefNames: c currentBlockRefNames]

    typedElems = unTypedBody mapIndexed: [ i, elem ->
      expectedForElem = i % 2 == 0 ifTrue: [expectedEven] ifFalse: [expectedOdd]
      elem toTypedExprFromDb2: db withContext: c expectedType: expectedForElem
    ]

    bodyErrors::mut List(NivaType) = {}!
    typedElems forEach: [expr ->
      expr typeInfo listOfErrors forEach: [bodyErrors add: it]
    ]

    TypedBody
        v: typedElems
        t: (typedElems isEmpty ifTrue: [db dtc unit] ifFalse: [typedElems last typeInfo t])
        listOfErrors: (bodyErrors normalizeErrorList)
  ]
]

List(NivaType) normalizeErrorList -> List(NivaType) = [
  seen::mut Set(String) = #()!
  result::mut List(NivaType) = {}!

  this forEach: [err ->
    errId = err pkgName + "." + err name
    seen contains: errId, ifFalse: [
      seen add: errId
      result add: err
    ]
  ]

  result toList
]

List(NivaType) errorListEquals(other): List(NivaType) -> Bool = [
  left = this normalizeErrorList
  right = other normalizeErrorList
  | true
  | left count != right count => false
  |=> [
    rightIds = (right map: [it pkgName + "." + it name]) toSet
    missing = left find: [err ->
      rightIds contains: (err pkgName + "." + err name), not
    ]

    missing == null
  ]
]

List(NivaType) errorListCovers(actual): List(NivaType) db: TyperDB -> Bool = [
  declared = this normalizeErrorList
  actualNormalized = actual normalizeErrorList

  missing = actualNormalized find: [actualError ->
    covered = declared any: [declaredError ->
      db isAssignable: actualError toExpected: declaredError
    ]
    covered not
  ]

  missing == null
]

List(NivaType) errorsToString -> String =
  this normalizeErrorList joinWith: ", " transform: [it name]

NivaType sameTypeAsMany(types): List(NivaType) -> Int? = [
  types forEachIndexed: [i, it ->
    this sameTypeAs: it, ifFalse: [^ i]
  ]
  null
]

extend TyperDB [
  on checkUnionMatchExhaustiveness(subjectType): NivaType branches: List(MatchBranchT) elseBranch: TypedBody? token: Token = [
    | subjectType
    | TypeT => [
      unionLeaves = this unionLeaves: subjectType
      elseBranch == null ifTrue: [
        checkedLeaves::mut Set(String) = #()!

        addCheckedBranch = [expr::TypedExpr2 ->
          | expr
          | IdentifierT => [
            expr isNameOfTheType ifTrue: [
              branchType = expr typeInfo t
              | branchType
              | TypeT => [
                this isUnionBranch: branchType ofRoot: subjectType, ifTrue: [
                  branchId = branchType toIdString
                  sub = unionRootToBranches at: branchId
                  | sub
                  | null => checkedLeaves add: branchId
                  |=> [
                    subLeaves = this unionLeaves: branchType
                    subLeaves forEach: [checkedLeaves add: it]
                  ]
                ]
              ]
              |=> []
            ]
          ]
          |=> []
        ]

        branches forEach: [branch ->
          addCheckedBranch expr: branch condition
          branch additionalConditions v forEach: [cond ->
            addCheckedBranch expr: cond
          ]
        ]

        allLeaves = unionLeaves toList
        missing = allLeaves
                    filter: [branchId -> checkedLeaves contains: branchId, not],
                    map: [branchId ->
                          branchType = typesById at: branchId
                          branchTypeMaybe = branchType
                          name = | branchTypeMaybe
                            | null => branchId
                            |=> branchTypeMaybe name
                          name]

        missing isNotEmpty ifTrue: [
          missingSorted = missing sortedBy: [it]
          msg = "Not all possible variants have been checked (" + (missingSorted joinWith: ", " transform: [it]) + ")"
          this addErrorMessage: (LazyError tok: token msg: msg)
        ]
      ]
    ]
    |=> []
  ]

  on checkErrorMatchExhaustiveness(subjectErrors): List(NivaType) branches: List(MatchBranchT) token: Token = [
    | true
    | subjectErrors isEmpty => ()
    |=> [
      leaves::mut Set(String) = #()!
      subjectErrors forEach: [err ->
        | err
        | TypeT => [
          errLeaves = this unionLeaves: err
          (errLeaves count == 0)
            ifTrue: [
              leaves add: err toIdString
              ()
            ]
            ifFalse: [
              leaves addAll: errLeaves
              ()
            ]
        ]
        |=> []
      ]

      checked::mut Set(String) = #()!
      branches forEach: [branch ->
        branchType = branch condition typeInfo t
        | branchType
        | TypeT => [
          leaves forEach: [leafId ->
            leafType = typesById at: leafId
            leafTypeMaybe = leafType
            | leafTypeMaybe
            | null => []
            |=> [
              this isAssignable: leafTypeMaybe toExpected: branchType, ifTrue: [
                checked add: leafId
              ]
            ]
          ]
        ]
        |=> []
      ]

      allLeaves = leaves toList
      missing = allLeaves
        filter: [leafId -> checked contains: leafId, not],
        map: [leafId ->
          branchType = typesById at: leafId
          branchTypeMaybe = branchType
          | branchTypeMaybe
          | null => leafId
          |=> branchTypeMaybe name
        ]

      missing isNotEmpty ifTrue: [
        missingSorted = missing sortedBy: [it]
        msg = "Not all possible errors have been handled (" + (missingSorted joinWith: ", " transform: [it]) + ")"
        this addErrorMessage: (LazyError tok: token msg: msg)
      ]
    ]
  ]
]

CodeBlock resolveWithExpectedType(db): TyperDB withContext(upperContext): Context expectedType: FuntionT -> CodeBlockT = [
  c = Context fromParent: upperContext

  expectedFields = expectedType fields

  typeTFields::List(TypeTField) = args isNotEmpty
    ifTrue: [
      args map: [
        {name astType} = it
        t = astType toNivaTypefromDB: db inPkg: null
        errorsList = astType toErrorsFromDb: db inPkg: null
        c defineVar: name withType: (TypeInfo t: t isMut: false listOfErrors: errorsList)
        TypeTField name: name typeT: t isMut: false
      ]
    ]
    ifFalse: [
      untypedArgs isNotEmpty
        ifTrue: [
          expectedFields count != untypedArgs count ifTrue: [
            db addErrorMessage: (ErrorWrongArgCount tok: token msg: "Wrong number of block args, expected " + expectedFields count toString)
          ]

          expectedFields count != untypedArgs count
            ifTrue: [
              noTypeTFields::List(TypeTField) = {}
              noTypeTFields
            ]
            ifFalse: [
              untypedArgs mapIndexed: [i, ident ->
                expectedField = expectedFields at: i
                c defineVar: ident name withType: expectedField typeT toTypeInfoDefault
                TypeTField name: ident name typeT: expectedField typeT isMut: expectedField isMut
              ]
            ]
        ]
        ifFalse: [
          expectedFields count == 1
            ifTrue: [
              expectedField = expectedFields first
              c defineVar: expectedField name withType: expectedField typeT toTypeInfoDefault
              { expectedField }
            ]
            ifFalse: [
              expectedFields isNotEmpty ifTrue: [
                db addErrorMessage: (ErrorWrongArgCount tok: token msg: "Block has no args, but expected " + expectedFields count toString)
              ]
              noTypeTFields::List(TypeTField) = {}
              noTypeTFields
            ]
        ]
    ]

  genericList = typeTFields
                  filter: [
                    {typeT} = it
                    | typeT
                    | UnresolvedGenericT => [true]
                    |=> [false]
                  ],
                  map: [it typeT]

  typedArgs::List(IdentifierT) = untypedArgs isNotEmpty
    ifTrue: [
      expectedFields count == untypedArgs count
        ifTrue: [
          untypedArgs mapIndexed: [i, ident ->
            expectedField = expectedFields at: i
            IdentifierT
              token: ident token
              typeInfo: expectedField typeT toTypeInfoDefault
              name: ident name
              path: ident path
              isNameOfTheType: false
          ]
        ]
        ifFalse: [
          untypedArgs map: [ident ->
            IdentifierT
              token: ident token
              typeInfo: db dtc any toTypeInfoDefault
              name: ident name
              path: ident path
              isNameOfTheType: false
          ]
        ]
    ]
    ifFalse: [
      noTypedArgs::List(IdentifierT) = {}
      noTypedArgs
    ]

  expectedReturnType = expectedType returnType
  typedBody = body resolveBody2: db withContext: c expectedType: expectedReturnType
  returnType = typedBody t

  name = args isNotEmpty
    ifTrue: [args joinWith: "__" transform: [it astType name]]
    ifFalse: [
      typedArgs isNotEmpty
        ifTrue: [typedArgs joinWith: "__" transform: [it name]]
        ifFalse: [expectedType name]
    ]

  CodeBlockT token: token
    typeInfo: (FuntionT
                name: name
                pkgName: c currentPkg name
                fields: typeTFields toMutableList
                genericArgs: genericList toMutableList
                returnType: returnType
                returnErrors: typedBody listOfErrors) toTypeInfoDefault
    args: args
    typedArgs: typedArgs
    body: typedBody
]


Expr toTypedExprFromDb2: TyperDB withContext: Context -> TypedExpr2 =
  this toTypedExprFromDb2: toTypedExprFromDb2 withContext: withContext expectedType: null

Expr toTypedExprFromDb2(db): TyperDB withContext(c): Context expectedType: NivaType? -> TypedExpr2 = [
  result = | this
  | CharExpr    => CharExprT token: token typeInfo: db dtc char toTypeInfoDefault
  | IntExpr     => IntExprT token: token typeInfo: db dtc int toTypeInfoDefault
  | FloatExpr   => FloatExprT token: token typeInfo: db dtc float toTypeInfoDefault
  | DoubleExpr  => DoubleExprT token: token typeInfo: db dtc double toTypeInfoDefault
  | StringExpr  => StringExprT token: token typeInfo: db dtc str toTypeInfoDefault
  | BooleanExpr => BooleanExprT token: token typeInfo: db dtc bool toTypeInfoDefault
  | NullExpr    => NullExprT token: token typeInfo: (NullableT v: db dtc nothing) toTypeInfoDefault
  | UnitExpr    => UnitExprT token: token typeInfo: db dtc unit toTypeInfoDefault
  | AtomIdentifier => AtomExprT token: token typeInfo: db dtc str toTypeInfoDefault name: name
  | Identifier   => [

    varType = c lookupForVar: this name
    | varType
    | null => [
      name first isUpperCase ifTrue: [
        q = db findByTypeName: name

        IdentifierT token: token typeInfo: q toTypeInfoDefault name: name path: path isNameOfTheType: true
      ] ifFalse: [
        thisType = c lookupForVar: "this"
        | thisType
        | null => [
          contextString = c allKnownVars
          pos = token toPosition toString
          TO DO: "Cant find $this in the current context: \n$contextString " + pos
        ]
        |=> [
          thisIdent = IdentifierT
            token: token
            typeInfo: thisType
            name: "this"
            path: null
            isNameOfTheType: false

          methodMaybe = db
            findMethodInAllProtocols: name
            forType: thisType t
            receiver: thisIdent

          | methodMaybe
          | null => [
            // try to resolve union branch field
            thisTypeT = thisType t
            | thisTypeT
            | TypeT => [
              unionField = db findUnionField: thisTypeT fieldName: name
              | unionField
              | null => [
                contextString = c allKnownVars
                TO DO: "Cant find $this in the current context: \n$contextString"
              ]
              |=> [
                getter = NivaMethod
                  name: name
                  receiverType: thisTypeT
                  args: {}
                  returnType: unionField typeT
                  returnErrors: {}!
                  forMut: false
                  possibleErrors: {}
                  kind: MessageSendKind.Getter
                  decl: null
                  protocolName: "getters"
                  pkgName: thisTypeT pkgName

                UnaryMsgT
                  receiver: thisIdent
                  token: token
                  typeInfo: getter returnTypeInfo
                  dbMsg: getter
                  selector: (Identifier token: token name: name path: null)
                  kind: getter kind
              ]
            ]
            |=> [
              contextString = c allKnownVars
              TO DO: "Cant find $this in the current context: \n$contextString"
            ]
          ]
          |=> [
            methodMaybe kind != MessageSendKind.Getter ifTrue: [
              contextString = c allKnownVars
              TO DO: "Cant find $this in the current context: \n$contextString"
            ]

            UnaryMsgT
              receiver: thisIdent
              token: token
              typeInfo: methodMaybe returnTypeInfo
              dbMsg: methodMaybe
              selector: (Identifier token: token name: name path: null)
              kind: methodMaybe kind
          ]
        ]
      ]
    ]
    |=> IdentifierT token: token typeInfo: varType name: name path: path isNameOfTheType: false

  ]
  | MutableTypeIdentifier => [
    typeIdentifier = identifier
    q = db findByTypeName: typeIdentifier name
    IdentifierT
      token: typeIdentifier token
      typeInfo: (TypeInfo t: q isMut: true listOfErrors: {})
      name: typeIdentifier name
      path: typeIdentifier path
      isNameOfTheType: true
  ]
  | ExprInBrackets => [
    valueT = value toTypedExprFromDb2: db withContext: c
    ExprInBracketsT token: token typeInfo: valueT typeInfo value: valueT
  ]
  | MapLiteral     => [
    expectedTypeMaybe = expectedType
    expectedMap = | expectedTypeMaybe
      | null => null
      |=> [
      unwrapped = expectedTypeMaybe unwrapNullable
      | unwrapped
      | MapT => unwrapped
      |=> null
    ]

    this elements unTypedBody count % 2 != 0 ifTrue: [
      db addErrorMessage: (ErrorWrongArgCount tok: this token msg: "Number of arguments for Map should be even")
    ]
    this elements unTypedBody isEmpty ifTrue: [
      mapType = | expectedMap
        | null => TO DO: "Can't infer type of the Map collection without elements at " + token file path + ":" + token line toString
        |=> expectedMap
      typedBody = TypedBody v: {} t: db dtc unit listOfErrors: {}
      db addCollectionInstantiationIfAbsent: mapType
      ^ MapLiteralT
        token: token
        elements: typedBody
        typeInfo: (TypeInfo t: mapType isMut: isMutable listOfErrors: {})
    ]

    typedBody = elements
      resolveCollectionElements: db
      withContext: c
      expectedEven: (| expectedMap
        | null => null
        |=> expectedMap k)
      expectedOdd: (| expectedMap
        | null => null
        |=> expectedMap v)

    elems = typedBody v
    typesOfElems = elems map: [it typeInfo t]

    keyTypes::mut List(NivaType) = {}!
    valueTypes::mut List(NivaType) = {}!
    typesOfElems forEachIndexed: [i, it ->
      i % 2 == 0 ifTrue: [keyTypes add: it] ifFalse: [valueTypes add: it]
    ]

    mergedKeyType = db mergeTypesByUnion: keyTypes
    mergedValueType = db mergeTypesByUnion: valueTypes
    first = | mergedKeyType
            | null => keyTypes first
            |=> mergedKeyType
    second = | mergedValueType
             | null => valueTypes first
             |=> mergedValueType

    wrongKeyIndex = | mergedKeyType
                    | null => first sameTypeAsMany: (keyTypes drop: 1)
                    |=> null
    wrongKeyIndexMaybe = wrongKeyIndex
    | wrongKeyIndexMaybe
    | null => []
    |=> [
      wrongElement = elems at: (wrongKeyIndexMaybe * 2 + 2)
      db addErrorMessage: (ErrorWrongArgType tok: this token
                            msg: "Wrong type of $wrongElement element, $first key type expected")
    ]

    wrongValueIndex = | mergedValueType
                      | null => second sameTypeAsMany: (valueTypes drop: 1)
                      |=> null
    wrongValueIndexMaybe = wrongValueIndex
    | wrongValueIndexMaybe
    | null => []
    |=> [
      wrongElement = elems at: (wrongValueIndexMaybe * 2 + 3)
      db addErrorMessage: (ErrorWrongArgType tok: this token
                            msg: "Wrong type of $wrongElement element, $second value type expected")
    ]


    mapType = db addCollectionInstantiationIfAbsent: (MapT k: first v: second)

    MapLiteralT
      token: token
      elements: typedBody
      typeInfo: (TypeInfo t: mapType isMut: isMutable listOfErrors: {})
  ]
  | ListLiteral | SetLiteral => [
    this elements unTypedBody isEmpty ifTrue: [
      // if expectedType is null then error, if not then
      //
      expectedTypeMaybe = expectedType
      expectedCollectionType = | expectedTypeMaybe
        | null => null
        |=> [
          | expectedTypeMaybe
          | NullableT => expectedTypeMaybe v
          | Unknown => null
          |=> expectedTypeMaybe
        ]

      | expectedCollectionType
      | null => TO DO: "Can't infer type of the ListLiteral | SetLiteral without elements at " + token file path + ":" + token line toString
      |=> [
        | expectedCollectionType
        | ListT => [
          typedBody = TypedBody v: {} t: db dtc unit listOfErrors: {}
          db addCollectionInstantiationIfAbsent: expectedCollectionType
          ^ ListLiteralT token: token elements: typedBody typeInfo: (TypeInfo t: expectedCollectionType isMut: isMutable listOfErrors: {})
        ]
        | SetT => [
          typedBody = TypedBody v: {} t: db dtc unit listOfErrors: {}
          db addCollectionInstantiationIfAbsent: expectedCollectionType
          ^ SetLiteralT token: token elements: typedBody typeInfo: (TypeInfo t: expectedCollectionType isMut: isMutable listOfErrors: {})
        ]
        |=> [TO DO: "Expected List|Set for empty collection, got " + expectedCollectionType toString + " at " + token file path + ":" + token line toString]

      ]
    ]
    expectedTypeMaybe = expectedType
    expectedElem = | expectedTypeMaybe
      | null => null
      |=> [
      unwrapped = expectedTypeMaybe unwrapNullable
      | unwrapped
      | ListT => unwrapped t
      | SetT => unwrapped t
      |=> null
    ]

    typedBody = elements
      resolveCollectionElements: db
      withContext: c
      expectedEven: expectedElem
      expectedOdd: expectedElem

    elems = typedBody v
    typesOfElems = elems map: [it typeInfo t]
    // Collection elements may be different branches of the same union.
    // Reuse the same common-union-root merge used for match return types.
    mergedElementType = db mergeTypesByUnion: typesOfElems
    f = | mergedElementType
        | null => typesOfElems first
        |=> mergedElementType
    numberOfWrongElementType = | mergedElementType
      | null => f sameTypeAsMany: (typesOfElems drop: 1)
      |=> null
    wrongElementIndex = numberOfWrongElementType
    | wrongElementIndex
    | null => []
    |=> [
      wrongElement = elems at: wrongElementIndex
      db addErrorMessage: (ErrorWrongArgType tok: this token msg: "Wrong type of $wrongElement element, $f type expected")
    ]

    astType =
      | this
      | ListLiteral => [
        newType = db addCollectionInstantiationIfAbsent: (ListT t: f)
        ListLiteralT token: token elements: typedBody typeInfo: (TypeInfo t: newType isMut: isMutable listOfErrors: {})
      ]
      | SetLiteral => [
        newType = db addCollectionInstantiationIfAbsent: (SetT t: f)
        SetLiteralT token: token elements: typedBody typeInfo: (TypeInfo t: newType isMut: isMutable listOfErrors: {})
      ]
      | MapLiteral => [TO DO: "Impossible, we are inside ListLiteral | SetLiteral, but niva dont shrinc enougth"]

      astType
  ]
  | UnaryMsg   => [
    isFullInfo = selector name == "infoFull"
    (selector name == "info") || isFullInfo ifTrue: [
      receiverTyped = receiver toTypedExprFromDb2: db withContext: c
      (db compileTimeInfoFor: receiverTyped typeInfo t showSourceLocations: isFullInfo) echo
      ^ UnitExprT token: token typeInfo: db dtc unit toTypeInfoDefault
    ]
    ^ this resolveUnaryFromDb2: db withContext: c
  ]
  | BinaryMsg  => [
    this args isEmpty, ifTrue: [TO DO: "Compiler bug: binary without args"]
    ^ this replaceArgsWithTypedfromDb2: db withContext: c
  ]
  | KeywordMsg =>[
    this args isEmpty, ifTrue: [TO DO: "Compiler bug: keyword without args is like a single identifier"]
    ^ this resolveKeywordFromDb2: db withContext: c nameOverride: null expectedType: expectedType
  ]

  | ImmutableCopyUpdate => [
    typedTarget = target resolveUnaryFromDb2: db withContext: c
    invalidGetter = typedTarget firstNonGetterInCopyUpdate
    invalidGetterMaybe = invalidGetter
    | invalidGetterMaybe
    | null => typedTarget
    |=> [
      value toTypedExprFromDb2: db withContext: c
      db addErrorFromTok: invalidGetterMaybe withMsg: "Immutable copy update path can contain only unary getters"
      ^ typedTarget
    ]

    expanded = target expandImmutableCopyUpdate: value
    ^ expanded toTypedExprFromDb2: db withContext: c expectedType: expectedType
  ]

  | VarDeclaration  => [

    mut declaredType::NivaType? = null
    mut declaredTypeInfo::TypeInfo? = null
    declaredAstTypeMaybe = this astType
    | declaredAstTypeMaybe
    | null => []
    |=> [
      nivaType = declaredAstTypeMaybe toNivaTypefromDB: db inPkg: null
      declaredType <- nivaType
      declaredTypeInfo <- declaredAstTypeMaybe toTypeInfoFromDb: db inPkg: null
    ]

    typedExpr = this value toTypedExprFromDb2: db withContext: c expectedType: declaredType

    declaredTypeMaybe = declaredType
    | declaredTypeMaybe
    | null => []
    |=> [
      db isAssignable: typedExpr typeInfo t toExpected: declaredTypeMaybe,
        ifFalse: [
          valName = name
          astTypeName = declaredType toString
          realTypeName = typedExpr typeInfo t toString
          db addErrorFromTok: this token withMsg: "Type declared for $valName is not equal for it's value type $astTypeName != $realTypeName"
        ]
    ]

    declaredTypeInfoMaybe = declaredTypeInfo
    varTypeInfo = | declaredTypeInfoMaybe
      | null => typedExpr typeInfo
      |=> declaredTypeInfoMaybe
    untypedValue = this value
    valueIsTry = | untypedValue
                 | UnaryMsg => untypedValue selector name == "try"
                 |=> false
    bindingTypeInfo = valueIsTry
      ifTrue: [TypeInfo t: typedExpr typeInfo t isMut: typedExpr typeInfo isMut listOfErrors: {}]
      ifFalse: [varTypeInfo]
    c defineVar: name withType: bindingTypeInfo

    isVarUsed = c currentBlockRefNames contains: name

    VarDeclarationT
      token: token
      typeInfo: (TypeInfo t: db dtc unit isMut: false listOfErrors: typedExpr typeInfo listOfErrors)
      name: name
      value: typedExpr
      astType: astType
      isMut: isMut
      isUsed: isVarUsed

  ]
  | Assign => [
      method_receiver = c lookupForVar: "this"
      kind = | method_receiver
              | null => AssignKind.TO_LOCAL_MUT
              |=> [
                  found_field = method_receiver t findField: name
                  | found_field
                  | null => AssignKind.TO_LOCAL_MUT
                  |=>       AssignKind.TO_THIS_FIELD
              ]

    AssignT token: token typeInfo: db dtc unit toTypeInfoDefault name: name value: (value toTypedExprFromDb2: db withContext: c) kind: kind
  ]
  | DestructingAssign => [
    typedValue = value toTypedExprFromDb2: db withContext: c
    valueType = typedValue typeInfo t

    typedBindings = bindings map: [binding ->
      DestructureBindingT
        localName: binding localName
        fieldName: binding fieldName
        isUsed: (c currentBlockRefNames contains: binding localName)
    ]

    typedBindings forEach: [binding ->
      fieldName = binding fieldName
      field = valueType findField: fieldName
      | field
      | null => [
        errMsg = | valueType
                 | Complex => "Type " + valueType name + " has no field " + fieldName
                 |=> "Destructing assign expects complex type, got " + valueType name
        db addErrorMessage: (LazyError tok: token msg: errMsg)
      ]
      |=> [
        c defineVar: binding localName withType: field typeT toTypeInfoDefault
      ]
    ]

    DestructingAssignT
      token: token
      typeInfo: db dtc unit toTypeInfoDefault
      bindings: typedBindings
      value: typedValue
  ]
  | ReturnStatement =>[
    valueMaybe = value
    valueT = | valueMaybe
      | null => null
      |=> valueMaybe toTypedExprFromDb2: db withContext: c expectedType: expectedType
    returnInfo =
      | valueT
      | null => db dtc unit toTypeInfoDefault
      |=> valueT typeInfo

    ReturnStatementT token: token
                     typeInfo: returnInfo
                     value: valueT
  ]

  | CodeBlock => [
    c = Context fromParent: c

    typeTFields::List(TypeTField) = args isNotEmpty
      ifTrue: [
        args map: [
          {name astType} = it
          t = astType toNivaTypefromDB: db inPkg: null
          errorsList = astType toErrorsFromDb: db inPkg: null
          c defineVar: name withType: (TypeInfo t: t isMut: false listOfErrors: errorsList)
          TypeTField name: name typeT: t isMut: false
        ]
      ]
      ifFalse: [
        untypedArgs isNotEmpty
          ifTrue: [
            untypedArgs map: [ident ->
              unresolvedT = UnresolvedGenericT name: ident name
              c defineVar: ident name withType: unresolvedT toTypeInfoDefault
              TypeTField name: ident name typeT: unresolvedT isMut: false
            ]
          ]
          ifFalse: [
            noTypeTFields::List(TypeTField) = {}
            noTypeTFields
          ]
      ]

    genericList = typeTFields
                    filter: [
                      {typeT} = it
                      | typeT
                      | UnresolvedGenericT => [true]
                      |=> [false]
                    ],
                    map: [it typeT]

    typedUntypedArgs::List(IdentifierT) = untypedArgs isNotEmpty
      ifTrue: [
        untypedArgs mapIndexed: [i, ident ->
          typeField = typeTFields at: i
          IdentifierT
            token: ident token
            typeInfo: typeField typeT toTypeInfoDefault
            name: ident name
            path: ident path
            isNameOfTheType: false
        ]
      ]
      ifFalse: [
        noTypedArgs::List(IdentifierT) = {}
        noTypedArgs
      ]


    typedBody = body resolveBody2: db withContext: c
    returnType = typedBody t

    name = args isNotEmpty
      ifTrue: [args joinWith: "__" transform: [it astType name]]
      ifFalse: [
        typedUntypedArgs isNotEmpty
          ifTrue: [typedUntypedArgs joinWith: "__" transform: [it name]]
          ifFalse: [""]
      ]

    CodeBlockT token: token
      typeInfo: (FuntionT
                  name: name
                  pkgName: c currentPkg name
                  fields: typeTFields toMutableList
                  genericArgs: genericList toMutableList
                  returnType: returnType
                  returnErrors: typedBody listOfErrors) toTypeInfoDefault
      args: args
      typedArgs: typedUntypedArgs
      body: typedBody
  ]
  | Match     => [

    rawElseBranch = this elseBranch // local smart cast
    isMatchingOnThis = subject token lexeme == "this"

    mut hasNullBranch = false
    branches forEach: [br ->
      br condition isNullExpr ifTrue: [hasNullBranch <- true]
      br additionalConditions unTypedBody forEach: [e ->
        e isNullExpr ifTrue: [hasNullBranch <- true]
      ]
    ]

    subjectT = subject toTypedExprFromDb2: db withContext: c
    subjectType = subjectT typeInfo t
    subjectErrors = subjectT typeInfo listOfErrors
    isErrorMatch = subjectErrors isNotEmpty
    //// resolve branches ////

    // type narrowing to non-nullable inside else branch
    rawElseBranchMaybe = rawElseBranch
    elseBranchT = | rawElseBranchMaybe
      | null => null
      |=> [
        mut elseContext = c
        isErrorMatch ifTrue: [
          elseContext <- Context fromParent: c
          elseContext defineVar: "it" withType: subjectType toTypeInfoDefault
        ]
        | subjectType
        | NullableT => [
          hasNullBranch ifTrue: [
            | subjectT
            | IdentifierT => [
              narrowed = subjectType unwrapNullable
              elseContext <- Context fromParent: c
              elseContext defineVar: subjectT name withType: narrowed toTypeInfoDefault
            ]
            |=> []
          ]
        ]
        |=> []
        typedElseBody = rawElseBranchMaybe resolveBody2: db withContext: elseContext expectedType: expectedType
        typedElseBody
      ]


    returnTypes::mut List(NivaType) = {}!
    branchesT = branches map: [br ->
      contextIfThisMatching = isMatchingOnThis
                                ifTrue: [
                                  newC = Context fromParent: c
                                  newC
                                ]
                                ifFalse:[c]
      //contextIfThisMatching vars keys toList isEmpty ifTrue: [
      //                                              ] ifFalse: [
      //                                              ]
      //// resolve additionalConditions and branches ////
      conditionT = br condition toTypedExprFromDb2: db withContext: contextIfThisMatching

      isTypeBranch = | conditionT
        | IdentifierT => conditionT isNameOfTheType
        |=> false

      conditionTypeInfo = conditionT typeInfo
      mut narrowedTypeInfo = conditionTypeInfo
      (isTypeBranch && (isErrorMatch not)) ifTrue: [
        conditionType = conditionTypeInfo t
        | conditionType
        | TypeT => [
          | subjectType
          | TypeT => [
            letterToType::mut Map(String, NivaType) = #{}!
            sameType = ((conditionType name) == (subjectType name)) && ((conditionType pkgName) == (subjectType pkgName))
            sameType ifTrue: [
              conditionType collectGenericMappingsFrom: subjectType into: letterToType db: db
            ] ifFalse: [
              parentMaybe = db findUnionParent: subjectType
              genericSource = | parentMaybe
                | null => subjectType
                |=> parentMaybe
              ((genericSource genericArgs count) == (subjectType genericArgs count)) ifTrue: [
                genericSource genericArgs forEachIndexed: [i, g ->
                  letterToType at: g name put: (subjectType genericArgs at: i)
                ]
              ]
            ]
            (letterToType count > 0) ifTrue: [
              narrowed = conditionType replaceGenericsFromTableDeep: letterToType db: db
              narrowedTypeInfo <- TypeInfo t: narrowed isMut: conditionTypeInfo isMut listOfErrors: conditionTypeInfo listOfErrors
            ]
          ]
          |=> []
        ]
        |=> []
      ]
      conditionForBranch =
        (isTypeBranch && (isErrorMatch not))
          ifTrue: [
            | conditionT
            | IdentifierT => [
              IdentifierT
                token: conditionT token
                typeInfo: narrowedTypeInfo
                name: conditionT name
                path: conditionT path
                isNameOfTheType: conditionT isNameOfTheType
            ]
            |=> conditionT
          ]
          ifFalse: [conditionT]

      contextWithNarrowedSubject =
        (isTypeBranch && (isErrorMatch not))
          ifTrue: [
            newC = Context fromParent: contextIfThisMatching
            | subjectT
            | IdentifierT => [
              (subjectT isNameOfTheType || (subjectT name == "this")) ifFalse: [
                newC defineVar: subjectT name withType: narrowedTypeInfo
              ]
            ]
            |=> []
            isMatchingOnThis ifTrue: [
              newC defineVar: "this" withType: narrowedTypeInfo
            ]
            newC
          ]
          ifFalse: [contextIfThisMatching]

      contextForBody =
        isErrorMatch
          ifTrue: [
            newC = Context fromParent: contextWithNarrowedSubject
            newC defineVar: "it" withType: conditionForBranch typeInfo
            newC
          ]
          ifFalse: [contextWithNarrowedSubject]

      conditionsT = br additionalConditions resolveBody2: db withContext: contextWithNarrowedSubject

      bodyT = br body resolveBody2: db withContext: contextForBody expectedType: expectedType
      returnTypes add: bodyT t

      MatchBranchT condition: conditionForBranch
                   additionalConditions: conditionsT
                   body: bodyT
    ]

    elseBranchTMaybe = elseBranchT
    | elseBranchTMaybe
    | null => []
    |=> [
      returnTypes add: elseBranchTMaybe t
      ()
    ]

    matchType =
      returnTypes isEmpty
        ifTrue: [db dtc unit]
        ifFalse: [
          merged = db mergeTypesByUnion: returnTypes
          | merged
          | null => [
            typesStr = returnTypes joinWith: ", " transform: [it toString]
            db addErrorMessage: (ErrorWrongArgType
                                  tok: token
                                  msg: "Match branches return incompatible types: " + typesStr)
            returnTypes first
          ]
          |=> merged
        ]


    matchErrors::mut List(NivaType) = {}!
    branchesT forEach: [branch ->
      branch additionalConditions listOfErrors forEach: [matchErrors add: it]
      branch body listOfErrors forEach: [matchErrors add: it]
    ]
    | elseBranchTMaybe
    | null => []
    |=> elseBranchTMaybe listOfErrors forEach: [matchErrors add: it]

    newAst = MatchT
      token: token
      typeInfo: (TypeInfo t: matchType isMut: false listOfErrors: (matchErrors normalizeErrorList))
      subject: subjectT
      branches: branchesT
      elseBranch: elseBranchT

    // union exhaustiveness check
    db checkUnionMatchExhaustiveness: (subjectT typeInfo t) branches: branchesT elseBranch: elseBranchT token: token
    db checkErrorMatchExhaustiveness: subjectErrors branches: branchesT token: token

    // nullable exhaustiveness check
    | subjectType
    | NullableT => [
      elseBranchT == null ifTrue: [
        db addErrorMessage: (LazyError tok: token msg: "Nullable match must be exhaustive (add |=> branch)")
      ]
    ]
    |=> []

    ^ newAst
  ]
  | TypedExpr => TO DO: "Compiler bug: Recursive check, $this already type checked"


  result
]

type CheckMethodArg nivaType: NivaType expr: Expr argName: String
