Test errorDomainMatch = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      (Error1 text: "something went wrong") throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error1 => [0]
                | Error2 => [1]
                |=> [it]
      ^ default
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db

  Assert that: db listOfErrors count equals: 0
]

Test errorDomainMatchByCoreError = [
