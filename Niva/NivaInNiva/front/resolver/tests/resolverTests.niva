

Test constructorReturnType = [
  fileMain = """
    type FS

    constructor FS read: String -> String = [
      ^ "sas"
    ]

    x = FS read: "file.txt"

    x + "111"
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAst = result entryPointExpressions

  boxDecl = typedAst at: 0
  | boxDecl
  | VarDeclarationT => [
      t = boxDecl value typeInfo t
      Assert that: t name equals: "String"
  ]
  |=> false assert: ""

]

Test errorEffectsMismatch = [
  fileMain = """
    Unit sas -> Int = [
      Error throw
      ^ 42
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  Assert that: db listOfErrors count equals: 1
]

Test errorEffectsDeclared = [
  fileMain = """
    Unit sas -> Int!Error = [
      Error throw
      ^ 42
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db

  Assert that: db listOfErrors count equals: 0

  msgDecl = result fileToStatements at: "main", unpackOrPANIC, at: 0
  | msgDecl
  | MessageDeclT => [
    Assert that: msgDecl returnType listOfErrors count equals: 1
    Assert that: msgDecl body listOfErrors count equals: 1
    Assert that: msgDecl body listOfErrors first name equals: "Error"
  ]
  |=> [TO DO: "MessageDeclT expected"]
]

Test errorEffectsInferFromBang = [
  fileMain = """
    Unit sas -> Int! = [
      Error throw
      ^ 42
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db

  Assert that: db listOfErrors count equals: 0

  msgDecl = result fileToStatements at: "main", unpackOrPANIC, at: 0
  | msgDecl
  | MessageDeclT => [
    Assert that: msgDecl returnType listOfErrors count equals: 1
    Assert that: msgDecl returnType listOfErrors first name equals: "Error"
    Assert that: msgDecl body listOfErrors count equals: 1
  ]
  |=> [TO DO: "MessageDeclT expected"]
]

Test errorEffectsPropagateFromCall = [
  fileMain = """
    Unit throwing -> Int!Error = [
      Error throw
      ^ 42
