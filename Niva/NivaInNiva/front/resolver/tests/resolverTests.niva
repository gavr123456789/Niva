Test resolveAFewDeclarations = [

  fileMain = """
    // type Money declared in a different file
    Int make::Wallet sas::Person -> Int = [
      x::Int = 42
      1 inc dec
      2 + 3
    ]

    type Person age: Int
    type Wallet money: Int

  """

  statements  = TestParse withInput: fileMain expectedCount: -1
  listOfFilesContents = #{"main" statements}
  db = TyperDB new

  msgDecls = TypeDeclVisitor :db,
    visitAllTypesThenTypesAndMethods: listOfFilesContents
    entryPointStatements: statements

  MsgDeclVisitor new processBodyes: msgDecls :db

  typesWereRegistered = [
    mainPkgMaybe = db packages at: "main"
    mainPkg = mainPkgMaybe expect: "Missing main package"
    personTypeMaybe = mainPkg types at: "Person"
    personType = personTypeMaybe expect: "Missing Person type"
    walletTypeMaybe = mainPkg types at: "Wallet"
    walletType = walletTypeMaybe expect: "Missing Wallet type"
  ] do

  msgListMaybe = msgDecls at: "main"
  msgList = msgListMaybe expect: "Missing main message list"
  makeSas = msgList at: 0
  typedBodyMaybe = db typedBodiesCache at: (makeSas messageDeclKey)
  typedBody = typedBodyMaybe expect: "Missing typed body"
  checkExpressionsTypes = [
    Assert
      that: typedBody v count
      equals: 3
      andSay: "wrong number of expressions"

    varDecl = typedBody v at: 0
    unary = typedBody v at: 1
    binary = typedBody v at: 2

    Assert that: varDecl typeInfo t name equals: "Unit"
    Assert that: unary typeInfo t name equals: "Int"
    Assert that: binary typeInfo t name equals: "Int"

  ] do
]

Test checkGenerics = [
  fileMain = """
    type Box x: T
    box = Box x: 42
    Box tGeneric::T -> T = [
        ^ tGeneric
    ]
    res = box tGeneric: 1
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  typedAst = result entryPointExpressions

  // 1) check 'box' type
  checkBox = [
    boxDecl = typedAst at: 0, asVarDeclarationT
    t = boxDecl value typeInfo t
    Assert that: t name equals: "Box"
    boxT = t asTypeT
    Assert that: boxT genericArgs count equals: 1
    Assert that: boxT genericArgs first name equals: "Int"
  ] do

  // 2) check 'res' type
  checkRes = [
    resDecl = typedAst at: 1, asVarDeclarationT
    t = resDecl value typeInfo t
    Assert that: t name equals: "Int"
  ] do
]

Test testGenericsMethodWithTwoGenerics = [
  fileMain = """
    type Box x: T
    box = Box x: 42
    Box foo::T bar::G -> T = [
        ^ foo
    ]
    res = box foo: 1 bar: 6
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  typedAst = result entryPointExpressions

  // check 'res' type
  resDecl = typedAst last asVarDeclarationT
  t = resDecl value typeInfo t
  Assert that: t name equals: "Int"
]

