Test immutableNestedCopyUpdateLowersToShadowCopies = [
  fileMain = """
    type Money value: Int currency: String
    type Wallet money: Money id: Int
    type Person wallet: Wallet name: String

    person = Person
      wallet: (Wallet money: (Money value: 1 currency: "EUR") id: 7)
      name: "Alice"
    updated = person wallet money value <- 13
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAstMaybe = result fileToStatements at: "main"
  typedAst = typedAstMaybe expect: "Missing main statements"

  Assert that: db listOfErrors count equals: 0
  updatedDecl = typedAst last asVarDeclarationT
  Assert that: updatedDecl value typeInfo t name equals: "Person"
  outerCopy = updatedDecl value asKeywordMsgT
  Assert that: outerCopy kind equals: MessageSendKind.ShadowCopy
  walletCopy = outerCopy args first expr asKeywordMsgT
  Assert that: walletCopy kind equals: MessageSendKind.ShadowCopy
  moneyCopy = walletCopy args first expr asKeywordMsgT
  Assert that: moneyCopy kind equals: MessageSendKind.ShadowCopy
]

