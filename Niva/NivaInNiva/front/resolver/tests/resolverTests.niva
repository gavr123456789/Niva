Test resolveAFewDeclarations = [

  fileMain = """
    // type Money declared in a different file
    Int make::Wallet sas::Person -> Int = [
      x::Int = 42
      1 inc dec
      2 + 3
    ]

    type Person age: Int
    type Wallet money: Int

  """

  statements  = TestParse withInput: fileMain expectedCount: -1
  listOfFilesContents = #{"main" statements}
  db = TyperDB new

  msgDecls = TypeDeclVisitor db: db,
    visitAllTypesThenTypesAndMethods: listOfFilesContents
    entryPointStatements: statements

  MsgDeclVisitor new processBodyes: msgDecls db: db

  typesWereRegistered = [
    mainPkg = db packages at: "main", unpackOrPANIC
    mainPkg types at: "Person", unpackOrPANIC
    mainPkg types at: "Wallet", unpackOrPANIC
  ] do

  msgList = msgDecls at: "main", unpackOrPANIC
  makeSas = msgList at: 0
  typedBodyMaybe = db typedBodiesCache at: makeSas
  typedBody = typedBodyMaybe unpackOrPANIC
  checkExpressionsTypes = [
    Assert
      that: typedBody v count
      equals: 3
      andSay: "wrong number of expressions"

    varDecl = typedBody v at: 0
    unary = typedBody v at: 1
    binary = typedBody v at: 2

    Assert that: varDecl typeInfo t name equals: "Unit"
    Assert that: unary typeInfo t name equals: "Int"
    Assert that: binary typeInfo t name equals: "Int"

  ] do
]

Test checkGenerics = [
  fileMain = """
    type Box x: T
    box = Box x: 42
    Box tGeneric::T -> T = [
        ^ tGeneric
    ]
    res = box tGeneric: 1
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  typedAst = result entryPointExpressions

  // 1) check 'box' type
  checkBox = [
    boxDecl = typedAst at: 0
    | boxDecl
    | VarDeclarationT => [
        t = boxDecl value typeInfo t
        Assert that: t name equals: "Box"
        | t
        | TypeT => [
          Assert that: t genericArgs count equals: 1
          Assert that: t genericArgs first name equals: "Int"
        ]
        |=> [ Assert that: false equals: true ]
    ]
    |=> [ Assert that: false equals: true ]
  ] do

  // 2) check 'res' type
  checkRes = [
    resDecl = typedAst at: 1
    | resDecl
    | VarDeclarationT => [
        t = resDecl value typeInfo t
        Assert that: t name equals: "Int"
    ]
    |=> [ Assert that: false equals: true ]
  ] do
]

Test testGenericsMethodWithTwoGenerics = [
  fileMain = """
    type Box x: T
    box = Box x: 42
    Box foo::T bar::G -> T = [
        ^ foo
    ]
    res = box foo: 1 bar: 6
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  typedAst = result entryPointExpressions

  // check 'res' type
  resDecl = typedAst last
  | resDecl
  | VarDeclarationT => [
      t = resDecl value typeInfo t
      Assert that: t name equals: "Int"
  ]
  |=> [ Assert that: false equals: true ]
]

