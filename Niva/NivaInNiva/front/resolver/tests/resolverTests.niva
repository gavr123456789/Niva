Test collectionsTestingMapTry = [
  fileMain = """
    {1 2 3}
    #("1" "2" "3")
    #{1 "a" 2 "b"}
  //{"a" 1 "b" 2}
  """
  result = ResolverHelper
    resolve: #{"main" fileMain}
    entryPoint: "main"

  db = result db
  typedAst = result entryPointExpressions

  checkFirstList = [
    t = typedAst at: 0, typeInfo t asListT
    Assert that: t t name equals: "Int"
  ] do

  checkSecondSet = [
    t = typedAst at: 1, typeInfo t asSetT
    Assert that: t t name equals: "String"
  ] do

  checkThirdMap = [
    t = typedAst at: 2, typeInfo t asMapT
    Assert that: t k name equals: "Int"
    Assert that: t v name equals: "String"
  ] do

]

Test unionBranchesCanBeCollectionElements = [
  fileMain = """
    union DifferentTypes =
    | IntType x: Int
    | StrType x: String
    | BoolType x: Bool

    i = IntType x: 1
    s = StrType x: "a"
    b = BoolType x: true

    anyList = {i b s i b}
    anyMap = #{"int" i "str" s "bool" b}

    anyList forEach: [
      | it
      | IntType => "int!" echo
      | StrType => "String!" echo
      | BoolType => "bool!" echo
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
]

Test charLiteralAndProtocol = [
  fileMain = """
    Char foo = "hiii" echo

    ch = 'a'
    ch foo
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
]

Test nestedCollectionsAndExprInBracketsTypes = [
  fileMain = """
    {{1 2} {3}}
    {(1 inc) (2 inc)}
    #{1 {1 2}}
    emptyNested::List(List(Int)) = {{} {}}
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAst = result entryPointExpressions

  Assert that: db listOfErrors count equals: 0

  checkListOfLists = [
    t = typedAst at: 0, typeInfo t asListT
    inner = t t asListT
    Assert that: inner t name equals: "Int"
  ] do

  checkListOfExprInBrackets = [
    t = typedAst at: 1, typeInfo t asListT
    Assert that: t t name equals: "Int"
  ] do

  checkMapWithListValue = [
    t = typedAst at: 2, typeInfo t asMapT
    Assert that: t k name equals: "Int"
    Assert that: t v name equals: "List"
  ] do

  // empty nested collections take their type from the declaration
  checkEmptyNested = [
    decl = typedAst at: 3, asVarDeclarationT
    t = decl value typeInfo t asListT
    inner = t t asListT
    Assert that: inner t name equals: "Int"
  ] do
]

Test listMapFilterForEachChain = [
  fileMain = """
    list = {1 2 3}
    list map: [it * 2], filter: [it > 2], forEach: [it echo]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAst = result entryPointExpressions

  Assert that: db listOfErrors count equals: 0

  chainExpr = typedAst at: 1, asKeywordMsgT
  Assert that: chainExpr dbMsg name equals: "forEach"
  Assert that: chainExpr typeInfo t name equals: "Unit"

  inner = chainExpr receiver asExprInBracketsT value asKeywordMsgT
  Assert that: inner dbMsg name equals: "filter"
  t = inner typeInfo t asListT
  Assert that: t t name equals: "Int"
]

Test collectionLiteralOfBranchesTakesExpectedUnion = [
  fileMain = """
    union Expr = | Num v: Int | Sym name: String
    l::List(Expr) = {(Num v: 1)}
    s::Set(Expr) = #((Sym name: "x"))
    m::Map(String, Expr) = #{"a" (Num v: 1)}
    u = {(Num v: 1)}
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  typedAst = result entryPointExpressions
  Assert that: result db listOfErrors count equals: 0

  listType = typedAst at: 0, asVarDeclarationT value typeInfo t asListT
  Assert that: listType t name equals: "Expr"
  setType = typedAst at: 1, asVarDeclarationT value typeInfo t asSetT
  Assert that: setType t name equals: "Expr"
  mapType = typedAst at: 2, asVarDeclarationT value typeInfo t asMapT
  Assert that: mapType v name equals: "Expr"
  // with nothing expected, the items give the type
  untypedType = typedAst at: 3, asVarDeclarationT value typeInfo t asListT
  Assert that: untypedType t name equals: "Num"
]

Test matchBranchesWrappingNarrowedValueTakeReturnType = [
  fileMain = """
    union Expr = | Num v: Int | Sym name: String | Sum terms: List(Expr)
    Expr operands -> List(Expr) = | this
    | Sum => terms
    | Num => {this}
    | Sym => {this}
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  // each {this} is a List(Expr), not a List(Num) and a List(Sym) that don't merge
  Assert that: result db listOfErrors count equals: 0
]

