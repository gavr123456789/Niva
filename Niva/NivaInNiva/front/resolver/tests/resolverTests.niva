Test errorEffectsDeclared = [
  fileMain = """
    Unit sas -> Int!Error = [
      Error throw
      ^ 42
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db

  Assert that: db listOfErrors count equals: 0

  statementsMaybe = result fileToStatements at: "main"
  statements = statementsMaybe expect: "Missing main statements"
  msgDecl = statements at: 0, asMessageDeclT
  Assert that: msgDecl returnType listOfErrors count equals: 1
  Assert that: msgDecl body listOfErrors count equals: 1
  Assert that: msgDecl body listOfErrors first name equals: "Error"
]

Test errorEffectsInferFromBang = [
  fileMain = """
    Unit sas -> Int! = [
      Error throw
      ^ 42
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db

  Assert that: db listOfErrors count equals: 0

  statementsMaybe = result fileToStatements at: "main"
  statements = statementsMaybe expect: "Missing main statements"
  msgDecl = statements at: 0, asMessageDeclT
  Assert that: msgDecl returnType listOfErrors count equals: 1
  Assert that: msgDecl returnType listOfErrors first name equals: "Error"
  Assert that: msgDecl body listOfErrors count equals: 1
]

Test declaredErrorEffectsRequireBodyErrors = [
  fileMain = """
    Unit inferredButClean -> Int! = [42]
    Unit explicitButClean -> Int!Error = [42]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  errors = result db listOfErrors

  Assert that: errors count equals: 2
  errors forEach: [err ->
    err msg contains: "body cannot produce an error", assertTrue
  ]
]

Test inlineBindDeclarationAllowsDeclaredErrorEffect = [
  bindFile = """
    String readFile -> String!Error =
      Bind imports: #() emit: "(slurp $0)"
  """
  fileMain = "x = \"hi\" readFile"

  result = ResolverHelper resolve: #{"main" fileMain "main.bind" bindFile} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
]

Test inlineBindWithoutDeclaredErrorEffectDoesNotInferOne = [
  bindFile = """
    String readFile -> String =
      Bind imports: #() emit: "(slurp $0)"
  """
  fileMain = "x = \"hi\" readFile"

  result = ResolverHelper resolve: #{"main" fileMain "main.bind" bindFile} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
]

Test tryRethrowsIntoEnclosingFunctionAndUnwrapsVariable = [
  fileMain = """
    Int sas -> Int! = [
      1 > 2 ifTrue: [Error throwWithMsg: "hello"]
      1
    ]

    Int sus -> Int!Error = [
      x = this sas try
      x inc inc
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0

  statementsMaybe = result fileToStatements at: "main"
  statements = statementsMaybe expect: "Missing main statements"
  sus = statements at: 1, asMessageDeclT
  Assert that: sus body listOfErrors count equals: 1
  Assert that: sus body listOfErrors first name equals: "Error"
]

Test callbackErrorsPropagateToEnclosingDeclarationAndMatch = [
  fileMain = """
    Int sas -> Int! = [
      1 > 2 ifTrue: [Error throwWithMsg: "hello"]
      1
    ]

    | 1 sas
    | Error => [0]
    |=> [1]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0

  typedMatch = result entryPointExpressions last asMatchT
  Assert that: typedMatch subject typeInfo listOfErrors count equals: 1
  Assert that: typedMatch subject typeInfo listOfErrors first name equals: "Error"
]

Test errorEffectsPropagateFromCall = [
  fileMain = """
    Unit throwing -> Int!Error = [
      Error throw
      ^ 42
    ]

    Unit caller -> Int = [
      () throwing
      ^ 1
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db

  Assert that: db listOfErrors count equals: 1
]

Test errorableReceiverOnlyAllowsAnyMethods = [
  fileMain = """
    Unit readFile -> String!Error = [
      Error throw
      ^ "text"
    ]

    text = () readFile
    text echo
    text + " new text!"
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 1
]

Test tryRequiresErrorableOrNullableReceiver = [
  fileMain = """
    value = 42 try
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  errors = result db listOfErrors
  Assert that: errors count equals: 1
  err = errors first asErrorInvalidTry
  Assert that: (err msg contains: "try can only be used on errorable or nullable values") equals: true
]

