Test matchBranchEndingWithReturnDoesNotDecideItsType = [
  fileMain = """
    errordomain E =
    | Bad text: String

    Int parse -> Int!{Bad} = [
      this >= 0 ifTrue: [^ this * 10]
      (Bad text: "negative") throw
      ^ 0
    ]

    Int describe -> String = [
      | this parse
      | Bad => ^ "bad input"
      |=> []
      "parsed"
    ]

    Int describeZero -> String = [
      | this
      | 0 => ^ "zero"
      |=> this
      "not zero"
    ]

    Int describeZeroInBrackets -> String = [
      | this
      | 0 => (^ "zero")
      |=> 1
      "done"
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
]

    Test resolveUnaryBinaryKeywordMessages = [
  fileMain = """
    type Counter value: Int

    Counter get -> Int = [
      this value
    ]

    Counter + amount::Int -> Counter = [
      ^ this
    ]

    Counter add::Int -> Int = [
      ^ this value + add
    ]

    c = Counter value: 1
    u = c get
    b = c + 2
    k = c add: 2
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  typedAst = result entryPointExpressions

  checkConstructor = [
    cVal = typedAst at: 0, asVarDeclarationT value asKeywordMsgT
    Assert that: cVal kind equals: MessageSendKind.DefaultConstructor
  ] do

  checkUnary = [
    uVal = typedAst at: 1, asVarDeclarationT value asUnaryMsgT
    Assert that: uVal dbMsg name equals: "get"
    Assert that: uVal typeInfo t name equals: "Int"
  ] do

  checkBinary = [
    bVal = typedAst at: 2, asVarDeclarationT value asBinaryMsgT
    Assert that: bVal dbMsg name equals: "+"
    Assert that: bVal typeInfo t name equals: "Counter"
  ] do

  checkKeyword = [
    kVal = typedAst at: 3, asVarDeclarationT value asKeywordMsgT
    Assert that: kVal dbMsg name equals: "add"
    Assert that: kVal typeInfo t name equals: "Int"
  ] do

]

