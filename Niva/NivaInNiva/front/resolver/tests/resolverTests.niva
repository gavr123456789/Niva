Test nullableReceiverMessageDecl = [
  fileMain = """
    T? orDefault: default::T -> T = [
      | this
      | null => ^default
      |=> ^this
    ]

    x::Int? = null
    y = x orDefault: 42
    z::String? = "sas"
    w = z orDefault: "nope"
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  Assert that: db listOfErrors count equals: 0

  typedAst = result entryPointExpressions

  yDecl = typedAst at: 1, asVarDeclarationT
  Assert that: yDecl value typeInfo t name equals: "Int"

  wDecl = typedAst at: 3, asVarDeclarationT
  Assert that: wDecl value typeInfo t name equals: "String"
]

Test nullableReceiverMessageDeclForConcreteType = [
  fileMain = """
    G? isNil -> Bool = [
      ^ this == null
    ]

    Int? orZero -> Int = [
      | this
      | null => ^0
      |=> ^this
    ]

    x::Int? = null
    y = x orZero
    z = x isNil
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  Assert that: db listOfErrors count equals: 0

  typedAst = result entryPointExpressions

  yDecl = typedAst at: 1, asVarDeclarationT
  Assert that: yDecl value typeInfo t name equals: "Int"

  zDecl = typedAst at: 2, asVarDeclarationT
  Assert that: zDecl value typeInfo t name equals: "Bool"
]

/// a method declared for the exact inner type wins over the generic one with the same name
Test nullableReceiverExactTypeWinsOverGeneric = [
  fileMain = """
    T? orDefaultOrPanic -> Int = [
      ^ 42
    ]

    String? orDefaultOrPanic -> String = [
      ^ "no"
    ]

    x::Int? = null
    fromGeneric = x orDefaultOrPanic
    y::String? = null
    fromExact = y orDefaultOrPanic
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  Assert that: db listOfErrors count equals: 0

  typedAst = result entryPointExpressions

  genericDecl = typedAst at: 1, asVarDeclarationT
  Assert that: genericDecl value typeInfo t name equals: "Int"

  exactDecl = typedAst at: 3, asVarDeclarationT
  Assert that: exactDecl value typeInfo t name equals: "String"
]

Test setProtocolMethods = [
  fileMain = """
    set = #(1 2 3)
    set count
    set first
    set toList
    set contains: 2
    set filter: [it > 1]
    set + #(4)
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  Assert that: db listOfErrors count equals: 0

  typedAst = result entryPointExpressions

  countType = typedAst at: 1, typeInfo t
  Assert that: countType name equals: "Int"

  firstType = typedAst at: 2, typeInfo t
  Assert that: firstType name equals: "Int"

  toListType = typedAst at: 3, typeInfo t asListT
  Assert that: toListType t name equals: "Int"

  containsType = typedAst at: 4, typeInfo t
  Assert that: containsType name equals: "Bool"

  filteredType = typedAst at: 5, typeInfo t asSetT
  Assert that: filteredType t name equals: "Int"

  mergedType = typedAst at: 6, typeInfo t asSetT
  Assert that: mergedType t name equals: "Int"
]

Test structureInfoMarkdownAndTypePath = [
  fileMain = """
    type Hidden value: Int

    type Person
      name: String
      age: Int

    Person greet -> String = "hello"
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0

  allInfo = result db structureInfo
  (allInfo contains: "## Package `main`") assertTrue
  (allInfo contains: "type Person") assertTrue
  (allInfo contains: "    name: String") assertTrue
  (allInfo contains: "    age: Int") assertTrue
  (allInfo contains: "#### Methods") assertTrue
  (allInfo contains: "- `greet -> String`") assertTrue

  personInfo = result db structureInfoFor: "main.Person"
  (personInfo contains: "type Person") assertTrue
  (personInfo contains: "    name: String") assertTrue
  (personInfo contains: "    age: Int") assertTrue
  Assert that: (personInfo contains: "type Hidden") equals: false

  invalidInfo = result db structureInfoFor: "Person"
  (invalidInfo contains: "Expected a type path in the form `package.Type`") assertTrue
]

Test compileTimeInfoMessage = [
  fileMain = """
    type Person name: String
    Person greet -> String = "hello"

    p = Person name: "Alice"
    p infoFull
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0

  infoExpr = result entryPointExpressions last asUnitExprT

  personInfo = result db compileTimeInfoFor: (result db findByTypeName: "Person" inPkg: "main") showSourceLocations: true
  (personInfo contains: "type Person ( main.niva:2 )") assertTrue
  (personInfo contains: "    name: String") assertTrue
  (personInfo contains: "- `greet -> String` ( main.niva:3 )") assertTrue
]

Test compileTimeInfoOnBuiltinType = [
  fileMain = """
    n = 1
    n info
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0

  infoExpr = result entryPointExpressions last asUnitExprT
  Assert that: (infoExpr typeInfo t name) equals: "Unit"

  intInfo = result db compileTimeInfoFor: (result db dtc int)
  (intInfo contains: "type Int") assertTrue
  (intInfo contains: "#### Methods") assertTrue
]

/// dollars and quotes here are built by concatenation
/// so that the kotlin bootstrap does not touch them
Test interpolatedStringResolvesToStringConcat = [
  dollar = "$"
  quote = (34 toChar) toString
  fileMain = "type Point\n  x: Int\n\nn = 5\np = Point x: 1\nt = " + quote + dollar + "[n + 1] of " + dollar + "[p]" + quote + "\n"
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0

  tDecl = result entryPointExpressions at: 2, asVarDeclarationT
  tVal = tDecl value asBinaryMsgT
  Assert that: tVal typeInfo t name equals: "String"
  Assert that: tVal dbMsg name equals: "+"
]
