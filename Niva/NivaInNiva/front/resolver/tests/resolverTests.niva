Test codeblockReturnType = [
  fileMain = """
    [
      "sas"
      1 inc
    ]
    [a::Int, b::Int ->
      a + b
    ]
    {1} map: [it inc]


  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"


  db = result db
  Assert that: db listOfErrors count equals: 0
  typedAst = result entryPointExpressions
  checkFirst = [
    codeBlock = typedAst at: 0, asCodeBlockT
    Assert that: codeBlock args count equals: 0
    ft = codeBlock typeInfo t asFuntionT
    Assert that: ft returnType name equals: "Int"
  ] do


  checkSecond = [
    codeBlock = typedAst at: 1, asCodeBlockT
    Assert that: codeBlock args count equals: 2
    ft = codeBlock typeInfo t asFuntionT
    Assert that: ft returnType name equals: "Int"
  ] do

]

Test wrongArgTypeError = [
  fileMain = """
    type Person name: String
    p = Person name: 234
    q = Person name: 'c'
    w = Person name: true
  """


  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAstMaybe = result fileToStatements at: "main"
  typedAst = typedAstMaybe expect: "Missing main statements"

  Assert that: db listOfErrors count equals: 3
]

