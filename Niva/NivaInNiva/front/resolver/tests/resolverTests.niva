    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      (Error1 text: "something went wrong") throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error => [0]
                |=> [it]
      ^ default
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db

  Assert that: db listOfErrors count equals: 0
]

Test findingGenericRoot = [
  fileMain = """
    union Sas = Ses | Sis

    1 > 2 ifTrue: [Ses new] ifFalse: [Sis new]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAst = result entryPointExpressions

  boxDecl = typedAst at: 0
  Assert that: boxDecl typeInfo t name equals: "Sas"
]

Test ifTrueIfFalseEmptyListInfer = [
  fileMain = """
    Unit sas -> List(Int) = {}
    x = 1 > 2 ifTrue: [() sas]
              ifFalse: [{}]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAst = result entryPointExpressions

  Assert that: db listOfErrors count equals: 0

  typedStmtsMaybe = result fileToStatements at: "main"
  typedStmts = typedStmtsMaybe expect: "Missing main statements"
  msgDecl = typedStmts at: 0, asMessageDeclT
  rt = msgDecl returnType t asListT
  Assert that: rt t name equals: "Int"

  xDecl = typedAst at: 0, asVarDeclarationT
  t = xDecl value typeInfo t asListT
  Assert that: t t name equals: "Int"
]

Test constructorInfersNestedGenerics = [
  fileMain = """
    type Cell meow: List(V) meow2: List(K)
    x = Cell meow: {1} meow2: {1}
    y = x meow at: 0 + 2
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAst = result entryPointExpressions

  Assert that: db listOfErrors count equals: 0

  xDecl = typedAst at: 0, asVarDeclarationT
  cellT = xDecl value typeInfo t asTypeT
  f1 = cellT fields at: 0, typeT asListT
  Assert that: f1 t name equals: "Int"
  f2 = cellT fields at: 1, typeT asListT
  Assert that: f2 t name equals: "Int"

  yDecl = typedAst at: 1, asVarDeclarationT
  Assert that: yDecl value typeInfo t name equals: "Int"
]

