Test collectionsTestingMapTry = [
  fileMain = """
    {1 2 3}
    #("1" "2" "3")
    #{1 "a" 2 "b"}
  //{"a" 1 "b" 2}
  """
  result = ResolverHelper
    resolve: #{"main" fileMain}
    entryPoint: "main"

  db = result db
  typedAst = result entryPointExpressions

  checkFirstList = [
    t = typedAst at: 0, typeInfo t
    | t
    | ListT => Assert that: t t name equals: "Int"
    |=> [TO DO: "list expected"]
  ] do

  checkSecondSet = [
    t = typedAst at: 1, typeInfo t
    | t
    | SetT => Assert that: t t name equals: "String"
    |=> [TO DO: "set expected"]
  ] do

  checkThirdMap = [
    t = typedAst at: 2, typeInfo t
    | t
    | MapT => [
      keyType = t k
      valueType = t v
      Assert that: keyType name equals: "Int"
      Assert that: valueType name equals: "String"
    ]
    |=> [TO DO: "map expected but got: $t"]
  ] do

]

Test nestedCollectionsAndExprInBracketsTypes = [
  fileMain = """
    {{1 2} {3}}
    {(1 inc) (2 inc)}
    #{1 {1 2}}
    emptyNested::List(List(Int)) = {{} {}}
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAst = result entryPointExpressions

  Assert that: db listOfErrors count equals: 0

  checkListOfLists = [
    t = typedAst at: 0, typeInfo t
    | t
    | ListT => [
      inner = t t
      | inner
      | ListT => Assert that: inner t name equals: "Int"
      |=> [TO DO: "List(List(Int)) expected, got $t"]
    ]
    |=> [TO DO: "list expected, got $t"]
  ] do

  checkListOfExprInBrackets = [
    t = typedAst at: 1, typeInfo t
    | t
    | ListT => Assert that: t t name equals: "Int"
    |=> [TO DO: "list expected, got $t"]
  ] do

  checkMapWithListValue = [
    t = typedAst at: 2, typeInfo t
    | t
    | MapT => [
      Assert that: t k name equals: "Int"
      Assert that: t v name equals: "List"
    ]
    |=> [TO DO: "map expected, got $t"]
  ] do

  // empty nested collections take their type from the declaration
  checkEmptyNested = [
    decl = typedAst at: 3
    | decl
    | VarDeclarationT => [
      t = decl value typeInfo t
      | t
      | ListT => [
        inner = t t
        | inner
        | ListT => Assert that: inner t name equals: "Int"
        |=> [TO DO: "List(List(Int)) expected, got $t"]
      ]
      |=> [TO DO: "list expected, got $t"]
    ]
    |=> [TO DO: "var declaration expected, got $decl"]
  ] do
]

Test listMapFilterForEachChain = [
  fileMain = """
    list = {1 2 3}
    list map: [it * 2], filter: [it > 2], forEach: [it echo]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  db = result db
  typedAst = result entryPointExpressions

  Assert that: db listOfErrors count equals: 0

  chainExpr = typedAst at: 1
  | chainExpr
  | KeywordMsgT => [
    Assert that: chainExpr dbMsg name equals: "forEach"
    Assert that: chainExpr typeInfo t name equals: "Unit"

    recv = chainExpr receiver
    | recv
    | ExprInBracketsT => [
      inner = recv value
      | inner
      | KeywordMsgT => [
        Assert that: inner dbMsg name equals: "filter"
        t = inner typeInfo t
        | t
        | ListT => Assert that: t t name equals: "Int"
        |=> [TO DO: "List expected"]
      ]
      |=> [TO DO: "filter keyword expected"]
    ]
    |=> [TO DO: "ExprInBrackets expected"]
  ]
  |=> [TO DO: "KeywordMsgT expected"]
]

    Test resolveUnaryBinaryKeywordMessages = [
  fileMain = """
    type Counter value: Int

    Counter get -> Int = [
      this value
    ]

    Counter + amount::Int -> Counter = [
      ^ this
    ]

    Counter add::Int -> Int = [
      ^ this value + add
    ]

    c = Counter value: 1
    u = c get
    b = c + 2
    k = c add: 2
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  typedAst = result entryPointExpressions

  checkConstructor = [
    cDecl = typedAst at: 0
    | cDecl
    | VarDeclarationT => [
      cVal = cDecl value
      | cVal
      | KeywordMsgT => [
        Assert that: cVal kind equals: MessageSendKind.DefaultConstructor
      ]
      |=> [TO DO: "constructor call expected"]
    ]
    |=> [TO DO: "VarDeclarationT expected for constructor"]
  ] do

  checkUnary = [
    uDecl = typedAst at: 1
    | uDecl
    | VarDeclarationT => [
      uVal = uDecl value
      | uVal
      | UnaryMsgT => [
        Assert that: uVal dbMsg name equals: "get"
        Assert that: uVal typeInfo t name equals: "Int"
      ]
      |=> [TO DO: "UnaryMsgT expected"]
    ]
    |=> [TO DO: "VarDeclarationT expected for unary"]
  ] do

  checkBinary = [
    bDecl = typedAst at: 2
    | bDecl
    | VarDeclarationT => [
      bVal = bDecl value
      | bVal
      | BinaryMsgT => [
        Assert that: bVal dbMsg name equals: "+"
        Assert that: bVal typeInfo t name equals: "Counter"
      ]
      |=> [TO DO: "BinaryMsgT expected"]
    ]
    |=> [TO DO: "VarDeclarationT expected for binary"]
  ] do

  checkKeyword = [
    kDecl = typedAst at: 3
    | kDecl
    | VarDeclarationT => [
      kVal = kDecl value
      | kVal
      | KeywordMsgT => [
        Assert that: kVal dbMsg name equals: "add"
        Assert that: kVal typeInfo t name equals: "Int"
      ]
      |=> [TO DO: "KeywordMsgT expected"]
    ]
    |=> [TO DO: "VarDeclarationT expected for keyword"]
  ] do

]

Test codeblockReturnType = [
  fileMain = """
    [
      "sas"
      1 inc
    ]
    [a::Int, b::Int ->
      a + b
    ]


  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"


  db = result db
  typedAst = result entryPointExpressions
  checkFirst = [
    codeBlock = typedAst at: 0
    | codeBlock | CodeBlockT => [
      Assert that: codeBlock args count equals: 0
      t = codeBlock typeInfo t
      | t | FuntionT => [
        Assert that: t returnType name equals: "Int"
      ] |=> [TO DO: "function type expected"]

    ] |=> [TO DO: "codeblock expected"]
  ] do


  checkSecond = [
    codeBlock = typedAst at: 1
    | codeBlock | CodeBlockT => [
      Assert that: codeBlock args count equals: 2



      t = codeBlock typeInfo t
      | t | FuntionT => [
        Assert that: t returnType name equals: "Int"
      ] |=> [TO DO: "function type expected"]

    ] |=> [TO DO: "codeblock expected"]
  ] do

]

