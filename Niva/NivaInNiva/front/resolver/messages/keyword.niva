
KeywordMsg resolveKeywordFromDb2(db): TyperDB withContext(c): Context  -> KeywordMsgT = [
  ^ this resolveKeywordFromDb2: db withContext: c nameOverride: null expectedType: null
]

KeywordMsg resolveKeywordFromDb2(db): TyperDB withContext(c): Context nameOverride: String? expectedType: NivaType?  -> KeywordMsgT = [
  msgName = | nameOverride
    | null => this getNameFromArgs
    |=> nameOverride
  receiverTypedExpr = this resolveReceiverForInlineMethod: db withContext: c methodName: msgName
  ^ this resolveKeywordFromDb2: db withContext: c receiverTyped: receiverTypedExpr nameOverride: nameOverride expectedType: expectedType
]

KeywordMsg resolveReceiverForInlineMethod(db): TyperDB withContext(c): Context methodName: String -> TypedExpr2 = [
  receiverExpr = receiver
  | receiverExpr
  | CodeBlock => [
    ((methodName == "whileTrue") || (methodName == "whileTrue:")) ifTrue: [
      condType = FuntionT
        fields: {}!
        name: "whileTrueCond"
        genericArgs: {}!
        pkgName: "core"
        returnType: db dtc bool
      receiverExpr resolveWithExpectedType: db withContext: c expectedType: condType allowNonLocalReturn: true
    ] ifFalse: [receiverExpr toTypedExprFromDb2: db withContext: c]
  ]
  |=> receiverExpr toTypedExprFromDb2: db withContext: c
]

KeywordMsg resolveKeywordFromDb2(db): TyperDB withContext(c): Context receiverTyped: TypedExpr2 nameOverride: String? expectedType: NivaType?  -> KeywordMsgT = [
  receiverTypedExpr = receiverTyped
  receiverType = receiverTypedExpr typeInfo t
  db addCollectionInstantiationIfAbsent: receiverType
  argTypesAndExprs::mut List(CheckMethodArg) = {}!

  msgName = | nameOverride
  | null => this getNameFromArgs
  |=> nameOverride

  mut shadowCopy::KeywordMsgT? = null
  isTypeReceiver = | receiverTypedExpr
    | IdentifierT => receiverTypedExpr isNameOfTheType
    |=> false

  | receiverType
  | TypeT => [
    (isTypeReceiver || args isEmpty) ifFalse: [
      fieldNames = receiverType collectFields map: [it name]
      fieldNameSet = fieldNames toSet
      argNames = args map: [it name name]
      argNameSet = argNames toSet
      missingField = argNames find: [fieldNameSet contains: it, not]
      allArgsAreFields = missingField == null

      allArgsAreFields ifTrue: [
        argNameSet count != argNames count ifTrue: [
          db addErrorMessage: (LazyError tok: token msg: "Shadow copy has duplicate fields")
        ]

        allFieldsMentioned = (fieldNames count != 1) && (fieldNames count == argNameSet count)
        allFieldsMentioned ifTrue: [
          db addErrorMessage: (LazyError tok: token msg: "Shadow copy must not mention all fields; use constructor")
        ]

        shadowLetterToType::mut Map(String, NivaType) = #{}!

        typedShadowArgs = args map: [kwArg ->
          expr = kwArg expr
          field = receiverType findField: (kwArg name name)
          fieldMaybe = field
          fieldType = | fieldMaybe
            | null => Unknown new
            |=> fieldMaybe typeT
          expectedArgType =
            ((shadowLetterToType count > 0) && fieldType isContainsUnresolvedGenerics)
              ifTrue: [fieldType replaceGenericsFromTableDeep: shadowLetterToType db: db]
              ifFalse: [fieldType]

          typedExpr =
            | expr
            | CodeBlock => [
              | expectedArgType
              | FuntionT => expr resolveWithExpectedType: db withContext: c expectedType: expectedArgType allowNonLocalReturn: false
              |=> expr toTypedExprFromDb2: db withContext: c expectedType: expectedArgType
            ]
            |=> expr toTypedExprFromDb2: db withContext: c expectedType: expectedArgType

          realType = typedExpr typeInfo t

          fieldType collectGenericMappingsFrom: realType into: shadowLetterToType db: db

          fieldType isContainsUnresolvedGenerics
            ifTrue: [
              expectedResolved = fieldType replaceGenericsFromTableDeep: shadowLetterToType db: db
              db rejectWrongGenericArg: expectedResolved real: realType tok: (expr token)
            ]
            ifFalse: [
              db isAssignable: realType toExpected: fieldType, ifFalse: [
                db addErrorMessage: (ErrorWrongArgType
                                      tok: expr token
                                      msg: "wrong arg type for " + (kwArg name name) + " expected " + fieldType toString cyan + " but got "red + realType toString cyan)
              ]
            ]

          NameAndExprT name: (kwArg name) expr: typedExpr
        ]

        resolvedReceiverType =
          ((shadowLetterToType count > 0) && receiverType isContainsUnresolvedGenerics)
            ifTrue: [receiverType replaceGenericsFromTableDeep: shadowLetterToType db: db]
            ifFalse: [receiverType]

        shadowMsgArgs = typedShadowArgs map: [kwArg ->
          field = receiverType findField: kwArg name name
          fieldMaybe = field
          fieldType = | fieldMaybe
            | null => Unknown new
            |=> fieldMaybe typeT
          resolvedFieldType =
            ((shadowLetterToType count > 0) && fieldType isContainsUnresolvedGenerics)
              ifTrue: [fieldType replaceGenericsFromTableDeep: shadowLetterToType db: db]
              ifFalse: [fieldType]
          TypeTField name: (kwArg name name) typeT: resolvedFieldType isMut: false
        ]

        shadowMsg = NivaMethod
          name: msgName
          receiverType: resolvedReceiverType
          args: shadowMsgArgs
          returnType: resolvedReceiverType
          returnErrors: {}!
          forMut: false
          possibleErrors: {}
          kind: MessageSendKind.ShadowCopy
          decl: null
          protocolName: "shadowCopy"
          pkgName: receiverType pkgName
          isInline: false

        shadowCopy <- KeywordMsgT
          receiver: receiverTypedExpr
          token: token
          typeInfo: (TypeInfo
                        t: resolvedReceiverType
                        isMut: false
                        listOfErrors: {}!)
          dbMsg: shadowMsg
          args: typedShadowArgs
          kind: MessageSendKind.ShadowCopy
      ]
    ]
  ]
  |=> []

  shadowCopyMaybe = shadowCopy
  ^ | shadowCopyMaybe
    | null => [
  constructorTableMaybe = db constructorsTypeToMethodNameToMethod at: (receiverType toMangledName)
  constructorMaybe = | constructorTableMaybe
    | null => null
    |=> [
      constructorTable::mut Map(String, NivaMethod) = constructorTableMaybe
      constructorTable at: msgName
    ]
  typedConstructorMaybe = | constructorMaybe
    | null => null
    |=> [
      constructorMethod = constructorMaybe
      | constructorMethod returnType
      | Unknown => null
      |=> constructorMethod
    ]
  mut kwMsgDB = isTypeReceiver ifTrue: [
    | typedConstructorMaybe
    | null => db findMsgFromReceiver: receiverTypedExpr byName: msgName currentPkg: c currentPkg
    |=> typedConstructorMaybe
  ] ifFalse: [
    db findMsgFromReceiver: receiverTypedExpr byName: msgName currentPkg: c currentPkg
  ]

  // unary and keyword can share the same name, so if current not match, there might be generic kinda overloading
  kwMsgDB args count != args count ifTrue: [
    genericCandidateMaybe = db findGenericReceiverMethod: msgName forType: receiverType
    | genericCandidateMaybe
    | null => []
    |=> genericCandidateMaybe args count == args count ifTrue: [kwMsgDB <- genericCandidateMaybe]
  ]


  kwMsgDB args count != args count ifTrue: [
    TO DO: "keyword " + msgName + " at " + receiverTyped token toPosition + " on " + receiverType toString + " expects " + kwMsgDB args count toString + " arguments but got " + args count toString
  ]




  // GENERICS

  letterToType::mut Map(String, NivaType) = #{}!

  // `Bind emit:` returns T to make `Sas sus -> String = Bind emit: "..."` possible
  expectedReturnTypeMaybe = expectedType
  | expectedReturnTypeMaybe
  | null => []
  |=> kwMsgDB returnType collectGenericMappingsFrom: expectedReturnTypeMaybe into: letterToType db: db

  typedArgs = args mapIndexed: [ i, kwArg ->
    name = kwArg name
    expr = kwArg expr
    argTypeFromDb = kwMsgDB args at: i, typeT
    expectedArgType =
      ((letterToType count > 0) && argTypeFromDb isContainsUnresolvedGenerics)
        ifTrue: [argTypeFromDb replaceGenericsFromTableDeep: letterToType db: db]
        ifFalse: [argTypeFromDb]
    typedExpr =
      | expr
      | CodeBlock => [
        | expectedArgType
        | FuntionT => expr resolveWithExpectedType: db withContext: c expectedType: expectedArgType allowNonLocalReturn: kwMsgDB isInline
        |=> expr toTypedExprFromDb2: db withContext: c expectedType: expectedArgType
      ]
      |=> expr toTypedExprFromDb2: db withContext: c expectedType: expectedArgType

    realType = typedExpr typeInfo t
    argTypesAndExprs add: (CheckMethodArg
                            nivaType: typedExpr typeInfo t
                            expr: expr
                            argName: name name)

    argTypeFromDb collectGenericMappingsFrom: realType into: letterToType db: db

    argTypeFromDb isContainsUnresolvedGenerics
      ifTrue: [
        expectedResolved = argTypeFromDb replaceGenericsFromTableDeep: letterToType db: db
        db rejectWrongGenericArg: expectedResolved real: realType tok: (expr token)
      ]
      ifFalse: [
        // вот, если это не женерик то сравниваем с тем шо в дб
        db isAssignable: realType toExpected: argTypeFromDb, ifFalse: [
          kwName = kwArg name
          db addErrorMessage: (ErrorWrongArgType
                                tok: expr token
                                msg: "wrong arg type for " + kwName name + " expected " + argTypeFromDb toString cyan + " but got "red + realType toString cyan)
        ]
      ]

          NameAndExprT name: name expr: typedExpr
  ]

  (letterToType count > 0) ifTrue: [
    dontMangle::Set(String) = | receiverType
                 | TypeT => (receiverType collectGenerics map: [t::NivaType -> t name]) toSet
                 |=> #()!

    newMethod = kwMsgDB replaceGenericsFromTable: letterToType dontMangle: dontMangle mangle: true db: db

    instReceiverType = db addCollectionInstantiationIfAbsent: newMethod receiverType



    methodAlreadyExists = db findMethodInAllProtocols: newMethod name forType: instReceiverType receiver: receiverTypedExpr

    | methodAlreadyExists
    | null => [
       db addNewMethod: newMethod forType: instReceiverType inProtocol: "generated"

       originalDecl = kwMsgDB decl

       | originalDecl
       | null => [] // nothing to generate (intrinsic or getter without decl)
       |=> [
          // create new body with same expressions but empty typed body
          newBody = Body unTypedBody: (originalDecl body unTypedBody toMutableList)

          // create args
          // we need to update types to mangled names of resolved types
          newArgs = originalDecl args mapIndexed: [ i, arg ->
             resolvedArgType = newMethod args at: i, typeT
             NameAndAstType name: arg name astType: (AstType name: resolvedArgType toMangledName tok: (Token fake))
          ]
          newDecl = MessageDecl
            token: originalDecl token
            receiver: (AstType name: instReceiverType toMangledName tok: (Token fake))
            name: newMethod name // mangled name if method was generic
            args: newArgs
            returnType: (AstType name: newMethod returnType toMangledName tok: (Token fake))
            body: newBody
            isSingleExpr: originalDecl isSingleExpr
            isConstructor: originalDecl isConstructor
          newDecl resolveBodyWithDb: db pkg: c currentPkg extraTypes: letterToType

          db addGeneratedMessageDecl: newDecl
       ]
    ]
    |=> [
       // already exists, use it
       // ensure we use the cached one just in case
       // newMethod <- methodAlreadyExists
    ]

    kwMsgDB <- newMethod

  ] ifFalse: [
    | receiverType
    | TypeT => [
      isThereUnresolvedGenerics = receiverType genericArgs find: [
        | it
        | UnresolvedGenericT => [true]
        |=> [false]
      ]

      unresolvedGenericMaybe = isThereUnresolvedGenerics
      | unresolvedGenericMaybe
      | null => []
      |=> [
        db addFatalErrorFromTok: receiver token
           withMsg: "Receiver has generic param " + unresolvedGenericMaybe toString + " but I can't infer it via message arguments"
      ]
    ] |=> []

  ]




  canonicalReturnType = db addCollectionInstantiationIfAbsent: kwMsgDB returnType
  callErrors::mut List(NivaType) = {}!
  kwMsgDB returnErrors forEach: [callErrors add: it]

  isOrPanic = msgName == "orPANIC"
  isOrPanic ifFalse: [
    receiverTypedExpr typeInfo listOfErrors forEach: [callErrors add: it]
  ]
  receiverEffectType = receiverTypedExpr typeInfo t
  isOrPanic ifFalse: [
    | receiverEffectType
    | FuntionT => receiverEffectType returnErrors forEach: [callErrors add: it]
    |=> []
  ]

  typedArgs forEach: [arg ->
    arg expr typeInfo listOfErrors forEach: [callErrors add: it]
    argEffectType = arg expr typeInfo t
    | argEffectType
    | FuntionT => argEffectType returnErrors forEach: [callErrors add: it]
    |=> []
  ]

  KeywordMsgT
    receiver: receiverTypedExpr
    token: token
    typeInfo: (TypeInfo
                  t: canonicalReturnType
                  isMut: (kwMsgDB returnTypeInfo isMut) || (isTypeReceiver && receiverTypedExpr typeInfo isMut)
                  listOfErrors: (callErrors normalizeErrorList))
    dbMsg: kwMsgDB
    args: typedArgs
    kind: kwMsgDB kind
    ]
    |=> shadowCopyMaybe
]

// add arg type error when resolved generic arg type still mismatches
TyperDB rejectWrongGenericArg(expected): NivaType real: NivaType tok: Token = [
  expected isContainsUnresolvedGenerics ifFalse: [
    this isAssignable: real toExpected: expected, ifFalse: [
      this addErrorMessage: (ErrorWrongArgType
                                tok: tok
                                msg: "Expected " + expected toString + " but got " + real toString)
    ]
  ]
]
