
UnaryMsg resolveUnaryFromDb2(db): TyperDB withContext(c): Context -> UnaryMsgT = [
  kw = KeywordMsg
    :receiver
    :token
    args: {}
    :kind

  kwResolved = kw resolveKeywordFromDb2: db withContext: c receiverTyped: (receiver toTypedExprFromDb2: db withContext: c) nameOverride: selector name expectedType: null bucket: MethodBucketKind.Unary

  ^ UnaryMsgT
    receiver: kwResolved receiver
    :token
    typeInfo: kwResolved typeInfo
    dbMsg: kwResolved dbMsg
    :selector
    kind: kwResolved kind
]
