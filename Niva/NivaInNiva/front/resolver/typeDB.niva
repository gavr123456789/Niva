type TyperDB
  listOfErrors: mut List::ResolveErrors // across all packages?

  packages: mut Map(String, NivaPkg)


  // caches
  internalTypesCache: mut Map(String, NivaType) // types from Core pkg
  typesWithSameNames: mut Map(String, mut Set::NivaType)
  // key = typeId ("pkg.Type"), value = branch typeIds
  unionRootToBranches: mut Map(String, mut Set::String)
  // reverse: branch typeId -> direct parent typeId
  branchIdToParentId: mut Map(String, String)

  typesById: mut Map(String, TypeT) // typeID("pkg.Map.Ing.String") to type, why not type to type, because we need real generic info
  // utils
  dtc: DefaultTypesContainer
  // methods
  typeToMethodNameToMethod: mut Map(NivaType, mut Map(String, NivaMethod)) // methodDB
  // Methods declared on generic receiver patterns (for example List(T)).
  // These are deliberately kept separate from the concrete method cache:
  // NivaType uses identity semantics as a Map key.
  genericReceiverMethods: mut List::GenericReceiverMethodTemplate
  // methods of nullable receivers(`Int? orZero = ...`, `T? unpackOr: x = ...`) they cant live in
  // typeToMethodNameToMethod, because NullableT is created anew every time and has no structural equality
  // methodName -> mangled name of the inner type -> method
  nullableMethods: mut Map(String, mut Map(String, NivaMethod))
  constructorsTypeToMethodNameToMethod: mut Map(NivaType, mut Map(String, NivaMethod)) // constructorsDB, since we can have constructo and message with the same names
  instantiatedCache: mut Map(NivaType, mut Map(String, NivaMethod)) // From instantiated generics types like List(Int)
  // canonical instances for collection types (ListT/SetT/MapT), keyed by "List_Int" etc.
  canonicalCollectionInstances: mut Map(String, NivaType)

  // generated
  generatedMessageDecls: mut List::MessageDecl
  typedBodiesCache: mut Map(MessageDecl, TypedBody)
  declToMethod: mut Map(MessageDecl, NivaMethod)

  // local scope for generic resolution
  localGenericScope: mut Map(String, NivaType)

  // bind metadata
  bindMeta: BindMeta




type BindMeta
  bindFiles: mut Set(String)
  bindFileToPkg: mut Map(String, String)
  bindStatements: mut Set(Statement)
  bindMessageDecls: mut Set(MessageDecl)
  bindTypeIds: mut Set(String)

constructor BindMeta new =
  BindMeta bindFiles: #()! bindFileToPkg: #{}! bindStatements: #()! bindMessageDecls: #()! bindTypeIds: #()!


constructor TyperDB new -> TyperDB = [
  tuple = NivaPkg core
  corePkg = tuple x
  dtc = tuple y

  sb = TypeT noFieldsWithName: "StringBuilder" pkgName: "core"
  corePkg types at: "StringBuilder" put: sb

  {char int float double str bool bind error unit nothing any t list map set intRange charRange} = dtc

  listProtocol    = NivaProtocol collectionFromDefaultTypes: dtc collectionType: list itemType: (UnresolvedGenericT name: "T")
  mapProtocol     = NivaProtocol mapFromDefaultTypes: dtc mapType: map keyType: map k valueType: map v
  setProtocol     = NivaProtocol setFromDefaultTypes: dtc setType: set itemType: set t
  intProtocol     = NivaProtocol numArithmeticsFromDefaultTypes: dtc num: dtc int
  doubleProtocol  = NivaProtocol numArithmeticsFromDefaultTypes: dtc num: dtc double
  strProtocol     = NivaProtocol stringFromDefaultTypes: dtc
  boolProtocol    = NivaProtocol boolFromDefaultTypes: dtc
  charProtocol    = NivaProtocol charFromDefaultTypes: dtc
  anyProtocol     = NivaProtocol anyFromDefaultTypes: dtc
  bindConstructors = NivaProtocol bindFromDefaultTypes: dtc
  errorProtocol   = NivaProtocol errorFromDefaultTypes: dtc errorType: error
  intRangeProtocol = NivaProtocol rangeFromDefaultTypes: dtc rangeType: intRange itemType: int
  charRangeProtocol = NivaProtocol rangeFromDefaultTypes: dtc rangeType: charRange itemType: char
  stringBuilderProtocol = NivaProtocol stringBuilderFromDefaultTypes: dtc sb: sb

  // every type needs its own empty protocol, sharing one map means
  // that a method added to one type appears on all of them
  floatProto::mut Map(String, NivaMethod) = #{}!
  unitProto::mut Map(String, NivaMethod) = #{}!

  typeToMethodNameToMethod::mut Map(NivaType, mut Map(String, NivaMethod)) = #{
    char charProtocol

    int intProtocol
    double doubleProtocol

    float floatProto

    str strProtocol
    bool boolProtocol

    unit unitProto

    any anyProtocol
    error errorProtocol
    list listProtocol
    map mapProtocol
    set setProtocol
    intRange intRangeProtocol
    charRange charRangeProtocol

    sb stringBuilderProtocol
  }

  charConstructors::mut Map(String, NivaMethod) = #{}!
  intConstructors::mut Map(String, NivaMethod) = #{}!
  floatConstructors::mut Map(String, NivaMethod) = #{}!
  doubleConstructors::mut Map(String, NivaMethod) = #{}!
  strConstructors::mut Map(String, NivaMethod) = #{}!
  boolConstructors::mut Map(String, NivaMethod) = #{}!
  unitConstructors::mut Map(String, NivaMethod) = #{}!
  anyConstructors::mut Map(String, NivaMethod) = #{}!
  listConstructors::mut Map(String, NivaMethod) = #{}!
  mapConstructors::mut Map(String, NivaMethod) = #{}!
  setConstructors::mut Map(String, NivaMethod) = #{}!
  sbConstructors::mut Map(String, NivaMethod) = #{}!
  sbConstructors at: "new" put: sb generateDefaultConstructor

  constructorsCache::mut Map(NivaType, mut Map(String, NivaMethod)) = #{
    char charConstructors
    int intConstructors
    float floatConstructors
    double doubleConstructors
    str strConstructors
    bool boolConstructors
    bind bindConstructors
    unit unitConstructors
    any anyConstructors
    error errorProtocol
    list listConstructors
    map mapConstructors
    set setConstructors
    sb sbConstructors
  }

  typesWithSameNames = #{}!
  typesById::mut Map(String, TypeT) = #{}!
  // add core types to typesWithSameNames so they can be found by mangled name (e.g. core_String)
  corePkg types values forEach: [
    mangled = it toMangledName
    typesWithSameNames at: mangled put: #(it)!
    | it
    | TypeT => typesById at: it toIdString put: it
    |=> []
  ]

  db = TyperDB
    listOfErrors: {}!
    packages: #{"core" corePkg}!
    internalTypesCache: corePkg types
    typesWithSameNames: typesWithSameNames
    unionRootToBranches: #{}!
    branchIdToParentId: #{}!
    typesById: typesById
    dtc: dtc
    typeToMethodNameToMethod: typeToMethodNameToMethod
    genericReceiverMethods: {}!
    nullableMethods: #{}!
    constructorsTypeToMethodNameToMethod: constructorsCache
    instantiatedCache: #{}!
    canonicalCollectionInstances: #{}!
    generatedMessageDecls: {}!
    typedBodiesCache: #{}!
    declToMethod: #{}!
    localGenericScope: #{}!
    bindMeta: BindMeta new

  // all core methods are stored in the type table above
  // but echo from anyProtocol is very special and has T echo -> T signature
  // so we registering it very very much specifically --- registerGenericReceiverMethod
  echoMethod = anyProtocol at: "echo", unpackOrPANIC
  db registerGenericReceiverMethod: echoMethod forType: echoMethod receiverType
  ^db

]

type GenericReceiverMethodTemplate
  receiverPattern: NivaType
  method: NivaMethod
  pkgName: String

extend TyperDB [
  on addBindFile(fileName): String pkgName: String = [
    bindMeta bindFiles add: fileName
    bindMeta bindFileToPkg at: fileName put: pkgName
  ]

  //on isBindFile(fileName): String -> Bool = bindMeta bindFiles contains: fileName

  //on pkgNameForFile(fileName): String -> String = [
  //  maybe = bindMeta bindFileToPkg at: fileName
  //  ^ maybe unpack: [it] or: fileName
  //]

  on markBindStatement(st): Statement = [
    bindMeta bindStatements add: st
  ]

  on isBindStatement(st): Statement -> Bool = bindMeta bindStatements contains: st

  on markBindMessageDecl(m): MessageDecl = [
    bindMeta bindMessageDecls add: m
  ]

  on isBindMessageDecl(m): MessageDecl -> Bool = bindMeta bindMessageDecls contains: m

  on markBindTypeId(typeId): String = [
    bindMeta bindTypeIds add: typeId
  ]

  on isBindTypeId(typeId): String -> Bool = bindMeta bindTypeIds contains: typeId

  on isBindType(t): NivaType -> Bool = this isBindTypeId: (t toMangledName)

  /// for generic instantiation
  on addGeneratedMessageDecl(m): MessageDecl = [
    generatedMessageDecls add: m
  ]

  on registerUnion(rootName): String inPkg(pkgName): String branches: List(String) = [
    rootId = pkgName + "." + rootName
    branchIds = branches map: [pkgName + "." + it]
    this registerUnionIds: rootId branches: branchIds
  ]

  on registerUnionIds(rootId): String branches(branchIds): List(String) = [
    existing = unionRootToBranches at: rootId
    set::mut Set::String =
      | existing
      | null => #()!
      |=> existing

    branchIds forEach: [branchId ->
      set add: branchId
      branchIdToParentId at: branchId put: rootId
    ]
    unionRootToBranches at: rootId put: set
  ]

  on isUnionBranch(branch): TypeT ofRoot(root): TypeT -> Bool = [
    branches = this unionBranchesDeep: root
    ^ branches contains: branch toIdString
  ]

  on findUnionParent(branch): TypeT -> TypeT? = [
    branchId = branch toIdString
    mut parentId::String? = branchIdToParentId at: branchId
    parentId == null ifTrue: [
      parentId <- branchIdToParentId at: (branch pkgName + "." + branch name)
    ]
    ^ parentId unpack: [
      exact = typesById at: it
      | exact
      | null => [
        pkg = it substringBefore: "."
        typeName = it substringAfter: "."
        found = this findByTypeName: typeName inPkg: pkg
        | found
        | TypeT => found
        |=> null
      ]
      |=> exact
    ] or: null
  ]

  on unionBranchesDeep(root): TypeT -> Set::String = [
    visited::mut Set::String = #()!
    ^ this unionBranchesDeepById: root toIdString visited: visited
  ]

  on unionBranchesDeepById(rootId): String visited: mut Set::String -> Set::String = [
    visited contains: rootId, ifTrue: [^ #()!]
    visited add: rootId

    direct = unionRootToBranches at: rootId
    ^ | direct
      | null => #()!
      |=> [
        expanded = #()!
        direct forEach: [branchId ->
          expanded add: branchId
          expanded addAll: (this unionBranchesDeepById: branchId visited: visited)
        ]
        expanded
      ]
  ]

  on unionLeaves(root): TypeT -> Set::String = [
    visited::mut Set::String = #()!
    ^ this unionLeavesById: root toIdString visited: visited
  ]

  on unionLeavesById(rootId): String visited: mut Set::String -> Set::String = [
    visited contains: rootId, ifTrue: [^ #()!]
    visited add: rootId

    direct = unionRootToBranches at: rootId
    ^ | direct
      | null => #()!
      |=> [
        leaves = #()!
        direct forEach: [branchId ->
          sub = unionRootToBranches at: branchId
          | sub
          | null => leaves add: branchId
          |=> [
            nestedLeaves = this unionLeavesById: branchId visited: visited
            leaves addAll: nestedLeaves
            ()
          ]
        ]
        leaves
      ]
  ]

  on unionAncestorChain(startType): TypeT -> List::TypeT = [
    parent = .findUnionParent: startType
    ^| parent
    | null => {startType}
    |=> [
      rest = .unionAncestorChain: parent
      chain = {startType}!
      chain addAll: rest
      chain toList
    ]
  ]

  on unionAncestorIds(startType): TypeT -> Set(String) = [
    chain = .unionAncestorChain: startType
    ^ chain map: [it toIdString],
      toSet
  ]

  on findFirstCommonUnionAncestor(types): List::NivaType -> TypeT? = [
    types isEmpty ifTrue: [^ null]

    nonTypeFound = types any: [
      | it | TypeT => false
      |=> true
    ]
    nonTypeFound ifTrue: [^ null]

    typeTs::mut List::TypeT = {}!
    types forEach: [
      | it | TypeT => typeTs add: it
      |=> []
    ]

    ancestorSets::mut List::Set::String = {}!
    typeTs forEach: [
      ancestorSets add: (this unionAncestorIds: it)
    ]

    firstChain = this unionAncestorChain: (typeTs first)

    found = firstChain find: [candidate ->
      candidateId = candidate toIdString
      isCommon <- true
      ancestorSets forEach: [set ->
        set contains: candidateId,
            ifFalse: [isCommon <- false]
      ]
      isCommon
    ]

    ^ found
  ]

  on mergeTypesByUnion(types): List::NivaType -> NivaType? = [
    types isEmpty ifTrue: [^ null]

    // unwrap NullableT branches (marking result nullable) and drop NothingT (bottom type)
    mut hasNullable::Bool = false
    unwrapped::mut List::NivaType = {}!
    types forEach: [t ->
      | t
      | NullableT => [
        hasNullable <- true
        | t v
        | NothingT => []
        |=> [
          unwrapped add: t v
          ()
        ]
      ]
      | NothingT => []
      |=> [
        unwrapped add: t
        ()
      ]
    ]

    // all branches were NothingT/Nullable(NothingT) - result is Nothing, possibly nullable
    unwrapped isEmpty ifTrue: [
      ^ hasNullable ifTrue: [NullableT v: dtc nothing] ifFalse: [dtc nothing]
    ]

    mut merged::NivaType = unwrapped first

    rest = unwrapped drop: 1
    rest forEach: [t ->
      merged sameTypeAs: t, ifFalse: [
        ancestor = this findFirstCommonUnionAncestor: {merged t}
        | ancestor
        | null => [^ null]
        |=> merged <- ancestor
      ]
    ]

    ^ hasNullable ifTrue: [NullableT v: merged] ifFalse: [merged]
  ]

  on isAssignable(actual): NivaType toExpected(expected): NivaType -> Bool = [
    ^ actual isAssignableTo: expected db: this
  ]

  // TODO replace with nullmatch + find
  on findUnionField(rootType): TypeT fieldName: String -> TypeTField? = [
    rootId = rootType toIdString
    ^ unionRootToBranches at: rootId, unpack: [branches ->
      branches forEach: [branchId ->
        branchType = typesById at: branchId
        | branchType
        | null => []
        |=> [
          field = branchType findField: fieldName
          field != null ifTrue: [^ field]
        ]
      ]
      null
    ] or: null
  ]
  /// nullable receivers are keyed by the mangled name of their inner type,
  /// every generic one(`T? m`, `G? m`) matches any nullable, so they all share a single slot
  on nullableMethodKeyFor(inner): NivaType -> String = [
    mangled = inner toMangledName
    ^ mangled isGeneric ifTrue: ["?"] ifFalse: [mangled]
  ]

  /// adds method to protocol, if no such protocol - creates it
  on addMethod(m): NivaMethod forType(forType): NivaType = [
    | forType
    // nullable receivers(`T? unpackOr: x = ...`) are never registered as types, see nullableMethods
    | NullableT => [
      innerToMethod::mut Map(String, NivaMethod) = nullableMethods get: m name orPut: [#{}!]
      key = .nullableMethodKeyFor: forType v
      innerToMethod containsKey: key,
        ifTrue: [TO DO: "Type $forType already has method $m"]

      innerToMethod at: key put: m
    ]
    |=> [
      methodNameToMethodMap::mut Map(String, NivaMethod) = (typeToMethodNameToMethod at: forType) unpackOrPANIC
      methodNameToMethodMap containsKey: m name,
        ifTrue: [TO DO: "Type $forType already has method $m"]

      methodNameToMethodMap at: m name put: m
    ]
    //m kind == MessageSendKind.Getter ifFalse: [
    //  "Methods: added method " + m name + " to new protocol $protocolName for type $forType in pkg ", log
    //]
  ]


  /// adds ne method for db, if protocol is null then adds to "common"
  on addNewMethod(m): NivaMethod forType::NivaType inProtocol::String? = [
    // A generic receiver is a pattern, not an instantiable method-table key.
    // Keep it in a separate registry and materialize it on first concrete use.
    isNullableReceiver = | forType
      | NullableT => true
      |=> false
    (forType isContainsUnresolvedGenerics) && (isNullableReceiver not)
      ifTrue: [this registerGenericReceiverMethod: m forType: forType]
      ifFalse: [
        this
          addMethod: m
          forType: forType
      ]

    m decl unpack: [
      existing = declToMethod at: it
      | existing
      | null => declToMethod at: it put: m
      |=> []
    ]
  ]

  on registerGenericReceiverMethod(m): NivaMethod forType: NivaType = [
    duplicate = genericReceiverMethods find: [candidate ->
      (candidate pkgName == m pkgName) &&
      (candidate receiverPattern sameTypeStrictAs: forType) &&
      (candidate method name == m name)
    ]
    duplicate != null ifTrue: [
      TO DO: "Generic receiver method $m name already exists for $forType in package $m pkgName"
    ]
    genericReceiverMethods add: (GenericReceiverMethodTemplate
      receiverPattern: forType
      method: m
      pkgName: m pkgName)
  ]

  /// Returns a mapping only when the whole receiver shape matches. In
  /// particular, TypeT arity is checked before collectGenericMappingsFrom,
  /// which otherwise indexes the actual generic arguments directly.
  on matchGenericReceiver(template): NivaType actual: NivaType -> Map(String, NivaType)? = [
    shapeMatches = [expected::NivaType, got::NivaType ->
      | expected
      | ListT => | got | ListT => true |=> false
      | SetT => | got | SetT => true |=> false
      | MapT => | got | MapT => true |=> false
      | TypeT => | got
        | TypeT => (expected name == got name) &&
                    (expected pkgName == got pkgName) &&
                    (expected genericArgs count == got genericArgs count)
        |=> false
      | NullableT => | got | NullableT => true |=> false
      | FuntionT => | got | FuntionT => expected fields count == got fields count |=> false
      | UnresolvedGenericT => true
      |=> expected sameTypeStrictAs: got
    ]
    shapeMatchesResult = shapeMatches expected: template got: actual

    shapeMatchesResult ifFalse: [^ null]
    letterToType::mut Map(String, NivaType) = #{}!
    template collectGenericMappingsFrom: actual into: letterToType db: this
    specialized = template replaceGenericsFromTableDeep: letterToType db: this
    (specialized isContainsUnresolvedGenerics) ifTrue: [^ null]
    sameReceiver = specialized sameTypeStrictAs: actual
    sameReceiver ifFalse: [^ null]
    ^ letterToType
  ]

  on findGenericReceiverMethod(name): String forType::NivaType -> NivaMethod? = [
    matches::mut List::NivaMethod = {}!
    genericReceiverMethods forEach: [candidate ->
      candidate method name == name ifTrue: [
        mapping = this matchGenericReceiver: candidate receiverPattern actual: forType
        mapping unpack: [letterToType ->
          receiverGenerics = candidate receiverPattern collectUnresolvedGenerics
          receiverNames = (receiverGenerics map: [generic -> generic name]) toSet
          specialized = candidate method replaceGenericsFromTable:
            letterToType dontMangle: receiverNames mangle: false db: this
          // Keep the canonical actual receiver identity used by the cache.
          // replaceGenericsFromTableDeep creates a structurally equal ListT/SetT/
          // MapT value, which is not safe as a Map key here.
          specializedWithActualReceiver = NivaMethod
            name: specialized name
            receiverType: forType
            args: specialized args
            returnType: specialized returnType
            returnErrors: specialized returnErrors
            forMut: specialized forMut
            possibleErrors: specialized possibleErrors
            kind: specialized kind
            decl: specialized decl
            protocolName: specialized protocolName
            pkgName: specialized pkgName
          matches add: specializedWithActualReceiver
        ]
      ]
    ]
    matches count == 0 ifTrue: [^ null]
    matches count > 1 ifTrue: [
      TO DO: "Ambiguous generic receiver method $name for $forType"
    ]
    method = matches first
    cache = typeToMethodNameToMethod at: forType
    | cache
    | null => [
      newCache::mut Map(String, NivaMethod) = #{}!
      newCache at: method name put: method
      typeToMethodNameToMethod at: forType put: newCache
    ]
    |=> cache at: method name put: method
    ^ method
  ]

  on addErrorMessage(e): ResolveErrors = [
    msg = e msg
    pos = e tok toPosition
    "ADDED ERROR $pos $msg" red log
    listOfErrors add: e
    //TO DO: "bad"
  ]

  on addErrorFromTok(tok): Token withMsg(msg): String = [
    "\n!!!!! ADDED ERROR $msg !!!!!\n" red log
    listOfErrors add: (LazyError :tok :msg)
  ]

  on addFatalErrorFromTok(tok): Token withMsg(msg): String = [
    "\n!!!!! ADDED ERROR $msg !!!!!\n" red log
    listOfErrors add: (LazyError :tok :msg)
    TO DO: "FATAL"
  ]

  on addNewConstructor(m): NivaMethod forType::NivaType = [
    Assert that: m kind equals: MessageSendKind.DefaultConstructor andSay: "add New DefaultConstructor, but its kind is " + m kind toString

    x::mut Map(String, NivaMethod) = this constructorsTypeToMethodNameToMethod at: forType, unpackOrPANIC
    x at: m name put: m

    m decl unpack: [
      existing = declToMethod at: it
      | existing
      | null => declToMethod at: it put: m
      |=> []
    ]

    //"addNewConstructor: added constructor " + m name + " for type " + forType name, log
  ]

  on addNewPkgIfNotExists(pkgName): String -> NivaPkg = [
    result = packages at: pkgName
    p = | result
        | null => [
          newPkg = NivaPkg withCoreImportednamed: pkgName
          packages at: pkgName put: newPkg
          newPkg
        ]
        |=> [
          result
        ]

    ^ p
  ]

  on addToTypesWithTheSameName(t): TypeT = [
    setMaybe = typesWithSameNames at: t name

    | setMaybe
    | null => [
      // create set
      newSet::mut Set::NivaType = #()!
      newSet add: t
      typesWithSameNames at: t name put: newSet
    ]
    |=> setMaybe add: t

  ]
  on addNewType(t): TypeT inPkg(pkgName): String = [
    // 1 add to pkg
    // find the pkg
    pkg = packages at: pkgName
    | pkg
    | null => TO DO: "Compiler bug: cant find pkg $pkgName"
    |=> pkg types at: t name put: t


    .addToTypesWithTheSameName: t

    // also add mangled name
    mangled = t toMangledName
    // we don't use addToTypesWithTheSameName because it uses t name
    setMaybe = typesWithSameNames at: mangled
    | setMaybe
    | null => [
      newSet::mut Set::NivaType = #()!
      newSet add: t
      typesWithSameNames at: mangled put: newSet
    ]
    |=> setMaybe add: t

    id = t toIdString
    typesById get: id orPut: [t]
    //"addNewType typesById: added new type $t to typesById with id: $id" log


    // 2 add to methods db
    x = this typeToMethodNameToMethod at: t
    | x
    | null => [
      //"addNewType: added new type $t to methods cache with 0 members" log
      this typeToMethodNameToMethod at: t put: #{}! // new type does't have any methods yet
    ] |=> TO DO: "Compiler bug: such type was already added to methodDB"

    // 3 to constructors
    xc = this constructorsTypeToMethodNameToMethod at: t
    | xc
    | null => [
      //"addNewType: added new type $t to constructor cache with 0 members" log
      this constructorsTypeToMethodNameToMethod at: t put: #{}! // new type does't have any methods yet
    ] |=> TO DO: "Compiler bug: such type was already added to constructorsDB"
  ]

  on addGenericInstantiationIfAbsent(t): TypeT letterToType::Map(String, NivaType) -> TypeT = [
    baseType = t
    newTypeWithGenericInstantiated = baseType replaceGenericsFromTable: letterToType db: this
    typeId = newTypeWithGenericInstantiated toIdString

    // check if it already
    typesById at: typeId, unpack: [
      //"already resolved generic $typeId" log
      ^it
    ]

    typesById at: typeId put: newTypeWithGenericInstantiated
    //"added new generic instantiation $typeId" log

    // add to lookup for mangled name (so we can find Box__Int)
    mangled = newTypeWithGenericInstantiated toMangledName
    // .addToTypesWithTheSameName: newTypeWithGenericInstantiated // this uses name, which is "Box"

    // manually add mangled name
    setMaybe = typesWithSameNames at: mangled
    | setMaybe
    | null => [
      newSet::mut Set::NivaType = #()!
      newSet add: newTypeWithGenericInstantiated
      typesWithSameNames at: mangled put: newSet
    ]
    |=> setMaybe add: newTypeWithGenericInstantiated


    // we adding type the first time, othervice it would be returned before
    Assert that: (instantiatedCache at: baseType) equals: null

    // add empty method lits to methods and constructors
    this instantiatedCache at: newTypeWithGenericInstantiated put: #{}!
    instMethods::mut Map(String, NivaMethod) = #{}!
    this typeToMethodNameToMethod at: newTypeWithGenericInstantiated put: instMethods
    instConstructors::mut Map(String, NivaMethod) = #{}!
    this constructorsTypeToMethodNameToMethod at: newTypeWithGenericInstantiated put: instConstructors

    // copy methods
    dontMangle = letterToType keys toSet
    methodsOfGeneric = this typeToMethodNameToMethod at: baseType
    | methodsOfGeneric
    | null => []
    |=> [
       methodsOfGeneric values forEach: [ m ->
          newM = m replaceGenericsFromTable: letterToType dontMangle: dontMangle mangle: false db: this
          instMethods at: newM name put: newM
       ]
    ]

    // copy constructors
    constructorsOfGeneric = this constructorsTypeToMethodNameToMethod at: baseType
    | constructorsOfGeneric
    | null => []
    |=> [
       constructorsOfGeneric values forEach: [ m ->
          newM = m replaceGenericsFromTable: letterToType dontMangle: dontMangle mangle: false db: this
          instConstructors at: newM name put: newM
       ]
    ]

    ^ newTypeWithGenericInstantiated
  ]

  on addCollectionInstantiationIfAbsent(collectionType): NivaType -> NivaType = [
    ^| collectionType
    | ListT => [
      collId = "List_" + collectionType t toMangledName
      existingCanonical = canonicalCollectionInstances at: collId
      existingCanonical != null ifTrue: [^ existingCanonical unpackOrPANIC]
      canonicalCollectionInstances at: collId put: collectionType

      coreBase = dtc list
      letterToType::mut Map(String, NivaType) = #{}!
      letterToType at: coreBase t name put: collectionType t

      baseMethods::mut Map(String, NivaMethod) = typeToMethodNameToMethod at: coreBase, unpackOrPANIC
      instMethods::mut Map(String, NivaMethod) = #{}!
      dontMangle = letterToType keys toSet

      baseMethods values forEach: [ m ->
        newM = m replaceGenericsFromTable: letterToType dontMangle: dontMangle mangle: false db: this
        instMethods at: newM name put: newM
      ]

      typeToMethodNameToMethod at: collectionType put: instMethods
      constructorsTypeToMethodNameToMethod at: collectionType put: #{}!
      collectionType
    ]
    | SetT => [
      collId = "Set_" + collectionType t toMangledName
      existingCanonical = canonicalCollectionInstances at: collId
      existingCanonical != null ifTrue: [^ existingCanonical unpackOrPANIC]
      canonicalCollectionInstances at: collId put: collectionType

      coreBase = dtc set
      letterToType::mut Map(String, NivaType) = #{}!
      letterToType at: coreBase t name put: collectionType t

      baseMethods::mut Map(String, NivaMethod) = typeToMethodNameToMethod at: coreBase, unpackOrPANIC
      instMethods::mut Map(String, NivaMethod) = #{}!
      dontMangle = letterToType keys toSet

      baseMethods values forEach: [ m ->
        newM = m replaceGenericsFromTable: letterToType dontMangle: dontMangle mangle: false db: this
        instMethods at: newM name put: newM
      ]

      typeToMethodNameToMethod at: collectionType put: instMethods
      constructorsTypeToMethodNameToMethod at: collectionType put: #{}!
      collectionType
    ]
    | MapT => [
      collId = "Map_" + collectionType k toMangledName + "_" + collectionType v toMangledName
      existingCanonical = canonicalCollectionInstances at: collId
      existingCanonical != null ifTrue: [^ existingCanonical unpackOrPANIC]
      canonicalCollectionInstances at: collId put: collectionType

      coreBase = dtc map
      letterToType::mut Map(String, NivaType) = #{}!
      letterToType at: coreBase k name put: collectionType k
      letterToType at: coreBase v name put: collectionType v

      baseMethods::mut Map(String, NivaMethod) = typeToMethodNameToMethod at: coreBase, unpackOrPANIC
      instMethods::mut Map(String, NivaMethod) = #{}!
      dontMangle = letterToType keys toSet

      baseMethods values forEach: [ m ->
        newM = m replaceGenericsFromTable: letterToType dontMangle: dontMangle mangle: false db: this
        instMethods at: newM name put: newM
      ]

      typeToMethodNameToMethod at: collectionType put: instMethods
      constructorsTypeToMethodNameToMethod at: collectionType put: #{}!
      collectionType
    ]
    |=> collectionType
  ]

  /// we use this for replacing an old method with Unknown return type with new one with resolved rt
  on replaceMethod(m): NivaMethod inType::NivaType = [
    | inType
    | NullableT => [
      innerToMethod::mut Map(String, NivaMethod) = nullableMethods at: m name, unpackOrPANIC
      innerToMethod at: (.nullableMethodKeyFor: inType v) put: m
    ]
    |=> [
      x::mut Map(String, NivaMethod) = typeToMethodNameToMethod at: inType, unpackOrPANIC
      x at: m name put: m
    ]
  ]


// FINDING

// добавить в NivaPkg список методов из других пакетов, точнее даже мапа
// методНейм - пкг, нет, тк кк в разных пакетах могут быть одинаковые методы
// как ни крути походу лучше всего хранить пакет в самом методе

  /// methods of nullable receivers(`Int? orZero = ...`, `T? unpackOr: x = ...`) live in
  /// nullableMethods instead of typeToMethodNameToMethod
  /// a method declared for the exact inner type wins over a generic one
  on findMethodOnNullable(name): String inner(innerType): NivaType -> NivaMethod? = [
    nullableMethods at: name, unpack: [ byInnerType ->
      // mangled names of collections dont contain their item types(`List(Int)` and `List(String)`
      // are both `core_List`), so the found method still has to be checked
      byInnerType at: (.nullableMethodKeyFor: innerType), unpack: [ m ->
        m receiverType unwrapNullable sameTypeStrictAs: innerType, ifTrue: [^ m]
      ]

      ^ byInnerType at: "?"
    ]

    ^ null
  ]

  on findMethodInAllProtocols(name): String forType::NivaType receiver::TypedExpr2  -> NivaMethod? = [
    lookupType = forType
    receiver isIdentifierConstructor ifTrue: [
      constructorsForType::mut Map(String, NivaMethod) = this constructorsTypeToMethodNameToMethod at: lookupType, unpackOrPANIC
      constructorDB = constructorsForType at: name
      | constructorDB
      | null => [
        formatted = constructorsForType values map: [m ->
          argsStr = m args isEmpty
            ifTrue:  [""]
            ifFalse: [m args joinWith: ", " transform: [it toString]]
          m args isEmpty
            ifTrue:  [m name]
            ifFalse: [m name + "(" + argsStr + ")"]
        ], sortedBy: [it]

        constructorsPretty = formatted isEmpty
          ifTrue: ["  (no constructors)"]
          ifFalse: ["  - " + (formatted joinWith: "\n  - ")]

        TO DO: "No such constructor $name' for type $lookupType.\nAvailable constructors:\n" + constructorsPretty
      ]
      |=> [
        ^ constructorDB
      ]
    ]

    nullableInner::NivaType? = | lookupType
      | NullableT => lookupType v
      |=> null

    x = this typeToMethodNameToMethod at: lookupType
    | x
    | null => [
      nullableInner unpack: [ inner ->
        ^ this findMethodOnNullable: name inner: inner
      ]
      genericMethod = this findGenericReceiverMethod: name forType: lookupType
      genericMethod unpack: [^ it]
      TO DO: "cant find type $lookupType in db typeToMethodNameToMethod"
    ]
    |=> []

    y::mut Map(String, NivaMethod) = x unpackOrPANIC

    //StackTrace get echo
    //"Methods: found method $name in $lookupType" log
    methodMaybe = y at: name
    result =
      | methodMaybe
      | null => [
        genericMethod = this findGenericReceiverMethod: name forType: lookupType
        genericMethod unpack: [^ it]
        | lookupType
        | TypeT => [
          // search union parents if method not found on the branch
          chain = this unionAncestorChain: lookupType
          rest = chain drop: 1
          parentWithMethod = rest find: [t ->
            methodsMaybe = this typeToMethodNameToMethod at: t
            | methodsMaybe
            | null => false
            |=> [
              methods::mut Map(String, NivaMethod) = methodsMaybe
              method = methods at: name
              method != null
            ]
          ]
          parentWithMethod unpack: [
            methods::mut Map(String, NivaMethod) = (this typeToMethodNameToMethod at: it), unpackOrPANIC
            inherited = methods at: name
            | inherited
            | null => null
            |=> [
              inheritsCoreErrorMethod =
                inherited returnErrors count == 1 &&
                (inherited returnErrors first name == "Error") &&
                (inherited returnErrors first pkgName == "core")

              inheritsCoreErrorMethod
                ifTrue:  [inherited copyWithDifferentReturnErrors: {lookupType}]
                ifFalse: [inherited]
            ]
          ] or: null
        ]
        |=> null
      ]
      |=> methodMaybe
    ^ result
  ]

  on findMsgFromReceiver(receiver): TypedExpr2
    byName(name): String
    currentPkg::NivaPkg -> NivaMethod = [

    receiverType = receiver typeInfo t
    // resolve do if this is message for a codeblock
    | receiverType
    | FuntionT => [
      name == "whileTrue" ifTrue: [
        {unit bool} = dtc

        receiverType returnType sameTypeAs: bool, ifFalse: [
          TO DO: "whileTrue receiver must return Bool"
        ]

        whileTrueProto = NivaProtocol whileTrueFromDefaultTypes: dtc
        whileTrueMethod = whileTrueProto at: "whileTrue", unpackOrPANIC
        bodyArgType = whileTrueMethod args first typeT

        ^ NivaMethod singleArgKw: "whileTrue" receiverType: receiverType argT: bodyArgType returnT: unit
      ]

      // check that its Do or any arg names
      result = name == "do" ifTrue: [
        NivaMethod unary: "do" receiverType: receiverType returnT: receiverType returnType
      ] ifFalse: [
        // check that it has args
        // then compare them
        NivaMethod manyArgKw: receiverType fields receiverType: receiverType returnT: receiverType returnType
    ]

      ^ result
    ]
    |=> []
    pkg = packages at: receiverType pkgName, unpackOrPANIC

    methodMaybe = this findMethodInAllProtocols: name forType: receiverType :receiver
    method =
      | methodMaybe
      | null => [
          {any} = dtc
          foundInAnyMaybe = this findMethodInAllProtocols: name forType: any :receiver
          | foundInAnyMaybe
          | null => [ // TODO check for nullable, and suggest unpacking methods
                      TO DO: "Searching for $name method but its not found for type $receiverType"]
          |=> foundInAnyMaybe
        ]
      |=> methodMaybe


    result =
      | method returnType
      | Unknown => [
        //"Lazy resolving for $name", log

        {decl} = method
        | decl
        | null => TO DO: "Compiler bug, only single expr methods can have Unknown method, and they should have decl defined"
        |=> [
          Assert that: decl isSingleExpr equals: true


          typedBody = decl resolveBodyWithDb: this pkg: pkg extraTypes: #{}!

          Assert that: typedBody v isNotEmpty equals: true

          returnType = typedBody v last typeInfo t

          methodToReplace = method copyWithDifferentReturnType: returnType
          this replaceMethod: methodToReplace inType: method receiverType
          methodToReplace
        ]
      ]
      |=> method

    // ensure module import is generated for cross-pkg method calls
    currentPkg addImport: result pkgName

    ^ result
  ]

  on findByTypeName(typeName): String = .findByTypeName: typeName inPkg: null


  on findByTypeName(typeName): String inPkg(pkgName): String? -> NivaType = [

    typeName isGeneric ifTrue: [
      ^ UnresolvedGenericT name: typeName
    ]

    // generated declarations refer to types by mangled name, and a nullable one
    // is never registered anywhere, so rebuild it from its base(`Nullable__core_Int`)
    (typeName startsWith: NULLABLE_MANGLE_PREFIX) ifTrue: [
      base = typeName drop: NULLABLE_MANGLE_PREFIX count
      ^ NullableT v: (.findByTypeName: base inPkg: pkgName)
    ]

    // check local scope
    localGenericScope at: typeName, unpack: [
      ^ it
    ]

    // if core return from cache
    internalType = internalTypesCache at: typeName
    | internalType
    | null => []//TO DO: "internal type: $typeName is not in core pkg" // compiler bug, not user error, so token wont be needed
    |=> [^ internalType
          Unit]

    // its not core type
    // so use typesWithSameNames

    result = | pkgName
    | null => [
      // we dont know the pkg, so search type in every pkg
      sameNameType = typesWithSameNames at: typeName
      knownNames = typesWithSameNames keys
      | sameNameType
      | null => TO DO: "Bug: Cant find type $typeName in typesWithSameNames, known: $knownNames"
      |=> [
        | sameNameType count == 1
        | true => [
          // found only one type in the pkg
          ^ sameNameType first
        ]
        | false => TO DO: "There are many types with the same name: $sameNameType, please specify pkg like pkg.type"
      ]
    ]
    |=> [
      // we know the pkg, so search for type in it
      pkg = packages at: pkgName
      | pkg
      | null => [TO DO: "No such package as $pkgName, known pkgs: $packages"]
      |=> [
        foundType = pkg types at: typeName
        | foundType
        | null => [TO DO: "No such type: $typeName in $pkgName"]
        |=> [
          ^ foundType
        ]
      ]
    ]
    ^ result
  ]


  // INFO

  on appendStructureInfoForType(t): NivaType to(sb): StringBuilder -> Unit = [
    sb appendLine: "### Type `" + t name + "`"

    sb appendLine: "#### Fields"
    fields = t collectFields
    fields isEmpty
      ifTrue: [
        sb appendLine: "_None._"
        ()
      ]
      ifFalse: [
        fields forEach: [field ->
          mutPrefix = field isMut ifTrue: ["mut "] ifFalse: [""]
          sb appendLine: "- `" + field name + "`: `" + mutPrefix + field typeT nameForInfo + "`"
        ]
      ]

    sb appendLine: "#### Methods"
    methodsMaybe = typeToMethodNameToMethod at: t
    methods = methodsMaybe unpack: [methodMap ->
      methodMap values
        filter: [it kind != MessageSendKind.Getter]
        ,sortedBy: [it name]
    ] or: {NivaMethod}
    methods isEmpty
      ifTrue: [
        sb appendLine: "_None._"
        ()
      ]
      ifFalse: [
        methods forEach: [method ->
          sb appendLine: "- `" + method infoSignature + "`"
        ]
      ]
    sb appendLine: ""
    ()
  ]

  on appendStructureInfoForPackage(pkg): NivaPkg to(sb): StringBuilder -> Unit = [
    sb appendLine: "## Package `" + pkg name + "`"
    types = pkg types values toList sortedBy: [it name]
    types isEmpty
//       ifTrue: [
//         sb appendLine: "_No types._"
//         ()
//       ]
      ifFalse: [types forEach: [this appendStructureInfoForType: it to: sb]]
    ()
  ]

  /// Returns Markdown documentation about every package -> type -> fields/methods.
  on structureInfo -> String = [
    sb = StringBuilder new
    sb appendLine: "# Niva project info"
    sb appendLine: ""
    projectPackages = packages values
      filter: [it name != "core"]
      ,sortedBy: [it name]
    projectPackages forEach: [this appendStructureInfoForPackage: it to: sb]

    ^ sb toString
  ]

  /// Returns the same Markdown hierarchy narrowed to `package.Type`.
  on structureInfoFor(typePath): String -> String = [
    hasPackageAndType = (typePath contains: ".") &&
      ((typePath substringBeforeLast: ".") count != 0) &&
      ((typePath substringAfterLast: ".") count != 0)
    hasPackageAndType ifFalse: [
      ^ "# Niva info error\n\nExpected a type path in the form `package.Type`, got `" + typePath + "`."
    ]

    pkgName = typePath substringBeforeLast: "."
    typeName = typePath substringAfterLast: "."
    pkgMaybe = packages at: pkgName
    pkgMaybe unpack: [pkg ->
      typeMaybe = pkg types at: typeName
      typeMaybe unpack: [t ->
        sb = StringBuilder new
        sb appendLine: "# Niva project info"
        sb appendLine: ""
        sb appendLine: "## Package `" + pkg name + "`"
        this appendStructureInfoForType: t to: sb
        ^ sb toString
      ]
      ^ "# Niva info error\n\nType `" + typeName + "` was not found in package `" + pkgName + "`."
    ]
    ^ "# Niva info error\n\nPackage `" + pkgName + "` was not found."
  ]
]

type ResolverHelper
  fileToStatements: Map(String, List::TypedStatement)  // fully typed declarations
  db: TyperDB
  entryPointExpressions: List::TypedExpr2
  entryPointName: String

constructor ResolverHelper resolve(fileToContent): Map(String, String) entryPoint: String -> ResolverHelper  = [
  ^ ResolverHelper resolve: fileToContent entryPoint: entryPoint backend: "js"
]

// A bind file is named `<pkgpath>.bind.niva`; the map key has `.niva` already
// stripped, so we look for a trailing `.bind`. Dots in the package part become
// slashes so `net.http.bind.niva` binds to the Go import path `net/http`.
// Returns the Go import path, or null if this is not a bind file.
String parseBindFileName -> String? = [
  marker = ".bind"
  (this endsWith: marker) ifFalse: [^ null]
  pkgRaw = this substringBeforeLast: marker
  pkgRaw count == 0 ifTrue: [^ null]
  ^ pkgRaw replace: "." with: "/"
]

constructor ResolverHelper resolve(fileToContent): Map(String, String) entryPoint: String backend: String -> ResolverHelper  = [
  fileToStatements::mut Map(String, mut List::Statement) = #{}!
  db = TyperDB new

  getStatementsList = [pkgName::String ->
    listMaybe = fileToStatements at: pkgName
    | listMaybe
    | null => [
        newList::mut List::Statement = {}!
        fileToStatements at: pkgName put: newList
        newList
      ]
    |=> listMaybe
  ]

  // scan bind files first
  fileToContent forEach: [ file, content ->
    pkgNameMaybe = file parseBindFileName
    | pkgNameMaybe
    | null => []
    |=> [
      pkgName = pkgNameMaybe
      db addBindFile: file pkgName: pkgName
      statements = TestParse withInput: content file: (SourceFile path: (file + ".bind.niva")) expectedCount: -1
      list = getStatementsList pkgName: pkgName
      statements forEach: [
        | it
        // no top level expressions allowed in a .bind.niva file
        // TODO: report a proper compile error here instead of skipping
        | Expr => []
        |=> [
          list add: it
          db markBindStatement: it
          | it
          | MessageDecl => db markBindMessageDecl: it
          | ExtendDecl  => it messages forEach: [db markBindMessageDecl: it]
          // types declared in a bind file are bindings to existing Go types,
          // so mark them: the Go backend must not emit a struct for them
          | TypeDecl    => db markBindTypeId: (pkgName + "_" + it name)
          | UnionDecl   => db markBindTypeId: (pkgName + "_" + it name)
          |=> []
        ]
      ]
    ]
  ]

  // scan normal files
  fileToContent forEach: [ file, content ->
    bindInfo = file parseBindFileName
    bindInfo == null ifTrue: [
      statements = TestParse withInput: content file: (SourceFile path: (file + ".niva")) expectedCount: -1
      list = getStatementsList pkgName: file
      statements forEach: [list add: it]
    ]
  ]

  entryPointStatementsMaybe = fileToStatements at: entryPoint
  entryPointStatements =
    | entryPointStatementsMaybe
    | null => [TO DO: "trying to find entryPoint: " + entryPoint + " but not found in " + fileToStatements toString]
    |=> [ entryPointStatementsMaybe ]

  msgDecls = TypeDeclVisitor db: db,
    visitAllTypesThenTypesAndMethods: fileToStatements
    entryPointStatements: entryPointStatements

  MsgDeclVisitor new
    processBodyes: msgDecls
    db: db

  // resolve entry point expressions
  entryPointExprs::mut List::Expr = {}!
  entryPointStatements forEach: [
    | it
    | Expr => entryPointExprs add: it
    |=> []
  ]
  entryPointBody = Body unTypedBody: entryPointExprs
  entryPointPkg = db addNewPkgIfNotExists: "entryPoint"
  typedMain = entryPointBody
    resolveBody2: db
    withContext: (Context rootWithPkg: entryPointPkg)

  // merge entryPoint imports into the real entry file pkg
  realEntryPkg = db addNewPkgIfNotExists: entryPoint

  entryPointPkg imports forEach: [
    realEntryPkg addImport: it
  ]
  entryPointPkg packageImports forEach: [
    realEntryPkg addPackageImport: it
  ]

  // add generated functions to fileToStatements
  db generatedMessageDecls forEach: [
    receiverType = db findByTypeName: it receiver name inPkg: null
    pkgName = receiverType pkgName
    isBindType = db isBindType: receiverType
    isBindType ifFalse: [
      listMaybe = fileToStatements at: pkgName
      | listMaybe
      | null => [
        (fileToStatements at: entryPoint, unpackOrPANIC) add: it
      ]
      |=> listMaybe add: it
    ]
  ]

  // build typed declarations map
  toTypeFieldT = [field::TypeField ->
    TypeFieldT
      name: field name
      typeInfo: (field astType toTypeInfoFromDb: db inPkg: null)
  ]

  toUnionBranchT = [branch::UnionBranch ->
    UnionBranchT
      name: branch name
      fields: (branch fields map: [f -> toTypeFieldT field: f])
      isInclude: branch isInclude
      token: branch token
  ]

  toTypedMessageDecl = [msgDecl::MessageDecl pkg::NivaPkg ->
    receiverType = msgDecl receiver toNivaTypefromDB: db inPkg: null
    argsTyped = msgDecl args map: [arg ->
      NameAndTypeInfo
        name: arg name
        typeInfo: (arg astType toTypeInfoFromDb: db inPkg: null)
    ]
    typedBodyMaybe = db typedBodiesCache at: msgDecl
    typedBody =
      | typedBodyMaybe
      | null => [
        extraTypes::mut Map(String, NivaType) = #{}!
        | receiverType
        | TypeT => [
          receiverType genericArgs forEach: [
            extraTypes at: it name put: it
          ]
        ]
        |=> []
        msgDecl resolveBodyWithDb: db pkg: pkg extraTypes: extraTypes
      ]
      |=> typedBodyMaybe
    fallbackReturnInfo = [
      noDeclaredReturnType = msgDecl returnType == null
      shouldUseBodyType = msgDecl isSingleExpr && noDeclaredReturnType
      inferredReturnType = shouldUseBodyType ifTrue: [typedBody t] ifFalse: [msgDecl getReturnTypeIfDeclaredOrUnknown: db]
      inferredReturnType toTypeInfoDefault
    ] do
    returnInfo = msgDecl returnType unpack: [
      baseInfo = it toTypeInfoFromDb: db inPkg: null
      it hasAnyErrorMarker
        ifTrue: [TypeInfo t: baseInfo t isMut: baseInfo isMut listOfErrors: typedBody listOfErrors]
        ifFalse: [baseInfo]
    ] or: fallbackReturnInfo

    MessageDeclT
      receiver: receiverType
      name: msgDecl name
      args: argsTyped
      returnType: returnInfo
      body: typedBody
      isSingleExpr: msgDecl isSingleExpr
      isConstructor: msgDecl isConstructor
      token: msgDecl token
  ]

  fileToTypedStatements::mut Map(String, mut List::TypedStatement) = #{}!
  entryExprsTyped = typedMain v
  fileToStatements forEach: [file, statements ->
    pkg = db packages at: file, unpackOrPANIC
    isEntryPointFile = file == entryPoint
    mut entryExprIndex = 0
    typedList::mut List::TypedStatement = {}!
    mut hasNonBind = false
    statements forEach: [
      isBind = db isBindStatement: it
      isBind ifFalse: [
        hasNonBind <- true
        | it
        | Expr => [
          isEntryPointFile ifTrue: [
            entryExprIndex < (entryExprsTyped count) ifFalse: [
              TO DO: "Entry point expressions count mismatch for " + entryPoint
            ]
            typedList add: (entryExprsTyped at: entryExprIndex)
            entryExprIndex <- entryExprIndex + 1
          ]
          ()
        ]
        | TypeDecl => [
          typedList add: (TypeDeclT
                            name: it name
                            genericParams: it genericParams
                            fields: (it fields map: [f -> toTypeFieldT field: f])
                            token: it token)
          ()
        ]
        | EnumDecl => [
          typedList add: (EnumDeclT token: it token)
          ()
        ]
        | UnionDecl => [
          typedList add: (UnionDeclT
                            name: it name
                            genericParams: it genericParams
                            commonUnionFields: (it commonUnionFields map: [f -> toTypeFieldT field: f])
                            branches: (it branches map: [b -> toUnionBranchT branch: b])
                            token: it token)
          ()
        ]
        | ExtendDecl => [
          receiverType = it receiver toNivaTypefromDB: db inPkg: null
          typedMsgs = it messages map: [m -> toTypedMessageDecl msgDecl: m pkg: pkg]
          typedList add: (ExtendDeclT
                            receiver: receiverType
                            messages: typedMsgs
                            token: it token)
          ()
        ]
        | MessageDecl => [
          typedList add: (toTypedMessageDecl msgDecl: it pkg: pkg)
          ()
        ]
      ]
    ]
    hasNonBind
      ifTrue: [ fileToTypedStatements at: file put: typedList ]
  ]

  ^ ResolverHelper
    fileToStatements: fileToTypedStatements
    db: db
    entryPointExpressions: typedMain v
    entryPointName: entryPoint
]

TypeT replaceGenericsFromTable(letterToType): Map(String, NivaType) db(db): TyperDB -> TypeT = [
  newFields = fields map: [
    TypeTField name: it name
              typeT: (it typeT replaceGenericsFromTableDeep: letterToType db: db)
              isMut: it isMut
  ]

  newGenericArgs = genericArgs map: [
    it replaceGenericsFromTableDeep: letterToType db: db
  ]

  ^TypeT fields: newFields toMutableList
        genericArgs: newGenericArgs toMutableList
        :name :pkgName
]
