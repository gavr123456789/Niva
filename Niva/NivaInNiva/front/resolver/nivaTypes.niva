type TypeTField
  name: String
  typeT: NivaType
  isMut: Bool
TypeTField toString -> String =
  "$name: " + (isMut ifTrue: ["mut "] ifFalse: [""]) + typeT toString

/// no name provided
constructor TypeTField binary(t): NivaType = TypeTField name: "" typeT: t isMut: false

union NivaType name: String pkgName: String =
| ^Complex
| UnitT
| IntegerT
| FloatT
| DoubleT
| BoolT
| CharT
| StringT
| AnyT
| NothingT

// collections
| ListT t: NivaType
| SetT t: NivaType
| MapT k: NivaType v: NivaType
// utility
| UnresolvedGenericT letter: String
| NullableT v: NivaType
| Unknown // Special type for


union Complex
  name: String
  pkgName: String
  fields: mut List::TypeTField
  genericArgs: mut List::NivaType =
| TypeT
| FuntionT
  returnType: NivaType // method or lambda
  returnErrors: List(NivaType) // latent errors produced when the function is called

extend NivaType [

  /// type name used in user-facing project information.
  on nameForInfo -> String = [
    nivaType = this
    ^ | nivaType
      | TypeT => [
        nivaType genericArgs isNotEmpty
          ifTrue: [name + "(" + (nivaType genericArgs joinWith: ", " transform: [it nameForInfo]) + ")"]
          ifFalse: [name]
      ]
      | FuntionT => [
        argsStr = nivaType fields joinWith: ", " transform: [it typeT nameForInfo]
        errorsStr = nivaType returnErrors isEmpty
          ifTrue: [""]
          ifFalse: ["!{" + (nivaType returnErrors joinWith: " " transform: [it nameForInfo]) + "}"]
        "[" + argsStr + " -> " + (nivaType returnType nameForInfo) + errorsStr + "]"
      ]
      | ListT => [
        elementType = nivaType t
        "List(" + (elementType nameForInfo) + ")"
      ]
      | SetT => [
        elementType = nivaType t
        "Set(" + (elementType nameForInfo) + ")"
      ]
      | MapT => [
        keyType = nivaType k
        valueType = nivaType v
        "Map(" + (keyType nameForInfo) + ", " + (valueType nameForInfo) + ")"
      ]
      | NullableT => [
        valueType = nivaType v
        (valueType nameForInfo) + "?"
      ]
      |=> name
  ]

  on unwrapNullable -> NivaType = [
    ^ | this
      | NullableT => this v
      |=> this
  ]


  on toNullable -> NullableT =
    | this
    | NullableT => TO DO: this toString + "already nullable"
    |=> NullableT v: this


  /// generate unique identifiers for instantiated types (Box__Int)
  on toMangledName -> String = [
    nivaType = this
    ^ | nivaType
    | TypeT => [
      genericArgsStr = nivaType genericArgs isNotEmpty
                        ifTrue:  ["__" + (nivaType genericArgs joinWith: "_" transform: [it toMangledName])]
                        ifFalse: [""]
      pkgName + "_" + name + genericArgsStr
    ]
    | UnresolvedGenericT => [name]
    | ListT => [
      elementType = nivaType t
      pkgName + "_" + name + "__" + (elementType toMangledName)
    ]
    | SetT => [
      elementType = nivaType t
      pkgName + "_" + name + "__" + (elementType toMangledName)
    ]
    | MapT => [
      keyType = nivaType k
      valueType = nivaType v
      pkgName + "_" + name + "__" + (keyType toMangledName) + "__" + (valueType toMangledName)
    ]
    | NullableT => [
      valueType = nivaType v
      "Nullable__" + (valueType toMangledName)
    ]
    | Unknown => ["Unknown"]
    |=> [
      pkgName + "_" + name
    ]
  ]

  on typeArgsForComparison -> List(NivaType) = [
    nivaType = this
    | nivaType
    | ListT => {(nivaType t)}
    | SetT => {(nivaType t)}
    | MapT => {(nivaType k) (nivaType v)}
    | NullableT => {(nivaType v)}
    |=> {}
  ]

  on replaceGenericsFromTableDeep(letterToType): Map(String, NivaType) db: TyperDB -> NivaType = [
    ^| this
    | TypeT => [
      db addGenericInstantiationIfAbsent: this
         :letterToType
    ]
    | UnresolvedGenericT => [
      maybe = letterToType at: this name
      | maybe
      | null => this
      |=> maybe
    ]
    | ListT => [
      ListT t: (this t replaceGenericsFromTableDeep: letterToType :db)
    ]
    | SetT => [
      SetT t: (this t replaceGenericsFromTableDeep: letterToType :db)
    ]
    | MapT => [
      MapT k: (this k replaceGenericsFromTableDeep: letterToType :db)
           v: (this v replaceGenericsFromTableDeep: letterToType :db)
    ]
    | FuntionT => [
      newFields = fields map: [
        TypeTField name: it name
                  typeT: (it typeT replaceGenericsFromTableDeep: letterToType :db)
                  isMut: it isMut
      ]
      newGenericArgs = genericArgs map: [it replaceGenericsFromTableDeep: letterToType :db]
      newReturnType = returnType replaceGenericsFromTableDeep: letterToType :db
      newReturnErrors = returnErrors map: [it replaceGenericsFromTableDeep: letterToType :db]
      FuntionT
        :name
        :pkgName
        fields: newFields toMutableList
        genericArgs: newGenericArgs toMutableList
        returnType: newReturnType
        returnErrors: newReturnErrors
    ]
    | NullableT => [
      NullableT v: (this v replaceGenericsFromTableDeep: letterToType :db)
    ]
    |=> this
  ]

  on isContainsUnresolvedGenerics -> Bool = [
    ^| this
    | UnresolvedGenericT => true
    | ListT => this t isContainsUnresolvedGenerics
    | SetT => this t isContainsUnresolvedGenerics
    | MapT => (this k isContainsUnresolvedGenerics) || (this v isContainsUnresolvedGenerics)
    | FuntionT => [
      hasGenericInFields = fields any: [ it typeT isContainsUnresolvedGenerics ]
      hasGenericInReturn = returnType isContainsUnresolvedGenerics
      hasGenericInErrors = returnErrors any: [it isContainsUnresolvedGenerics]

      hasGenericInFields || hasGenericInReturn || hasGenericInErrors
    ]
    | TypeT => [
      genericArgs any: [ it isContainsUnresolvedGenerics ]
    ]
    | NullableT => this v isContainsUnresolvedGenerics
    |=> false
  ]

  on collectUnresolvedGenericsInto(visitedTypes): mut Set(String) -> List(NivaType) = [
    ^ | this
      | UnresolvedGenericT => [
        result::mut List(NivaType) = {}!
        genericArg::NivaType = this
        result add: genericArg
        result toList
      ]
      | ListT => this t collectUnresolvedGenericsInto: visitedTypes
      | SetT => this t collectUnresolvedGenericsInto: visitedTypes
      | MapT => [
        res::mut List::NivaType = {}!
        this k collectUnresolvedGenericsInto: visitedTypes, forEach: [res add: it]
        this v collectUnresolvedGenericsInto: visitedTypes, forEach: [res add: it]
        res toList
      ]
      | FuntionT => [
        res::mut List::NivaType = {}!
        fields forEach: [it typeT collectUnresolvedGenericsInto: visitedTypes, forEach: [res add: it]]
        returnType collectUnresolvedGenericsInto: visitedTypes, forEach: [res add: it]
        returnErrors forEach: [it collectUnresolvedGenericsInto: visitedTypes, forEach: [res add: it]]
        res toList
      ]
      | TypeT => [
        typeKey = pkgName + "." + name
        visitedTypes contains: typeKey, ifTrue: [
          empty::mut List(NivaType) = {}!
          ^ empty toList
        ]
        visitedTypes add: typeKey
        res::mut List::NivaType = {}!
        genericArgs forEach: [it collectUnresolvedGenericsInto: visitedTypes, forEach: [res add: it]]
        fields forEach: [it typeT collectUnresolvedGenericsInto: visitedTypes, forEach: [res add: it]]
        visitedTypes remove: typeKey
        res toList
      ]
      | NullableT => this v collectUnresolvedGenericsInto: visitedTypes
      |=> {} // empty list
  ]

  on collectUnresolvedGenerics -> List(NivaType) = [
    visitedTypes::mut Set(String) = #()!
    ^ this collectUnresolvedGenericsInto: visitedTypes
  ]

  on collectGenericMappingsFrom(actual): NivaType into: mut Map(String, NivaType) db: TyperDB = [
    | this
    | UnresolvedGenericT => [
      existing = into at: letter
      | existing
      | null => [
        // unresolved type doesnt means its generic, it maybe lambda like T -> T
        | actual
        | UnresolvedGenericT => []
        |=> into at: letter put: actual
      ]

      |=> [
        existing sameTypeAs: actual, ifFalse: [
          merged = db mergeTypesByUnion: {existing actual}
          | merged
          | null => []
          |=> into at: letter put: merged

        ]
      ]
    ]
    | ListT => [
      | actual
      | ListT => this t collectGenericMappingsFrom: actual t :into :db
      |=> []
    ]
    | SetT => [
      | actual
      | SetT => this t collectGenericMappingsFrom: actual t :into :db
      |=> []
    ]
    | MapT => [
      | actual
      | MapT => [
        this k collectGenericMappingsFrom: actual k :into :db
        this v collectGenericMappingsFrom: actual v :into :db
      ]
      |=> []
    ]
    | FuntionT => [
      | actual
      | FuntionT => [
        fields count == actual fields count ifTrue: [
          fields forEachIndexed: [i, fExp ->
            fAct = actual fields at: i
            fExp typeT collectGenericMappingsFrom: fAct typeT :into :db
          ]
        ]
        returnType collectGenericMappingsFrom: actual returnType :into :db
      ]
      |=> []
    ]
    | TypeT => [
      | actual
      | TypeT => [
        (name == actual name) && (pkgName == actual pkgName), ifTrue: [
          genericArgs forEachIndexed: [i, gExp ->
            gAct = actual genericArgs at: i
            gExp collectGenericMappingsFrom: gAct :into :db
          ]
        ]
      ]
      |=> []
    ]
    | NullableT => [
      | actual
      | NullableT => this v collectGenericMappingsFrom: actual v :into :db
      |=> []
    ]
    |=> []
  ]

  on findField(fieldName): String -> TypeTField? = [
    field = | this
            | Complex => fields find: [it name == fieldName]
            |=> null
    ^ field
  ]

  on collectFields -> List(TypeTField) =
    | this
    | Complex => [fields toList]
    |=> {}

]

constructor TypeT noFieldsWithName(name): String pkgName: String  = TypeT
  :name :pkgName fields: {}! genericArgs: {}!

extend TypeT [
  on generateDefaultConstructor -> NivaMethod =
    NivaMethod
      defaultConstructorWithName: (fields isEmpty ifTrue: ["new"]
                                                  ifFalse: [fields joinWith: "__"
                                                                   transform: [it name]])
      receiverType: this
      args: fields
      returnType: this
      decl: null
      protocolName: "constructors"
      pkgName: this pkgName



  /// collect unresolved generics from fields
  on collectGenerics -> List(NivaType) = [
    set::mut Set(String) = #()!
    result::mut List(NivaType) = {}!

    fields forEach: [
      it typeT collectUnresolvedGenerics forEach: [g ->
        set contains: g name, ifFalse: [
          set add: g name
          result add: g
        ]
      ]
    ]

    ^ result
  ]
  /// creates unique identificator
  on toIdString -> String = [
    genericStr = genericArgs isNotEmpty
                        ifTrue: [ "<" + (genericArgs map: [it name], sortedBy: [it], joinWith: " " transform: [it]) + ">"]
                        ifFalse: [""]

    ^ pkgName + "." + name + genericStr
  ]

]


constructor UnresolvedGenericT name: String = UnresolvedGenericT :name pkgName: "core" letter: name
constructor UnitT new    = UnitT    name: "Unit"    pkgName: "core"
constructor IntegerT new = IntegerT name: "Int"     pkgName: "core"
constructor IntegerT long = IntegerT name: "Long"   pkgName: "core"
constructor FloatT new   = FloatT   name: "Float"   pkgName: "core"
constructor DoubleT new  = DoubleT  name: "Double"  pkgName: "core"
constructor BoolT new    = BoolT    name: "Bool"    pkgName: "core"
constructor StringT new  = StringT  name: "String"  pkgName: "core"
constructor CharT new    = CharT    name: "Char"    pkgName: "core"

constructor AnyT new     = AnyT     name: "Any"     pkgName: "core"
constructor NothingT new = NothingT name: "Nothing" pkgName: "core"
constructor Unknown new  = Unknown  name: "Unknown" pkgName: "core"

constructor ListT t::NivaType            = ListT name: "List" pkgName: "core" :t
constructor SetT t::NivaType             = SetT name: "Set" pkgName: "core" :t
constructor MapT k::NivaType v::NivaType = MapT name: "Map" pkgName: "core" :k :v

constructor NullableT v::NivaType = NullableT name: v name pkgName: v pkgName :v

// keep core function types error free
constructor FuntionT [
  on fields(fields): mut List::TypeTField name(name): String genericArgs(genericArgs): mut List::NivaType pkgName(pkgName): String returnType(returnType): NivaType -> FuntionT =
    FuntionT :name :pkgName :fields :genericArgs :returnType returnErrors: {}
]


type NivaMethod
  name: String
  receiverType: NivaType
  args: List(TypeTField)
  returnType: NivaType
  returnErrors: List::NivaType
  forMut: Bool // can be called only on mutable types
  possibleErrors: List(TypeT)//List(UnionT)
  kind: MessageSendKind
  decl: MessageDecl? // getters, default constructors(new and fields) and messages from Core pkg does not have decls
  protocolName: String
  pkgName: String
  isInline: Bool

extend NivaMethod [
  on infoSignature -> String = [
    selector = args isEmpty
      ifTrue: [name]
      ifFalse: [
        firstArg = args first
        firstArg name == ""
          ifTrue: [name + " " + firstArg typeT nameForInfo]
          ifFalse: [args joinWith: " " transform: [it name + ": " + it typeT nameForInfo]]
      ]
    mutPrefix = forMut ifTrue: ["mut "] ifFalse: [""]
    ^ mutPrefix + selector + " -> " + returnType nameForInfo
  ]

  on getGenericArgs =
    args filter: [
      | it typeT
      | UnresolvedGenericT => true
      |=> false
    ]


  on replaceGenericsFromTable(letterToType): Map(String, NivaType) dontMangle: Set(String) mangle: Bool db: TyperDB -> NivaMethod = [

    recType = receiverType
    retType = returnType
    instantiatedReceiverOrDefaultT = recType replaceGenericsFromTableDeep: letterToType :db
    instantiatedReturnOrDefaultT = retType replaceGenericsFromTableDeep: letterToType :db
    instantiatedReturnErrors = returnErrors map: [it replaceGenericsFromTableDeep: letterToType :db]

    newArgs = args map: [
      TypeTField name: it name
                typeT: (it typeT replaceGenericsFromTableDeep: letterToType :db)
                isMut: it isMut
    ]

    // instantiating the receiver does not change the method name:
    // the backend combines the receiver’s mangled name with the method name

    // if the method itself has generics, the method name must include concrete types
    // tGeneric -> tGeneric__String

    methodGenericArgs = this getGenericArgs
    genericsToMangle = methodGenericArgs filter: [
         dontMangle contains: it typeT name, not
    ]

    newMethodName = (mangle && genericsToMangle isNotEmpty)
      ifTrue: [
        genericMangled = genericsToMangle map: [
          // find what this generic arg resolves to
          resolvedType = letterToType at: it typeT name
          | resolvedType
          | null => [
             // if not resolved then its probably generic of the receiver, so we ignore it here
             // or its an error xddd
             ""
          ]
          |=> resolvedType toMangledName
        ]

        name + "__" + (genericMangled joinWith: "_")
      ]
      ifFalse: [name]



    ^ NivaMethod
        name: newMethodName
        receiverType: instantiatedReceiverOrDefaultT
        args: newArgs
        returnType: instantiatedReturnOrDefaultT
        returnErrors: instantiatedReturnErrors
        :forMut
        :possibleErrors
        :kind
        :decl
        :protocolName
        :pkgName
        :isInline
  ]

  on copyWithDifferentReturnType(rt): NivaType =
    NivaMethod :name :receiverType :args returnType: rt :returnErrors :forMut :possibleErrors :kind :decl :protocolName :pkgName :isInline

  on copyWithDifferentReturnErrors(errors): List::NivaType =
    NivaMethod :name :receiverType :args :returnType returnErrors: errors :forMut :possibleErrors :kind :decl :protocolName :pkgName :isInline

  on markedInline -> NivaMethod = NivaMethod
    :name :receiverType :args :returnType
    :returnErrors :forMut :possibleErrors
    :kind :decl :protocolName :pkgName isInline: true

  on toString -> String = [
    isMut = forMut ifTrue: ["mut"] ifFalse: [""]
    possibleErrorsStr = (possibleErrors joinWith: ", " transform: [it name])
    p2 = possibleErrorsStr == "" ifTrue: [""] ifFalse: [" with possible errors: (" + possibleErrorsStr + ")!"]
    argsStr = args joinWith: " " transform: [it toString]
    ^ "(NivaMethod " + isMut + " " + name + "(" + argsStr + ")" + p2 + " -> " + returnType toString + ")"
  ]

  on returnTypeInfo -> TypeInfo = [
    getterFieldMaybe = | kind
      | MessageSendKind.Getter => receiverType findField: name
      |=> null
    isMut = | getterFieldMaybe
      | null => forMut
      |=> getterFieldMaybe isMut
    TypeInfo t: returnType :isMut listOfErrors: returnErrors
  ]
]

constructor NivaMethod [

  on name::String receiverType::NivaType args::List::TypeTField returnType::NivaType forMut::Bool protocolName::String pkgName::String = NivaMethod
    :name
    :receiverType
    :args
    :returnType
    returnErrors: {}!
    :forMut
    possibleErrors: {}
    kind: MessageSendKind.Call
    decl: null
    :protocolName
    :pkgName
    isInline: false

  on defaultConstructorWithName(name): String receiverType: NivaType args: List(TypeTField) returnType: NivaType decl: MessageDecl? protocolName::String pkgName::String -> NivaMethod = NivaMethod
    :name
    :receiverType
    :args
    :returnType
    returnErrors: {}!
    forMut: false
    possibleErrors: {}
    kind: MessageSendKind.DefaultConstructor
    :decl
    :protocolName
    :pkgName
    isInline: false

]

type NivaProtocol
  name: String
  methods: mut Map(String, NivaMethod)

constructor NivaProtocol [
  on common = NivaProtocol name: "common" methods: #{}!
  on constructors = NivaProtocol name: "constructors" methods: #{}!
  on name: String = NivaProtocol :name methods: #{}!
]

extend NivaProtocol [
  on addMethod: NivaMethod = [
    methods at: addMethod name put: addMethod
  ]
]

type NivaPkg
  name: String
  types: mut Map(String, NivaType)
  constructorsProtocol: NivaProtocol
  imports: mut Set(String)
  packageImports: mut Set(String)


constructor NivaPkg name: String =
  NivaPkg :name types: #{}! constructorsProtocol: NivaProtocol constructors imports: #()! packageImports: #()!

/// create package with core imported
constructor NivaPkg withCoreImportednamed(name): String =
  NivaPkg :name types: #{}! constructorsProtocol: NivaProtocol constructors imports: #("core")! packageImports: #()!

extend NivaPkg [
  on addImport(pkgName): String = [
    pkgName != this name ifTrue: [
      imports add: pkgName
    ]
  ]

  on addPackageImport(pkgName): String = [
    packageImports add: pkgName
  ]
]


type DefaultTypesContainer
  char: CharT
  int: IntegerT
  long: IntegerT
  float: FloatT
  double: DoubleT
  str: StringT
  bool: BoolT
  bind: TypeT
  compiler: TypeT
  error: TypeT
  unit: UnitT
  // utils
  nothing: NothingT
  any: AnyT
  t: UnresolvedGenericT
  g: UnresolvedGenericT
  // create collections
  list: ListT
  list2: ListT
  map: MapT
  map2: MapT
  set: SetT
  set2: SetT
  intRange: TypeT
  charRange: TypeT

constructor DefaultTypesContainer new -> DefaultTypesContainer = [
  t = (UnresolvedGenericT name: "T")
  g = (UnresolvedGenericT name: "G")
  q = (UnresolvedGenericT name: "Q")
  w = (UnresolvedGenericT name: "W")
  char = CharT new
  int = IntegerT new
  long = IntegerT long
  float = FloatT new
  double = DoubleT new
  str = StringT new
  bool = BoolT new
  bind = TypeT noFieldsWithName: "Bind" pkgName: "core"
  compiler = TypeT noFieldsWithName: "Compiler" pkgName: "core"
  unit = UnitT new
  nothing = NothingT new
  any = AnyT new
  error = TypeT noFieldsWithName: "Error" pkgName: "core"

  list = (ListT :t)
  list2 = (ListT t: q)
  map = (MapT k: t v: g)
  map2 = (MapT k: q v: w)
  set = (SetT :t)
  set2 = (SetT t: q)

  intRangeFields = {(TypeTField name: "start" typeT: int isMut: false)
                    (TypeTField name: "endInclusive" typeT: int isMut: false)}!
  intRange = TypeT
    name: "IntRange"
    pkgName: "core"
    fields: intRangeFields
    genericArgs: {}!

  charRangeFields = {(TypeTField name: "start" typeT: char isMut: false)
                     (TypeTField name: "endInclusive" typeT: char isMut: false)}!
  charRange = TypeT
    name: "CharRange"
    pkgName: "core"
    fields: charRangeFields
    genericArgs: {}!

  dtc = DefaultTypesContainer
    :char :int :long :float :double :str :bool :bind :compiler :error :unit :nothing :any :t :g :list :list2 :map :map2 :set :set2 :intRange :charRange
  ^ dtc
]

DefaultTypesContainer collection-with-different-generic(collection): NivaType -> NivaType = [
  ^ | collection
    | ListT => list2
    | SetT => set2
    | MapT => map2
    |=> [TO DO: "Compiler bug, use one of collections(list map set) got $collection"]
]


/// create basic types like String Int List
constructor NivaPkg core -> Tuple(NivaPkg, DefaultTypesContainer) = [
  dtc = DefaultTypesContainer new
  {char, int, float, double, str, bool, bind, compiler, error, unit,
  long,
  // utils
  nothing, any,
  // T
  t,
  // collections
  list, map, set,
  intRange, charRange} = dtc

  corePkg = NivaPkg name: "core" types: #{
    "Bool" bool
    "Unit" unit
    "String" str
    "Char" char
    "Int" int
    "Long" long
    "Float" float
    "Double" double
    "Bind" bind
    "Compiler" compiler
    "Error" error
    "IntRange" intRange
    "CharRange" charRange

    "Nothing" nothing
    "Any" any

    "List" list
    "Set" set
    "Map" map
  }!

  constructorsProtocol: NivaProtocol constructors
  imports: #()!
  packageImports: #()!


  ^ Tuple x: corePkg y: dtc
]




// -----

Project protocol: "toString"

NivaType toTypeShapeString -> String = [
  nivaType = this
  ^ | nivaType
    | TypeT => [
      genericArgs = nivaType genericArgs
      genericArgsString = genericArgs isNotEmpty
        ifTrue: [" <" + (genericArgs joinWith: " " transform: [it name]) + ">"]
        ifFalse: [""]
      " Type(" + nivaType name + genericArgsString + ")"
    ]
    | ListT => " Type(" + nivaType name + " <" + (nivaType t toTypeShapeString) + ">)"
    | SetT => " Type(" + nivaType name + " <" + (nivaType t toTypeShapeString) + ">)"
    | MapT => " Type(" + nivaType name + " <key: " + (nivaType k toTypeShapeString) + " val: " + (nivaType v toTypeShapeString) + ">)"
    | NullableT => (nivaType v toTypeShapeString) + "?"
    |=> " Type(" + nivaType name + ")"
]

TypeT toString -> String = [
  strFields = fields joinWith: " " transform: [
    it name + ": " + (it typeT toTypeShapeString)
  ]
  strGenericArgs = genericArgs joinWith: " " transform: [
    it name
  ]
  strGenerics2 = genericArgs isNotEmpty ifTrue: [" <$strGenericArgs> "] ifFalse: [""]
  ^ " Type(" + name + " " + strFields  + strGenerics2 +  ")"
]

IntegerT toString -> String = " Type(" + name + ")"
StringT  toString -> String = " Type(" + name + ")"
FloatT   toString -> String = " Type(" + name + ")"
DoubleT  toString -> String = " Type(" + name + ")"
BoolT    toString -> String = " Type(" + name + ")"
UnitT    toString -> String = " Type(" + name + ")"
CharT    toString -> String = " Type(" + name + ")"
AnyT    toString -> String = " Type(" +  name + ")"
ListT    toString -> String = " Type(" + name + " <" + t toString + ">" + ")"
MapT    toString -> String = " Type(" +  name + " <" + "key: $k val: $v" +  ">" + ")"
SetT    toString -> String =  " Type(" + name + " <" + t toString + ">" + ")"
UnresolvedGenericT toString -> String = " Type(" + name + ")"
NullableT toString -> String =  v toString + "?"
