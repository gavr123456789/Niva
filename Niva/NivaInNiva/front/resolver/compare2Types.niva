NivaType needsDeepTypeCompare -> Bool = | this
  | TypeT | FuntionT | ListT | SetT | MapT | NullableT => true
  |=> false

NivaType sameSimpleTypeAs(nivaType): NivaType -> Bool = | nivaType
  | UnitT =>  | this
              | UnitT => true
              |=> false
  | IntegerT => | this
                | IntegerT => true
                |=> false
  | FloatT => | this
              | FloatT => true
              |=> false
  | DoubleT => | this
               | DoubleT => true
               |=> false
  | BoolT => | this
             | BoolT => true
             |=> false
  | CharT =>  | this
              | CharT => true
              |=> false
  | StringT =>  | this
                | StringT => true
                |=> false
  | AnyT =>  true
  | Unknown => TO DO: "Compiler bug: u cant compare Unknown"
  | NothingT => true
  | UnresolvedGenericT => | this
                          | UnresolvedGenericT => letter == nivaType letter
                          |=> false
  |=> false


NivaType sameDeclaredTypeAs(nivaType): TypeT -> Bool = | this
  | TypeT => [
    (name == nivaType name) &&
    (pkgName == nivaType pkgName) &&
    (genericArgs toString == nivaType genericArgs toString)
  ]
  |=> false


NivaType sameTypeAs(nivaType): NivaType -> Bool = [
  ^ nivaType needsDeepTypeCompare ifTrue: [
    | nivaType
    | TypeT => this sameDeclaredTypeAs: nivaType
    | FuntionT => [
      | this
      | FuntionT => [
        fields count != nivaType fields count
          ifTrue: [^ false]

        fieldsMatch <- true
        fields forEachIndexed: [i, f1 ->
          f2 = nivaType fields at: i
          f1 typeT sameTypeAs: f2 typeT, ifFalse: [
            fieldsMatch <- false
          ]
        ]
        returnTypeMatch = returnType sameTypeAs: nivaType returnType
        fieldsMatch && returnTypeMatch
      ]
      |=> false
    ]
    | ListT =>  | this
                | ListT => this t sameTypeAs: nivaType t
                |=> false

    | SetT => | this
              | SetT => this t sameTypeAs: nivaType t
              |=> false

    | MapT => | this
              | MapT => (.k sameTypeAs: nivaType k) &&
                        (.v sameTypeAs: nivaType v)
              |=> false

    | NullableT => | this
                   | NullableT => .v sameTypeAs: nivaType v
                   | NothingT => true
                   |=> false
    |=> false
  ] ifFalse: [
    .sameSimpleTypeAs: nivaType
  ]
]

/// sameTypeAs: is asymmetric, NothingT and AnyT on the right match everything,
/// so `null`(NothingT) or `Any` receivers would match a method declared for a concrete type
NivaType sameTypeStrictAs(nivaType): NivaType -> Bool =
  (.sameTypeAs: nivaType) && (nivaType sameTypeAs: this)


// typechecks for x::Int = 4
// where nivaType is `::Int` part, and 4 is `this`
NivaType isAssignableTo(nivaType): NivaType db: TyperDB -> Bool = [
  // Nothing is the bottom type (for example `throw`) is valid wherever a value is expected
  this isNothingType ifTrue: [^ true]
  ^ nivaType needsDeepTypeCompare ifTrue: [
    | nivaType
    | TypeT =>  | this
                | TypeT => [
                  | .sameDeclaredTypeAs: nivaType
                  | true => true
                  | false => (db isUnionBranch: this ofRoot: nivaType) ||
                              [
                                parent = db findUnionParent: this
                                | parent
                                | null => false
                                |=> parent isAssignableTo: nivaType :db
                              ] do

                ]
                |=> false

    | FuntionT => | this
                  | FuntionT => [
                    fields count != nivaType fields count
                      ifTrue: [^ false]

                    fieldsMatch <- true
                    fields forEachIndexed: [i, f1 ->
                      f2 = nivaType fields at: i
                      f1 typeT isAssignableTo: f2 typeT :db,
                        ifFalse: [fieldsMatch <- false]
                    ]

                    // ktlike Unit coercion: any return type is acceptable when Unit is expected
                    returnTypeMatch = | nivaType returnType
                                      | UnitT => true
                                      |=> returnType isAssignableTo: nivaType returnType :db

                    fieldsMatch && returnTypeMatch
                  ]
                  |=> false

    | ListT => | this
               | ListT => this t isAssignableTo: nivaType t :db
               |=> false

    | SetT => | this
              | SetT =>  this t isAssignableTo: nivaType t :db
              |=> false

    | MapT => | this
              | MapT => (this k isAssignableTo: nivaType k :db) &&
                        (this v isAssignableTo: nivaType v :db)
              |=> false

    | NullableT =>  | this
                    | NullableT => [
                                    // nullable with nothing inside is just `null`
                                    // x::Int? = null
                                    // null here is NullableT(NothingT)
                                    | this v isNothingType
                                    | true => true
                                    |=> this v isAssignableTo: nivaType v :db]
                    | NothingT => true
                    |=> .isAssignableTo: nivaType v :db

    |=> false
  ] ifFalse: [
    this sameSimpleTypeAs: nivaType
  ]
]
