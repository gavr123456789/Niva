NivaType needsDeepTypeCompare -> Bool = | this
  | TypeT | FuntionT | ListT | SetT | MapT | NullableT => true
  |=> false

NivaType sameSimpleTypeAs(nivaType): NivaType -> Bool = | nivaType
  | UnitT =>  | this
              | UnitT => true
              |=> false
  | IntegerT => | this
                | IntegerT => true
                |=> false
  | FloatT => | this
              | FloatT => true
              |=> false
  | DoubleT => | this
               | DoubleT => true
               |=> false
  | BoolT => | this
             | BoolT => true
             |=> false
  | CharT =>  | this
              | CharT => true
              |=> false
  | StringT =>  | this
                | StringT => true
                |=> false
  | AnyT =>  true
  | Unknown => TO DO: "Compiler bug: u cant compare Unknown"
  | NothingT => true
  | UnresolvedGenericT => | this
                          | UnresolvedGenericT => letter == nivaType letter
                          |=> false
  |=> false


NivaType sameDeclaredTypeAs(nivaType): TypeT -> Bool = | this
  | TypeT => [
    (name == nivaType name) &&
    (pkgName == nivaType pkgName) &&
    (genericArgs toString == nivaType genericArgs toString)
  ]
  |=> false

NivaType sameTypeAsSameKind(nivaType): NivaType -> Bool = [
  thisArgs = this typeArgsForComparison
  otherArgs = nivaType typeArgsForComparison
  | true
  | this name != nivaType name => false
  | thisArgs count != otherArgs count => false
  |=> [
    mut allSame = true
    thisArgs forEachIndexed: [i, thisArg ->
      otherArg = otherArgs at: i
      thisArg sameTypeAs: otherArg, ifFalse: [allSame <- false]
    ]
    allSame
  ]
]

NivaType isAssignableToSameKind(nivaType): NivaType db: TyperDB -> Bool = [
  thisArgs = this typeArgsForComparison
  expectedArgs = nivaType typeArgsForComparison
  | true
  | this name != nivaType name => false
  | thisArgs count != expectedArgs count => false
  |=> [
    mut allAssignable = true
    thisArgs forEachIndexed: [i, thisArg ->
      expectedArg = expectedArgs at: i
      thisArg isAssignableTo: expectedArg :db, ifFalse: [allAssignable <- false]
    ]
    allAssignable
  ]
]

NivaType sameTypeAs(nivaType): NivaType -> Bool = [
  ^ nivaType needsDeepTypeCompare ifTrue: [
    | nivaType
    | TypeT => this sameDeclaredTypeAs: nivaType
    | FuntionT => [
      | this
      | FuntionT => [
        | true
        | fields count != nivaType fields count => false
        |=> [
          mut fieldsMatch = true
          fields forEachIndexed: [i, f1 ->
            f2 = nivaType fields at: i
            f1 typeT sameTypeAs: f2 typeT, ifFalse: [
              fieldsMatch <- false
            ]
          ]
          returnTypeMatch = returnType sameTypeAs: nivaType returnType
          fieldsMatch && returnTypeMatch
        ]
      ]
      |=> false
    ]
    | ListT | SetT | MapT => this sameTypeAsSameKind: nivaType
    | NullableT => | this
                   | NullableT => this sameTypeAsSameKind: nivaType
                   | NothingT => true
                   |=> false
    |=> false
  ] ifFalse: [
    this sameSimpleTypeAs: nivaType
  ]
]

/// sameTypeAs: NothingT and AnyT on the right match every type
NivaType sameTypeStrictAs(nivaType): NivaType -> Bool =
  (this sameTypeAs: nivaType) && (nivaType sameTypeAs: this)


NivaType isAssignableTo(nivaType): NivaType db: TyperDB -> Bool = [
  ^ | true
    | this name == "Nothing" => true
    |=> nivaType needsDeepTypeCompare ifTrue: [
    | nivaType
    | TypeT =>  | this
                | TypeT => [
                  | this sameDeclaredTypeAs: nivaType
                  | true => true
                  | false => [
                    isUnionBranch = db isUnionBranch: this ofRoot: nivaType
                    isUnionBranch ifTrue: [true] ifFalse: [
                      parentMaybe = db findUnionParent: this
                      | parentMaybe
                      | null => false
                      |=> parentMaybe isAssignableTo: nivaType :db
                    ]
                  ]

                ]
                |=> false

    | FuntionT => | this
                  | FuntionT => [
                    | true
                    | fields count != nivaType fields count => false
                    |=> [
                      mut fieldsMatch = true
                      fields forEachIndexed: [i, f1 ->
                        f2 = nivaType fields at: i
                        f1 typeT isAssignableTo: f2 typeT :db,
                          ifFalse: [fieldsMatch <- false]
                      ]

                      // ktlike Unit coercion: any return type is acceptable when Unit is expected
                      returnTypeMatch = | nivaType returnType
                                        | UnitT => true
                                        |=> returnType isAssignableTo: nivaType returnType :db

                      fieldsMatch && returnTypeMatch
                    ]
                  ]
                  |=> false

    | ListT | SetT | MapT => this isAssignableToSameKind: nivaType :db

    | NullableT => | this
                   | NullableT => this v isAssignableTo: nivaType v :db
                   | NothingT => true
    |=> this isAssignableTo: (nivaType typeArgsForComparison first) :db

    |=> false
  ] ifFalse: [
    this sameSimpleTypeAs: nivaType
  ]
]
