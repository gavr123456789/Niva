type GoBackend

type GoSymbolTable
  typeNames: Map(String, String)
  funcNames: Map(String, String)
  packageNames: Map(String, String)
  fileNames: Map(String, String)

type GoImportPlan
  importsByFile: Map(String, List(String))

type GoFragment
  pkgId: String
  fileKey: String
  orderKey: String
  imports: List(String)
  code: String

type GoFragmentFrame
  ctx: GoContext
  sb: StringBuilder

type GoFile
  path: String
  packageName: String
  imports: List(String)
  body: String

type GoIrError
  message: String

type GoContext
  symbols: GoSymbolTable
  imports: mut List(String)
  importSet: mut Set(String)

constructor GoContext forSymbols(symbols): GoSymbolTable -> GoContext = GoContext symbols: symbols imports: {}! importSet: #()!

GoContext seedImports(imports): List(String) -> Unit = [
  imports forEach: [this addImport: it]
]

GoContext addImport(name): String -> Unit = [
  (importSet contains: name) ifFalse: [
    importSet add: name
    imports add: name
  ]
]

type GoScope
  locals: mut Set(String)
  fieldAliases: mut Map(String, IrFieldAlias)
  pointerLocals: mut Set(String)

constructor GoScope new = GoScope locals: #()! fieldAliases: #{}! pointerLocals: #()!

GoScope copy -> GoScope = [
  newLocals::mut Set(String) = #()!
  newAliases::mut Map(String, IrFieldAlias) = #{}!
  newPointers::mut Set(String) = #()!
  newLocals addAll: locals
  fieldAliases forEach: [aliasName, alias ->
    newAliases at: aliasName put: alias
  ]
  newPointers addAll: pointerLocals

  ^ GoScope locals: newLocals fieldAliases: newAliases pointerLocals: newPointers
]

GoContext emitResult: IrExpr? sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  hasErrors = retType errors isNotEmpty
  retType isGoUnitType
    ifFalse: [
      | emitResult
      | null => [TO DO: "bug: Go emitResult: missing result for non-Unit return"]
      |=> [
        exprStr = emitResult toGoExpr: this :scope
        line = hasErrors
          ifTrue:  ["return " + exprStr + ", nil"]
          ifFalse: ["return " + exprStr]
        sb appendIndent: indent line: line
      ]
    ]
    ifTrue: [
      | emitResult
      | null => []
      |=> [ sb appendIndent: indent
               line: (emitResult toGoStatement: this :scope) ]
    ]
]

static GO_KEYWORDS = #("break" "default" "func" "interface" "select"
                        "case" "defer" "go" "map" "struct"
                        "chan" "else" "goto" "package" "switch"
                        "const" "fallthrough" "if" "range" "type"
                        "continue" "for" "import" "return" "var")

//str go utils
extend String [
  on isGoKeyword -> Bool = GO_KEYWORDS contains: this
  on goNormalizeTypeId -> String = [
    hasGeneric = this contains: "__"
    result = hasGeneric
        ifTrue: [this substringBefore: "__"]
        ifFalse: [this]
    this == result ifFalse: [
      "goNormalizeTypeId: before = $this, after = $result" log
    ]
    ^ result
  ]
  // verrry badd, need iterate over symbols
  on goSanitizeIdent -> String =
        .replace: ".." with: "rangeTo"
        ,replace: "==" with: "equals"
        ,replace: "!=" with: "notEquals"
        ,replace: ">=" with: "gte"
        ,replace: "<=" with: "lte"
        ,replace: ">" with: "gt"
        ,replace: "<" with: "lt"
        ,replace: "||" with: "or"
        ,replace: "&&" with: "and"
        ,replace: "+" with: "plus"
        ,replace: "-" with: "minus"
        ,replace: "*" with: "times"
        ,replace: "/" with: "div"
        ,replace: "%" with: "rem"
        //,replace: ":" with: "__"
        ,replace: "." with: "_"
        ,replace: "/" with: "_"
        ,replace: "?" with: "_Nullable"
        ,replace: "(" with: "_"
        ,replace: ")" with: "_"
        ,replace: "," with: "_"
        ,replace: " " with: "_"
  on toSafeGoIdent -> String = [
    mut s = this goSanitizeIdent
    s count > 0 ifTrue: [
      first = s at: 0
      first isDigit ifTrue: [s <- "_" + s]
    ]
    s isGoKeyword ifTrue: [s <- s + "_"]
    areEqual = . == s
    areEqual ifTrue: [
      "toSafeGoIdent: before = $this after = $s"
    ]
    ^ s
  ]

  on uniqueName(used): mut Set(String) -> String = [
    base = this
    used contains: base, ifFalse: [
      used add: base
      ^ base
    ]
    mut i = 1
    mut candidate = base + "_" + i toString
    [used contains: candidate] whileTrue: [
      i <- i + 1
      candidate <- base + "_" + i toString
    ]
    used add: candidate
    ^ candidate
  ]

  on stripPkgPrefix(prefix): String -> String = [
    pre = prefix + "_"
    preLen = pre count
    ^ (this count >= preLen && ((this slice: 0..<preLen) == pre))
        ifTrue:  [this slice: preLen..<this count]
        ifFalse: [this]
  ]

  on hasPrefix(prefix): String -> Bool = [
    prefixLen = prefix count
    ^ (this count >= prefixLen) && ((this slice: 0..<prefixLen) == prefix)
  ]

  on addToGoImports(imports): mut List(String) seen: mut Set(String) -> Unit = [
    (seen contains: this) ifFalse: [
      seen add: this
      imports add: this
    ]
  ]

]

IrTypeRef coreFuncNameFromCall(name): String -> String = [
  baseId = typeId goNormalizeTypeId
  recvBase = baseId stripPkgPrefix: "core"
  recvBaseSafe = recvBase toSafeGoIdent
  normalized = name goSanitizeIdent

  x = recvBaseSafe + "__" + normalized

  name == x ifFalse: [
    "coreFuncNameFromCall: was: $name became $x" log
  ] ifTrue: ["coreFuncNameFromCall: no changes" log]

  ^ x

]

GoContext goTypeNameFor(typeId): String -> String = [
  baseId = typeId goNormalizeTypeId
  existing = symbols typeNames at: baseId
  ^ | existing
    | null => [TO DO: "Go typeId not registered in symbol table: " + baseId]
    |=> existing
]

IrFunction goFuncNameFromIr -> String = [
  recvId = receiverType typeId


  recvBase = pkgId != ""
              ifTrue:  [ recvId stripPkgPrefix: pkgId ]
              ifFalse: [ recvId ],
              goSanitizeIdent

  sel = name goSanitizeIdent

  full =
    pkgId != ""
      ifTrue: [ pkgId + "__" + recvBase + "__" + sel ]
      ifFalse: [ recvBase + "__" + sel ]

  ^ full toSafeGoIdent
]

extend GoContext [
  on goFuncNameForFn(fn): IrFunction -> String = [
    ^ this goFuncNameFor: fn id
  ]

  on goFuncNameFor(funcId): String -> String = [
    existing = symbols funcNames at: funcId
    ^ | existing
      | null => [TO DO: "Go funcId not registered: " + funcId]
      |=> existing
  ]

]

IrUnionDef goBranchTypeIds -> List(String) = [
  ids::mut List(String) = {}!
  branches forEach: [br ->
    br isInclude ifFalse: [
      ids add: (pkgId + "_" + br name)
    ]
  ]
  ^ ids toList
]

Int goIndent -> String = [
  sb = StringBuilder new
  mut i = 0
  [i < this] whileTrue: [
    sb append: "    "
    i <- i inc
  ]
  ^ sb toString
]

StringBuilder appendIndent(level): Int line: String -> Unit = [
  this append: (level goIndent)
  this appendLine: line
]

GoImportPlan importsForFile(fileKey): String -> List(String) = [
  imports = importsByFile at: fileKey
  ^ imports unpack: [it] or: {}
]

extend IrTypeRef [

  on isGoRefLikeType -> Bool =
    | kind
    | IrTypeRefKind.Function => true
    | IrTypeRefKind.Builtin => [
        baseId = typeId goNormalizeTypeId
        | baseId
        | "core_List" | "core_Set" | "core_Map" => true
        |=> false
      ]
    |=> false


  on isGoUnitType -> Bool =
    (kind == IrTypeRefKind.Builtin) && (typeId goNormalizeTypeId == "core_Unit")

  on hasGoErrors -> Bool = errors isNotEmpty

  on goZeroValue(ctx): GoContext -> String = [
    ^ nullable ifTrue: ["nil"] ifFalse: [
      | kind
      | IrTypeRefKind.Builtin => [
          baseId = typeId goNormalizeTypeId
          | baseId
          | "core_Int" | "core_Double" | "core_Float" | "core_Char" => "0"
          | "core_String" => "\"\""
          | "core_Bool" => "false"
          | "core_Unit" => "core.UnitInstance"
          |=> "nil"
        ]
      | IrTypeRefKind.Custom => (ctx goTypeNameFor: (typeId goNormalizeTypeId)) + "{}"
      | IrTypeRefKind.Function => "nil"
    ]
  ]

  on goReturnTypes(ctx): GoContext -> String = [
    hasErr = errors isNotEmpty
    isUnit = this isGoUnitType
    ^ hasErr
      ifTrue: [
        isUnit
          ifTrue: [" error"]
          ifFalse: [" (" + (this toGoType: ctx) + ", error)"]
      ]
      ifFalse: [
        isUnit ifTrue: [""] ifFalse: [" " + (this toGoType: ctx)]
      ]
  ]

  on goBaseType(ctx): GoContext -> String = [
    baseId = typeId goNormalizeTypeId
    ^ | kind
      | IrTypeRefKind.Function => [
          argsStr = args joinWith: ", " transform: [it toGoParamType: ctx]
          retTypeMaybe = returnType
          retStr = | retTypeMaybe
                  | null => ""
                  |=> retTypeMaybe toGoType: ctx
          retStr == "" ifTrue:  ["func(" + argsStr + ")"]
                      ifFalse: ["func(" + argsStr + ") " + retStr]
        ]
      | IrTypeRefKind.Builtin => [
          | baseId
          | "core_Int" => "int"
          | "core_Double" => "float64"
          | "core_Float" => "float32"
          | "core_String" => "string"
          | "core_Bool" => "bool"
          | "core_Char" => "rune"
          | "core_Unit" => "struct{}"
          | "core_Any" => "any"
          | "core_Nothing" => "any"
          | "core_Null" => "any"
          | "core_Error" => "error"
          | "core_List" => [
              elem = args isNotEmpty ifTrue: [args first toGoType: ctx] ifFalse: ["any"]
              "[]" + elem
            ]
          | "core_Set" => [
              elem = args isNotEmpty ifTrue: [args first toGoType: ctx] ifFalse: ["any"]
              "map[" + elem + "]struct{}"
            ]
          | "core_Map" => [
              keyType = args count > 0 ifTrue: [args at: 0, toGoType: ctx] ifFalse: ["any"]
              valType = args count > 1 ifTrue: [args at: 1, toGoType: ctx] ifFalse: ["any"]
              "map[" + keyType + "]" + valType
            ]
          |=> ctx goTypeNameFor: baseId
        ]
      | IrTypeRefKind.Custom => [
          baseId isGeneric ifTrue: [^ baseId toSafeGoIdent]
          name = ctx goTypeNameFor: baseId
          argsStr = args isNotEmpty
            ifTrue:  ["[" + (args joinWith: ", " transform: [it toGoType: ctx]) + "]"]
            ifFalse: [""]
          name + argsStr
        ]
  ]

  on toGoType(ctx): GoContext -> String = [
    base = .goBaseType: ctx
    ^ nullable
        ifTrue: [
          // already reference-like types can be nil without pointer
          isAny = base == "any"
          isIfaceStr = base == "interface{}"
          isIface = isAny || isIfaceStr

          isRefLike = (.isGoRefLikeType) || isIface
          isRefLike ifTrue: [base] ifFalse: ["*" + base]
        ]
        ifFalse: [base]
  ]

  on isGoPointerParam -> Bool =
    isMut && (kind == IrTypeRefKind.Custom) && (.isGoRefLikeType not)


  on toGoParamType(ctx): GoContext -> String =
    .isGoPointerParam,
      ifTrue: [ nullable ifTrue:  [.toGoType: ctx]
                         ifFalse: ["*" + (.goBaseType: ctx)] ]
      ifFalse: [.toGoType: ctx]

  on needsGoAddressAtCall -> Bool =
    .isGoPointerParam && (nullable not)

]

IrLiteral toGoLiteral -> String =
  | kind
  | IrLiteralKind.Null => "nil"
  | IrLiteralKind.Unit => "core.UnitInstance"
  | IrLiteralKind.Bool => lexeme
  | IrLiteralKind.Int => lexeme
  | IrLiteralKind.Double => lexeme
  | IrLiteralKind.Float => lexeme endsWith: "f",
                                  ifTrue:  [lexeme dropLast: 1]
                                  ifFalse: [lexeme]
  | IrLiteralKind.Char => lexeme
  | IrLiteralKind.String => lexeme

IrCall tryGoBindExpr(ctx): GoContext scope: GoScope -> String? = [
  r = receiverType
  | r
  | null => [^ null]
  |=> r typeId == "core_Bind"
        ifFalse: [^ null]


  msgNameLocalMaybe = msgName
  | msgNameLocalMaybe
  | null => [^ null]
  |=> [
    msgNameLocal = msgNameLocalMaybe
    ^ | msgNameLocal
    | "emit" => [
      templateExpr = args first
      templateVal = templateExpr irStringLiteralValue
      | templateVal
      | null => (templateExpr toGoExpr: ctx scope: scope)
      |=> templateVal
    ]
    | "emit__args" => [
      templateExpr = args first
      argsListExpr = args at: 1
      template = templateExpr irStringLiteralValue unpackOrPANIC
      items = argsListExpr irListLiteralItems
      argsValues = items map: [it toGoExpr: ctx scope: scope]
      template bindApply: argsValues
    ]
    | "emit__backend" => [
      templateExpr = args first
      backendExpr = args at: 1
      backendName = backendExpr irStringLiteralValue unpackOrPANIC
      backendName != "go" ifTrue: [^ ""]
      templateVal = templateExpr irStringLiteralValue
      | templateVal
      | null => (templateExpr toGoExpr: ctx scope: scope)
      |=> templateVal
    ]
    | "emit__backend__args" => [
      templateExpr = args first
      backendExpr = args at: 1
      argsListExpr = args at: 2
      backendName = backendExpr irStringLiteralValue unpackOrPANIC
      backendName != "go" ifTrue: [^ ""]
      template = templateExpr irStringLiteralValue unpackOrPANIC
      items = argsListExpr irListLiteralItems
      argsValues = items map: [it toGoExpr: ctx scope: scope]
      template bindApply: argsValues
    ]
    | "addImport" => [
      importExpr = args first
      importName = importExpr irStringLiteralValue unpackOrPANIC
      ctx addImport: importName
      ""
    ]
    | "addImport__backend" => [
      importExpr = args first
      backendExpr = args at: 1
      isGo = backendExpr irStringLiteralValue unpackOrPANIC == "go"
      isGo ifFalse: [^ ""]
      importName = importExpr irStringLiteralValue unpackOrPANIC
      ctx addImport: importName
      ""
    ]
    |=> null
  ]
]

// Collect all IrVarRef names from an IR block (for match alias usage check)
IrBlock collectIrRefNames -> mut Set(String) = [
  refs::mut Set(String) = #()!
  stmts forEach: [it collectIrStmtRefs: refs]
  result unpack: [it collectIrExprRefs: refs]
  ^ refs
]

IrStmt collectIrStmtRefs(refs): mut Set(String) -> Unit = [
  | this
  | IrLet =>      [ value unpack: [it collectIrExprRefs: refs] ]
  | IrSetLocal => [ value collectIrExprRefs: refs ]
  | IrSetField => [ receiver collectIrExprRefs: refs
                    value collectIrExprRefs: refs ]
  | IrDestructure => [ value collectIrExprRefs: refs ]
  | IrExprStmt =>    [ expr collectIrExprRefs: refs ]
  | IrReturn =>      [ expr unpack: [it collectIrExprRefs: refs] ]
  | IrWhile =>       [ cond collectIrExprRefs: refs
                       body collectIrExprRefs: refs ]
  |=> []
]

IrExpr collectIrExprRefs(refs): mut Set(String) -> Unit = [
  | this
  | IrVarRef => refs add: name
  | IrLiteralExpr => []
  | IrThisRef => []
  | IrFieldGet => receiver collectIrExprRefs: refs
  | IrCall => [
    callee unpack: [it collectIrExprRefs: refs]
    args forEach: [it collectIrExprRefs: refs]
  ]
  | IrLambda => body collectIrRefNames forEach: [refs add: it]
  | IrBlockExpr => block collectIrRefNames forEach: [refs add: it]
  | IrMatchExpr => [
    subject collectIrExprRefs: refs
    cases forEach: [c ->
      c condition collectIrExprRefs: refs
      c additionalConditions forEach: [it collectIrExprRefs: refs]
      c body collectIrRefNames forEach: [refs add: it]
    ]
    elseBranch unpack: [it collectIrRefNames forEach: [refs add: it]]
  ]
  | IrNewExpr => args forEach: [it collectIrExprRefs: refs]
  | IrCollectionLiteral => items forEach: [it collectIrExprRefs: refs]
  | IrOpBin => [
    left collectIrExprRefs: refs
    right collectIrExprRefs: refs
  ]
  | IrTypeRefExpr => []
  |=> []
]

IrTypeRef validateGoTypeRefs(knownTypeIds): Set(String) goErrors: mut List(GoIrError) -> Unit = [
  baseId = typeId goNormalizeTypeId
  shouldCheck =
    (kind == IrTypeRefKind.Custom) &&
    (baseId isGeneric not) &&
    (baseId hasPrefix: "core_", not)

  shouldCheck && (knownTypeIds contains: baseId, not) ifTrue: [
    goErrors add: (GoIrError message: ("unknown Go IR type id: " + baseId))
  ]

  args forEach: [it validateGoTypeRefs: knownTypeIds goErrors: goErrors]
  returnType unpack: [it validateGoTypeRefs: knownTypeIds goErrors: goErrors]
  errors forEach: [it validateGoTypeRefs: knownTypeIds goErrors: goErrors]
]

IrBlock validateGoIrBlock(knownFuncIds): Set(String) knownTypeIds: Set(String) goErrors: mut List(GoIrError) -> Unit = [
  resultType validateGoTypeRefs: knownTypeIds goErrors: goErrors
  stmts forEach: [it validateGoIrStmt: knownFuncIds :knownTypeIds :goErrors]
  result unpack: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
]

IrStmt validateGoIrStmt(knownFuncIds): Set(String) knownTypeIds: Set(String) goErrors: mut List(GoIrError) -> Unit = [
  | this
  | IrLet => [
      typeRef validateGoTypeRefs: knownTypeIds goErrors: goErrors
      value unpack: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
    ]
  | IrSetLocal => [value validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
  | IrSetField => [
      receiver validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      value validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrDestructure => [
      bindings forEach: [it typeRef validateGoTypeRefs: knownTypeIds goErrors: goErrors]
      value validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrExprStmt => [expr validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
  | IrReturn => [expr unpack: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]]
  | IrWhile => [
      cond validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      body validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  |=> []
]

IrExpr validateGoIrExpr(knownFuncIds): Set(String) knownTypeIds: Set(String) goErrors: mut List(GoIrError) -> Unit = [
  typeRef validateGoTypeRefs: knownTypeIds goErrors: goErrors
  | this
  | IrVarRef => []
  | IrLiteralExpr => []
  | IrThisRef => []
  | IrFieldGet => [receiver validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
  | IrCall => [
      fid = funcId
      | fid
      | null => [
          callee == null ifTrue: [
            goErrors add: (GoIrError message: "IrCall without funcId must have callee")
          ]
        ]
      |=> [
          isCore = declPkg unpack: [it == "core"] or: false
          (isCore not) && (knownFuncIds contains: fid, not) ifTrue: [
            goErrors add: (GoIrError message: ("unknown Go IR func id: " + fid))
          ]
        ]
      callee unpack: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
      args forEach: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
      paramTypes forEach: [it validateGoTypeRefs: knownTypeIds goErrors: goErrors]
      receiverType unpack: [it validateGoTypeRefs: knownTypeIds goErrors: goErrors]
    ]
  | IrLambda => [body validateGoIrBlock: knownFuncIds :knownTypeIds :goErrors]
  | IrBlockExpr => [block validateGoIrBlock: knownFuncIds :knownTypeIds :goErrors]
  | IrMatchExpr => [
      subject validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      cases forEach: [c ->
        c condition validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
        c additionalConditions forEach: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
        c body validateGoIrBlock: knownFuncIds :knownTypeIds :goErrors
      ]
      elseBranch unpack: [it validateGoIrBlock: knownFuncIds :knownTypeIds :goErrors]
    ]
  | IrNewExpr => [
      baseId = typeId goNormalizeTypeId
      (baseId isGeneric not) && ((baseId hasPrefix: "core_") not) && (knownTypeIds contains: baseId, not) ifTrue: [
        goErrors add: (GoIrError message: ("unknown Go IR constructor type id: " + baseId))
      ]
      args forEach: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
    ]
  | IrCollectionLiteral => [items forEach: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]]
  | IrOpBin => [
      left validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      right validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrTypeRefExpr => [ref validateGoTypeRefs: knownTypeIds goErrors: goErrors]
  |=> []
]

IrCall collectGoBindImports(imports): mut List(String) seen: mut Set(String) -> Unit = [
  r = receiverType
  isBind = r unpack: [it typeId == "core_Bind"] or: false
  isBind ifFalse: [^ Unit]

  msgName unpack: [msg ->
    | msg
    | "addImport" => [
        importExpr = args first
        importName = importExpr irStringLiteralValue
        importName unpack: [it addToGoImports: imports :seen]
      ]
    | "addImport__backend" => [
        importExpr = args first
        backendExpr = args at: 1
        isGo = backendExpr irStringLiteralValue unpack: [it == "go"] or: false
        isGo ifTrue: [
          importName = importExpr irStringLiteralValue
          importName unpack: [it addToGoImports: imports :seen]
        ]
      ]
    |=> []
  ]
]

IrBlock collectGoImportsInto(imports): mut List(String) seen: mut Set(String) -> Unit = [
  stmts forEach: [it collectGoImportsInto: imports :seen]
  result unpack: [it collectGoImportsInto: imports :seen]
]

IrStmt collectGoImportsInto(imports): mut List(String) seen: mut Set(String) -> Unit = [
  | this
  | IrLet => [value unpack: [it collectGoImportsInto: imports :seen]]
  | IrSetLocal => [value collectGoImportsInto: imports :seen]
  | IrSetField => [
      receiver collectGoImportsInto: imports :seen
      value collectGoImportsInto: imports :seen
    ]
  | IrDestructure => [value collectGoImportsInto: imports :seen]
  | IrExprStmt => [expr collectGoImportsInto: imports :seen]
  | IrReturn => [expr unpack: [it collectGoImportsInto: imports :seen]]
  | IrWhile => [
      cond collectGoImportsInto: imports :seen
      body collectGoImportsInto: imports :seen
    ]
  |=> []
]

IrExpr collectGoImportsInto(imports): mut List(String) seen: mut Set(String) -> Unit = [
  | this
  | IrLiteralExpr => [
      literal kind == IrLiteralKind.Unit ifTrue: [
        "niva_go/core" addToGoImports: imports :seen
      ]
    ]
  | IrVarRef => []
  | IrThisRef => []
  | IrFieldGet => [receiver collectGoImportsInto: imports :seen]
  | IrCall => [
      isCore = declPkg unpack: [it == "core"] or: false
      isCore ifTrue: ["niva_go/core" addToGoImports: imports :seen]
      isThrow = (msgName unpack: [it == "throw"] or: false) && isCore
      isThrow ifTrue: ["fmt" addToGoImports: imports :seen]
      .collectGoBindImports: imports :seen
      callee unpack: [it collectGoImportsInto: imports :seen]
      args forEach: [it collectGoImportsInto: imports :seen]
    ]
  | IrLambda => [body collectGoImportsInto: imports :seen]
  | IrBlockExpr => [block collectGoImportsInto: imports :seen]
  | IrMatchExpr => [
      subject collectGoImportsInto: imports :seen
      cases forEach: [c ->
        c condition collectGoImportsInto: imports :seen
        c additionalConditions forEach: [it collectGoImportsInto: imports :seen]
        c body collectGoImportsInto: imports :seen
      ]
      elseBranch unpack: [it collectGoImportsInto: imports :seen]
    ]
  | IrNewExpr => [args forEach: [it collectGoImportsInto: imports :seen]]
  | IrCollectionLiteral => [items forEach: [it collectGoImportsInto: imports :seen]]
  | IrOpBin => [
      left collectGoImportsInto: imports :seen
      right collectGoImportsInto: imports :seen
    ]
  | IrTypeRefExpr => []
  |=> []
]

extend IrExpr [

  on irStringLiteralValue -> String? = | this
    | IrLiteralExpr => [
        literal kind == IrLiteralKind.String
          ifTrue: [literal lexeme unquoteLiteral]
          ifFalse: [null]
      ]
    |=> null

  on irListLiteralItems -> List::IrExpr = | this
    | IrCollectionLiteral => [
        kind == IrCollectionKind.List ifTrue: [items] ifFalse: [TO DO: "Bind emit:args: expects List literal as second argument"]
    ]
    |=> [TO DO: "Bind emit:args: expects List literal as second argument"]

  on toGoArgExpr(ctx): GoContext scope: GoScope paramType: IrTypeRef -> String = [
    exprStr = this toGoExpr: ctx scope: scope
    paramType needsGoAddressAtCall ifFalse: [^ exprStr]

    alreadyPointer =
      | this
      | IrVarRef => scope pointerLocals contains: name
      | IrThisRef => scope pointerLocals contains: "this"
      |=> false

    ^ alreadyPointer ifTrue: [exprStr] ifFalse: ["&" + exprStr]
  ]

  on toGoExpr(ctx): GoContext scope: GoScope -> String =
    | this
    | IrLiteralExpr => literal toGoLiteral
    | IrVarRef => [
        // resolve field alias
        scope locals contains: name,
          ifTrue: [name toSafeGoIdent]
          ifFalse: [
            alias = scope fieldAliases at: name
            alias unpack: [
              (it receiverName toSafeGoIdent) + "." + (it fieldName toSafeGoIdent)
            ] or: (name toSafeGoIdent)
          ]
      ]
    | IrThisRef => "this"
    | IrFieldGet => [
        recv = receiver toGoExpr: ctx scope: scope
        recv + "." + (field toSafeGoIdent)
      ]
    | IrTypeRefExpr => ref toGoType: ctx
    | IrOpBin => [
        l = left toGoExpr: ctx scope: scope
        r = right toGoExpr: ctx scope: scope
        "(" + l + " " + op + " " + r + ")"
      ]
    | IrCall => [
        bindExpr = this tryGoBindExpr: ctx scope: scope
        bindExpr != null ifTrue: [^ bindExpr unpackOrPANIC]
        argsStr = args mapIndexed: [i, it ->
          paramType = paramTypes at: i
          it toGoArgExpr: ctx scope: scope paramType: paramType
        ], goCallArgs
        funcIdLocal = funcId
        | funcIdLocal
        | null => [
            calleeLocal = callee
            | calleeLocal
            | null => TO DO: "IrCall without funcId must have callee"
            |=> [
              calleeExpr = calleeLocal
              "(" + (calleeExpr toGoExpr: ctx scope: scope) + ")(" + argsStr + ")"
            ]
          ]
        |=> [
            // if its from core => generate core.Type__funcname, if not then Pkg__
            declPkgLocal = declPkg unpackOrPANIC
            declPkgLocal == "core"
              ifTrue: [
                ctx addImport: "niva_go/core"
                msgNameLocal = msgName unpackOrPANIC
                recvTypeLocal = receiverType unpackOrPANIC
                coreFn = recvTypeLocal coreFuncNameFromCall: msgNameLocal
                "core." + coreFn + "(" + argsStr + ")"
              ]
              ifFalse: [
                fn = ctx goFuncNameFor: funcIdLocal
                fn + "(" + argsStr + ")"
              ]
          ]
      ]
    | IrLambda => [
        argsStr = args joinWith: ", " transform: [a -> (a name toSafeGoIdent) + " " + (a typeRef toGoParamType: ctx)]
        retTypeMaybe = typeRef returnType
        retType = | retTypeMaybe
          | null => typeRef
          |=> retTypeMaybe
        retStr = retType isGoUnitType ifTrue: [""] ifFalse: [" " + (retType toGoType: ctx)]
        sb = StringBuilder new
        sb append: "func("
        sb append: argsStr
        sb append: ")"
        sb append: retStr
        sb appendLine: " {"

        innerScope = scope copy
        args forEach: [innerScope locals add: it name]
        body blockToGoStatements: ctx scope: innerScope sb: sb indent: 1 returnType: retType
        ctx emitResult: (body result) sb: sb indent: 1 retType: retType scope: innerScope
        sb append: "}"
        sb toString
      ]
    | IrBlockExpr => block blockToGoExpr: ctx scope: scope
    | IrMatchExpr => this matchToGoExpr: ctx scope: scope
    | IrNewExpr => [
        // adding [int] to tests_Box[int]{42}
        name = | typeRef kind
               | IrTypeRefKind.Custom => typeRef toGoType: ctx
               |=> ctx goTypeNameFor: (typeId goNormalizeTypeId)
        argsStr = args joinWith: ", " transform: [it toGoExpr: ctx scope: scope]
        argsStr == "" ifTrue: [name + "{}"] ifFalse: [name + "{" + argsStr + "}"]
      ]
    | IrCollectionLiteral => this collectionToGoExpr: ctx scope: scope

  on isGoCallLike -> Bool =
    | this
    | IrCall => true
    | IrBlockExpr => true
    | IrMatchExpr => true
    |=> false

  on isIrLambda = | this | IrLambda => true |=> false

  on isGoThrowCall -> Bool =
    | this
    | IrCall => [
        msg = msgName
        pkg = declPkg
        (msg unpack: [it == "throw"] or: false) && (pkg unpack: [it == "core"] or: false)
      ]
    |=> false

  on throwErrorExpr(ctx): GoContext scope: GoScope -> String = [
    ^ | this
    | IrCall => [
        errArg = args isNotEmpty ifTrue: [args first] ifFalse: [null]
        | errArg
          | null => [
              ctx addImport: "fmt"
              "fmt.Errorf(\"Error\")"
            ]
          | IrTypeRefExpr => [
              ctx addImport: "fmt"
              "fmt.Errorf(\"" + (errArg ref typeId goNormalizeTypeId) + "\")"
            ]
          |=> errArg toGoExpr: ctx scope: scope
      ]
    |=> [
        ctx addImport: "fmt"
        "fmt.Errorf(\"Error\")"
      ]
  ]

  on goErrorReturnLine(ctx): GoContext errExpr: String returnType: IrTypeRef -> String = [
    returnType isGoUnitType
      ifTrue: [^ "return " + errExpr]
    ^ "return " + (returnType goZeroValue: ctx) + ", " + errExpr
  ]

  on emitPropagatingCall(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef bindTo: String? -> String? = [
    this isGoThrowCall ifTrue: [
      errExpr = this throwErrorExpr: ctx scope: scope
      sb appendIndent: indent line: (this goErrorReturnLine: ctx errExpr: errExpr returnType: returnType)
      ^ null
    ]

    callStr = this toGoExpr: ctx scope: scope
    errName = "__err" uniqueName: scope locals
    retIsUnit = typeRef isGoUnitType
    boundName = bindTo

    | boundName
    | null => [
      retIsUnit
        ifTrue: [sb appendIndent: indent line: (errName + " := " + callStr)]
        ifFalse: [
          tmpName = "__callResult" uniqueName: scope locals
          sb appendIndent: indent line: (tmpName + ", " + errName + " := " + callStr)
          sb appendIndent: indent line: ("if " + errName + " != nil { " + (this goErrorReturnLine: ctx errExpr: errName returnType: returnType) + " }")
          ^ tmpName
        ]
    ]
    |=> [
      retIsUnit
        ifTrue: [
          sb appendIndent: indent line: ("var " + boundName + " " + (typeRef toGoType: ctx) + " = " + (typeRef goZeroValue: ctx))
          sb appendIndent: indent line: (errName + " := " + callStr)
        ]
        ifFalse: [sb appendIndent: indent line: (boundName + ", " + errName + " := " + callStr)]
    ]

    sb appendIndent: indent line: ("if " + errName + " != nil { " + (this goErrorReturnLine: ctx errExpr: errName returnType: returnType) + " }")
    ^ boundName
  ]

  on emitReturn(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    hasErrors = returnType errors isNotEmpty
    typeRef hasGoErrors ifTrue: [
      resultName = this emitPropagatingCall: ctx :scope :sb :indent :returnType bindTo: null
      resultName unpack: [
        line = hasErrors
          ifTrue: ["return " + it + ", nil"]
          ifFalse: ["return " + it]
        sb appendIndent: indent line: line
      ]
      ^ Unit
    ]

    exprStr = this toGoExpr: ctx scope: scope
    line =
      hasErrors
        ifTrue: [
          returnType isGoUnitType
            ifTrue: ["return nil"]
            ifFalse: ["return " + exprStr + ", nil"]
        ]
        ifFalse: ["return " + exprStr]
    sb appendIndent: indent line: line
  ]

  on emitAsStmt(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    typeRef hasGoErrors ifTrue: [
      this emitPropagatingCall: ctx scope: scope sb: sb indent: indent returnType: returnType bindTo: null
      ^ Unit
    ]
    stmtStr = this toGoStatement: ctx scope: scope
    sb appendIndent: indent line: stmtStr
  ]

  on toGoStatement(ctx): GoContext scope: GoScope -> String = [
    exprStr = this toGoExpr: ctx scope: scope
    isCallLike = this isGoCallLike
    ^ isCallLike ifTrue: [exprStr] ifFalse: ["_ = " + exprStr]
  ]
]

IrCollectionLiteral collectionToGoExpr(ctx): GoContext scope: GoScope -> String = [
  elemType = typeRef args isNotEmpty ifTrue: [(typeRef args first) toGoType: ctx] ifFalse: ["any"]
  ^ | this kind
  | IrCollectionKind.List => [
      elems = items joinWith: ", " transform: [it toGoExpr: ctx scope: scope]
      "[]" + elemType + "{" + elems + "}"
    ]
  | IrCollectionKind.Set => [
      pairs = items joinWith: ", " transform: [(it toGoExpr: ctx scope: scope) + ": struct{}{}"]
      "map[" + elemType + "]struct{}{ " + pairs + " }"
    ]
  | IrCollectionKind.Map => [
      elems = items
      elems count % 2 != 0 ifTrue: [TO DO: "Map should contain even number of elements"]
      pairs = elems asSequence
                chunked: 2, joinTransform: [
                  key = it at: 0
                  value = it at: 1
                  keyStr = key toGoExpr: ctx scope: scope
                  valueStr = value toGoExpr: ctx scope: scope
                  keyStr + ": " + valueStr
                ]
      keyType = typeRef args count > 0 ifTrue: [(typeRef args at: 0) toGoType: ctx] ifFalse: ["any"]
      valType = typeRef args count > 1 ifTrue: [(typeRef args at: 1) toGoType: ctx] ifFalse: ["any"]
      "map[" + keyType + "]" + valType + "{" + pairs + "}"
    ]
]

IrMatchExpr matchToGoExpr(ctx): GoContext scope: GoScope -> String = [
  retType = typeRef
  retErrors = typeRef errors
  retStr = retType goReturnTypes: ctx
  sb = StringBuilder new
  sb append: "func()"
  sb append: retStr
  sb appendLine: " {"

  innerScope = scope copy
  subjectName = "__matchSubject"
  subjectLocal = subject
  subjectIsThis = | subjectLocal
    | IrThisRef => true
    |=> false
  subjectVarName = | subjectLocal
    | IrVarRef => subjectLocal name
    |=> null
  subjectExpr = subjectLocal toGoExpr: ctx scope: innerScope
  kind != IrMatchKind.ByError ifTrue: [
    kind == IrMatchKind.ByType
      ifTrue: [sb appendIndent: 1 line: ("var " + subjectName + " any = " + subjectExpr)]
      ifFalse: [sb appendIndent: 1 line: ("" + subjectName + " := " + subjectExpr)]
  ]
  elseBranchLocal = elseBranch
  hasElse = | elseBranchLocal
    | null => false
    |=> true

  | kind
  | IrMatchKind.ByError => [
      valueName = "__matchValue"
      errName = "__matchErr"
      subjectCall = subjectExpr
      subjectRetIsUnit = subject typeRef isGoUnitType
      subjectRetIsUnit
        ifTrue: [
          sb appendIndent: 1 line: (errName + " := " + subjectCall)
        ]
        ifFalse: [
          sb appendIndent: 1 line: (valueName + ", " + errName + " := " + subjectCall)
        ]

      sb appendIndent: 1 line: ("if " + errName + " != nil {")
      sb appendIndent: 2 line: ("switch " + errName + ".(type) {")
      cases forEach: [c ->
        condType = c condition
        typeStr = | condType
          | IrTypeRefExpr => condType ref toGoType: ctx
          |=> (condType toGoExpr: ctx scope: innerScope)
        sb appendIndent: 2 line: ("case " + typeStr + ":")
        caseScope = innerScope copy
        caseScope locals add: "it"
        sb appendIndent: 3 line: ("it := " + errName + ".(" + typeStr + ")")
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 3 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (c body result) sb: sb indent: 3 retType: retType scope: caseScope
            retErrors isNotEmpty
              ifTrue: [sb appendIndent: 3 line: "return nil"]
              ifFalse: [sb appendIndent: 3 line: "return"]
          ]
          ifFalse: [
            ctx emitResult: (c body result) sb: sb indent: 3 retType: retType scope: caseScope
          ]
      ]
      sb appendIndent: 2 line: "default:"
      sb appendIndent: 3 line: (this goErrorReturnLine: ctx errExpr: errName returnType: retType)
      sb appendIndent: 2 line: "}"
      sb appendIndent: 1 line: "}"

      | elseBranchLocal
      | null => [
        subjectRetIsUnit
          ifTrue: [
            retType isGoUnitType
              ifTrue: [
                retErrors isNotEmpty
                  ifTrue: [sb appendIndent: 1 line: "return nil"]
                  ifFalse: [sb appendIndent: 1 line: "return"]
              ]
              ifFalse: [sb appendIndent: 1 line: ("return " + (retType goZeroValue: ctx))]
          ]
          ifFalse: [
            retType isGoUnitType
              ifTrue: [
                retErrors isNotEmpty
                  ifTrue: [sb appendIndent: 1 line: "return nil"]
                  ifFalse: [sb appendIndent: 1 line: "return"]
              ]
              ifFalse: [
                retErrors isNotEmpty
                  ifTrue: [sb appendIndent: 1 line: ("return " + valueName + ", nil")]
                  ifFalse: [sb appendIndent: 1 line: ("return " + valueName)]
              ]
          ]
      ]
      |=> [
        elseBlock = elseBranchLocal
        elseScope = innerScope copy
        elseScope locals add: "it"
        subjectRetIsUnit ifFalse: [
          sb appendIndent: 1 line: ("it := " + valueName)
        ]
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 1 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (elseBlock result) sb: sb indent: 1 retType: retType scope: elseScope
            retErrors isNotEmpty
              ifTrue: [sb appendIndent: 1 line: "return nil"]
              ifFalse: [sb appendIndent: 1 line: "return"]
          ]
          ifFalse: [
            ctx emitResult: (elseBlock result) sb: sb indent: 1 retType: retType scope: elseScope
          ]
      ]
    ]
  | IrMatchKind.ByType => [
      sb appendIndent: 1 line: ("switch " + subjectName + ".(type) {")
      cases forEach: [c ->
        condType = c condition
        typeStr = | condType
          | IrTypeRefExpr => condType ref toGoType: ctx
          |=> (condType toGoExpr: ctx scope: innerScope)
        sb appendIndent: 1 line: ("case " + typeStr + ":")
        caseScope = innerScope copy
        caseRefNames = c body collectIrRefNames
        emitAlias = [aliasName::String ->
          sb appendIndent: 2 line: (aliasName + " := " + subjectName + ".(" + typeStr + ")")
          (caseRefNames contains: aliasName) ifFalse: [
            sb appendIndent: 2 line: ("_ = " + aliasName)
          ]
          caseScope locals add: aliasName
        ]
        subjectIsThis ifTrue: [
          emitAlias do: "this"
        ] ifFalse: [
          subjectVarName unpack: [
            emitAlias do: (it toSafeGoIdent)
          ]
        ]
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 2 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (c body result) sb: sb indent: 2 retType: retType scope: caseScope
            sb appendIndent: 2 line: "return"
          ]
          ifFalse: [
            ctx emitResult: (c body result) sb: sb indent: 2 retType: retType scope: caseScope
          ]
      ]
      | elseBranchLocal
      | null => [
        sb appendIndent: 1 line: "default:"
        sb appendIndent: 2 line: "panic(\"invalid type assertion\")"
      ]
      |=> [
        elseBlock = elseBranchLocal
        sb appendIndent: 1 line: "default:"
        elseScope = innerScope copy
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 2 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (elseBlock result) sb: sb indent: 2 retType: retType scope: elseScope
            sb appendIndent: 2 line: "return"
          ]
          ifFalse: [
            ctx emitResult: (elseBlock result) sb: sb indent: 2 retType: retType scope: elseScope
          ]
      ]
      sb appendIndent: 1 line: "}"
    ]
  |=> [
      // ByValue or ByBool -> if/else chain
      casesCount = cases count
      cases forEachIndexed: [i, c ->
        isFirst = i == 0
        isLast = i == (casesCount - 1)
        cond = c condition toGoExpr: ctx scope: innerScope
        guardStr = c additionalConditions isNotEmpty
          ifTrue: [" && " + (c additionalConditions joinWith: " && " transform: [it toGoExpr: ctx scope: innerScope])]
          ifFalse: [""]
        fullCond = "(" + subjectName + " == " + cond + ")" + guardStr
        kw = isFirst ifTrue: ["if "] ifFalse: ["} else if "]
        sb appendIndent: 1 line: (kw + fullCond + " {")
        caseScope = innerScope copy
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 2 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (c body result) sb: sb indent: 2 retType: retType scope: caseScope
            sb appendIndent: 2 line: "return"
          ]
          ifFalse: [
            ctx emitResult: (c body result) sb: sb indent: 2 retType: retType scope: caseScope
          ]
        isLast && (hasElse not) ifTrue: [
          sb appendIndent: 1 line: "}"
        ]
      ]
      | elseBranchLocal
      | null => []
      |=> [
        elseBlock = elseBranchLocal
        sb appendIndent: 1 line: "} else {"
        elseScope = innerScope copy
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 2 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (elseBlock result) sb: sb indent: 2 retType: retType scope: elseScope
            sb appendIndent: 2 line: "return"
          ]
          ifFalse: [
            ctx emitResult: (elseBlock result) sb: sb indent: 2 retType: retType scope: elseScope
          ]
        sb appendIndent: 1 line: "}"
      ]
    ]

  sb appendLine: "}()"
  ^ sb toString
]

IrStmt toGoStmt(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit =
  | this
  | IrLet => [
      goName = name toSafeGoIdent
      scope locals add: name
      valueLocal = value
      typeStr = typeRef toGoType: ctx
      | valueLocal
      | null => [sb appendIndent: indent line: ("var " + goName + " " + typeStr)]
      |=> [
        valueExpr = valueLocal
        valueExpr typeRef hasGoErrors
          ifTrue: [
            valueExpr emitPropagatingCall: ctx scope: scope sb: sb indent: indent returnType: returnType bindTo: goName
            Unit
          ]
          ifFalse: [
            valueStr = valueExpr toGoExpr: ctx scope: scope
            sb appendIndent: indent line: ("var " + goName + " " + typeStr + " = " + valueStr)
          ]
      ]
      isUsed ifFalse: [
        sb appendIndent: indent line: ("_ = " + goName)
      ]
    ]
  | IrSetLocal => [
      goName = name toSafeGoIdent
      valueStr = value toGoExpr: ctx scope: scope
      sb appendIndent: indent line: (goName + " = " + valueStr)
  ]
  | IrSetField => [
      recvStr = receiver toGoExpr: ctx scope: scope
      valueStr = value toGoExpr: ctx scope: scope
      sb appendIndent: indent line: ("(" + recvStr + ")." + (field toSafeGoIdent) + " = " + valueStr)
  ]
  | IrDestructure => [
      tmpName = "__destructTmp" uniqueName: scope locals
      valueStr = value toGoExpr: ctx :scope
      sb appendIndent: indent line: (tmpName + " := " + valueStr)
      bindings forEach: [b ->
        goName = b name toSafeGoIdent
        scope locals add: b name
        sb appendIndent: indent line: ("var " + goName + " " + (b typeRef toGoType: ctx) + " = " + tmpName + "." + (b fieldName toSafeGoIdent))
        b isUsed ifFalse: [
          sb appendIndent: indent line: ("_ = " + goName)
        ]
      ]
  ]
  | IrExprStmt => [
      expr emitAsStmt: ctx scope: scope sb: sb indent: indent returnType: returnType
  ]
  | IrReturn => [
      exprLocal = expr
      hasErrors = returnType errors isNotEmpty
      | exprLocal
      | null => [
        hasErrors
          ifTrue: [sb appendIndent: indent line: "return nil"]
          ifFalse: [sb appendIndent: indent line: "return"]
      ]
      |=> [
        exprVal = exprLocal
        exprVal emitReturn: ctx scope: scope sb: sb indent: indent returnType: returnType
      ]
  ]
  | IrWhile => [
      condExpr = cond toGoExpr: ctx scope: scope
      bodyExpr = body toGoExpr: ctx scope: scope

      // whileTrue: is typically used as `[cond] whileTrue: [body]`, which arrives as IrLambda
      // for both parts, so we must invoke lambdas to preserve semantics.
      condStr = cond isIrLambda ifTrue: ["(" + condExpr + ")()"] ifFalse: [condExpr]
      bodyStr = body isIrLambda ifTrue: ["(" + bodyExpr + ")()"] ifFalse: [bodyExpr]
      sb appendIndent: indent line: "for {"
      sb appendIndent: (indent + 1) line: ("if !(" + condStr + ") { break }")
      sb appendIndent: (indent + 1) line: bodyStr
      sb appendIndent: indent line: "}"
  ]

extend IrBlock [
  on blockToGoExpr(ctx): GoContext scope: GoScope -> String = [
    retType = resultType
    retStr = retType isGoUnitType ifTrue: [""] ifFalse: [" " + (retType toGoType: ctx)]
    sb = StringBuilder new
    sb append: "func()"
    sb append: retStr
    sb appendLine: " {"

    innerScope = scope copy
    this blockToGoStatements: ctx scope: innerScope sb: sb indent: 1 returnType: retType
    ctx emitResult: result sb: sb indent: 1 retType: retType scope: innerScope

    sb appendLine: "}()"
    ^ sb toString
  ]

  on blockToGoStatements(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    stmts forEach: [st -> st toGoStmt: ctx scope: scope sb: sb indent: indent returnType: returnType]
    // return handling is done by caller
  ]

  on hasTrailingReturn -> Bool = [
    stmts isEmpty ifTrue: [^ false]
    lastStmt = stmts last
    ^ | lastStmt
      | IrReturn => true
      |=> false
  ]
]

List(String) goTypeParams -> String = [
  this isEmpty ifTrue: [^ ""]
  joined = this joinWith: ", " transform: [it toSafeGoIdent + " any"]
  ^ "[" + joined + "]"
]

List(String) goTypeArgs -> String = [
  this isEmpty ifTrue: [^ ""]
  joined = this joinWith: ", " transform: [it toSafeGoIdent]
  ^ "[" + joined + "]"
]

IrTypeRef collectGoTypeParamsInto(names): mut List(String) seen: mut Set(String) -> Unit = [
  baseId = typeId goNormalizeTypeId
  ((kind == IrTypeRefKind.Custom) && (baseId isGeneric)) ifTrue: [
    seen contains: baseId, ifFalse: [
      seen add: baseId
      names add: baseId
    ]
  ]
  args forEach: [it collectGoTypeParamsInto: names :seen]
  returnType unpack: [it collectGoTypeParamsInto: names :seen]
  errors forEach: [it collectGoTypeParamsInto: names :seen]
]

List(IrField) goTypeParamsFromFields -> List(String) = [
  names::mut List(String) = {}!
  seen::mut Set(String) = #()!
  this forEach: [field -> field typeRef collectGoTypeParamsInto: names :seen]
  ^ names toList
]

List(String) goCallArgs -> String = [
  this isEmpty ifTrue: [^ ""]
  joined = this joinWith: ", "
  hasMultilineArg = this any: [it contains: "\n"]
  ^ hasMultilineArg ifTrue: [joined + ",\n"] ifFalse: [joined]
]

constructor GoBackend [
  on emitTypeDef(def): IrTypeDef ctx: GoContext sb: StringBuilder -> Unit = [
    name = ctx goTypeNameFor: def id
    typeParams = def typeParams goTypeParams
    sb appendLine: ("type " + name + typeParams + " struct {")
    def fields forEach: [f ->
      sb appendIndent: 1 line: ((f name toSafeGoIdent) + " " + (f typeRef toGoType: ctx))
    ]
    sb appendLine: "}"
    sb appendLine: ""
  ]

  on emitUnionDef(def): IrUnionDef ctx: GoContext sb: StringBuilder -> Unit = [
    name = ctx goTypeNameFor: def id
    typeParams = def typeParams goTypeParams
    def isErrorDomain
      ifTrue:  [sb appendLine: ("type " + name + typeParams + " interface { error; is" + name + "() }")]
      ifFalse: [sb appendLine: ("type " + name + typeParams + " interface { is" + name + "() }")]

    def branches forEach: [br ->
      br isInclude ifFalse: [
        // compute branch typeId using union pkg prefix
        prefix = def pkgId
        branchTypeId = prefix + "_" + br name
        branchName = ctx goTypeNameFor: branchTypeId
        branchTypeParams = (def commonFields + br fields) goTypeParamsFromFields
        branchTypeParamDecl = branchTypeParams goTypeParams
        branchTypeArgs = branchTypeParams goTypeArgs

        sb appendLine: ("type " + branchName + branchTypeParamDecl + " struct {")
        def commonFields forEach: [f ->
          sb appendIndent: 1
             line: ((f name toSafeGoIdent) + " " + (f typeRef toGoType: ctx))
        ]
        br fields forEach: [f ->
          sb appendIndent: 1
             line: ((f name toSafeGoIdent) + " " + (f typeRef toGoType: ctx))
        ]
        sb appendLine: "}"
        receiverType = branchName + (branchTypeArgs == "" ifTrue: [""]
                                                          ifFalse: [branchTypeArgs])
        sb appendLine: ("func (" + receiverType + ") is" + name + "() {}")
        def isErrorDomain
            ifTrue: [ sb appendLine: ("func (" + receiverType + ") Error() string { return \"" + br name + "\" }") ]
        sb appendLine: ""
        ()
      ]
    ]
  ]

  on emitEnumDef(def): IrEnumDef ctx: GoContext sb: StringBuilder -> Unit = [
    name = ctx goTypeNameFor: def id
    sb appendLine: ("type " + name + " int")
    sb appendLine: "const ("
    def values forEachIndexed: [i, v ->
      valName = (name + "_" + (v toSafeGoIdent))
      line = i == 0
        ifTrue: [valName + " " + name + " = iota"]
        ifFalse: [valName]
      sb appendIndent: 1 line: line
    ]
    sb appendLine: ")"
    sb appendLine: ""
  ]

  on emitFunction(fn): IrFunction ctx: GoContext sb: StringBuilder -> Unit = [
    name = ctx goFuncNameForFn: fn
    typeParams = fn generics goTypeParams
    argsStr = fn args joinWith: ", " transform: [a ->
      (a name toSafeGoIdent) + " " + (a typeRef toGoParamType: ctx)
    ]
    retStr = fn returnType goReturnTypes: ctx

    sb appendLine: ("// funcId: " + fn id + " goName: " + name)
    sb appendLine: ("func " + name + typeParams + "(" + argsStr + ")" + retStr + " {")

    scope = GoScope new
    fn args forEach: [
      scope locals add: it name
      (it typeRef isGoPointerParam) ifTrue: [
        scope pointerLocals add: it name
      ]
    ]
    fn receiverFieldAliases forEach: [
      scope fieldAliases at: it localName put: it
    ]
    fn body blockToGoStatements: ctx scope: scope sb: sb indent: 1 returnType: fn returnType

    fn returnType isGoUnitType
      ifTrue: [
        ctx emitResult: (fn body result) sb: sb indent: 1 retType: fn returnType scope: scope
        fn returnType errors isNotEmpty ifTrue: [
          (fn body hasTrailingReturn) ifFalse: [
            sb appendIndent: 1 line: "return nil"
          ]
        ]
      ]
      ifFalse: [
        fnBodyResult = fn body result
        hasTrailingReturn = fn body hasTrailingReturn
        fnBodyResult == null
          ifTrue: [
            hasTrailingReturn ifFalse: [
              ctx emitResult: null sb: sb indent: 1 retType: fn returnType scope: scope
            ]
          ]
          ifFalse: [
            ctx emitResult: fnBodyResult sb: sb indent: 1 retType: fn returnType scope: scope
          ]
      ]

    sb appendLine: "}"
    sb appendLine: ""
  ]

  on emitEntry(entry): IrBlock ctx: GoContext sb: StringBuilder -> Unit = [
    sb appendLine: "func main() {"
    scope = GoScope new
    entry blockToGoStatements: ctx scope: scope sb: sb indent: 1 returnType: entry resultType
    entryResult = entry result
    | entryResult
    | null => []
    |=> [
      sb appendIndent: 1 line: (entryResult toGoStatement: ctx scope: scope)
    ]
    sb appendLine: "}"
    sb appendLine: ""
  ]

  // Phase 2: build the deterministic symbol table before any code is printed.
  on planGoSymbols(ir): IrModule -> GoSymbolTable = [
    typeNames::mut Map(String, String) = #{}!
    funcNames::mut Map(String, String) = #{}!
    packageNames::mut Map(String, String) = #{}!
    fileNames::mut Map(String, String) = #{}!
    usedTypeNames::mut Set(String) = #()!
    usedFuncNames::mut Set(String) = #()!

    registerTypeName = [typeId::String ->
      baseId = typeId goNormalizeTypeId
      existing = typeNames at: baseId
      | existing
      | null => [
          raw = baseId toSafeGoIdent
          name = raw uniqueName: usedTypeNames
          typeNames at: baseId put: name
        ]
      |=> []
    ]

    registerFuncName = [fn::IrFunction ->
      existing = funcNames at: fn id
      | existing
      | null => [
          raw = fn goFuncNameFromIr
          name = raw uniqueName: usedFuncNames
          funcNames at: fn id put: name
        ]
      |=> []
    ]

    collectedTypeIds::mut List(String) = {}!
    ir types forEach: [collectedTypeIds add: it id]
    ir unions forEach: [
      collectedTypeIds add: it id
      it goBranchTypeIds forEach: [collectedTypeIds add: it]
    ]
    ir enums forEach: [collectedTypeIds add: it id]

    typeIds = (collectedTypeIds toList) sortedBy: [it]
    typeIds forEach: [registerTypeName do: it]

    functions = ir functions sortedBy: [it id]
    functions forEach: [registerFuncName do: it]

    ir packages forEach: [
      packageNames at: it name put: (it name toSafeGoIdent)
      fileNames at: it name put: "main.go"
    ]

    ^ GoSymbolTable
      typeNames: typeNames
      funcNames: funcNames
      packageNames: packageNames
      fileNames: fileNames
  ]

  // Phase 1: reject IR shapes that the Go backend cannot emit safely.
  on validateIr(ir): IrModule -> List(GoIrError) = [
    errors::mut List(GoIrError) = {}!
    knownTypeIds::mut Set(String) = #()!
    knownFuncIds::mut Set(String) = #()!

    ir types forEach: [knownTypeIds add: (it id goNormalizeTypeId)]
    ir unions forEach: [
      knownTypeIds add: (it id goNormalizeTypeId)
      it goBranchTypeIds forEach: [branchTypeId ->
        branchTypeId hasPrefix: (it pkgId + "_"), ifFalse: [
          errors add: (GoIrError message: ("union branch id is outside package: " + branchTypeId))
        ]
        knownTypeIds add: (branchTypeId goNormalizeTypeId)
      ]
    ]
    ir enums forEach: [knownTypeIds add: (it id goNormalizeTypeId)]
    ir functions forEach: [knownFuncIds add: it id]

    ir types forEach: [
      it fields forEach: [field -> field typeRef validateGoTypeRefs: knownTypeIds goErrors: errors]
    ]
    ir unions forEach: [
      it commonFields forEach: [field -> field typeRef validateGoTypeRefs: knownTypeIds goErrors: errors]
      it branches forEach: [br -> br fields forEach: [field -> field typeRef validateGoTypeRefs: knownTypeIds goErrors: errors]]
    ]
    ir functions forEach: [fn ->
      fn receiverType validateGoTypeRefs: knownTypeIds goErrors: errors
      fn args forEach: [it typeRef validateGoTypeRefs: knownTypeIds goErrors: errors]
      fn returnType validateGoTypeRefs: knownTypeIds goErrors: errors
      fn receiverFieldAliases forEach: [it typeRef validateGoTypeRefs: knownTypeIds goErrors: errors]
      fn body validateGoIrBlock: knownFuncIds knownTypeIds: knownTypeIds goErrors: errors
    ]
    ir entry unpack: [it validateGoIrBlock: knownFuncIds knownTypeIds: knownTypeIds goErrors: errors]

    ^ errors toList
  ]

  // Phase 3: collect file imports from IR facts before fragment emission.
  on planGoImports(ir): IrModule symbols: GoSymbolTable -> GoImportPlan = [
    imports::mut List(String) = {}!
    seen::mut Set(String) = #()!

    ir functions forEach: [it body collectGoImportsInto: imports :seen]
    ir entry unpack: [it collectGoImportsInto: imports :seen]

    importsByFile::mut Map(String, List(String)) = #{}!
    importsByFile at: "main.go" put: (imports toList)

    ^ GoImportPlan importsByFile: importsByFile
  ]

  // Fragment helper: creates the local emission state shared by every independently emitted fragment.
  on newFragmentFrame(symbols): GoSymbolTable imports: GoImportPlan fileKey: String -> GoFragmentFrame = [
    ctx = GoContext forSymbols: symbols
    ctx seedImports: (imports importsForFile: fileKey)
    sb = StringBuilder new
    ^ GoFragmentFrame ctx: ctx sb: sb
  ]

  // Fragment helper: converts a filled fragment frame into stable merge metadata and generated code.
  on finishFragment(frame): GoFragmentFrame pkgId: String fileKey: String orderKey: String -> GoFragment = [
    ^ GoFragment
      pkgId: pkgId
      fileKey: fileKey
      orderKey: orderKey
      imports: (frame ctx imports toList)
      code: (frame sb toString)
  ]

  // Fragment builder: turns one type definition into an independently mergeable Go fragment.
  on typeFragment(def): IrTypeDef symbols: GoSymbolTable imports: GoImportPlan -> GoFragment = [
    frame = GoBackend newFragmentFrame: symbols imports: imports fileKey: "main.go"
    GoBackend emitTypeDef: def ctx: frame ctx sb: frame sb
    ^ GoBackend finishFragment: frame pkgId: def pkgId fileKey: "main.go" orderKey: ("10_type_" + def id)
  ]

  // Fragment builder: turns one union definition and its branch declarations into a Go fragment.
  on unionFragment(def): IrUnionDef symbols: GoSymbolTable imports: GoImportPlan -> GoFragment = [
    frame = GoBackend newFragmentFrame: symbols imports: imports fileKey: "main.go"
    GoBackend emitUnionDef: def ctx: frame ctx sb: frame sb
    ^ GoBackend finishFragment: frame pkgId: def pkgId fileKey: "main.go" orderKey: ("20_union_" + def id)
  ]

  // Fragment builder: turns one enum definition into an independently mergeable Go fragment.
  on enumFragment(def): IrEnumDef symbols: GoSymbolTable imports: GoImportPlan -> GoFragment = [
    frame = GoBackend newFragmentFrame: symbols imports: imports fileKey: "main.go"
    GoBackend emitEnumDef: def ctx: frame ctx sb: frame sb
    ^ GoBackend finishFragment: frame pkgId: def pkgId fileKey: "main.go" orderKey: ("30_enum_" + def id)
  ]

  // Fragment builder: emits one function with planned names/imports so it can later run in parallel.
  on functionFragment(fn): IrFunction symbols: GoSymbolTable imports: GoImportPlan -> GoFragment = [
    frame = GoBackend newFragmentFrame: symbols imports: imports fileKey: "main.go"
    GoBackend emitFunction: fn ctx: frame ctx sb: frame sb
    ^ GoBackend finishFragment: frame pkgId: fn pkgId fileKey: "main.go" orderKey: ("40_function_" + fn id)
  ]

  // Fragment builder: wraps the IR entry block as the deterministic main function fragment.
  on entryFragment(entry): IrBlock symbols: GoSymbolTable imports: GoImportPlan -> GoFragment = [
    frame = GoBackend newFragmentFrame: symbols imports: imports fileKey: "main.go"
    GoBackend emitEntry: entry ctx: frame ctx sb: frame sb
    ^ GoBackend finishFragment: frame pkgId: "main" fileKey: "main.go" orderKey: "90_entry_main"
  ]

  // Phase 4: emit top-level declarations as fragments instead of one shared mutable output stream.
  on emitGoFragments(ir): IrModule symbols: GoSymbolTable imports: GoImportPlan -> List(GoFragment) = [
    fragments::mut List(GoFragment) = {}!

    // todo parallel
    ir types forEach: [fragments add: (GoBackend typeFragment: it :symbols :imports)]
    // todo parallel
    ir unions forEach: [fragments add: (GoBackend unionFragment: it :symbols :imports)]
    // todo parallel
    ir enums forEach: [fragments add: (GoBackend enumFragment: it :symbols :imports)]
    // todo parallel
    ir functions forEach: [fragments add: (GoBackend functionFragment: it :symbols :imports)]

    ir entry unpack: [
      fragments add: (GoBackend entryFragment: it :symbols :imports)
    ]

    ^ fragments toList
  ]

  // Phase 5: sort fragments, combine imports, and assemble stable Go file bodies.
  on mergeGoFragments(fragments): List(GoFragment) -> List(GoFile) = [
    sorted = fragments sortedBy: [it orderKey]
    imports::mut List(String) = {}!
    seenImports::mut Set(String) = #()!
    bodySb = StringBuilder new

    // todo parallel
    sorted forEach: [fragment ->
      fragment imports forEach: [it addToGoImports: imports seen: seenImports]
      bodySb append: fragment code
    ]

    goFile = GoFile
              path: "main.go"
              packageName: "main"
              imports: (imports toList)
              body: (bodySb toString)

    ^ {goFile}
  ]

  // Final rendering step: print the package header, import block, and merged file body.
  on renderGoFile(file): GoFile -> String = [
    sb = StringBuilder new
    sb appendLine: "// Code generated by Niva. DO NOT EDIT."
    sb appendLine: ("package " + file packageName)
    sb appendLine: ""

    imports = file imports
    imports isEmpty ifFalse: [
      imports count == 1 ifTrue: [
        imp = imports first
        sb appendLine: ("import \"" + imp + "\"")
      ] ifFalse: [
        sb appendLine: "import ("
        imports forEach: [imp -> sb appendIndent: 1 line: ("\"" + imp + "\"")]
        sb appendLine: ")"
      ]
      sb appendLine: ""
    ]

    sb append: file body
    ^ sb toString
  ]

  // Public backend entry point: runs the phased pipeline and returns the current single-file output.
  on fullFromIrModule(ir): IrModule -> String = [
    errors = GoBackend validateIr: ir
    errors isEmpty ifFalse: [
      message = errors joinWith: "\n" transform: [it message]
      TO DO: "invalid Go IR:\n" + message
    ]

    symbols = GoBackend planGoSymbols: ir
    imports = GoBackend planGoImports: ir symbols: symbols
    fragments = GoBackend emitGoFragments: ir :symbols :imports
    files = GoBackend mergeGoFragments: fragments

    ^ GoBackend renderGoFile: (files first)
  ]
]
