Test goMatchVariableSubjectNarrowsAlias = [
  fileMain = """
    union Shape =
    | Rectangle width: Int height: Int
    | Circle radius: Int

    shape::Shape = Rectangle width: 1 height: 2

    area = | shape
    | Rectangle => shape width * shape height
    | Circle => shape radius
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "case main_Rectangle:", assertTrue
  go contains: "shape := __matchSubject.(main_Rectangle)", assertTrue
  go contains: "return (shape.width * shape.height)", assertTrue
  go contains: "case main_Circle:", assertTrue
  go contains: "shape := __matchSubject.(main_Circle)", assertTrue
  go contains: "return shape.radius", assertTrue
]

