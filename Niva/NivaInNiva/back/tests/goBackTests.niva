Test goTaggedUnionShapes = [
  fileMain = """
    type Point
      x: Int
      y: Int

    union Shape =
    | Rectangle width: Int height: Int
    | Circle radius: Int

    Shape area -> Int =
    | this
    | Rectangle => width * height
    | Circle => radius * radius * 3

    Unit area: Shape -> Int =
    | area
    | Rectangle => area width * area height
    | Circle => area radius * area radius * 3

  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "type main_Point struct {", assertTrue
  go contains: "type main_Shape interface { ismain_Shape() }", assertTrue
  go contains: "type main_Rectangle struct {", assertTrue
  go contains: "type main_Circle struct {", assertTrue
  go contains: "func (main_Rectangle) ismain_Shape() {}", assertTrue
  go contains: "func (main_Circle) ismain_Shape() {}", assertTrue
  go contains: "func main__Shape__area", assertTrue
  go contains: "switch __matchSubject.(type) {", assertTrue
  go contains: "case main_Rectangle:", assertTrue
  go contains: "this := __matchSubject.(main_Rectangle)", assertTrue
  go contains: "return (this.width * this.height)", assertTrue
  go contains: "case main_Circle:", assertTrue
  go contains: "this := __matchSubject.(main_Circle)", assertTrue
  go contains: "return ((this.radius * this.radius) * 3)", assertTrue
  go contains: "default:", assertTrue
  go contains: "panic(\"invalid type assertion\")", assertTrue
]

Test goShadowCopyCodegen = [
  fileMain = """
    type Person
      name: String
      age: Int

    p = Person name: "Alice" age: 24
    p2 = p age: 25
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "main_Person{p.name, 25}", assertTrue
]

Test goMutReceiverUsesPointer = [
  fileMain = """
    type Person
      name: String

    mut Person changeName: String = [
      name <- changeName
    ]

    Int person: mut Person = [
      person changeName: "Aboba2"
    ]

    p::mut Person = Person name: "qwf"
    p changeName: "Aboba"
    1 person: p
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "func main__Person__changeName(this *main_Person, changeName string)", assertTrue
  go contains: "func main__core_Int__person(this int, person *main_Person)", assertTrue
  go contains: "var p main_Person = main_Person{\"qwf\"}", assertTrue
  go contains: "main__Person__changeName(&p, \"Aboba\")", assertTrue
  go contains: "main__core_Int__person(1, &p)", assertTrue
]

Test goBindingsReadFile = [
  fileMain = """
    Int read: String -> String = [
      Bind addImport: "os" backend: "go"
      ^ Bind emit: "os.ReadFile($1)" backend: "go" args: {read}
    ]
    x = 1 read: "file.txt"
    x echo
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result
  go contains: "import (", assertTrue
  go contains: "\"niva_go/core\"", assertTrue
  go contains: "\"os\"", assertTrue
  go contains: "func main__core_Int__read", assertTrue
  go contains: "os.ReadFile(read)", assertTrue
  go contains: "main__core_Int__read(1, \"file.txt\")", assertTrue
]

Test goCoreAnyMethodOwnerCodegen = [
  fileMain = """
    1 echo
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "core.Any__echo(1)", assertTrue
  Assert that: (go contains: "core.Int__echo(1)") equals: false
]

Test goEntryLastExprDoesNotReturn = [
  fileMain = """
    1 + 2
    3 + 4
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "_ = (1 + 2)", assertTrue
  go contains: "_ = (3 + 4)", assertTrue
  Assert that: (go contains: "return (3 + 4)") equals: false
  Assert that: (go contains: "\"niva_go/core\"") equals: false
]

