  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "type main_Result[T any] interface { ismain_Result() }", assertTrue
  go contains: "type main_Ok[T any] struct {", assertTrue
  go contains: "func (main_Ok[T]) ismain_Result() {}", assertTrue
  go contains: "var x main_Ok[int] = main_Ok[int]{42}", assertTrue
]

Test goTypeMatchConcreteSubjectUsesInterfaceTmp = [
  fileMain = """
    union Result(T) =
    | Ok t: T
    | Baad x: T

    x = Ok t: 42

    | x
    | Ok => [x t echo]
    | Baad => [x x echo]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "var __matchSubject any = x", assertTrue
  go contains: "case main_Ok[int]:", assertTrue
  go contains: "x := __matchSubject.(main_Ok[int])", assertTrue
  go contains: "case main_Baad[int]:", assertTrue
  go contains: "x := __matchSubject.(main_Baad[int])", assertTrue
]

Test goUnitMatchBranchResultIsEmitted = [
  fileMain = """
    union Result(T) =
    | Ok t: T
    | Baad x: T

    x = Ok t: 42

    | x
    | Ok => [1 echo]
    | Baad => [2 echo]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "case main_Ok[int]:", assertTrue
  go contains: "core.Any__echo(1)", assertTrue
  go contains: "case main_Baad[int]:", assertTrue
  go contains: "core.Any__echo(2)", assertTrue
]

