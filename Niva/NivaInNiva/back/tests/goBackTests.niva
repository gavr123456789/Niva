]

Test goMutReceiverUsesPointer = [
  Assert nivaToGo: """
    type Person
      name: String

    mut Person changeName: String = [
      name <- changeName
    ]

    Int person: mut Person = [
      person changeName: "Aboba2"
    ]

    p::mut Person = Person name: "qwf"
    p changeName: "Aboba"
    1 person: p
  """ containsAll: {
    "func main__Person__changeName(this *main_Person, changeName string)" "func main__core_Int__person(this int, person *main_Person)"
    "var p *main_Person = &main_Person{\"qwf\"}" "main__Person__changeName(p, \"Aboba\")" "main__core_Int__person(1, p)"
  }
]

