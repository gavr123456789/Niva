Test goErrorDomainHandledMatchCodegen = [
  Assert nivaToGo: """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error1 => [0]
                | Error2 => [1]
                |=> [it]
      ^ default
    ]
  """ containsAll: {
    "func main__core_Unit__bar(this struct{}) int {" "__matchValue, __matchErr := main__core_Unit__foo(core.UnitInstance)"
    "switch __matchErr.(type) {" "case main_Error1:" "it := __matchErr.(main_Error1)" "it := __matchValue"
  } containsNone: {"func main__core_Unit__bar(this struct{}) (int, error)"}
]

