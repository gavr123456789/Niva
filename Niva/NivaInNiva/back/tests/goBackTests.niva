    | Error1 text: String

    Unit foo -> Int!{Error1} = [
      (Error1 text: "bad") throw
      ^ 42
    ]

    errorValue = () foo orPANIC
    maybe::Int? = 42
    nullableValue = maybe orPANIC
  """ containsAll: {
    "if __tryErr != nil { panic(__tryErr) }" "if __tryValue == nil { panic(\"try on null\") }" "return __tryValue" "return *__tryValue"
  } containsNone: {"func() (int, error) {"}
]

