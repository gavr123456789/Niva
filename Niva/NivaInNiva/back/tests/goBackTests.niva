      mut s = ""
      s <- | this
           | 0 => ^ "zero"
           |=> "other"
      s + "!"
    ]
  """ containsAll: {"var s string\n" "return \"returned\"" "s = \"kept\"" "return \"zero\"" "s = \"other\""} containsNone: {"func() string {"}
]

Test goValueMatchReturnOnErrorCodegen = [
  Assert nivaToGo: """
    errordomain E =
    | Bad text: String

    Int parse -> Int!{Bad} = [
      this >= 0 ifTrue: [^ this * 10]
      (Bad text: "negative") throw
      ^ 0
    ]

    Int describe -> String = [
      v = | this parse
          | Bad => ^ "bad input"
          |=> it
      "value " + v toString
    ]

    Int noElse -> String = [
      v = | this parse
          | Bad => ^ "bad input"
      "value " + v toString
    ]
  """ containsAll: {"var v int\n" "return \"bad input\"" "v = it"} containsNone: {"func() int {"}
]

