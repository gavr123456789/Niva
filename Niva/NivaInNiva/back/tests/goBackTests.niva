String assertGoContents(expected): List(String) excludes(excluded): List(String) -> Unit = [
  expected forEach: [snippet -> Assert that: (this contains: snippet) equals: true]
  excluded forEach: [snippet -> Assert that: (this contains: snippet) equals: false]
]

constructor Assert nivaToGo: String containsAll: List(String) -> Unit = [
  Assert nivaToGo: nivaToGo containsAll: containsAll containsNone: {}
]

constructor Assert nivaToGo: String containsAll: List(String) containsNone: List(String) -> Unit = [
  result = ResolverHelper resolve: #{"main" nivaToGo} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  go = GoBackend fullFromIrModule: (result toIrModule)
  go assertGoContents: containsAll excludes: containsNone
]

constructor Assert nivaFiles: Map(String, String) containsAll: List(String) -> Unit = [
  Assert nivaFiles: nivaFiles containsAll: containsAll containsNone: {}
]

constructor Assert nivaFiles: Map(String, String) containsAll: List(String) containsNone: List(String) -> Unit = [
  result = ResolverHelper resolve: nivaFiles entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  go = GoBackend fullFromIrModule: (result toIrModule)
  go assertGoContents: containsAll excludes: containsNone
]

Test goTaggedUnionShapes = [
  Assert nivaToGo: """
    type Point
      x: Int
      y: Int

    union Shape =
    | Rectangle width: Int height: Int
    | Circle radius: Int

    Shape area -> Int =
    | this
    | Rectangle => width * height
    | Circle => radius * radius * 3

    Unit area: Shape -> Int =
    | area
    | Rectangle => area width * area height
    | Circle => area radius * area radius * 3

  """ containsAll: {
    "type main_Point struct {" "type main_Shape interface {\n    ismain_Shape()\n}" "type main_Rectangle struct {" "type main_Circle struct {"
    "func (main_Rectangle) ismain_Shape() {}" "func (main_Circle) ismain_Shape() {}"
    "func (this main_Rectangle) nivaField__width() int { return this.width }"
    "func (this main_Rectangle) nivaField__height() int { return this.height }" "func main__Shape__area" "switch __matchSubject.(type) {"
    "case main_Rectangle:" "this := __matchSubject.(main_Rectangle)" "return ((this).nivaField__width() * (this).nivaField__height())"
    "case main_Circle:" "this := __matchSubject.(main_Circle)" "return (((this).nivaField__radius() * (this).nivaField__radius()) * 3)"
    "default:" "panic(\"invalid type assertion\")"
  }
]

