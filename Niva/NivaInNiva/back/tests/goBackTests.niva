Test goTaggedUnionShapes = [
  fileMain = """
    type Point
      x: Int
      y: Int

    union Shape =
    | Rectangle width: Int height: Int
    | Circle radius: Int

    Shape area -> Int =
    | this
    | Rectangle => width * height
    | Circle => radius * radius * 3

    Unit area: Shape -> Int =
    | area
    | Rectangle => area width * area height
    | Circle => area radius * area radius * 3

  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "type main_Point struct {", assertTrue
  go contains: "type main_Shape interface {\n    ismain_Shape()\n}", assertTrue
  go contains: "type main_Rectangle struct {", assertTrue
  go contains: "type main_Circle struct {", assertTrue
  go contains: "func (main_Rectangle) ismain_Shape() {}", assertTrue
  go contains: "func (main_Circle) ismain_Shape() {}", assertTrue
  go contains: "func (this main_Rectangle) nivaField__width() int { return this.width }", assertTrue
  go contains: "func (this main_Rectangle) nivaField__height() int { return this.height }", assertTrue
  go contains: "func main__Shape__area", assertTrue
  go contains: "switch __matchSubject.(type) {", assertTrue
  go contains: "case main_Rectangle:", assertTrue
  go contains: "this := __matchSubject.(main_Rectangle)", assertTrue
  go contains: "return ((this).nivaField__width() * (this).nivaField__height())", assertTrue
  go contains: "case main_Circle:", assertTrue
  go contains: "this := __matchSubject.(main_Circle)", assertTrue
  go contains: "return (((this).nivaField__radius() * (this).nivaField__radius()) * 3)", assertTrue
  go contains: "default:", assertTrue
  go contains: "panic(\"invalid type assertion\")", assertTrue
]

