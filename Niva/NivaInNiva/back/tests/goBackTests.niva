Test goErrorDomainThrowCodegen = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "type main_MyError interface { error; ismain_MyError() }", assertTrue
  go contains: "func (main_Error1) Error() string { return \"Error1\" }", assertTrue
  go contains: "func main__core_Unit__foo(this struct{}) (int, error) {", assertTrue
  go contains: "return 0, main_Error2{404}", assertTrue
  go contains: "return 42, nil", assertTrue
]

Test goErrorDomainHandledMatchCodegen = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error1 => [0]
                | Error2 => [1]
                |=> [it]
      ^ default
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "func main__core_Unit__bar(this struct{}) int {", assertTrue
  go contains: "__matchValue, __matchErr := main__core_Unit__foo(core.UnitInstance)", assertTrue
  go contains: "switch __matchErr.(type) {", assertTrue
  go contains: "case main_Error1:", assertTrue
  go contains: "it := __matchErr.(main_Error1)", assertTrue
  go contains: "it := __matchValue", assertTrue
  Assert that: (go contains: "func main__core_Unit__bar(this struct{}) (int, error)") equals: false
]

Test goErrorDomainMatchByCoreErrorCodegen = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error => [0]
                |=> [it]
      ^ default
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "case error:", assertTrue
  go contains: "it := __matchErr.(error)", assertTrue
]

Test goBindPlaceholder10 = [
  fileMain = """
    Int sumMany: a::Int b::Int c::Int d::Int e::Int f::Int g::Int h::Int i::Int j::Int k::Int -> Int = [
      ^ Bind emit: "$10 + $1" backend: "go" args: {a b c d e f g h i j k}
    ]
    x = 0 sumMany: 1 b: 2 c: 3 d: 4 e: 5 f: 6 g: 7 h: 8 i: 9 j: 10 k: 11
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "return j + a", assertTrue
]
