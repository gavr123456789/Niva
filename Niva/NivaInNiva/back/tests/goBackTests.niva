Test goBindPlaceholder10 = [
  bindFile = """
    Int sumMany: a::Int b::Int c::Int d::Int e::Int f::Int g::Int h::Int i::Int j::Int k::Int -> Int =
      Bind goPkg: "" emit: "$10 + $1"
  """
  fileMain = """
    x = 0 sumMany: 1 b: 2 c: 3 d: 4 e: 5 f: 6 g: 7 h: 8 i: 9 j: 10 k: 11
  """

  result = ResolverHelper resolve: #{"main" fileMain "main.bind" bindFile} entryPoint: "main"
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "10 + 1", assertTrue
]

// New bind design (docs/bind_redesign_plan.md)

// Point 2: single `Bind emit:` body is inlined at the call site (no wrapper func).
Test goBindInlineEmitUnary = [
  bindFile = """
    Int double -> Int = Bind goPkg: "" emit: "($0 * 2)"
  """
  fileMain = """
    x = 21 double
  """
  result = ResolverHelper resolve: #{"main" fileMain "main.bind" bindFile} entryPoint: "main"
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "(21 * 2)", assertTrue
  // no wrapper function is generated for an inline emit
  Assert that: (go contains: "func main__core_Int__double") equals: false
]

// Point 2: keyword form, $0 = this, $1 = first arg, $2 = second arg.
Test goBindInlineEmitKeyword = [
  bindFile = """
    Int sas: Int and: Bool -> Int = Bind goPkg: "" emit: "kekeke($1, $0, $2)"
  """
  fileMain = """
    y = 1 sas: 2 and: true
  """
  result = ResolverHelper resolve: #{"main" fileMain "main.bind" bindFile} entryPoint: "main"
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "kekeke(2, 1, true)", assertTrue
  Assert that: (go contains: "func main__core_Int__sas__and") equals: false
]

// Point 1: empty body in a .bind.niva file -> bind by function name.
// instance method: receiver becomes the first Go argument.
Test goBindByNameInstance = [
  bindFile = """
    String toUpper -> String = Bind goPkg: "strings" goName: "ToUpper"
  """
  fileMain = """
    a = "hi" toUpper
  """
  result = ResolverHelper resolve: #{"main" fileMain "strings.bind" bindFile} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "strings.ToUpper(\"hi\")", assertTrue
  go contains: "\"strings\"", assertTrue
]

Test goBindEmitImportsAllDeclaredPackages = [
  bindFile = """
    String trim -> String = Bind goPkg: "fmt,strings" emit: "fmt.Sprint(strings.TrimSpace($0))"
  """
  fileMain = """
    value = "  niva  " trim
    value echo
  """
  result = ResolverHelper resolve: #{"main" fileMain "strings.bind" bindFile} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  go = GoBackend fullFromIrModule: (result toIrModule)

  Assert that: (go contains: "fmt.Sprint(strings.TrimSpace(\"  niva  \"))") equals: true
  Assert that: (go contains: "\"fmt\"") equals: true
  Assert that: (go contains: "\"strings\"") equals: true
]

// Point 1: static (constructor) bind by name -> receiver is NOT an argument.
Test goBindByNameStatic = [
  bindFile = """
    static String atoi: String -> Int = []
  """
  fileMain = """
    b = String atoi: "42"
  """
  result = ResolverHelper resolve: #{"main" fileMain "strconv.bind" bindFile} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "strconv.Atoi(\"42\")", assertTrue
  go contains: "\"strconv\"", assertTrue
]

// Point 3: a multi-expr bind-file body stays a real function; its ordinary
// `Bind emit:` call is inserted inline in that function.
Test goBindEmitInBody = [
  bindFile = """
    Int compute -> Int = [
      a::Int = Bind goPkg: "" emit: "1 + 41"
      ^ a
    ]
  """
  fileMain = """
    x = 0 compute
  """
  result = ResolverHelper resolve: #{"main" fileMain "main.bind" bindFile} entryPoint: "main"
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "1 + 41", assertTrue
  // a multi-expr bind body is a normal Go function
  go contains: "func main__core_Int__compute", assertTrue
]

Test goSharedEmitRequiresGoPackage = [
  bindFile = """
    Int answer -> Int = Bind emit: "42"
  """
  fileMain = "x = 0 answer"
  result = ResolverHelper resolve: #{"main" fileMain "shared.bind" bindFile}
    entryPoint: "main" backend: "go"
  errors = GoBackend validateIr: (result toIrModule)
  messages = errors joinWith: "\n" transform: [it message]

  Assert that: (messages contains: "Go backend requires an explicit goPkg for Bind emit templates") equals: true
]

Test goUnsupportedConstructorBindHasDiagnostic = [
  typeRef = IrTypeRef
    kind: IrTypeRefKind.Custom
    typeId: "sample_Box"
    ownerPkg: "sample"
    args: {}
    returnType: null
    isMut: false
    nullable: false
    errors: {}
  expr::IrExpr = IrNewExpr
    typeRef: typeRef
    token: Token eof
    typeId: "sample_Box"
    args: {}
    constructorBind: (IrConstructorBindEmit backend: "kotlin" template: "Box()")
  errors::mut List(GoIrError) = {}!

  expr validateGoIrExpr: #() knownTypeIds: #( "sample_Box" ) goErrors: errors
  Assert that: errors count equals: 1
  Assert that: ((errors first message) contains: "Go backend does not support constructor binding") equals: true
]

Test goEntryPointRecoversPanics = [
  result = ResolverHelper resolve: #{"main" "1 echo"} entryPoint: "main" backend: "go"
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "defer func() {", assertTrue
  go contains: "recovered := recover()", assertTrue
  go contains: "fmt.Fprintln(os.Stderr, recovered)", assertTrue
  go contains: "os.Exit(1)", assertTrue
]

Test goAtomIdentifierAsStringLiteral = [
  fileMain = """
    color = #red
    other = #blue
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "var color string = \"red\"", assertTrue
  go contains: "var other string = \"blue\"", assertTrue
]


/// dollars and quotes are built by concatenation
/// so that the kotlin bootstrap does not touch them
Test goInterpolatedStringConcat = [
  dollar = "$"
  quote = (34 toChar) toString
  fileMain = "type Point\n  x: Int\n\nn = 5\np = Point x: 1\nt = " + quote + dollar + "[n + 1] of " + dollar + "[p]" + quote + "\n"

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "var t string = ((core.Any__toString((n + 1)) + \" of \") + core.Any__toString(p))", assertTrue
]

/// escaped dollar becomes a plain dollar in the emitted go string
Test goEscapedDollarStaysPlainText = [
  dollar = "$"
  bs = "\\"
  quote = (34 toChar) toString
  fileMain = "t = " + quote + bs + dollar + "name" + quote + "\n"
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: ("var t string = " + quote + dollar + "name" + quote), assertTrue
]
