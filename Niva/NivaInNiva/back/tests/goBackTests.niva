Test goNullableValueInitializerCodegen = [
  Assert nivaToGo: """
    type Person
      name: String

    nullableValue::Int? = 42
    nullableNull::Int? = null
    nullableText::String? = "text"
    nullableComputed::Int? = 1 + 2
    nullablePerson::Person? = Person name: "Ada"
    nullableAgain::Int? = nullableValue
    result = | nullableValue
      | null => 0
      |=> nullableValue inc
  """ containsAll: {
    "var nullableValue *int = core.NewNullable(int(42))" "var nullableNull *int = nil"
    "var nullableText *string = core.NewNullable(string(\"text\"))"
    "var nullableComputed *int = core.NewNullable(int((1 + 2)))"
    "var nullablePerson *main_Person = core.NewNullable(main_Person(main_Person{\"Ada\"}))"
    "var nullableAgain *int = nullableValue"
    "core.Int__inc(*nullableValue)"
  }
]

Test goNullableInt64UsesNonNullableTarget = [
  valueType = IrTypeRef kind: IrTypeRefKind.Builtin typeId: "core_Int64" ownerPkg: "core" args: {} returnType: null isMut: false nullable: false errors: {}
  nullableType = IrTypeRef kind: IrTypeRefKind.Builtin typeId: "core_Int64" ownerPkg: "core" args: {} returnType: null isMut: false nullable: true errors: {}
  value = IrLiteralExpr literal: (IrLiteral kind: IrLiteralKind.Int lexeme: "42") typeRef: valueType token: (Token fake)
  symbols = GoSymbolTable typeNames: #{}! funcNames: #{}! packageNames: #{}! fileNames: #{}! fieldNames: #{}! constructorFieldTypes: #{}! fieldTypesByName: #{}! unionTypeIds: #()! unionDefs: #{}! eqTypeIds: #()!
  ctx = GoContext forSymbols: symbols
  go = value toGoNullableInitExpr: ctx scope: (GoScope new) targetType: nullableType

  Assert that: go equals: "core.NewNullable(int64(42))"
]

