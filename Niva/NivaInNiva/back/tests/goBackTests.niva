Test goBindPlaceholder10 = [
  Assert nivaFiles: #{
    "main" """
    x = 0 sumMany: 1 b: 2 c: 3 d: 4 e: 5 f: 6 g: 7 h: 8 i: 9 j: 10 k: 11
  """
    "main.bind" """
    Int sumMany: a::Int b::Int c::Int d::Int e::Int f::Int g::Int h::Int i::Int j::Int k::Int -> Int =
      Bind imports: #() emit: "$10 + $1"
  """
  } containsAll: {"10 + 1"}
]

// New bind design (docs/bind_redesign_plan.md)

// Point 2: single `Bind emit:` body is inlined at the call site (no wrapper func).
Test goBindInlineEmitUnary = [
  Assert nivaFiles: #{
    "main" """
    x = 21 double
  """
    "main.bind" """
    Int double -> Int = Bind imports: #() emit: "($0 * 2)"
  """
  } containsAll: {"(21 * 2)"} containsNone: {"func main__core_Int__double"}
]

// Point 2: keyword form, $0 = this, $1 = first arg, $2 = second arg.
Test goBindInlineEmitKeyword = [
  Assert nivaFiles: #{
    "main" """
    y = 1 sas: 2 and: true
  """
    "main.bind" """
    Int sas: Int and: Bool -> Int = Bind imports: #() emit: "kekeke($1, $0, $2)"
  """
  } containsAll: {"kekeke(2, 1, true)"} containsNone: {"func main__core_Int__sas__and"}
]

// by-name instance binding passes the receiver as the first Go argument
Test goBindByNameInstance = [
  Assert nivaFiles: #{
    "main" """
    a = "hi" toUpper
  """
    "strings.bind" """
    String toUpper -> String = Bind pkg: "strings" name: "ToUpper"
  """
  } containsAll: {"strings.ToUpper(\"hi\")" "\"strings\""}
]

Test goBindEmitImportsAllDeclaredPackages = [
  Assert nivaFiles: #{
    "main" """
    value = "  niva  " trim
    value echo
  """
    "strings.bind" """
    String trim -> String = Bind imports: #("fmt" "strings") emit: "fmt.Sprint(strings.TrimSpace($0))"
  """
  } containsAll: {"fmt.Sprint(strings.TrimSpace(\"  niva  \"))" "\"fmt\"" "\"strings\""}
]

// Point 1: static (constructor) bind by name -> receiver is NOT an argument.
Test goBindByNameStatic = [
  Assert nivaFiles: #{
    "main" """
    b = String atoi: "42"
  """
    "strconv.bind" """
    static String atoi: String -> Int = Bind pkg: "strconv" name: "Atoi"
  """
  } containsAll: {"strconv.Atoi(\"42\")" "\"strconv\""}
]

// Point 3: a multi-expr bind-file body stays a real function; its ordinary
// `Bind emit:` call is inserted inline in that function.
Test goBindEmitInBody = [
  Assert nivaFiles: #{
    "main" """
    x = 0 compute
  """
    "main.bind" """
    Int compute -> Int = [
      a::Int = Bind imports: #() emit: "1 + 41"
      ^ a
    ]
  """
  } containsAll: {"1 + 41" "func main__core_Int__compute"}
]

Test goSharedEmitRequiresImports = [
  bindFile = """
    Int answer -> Int = Bind emit: "42"
  """
  fileMain = "x = 0 answer"
  result = ResolverHelper resolve: #{"main" fileMain "shared.bind" bindFile}
    entryPoint: "main"
  errors = GoBackend validateIr: (result toIrModule)
  messages = errors joinWith: "\n" transform: [it message]

  Assert that: (messages contains: "Go backend requires explicit imports for Bind emit templates") equals: true
]

Test goUnsupportedConstructorBindHasDiagnostic = [
  typeRef = IrTypeRef
    kind: IrTypeRefKind.Custom
    typeId: "sample_Box"
    ownerPkg: "sample"
    args: {}
    returnType: null
    isMut: false
    nullable: false
    errors: {}
  expr::IrExpr = IrNewExpr
    :typeRef
    token: Token eof
    typeId: "sample_Box"
    args: {}
    constructorBind: (IrConstructorBindEmit backend: "kotlin" template: "Box()")
  errors::mut List(GoIrError) = {}!

  expr validateGoIrExpr: #() knownTypeIds: #( "sample_Box" ) goErrors: errors
  Assert that: errors count equals: 1
  Assert that: ((errors first message) contains: "Go backend does not support constructor binding") equals: true
]

Test goEntryPointRecoversPanics = [
  Assert nivaToGo: "1 echo" containsAll: {"defer func() {" "recovered := recover()" "fmt.Fprintln(os.Stderr, recovered)" "os.Exit(1)"}
]

Test goAtomIdentifierAsStringLiteral = [
  Assert nivaToGo: """
    color = #red
    other = #blue
  """ containsAll: {"var color string = \"red\"" "var other string = \"blue\""}
]


/// dollars and quotes are built by concatenation
/// so that the kotlin bootstrap does not touch them
Test goInterpolatedStringConcat = [
  Assert nivaToGo: ("type Point\n  x: Int\n\nn = 5\np = Point x: 1\nt = " + ((34 toChar) toString) + ("$") + "[n + 1] of " + ("$") + "[p]" + ((34 toChar) toString) + "\n") containsAll: {
    "var t string = ((core.Any__toString((n + 1)) + \" of \") + core.Any__toString(p))"
  }
]

/// escaped dollar becomes a plain dollar in the emitted go string
Test goEscapedDollarStaysPlainText = [
  Assert nivaToGo: ("t = " + ((34 toChar) toString) + ("\\") + ("$") + "name" + ((34 toChar) toString) + "\n") containsAll: {
    ("var t string = " + ((34 toChar) toString) + ("$") + "name" + ((34 toChar) toString))
  }
]


Test goRangeUntilExclusive = [
  Assert nivaToGo: "r = 1..<3" containsAll: {"core.Int__rangeUntil(1, 3)"}
]

Test goUserInlineMethodSplicesCallbackReturn = [
  Assert nivaToGo: """
    Int apply(body): [Int -> Unit] ^= [
      body item: this
    ]

    Int run ^= [
      this apply: [item::Int -> item == 1 ifTrue: [^ 42]]
      ^ 0
    ]

    1 run echo
  """ containsAll: {"__niva_inline_" "return 42"}
]
Test goEqTypeWithListUsesGeneratedFunction = [
  Assert nivaToGo: """
    type Bag n: Int items: List(Int)
    b1 = Bag n: 1 items: {1 2}
    b2 = Bag n: 1 items: {1 2}
    (b1 == b2) echo
    (b1 != b2) echo
  """ containsAll: {
    "func main_Bag__eq(a, b main_Bag) bool {\n    return (a.n == b.n) &&\n        core.List__equals(a.items, b.items, core.Eq[int])\n}"
    "main_Bag__eq(b1, b2)" "(!main_Bag__eq(b1, b2))"
  }
]

Test goEqUnionComparesBranchFirst = [
  Assert nivaToGo: """
    union Expr = | Num v: Int | Sum terms: List(Expr)
    a::Expr = Sum terms: {(Num v: 1)}
    b::Expr = Sum terms: {(Num v: 1)}
    (a == b) echo
  """ containsAll: {
    "func main_Sum__eq(a, b main_Sum) bool {\n    return core.List__equals(a.terms, b.terms, main_Expr__eq)\n}"
    "func main_Expr__eq(a, b main_Expr) bool {\n    switch x := a.(type) {\n    case main_Sum:\n        y, ok := b.(main_Sum)\n        return ok && main_Sum__eq(x, y)\n    }\n    return a == b\n}"
    "main_Expr__eq(a, b)"
  } containsNone: {"main_Num__eq"}
]

Test goEqPointerFieldsCompareValues = [
  Assert nivaToGo: """
    type Point x: Int y: Int
    type Holder p: Point? q: mut Point n: Int?
    h1 = Holder p: (Point x: 1 y: 2) q: (Point x: 3 y: 4) n: 5
    h2 = Holder p: (Point x: 1 y: 2) q: (Point x: 3 y: 4) n: 5
    (h1 == h2) echo
  """ containsAll: {
    "core.Ptr__equals(a.p, b.p, core.Eq[main_Point])" "core.Ptr__equals(a.q, b.q, core.Eq[main_Point])"
    "core.Ptr__equals(a.n, b.n, core.Eq[int])" "main_Holder__eq(h1, h2)"
  }
]

Test goEqOnlyWhereNeeded = [
  Assert nivaToGo: """
    type Point x: Int y: Int
    type Bag items: List(Int)
    type Line from: Point to: Point
    p1 = Point x: 1 y: 2
    p2 = Point x: 1 y: 2
    (p1 == p2) echo
    b = Bag items: {1}
    l = Line from: p1 to: p2
    (l == l) echo
    bagMaybe::Bag? = b
    (bagMaybe == null) echo
  """ containsAll: {"(p1 == p2)" "(l == l)" "(bagMaybe == nil)"} containsNone: {"main_Point__eq" "main_Bag__eq"}
]

Test goEqCollectionsAndBlocks = [
  Assert nivaToGo: """
    type Op f: [Int -> Int]
    type Env vars: Map(String, List(Int)) tags: Set(String)
    ({1 2} == {1 2}) echo
    ({{1} {2}} != {{1} {2}}) echo
    e = Env vars: #{"x" {1}} tags: #("t")
    (e == e) echo
    o = Op f: [it + 1]
    (o == o) echo
  """ containsAll: {
    "core.List__equals([]int{1, 2}, []int{1, 2}, core.Eq[int])" "(!core.List__equals("
    "func(a, b []int) bool { return core.List__equals(a, b, core.Eq[int]) }"
    "core.Map__equals(a.vars, b.vars, func(a, b []int) bool { return core.List__equals(a, b, core.Eq[int]) })" "core.Set__equals(a.tags, b.tags)"
    "return ((a.f == nil) == (b.f == nil))"
  }
]

Test goDeclaredEqIsCalled = [
  Assert nivaToGo: """
    type Point x: Int y: Int
    Point == other::Point -> Bool = x == other x
    type Pair a: Int b: Int
    Pair != other::Pair -> Bool = a != other a
    p1 = Point x: 1 y: 2
    p2 = Point x: 1 y: 3
    (p1 == p2) echo
    (p1 != p2) echo
    q1 = Pair a: 1 b: 2
    q2 = Pair a: 1 b: 3
    (q1 != q2) echo
    (q1 == q2) echo
  """ containsAll: {"main__Point__equals(p1, p2)" "(main__Point__equals(p1, p2) == false)" "main__Pair__notEquals(q1, q2)" "(q1 == q2)"}
]

Test goDeclaredEqOnUnionIsCalledForBranches = [
  Assert nivaToGo: """
    union Shape = | Circle r: Int | Square s: Int
    Shape == other::Shape -> Bool = true
    c1 = Circle r: 1
    c2 = Circle r: 2
    (c1 == c2) echo
  """ containsAll: {"main__Shape__equals(c1, c2)"}
]

Test goEqNullCollectionIsNotEmpty = [
  Assert nivaToGo: """
    x::List(Int)? = {}
    y::List(Int)? = null
    (x == y) echo
  """ containsAll: {"(((x == nil) == (y == nil)) && core.List__equals(x, y, core.Eq[int]))"}
]

Test goEqGenericTypeTakesCompareForTypeParam = [
  Assert nivaToGo: """
    type Box(T) value: T
    type Pair(A, B) first: A second: List(B)
    a::Box(List(Int)) = Box value: {1 2}
    b::Box(List(Int)) = Box value: {1 2}
    (a == b) echo
    c::Box(Int) = Box value: 1
    (c == c) echo
    p::Pair(Int, String) = Pair first: 1 second: {"x"}
    (p == p) echo
  """ containsAll: {
    "func main_Box__eq[T any](a, b main_Box[T], eqT func(T, T) bool) bool {\n    return eqT(a.value, b.value)\n}"
    "main_Box__eq(a, b, func(a, b []int) bool { return core.List__equals(a, b, core.Eq[int]) })" "main_Box__eq(c, c, core.Eq[int])"
    "func main_Pair__eq[A any, B any](a, b main_Pair[A, B], eqA func(A, A) bool, eqB func(B, B) bool) bool {"
    "core.List__equals(a.second, b.second, eqB)" "main_Pair__eq(p, p, core.Eq[int], core.Eq[string])"
  }
]

Test goEqTypeParamInGenericMethodUsesAny = [
  Assert nivaToGo: """
    T isSame: other::T -> Bool = this == other
    (1 isSame: 1) echo
  """ containsAll: {"return core.EqAny[T](this, other)"}
]

Test goCollectionLiteralOfBranchesUsesExpectedUnion = [
  Assert nivaToGo: """
    union Expr = | Num v: Int | Sym name: String | Sum terms: List(Expr)
    Expr wrap -> Expr = | this
    | Num => Sum terms: {this}
    |=> this
    Int count(es): Set(Expr) -> Int = es count
    s = Sum terms: {(Sym name: "x")}
    m::Map(String, Expr) = #{"a" (Num v: 1)}
    (1 count: #((Num v: 1))) echo
  """ containsAll: {
    "main_Sum{[]main_Expr{main_Sym{\"x\"}}}" "return main_Sum{[]main_Expr{this}}" "map[main_Expr]struct{}{ main_Num{1}: struct{}{} }"
    "map[string]main_Expr{\"a\": main_Num{1}}"
  } containsNone: {"[]main_Sym{" "[]main_Num{"}
]

// go's comparison operators already order strings
Test goStringsAreOrderedWithGoOperators = [
  Assert nivaToGo: """
    a = "apple"
    b = "banana"
    (a < b) echo
    (a > b) echo
    (a <= b) echo
    (a >= b) echo
  """ containsAll: {"(a < b)" "(a > b)" "(a <= b)" "(a >= b)"}
]

// the call inject:into: compiles to has to be the function the runtime defines
Test goInjectIntoCallsRuntimeFunction = [
  Assert nivaToGo: """
    ({1 2 3} inject: 0 into: [acc, x -> acc + x]) echo
  """ containsAll: {"core.List__inject__into["}
  Assert that: (GoRuntimeSources coreSource contains: "func List__inject__into[") equals: true
]

Test goSortedWithCallsRuntimeFunction = [
  Assert nivaToGo: """
    ({3 1 2} sortedWith: [a, b -> a - b]) echo
  """ containsAll: {"core.List__sortedWith["}
  Assert that: (GoRuntimeSources coreSource contains: "func List__sortedWith[T any](s []T, cmp func(T, T) int) []T") equals: true
]
