    | Ok t: T
    | Baad x: T
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromResolver: result

  go contains: "type main_Result interface { ismain_Result() }", assertTrue
  go contains: "type main_Ok[T any] struct {", assertTrue
  go contains: "t T", assertTrue
  go contains: "func (main_Ok[T]) ismain_Result() {}", assertTrue
  go contains: "type main_Baad[T any] struct {", assertTrue
  go contains: "x T", assertTrue
  go contains: "func (main_Baad[T]) ismain_Result() {}", assertTrue
]

Test goExplicitGenericUnionBranchTypeParams = [
