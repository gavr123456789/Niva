Test goErrorDomainHandledMatchCodegen = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error1 => [0]
                | Error2 => [1]
                |=> [it]
      ^ default
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  go = GoBackend fullFromIrModule: (result toIrModule)

  go contains: "func main__core_Unit__bar(this struct{}) int {", assertTrue
  go contains: "__matchValue, __matchErr := main__core_Unit__foo(core.UnitInstance)", assertTrue
  go contains: "switch __matchErr.(type) {", assertTrue
  go contains: "case main_Error1:", assertTrue
  go contains: "it := __matchErr.(main_Error1)", assertTrue
  go contains: "it := __matchValue", assertTrue
  Assert that: (go contains: "func main__core_Unit__bar(this struct{}) (int, error)") equals: false
]

