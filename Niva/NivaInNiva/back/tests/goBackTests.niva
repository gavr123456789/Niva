Test goErrorMatchStatementAliasAndElse = [
  Assert nivaToGo: """
    errordomain E =
    | Bad text: String

    Int parse -> Int!{Bad} = [
      this >= 0 ifTrue: [^ this * 10]
      (Bad text: "negative") throw
      ^ 0
    ]

    Int show -> String = [
      | this parse
      | Bad => "bad" echo
      |=> it toString echo
      | (this + 1) parse
      | Bad => it text echo
      |=> "ok" echo
      "done"
    ]
  """ containsAll: {
    "it := __matchErr.(main_Bad)\n            _ = it" "it := __matchValue_1\n        _ = it" "} else {\n        it := __matchValue\n"
    "__matchValue_1, __matchErr_1 := main__core_Int__parse((this + 1))"
  }
]

