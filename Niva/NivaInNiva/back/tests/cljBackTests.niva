  Assert nivaToClj: ("x = " + ((34 toChar) toString) + ((34 toChar) toString) + ((34 toChar) toString) + "hello\nworld" + ((34 toChar) toString) + ((34 toChar) toString) + ((34 toChar) toString)) containsAll: {"\"hello\\nworld\""} containsNone: {"\"\"\""}
]

