    "main" "x = 41 foo"
    "main.bind" ("Int foo -> Int = Bind emit: " + ((34 toChar) toString) + ((34 toChar) toString) + ((34 toChar) toString) + "(+ $0 1)" + ((34 toChar) toString) + ((34 toChar) toString) + ((34 toChar) toString))
  } containsAll: {"(+ 41 1)"} containsNone: {"\"\"(+ 41 1)\"\""}
]

