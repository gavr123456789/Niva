      name: String
      age: Int

    alice = Person name: "Alice" age: 24
    n = alice name
  """ containsAll: {"(->main_Person \"Alice\" 24)" "(:name alice)"}
]

Test cljImmutableNestedCopyUpdate = [
  Assert nivaToClj: """
    type Money value: Int currency: String
    type Wallet money: Money id: Int
    type Person wallet: Wallet name: String

    person = Person
      wallet: (Wallet money: (Money value: 1 currency: "EUR") id: 7)
      name: "Alice"
    updated = person wallet money value <- 13
  """ containsAll: {"(->main_Person (->main_Wallet (->main_Money 13 (:currency (:money (:wallet person)))) (:id (:wallet person))) (:name person))"} containsNone: {"reset!"}
]

