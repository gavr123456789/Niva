  Assert nivaToClj: """
    color = #red
    other = #blue
  """ containsAll: {"color :red" "other :blue"}
]

Test cljErrorDomainThrowCodegen = [
  Assert nivaToClj: """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]
  """ containsAll: {"(defrecord main_Error1 [text])" "(defrecord main_Error2 [code])" "(->main_Error2 404)" "(throw (ex-info (str __cljErr) {:value __cljErr}))"}
]

Test cljErrorDomainHandledMatchCodegen = [
  Assert nivaToClj: """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error1 => [0]
                | Error2 => [1]
                |=> [it]
      ^ default
    ]
  """ containsAll: {"(niva.core/handling [it" "[niva.core]" "(condp instance? it" "main_Error1 0" "main_Error2 1" ":niva.core/miss"} containsNone: {":niva-ok" ":niva-done"}
]

Test cljErrorDomainMatchByCoreErrorCodegen = [
  Assert nivaToClj: """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error => [0]
                |=> [it]
      ^ default
    ]
  """ containsAll: {"(niva.core/handling [it" "Object 0" ":niva.core/miss"}
]

Test cljErrorDomainNoElseMatchCodegen = [
  Assert nivaToClj: """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      ^ | () foo
        | Error1 => [0]
        | Error2 => [1]
    ]
  """ containsAll: {
    "(catch clojure.lang.ExceptionInfo __cljErr"
    "(:value (ex-data __cljErr))"
    "(condp instance? it"
    "main_Error1 0"
    "main_Error2 1"
    "(throw __cljErr)"
  } containsNone: {"niva.core/handling" ":niva-ok"}
]

