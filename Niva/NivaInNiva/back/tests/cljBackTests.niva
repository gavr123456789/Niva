  Assert nivaToClj: """
    Int double -> Int = this * 2
  """ containsAll: {"(defn main__core_Int__double ^long [^long this]" "(* this 2)"}
]

Test cljStringBuilderConstructor = [
  Assert nivaToClj: """
    b = StringBuilder new
    b append: "x"
  """ containsAll: {"(StringBuilder.)"} containsNone: {"->core_StringBuilder"}
]

Test cljDeclaresFunctionsBeforeDefinitions = [
  fileMain = """
    Int first -> Int = this second
    Int second -> Int = this + 1
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(declare main__core_Int__first main__core_Int__second)", assertTrue
  beforeFirstDef = clj substringBefore: "(defn main__core_Int__first"
  beforeFirstDef contains: "(declare main__core_Int__first main__core_Int__second)", assertTrue
]

Test cljEntryIsBehindReloadSafeHook = [
    Assert nivaToClj: """
     x = 1
     y = 2
    """ containsAll: {"(defn __niva_entry! []" "(let [x 1" "y 2]" "(defn -main [& args]" "(System/setProperty \"niva.cli.args\" (pr-str (vec args)))"} containsNone: {"\n(let [x 1"}
]

Test cljCompilerCliArgsFollowMainArguments = [
  result = ResolverHelper resolve: #{"main" "Compiler cliArgs"}
    entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(System/getProperty \"niva.cli.args\")", assertTrue
  clj contains: "(System/setProperty \"niva.cli.args\" (pr-str (vec args)))", assertTrue
  Assert that: (clj contains: "Compiler__cliArgs") equals: false

  io = IO_Container new
  root = ".niva_clj/cli-args"
  io createDirectories path: root
  io writeFile file: root + "/main.clj" content: clj
  io writeFile file: root + "/deps.edn" content: "{:paths [\".\"]}\n"
  exit = io runProgramFromPath path: root args: {"sh" "-c"
    "clojure -M -e '(do (load-file \"main.clj\") (println (main/-main \"watch\" \"main.niva\" \"--runtime=bb\")))' > result.txt"}
  Assert that: exit equals: 0
  output = io readFile path: root + "/result.txt"
  Assert that: output equals: "[watch main.niva --runtime=bb]\n"
  io deleteRecursively path: root
]

