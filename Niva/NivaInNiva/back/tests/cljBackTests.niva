]

Test cljGenericArgumentAndUnaryOverloadAreDistinct = [
  Assert nivaToClj: """
    type Person name: String
    p = Person name: "Alice"
    Person sas: T -> String = "qwfqwf"
    T sas = "Sas"
    p sas: 42
    p sas
  """ containsAll: {"(defn main_Person__sas__core_Int ^String [^niva.generated.main.main_Person this ^long sas]" "(defn main_Person__sas__0 ^String [^niva.generated.main.main_Person this]"}
]

Test cljMatchByTypeUsesCondpInstance = [
  Assert nivaToClj: """
    union Shape =
    | Rectangle width: Int height: Int
    | Circle radius: Int

    shape::Shape = Rectangle width: 1 height: 2

    area = | shape
    | Rectangle => shape width * shape height
    | Circle => shape radius
  """ containsAll: {"condp instance?" "main_Rectangle" "main_Circle"}
]

Test cljMatchByValueUsesCond = [
  Assert nivaToClj: """
    x = 1
    y = | x
    | 1 => 10
    | 2 => 20
    |=> 30
  """ containsAll: {"(cond" ":else 30"}
]

