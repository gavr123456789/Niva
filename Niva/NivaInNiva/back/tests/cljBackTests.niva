Test cljUnitUsesUnitKeyword = [
  fileMain = """
    Unit sas -> Unit = [
      ()
    ]
    () sas echo
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: ":unit", assertTrue
  clj contains: "(defn main__core_Unit__sas [this] (let [_ :unit] :unit))", assertTrue
]

Test cljGenericReceiverGetsSpecializedFunction = [
  fileMain = """
    type Person name: String
    p = Person name: "Alice"
    T sas = "hii!"
    p sas
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)
  clj echo
  clj contains: "(declare main__T__sas main__main_Person__sas main_Person__sas)", assertTrue
  clj contains: "(defn main_Person__sas [this]", assertTrue
]

Test cljGenericReceiverPreservesNestedGenericTypes = [
  fileMain = """
    type Box(T) value: T
    Box(T) keep: List(T) -> Unit = ()
    b = Box value: 1
    b keep: {2}
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(defn main_Box__core_Int__keep [this keep]", assertTrue
]

Test cljGenericArgumentAndUnaryOverloadAreDistinct = [
  fileMain = """
    type Person name: String
    p = Person name: "Alice"
    Person sas: T -> String = "qwfqwf"
    T sas = "Sas"
    p sas: 42
    p sas
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(defn main_Person__sas__core_Int [this sas]", assertTrue
  clj contains: "(defn main_Person__sas__0 [this]", assertTrue
]

Test cljMatchByTypeUsesCondpInstance = [
  fileMain = """
    union Shape =
    | Rectangle width: Int height: Int
    | Circle radius: Int

    shape::Shape = Rectangle width: 1 height: 2

    area = | shape
    | Rectangle => shape width * shape height
    | Circle => shape radius
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "condp instance?", assertTrue
  clj contains: "main_Rectangle", assertTrue
  clj contains: "main_Circle", assertTrue
]

Test cljMatchByValueUsesCond = [
  fileMain = """
    x = 1
    y = | x
    | 1 => 10
    | 2 => 20
    |=> 30
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(cond", assertTrue
  clj contains: ":else 30", assertTrue
]

Test cljCollectionLiterals = [
  fileMain = """
    xs = {1 2 3}
    ys = #(1 2 3)
    zs = #{"a" 1 "b" 2}
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "[1 2 3]", assertTrue
  clj contains: "#{1 2 3}", assertTrue
  clj contains: "{\"a\" 1 \"b\" 2}", assertTrue
]

Test cljRawStringLiteral = [
  quote = "\""
  triple = quote + quote + quote
  fileMain = "x = " + triple + "hello\nworld" + triple

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  Assert that: (clj contains: "\"\"\"") equals: false
  Assert that: (clj contains: "\"hello\\nworld\"") equals: true
]

Test cljEscapedCharLiterals = [
  fileMain = """
    newline = '\n'
    tab = '\t'
    space = ' '
    backslash = '\\'
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "\\newline", assertTrue
  clj contains: "\\tab", assertTrue
  clj contains: "\\space", assertTrue
  clj contains: "\\\\", assertTrue
]

Test cljFieldGetUsesKeyword = [
  fileMain = """
    type Person
      name: String
      age: Int

    alice = Person name: "Alice" age: 24
    n = alice name
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(->main_Person \"Alice\" 24)", assertTrue
  clj contains: "(:name alice)", assertTrue
]

Test cljBindEmitInline = [
  fileMain = """
    Int double -> Int = Bind emit: "(* $0 2)"
    x = 21 double
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(* 21 2)", assertTrue
  Assert that: (clj contains: "(defn main__core_Int__double") equals: false
]

Test cljBindEmitRawStringInline = [
  quote = "\""
  triple = quote + quote + quote
  fileMain = "Int foo -> Int = Bind emit: " + triple + "(+ $0 1)" + triple + "\nx = 41 foo"

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(+ 41 1)", assertTrue
  Assert that: (clj contains: "\"\"(+ 41 1)\"\"") equals: false
]

Test cljBindEmitBackendSpecific = [
  fileMain = """
    Int foo: Int -> Int = [
      ^ Bind emit: "(clj-only $1)" backend: "clojure" args: {foo}
    ]
    x = 5 foo: 42
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(clj-only foo)", assertTrue
]

Test cljBindAddImport = [
  fileMain = """
    Int readFile: String -> String = [
      Bind addImport: "clojure.java.io" backend: "clojure"
      ^ Bind emit: "(clojure.java.io/slurp $1)" backend: "clojure" args: {readFile}
    ]
    x = 1 readFile: "file.txt"
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "[clojure.java.io]", assertTrue
  clj contains: "(clojure.java.io/slurp readFile)", assertTrue
]

// Clojure preserves the declared external function name. The receiver is the
// first Clojure arg.
Test cljBindByNameInstance = [
  bindFile = """
    String upper-case -> String = []
  """
  fileMain = """
    a = "hi" upper-case
  """
  result = ResolverHelper resolve: #{"main" fileMain "clojure.string.bind" bindFile} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(clojure.string/upper-case \"hi\")", assertTrue
  clj contains: "[clojure.string]", assertTrue
]

// Static bind: the receiver type is not part of the external call arguments.
Test cljBindByNameStatic = [
  bindFile = """
    static String parse-long: String -> Int = []
  """
  fileMain = """
    x = String parse-long: "42"
  """
  result = ResolverHelper resolve: #{"main" fileMain "clojure.core.bind" bindFile} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(clojure.core/parse-long \"42\")", assertTrue
  clj contains: "[clojure.core]", assertTrue
]

// A multi-expression body remains a normal function, while its single
// Bind goCode expression is still emitted inline in that function.
Test cljBindGoCodeInBody = [
  fileMain = """
    Int compute -> Int = [
      a::Int = Bind goCode: "(+ 1 41)"
      ^ a
    ]
    x = 0 compute
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(+ 1 41)", assertTrue
  clj contains: "(defn main__core_Int__compute", assertTrue
]

Test cljDestructure = [
  fileMain = """
    type Person
      name: String
      age: Int

    alice = Person name: "Alice" age: 24
    {age name} = alice
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "{age :age name :name}", assertTrue
]

Test cljAtomIdentifierAsKeyword = [
  fileMain = """
    color = #red
    other = #blue
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "color :red", assertTrue
  clj contains: "other :blue", assertTrue
]

Test cljErrorDomainThrowCodegen = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(defrecord main_Error1 [text])", assertTrue
  clj contains: "(defrecord main_Error2 [code])", assertTrue
  // JVM throws only Throwables: the error record is wrapped in an ex-info
  clj contains: "(->main_Error2 404)", assertTrue
  clj contains: "(throw (ex-info (str __cljErr) {:value __cljErr}))", assertTrue
]

Test cljErrorDomainHandledMatchCodegen = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error1 => [0]
                | Error2 => [1]
                |=> [it]
      ^ default
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  // with an else branch, the success/handled plumbing hides in niva.core/handling
  clj contains: "(niva.core/handling [it", assertTrue
  clj contains: "[niva.core]", assertTrue
  clj contains: "(condp instance? it", assertTrue
  clj contains: "main_Error1 0", assertTrue
  clj contains: "main_Error2 1", assertTrue
  // unhandled errors -> sentinel, which the macro turns into a re-throw
  clj contains: ":niva.core/miss", assertTrue
  Assert that: (clj contains: ":niva-ok") equals: false
  Assert that: (clj contains: ":niva-done") equals: false
]

Test cljErrorDomainMatchByCoreErrorCodegen = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      default = | () foo
                | Error => [0]
                |=> [it]
      ^ default
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  // the base `Error` type has no runtime class, so Object is the catch-all
  clj contains: "(niva.core/handling [it", assertTrue
  clj contains: "Object 0", assertTrue
  clj contains: ":niva.core/miss", assertTrue
]

// A ByError match with no else branch needs no success/handled bookkeeping:
// it emits a plain, idiomatic try/catch/condp with an unhandled re-throw.
Test cljErrorDomainNoElseMatchCodegen = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String
    | Error2 code: Int

    Unit foo -> Int!{Error1 Error2} = [
      (Error2 code: 404) throw
      ^ 42
    ]

    Unit bar -> Int = [
      ^ | () foo
        | Error1 => [0]
        | Error2 => [1]
    ]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(catch clojure.lang.ExceptionInfo __cljErr", assertTrue
  clj contains: "(:value (ex-data __cljErr))", assertTrue
  clj contains: "(condp instance? it", assertTrue
  clj contains: "main_Error1 0", assertTrue
  clj contains: "main_Error2 1", assertTrue
  // the condp default re-throws so an unexpected error would keep propagating
  clj contains: "(throw __cljErr)", assertTrue
  // no macro and no tuples for the else-less shape
  Assert that: (clj contains: "niva.core/handling") equals: false
  Assert that: (clj contains: ":niva-ok") equals: false
]

Test cljTryKeepsExpression = [
  fileMain = """
    errordomain MyError =
    | Error1 text: String

    Unit foo -> Int!{Error1} = [
      (Error1 text: "bad") throw
      ^ 42
    ]

    value = () foo try
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main" backend: "clj"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(main__core_Unit__foo :unit)", assertTrue
  Assert that: (clj contains: "niva.core/Unit__try") equals: false
]

Test cljTryPanicsOnNull = [
  fileMain = """
    value::Int? = null
    result = value try
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main" backend: "clj"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(nil? __tryValue)", assertTrue
  clj contains: "try on null", assertTrue
]

Test cljCoreErrorThrowUsesSentinel = [
  fileMain = """
    Error throw
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main" backend: "clj"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(niva.core/Error__throw :niva.core/Error)", assertTrue
  Assert that: (clj contains: "core_Error") equals: false
]

Test cljCoreErrorFromCallbackUsesErrorMatch = [
  fileMain = """
    Int sas -> Int! = [
      1 > 2 ifTrue: [Error throwWithMsg: "hello"]
      1
    ]

    | 1 sas
    | Error => ["handled" echo]
    |=> ["success" echo]
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(niva.core/handling [it", assertTrue
  clj contains: "Object (niva.core/Any__echo \"handled\")", assertTrue
  Assert that: (clj contains: ":niva.core/Error (let") equals: false
]
