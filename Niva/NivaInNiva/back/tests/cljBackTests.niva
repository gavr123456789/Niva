]

// a call without arguments is not a bind emit so its empty args stay unread
Test cljCallWithoutArgs = [
  Assert nivaToClj: """
    type Input
      name: String

    static Input sas = 42 echo

    Input sas

    1 echo
  """ containsAll: {"(main_Input__sas__ctor_0)"}
]

