  Assert nivaToClj: ("type Point\n  x: Int\n\nn = 5\np = Point x: 1\nt = " + ((34 toChar) toString) + ("$") + "[n + 1] of " + ("$") + "[p]" + ((34 toChar) toString) + "\n") containsAll: {
