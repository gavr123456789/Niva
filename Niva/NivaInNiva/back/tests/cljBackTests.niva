  Assert nivaToClj: """
    mut q = 1
    q <- q + 2
    q
  """ mode: CljEmitMode.Repl containsAll: {"(def q 1)" "(def q (+ q 2))"} containsNone: {"(atom 1)" "(reset! q"}
]

Test cljReplStateInitializersUsePlainValues = [
  Assert nivaToClj: """
    mut a = 1
    mut b = a + 1
    b
  """ mode: CljEmitMode.Repl containsAll: {"(def a 1)" "(def b (+ a 1))"} containsNone: {"@a"}
]

Test cljProgramMutVarUsesLocalAtom = [
  Assert nivaToClj: """
    mut c = 3
    c <- 4
  """ containsAll: {"(defn __niva_entry! []\n  (let [c (atom 3)" "(reset! c 4)"} containsNone: {"__niva_state_uninitialized" "^:clj-reload/keep" "(reset! c 3)"}
]

