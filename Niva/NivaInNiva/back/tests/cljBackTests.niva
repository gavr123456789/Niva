      (Error1 text: "bad") throw
      ^ 42
    ]

    value = () foo try
  """ containsAll: {"(main__core_Unit__foo :unit)"} containsNone: {"niva.core/Unit__try"}
]

Test cljTryPanicsOnNull = [
  Assert nivaToClj: """
    value::Int? = null
    result = value try
  """ containsAll: {"(nil? __tryValue)" "try on null"}
]

