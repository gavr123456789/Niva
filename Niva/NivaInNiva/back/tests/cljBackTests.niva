Test cljRangeUntilExclusive = [
  Assert nivaToClj: "r = 1..<3" containsAll: {"(niva.core/Int__rangeUntil 1 3)"}
]

// a `^` the backend can't put in tail position is reported, not dropped
Test cljEarlyReturnInLoopOrValueIsReported = [
  fileMain = """
    List(Int) hasThree -> Bool = [
      this forEach: [it == 3 ifTrue: [^ true]]
      false
    ]
    Int inValue -> String = [
      s = this > 0 ifTrue: [^ "returned"] ifFalse: ["kept"]
      s + "!"
    ]
    Int inBranch -> String = [
      this > 0 ifTrue: [^ "positive"]
      "not positive"
    ]
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  ctx = CljContext newDebug: false
  sb = StringBuilder new
  (result toIrModule) packages first functions forEach: [CljBackend emitFunction: it ctx: ctx sb: sb]

  Assert that: ctx unsupportedReturns count equals: 3
  ctx unsupportedReturns toList first contains: "can't return from here", assertTrue
]

Test cljListEquality = [
  Assert nivaToClj: """
    ({1 2} == {1 2}) echo
    ({1 2} != {1 3}) echo
  """ containsAll: {"(= [1 2] [1 2])" "(not= [1 2] [1 3])"}
]

Test cljDeclaredEqIsCalled = [
  Assert nivaToClj: """
    type Point x: Int y: Int
    Point == other::Point -> Bool = x == other x
    p1 = Point x: 1 y: 2
    p2 = Point x: 1 y: 3
    (p1 == p2) echo
    (p1 != p2) echo
  """ containsAll: {"(niva.core/Any__echo (main_Point__== p1 p2))" "(niva.core/Any__echo (= (main_Point__== p1 p2) false))"}
]

Test cljMutListOfBranchesIsAtom = [
  Assert nivaToClj: """
    union Expr = | Num v: Int | Sym name: String
    l::mut List(Expr) = {(Num v: 1)}
    l add: (Sym name: "y")
  """ containsAll: {"(let [l (atom [(->main_Num 1)])"}
]

Test cljStringsAreOrderedWithCompare = [
  Assert nivaToClj: """
    a = "apple"
    b = "banana"
    (a < b) echo
    (a >= b) echo
    (1 < 2) echo
    (a + b) echo
  """ containsAll: {"(< (compare a b) 0)" "(>= (compare a b) 0)" "(< 1 2)" "(str a b)"}
]

Test cljInjectIntoCallsRuntimeFunction = [
  fileMain = """
    ({1 2 3} inject: 0 into: [acc, x -> acc + x]) echo
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  // the call inject:into: compiles to has to be the function the runtime defines
  clj contains: "(niva.core/List__inject__into ", assertTrue
  Assert that: (CompilerConstants nivaCoreSource contains: "(defn List__inject__into ") equals: true
]

Test cljSortedWithCallsRuntimeFunction = [
  fileMain = """
    ({3 1 2} sortedWith: [a, b -> a - b]) echo
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(niva.core/List__sortedWith ", assertTrue
  Assert that: (CompilerConstants nivaCoreSource contains: "(defn List__sortedWith ") equals: true
]
