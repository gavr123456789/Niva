String assertCljContents(expected): List(String) excludes(excluded): List(String) -> Unit = [
  expected forEach: [snippet -> Assert that: (this contains: snippet) equals: true]
  excluded forEach: [snippet -> Assert that: (this contains: snippet) equals: false]
]

constructor Assert nivaToClj: String containsAll: List(String) -> Unit = [
  Assert nivaToClj: nivaToClj containsAll: containsAll containsNone: {}
]

constructor Assert nivaToClj: String containsAll: List(String) containsNone: List(String) -> Unit = [
  result = ResolverHelper resolve: #{"main" nivaToClj} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)
  clj assertCljContents: containsAll excludes: containsNone
]

constructor Assert nivaToClj: String mode: CljEmitMode containsAll: List(String) -> Unit = [
  Assert nivaToClj: nivaToClj mode: mode containsAll: containsAll containsNone: {}
]

constructor Assert nivaToClj: String mode: CljEmitMode containsAll: List(String) containsNone: List(String) -> Unit = [
  result = ResolverHelper resolve: #{"main" nivaToClj} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule) debug: false mode: mode
  clj assertCljContents: containsAll excludes: containsNone
]

constructor Assert nivaFilesToClj: Map(String, String) containsAll: List(String) -> Unit = [
  Assert nivaFilesToClj: nivaFilesToClj containsAll: containsAll containsNone: {}
]

constructor Assert nivaFilesToClj: Map(String, String) containsAll: List(String) containsNone: List(String) -> Unit = [
  result = ResolverHelper resolve: nivaFilesToClj entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  clj = CljBackend fullFromIrModule: (result toIrModule)
  clj assertCljContents: containsAll excludes: containsNone
]

Test cljRecordTypes = [
  Assert nivaToClj: """
    type Point
      x: Int
      y: Int
  """ containsAll: {"(defrecord main_Point [x y])"}
]

Test cljFunctionHintsUseClojureTypeTags = [
  Assert nivaToClj: """
    type Person name: String
    Person greet -> String = this name
    Int double -> Int = this * 2
  """ containsAll: {
    "(defn main_Person__greet ^String [^niva.generated.main.main_Person this]"
    "(defn main__core_Int__double ^long [^long this]"
  } containsNone: {"^Int" "^int"}
]

Test cljTypeHintsMapNullableMutableAndCustomTypes = [
  intRef = IrTypeRef kind: IrTypeRefKind.Builtin typeId: "core_Int" ownerPkg: "core"
    args: {} returnType: null isMut: false nullable: false errors: {}
  nullableInt = IrTypeRef kind: IrTypeRefKind.Builtin typeId: "core_Int" ownerPkg: "core"
    args: {} returnType: null isMut: false nullable: true errors: {}
  mutableInt = IrTypeRef kind: IrTypeRefKind.Builtin typeId: "core_Int" ownerPkg: "core"
    args: {} returnType: null isMut: true nullable: false errors: {}
  personRef = IrTypeRef kind: IrTypeRefKind.Custom typeId: "model_Person" ownerPkg: "model"
    args: {} returnType: null isMut: false nullable: false errors: {}
  modelCtx = CljContext newDebug: false imports: #() pkg: "model"
    namespace: "niva.generated.model" hotReload: false

  Assert that: (intRef cljPrimitiveFunctionHint) equals: "long"
  Assert that: (nullableInt cljPrimitiveFunctionHint) equals: ""
  Assert that: (mutableInt cljPrimitiveFunctionHint) equals: ""
  Assert that: (personRef cljClassHint: modelCtx) equals: "niva.generated.model.model_Person"
]

Test cljPackageOutputUsesStableNamespacesAndPaths = [
  sources = #{
    "model" "type Person name: String\nPerson greet -> String = [^ name]"
    "main" "p = Person name: \"Ada\"\np greet"
  }
  result = ResolverHelper resolve: sources entryPoint: "main"
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program

  Assert that: output files count equals: 2
  Assert that: output entryNamespace equals: "niva.generated.main"
  modelMaybe = output files at: "niva/generated/model.clj"
  model = modelMaybe expect: "Missing generated model"
  mainMaybe = output files at: "niva/generated/main.clj"
  main = mainMaybe expect: "Missing generated main"
  model contains: "(ns niva.generated.model)", assertTrue
  Assert that: (model contains: ":gen-class") equals: false
  main contains: "(ns niva.generated.main (:gen-class) (:require [niva.generated.model]))", assertTrue
  main contains: "niva.generated.model/->model_Person", assertTrue
  main contains: "niva.generated.model/model_Person__greet", assertTrue
  Assert that: (model contains: "(defn -main") equals: false
  main contains: "(defn -main", assertTrue
]

Test cljBabashkaTargetRunsGeneratedProgram = [
  fileMain = "type Person name: String\np = Person name: \"Ada\""
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  output = CljBackend fullOutputFromIrModuleForTarget: (result toIrModule)
    debug: false mode: CljEmitMode.Program target: CljTarget.Bb
  root = ".niva_clj/babashka-target"
  setupExit = (IO_Container new) runProgram args: {"sh" "-c"
    "rm -rf .niva_clj/babashka-target && mkdir -p .niva_clj/babashka-target/generated/niva/generated"}
  Assert that: setupExit equals: 0

  io = IO_Container new
  output files forEach: [relativePath, content ->
    destination = root + "/generated/" + relativePath
    io writeFile file: destination :content
  ]
  mainMaybe = output files at: "niva/generated/main.clj"
  main = mainMaybe expect: "Missing generated main"
  io writeFile file: root + "/main.clj" content: output legacyMainShim
  io writeFile file: root + "/deps.edn" content: "{:paths [\"generated\" \".\"]}\n"

  Assert that: output target equals: CljTarget.Bb
  Assert that: (main contains: ":gen-class") equals: false
  Assert that: (output legacyMainShim contains: ":gen-class") equals: false
  exit = io runProgramFromPath path: root args: {"bb" "-cp" "generated:." "-m" "main"}
  Assert that: exit equals: 0

  io deleteRecursively path: root
]

Test cljManifestIsDeterministicAndUnchangedShapeIsCompatible = [
  sources = #{
    "model" "type Person name: String"
    "main" "mut counter = 1\np = Person name: \"Ada\"\np"
  }
  result = ResolverHelper resolve: sources entryPoint: "main"
  firstOutput = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  secondOutput = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program

  Assert that: firstOutput manifest canonical equals: secondOutput manifest canonical
  Assert that: (firstOutput manifest edn contains: ":entry-ns \"niva.generated.main\"") equals: true
  Assert that: (firstOutput manifest edn contains: "\"main\" {:file \"niva/generated/main.clj\"") equals: true
  Assert that: (firstOutput manifest edn contains: "\"main/counter\"") equals: true
  Assert that: (firstOutput manifest edn contains: "\"model/model_Person\"") equals: true
  Assert that: (firstOutput manifest incompatibleChanges: secondOutput manifest) count equals: 0
]

Test cljManifestDetectsChangedRecordFields = [
  firstSources = #{"main" "type Person name: String"}
  changedSources = #{"main" "type Person name: String age: Int"}
  firstResult = ResolverHelper resolve: firstSources entryPoint: "main"
  changedResult = ResolverHelper resolve: changedSources entryPoint: "main"
  firstManifest = (CljBackend fullOutputFromIrModule: (firstResult toIrModule)
    debug: false mode: CljEmitMode.Program) manifest
  changedManifest = (CljBackend fullOutputFromIrModule: (changedResult toIrModule)
    debug: false mode: CljEmitMode.Program) manifest
  changes = changedManifest incompatibleChanges: firstManifest

  Assert that: changes count equals: 1
  Assert that: (changes first contains: "type shape changed: main/main_Person") equals: true
]

Test cljManifestDetectsChangedUnionBranches = [
  firstSources = #{"main" "union Shape =\n| Circle radius: Int"}
  changedSources = #{"main" "union Shape =\n| Circle radius: Int diameter: Int"}
  firstResult = ResolverHelper resolve: firstSources entryPoint: "main"
  changedResult = ResolverHelper resolve: changedSources entryPoint: "main"
  firstManifest = (CljBackend fullOutputFromIrModule: (firstResult toIrModule)
    debug: false mode: CljEmitMode.Program) manifest
  changedManifest = (CljBackend fullOutputFromIrModule: (changedResult toIrModule)
    debug: false mode: CljEmitMode.Program) manifest
  changes = changedManifest incompatibleChanges: firstManifest

  Assert that: changes count equals: 1
  Assert that: (changes first contains: "type shape changed: main/main_Shape") equals: true
]

Test cljManifestDetectsChangedEnumValues = [
  oldEnum = IrEnumDef
    id: "main_Color" pkgId: "main" name: "Color" values: {"Red" "Green"} token: (Token fake)
  newEnum = IrEnumDef
    id: "main_Color" pkgId: "main" name: "Color" values: {"Red" "Green" "Blue"} token: (Token fake)
  oldManifest = CljManifest
    version: 1 entryNamespace: "niva.generated.main" modules: {}
    stateVars: {}
    typeShapes: {(CljTypeShape key: "main/main_Color" kind: "enum"
      shape: oldEnum cljManifestShape)}
  newManifest = CljManifest
    version: 1 entryNamespace: "niva.generated.main" modules: {}
    stateVars: {}
    typeShapes: {(CljTypeShape key: "main/main_Color" kind: "enum"
      shape: newEnum cljManifestShape)}
  changes = newManifest incompatibleChanges: oldManifest

  Assert that: changes count equals: 1
  Assert that: (changes first contains: "type shape changed: main/main_Color") equals: true
]

Test cljPackageOutputQualifiesUnionBranches = [
  sources = #{
    "model" "union Shape =\n| Circle radius: Int"
    "main" "shape = Circle radius: 1\nvalue = | shape\n| Circle => shape radius\n|=> 0"
  }
  result = ResolverHelper resolve: sources entryPoint: "main"
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  mainMaybe = output files at: "niva/generated/main.clj"
  main = mainMaybe expect: "Missing generated main"

  // a constructor is a var, named with `/`, and a record's class with `.`
  main assertCljContents: {"niva.generated.model/->model_Circle" "niva.generated.model.model_Circle"}
    excludes: {"niva.generated.model/model_Circle"}
]

Test cljFolderPackageNamesHaveNoDots = [
  sources = #{
    "geo.shapes" "type Point x: Int\nunion Shape =\n| Circle radius: Int\nenum Color = Red | Green"
    "main" "p = Point x: 1\nshape = Circle radius: 1\nvalue = | shape\n| Circle => shape radius\n|=> 0\ncolor = Color.Red"
  }
  result = ResolverHelper resolve: sources entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  shapesMaybe = output files at: "niva/generated/geo/shapes.clj"
  shapes = shapesMaybe expect: "Missing generated geo.shapes"
  mainMaybe = output files at: "niva/generated/main.clj"
  main = mainMaybe expect: "Missing generated main"

  // Clojure reads a dotted name as a class, so the package's dots become `_`
  shapes assertCljContents: {
    "(defrecord geo_shapes_Point [x])"
    "(defrecord geo_shapes_Circle [radius])"
    "(def geo_shapes_Color_Red :geo_shapes_Color_Red)"
  } excludes: {"geo.shapes_"}
  main assertCljContents: {
    "niva.generated.geo.shapes/->geo_shapes_Point"
    "niva.generated.geo.shapes/->geo_shapes_Circle"
    "niva.generated.geo.shapes.geo_shapes_Circle"
    "niva.generated.geo.shapes/geo_shapes_Color_Red"
  } excludes: {"geo.shapes_" "niva.generated.geo.shapes/geo_shapes_Circle"}
]

Test cljFolderPackageUnionMatchesFromMainOnBabashka = [
  sources = #{
    "geo.shapes" "union Shape =\n| Circle radius: Int\n| Square side: Int"
    "main" "shape::Shape = Square side: 3\nvalue = | shape\n| Circle => shape radius\n| Square => shape side\nvalue print"
    "main.bind" "Int print -> Unit = Bind emit: \"(println $0)\""
  }
  result = ResolverHelper resolve: sources entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  output = CljBackend fullOutputFromIrModuleForTarget: (result toIrModule)
    debug: false mode: CljEmitMode.Program target: CljTarget.Bb
  io = IO_Container new
  root = ".niva_clj/folder-package"
  setupExit = io runProgram args: {"sh" "-c"
    "rm -rf .niva_clj/folder-package && mkdir -p .niva_clj/folder-package/niva/generated/geo"}
  Assert that: setupExit equals: 0
  output files forEach: [relativePath, content ->
    io writeFile file: root + "/" + relativePath :content
  ]

  exit = io runProgramFromPath path: root args: {"sh" "-c" "bb -cp . -m niva.generated.main > result.txt"}
  Assert that: exit equals: 0
  Assert that: (io readFile path: root + "/result.txt") equals: "3\n"
  io deleteRecursively path: root
]

// the Java package of a namespace with a dash has `_` in its place
Test cljPackageWithDashNamesClassByJavaPackage = [
  sources = #{
    "my-geo" "union Shape =\n| Circle radius: Int"
    "main" "shape = Circle radius: 1\nvalue = | shape\n| Circle => shape radius\n|=> 0"
  }
  result = ResolverHelper resolve: sources entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  mainMaybe = output files at: "niva/generated/main.clj"
  main = mainMaybe expect: "Missing generated main"

  main contains: "niva.generated.my-geo/->my-geo_Circle", assertTrue
  main contains: "niva.generated.my_geo.my-geo_Circle", assertTrue
]

Test cljPackageOutputQualifiesEnumAtom = [
  enumRef = IrTypeRef
    kind: IrTypeRefKind.Custom
    typeId: "model_Color"
    ownerPkg: "model"
    args: {}
    returnType: null
    isMut: false
    nullable: false
    errors: {}
  atom = IrLiteralExpr
    literal: (IrLiteral kind: IrLiteralKind.Atom lexeme: "red")
    typeRef: enumRef
    token: (Token fake)
  ctx = CljContext newDebug: false imports: #() pkg: "main"
  clj = atom toCljExpr: ctx scope: CljScope new

  Assert that: clj equals: "niva.generated.model/model_Color_red"
]

Test cljPackageOutputQualifiesErrorBranches = [
  sources = #{
    "model" "errordomain ModelError =\n| Missing code: Int\n\nUnit fail -> Int!{Missing} = [\n  (Missing code: 404) throw\n  ^ 0\n]"
    "main" "value = | () fail\n| Missing => [1]\n|=> [0]"
  }
  result = ResolverHelper resolve: sources entryPoint: "main"
  Assert that: result db listOfErrors count equals: 0
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  modelMaybe = output files at: "niva/generated/model.clj"
  model = modelMaybe expect: "Missing generated model"
  mainMaybe = output files at: "niva/generated/main.clj"
  main = mainMaybe expect: "Missing generated main"

  model contains: "(->model_Missing 404)", assertTrue
  main contains: "niva.generated.model.model_Missing", assertTrue
]

