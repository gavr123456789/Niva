Test cljRecordTypes = [
  fileMain = """
    type Point
      x: Int
      y: Int
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(defrecord main_Point [x y])", assertTrue
]

Test cljPackageOutputUsesStableNamespacesAndPaths = [
  sources = #{
    "model" "type Person name: String\nPerson greet -> String = [^ name]"
    "main" "p = Person name: \"Ada\"\np greet"
  }
  result = ResolverHelper resolve: sources entryPoint: "main" backend: "clj"
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program

  Assert that: output files count equals: 2
  Assert that: output entryNamespace equals: "niva.generated.main"
  model = output files at: "niva/generated/model.clj", unpackOrPANIC
  main = output files at: "niva/generated/main.clj", unpackOrPANIC
  model contains: "(ns niva.generated.model)", assertTrue
  Assert that: (model contains: ":gen-class") equals: false
  main contains: "(ns niva.generated.main (:gen-class) (:require [niva.generated.model]))", assertTrue
  main contains: "niva.generated.model/->model_Person", assertTrue
  main contains: "niva.generated.model/model_Person__greet", assertTrue
  Assert that: (model contains: "(defn -main") equals: false
  main contains: "(defn -main", assertTrue
]

Test cljManifestIsDeterministicAndUnchangedShapeIsCompatible = [
  sources = #{
    "model" "type Person name: String"
    "main" "mut counter = 1\np = Person name: \"Ada\"\np"
  }
  result = ResolverHelper resolve: sources entryPoint: "main" backend: "clj"
  firstOutput = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  secondOutput = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program

  Assert that: firstOutput manifest canonical equals: secondOutput manifest canonical
  Assert that: (firstOutput manifest edn contains: ":entry-ns \"niva.generated.main\"") equals: true
  Assert that: (firstOutput manifest edn contains: "\"main\" {:file \"niva/generated/main.clj\"") equals: true
  Assert that: (firstOutput manifest edn contains: "\"main/counter\"") equals: true
  Assert that: (firstOutput manifest edn contains: "\"model/model_Person\"") equals: true
  Assert that: (firstOutput manifest incompatibleChanges: secondOutput manifest) count equals: 0
]

Test cljManifestDetectsChangedRecordFields = [
  firstSources = #{"main" "type Person name: String"}
  changedSources = #{"main" "type Person name: String age: Int"}
  firstResult = ResolverHelper resolve: firstSources entryPoint: "main" backend: "clj"
  changedResult = ResolverHelper resolve: changedSources entryPoint: "main" backend: "clj"
  firstManifest = (CljBackend fullOutputFromIrModule: (firstResult toIrModule)
    debug: false mode: CljEmitMode.Program) manifest
  changedManifest = (CljBackend fullOutputFromIrModule: (changedResult toIrModule)
    debug: false mode: CljEmitMode.Program) manifest
  changes = changedManifest incompatibleChanges: firstManifest

  Assert that: changes count equals: 1
  Assert that: (changes first contains: "type shape changed: main/main_Person") equals: true
]

Test cljManifestDetectsChangedUnionBranches = [
  firstSources = #{"main" "union Shape =\n| Circle radius: Int"}
  changedSources = #{"main" "union Shape =\n| Circle radius: Int diameter: Int"}
  firstResult = ResolverHelper resolve: firstSources entryPoint: "main" backend: "clj"
  changedResult = ResolverHelper resolve: changedSources entryPoint: "main" backend: "clj"
  firstManifest = (CljBackend fullOutputFromIrModule: (firstResult toIrModule)
    debug: false mode: CljEmitMode.Program) manifest
  changedManifest = (CljBackend fullOutputFromIrModule: (changedResult toIrModule)
    debug: false mode: CljEmitMode.Program) manifest
  changes = changedManifest incompatibleChanges: firstManifest

  Assert that: changes count equals: 1
  Assert that: (changes first contains: "type shape changed: main/main_Shape") equals: true
]

Test cljManifestDetectsChangedEnumValues = [
  oldEnum = IrEnumDef
    id: "main_Color" pkgId: "main" name: "Color" values: {"Red" "Green"} token: FAKE_TOKEN
  newEnum = IrEnumDef
    id: "main_Color" pkgId: "main" name: "Color" values: {"Red" "Green" "Blue"} token: FAKE_TOKEN
  oldManifest = CljManifest
    version: 1 entryNamespace: "niva.generated.main" modules: {}
    stateVars: {}
    typeShapes: {(CljTypeShape key: "main/main_Color" kind: "enum"
      shape: oldEnum cljManifestShape)}
  newManifest = CljManifest
    version: 1 entryNamespace: "niva.generated.main" modules: {}
    stateVars: {}
    typeShapes: {(CljTypeShape key: "main/main_Color" kind: "enum"
      shape: newEnum cljManifestShape)}
  changes = newManifest incompatibleChanges: oldManifest

  Assert that: changes count equals: 1
  Assert that: (changes first contains: "type shape changed: main/main_Color") equals: true
]

Test cljPackageOutputQualifiesUnionBranches = [
  sources = #{
    "model" "union Shape =\n| Circle radius: Int"
    "main" "shape = Circle radius: 1\nvalue = | shape\n| Circle => shape radius\n|=> 0"
  }
  result = ResolverHelper resolve: sources entryPoint: "main" backend: "clj"
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  main = output files at: "niva/generated/main.clj", unpackOrPANIC

  main contains: "niva.generated.model/->model_Circle", assertTrue
  main contains: "niva.generated.model/model_Circle", assertTrue
]

Test cljPackageOutputQualifiesEnumAtom = [
  enumRef = IrTypeRef
    kind: IrTypeRefKind.Custom
    typeId: "model_Color"
    ownerPkg: "model"
    args: {}
    returnType: null
    isMut: false
    nullable: false
    errors: {}
  atom = IrLiteralExpr
    literal: (IrLiteral kind: IrLiteralKind.Atom lexeme: "red")
    typeRef: enumRef
    token: FAKE_TOKEN
  ctx = CljContext newDebug: false imports: #() pkg: "main"
  clj = atom toCljExpr: ctx scope: CljScope new

  Assert that: clj equals: "niva.generated.model/model_Color_red"
]

Test cljPackageOutputQualifiesErrorBranches = [
  sources = #{
    "model" "errordomain ModelError =\n| Missing code: Int\n\nUnit fail -> Int!{Missing} = [\n  (Missing code: 404) throw\n  ^ 0\n]"
    "main" "value = | () fail\n| Missing => [1]\n|=> [0]"
  }
  result = ResolverHelper resolve: sources entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  model = output files at: "niva/generated/model.clj", unpackOrPANIC
  main = output files at: "niva/generated/main.clj", unpackOrPANIC

  model contains: "(->model_Missing 404)", assertTrue
  main contains: "niva.generated.model/model_Missing", assertTrue
]

Test cljPackageOutputKeepsBindRequirementWithQualifiedCall = [
  sources = #{
    "model" "String shout -> String = [^ this upper-case]"
    "main" "value = \"hi\" shout"
    "clojure.string.bind" "String upper-case -> String = []"
  }
  result = ResolverHelper resolve: sources entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  model = output files at: "niva/generated/model.clj", unpackOrPANIC
  main = output files at: "niva/generated/main.clj", unpackOrPANIC

  model contains: "(:require [clojure.string]", assertTrue
  model contains: "(clojure.string/upper-case this)", assertTrue
  main contains: "niva.generated.model/model__core_String__shout", assertTrue
]

Test cljPackageOutputMatchesSingleStringAtRuntime = [
  sources = #{
    "model" "type Person name: String\nPerson score -> Int = [^ 42]"
    "main" "p = Person name: \"Ada\"\nvalue = p score\nInt print -> Unit = Bind emit: \"(println $0)\"\nvalue print"
  }
  result = ResolverHelper resolve: sources entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  ir = result toIrModule
  io = IO_Container new
  cleanRoot = ".niva_clj/differential-clean"
  multiRoot = ".niva_clj/differential-multi"
  setupExit = io runProgram args: {"sh" "-c"
    "rm -rf .niva_clj/differential-clean .niva_clj/differential-multi && mkdir -p .niva_clj/differential-clean .niva_clj/differential-multi/niva/generated"}
  Assert that: setupExit equals: 0

  clean = CljBackend fullFromIrModule: ir
  io writeFile file: cleanRoot + "/main.clj" content: clean
  io writeFile file: cleanRoot + "/deps.edn" content: "{:paths [\".\"]}\n"
  cleanExit = io runProgramFromPath path: cleanRoot
    args: {"sh" "-c" "clojure -M -m main > result.txt"}
  Assert that: cleanExit equals: 0
  cleanResult = io readFile path: cleanRoot + "/result.txt"

  output = CljBackend fullOutputFromIrModule: ir
    debug: false mode: CljEmitMode.Program
  output files forEach: [relativePath, content ->
    destination = multiRoot + "/" + relativePath
    io writeFile file: destination content: content
  ]
  io writeFile file: multiRoot + "/deps.edn" content: "{:paths [\".\"]}\n"
  multiExit = io runProgramFromPath path: multiRoot
    args: {"sh" "-c" "clojure -M -m niva.generated.main > result.txt"}
  Assert that: multiExit equals: 0
  multiResult = io readFile path: multiRoot + "/result.txt"

  Assert that: cleanResult equals: multiResult
  Assert that: cleanResult equals: "42\n"
  cleanupExit = io runProgram args: {"sh" "-c"
    "rm -rf .niva_clj/differential-clean .niva_clj/differential-multi"}
  Assert that: cleanupExit equals: 0
]

Test cljPackageRequireDoesNotRunEntry = [
  source = "base = 2\nmut counter = base\ncounter <- counter + 1\nInt announce -> Unit = Bind emit: \"(println $0)\"\ncounter announce"
  result = ResolverHelper resolve: #{"main" source} entryPoint: "main" backend: "clj"
  Assert that: result db listOfErrors count equals: 0
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program

  io = IO_Container new
  root = ".niva_clj/entry-hook"
  setupExit = io runProgram args: {"sh" "-c"
    "rm -rf .niva_clj/entry-hook && mkdir -p .niva_clj/entry-hook/niva/generated"}
  Assert that: setupExit equals: 0
  output files forEach: [relativePath, content ->
    destination = root + "/" + relativePath
    io writeFile file: destination content: content
  ]
  io writeFile file: root + "/deps.edn" content: "{:paths [\".\"]}\n"

  requireExit = io runProgramFromPath path: root args: {"sh" "-c"
    "clojure -M -e '(require (quote niva.generated.main))' > result.txt"}
  Assert that: requireExit equals: 0
  requireResult = io readFile path: root + "/result.txt"
  Assert that: requireResult equals: ""

  entryExit = io runProgramFromPath path: root args: {"sh" "-c"
    "clojure -M -e '(require (quote niva.generated.main)) (niva.generated.main/__niva_entry!) (niva.generated.main/__niva_entry!)' > result.txt"}
  Assert that: entryExit equals: 0
  entryResult = io readFile path: root + "/result.txt"
  Assert that: entryResult equals: "3\n:unit\n4\n:unit\n"

  cleanupExit = io runProgram args: {"sh" "-c" "rm -rf .niva_clj/entry-hook"}
  Assert that: cleanupExit equals: 0
]

Test cljUnionShapesAsRecords = [
  fileMain = """
    union Shape =
    | Rectangle width: Int height: Int
    | Circle radius: Int
  """

  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(defrecord main_Rectangle [width height])", assertTrue
  clj contains: "(defrecord main_Circle [radius])", assertTrue
]

// enum inside triple-quoted source is not parsed by the parser test path
// (same as goEnumCodegen in goBackTests.niva — kept commented until the parser
// supports enums in-string). Enum emit itself is still exercised via the
// compiler pipeline when running from a real file.

Test cljFunctionAsDefn = [
  fileMain = """
    Int double -> Int = this * 2
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(defn main__core_Int__double [this]", assertTrue
  clj contains: "(* this 2)", assertTrue
]

Test cljStringBuilderConstructor = [
  fileMain = """
    b = StringBuilder new
    b append: "x"
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(StringBuilder.)", assertTrue
  Assert that: (clj contains: "->core_StringBuilder") equals: false
]

Test cljDeclaresFunctionsBeforeDefinitions = [
  fileMain = """
    Int first -> Int = this second
    Int second -> Int = this + 1
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(declare main__core_Int__first main__core_Int__second)", assertTrue
  beforeFirstDef = clj substringBefore: "(defn main__core_Int__first"
  beforeFirstDef contains: "(declare main__core_Int__first main__core_Int__second)", assertTrue
]

Test cljEntryIsBehindReloadSafeHook = [
    fileMain = """
     x = 1
     y = 2
    """
    result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
    clj = CljBackend fullFromIrModule: (result toIrModule)
    clj contains: "(defn __niva_entry! []", assertTrue
    clj contains: "(let [x 1", assertTrue
    clj contains: "y 2]", assertTrue
    Assert that: (clj contains: "\n(let [x 1") equals: false
    clj contains: "(defn -main [& args]", assertTrue
]

Test cljProgramNamespaceGeneratesJavaMainClass = [
  result = ResolverHelper resolve: #{"main" "1 echo"} entryPoint: "main" backend: "clj"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(ns main (:gen-class) (:require [niva.core]))", assertTrue
]

Test cljReplEmissionMode = [
  fileMain = """
    x = 1
    x + 2
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)
          debug: false mode: CljEmitMode.Repl

  clj contains: "(ns niva.repl.session)", assertTrue
  clj contains: "(def x 1)", assertTrue
  clj contains: "(+ x 2)", assertTrue
  Assert that: (clj contains: "(defn -main") equals: false
]

Test cljReplEmitsOnlyCurrentEntryLines = [
  fileMain = """
    q = 42
    q + 8
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  ir = result toIrModuleFromEntryLine: 3
  clj = CljBackend fullFromIrModule: ir debug: false mode: CljEmitMode.Repl

  clj contains: "(+ q 8)", assertTrue
  Assert that: (clj contains: "(def q 42)") equals: false
]

Test cljReplTopLevelMutationUsesDef = [
  fileMain = """
    mut q = 1
    q <- q + 2
    q
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  ir = result toIrModuleFromEntryLine: 3
  clj = CljBackend fullFromIrModule: ir debug: false mode: CljEmitMode.Repl

  clj contains: "(def q (+ q 2))", assertTrue
  clj contains: "\nq\n", assertTrue
]

Test cljReplInitialMutationUsesPlainValue = [
  fileMain = """
    mut q = 1
    q <- q + 2
    q
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)
          debug: false mode: CljEmitMode.Repl

  clj contains: "(def q 1)", assertTrue
  clj contains: "(def q (+ q 2))", assertTrue
  Assert that: (clj contains: "(atom 1)") equals: false
  Assert that: (clj contains: "(reset! q") equals: false
]

Test cljReplStateInitializersUsePlainValues = [
  fileMain = """
    mut a = 1
    mut b = a + 1
    b
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)
          debug: false mode: CljEmitMode.Repl

  clj contains: "(def a 1)", assertTrue
  clj contains: "(def b (+ a 1))", assertTrue
  Assert that: (clj contains: "@a") equals: false
]

Test cljMutVarAsAtom = [
  fileMain = """
    mut c = 3
    c <- 4
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(def ^:private __niva_state_uninitialized (Object.))", assertTrue
  clj contains: "^:clj-reload/keep (def c (atom __niva_state_uninitialized))", assertTrue
  Assert that: (clj contains: "(defn __niva_entry! []\n  (let [c (atom 3)") equals: false
  clj contains: "(reset! c 3)", assertTrue
  clj contains: "(reset! c 4)", assertTrue
]

Test cljWhileTrueUnwrapsLambdas = [
  fileMain = """
    mut c = 3
    [c > 0] whileTrue: [c <- c - 1]
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(while ", assertTrue
  clj contains: "(> @c 0)", assertTrue
  clj contains: "(reset! c (- @c 1))", assertTrue
]

Test cljCoreCallGoesToCoreNs = [
  fileMain = """
    1 echo
  """
  result = ResolverHelper resolve: #{"main" fileMain} entryPoint: "main"
  clj = CljBackend fullFromIrModule: (result toIrModule)

  clj contains: "(niva.core/Any__echo 1)", assertTrue
  clj contains: "[niva.core]", assertTrue
]

