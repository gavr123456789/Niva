extend NivaType [
  on isCoreTypeNamed(typeName): String -> Bool = [
    nivaType = this unwrapNullable
    isCore = (nivaType name == typeName) && (nivaType pkgName == "core")
    ^ isCore
  ]
  on isNumericType -> Bool =
    | this unwrapNullable
    | IntegerT | FloatT | DoubleT => true
    |=> false
  on isStringType -> Bool = this isCoreTypeNamed: "String"
  on isBoolType -> Bool = this isCoreTypeNamed: "Bool"
  on isNullableType -> Bool = | this | NullableT => true |=> false
  on isNothingType -> Bool = | this | NothingT => true |=> false
]


extend String [
  on stripPkgPrefix(prefix): String -> String = [
    pre = prefix + "_"
    preLen = pre count
    len = this count
    ^ len >= preLen ifTrue: [
      (this slice: 0..(preLen - 1)) == pre ifTrue: [this slice: preLen..(len - 1)] ifFalse: [this]
    ] ifFalse: [this]
  ]

  on unquoteLiteral -> String = [
    len = this count
    ^ len >= 2 ifTrue: [
      (this drop: 1) dropLast: 1
    ] ifFalse: [
      this
    ]
  ]
  on unquoteRawLiteral -> String = [
    ^ this count > 6
      ifTrue: [this drop: 3, dropLast: 3]
      ifFalse: [this]
  ]

  // `$0` is the receiver/this, `$1` is the first argument, and so on.
  on bindApply0(argsValues): List(String) -> String = [
    template = this
    sb = StringBuilder new
    len = template count
    mut i = 0
      [i < len] whileTrue: [
        ch = template at: i
      isDollar = ch == '$'
      isDollar ifTrue: [
        hasArgument = ((i + 1) < len) && ((template at: (i + 1)) isDigit)
        hasArgument ifTrue: [
          mut digitStr = ""
          mut j = i + 1
          [((j < len) && ((template at: j) isDigit))] whileTrue: [
            digitStr <- digitStr + ((template at: j) toString)
            j <- j + 1
          ]
          idx = digitStr toInt
          isValid = ((idx >= 0) && (idx < (argsValues count)))
          isValid ifTrue: [
            sb append: (argsValues at: idx)
            ()
          ]
          isValid ifFalse: [
            sb append: "$" + digitStr
            ()
          ]
          i <- j
        ]
        hasArgument ifFalse: [
          sb append: "$"
          i <- i + 1
        ]
      ]
      isDollar ifFalse: [
        sb append: (ch toString)
        i <- i + 1
      ]
    ]
    ^ sb toString
  ]

]
