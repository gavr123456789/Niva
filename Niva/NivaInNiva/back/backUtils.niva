String operatorToString -> String =
  | this
  | "+" => "plus"
  | "-" => "minus"
  | "*" => "times"
  | "/" => "div"
  | "%" => "rem"
  | ".." => "rangeTo"
  | "==" => "equals"
  | "!=" => "notEquals"
  | ">" => "gt"
  | "<" => "lt"
  | ">=" => "gte"
  | "<=" => "lte"
  | "||" => "or"
  | "&&" => "and"
  |=> this

extend NivaType [
  on isCoreTypeNamed(typeName): String -> Bool = [
    nivaType = this unwrapNullable
    ^ | nivaType
      | TypeT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | UnitT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | IntegerT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | FloatT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | DoubleT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | BoolT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | CharT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | StringT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | AnyT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | NothingT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | ListT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | SetT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | MapT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | UnresolvedGenericT => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      | Unknown => [
        (nivaType name == typeName) && (nivaType pkgName == "core")
      ]
      |=> false
  ]
  on isNumericType -> Bool =
    | this unwrapNullable
    | IntegerT => true
    | FloatT => true
    | DoubleT => true
    |=> false
  on isStringType -> Bool = this isCoreTypeNamed: "String"
  on isBoolType -> Bool = this isCoreTypeNamed: "Bool"
  on isNullableType -> Bool = | this | NullableT => true |=> false
  on isNothingType -> Bool = | this | NothingT => true |=> false
]


type NumAndStr str: String num: Int

extend String [
  on unquoteLiteral -> String = [
    len = this count
    ^ len >= 2 ifTrue: [
      (this drop: 1) dropLast: 1
    ] ifFalse: [
      this
    ]
  ]
  on unquoteRawLiteral -> String = [
    ^ this count > 6
      ifTrue: [this drop: 3, dropLast: 3]
      ifFalse: [this]
  ]

  on escapedTemplateLiteralChunkAt(i): Int -> NumAndStr = [
    bs = '\\' toString
    dollar = '$' toString
    brace = '{' toString
    c = this at: i
    len = this count
      nextIsBrace = (i + 1 < len) ifTrue: [
        (this at: (i + 1)) == '{'
      ] ifFalse: [false]
    hasTemplateBrace = ((c == '$') && nextIsBrace)
    result = c == '\\'
      ifTrue: [NumAndStr str: "\\\\" num: 1]
      ifFalse: [
        c == '`'
          ifTrue: [NumAndStr str: "\\`" num: 1]
          ifFalse: [
            hasTemplateBrace
              ifTrue: [NumAndStr str: bs + dollar + brace num: 2]
              ifFalse: [NumAndStr str: c toString num: 1]
          ]
      ]
    ^ result
  ]
  on escapeForTemplateLiteral -> String = [
    sb = StringBuilder new
    mut i = 0
    len = this count

    [i < len] whileTrue: [
      chunk = this escapedTemplateLiteralChunkAt: i

      sb append: chunk str
      i <- i + chunk num
    ]

    ^ sb toString
  ]

  // `$0` is the receiver/this, `$1` is the first argument, and so on.
  on bindApply0(argsValues): List(String) -> String = [
    template = this
    sb = StringBuilder new
    len = template count
    mut i = 0
      [i < len] whileTrue: [
        ch = template at: i
      isDollar = ch == '$'
      isDollar ifTrue: [
        hasArgument = ((i + 1) < len) && ((template at: (i + 1)) isDigit)
        hasArgument ifTrue: [
          mut digitStr = ""
          mut j = i + 1
          [((j < len) && ((template at: j) isDigit))] whileTrue: [
            digitStr <- digitStr + ((template at: j) toString)
            j <- j + 1
          ]
          idx = digitStr toInt
          isValid = ((idx >= 0) && (idx < (argsValues count)))
          isValid ifTrue: [
            sb append: (argsValues at: idx)
            ()
          ]
          isValid ifFalse: [
            sb append: "$" + digitStr
            ()
          ]
          i <- j
        ]
        hasArgument ifFalse: [
          sb append: "$"
          i <- i + 1
        ]
      ]
      isDollar ifFalse: [
        sb append: (ch toString)
        i <- i + 1
      ]
    ]
    ^ sb toString
  ]

]
