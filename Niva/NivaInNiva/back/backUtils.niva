String operatorToString -> String =
  | this
  | "+" => "plus"
  | "-" => "minus"
  | "*" => "times"
  | "/" => "div"
  | "%" => "rem"
  | ".." => "rangeTo"
  | "==" => "equals"
  | "!=" => "notEquals"
  | ">" => "gt"
  | "<" => "lt"
  | ">=" => "gte"
  | "<=" => "lte"
  | "||" => "or"
  | "&&" => "and"
  |=> this

extend NivaType [
  on isCoreTypeNamed(name): String -> Bool = [
    base = .unwrapNullable
    ^ (base name == name) && (base pkgName == "core")
  ]
  on isNumericType -> Bool = [
    ^ (.isCoreTypeNamed: "Int") ||
      (.isCoreTypeNamed: "Double") ||
      (.isCoreTypeNamed: "Float")
  ]
  on isStringType -> Bool = .isCoreTypeNamed: "String"
  on isBoolType -> Bool = .isCoreTypeNamed: "Bool"
  on isNullableType -> Bool = | this | NullableT => true |=> false
  on isNothingType -> Bool = | this | NothingT => true |=> false
]


type NumAndStr str: String num: Int

extend String [
  on unquoteLiteral -> String = [
    len = this count
    ^ len >= 2 ifTrue: [
      (this drop: 1) dropLast: 1
    ] ifFalse: [
      this
    ]
  ]
  on unquoteRawLiteral -> String =
    | this count > 6
    | true => .drop: 3, dropLast: 3
    | false => this

  on escapedTemplateLiteralChunkAt(i): Int -> NumAndStr = [
    bs = '\\' toString
    dollar = '$' toString
    brace = '{' toString
    c = this at: i
    ^ | true
      | c == '\\' => [ NumAndStr str: "\\\\" num: 1 ]
      | c == '`'  => [ NumAndStr str: "\\`"  num: 1 ]
      | c == '$' && (i + 1 < .count) && ((.at: i + 1) == '{') => [ NumAndStr str: bs + dollar + brace num: 2 ]
      |=> NumAndStr str: c toString num: 1
  ]
  on escapeForTemplateLiteral -> String = [
    sb = StringBuilder new
    mut i = 0
    len = this count

    [i < len] whileTrue: [
      chunk = this escapedTemplateLiteralChunkAt: i

      sb append: chunk str
      i <- i + chunk num
    ]

    ^ sb toString
  ]

  on bindApply(argsValues): List(String) -> String = [
    template = this
    // validate placeholder count
    mut maxPlaceholder = 0
    mut i = 0
    template count repeat: [
        (template at: i) == '$' && ((i + 1) < (template count)) ifTrue: [
            nextChar = template at: (i + 1)
            nextChar isDigit ifTrue: [
                mut digitStr = nextChar toString
                mut j = i + 2
                [j < (template count) && ((template at: j) isDigit)] whileTrue: [
                    digitStr <- digitStr + ((template at: j) toString)
                    j <- j + 1
                ]
                placeholderNum = digitStr toInt
                placeholderNum > maxPlaceholder ifTrue: [
                    maxPlaceholder <- placeholderNum
                ]
            ]
        ]
        i <- i + 1
    ]

    argsCount = argsValues count
    maxPlaceholder > argsCount ifTrue: [
        TO DO: "Bind emit: template contains placeholder $" + (maxPlaceholder toString) + " but only " + (argsCount toString) + " arguments provided"
    ]

    sb = StringBuilder new
    len = template count
    i <- 0
    [i < len] whileTrue: [
        ch = template at: i
        ch == '$' ifTrue: [
            (i + 1) < len && ((template at: (i + 1)) isDigit) ifTrue: [
                mut digitStr = ""
                mut j = i + 1
                [j < len && ((template at: j) isDigit)] whileTrue: [
                    digitStr <- digitStr + ((template at: j) toString)
                    j <- j + 1
                ]
                placeholderNum = digitStr toInt
                isValid = (placeholderNum >= 1) && (placeholderNum <= argsCount)
                isValid
                  ifTrue: [sb append: (argsValues at: (placeholderNum - 1))]
                  ifFalse: [sb append: "$" + digitStr]
                i <- j
            ] ifFalse: [
                sb append: "$"
                i <- i + 1
            ]
        ] ifFalse: [
            sb append: (ch toString)
            i <- i + 1
        ]
    ]
    ^ sb toString
  ]

  // Like bindApply but 0-based: $0 -> argsValues[0] (receiver/this), $1 -> arg1, ...
  // Used by inline `Bind emit:` bodies in the new bind design.
  on bindApply0(argsValues): List(String) -> String = [
    template = this
    sb = StringBuilder new
    len = template count
    mut i = 0
    [i < len] whileTrue: [
      ch = template at: i
      ch == '$' ifTrue: [
        (i + 1) < len && ((template at: (i + 1)) isDigit) ifTrue: [
          mut digitStr = ""
          mut j = i + 1
          [j < len && ((template at: j) isDigit)] whileTrue: [
            digitStr <- digitStr + ((template at: j) toString)
            j <- j + 1
          ]
          idx = digitStr toInt
          isValid = (idx >= 0) && (idx < (argsValues count))
          isValid
            ifTrue: [sb append: (argsValues at: idx)]
            ifFalse: [sb append: "$" + digitStr]
          i <- j
        ] ifFalse: [
          sb append: "$"
          i <- i + 1
        ]
      ] ifFalse: [
        sb append: (ch toString)
        i <- i + 1
      ]
    ]
    ^ sb toString
  ]

]

String

String
