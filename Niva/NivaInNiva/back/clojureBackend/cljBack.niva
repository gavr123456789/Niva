type CljBackend

type CljContext
  imports: mut Set(String)
  debug: Bool
  debugEntries: mut List(CljDebugEntry)

type CljDebugEntry
  generatedLine: Int
  generatedEndLine: Int
  sourceFile: String
  sourceLine: Int
  method: String

constructor CljContext newDebug(debug): Bool -> CljContext =
  CljContext imports: #()! debug: debug debugEntries: {}!

CljContext addImport(name): String -> Unit = [
  imports add: name
]

String cljDebugQuoted -> String =
  "\"" + (.replace: "\\" with: "\\\\", replace: "\"" with: "\\\"") + "\""

CljContext addDebugEntry(generatedLine): Int endLine: Int token: Token method: String -> Unit = [
  debug ifTrue: [
    file = token file path
    file != "" ifTrue: [
      debugEntries add: (CljDebugEntry :generatedLine generatedEndLine: endLine sourceFile: file sourceLine: token line :method)
    ]
  ]
]

String cljLineCount -> Int = [
  mut result = 1
  mut i = 0
  [i < this count] whileTrue: [
    (this at: i) == '\n', ifTrue: [result <- result + 1]
    i <- i + 1
  ]
  ^ result
]

CljDebugEntry toCljSourceMapEntries(bodyLineOffset): Int -> List(String) = [
  entries::mut List(String) = {}!
  mut line = generatedLine
  [line <= generatedEndLine] whileTrue: [
    entries add: ("[\"main.clj\" " + (line + bodyLineOffset) toString + "] [" +
      (sourceFile cljDebugQuoted) + " " + sourceLine toString + " " + (method cljDebugQuoted) + "]")
    line <- line + 1
  ]
  ^ entries toList
]

// tracks which locals were declared as mut (so refs to them emit @name)
type CljScope mutLocals: mut Set(String)

constructor CljScope new = CljScope mutLocals: #()!

CljScope copy -> CljScope = [
  s = CljScope new
  s mutLocals addAll: mutLocals
  ^ s
]

CljScope isMut(name): String -> Bool = mutLocals contains: name

// single `(let [name value ...])` binding pair
type CljBinding name: String value: String

extend String [
  on cljSanitizeIdent -> String =
        .replace: ".." with: "rangeTo"
        ,replace: "?" with: "_QM"
        //,replace: "==" with: "equals"
        //,replace: "!=" with: "notEquals"
        //,replace: ">=" with: "gte"
        //,replace: "<=" with: "lte"
        //,replace: ">" with: "gt"
        //,replace: "<" with: "lt"
        //,replace: "||" with: "or"
        //,replace: "&&" with: "and"
        //,replace: "+" with: "plus"
        //,replace: "-" with: "minus"
        //,replace: "*" with: "times"
        //,replace: "/" with: "div"
        //,replace: "%" with: "rem"
        //,replace: "." with: "_"
        //,replace: "(" with: "_"
        //,replace: ")" with: "_"
        //,replace: "," with: "_"
        //,replace: " " with: "_"

]

// mangled function name derived directly from IR
IrFunction cljFuncNameFromIr -> String = .id cljFuncIdToName

// The IR-issued function id has the shape "pkg.recv.name" (see irIds.niva).
// This mirrors it as "pkg__recv__name" so we can derive the same name from
// either an IrFunction (at defn site) or a bare funcId string (at call site)
// without needing a symbol table.
// pkg.recv.name -> pkg__recv__name
String cljFuncIdToName -> String =
  .split: ".", joinWith: "__" transform: [it cljSanitizeIdent]


extend String [
  // `clojure.string.bind` -> `clojure/string`
  on cljBindNamespace -> String = .replace: "/" with: "."

  on stripCljPkgPrefix(prefix): String -> String = [
    pre = prefix + "_"
    preLen = pre count
    ^ (.count >= preLen && ((.slice: 0..<preLen) == pre))
        ifTrue: [.slice: preLen..< .count]
        ifFalse: [this]
  ]

  on cljHasPrefix(prefix): String -> Bool = [
    prefixLen = prefix count
    ^ (.count >= prefixLen) && ((.slice: 0..<prefixLen) == prefix)
  ]

  on cljNormalizeTypeId -> String = [
    hasGeneric = .contains: "__"
    ^ hasGeneric ifTrue: [.substringBefore: "__"] ifFalse: [this]
  ]

  on cljPadTo(width): Int -> String =
    this + (" " repeat: width - this count)

]

IrTypeRef coreFuncNameFromCljCall(name): String -> String = [
  baseId = typeId cljNormalizeTypeId
  recvBase = baseId stripCljPkgPrefix: "core"
//   ^ (recvBase cljSanitizeIdent) + "__" + (name cljSanitizeIdent)

  // generics monomorphizes in nin, but Any__echo has a single impl, not Int__echo Person__echo for every type
  // this should be solved by lazily generating ?__echo methods for everything or something elce
  ^ name == "echo"
      ifTrue: ["Any__echo"]
      ifFalse: [(recvBase cljSanitizeIdent) + "__" + (name cljSanitizeIdent)]
]

// ---------------------------------------------------------------------------
// type mapping (no static types in Clojure but we still need type-ids for match)
// ---------------------------------------------------------------------------

IrTypeRef isCljUnitType -> Bool =
  (kind == IrTypeRefKind.Builtin) && (typeId cljNormalizeTypeId == "core_Unit")

IrTypeRef cljTypeName -> String = [
  ^ typeId cljNormalizeTypeId cljSanitizeIdent
]

// ---------------------------------------------------------------------------
// operator translation for IrOpBin
// ---------------------------------------------------------------------------
String cljOperator -> String =
  | this
  | "==" => "="
  | "!=" => "not="
  | "&&" => "and"
  | "||" => "or"
  | "%" => "rem"
  |=> this

// ---------------------------------------------------------------------------
// literals
// ---------------------------------------------------------------------------
String toCljRawStringLiteral -> String = [
  content = (this drop: 3) dropLast: 3
  sb = StringBuilder new
  mut i = 0
  [i < content count] whileTrue: [
    c = content at: i
    | c
    | '\\' => [sb append: "\\\\"]
    | '"'  => [sb append: "\\\""]
    | '\n' => [sb append: "\\n"]
    | '\r' => [sb append: "\\r"]
    | '\t' => [sb append: "\\t"]
    |=> [sb append: c toString]
    i <- i inc
  ]
  ^ "\"" + sb toString + "\""
]

IrLiteral toCljLiteral -> String =
  | kind
  | IrLiteralKind.Null   => "nil"
  | IrLiteralKind.Unit   => ":unit"
  | IrLiteralKind.Bool   => lexeme
  | IrLiteralKind.Int    => lexeme
  | IrLiteralKind.Double => lexeme
  | IrLiteralKind.Float  => lexeme endsWith: "f",
                                  ifTrue:  [lexeme dropLast: 1]
                                 ifFalse: [lexeme]
  | IrLiteralKind.Char   => lexeme toCljCharLiteral
  | IrLiteralKind.String    => lexeme
  | IrLiteralKind.RawString => lexeme toCljRawStringLiteral
  | IrLiteralKind.Atom   => ":" + lexeme

String toCljCharLiteral -> String = [
  content = (this drop: 1) dropLast: 1
  ^ | content
    | "\\n"  => "\\newline"
    | "\\t"  => "\\tab"
    | "\\r"  => "\\return"
    | "\\b"  => "\\backspace"
    | "\\f"  => "\\formfeed"
    | " "    => "\\space"
    | "\\\\" => "\\\\"
    |=> "\\" + content
]

Int cljIndent -> String = [
  sb = StringBuilder new
  mut i = 0
  [i < this] whileTrue: [
    sb append: "  "
    i <- i inc
  ]
  ^ sb toString
]

StringBuilder appendCljIndent(level): Int line: String -> Unit = [
  this append: (level cljIndent)
  this appendLine: line
]
