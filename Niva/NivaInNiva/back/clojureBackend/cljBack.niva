type CljBackend

type CljOutput
  files: Map(String, String)
  entryNamespace: String
  manifest: CljManifest
  target: CljTarget

CljOutput legacyMainShim -> String = [
  genClass = target == CljTarget.Jvm ifTrue: [" (:gen-class)"] ifFalse: [""]
  ^ "(ns main" + genClass + " (:require [" + entryNamespace + "]))\n" +
    "(defn -main [& args]\n  (apply " + entryNamespace + "/-main args))\n"
]

enum CljEmitMode = Program | Repl | HotReload
enum CljTarget = Jvm | Bb

type CljContext
  imports: mut Set(String)
  stateNames: mut Set(String)
  debug: Bool
  hotReload: Bool
  debugEntries: mut Map(Int, CljDebugEntry)
  currentPackage: String
  currentNamespace: String
  // `^` that can't be put in tail position, reported once emitting is done
  unsupportedReturns: mut Set(String)

type CljDebugEntry
  generatedLine: Int
  generatedEndLine: Int
  sourceFile: String
  sourceLine: Int
  method: String

constructor CljContext newDebug(debug): Bool -> CljContext =
  CljContext newDebug: debug imports: #() pkg: "" namespace: "" hotReload: false

constructor CljContext newDebug(debug): Bool imports(imports): Set(String)
    pkg(pkg): String hotReload(hotReload): Bool -> CljContext =
  CljContext newDebug: debug imports: imports pkg: pkg namespace: "" hotReload: hotReload

constructor CljContext newDebug(debug): Bool imports(imports): Set(String)
    pkg(pkg): String namespace(namespace): String hotReload(hotReload): Bool -> CljContext =
  CljContext imports: (imports toMutableSet) stateNames: #()! :debug
    :hotReload debugEntries: #{}! currentPackage: pkg currentNamespace: namespace
    unsupportedReturns: #()!

constructor CljContext newDebug(debug): Bool imports(imports): Set(String)
    pkg(pkg): String -> CljContext =
  CljContext newDebug: debug :imports :pkg namespace: "" hotReload: false

CljContext addImport(name): String -> Unit = [
  imports add: name
]

CljContext addStateName(name): String -> Unit = [
  stateNames add: name
]

CljContext isStateName(name): String -> Bool = [
  ^ stateNames contains: name
]

CljContext addUnsupportedReturn(token): Token -> Unit = [
  unsupportedReturns add: token toPosition +
    ": the Clojure backend can't return from here yet. `^` only works at the end of a method," +
    " or at the end of a branch that ends the method"
]

String cljDebugQuoted -> String =
  "\"" + (this replace: "\\" with: "\\\\", replace: "\"" with: "\\\"") + "\""

CljContext addDebugEntry(generatedLine): Int endLine: Int token: Token method: String -> Unit = [
  file = token file path
  (debug && (file != "")) ifTrue: [
    this debugEntries at: generatedLine put: (CljDebugEntry :generatedLine generatedEndLine: endLine sourceFile: file sourceLine: token line :method)
  ]
]

CljContext orderedDebugEntries -> List(CljDebugEntry) = [
  (this debugEntries values toList) sortedBy: [it generatedLine]
]

String cljLineCount -> Int = [
  mut result = 1
  mut i = 0
  [i < this count] whileTrue: [
    (this at: i) == '\n', ifTrue: [result <- result + 1]
    i <- i + 1
  ]
  ^ result
]

CljDebugEntry toCljSourceMapEntries(bodyLineOffset): Int -> List(String) = [
  entries::mut List(String) = {}!
  mut line = generatedLine
  [line <= generatedEndLine] whileTrue: [
    entry = "[\"main.clj\" " + (line + bodyLineOffset) toString + "] [" +
      (sourceFile cljDebugQuoted) + " " + sourceLine toString + " " + (method cljDebugQuoted) + "]"
    entries add: entry
    line <- line + 1
  ]
  ^ entries toList
]

// tracks which locals were declared as mut (so refs to them emit @name)
type CljScope mutLocals: mut Set(String)

constructor CljScope new = CljScope mutLocals: #()!

CljScope copy -> CljScope = [
  s = CljScope new
  s mutLocals addAll: mutLocals
  ^ s
]

CljScope isMut(name): String -> Bool = [
  ^ this mutLocals contains: name
]

// single `(let [name value ...])` binding pair
type CljBinding name: String value: String

extend String [
  on cljSanitizeIdent -> String =
        this replace: "..<" with: "rangeUntil"
        ,replace: ".." with: "rangeTo"
        ,replace: "?" with: "_QM"

  // a type's name, without its package's dots, since Clojure reads a dotted name as a class
  on cljTypeIdent -> String = this cljSanitizeIdent replace: "." with: "_"

  on cljGeneratedNamespace -> String = "niva.generated." + this

  // the Java package a generated namespace puts its records in
  on cljGeneratedClassPackage -> String = this cljGeneratedNamespace replace: "-" with: "_"

  on cljGeneratedPath -> String =
    // clojure translates - in files into _
    (this cljGeneratedNamespace replace: "." with: "/",
      replace: "-" with: "_") + ".clj"

]

IrPackage cljGeneratedNamespace -> String = this name cljGeneratedNamespace

IrPackage cljGeneratedPath -> String = this name cljGeneratedPath

// mangled function name derived directly from IR
IrFunction cljFuncNameFromIr -> String = this id cljFuncIdToName

// convert ir function id to clojure name
// pkg.recv.name -> pkg__recv__name
String cljFuncIdToName -> String =
  this split: ".", joinWith: "__" transform: [it cljSanitizeIdent]


extend String [
  on cljNamespace -> String = this replace: "/" with: "."

  on cljNormalizeTypeId -> String =
    (this contains: "__") ifTrue: [this substringBefore: "__"] ifFalse: [this]

  on cljPadTo(width): Int -> String =
    this + (" " repeat: width - this count)

]

IrTypeRef coreFuncNameFromCljCall(name): String forMut(isMutable): Bool -> String = [
  baseId = this typeId cljNormalizeTypeId
  recvBase = baseId stripPkgPrefix: "core"

  // generics monomorphizes in nin, but Any__echo has a single impl, not Int__echo Person__echo for every type
  // this should be solved by lazily generating ?__echo methods for everything or something elce
  ^ name == "echo"
      ifTrue: ["Any__echo"]
      ifFalse: [
        methodName = (isMutable ifTrue: ["mut_"] ifFalse: [""]) + (name cljSanitizeIdent)
        (recvBase cljSanitizeIdent) + "__" + methodName
      ]
]

// type mapping
IrTypeRef isCljUnitType -> Bool =
  (this kind == IrTypeRefKind.Builtin) && (this typeId cljNormalizeTypeId == "core_Unit")

IrTypeRef cljTypeName -> String = [
  baseId = this typeId cljNormalizeTypeId
  // Error is an abstract core type the emitter replaces it for
  // Error throw \ throwWithMsg calls
  // TODO
  ^ baseId == "core_Error"
      ifTrue: [":niva.core/Error"]
      ifFalse: [baseId cljTypeIdent]
]

// declared in another package, so named with its namespace
IrTypeRef cljCanQualify(ctx): CljContext -> Bool = [
  owner = this ownerPkg
  ^ (ctx currentPackage != "") && (owner != "") &&
    (owner != "core") && (owner != ctx currentPackage)
]

// a record's class, which another namespace names with `.`, as a Java class
IrTypeRef cljQualifiedTypeName(ctx): CljContext -> String = [
  baseName = this cljTypeName
  ^ (this cljCanQualify: ctx)
    ifTrue: [(this ownerPkg cljGeneratedClassPackage) + "." + baseName]
    ifFalse: [baseName]
]

// a var named after the type, a constructor or an enum value, which another namespace names with `/`
IrTypeRef cljQualifiedVarName(name): String ctx: CljContext -> String =
  (this cljCanQualify: ctx)
    ifTrue: [(this ownerPkg cljGeneratedNamespace) + "/" + name]
    ifFalse: [name]

// Primitive function hints are deliberately narrower than Clojure's complete
// set of primitive aliases. Clojure only supports long/double primitive
// signatures for functions, and nullable/mutable values cannot use them.
IrTypeRef cljIsPrimitiveNumeric -> Bool = [
  baseId = this typeId cljNormalizeTypeId
  ^ (baseId == "core_Int") || (baseId == "core_Long") || (baseId == "core_Double")
]

IrTypeRef cljPrimitiveFunctionHint -> String = [
  (this nullable) || (this isMut) ifTrue: [""] ifFalse: [
    baseId = this typeId cljNormalizeTypeId
    | baseId
    | "core_Int" | "core_Long" => "long"
    | "core_Double" => "double"
    |=> ""
  ]
]

// A class hint names the generated Java class, not the Clojure value shape.
// Collection hints stay out of the generic path because List/Set/Map are
// polymorphic Clojure values and only need a class hint at a Java boundary.
IrTypeRef cljClassHint(ctx): CljContext -> String = [
  this isMut ifTrue: [""] ifFalse: [
    baseId = this typeId cljNormalizeTypeId
    | this kind
    | IrTypeRefKind.Builtin => [
        | baseId
        | "core_String" => "String"
        | "core_StringBuilder" => "StringBuilder"
        |=> ""
      ]
    | IrTypeRefKind.Function => "clojure.lang.IFn"
    | IrTypeRefKind.Custom => [
        owner = this ownerPkg
        ((owner == "") || (owner == "core")) ifTrue: [""] ifFalse: [
          classNamespace = ctx currentPackage == ""
            ifTrue: [ctx currentNamespace]
            ifFalse: [owner cljGeneratedNamespace]
          classNamespace + "." + (this cljTypeName)
        ]
      ]
    |=> ""
  ]
]

IrFunction cljPrimitiveHintsAllowed -> Bool = [
  unsafeArg = args any: [arg ->
    t = arg typeRef
    (t cljIsPrimitiveNumeric) && ((t nullable) || (t isMut))
  ]
  unsafeReturn = (returnType cljIsPrimitiveNumeric) &&
    ((returnType nullable) || (returnType isMut))
  hasPrimitiveType = (returnType cljPrimitiveFunctionHint != "") ||
    (args any: [it typeRef cljPrimitiveFunctionHint != ""])
  ^ (args count <= 4) && hasPrimitiveType &&
    (unsafeArg not) && (unsafeReturn not)
]

// enum atoms use the generated enum Var instead of a plain keyword
IrLiteralExpr cljLiteralExpr(ctx): CljContext -> String = [
  exprLiteral = this literal
  exprType = this typeRef
  isEnumAtom = (exprLiteral kind == IrLiteralKind.Atom) &&
    (exprType kind == IrTypeRefKind.Custom) &&
    (exprType ownerPkg != "")
  ^ isEnumAtom ifTrue: [
    valueName = exprType cljTypeName + "_" + (exprLiteral lexeme cljSanitizeIdent)
    exprType cljQualifiedVarName: valueName :ctx
  ] ifFalse: [
    exprLiteral toCljLiteral
  ]
]

// ---------------------------------------------------------------------------
// operator translation for IrOpBin
// ---------------------------------------------------------------------------
String cljOperator -> String =
  | this
  | "==" => "="
  | "!=" => "not="
  | "&&" => "and"
  | "||" => "or"
  | "%" => "rem"
  |=> this

// ---------------------------------------------------------------------------
// literals
// ---------------------------------------------------------------------------
String toCljRawStringLiteral -> String = [
  content = (this drop: 3) dropLast: 3
  sb = StringBuilder new
  mut i = 0
  [i < content count] whileTrue: [
    c = content at: i
    | c
    | '\\' => [sb append: "\\\\"]
    | '"'  => [sb append: "\\\""]
    | '\n' => [sb append: "\\n"]
    | '\r' => [sb append: "\\r"]
    | '\t' => [sb append: "\\t"]
    |=> [sb append: c toString]
    i <- i inc
  ]
  ^ "\"" + sb toString + "\""
]

IrLiteral toCljLiteral -> String = [
    literalKind = this kind
    literalText = this lexeme
    ^ | literalKind
      | IrLiteralKind.Null => "nil"
      | IrLiteralKind.Unit => ":unit"
      | IrLiteralKind.Bool | IrLiteralKind.Int | IrLiteralKind.Double | IrLiteralKind.String => literalText
      | IrLiteralKind.Float => literalText endsWith: "f", ifTrue: [literalText dropLast: 1] ifFalse: [literalText]
      | IrLiteralKind.Char => literalText toCljCharLiteral
      | IrLiteralKind.RawString => literalText toCljRawStringLiteral
      |=> ":" + literalText
  ]

String toCljCharLiteral -> String = [
  content = (this drop: 1) dropLast: 1
  ^ | content
    | "\\n"  => "\\newline"
    | "\\t"  => "\\tab"
    | "\\r"  => "\\return"
    | "\\b"  => "\\backspace"
    | "\\f"  => "\\formfeed"
    | " "    => "\\space"
    | "\\\\" => "\\\\"
    |=> "\\" + content
]

Int cljIndent -> String = "  " repeat: this

StringBuilder appendCljIndent(level): Int line: String -> Unit = [
  this append: (level cljIndent)
  this appendLine: line
  ()
]
