// types    -> records
// unions   -> one record per branch with type based matching
// enums    -> separate keywords
// fns      -> defn
// values that can change use one cell
// blocks   -> one let with unused bindings for side effects
// return   -> only in tail position, anywhere else a compile error
// errors   -> exceptions
// field changes replace the value in that cell
extend IrExpr [
  on toCljExpr(ctx): CljContext scope: CljScope -> String =
    | this
    | IrLiteralExpr => this cljLiteralExpr: ctx
    | IrVarRef      => [
        safe = name cljSanitizeIdent
        (scope isMut: name) ifTrue: ["@" + safe] ifFalse: [safe]
      ]
    | IrThisRef  => "this"
    | IrFieldGet => [
        recv = receiver toCljSnapshotExpr: ctx :scope
        "(:" + (field cljSanitizeIdent) + " " + recv + ")"
      ]
    | IrTypeRefExpr => ref cljQualifiedTypeName: ctx
    | IrOpBin => [
        l = left  toCljExpr: ctx :scope
        r = right toCljExpr: ctx :scope
        // TODO make a better\cheaper way to check for default times
        isStr = (left cljExprTypeRef typeId cljNormalizeTypeId) == "core_String"
        isStr
          ifTrue: [
            | true
            | (op == "+") => "(str $l $r)"
            | (op == "<") || (op == ">") || (op == "<=") || (op == ">=") => "($op (compare $l $r) 0)"
            |=> "(" + (op cljOperator) + " $l $r)"
          ]
          ifFalse: ["(" + (op cljOperator) + " $l $r)"]
      ]
    | IrCall     => this callToCljExpr:  ctx :scope
    | IrLambda   => this lambdaToCljExpr: ctx :scope
    | IrBlockExpr => block toCljBlockExpr: ctx :scope
    | IrMatchExpr => this matchToCljExpr: ctx :scope
    | IrNewExpr   => [
        argsLocal = this args
        argsStr = argsLocal isNotEmpty
          ifTrue: [" " + (argsLocal joinWith: " " transform: [it toCljExpr: ctx :scope])]
          ifFalse: [""]
        constructorBindMaybe = this constructorBind
        constructorOutput = | constructorBindMaybe
          | null => ""
          |=> [
            constructorBindValue = constructorBindMaybe
            | constructorBindValue
            | IrConstructorBindEmit => [
              constructorBindValue backend == "clojure" ifTrue: [
                boundExpr = constructorBindValue template bindApply0: (argsLocal map: [it toCljExpr: ctx :scope])
                (this typeRef) toCljCellExpr: boundExpr
              ] ifFalse: [""]
            ]
            |=> ""
          ]
        constructorName = "->" + (this typeId cljNormalizeTypeId cljSanitizeIdent)
        owner = (this typeRef) ownerPkg
        canQualify = (ctx currentPackage != "") && (owner != "") &&
          (owner != "core") && (owner != ctx currentPackage)
        name = canQualify
          ifTrue: [(owner cljGeneratedNamespace) + "/" + constructorName]
          ifFalse: [constructorName]
        recordExpr = "(" + name + argsStr + ")"
        recordOutput = (this typeRef isMut) ifTrue: ["(atom " + recordExpr + ")"] ifFalse: [recordExpr]
        constructorOutput != "" ifTrue: [constructorOutput] ifFalse: [recordOutput]
      ]
    | IrCollectionLiteral => this collectionToCljExpr: ctx :scope

]

IrTypeRef isCljCollectionType -> Bool =
  (this kind == IrTypeRefKind.Builtin) &&
    (((this typeId cljNormalizeTypeId) == "core_List") ||
     ((this typeId cljNormalizeTypeId) == "core_Set") ||
     ((this typeId cljNormalizeTypeId) == "core_Map"))

// same collection kind on both sides of a call
IrTypeRef cljSameCollectionTypeAs(other): IrTypeRef -> Bool =
  (this isCljCollectionType) && (other isCljCollectionType) && (this typeId == other typeId)

// same record kind on both sides of a call
IrTypeRef cljSameRecordTypeAs(other): IrTypeRef -> Bool =
  (this kind == IrTypeRefKind.Custom) && (other kind == IrTypeRefKind.Custom) && (this typeId == other typeId)

IrExpr toCljCollectionCellExpr(ctx): CljContext scope: CljScope -> String = [
  this toCljExpr: ctx :scope
]

IrTypeRef toCljCellExpr(expr): String -> String = [
  this isMut ifTrue: ["(atom " + expr + ")"] ifFalse: [expr]
]

IrExpr toCljCollectionExpectedExpr(expected): IrTypeRef
    ctx(ctx): CljContext scope(scope): CljScope -> String = [
  cell = this toCljCollectionCellExpr: ctx :scope
  expected isMut ifTrue: [cell] ifFalse: ["(deref " + cell + ")"]
]

IrExpr toCljSnapshotExpr(ctx): CljContext scope: CljScope -> String = [
  exprType = this cljExprTypeRef
  (exprType isMut) && (exprType isCljCollectionType)
    ifTrue: ["(deref " + (this toCljCollectionCellExpr: ctx :scope) + ")"]
    ifFalse: [
      raw = this toCljExpr: ctx :scope
      isMutableRecord = (exprType isMut) && (exprType kind == IrTypeRefKind.Custom)
      isMutableRecord ifTrue: ["(deref " + raw + ")"] ifFalse: [raw]
    ]
]

// pass a plain value when the caller expects one
// keep the cell when the caller can change the value
IrExpr toCljExprForExpected(expected): IrTypeRef ctx(ctx): CljContext
    scope(scope): CljScope -> String = [
  raw = this toCljExpr: ctx :scope
  sourceType = this cljExprTypeRef
  sourceIsMut = sourceType isMut
  expectedIsMut = expected isMut
  sameCollection = sourceType cljSameCollectionTypeAs: expected
  sameRecord = sourceType cljSameRecordTypeAs: expected
  keepCell = sourceIsMut && (sourceType isCljCollectionType)
  needsCell = (sourceIsMut not) && expectedIsMut && (sameCollection || sameRecord)
  needsPlainValue = sourceIsMut && (expectedIsMut not) && sameRecord
  ^ keepCell ifTrue: [
    this toCljCollectionExpectedExpr: expected :ctx :scope
  ] ifFalse: [
    needsCell ifTrue: ["(atom " + raw + ")"] ifFalse: [
      needsPlainValue ifTrue: ["(deref " + raw + ")"] ifFalse: [raw]
    ]
  ]
]

// bind emit expressions are inlined at the call site
// declarations from <namespace>.bind.niva already store the namespace in irbind
IrCall tryCljBindExpr(ctx): CljContext scope: CljScope -> String = [
  r = this receiverType
  receiverTypeId = | r
    | null => ""
    |=> [
      receiverTypeValue = r
      receiverTypeValue typeId
    ]
  msgNameLocal = this msgNameOrEmpty
  // calls with no args are never bind emits so their args stay unread
  isBindEmitCall = (receiverTypeId == "core_Bind") &&
    (msgNameLocal == "emit") && (this args isNotEmpty)
  isBindEmitCall ifTrue: [
    templateExpr = this args first
    templateMaybe = templateExpr irStringLiteralValue
    | templateMaybe
      | null => templateExpr toCljExpr: ctx :scope
      |=> templateMaybe
  ] ifFalse: [""]
]

IrCall cljArgValues(ctx): CljContext scope: CljScope -> List(String) = [
  values::mut List(String) = {}!
  this args forEachIndexed: [i, arg ->
    value = i < (this paramTypes count)
      ifTrue: [arg toCljExprForExpected: ((this paramTypes) at: i) :ctx :scope]
      ifFalse: [arg toCljExpr: ctx :scope]
    values add: value
    ()
  ]
  ^ values toList
]

IrCall callToCljExpr(ctx): CljContext scope: CljScope -> String = [
  tryOutput = this cljTryOutput: ctx :scope
  tryOutput != "" ifTrue: [tryOutput] ifFalse: [
      bindOutput = this cljAttachedBindOutput: ctx :scope
      bindOutput != "" ifTrue: [bindOutput] ifFalse: [
          inlineOutput = this tryCljBindExpr: ctx :scope
          inlineOutput != "" ifTrue: [inlineOutput] ifFalse: [
              specialOutput = this cljSpecialCallOutput: ctx :scope
              specialOutput != "" ifTrue: [specialOutput] ifFalse: [
                this cljOrdinaryCallOutput: ctx :scope
              ]
            ]
        ]
    ]
]

IrCall cljTryOutput(ctx): CljContext scope: CljScope -> String = [
  msgNameLocal = this msgNameOrEmpty
  (msgNameLocal == "try") || (msgNameLocal == "orPANIC") ifTrue: [
    input = this args first
    inputStr = input toCljExpr: ctx :scope
    (input cljExprTypeRef nullable)
      ifTrue: ["(let [__tryValue " + inputStr + "] (if (nil? __tryValue) (throw (ex-info \"try on null\" {})) __tryValue))"]
      ifFalse: [inputStr]
  ] ifFalse: [""]
]

IrCall cljAttachedBindOutput(ctx): CljContext scope: CljScope -> String = [
  bindMaybe = this bind
  | bindMaybe
    | null => ""
    |=> [
      bindValue = bindMaybe
      | bindValue
      | IrBindByName => [
          argsStr = (this cljArgValues: ctx :scope) joinWith: " "
          namespace = bindValue pkg cljNamespace
          namespace != "" ifTrue: [ctx addImport: namespace]
          argsPart = argsStr == "" ifTrue: [""] ifFalse: [" " + argsStr]
          "(" + namespace + "/" + (bindValue name cljSanitizeIdent) + argsPart + ")"
        ]
      | IrBindEmit => [
          bindValue imports forEach: [ctx addImport: (it cljNamespace)]
          emitArgVals = this cljArgValues: ctx :scope
          bindValue template bindApply0: emitArgVals
        ]
      |=> ""
    ]
]

IrCall cljSpecialCallOutput(ctx): CljContext scope: CljScope -> String = [
  funcIdMaybe = this funcId
  receiverTypeMaybe = this receiverType
  receiverTypeId = | receiverTypeMaybe
    | null => ""
    |=> [
      receiverTypeValue = receiverTypeMaybe
      receiverTypeValue typeId
    ]
  msgNameLocal = this msgNameOrEmpty
  funcIdLocal = funcIdMaybe orElse: ""
  receiverIsCompiler = receiverTypeId contains: "Compiler"
  functionIsCompiler = funcIdLocal contains: "Compiler"
  compilerCliArgsCall = (msgNameLocal == "cliArgs") && (receiverIsCompiler || functionIsCompiler)
  jvmHostCall = funcIdLocal contains: "JvmReloadHost"
  argsStr = (this cljArgValues: ctx :scope) joinWith: " "
  argsPart = argsStr == "" ifTrue: [""] ifFalse: [" " + argsStr]
  compilerCliArgsCall ifTrue: [
    "(or (some-> (System/getProperty \"niva.cli.args\") read-string vec) [])"
  ] ifFalse: [
    jvmHostCall ifTrue: [
      | msgNameLocal
      | "start" => "((requiring-resolve 'niva.hot-reload.host/start!)" + argsPart + ")"
      | "reloadChanged" => "((requiring-resolve 'niva.hot-reload.host/reload-changed!))"
      |=> ""
    ] ifFalse: [""]
  ]
]

IrCall cljOrdinaryCallOutput(ctx): CljContext scope: CljScope -> String = [
  argsStr = (this cljArgValues: ctx :scope) joinWith: " "
  argsPart = argsStr == "" ifTrue: [""] ifFalse: [" " + argsStr]
  funcIdMaybe = this funcId
  | funcIdMaybe
  | null => [
      calleeMaybe = this callee
      | calleeMaybe
      | null => ""
      |=> [
        calleeValue = calleeMaybe
        calleeExpr = calleeValue toCljExpr: ctx :scope
        "(" + calleeExpr + argsPart + ")"
      ]
    ]
  |=> [
      funcIdValue = funcIdMaybe
      declPkgMaybe = this declPkg
      declPkgLocal = declPkgMaybe orElse: ""
      declPkgLocal == "core" ifTrue: [
        ctx addImport: "niva.core"
        msgNameLocal = this msgNameOrEmpty
        receiverMaybe = this receiverType
        mutReceiver = (this paramTypes) isNotEmpty && ((this paramTypes) first isMut)
        coreFn = | receiverMaybe
          | null => ""
          |=> [
            receiverValue = receiverMaybe
            receiverValue coreFuncNameFromCljCall: msgNameLocal forMut: mutReceiver
          ]
        "(niva.core/" + coreFn + argsPart + ")"
      ] ifFalse: [
        fn = funcIdValue cljFuncIdToName
        isCrossPackage = (ctx currentPackage != "") &&
          (declPkgLocal != ctx currentPackage)
        callName = isCrossPackage
          ifTrue: [(declPkgLocal cljGeneratedNamespace) + "/" + fn]
          ifFalse: [fn]
        "(" + callName + argsPart + ")"
      ]
    ]
]

// ---------------------------------------------------------------------------
// IrLambda
// ---------------------------------------------------------------------------

IrExpr lambdaToCljExpr(ctx): CljContext scope: CljScope -> String = [
  | this | IrLambda => [
    argsStr = (this args) joinWith: " " transform: [it name cljSanitizeIdent]

    innerScope = scope copy
    // lambda arg mutability is not tracked in IrArg, treat all as immutable locals

    bodyStr = this body toCljBlockBody: ctx scope: innerScope

    ^ "(fn [" + argsStr + "] " + bodyStr + ")"
  ] |=> ""
]

// ---------------------------------------------------------------------------
// IrCollectionLiteral
// ---------------------------------------------------------------------------

IrCollectionLiteral collectionToCljExpr(ctx): CljContext scope: CljScope -> String = [
  itemsLocal = this items
  kindLocal = this kind
  listExpr = "[" + (itemsLocal joinWith: " " transform: [it toCljExpr: ctx :scope]) + "]"
  setExpr = "#{" + (itemsLocal joinWith: " " transform: [it toCljExpr: ctx :scope]) + "}"
  mapExpr = "{" + (itemsLocal joinWith: " " transform: [it toCljExpr: ctx :scope]) + "}"
  value = | kindLocal
    | IrCollectionKind.List => listExpr
    | IrCollectionKind.Set => setExpr
    |=> mapExpr
  isMutable = this typeRef isMut
  ^ isMutable ifTrue: ["(atom " + value + ")"] ifFalse: [value]
]

// wrap the body in a let with the given bindings
// keep simple cases short and format longer ones across lines
String cljWrapInLet(bindings): List(CljBinding) -> String = [
  isSingle = bindings count == 1
  bodyMultiline = this contains: "\n"
  isShort = isSingle && bodyMultiline not

  ^ isShort ifTrue: [
      b = bindings first
      "(let [" + b name + " " + b value + "] " + this + ")"
    ] ifFalse: [
      bStr = isSingle
        ifTrue: [
          b = bindings first
          b name + " " + b value
        ]
        ifFalse: [
          mut maxLen = 0
          bindings forEach: [it ->
            w = it name count
            w > maxLen ifTrue: [maxLen <- w]
          ]
          bindings joinWith: "\n      " transform: [it ->
            (it name cljPadTo: maxLen) + " " + it value
          ]
        ]
      indented = this replace: "\n" with: "\n  "
      "(let [" + bStr + "]\n  " + indented + ")"
    ]
]

// all types a case matches on, the first one and every pattern after it
IrMatchCase cljCaseTypeStrs(ctx): CljContext scope: CljScope -> List(String) = [
  assertedTypeMaybe = this assertedTypeRef
  firstTypeStr = | assertedTypeMaybe
    | null => condition toCljExpr: ctx :scope
    |=> assertedTypeMaybe cljQualifiedTypeName: ctx
  typeStrs::mut List(String) = {firstTypeStr}!
  additionalConditions forEach: [alt ->
    | alt
    | IrTypeRefExpr => [
      typeStrs add: (alt ref cljQualifiedTypeName: ctx)
      ()
    ]
    |=> []
  ]
  ^ typeStrs toList
]

IrMatchExpr matchToCljExpr(ctx): CljContext scope: CljScope -> String = [
  subjectExpr = this subject toCljExpr: ctx :scope
  subjectName = "__cljSubject"
  innerScope = scope copy

  elseBranchLocal = this elseBranch
  casesLocal = this cases
  kindLocal = this kind

  ^ | kindLocal
    | IrMatchKind.ByError => [
      // Errors are exceptions carrying the error record under `:value` (see
      // IrThrow / niva.core/Error__throw). We dispatch on the record's concrete
      // type; anything unhandled is re-thrown so it keeps propagating.
      typeAliasMaybe = this typeAlias
      aliasRaw = typeAliasMaybe orElse: "it"
      aliasName = aliasRaw cljSanitizeIdent
      errName = "__cljErr"

      // Shared dispatch: (condp instance? alias  Type body  ...  <default>).
      // The default differs per shape: standalone re-throws immediately, while
      // the else form yields a sentinel that niva.core/handling turns into a
      // re-throw (it must escape the handler before deciding on the else branch).
      buildCondp = [defaultStr::String ->
        condpSb = StringBuilder new
        condpSb append: "(condp instance? "
        condpSb append: aliasName
        casesLocal forEach: [c ->
          assertedTypeMaybe = c assertedTypeRef
          typeStr = | assertedTypeMaybe
            | null => c condition toCljExpr: ctx scope: innerScope
            |=> [
              // Object for record errors(niva errors)
              assertedTypeValue = assertedTypeMaybe
              (assertedTypeValue typeId cljNormalizeTypeId) == "core_Error"
                ifTrue:  ["Object"]
                ifFalse: [assertedTypeValue cljQualifiedTypeName: ctx]
            ]
          caseScope = innerScope copy
          caseScope mutLocals remove: aliasName
          bodyStr = c body toCljBlockBody: ctx scope: caseScope
          condpSb append: "\n  "
          condpSb append: typeStr
          condpSb append: " "
          condpSb append: (bodyStr replace: "\n" with: "\n  ")
          ()
        ]
        condpSb append: "\n  "
        condpSb append: defaultStr
        condpSb append: ")"
        condpSb toString
      ]

      | elseBranchLocal
        | null => [
            // No else branch: a plain, idiomatic try/catch/condp — no wrapping.
            condpStr = buildCondp defaultStr: ("(throw " + errName + ")")
            sb = StringBuilder new
            sb append: "(try "
            sb append: subjectExpr
            sb append: "\n  (catch clojure.lang.ExceptionInfo "
            sb append: errName
            sb append: "\n    (let ["
            sb append: aliasName
            sb append: " (:value (ex-data "
            sb append: errName
            sb append: "))]\n      "
            sb append: (condpStr replace: "\n" with: "\n      ")
            sb append: ")))"
            sb toString
          ]
        |=> [
            // Else branch present: niva.core/handling hides the success-vs-handled
            // plumbing, so the generated code stays a readable macro call.
            ctx addImport: "niva.core"
            condpStr = buildCondp defaultStr: ":niva.core/miss"
            elseBlock = elseBranchLocal
            elseScope = innerScope copy
            elseScope mutLocals remove: aliasName
            elseStr = elseBlock toCljBlockBody: ctx scope: elseScope

            sb = StringBuilder new
            sb append: "(niva.core/handling ["
            sb append: aliasName
            sb append: " "
            sb append: subjectExpr
            sb append: "]\n  "
            sb append: (condpStr replace: "\n" with: "\n  ")
            sb append: "\n  "
            sb append: (elseStr replace: "\n" with: "\n  ")
            sb append: ")"
            sb toString
          ]
    ]
    | IrMatchKind.ByType => [
      // condp instance? subject Foo (let [alias subject] body) ...
      sb = StringBuilder new
      sb append: "(condp instance? "
      sb append: subjectName
      casesLocal forEach: [c ->
        typeAliasMaybe = this typeAlias
        aliasName = typeAliasMaybe orElse: "it"
        caseScope = innerScope copy
        caseScope mutLocals remove: aliasName
        bodyStr = c body toCljBlockBodyWithBind: ctx scope: caseScope
                    bindName: aliasName bindValue: subjectName
        // every pattern of the branch gets its own clause over the same body
        (c cljCaseTypeStrs: ctx scope: innerScope) forEach: [typeStr ->
          sb append: "\n  "
          sb append: typeStr
          sb append: " "
          sb append: (bodyStr replace: "\n" with: "\n  ")
          ()
        ]
      ]
      | elseBranchLocal
      | null => [ sb append: "\n  (throw (ex-info \"no matching type\" {})))" ]
      |=> [
          elseBlock = elseBranchLocal
          elseScope = innerScope copy
          elseStr = elseBlock toCljBlockBody: ctx scope: elseScope
          sb append: "\n  "
          sb append: (elseStr replace: "\n" with: "\n  ")
          sb append: ")"
        ]
      (sb toString) cljWrapInLet: {(CljBinding name: subjectName value: subjectExpr)}
    ]
    |=> [
      // ByValue or ByBool -> cond chain
      sb = StringBuilder new
      sb append: "(cond"
      casesLocal forEach: [c ->
        mut fullCond::String = "(= " + subjectName + " " + (c condition toCljExpr: ctx scope: innerScope) + ")"
        // patterns of one branch are alternatives so they are joined by or
        c additionalConditions forEach: [alt ->
          fullCond <- "(or " + fullCond + " (= " + subjectName + " " + (alt toCljExpr: ctx scope: innerScope) + "))"
        ]
        caseScope = innerScope copy
        bodyStr = c body toCljBlockBody: ctx scope: caseScope
        sb append: "\n  "
        sb append: fullCond
        sb append: " "
        sb append: (bodyStr replace: "\n" with: "\n  ")
        ()
      ]
      elseBranchLocal ifNotNull: [elseBranchLocalValue ->
          elseBlock = elseBranchLocalValue
          elseStr = elseBlock toCljBlockBody: ctx scope: (innerScope copy)
          sb append: "\n  :else "
          sb append: (elseStr replace: "\n" with: "\n  ")
          ()
        ]
      sb append: ")"
      (sb toString) cljWrapInLet: {(CljBinding name: subjectName value: subjectExpr)}
    ]
]

// ---------------------------------------------------------------------------
// blocks
// ---------------------------------------------------------------------------

extend IrBlock [
  // Emits the block as a Clojure expression: (let [...] body) with all
  // statements collected into the bindings vector. Non-binding statements use
  // `_` as their symbol.
  on toCljBlockBody(ctx): CljContext scope: CljScope -> String =
    this toCljBlockBodyWithBind: ctx :scope bindName: "" bindValue: ""

  // Same as `toCljBlockBody` but injects an extra binding at the top. Used by
  // match cases to alias the subject inside a type-cast branch.
  on toCljBlockBodyWithBind(ctx): CljContext scope: CljScope
                             bindName: String bindValue: String -> String = [
    // Clojure has no return, so a `^` has to be in tail position.
    // The first statement that can return splits the block: a `^` ends it.
    // A `^` anywhere else is reported rather than dropped.
    mut splitIdx = -1
    this stmts forEachIndexed: [i, st ->
      returns = st cljReturnTokens
      ((splitIdx == -1) && returns isNotEmpty) ifTrue: [
        st cljCanSplitBlock
          ifTrue: [splitIdx <- i]
          ifFalse: [ctx addUnsupportedReturn: returns first]
      ]
    ]
    splitIdx != -1 ifTrue: [
      ^ (this cljSplitAt: splitIdx) toCljBlockBodyWithBind: ctx :scope :bindName :bindValue
    ]

    injectedBinding::mut List(CljBinding) = {}
    bindName != "" ifTrue: [
      binding = CljBinding name: (bindName cljSanitizeIdent) value: bindValue
      injectedBinding add: binding
      ()
    ]
    bindings = injectedBinding + (this stmts map: [it toCljStmtBinding: ctx :scope])

    resultExpr = this result
    | resultExpr
    | null => []
    |=> resultExpr cljCheckTailReturns: ctx

    resultStr = | resultExpr
                | null => [this resultType isCljUnitType ifTrue: [":unit"] ifFalse: ["nil"]]
                |=> resultExpr toCljExprForExpected: (this resultType) :ctx :scope

    ^ bindings isNotEmpty
      ifTrue: [resultStr cljWrapInLet: bindings]
      ifFalse: [resultStr]
  ]

  on toCljBlockExpr(ctx): CljContext scope: CljScope -> String =
    this toCljBlockBody: ctx :scope
]

// ---------------------------------------------------------------------------
// early returns
// ---------------------------------------------------------------------------

// tokens of the `^` inside, without entering a lambda: that's its own fn
// a loop's lambdas are inlined, so those are entered
extend IrExpr [
  on cljCollectReturns(into): mut List(Token) -> Unit = [
    | this
    | IrLiteralExpr | IrVarRef | IrThisRef | IrTypeRefExpr | IrLambda => []
    | IrFieldGet => receiver cljCollectReturns: into
    | IrCall => [
        calleeMaybe = callee
        | calleeMaybe
        | null => []
        |=> calleeMaybe cljCollectReturns: into
        // an inline call that wasn't lowered still gets its block as a fn
        args forEach: [arg ->
          isInline
            ifTrue: [arg cljCollectLoopReturns: into]
            ifFalse: [arg cljCollectReturns: into]
        ]
      ]
    | IrBlockExpr => block cljCollectReturns: into
    | IrMatchExpr => [
        subject cljCollectReturns: into
        cases forEach: [it body cljCollectReturns: into]
        elseBranch ifNotNull: [elseBranchValue -> elseBranchValue cljCollectReturns: into]
      ]
    | IrNewExpr => args forEach: [it cljCollectReturns: into]
    | IrCollectionLiteral => items forEach: [it cljCollectReturns: into]
    | IrOpBin => [
        left cljCollectReturns: into
        right cljCollectReturns: into
      ]
  ]

  on cljCollectLoopReturns(into): mut List(Token) -> Unit =
    | this
    | IrLambda => body cljCollectReturns: into
    |=> this cljCollectReturns: into

  on cljReturnTokens -> List(Token) = [
    tokens::mut List(Token) = {}!
    this cljCollectReturns: tokens
    ^ tokens toList
  ]

  // in tail position a `^` can end a branch of a match or a block, which are
  // checked when they're emitted; anywhere else it can't be emitted
  on cljCheckTailReturns(ctx): CljContext -> Unit = [
    tokens::mut List(Token) = {}!
    | this
    | IrMatchExpr => subject cljCollectReturns: tokens
    | IrBlockExpr => []
    |=> this cljCollectReturns: tokens
    tokens isNotEmpty ifTrue: [ctx addUnsupportedReturn: tokens first]
  ]
]

extend IrStmt [
  on cljCollectReturns(into): mut List(Token) -> Unit = [
    | this
    | IrReturn => [
        into add: token
        exprMaybe = expr
        | exprMaybe
        | null => []
        |=> exprMaybe cljCollectReturns: into
      ]
    | IrLet => [
        valueMaybe = value
        | valueMaybe
        | null => []
        |=> valueMaybe cljCollectReturns: into
      ]
    | IrSetLocal => value cljCollectReturns: into
    | IrSetField => [
        receiver cljCollectReturns: into
        value cljCollectReturns: into
      ]
    | IrDestructure => value cljCollectReturns: into
    | IrExprStmt => expr cljCollectReturns: into
    | IrWhile => [
        cond cljCollectLoopReturns: into
        body cljCollectLoopReturns: into
      ]
    | IrThrow => errExpr cljCollectReturns: into
  ]

  on cljReturnTokens -> List(Token) = [
    tokens::mut List(Token) = {}!
    this cljCollectReturns: tokens
    ^ tokens toList
  ]

  on cljCanSplitBlock -> Bool =
    | this
    | IrReturn => true
    |=> false
]

extend IrBlock [
  on cljCollectReturns(into): mut List(Token) -> Unit = [
    stmts forEach: [it cljCollectReturns: into]
    resultMaybe = result
    | resultMaybe
    | null => []
    |=> resultMaybe cljCollectReturns: into
  ]

  // the block up to the statement at `idx`, which can split it
  on cljSplitAt(idx): Int -> IrBlock = [
    split = stmts at: idx
    ^ | split
      | IrReturn => IrBlock stmts: (stmts dropLast: stmts count - idx) result: split expr :resultType
      |=> this
  ]
]

// ---------------------------------------------------------------------------
// statement -> let-binding pair
// ---------------------------------------------------------------------------

IrStmt toCljStmtBinding(ctx): CljContext scope: CljScope -> CljBinding = [
  ^ | this
    | IrLet => [
        goName = name cljSanitizeIdent
        isPersistent = ctx isStateName: name
        isPersistent ifTrue: [
          persistentValueMaybe = value
          raw = | persistentValueMaybe
            | null => "nil"
            |=> persistentValueMaybe toCljExprForExpected: typeRef :ctx :scope
          init = "(if (identical? @" + goName + " __niva_state_uninitialized) (reset! " +
            goName + " " + raw + ") nil)"
          CljBinding name: "_" value: init
        ] ifFalse: [
          scope mutLocals remove: name
          isMut ifTrue: [scope mutLocals add: name]
          valueMaybe = value
          raw = | valueMaybe
            | null => "nil"
            |=> valueMaybe toCljExprForExpected: typeRef :ctx :scope
          valStr = isMut ifTrue: ["(atom " + raw + ")"] ifFalse: [raw]
          CljBinding name: goName value: valStr
        ]
      ]
    | IrSetLocal => [
        goName = name cljSanitizeIdent
        (scope isMut: name) ifFalse: [
          TO DO: "Clojure backend: assignment to non-mut var: " + name
          ()
        ]
        valStr = value toCljExpr: ctx :scope
        CljBinding name: "_" value: ("(reset! " + goName + " " + valStr + ")")
      ]
    | IrSetField => [
        receiverType = receiver cljExprTypeRef
        canMutateRecord = receiverType isMut && (receiverType kind == IrTypeRefKind.Custom)
        canMutateRecord ifFalse: [
          TO DO: "Clojure backend: field assignment requires a mutable record receiver"
          ()
        ]
        receiverStr = receiver toCljExpr: ctx :scope
        valueStr = value toCljExpr: ctx :scope
        CljBinding name: "_"
          value: ("(swap! " + receiverStr + " assoc :" + (field cljSanitizeIdent) + " " + valueStr + ")")
      ]
    | IrDestructure => [
        valStr = value toCljSnapshotExpr: ctx :scope
        // build {a :field b :field2 ...} destructure map
        parts = bindings joinWith: " " transform: [b ->
          scope mutLocals remove: b name
          (b name cljSanitizeIdent) + " :" + (b fieldName cljSanitizeIdent)
        ]
        CljBinding name: ("{" + parts + "}") value: valStr
      ]
    | IrExprStmt => [
        // Error propagation is automatic here: a call with propagatingErrVar just
        // throws on failure, and the exception unwinds the stack until a ByError
        // match (try/catch) handles it — so no special emission is needed.
        CljBinding name: "_" value: (expr toCljExpr: ctx :scope)
      ]
    | IrReturn => CljBinding name: "_" value: ""
    | IrWhile => [
        // the plain condition is already one form so extra parens would call it
        condStr = cond isIrLambda
          ifTrue:  [cond cljUnwrapLambdaBody: ctx :scope]
          ifFalse: [cond toCljExpr: ctx :scope]
        bodyStr = body isIrLambda
          ifTrue:  [body cljUnwrapLambdaBody: ctx :scope]
          ifFalse: [body toCljExpr: ctx :scope]
        CljBinding name: "_" value: ("(while " + condStr + " " + bodyStr + ")")
      ]
    | IrThrow => [
        // JVM can only throw Throwables, so wrap the error record in an ex-info
        // whose data carries it under `:value` (matching niva.core/Error__throw
        // and the extraction done by a ByError match).
        throwErrExpr = errExpr
        errRecordStr = | throwErrExpr
          | IrTypeRefExpr => "(->" + (throwErrExpr ref typeId cljNormalizeTypeId cljSanitizeIdent) + ")"
          |=> throwErrExpr toCljExpr: ctx :scope
        CljBinding name: "_"
          value: ("(let [__cljErr " + errRecordStr + "] (throw (ex-info (str __cljErr) {:value __cljErr})))")
      ]
]

// Unwrap the body of an IrLambda: expose its statements + result inline so that
// (while (fn [] cond)) becomes (while cond) instead of paying the closure cost.
IrExpr cljUnwrapLambdaBody(ctx): CljContext scope: CljScope -> String =
  | this | IrLambda => body toCljBlockBody: ctx :scope
  |=> ""

// ---------------------------------------------------------------------------
// top-level definitions
// ---------------------------------------------------------------------------

constructor CljBackend [
  on emitTypeDef(def): IrTypeDef ctx: CljContext sb: StringBuilder -> Unit = [
    name = def id cljNormalizeTypeId cljSanitizeIdent
    fields = def fields joinWith: " " transform: [it name cljSanitizeIdent]
    typeDef = ctx hotReload
      ifTrue: ["^:clj-reload/keep (defrecord " + name + " [" + fields + "])"]
      ifFalse: ["(defrecord " + name + " [" + fields + "])"]
    sb appendLine: typeDef
    sb appendLine: ""
    ()
  ]

  on emitUnionDef(def): IrUnionDef ctx: CljContext sb: StringBuilder -> Unit = [
    // each branch becomes its own defrecord that inlines common fields first
    def branches forEach: [br ->
      br isInclude ifFalse: [
        branchTypeId = def pkgId + "_" + br name
        branchName = branchTypeId cljSanitizeIdent
        commonStr = def commonFields joinWith: " " transform: [f -> f name cljSanitizeIdent]
        branchStr = br fields joinWith: " " transform: [f -> f name cljSanitizeIdent]
        fieldsStr = commonStr == ""
          ifTrue: [branchStr]
          ifFalse: [branchStr == "" ifTrue: [commonStr] ifFalse: [commonStr + " " + branchStr]]
        typeDef = ctx hotReload
          ifTrue: ["^:clj-reload/keep (defrecord " + branchName + " [" + fieldsStr + "])"]
          ifFalse: ["(defrecord " + branchName + " [" + fieldsStr + "])"]
        sb appendLine: typeDef
        ()
      ]
    ]
    sb appendLine: ""
    ()
  ]

  on emitEnumDef(def): IrEnumDef ctx: CljContext sb: StringBuilder -> Unit = [
    name = def id cljNormalizeTypeId cljSanitizeIdent
    def values forEach: [v ->
      valSafe = v cljSanitizeIdent
      valName = name + "_" + valSafe
      sb appendLine: ("(def " + valName + " :" + valName + ")")
      ()
    ]
    sb appendLine: ""
    ()
  ]

  on emitFunction(fn): IrFunction ctx: CljContext sb: StringBuilder -> Unit = [
    CljBackend emitFunctionNamed: (fn cljFuncNameFromIr) :fn :ctx :sb
    ()
  ]

  // Generic receiver methods are represented by one IR function and a list of
  // concrete call-site instantiations. Clojure has no dispatch by static type,
  // so every concrete receiver needs its own function symbol.
  on emitFunctionNamed(name): String fn(fn): IrFunction ctx: CljContext sb: StringBuilder -> Unit = [
    // fn.args already includes `this` for instance methods
    generatedLine = (sb toString) cljLineCount
    fullArgs = fn args joinWith: " " transform: [it name cljSanitizeIdent]

    scope = CljScope new
    ctx stateNames forEach: [it -> scope mutLocals add: it]
    body = fn body toCljBlockBody: ctx :scope

    (body contains: "\n")
      ifTrue: [
        indented = body replace: "\n" with: "\n  "
        sb appendLine: ("(defn " + name + " [" + fullArgs + "]")
        sb appendLine: ("  " + indented + ")")
      ]
      ifFalse: [
        sb appendLine: ("(defn " + name + " [" + fullArgs + "] " + body + ")")
    ]
    sb appendLine: ""
    generatedEndLine = ((sb toString) cljLineCount) - 2
    ctx addDebugEntry: generatedLine endLine: generatedEndLine token: fn token method: fn name
    ()
  ]

  on emitStateDef(def): IrStateDef ctx: CljContext sb: StringBuilder -> Unit = [
    name = def name cljSanitizeIdent
    sb appendLine: "^:clj-reload/keep (def " + name + " (atom __niva_state_uninitialized))"
    sb appendLine: ""
    ()
  ]

  on emitEntry(entry): IrBlock stateDefs(stateDefs): List(IrStateDef)
      ctx(ctx): CljContext sb(sb): StringBuilder -> Unit = [
    // keep entry execution behind a reload-safe hook
    entryToken = entry stmts isNotEmpty
      ifTrue: [(entry stmts first) cljStmtToken]
      ifFalse: [
        entryResultMaybe = entry result
        | entryResultMaybe
        | null => Token fake
        |=> entryResultMaybe cljExprToken
      ]
    generatedLine = (sb toString) cljLineCount
    scope = CljScope new
    stateDefs forEach: [it ->
      (ctx isStateName: it name) ifTrue: [scope mutLocals add: it name]
    ]
    body = entry toCljBlockBody: ctx :scope
    indented = body replace: "\n" with: "\n  "
    sb appendLine: "(defn __niva_entry! []"
    ctx debug
      ifTrue: [
        sb appendLine: "  (try"
        sb appendLine: ("    " + indented replace: "\n" with: "\n    ")
        sb appendLine: "    (catch ^:sci/error Exception __niva_exception"
        sb appendLine: "      (__niva_debug_print __niva_exception)))"
        sb appendLine: ")"
      ]
      ifFalse: [sb appendLine: ("  " + indented + ")")]
    sb appendLine: ""
    // keep the cli entry point as a thin compatibility wrapper
    sb appendLine: "(defn -main [& args]"
    sb appendLine: "  (System/setProperty \"niva.cli.args\" (pr-str (vec args)))"
    sb appendLine: "  (__niva_entry!))"
    sb appendLine: ""
    generatedEndLine = ((sb toString) cljLineCount) - 2
    ctx addDebugEntry: generatedLine endLine: generatedEndLine token: entryToken method: "__niva_entry!"
    ()
  ]

  // REPL modules have no `-main`: the entry block is emitted as a top-level
  // expression, so loading/evaluating the generated form returns the Niva
  // entry result in the target Clojure session.
  on emitEntryRepl(entry): IrBlock ctx: CljContext sb: StringBuilder -> Unit = [
    scope = CljScope new
    entry stmts forEach: [stmt ->
      | stmt
      | IrLet => [
        valueMaybe = stmt value
        value = | valueMaybe
          | null => "nil"
          |=> valueMaybe toCljExpr: ctx :scope
        sb appendLine: ("(def " + (stmt name cljSanitizeIdent) + " " + value + ")")
        ()
      ]
      | IrSetLocal => [
        value = stmt value toCljExpr: ctx :scope
        isPersistent = scope isMut: stmt name
        isPersistent
          ifTrue: [sb appendLine: ("(reset! " + (stmt name cljSanitizeIdent) + " " + value + ")")]
          ifFalse: [sb appendLine: ("(def " + (stmt name cljSanitizeIdent) + " " + value + ")")]
        ()
      ]
      | IrExprStmt => [
        sb appendLine: (stmt expr toCljExpr: ctx :scope)
        ()
      ]
      |=> [
        binding = stmt toCljStmtBinding: ctx :scope
        wrapped = ":unit" cljWrapInLet: {binding}
        sb appendLine: wrapped
        ()
      ]
    ]
    entryResultMaybe = entry result
    resultValue = | entryResultMaybe
      | null => ":unit"
      |=> entryResultMaybe toCljExpr: ctx :scope
    sb appendLine: resultValue
    sb appendLine: ""
    ()
  ]

  on fullOutputFromIrModuleForTarget(ir): IrModule debug: Bool mode: CljEmitMode
      target(target): CljTarget -> CljOutput = [
    files::mut Map(String, String) = #{}!

    // Keep the legacy `main` shim loadable even when the source file is empty.
    // The shim always requires the entry namespace, so an empty package list
    // still needs a no-op generated entry module.
    packages = ir packages isEmpty
      ifTrue: [
        {(IrPackage
          name: ir pkg
          imports: {}
          dependencies: {}
          types: {}
          unions: {}
          enums: {}
          stateDefs: {}
          functions: {})}
      ]
      ifFalse: [ir packages]

    packages sortedBy: [it name], forEach: [pkg ->
      localDependencyNames = pkg dependencyPackageNames filter: [it != "core"]
      localImports = (localDependencyNames map: [dependency -> dependency cljGeneratedNamespace]) toSet
      mut packageEntry::IrBlock? = null
      (pkg name == ir pkg) ifTrue: [packageEntry <- ir entry]
      packageIr = IrModule version: ir version pkg: pkg name packages: {pkg} entry: packageEntry
      content = CljBackend fullFromIrModule: packageIr :debug :mode
        namespace: (pkg cljGeneratedNamespace) initialImports: localImports
        mainClass: ((pkg name == ir pkg) && (target == CljTarget.Jvm))
      files at: (pkg cljGeneratedPath) put: content
    ]

    modules::mut List(CljModuleManifest) = {}!
    stateVars::mut List(CljStateManifest) = {}!
    typeShapes::mut List(CljTypeShape) = {}!
    packages sortedBy: [it name], forEach: [pkg ->
      module = CljModuleManifest
        moduleId: pkg name
        file: pkg cljGeneratedPath
        deps: ((pkg dependencyPackageNames filter: [it != "core"]) sortedBy: [it])
      modules add: module
      pkg stateDefs forEach: [state ->
        stateManifest = CljStateManifest
          key: pkg name + "/" + state name
          varName: state name
          typeShape: state typeRef canonicalInterfaceString
        stateVars add: stateManifest
        ()
      ]
      pkg types forEach: [def ->
        typeShape = CljTypeShape
          key: pkg name + "/" + def id
          kind: "record"
          shape: def cljManifestShape
        typeShapes add: typeShape
        ()
      ]
      pkg unions forEach: [def ->
        typeShape = CljTypeShape
          key: pkg name + "/" + def id
          kind: "union"
          shape: def cljManifestShape
        typeShapes add: typeShape
        ()
      ]
      pkg enums forEach: [def ->
        typeShape = CljTypeShape
          key: pkg name + "/" + def id
          kind: "enum"
          shape: def cljManifestShape
        typeShapes add: typeShape
        ()
      ]
    ]
    manifest = CljManifest
      version: 1
      entryNamespace: (ir pkg cljGeneratedNamespace)
      modules: modules toList
      stateVars: stateVars toList
      typeShapes: typeShapes toList

    ^ CljOutput files: files toMap
      entryNamespace: (ir pkg cljGeneratedNamespace)
      :manifest :target
  ]

  on fullOutputFromIrModule(ir): IrModule debug: Bool mode: CljEmitMode -> CljOutput = [
    ^ CljBackend fullOutputFromIrModuleForTarget: ir :debug :mode
      target: CljTarget.Jvm
  ]

  on manifestFromIrModule(ir): IrModule -> CljManifest =
    (CljBackend fullOutputFromIrModule: ir debug: false mode: CljEmitMode.Program) manifest

  // Public entry point.
  on fullFromIrModule(ir): IrModule debug: Bool mode: CljEmitMode
      namespace(namespace): String initialImports(initialImports): Set(String)
      mainClass(mainClass): Bool -> String = [
    packageName = ir packages count == 1
      ifTrue: [ir packages first name]
      ifFalse: [""]
    ctx = CljContext newDebug: debug imports: initialImports pkg: packageName
      hotReload: (mode == CljEmitMode.HotReload)
    // ns declaration is decided at the end; emit bodies first into a scratch buffer
    body = StringBuilder new
    functionNames::mut Set(String) = #()!
    isRepl = mode == CljEmitMode.Repl
    isHotReload = mode == CljEmitMode.HotReload
    hasProgramStates = isHotReload && (ir packages any: [it stateDefs isNotEmpty])
    hasProgramStates ifTrue: [
      body appendLine: "(def ^:private __niva_state_uninitialized (Object.))"
      body appendLine: ""
      ()
    ]

    // TODO parallel
    ir packages forEach: [pkg ->
      pkg stateDefs forEach: [state ->
        isHotReload ifTrue: [
          ctx addStateName: state name
          CljBackend emitStateDef: state :ctx sb: body
          ()
        ]
      ]
      pkg types  forEach: [CljBackend emitTypeDef:  it :ctx sb: body]
      pkg unions forEach: [CljBackend emitUnionDef: it :ctx sb: body]
      pkg enums  forEach: [CljBackend emitEnumDef:  it :ctx sb: body]
      pkg functions forEach: [fn ->
        baseName = fn cljFuncNameFromIr
        functionNames add: baseName
        CljBackend emitFunction: fn :ctx sb: body
        fn instantiations forEach: [inst ->
          specializedId = (fn id replace: (fn receiverType typeId) with: (inst receiverType typeId))
          specializedName = specializedId cljFuncIdToName
          functionNames add: specializedName
          specializedName == baseName ifFalse: [
            CljBackend emitFunctionNamed: specializedName :fn :ctx sb: body
            ()
          ]
        ]
      ]
    ]
    entryMaybe = ir entry
    entryMaybe ifNotNull: [entryValue ->
      isRepl ifTrue: [
        CljBackend emitEntryRepl: entryValue :ctx sb: body
        ()
      ]
      isRepl ifFalse: [
        entryStates::mut List(IrStateDef) = {}
        ir packages forEach: [pkg ->
          (pkg name == ir pkg) ifTrue: [
            entryStates addAll: pkg stateDefs
            ()
          ]
        ]
        CljBackend emitEntry: entryValue stateDefs: entryStates :ctx sb: body
        ()
      ]
    ]

    header = StringBuilder new
    header appendLine: ";; Code generated by Niva. DO NOT EDIT."
    nsName = namespace
    importsList = ctx imports toList sortedBy: [it]
    emitsMainClass = (isRepl not) && mainClass
    importsList isEmpty
      ifTrue:  [
        // programs need a Java main class for native-image, REPL does not.
        nsSuffix = emitsMainClass ifTrue: [" (:gen-class))"] ifFalse: [")"]
        header appendLine: ("(ns " + nsName + nsSuffix)
      ]
      ifFalse: [
        reqs = importsList joinWith: " " transform: [it -> "[" + it + "]"]
        genClass = emitsMainClass ifTrue: [" (:gen-class)"] ifFalse: [""]
        header appendLine: ("(ns " + nsName + genClass + " (:require " + reqs + "))")
    ]
    functionNamesList = functionNames toList
    stateNamesList = (ctx stateNames toList) map: [it cljSanitizeIdent]
    declarationNames = functionNamesList + stateNamesList
    declarationNames isNotEmpty ifTrue: [
      header appendLine: ("(declare " + (declarationNames joinWith: " ") + ")")
      ()
    ]
    header appendLine: ""

    ctx debug ifTrue: [
      header appendLine: """(declare __niva_source_map)
(defn- __niva_sci_stacktrace [e]
  (try
    (when-let [f (requiring-resolve 'sci.core/stacktrace)]
      (seq (f e)))
    (catch Throwable _ nil)))
(defn- __niva_debug_print [e]
  (let [actual-error (or (.getCause e) e)]
    (println (str "---\nException: " (.getMessage actual-error) "\n---" )))
  (if-let [frames (__niva_sci_stacktrace e)]
    (loop [frames frames last-info nil]
      (when frames
        (let [frame (first frames)
              file (some-> (:file frame) java.io.File. .getName)
              line (:line frame)
              info (when (and file line) (get __niva_source_map [file line]))]
          (when (and info (not= info last-info))
            (println (str "Method: " (nth info 2) " File: " (nth info 0) ":" (nth info 1))))
          (recur (next frames) (if info info last-info)))))
    (loop [frames (seq (.getStackTrace e)) last-info nil]
      (when frames
        (let [frame (first frames)
              info (get __niva_source_map [(.getFileName frame) (.getLineNumber frame)])]
          (when (and info (not= info last-info))
            (println (str "Method: " (nth info 2) " File: " (nth info 0) ":" (nth info 1))))
          (recur (next frames) (if info info last-info))))))
  (System/exit 1))"""
      bodyLineOffset = (header toString) cljLineCount + 1
      entriesList::mut List(String) = {}!
      ctx orderedDebugEntries forEach: [
        entriesList addAll: (it toCljSourceMapEntries: bodyLineOffset)
        ()
      ]
      entries = entriesList joinWith: " "
      header appendLine: ("(def __niva_source_map {" + entries + "})")
      header appendLine: ""
      ()
    ]
    header append: (body toString)

    ctx unsupportedReturns count > 0 ifTrue: [
      TO DO: (ctx unsupportedReturns toList joinWith: "\n")
      ()
    ]
    ^ header toString
  ]

  on fullFromIrModule(ir): IrModule debug: Bool mode: CljEmitMode -> String = [
    nsName = mode == CljEmitMode.Repl
      ifTrue: [CompilerConstants cljReplNamespace]
      ifFalse: ["main"]
    ^ CljBackend fullFromIrModule: ir :debug :mode
      namespace: nsName initialImports: #() mainClass: (mode == CljEmitMode.Program)
  ]

  on fullFromIrModule(ir): IrModule debug: Bool -> String =
    CljBackend fullFromIrModule: ir :debug mode: CljEmitMode.Program

  on fullFromIrModule(ir): IrModule -> String =
    CljBackend fullFromIrModule: ir debug: false
]

IrStmt cljStmtToken -> Token =
  | this
  | IrLet | IrSetLocal | IrSetField | IrDestructure | IrExprStmt | IrReturn | IrWhile | IrThrow => this token
  |=> Token fake

IrExpr cljExprToken -> Token =
  | this
  | IrLiteralExpr | IrVarRef | IrThisRef | IrFieldGet | IrCall | IrLambda | IrBlockExpr | IrMatchExpr | IrNewExpr | IrCollectionLiteral | IrOpBin | IrTypeRefExpr => this token
  |=> Token fake

IrExpr cljExprTypeRef -> IrTypeRef =
  | this
  | IrLiteralExpr | IrVarRef | IrThisRef | IrFieldGet | IrCall | IrLambda | IrBlockExpr | IrMatchExpr | IrNewExpr | IrCollectionLiteral | IrOpBin | IrTypeRefExpr => this typeRef
  |=> IrTypeRef kind: IrTypeRefKind.Builtin typeId: "core_Any" ownerPkg: "core" args: {} returnType: null isMut: false nullable: false errors: {}
