IrExpr validateGoIrExpr(knownFuncIds): Set(String) knownTypeIds: Set(String) goErrors: mut List(GoIrError) -> Unit = [
  typeRef validateGoTypeRefs: knownTypeIds :goErrors
  | this
  | IrVarRef | IrLiteralExpr | IrThisRef => []
  | IrFieldGet    => [receiver validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
  | IrCall        => [
      bindMaybe = bind
      | bindMaybe
      | null => ()
      |=> [
        | bindMaybe
        | IrBindEmit => [
          bindMaybe isGoSpecific ifFalse: [
            goErrors add: (GoIrError message:
              "Go backend requires an explicit goPkg for Bind emit templates")
          ]
        ]
        |=> []
      ]
      // inlined bind calls (emit / by-name) don't resolve a funcId, they are
      // substituted directly by the backend, so skip funcId validation for them
      bind == null ifTrue: [
        fid = funcId
        | fid
        | null => [
            callee == null ifTrue: [
              goErrors add: (GoIrError message: "IrCall without funcId must have callee")
            ]
          ]
        |=> [
            declPkgMaybe = declPkg
            isCore = | declPkgMaybe
              | null => false
              |=> declPkgMaybe == "core"
            validationId = fid
            (isCore not) && (knownFuncIds contains: validationId, not) ifTrue: [
              goErrors add: (GoIrError message: ("unknown Go IR func id: " + validationId))
            ]
          ]
      ]
      calleeMaybe = callee
      | calleeMaybe
      | null => []
      |=> calleeMaybe validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      args forEach: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
      paramTypes forEach: [it validateGoTypeRefs: knownTypeIds :goErrors]
      genericArgs forEach: [it validateGoTypeRefs: knownTypeIds :goErrors]
      receiverTypeMaybe = receiverType
      | receiverTypeMaybe
      | null => []
      |=> receiverTypeMaybe validateGoTypeRefs: knownTypeIds :goErrors
    ]
  | IrLambda    => [body validateGoIrBlock: knownFuncIds :knownTypeIds :goErrors]
  | IrBlockExpr => [block validateGoIrBlock: knownFuncIds :knownTypeIds :goErrors]
  | IrMatchExpr => [
      subject validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      cases forEach: [c ->
        c condition validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
        c additionalConditions forEach: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
        c body validateGoIrBlock: knownFuncIds :knownTypeIds :goErrors
      ]
      elseBranchMaybe = elseBranch
      | elseBranchMaybe
      | null => []
      |=> elseBranchMaybe validateGoIrBlock: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrNewExpr => [
      baseId = typeId goNormalizeTypeId
      (baseId isGeneric not) && ((baseId startsWith: "core_") not) && (knownTypeIds contains: baseId, not) ifTrue: [
        goErrors add: (GoIrError message: ("unknown Go IR constructor type id: " + baseId))
      ]
      constructorBindMaybe = constructorBind
      | constructorBindMaybe
      | null => ()
      |=> [
        | constructorBindMaybe
        | IrConstructorBindEmit => [
          bindingBackend = constructorBindMaybe backend
          isGoMapped = (baseId == "core_StringBuilder") && (bindingBackend == "clojure")
          isGoMapped ifFalse: [
            goErrors add: (GoIrError message:
              ("Go backend does not support constructor binding for " + baseId + " with backend " + bindingBackend))
          ]
        ]
        |=> []
      ]
      args forEach: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
    ]
  | IrCollectionLiteral => [items forEach: [it validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]]
  | IrOpBin             => [
      left validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      right validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrTypeRefExpr => [ref validateGoTypeRefs: knownTypeIds :goErrors]

]

IrTypeRef validateGoTypeRefs(knownTypeIds): Set(String) goErrors: mut List(GoIrError) -> Unit = [
  baseId = typeId goNormalizeTypeId
  shouldCheck =
    (kind == IrTypeRefKind.Custom) &&
    (baseId isGeneric not) &&
    (baseId startsWith: "core_", not) &&
    ((baseId contains: "/") not)

  shouldCheck && (knownTypeIds contains: baseId, not) ifTrue: [
    goErrors add: (GoIrError message: ("unknown Go IR type id: " + baseId))
  ]

  args forEach: [it validateGoTypeRefs: knownTypeIds :goErrors]
  returnTypeMaybe = returnType
  | returnTypeMaybe
  | null => []
  |=> returnTypeMaybe validateGoTypeRefs: knownTypeIds :goErrors
  errors forEach: [it validateGoTypeRefs: knownTypeIds :goErrors]
]

IrBlock validateGoIrBlock(knownFuncIds): Set(String) knownTypeIds: Set(String) goErrors: mut List(GoIrError) -> Unit = [
  resultType validateGoTypeRefs: knownTypeIds :goErrors
  stmts forEach: [it validateGoIrStmt: knownFuncIds :knownTypeIds :goErrors]
  resultMaybe = result
  | resultMaybe
  | null => []
  |=> resultMaybe validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
]

IrStmt validateGoIrStmt(knownFuncIds): Set(String) knownTypeIds: Set(String) goErrors: mut List(GoIrError) -> Unit = [
  | this
  | IrLet => [
      typeRef validateGoTypeRefs: knownTypeIds :goErrors
      valueMaybe = value
      | valueMaybe
      | null => []
      |=> valueMaybe validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrSetLocal => [value validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
  | IrSetField => [
      receiver validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      value validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrDestructure => [
      bindings forEach: [it typeRef validateGoTypeRefs: knownTypeIds :goErrors]
      value validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrExprStmt => [expr validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
  | IrReturn   => [
      exprMaybe = expr
      | exprMaybe
      | null => []
      |=> exprMaybe validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrWhile    => [
      cond validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
      body validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors
    ]
  | IrThrow    => [errExpr validateGoIrExpr: knownFuncIds :knownTypeIds :goErrors]
]
