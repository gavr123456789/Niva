// == compares by content, a type holding what go's == can't compare that way (a collection, a block, a pointer) gets a generated compare function when some == reaches it

extend GoContext [
  // whether go's == compares a value of this type by content, mut cells are read through before comparing so isMut doesn't count, and a type param could be anything
  on goEqIsNative(typeRef): IrTypeRef eqTypeIds: Set(String) -> Bool = [
    baseId = typeRef typeId goNormalizeTypeId
    ^ ((typeRef kind == IrTypeRefKind.Builtin) &&
        ((baseId == "core_List") || (baseId == "core_Set") || (baseId == "core_Map"))) || // is collection
      (typeRef kind == IrTypeRefKind.Function) ||  // is block
      (this needsGoNullablePointerFor: typeRef) || // is pointer
      (typeRef isGoTypeParam) ||
      (eqTypeIds contains: baseId),
      not
  ]

  // a struct field also keeps a mut value as a pointer
  on goFieldEqIsNative(typeRef): IrTypeRef eqTypeIds: Set(String) -> Bool =
    (typeRef goIsMutBoxType: this, not) && (this goEqIsNative: typeRef :eqTypeIds)

  // the types that get a compare function: the ones go's == can't compare
  on goEqTypeIdsFor(ir): IrModule -> Set(String) = [
    eqTypeIds = this goEqTypeIdsAll: ir
    compared::mut List(IrTypeRef) = {}!
    ir functions forEach: [it body collectGoEqTypesInto: compared ctx: this]
    ir entries forEach: [it collectGoEqTypesInto: compared ctx: this]
    reached::mut Set(String) = #()!
    compared forEach: [this addGoEqType: it :eqTypeIds :reached]
    ^ reached toSet
  ]

  // a type and the ones its compare calls
  on addGoEqType(typeRef): IrTypeRef eqTypeIds: Set(String) reached: mut Set(String) -> Unit = [
    typeRef args forEach: [this addGoEqType: it :eqTypeIds :reached]
    this addGoEqTypeId: (typeRef typeId goNormalizeTypeId) :eqTypeIds :reached
  ]

  on addGoEqTypeId(id): String eqTypeIds: Set(String) reached: mut Set(String) -> Unit = [
    (eqTypeIds contains: id) && (reached contains: id) not,
      ifTrue: [
        reached add: id
        fieldsMaybe = symbols fieldTypesByName at: id
        | fieldsMaybe | null => []
        |=> fieldsMaybe forEach: [name, fieldType -> .addGoEqType: fieldType :eqTypeIds :reached]
        .isGoUnionType: id,
          ifTrue: [symbols concreteUnionBranchTypeIds: id, forEach: [.addGoEqTypeId: it :eqTypeIds :reached]]
      ]
  ]

  // types and union branches with a field go's == can't compare, a type param too, and unions with such a branch
  on goEqTypeIdsAll(ir): IrModule -> Set(String) = [
    fieldsById::mut Map(String, List(IrField)) = #{}!
    unionIds::mut List(String) = {}!
    ir packages forEach: [pkg ->
      pkg types forEach: [def -> fieldsById at: (def id goNormalizeTypeId) put: def fields]

      pkg unions forEach: [def ->
        unionIds add: def id goNormalizeTypeId
        def branches forEach: [br ->
          branchTypeId = def pkgId + "_" + br name
          branchFields::List(IrField) = def commonFields + br fields
          br isInclude
            ifFalse: [fieldsById at: (branchTypeId goNormalizeTypeId) put: branchFields]
        ]
      ]
    ]

    // a type holding one of these types needs a function too, so repeat until nothing changes
    eqTypeIds::mut Set(String) = #()!
    mut changed = true
    [changed] whileTrue: [
      changed <- false
      fieldsById forEach: [id, fields ->
        needsFunc = fields any: [.goFieldEqIsNative: it typeRef :eqTypeIds, not]
        (eqTypeIds contains: id, not) && needsFunc,
          ifTrue: [
            eqTypeIds add: id
            changed <- true
          ]
      ]
      unionIds forEach: [id ->
        needsFunc = (symbols concreteUnionBranchTypeIds: id) any: [eqTypeIds contains: it]
        ((eqTypeIds contains: id) not && needsFunc) ifTrue: [
          eqTypeIds add: id
          changed <- true
        ]
        (eqTypeIds contains: id, not) && needsFunc,
          ifTrue: [
            eqTypeIds add: id
            changed <- true
          ]
      ]
    ]
    ^ eqTypeIds toSet
  ]

  // typeParams have a compare function in scope, eqT for T, another type param compares with go's == through any
  on goEqExpr(typeRef): IrTypeRef a: String b: String typeParams: List(String) -> String = [
    baseId = typeRef typeId goNormalizeTypeId
    ^ this goEqIsNative: typeRef eqTypeIds: symbols eqTypeIds,
      ifTrue: ["($a == $b)"]
      ifFalse: [
        .addImport: "niva_go/core"
        // a block compares by its signature, which its type already fixes, so two are equal unless one is null
        isBlock = typeRef kind == IrTypeRefKind.Function
        isBlock,
          ifTrue: ["(($a == nil) == ($b == nil))"]
          ifFalse: [
            .needsGoNullablePointerFor: typeRef,
              ifTrue: ["core.Ptr__equals($a, $b, " + (.goEqFunc: (typeRef nullable: false) :typeParams) + ")"]
              ifFalse: [
                collectionEq = | baseId
                  | "core_List" => "core.List__equals($a, $b, " + (.goEqFunc: typeRef arg: 0 :typeParams) + ")"
                  | "core_Set" => "core.Set__equals($a, $b)"
                  | "core_Map" => "core.Map__equals($a, $b, " + (.goEqFunc: typeRef arg: 1 :typeParams) + ")"
                  |=> ""
                typeArgEqs = typeRef args map: [.goEqFunc: it :typeParams]
                // a null collection is nil, so it isn't equal to an empty one
                | true
                | typeRef isGoTypeParam => (.goEqFunc: typeRef :typeParams) + "($a, $b)"
                | collectionEq == "" => (.goTypeNameFor: baseId) + "__eq(" + ({a b} + typeArgEqs joinWith: ", ") + ")"
                | typeRef nullable => "((($a == nil) == ($b == nil)) && $collectionEq)"
                |=> collectionEq
              ]
          ]
      ]
  ]

  // go function value comparing two values of this type by content
  on goEqFunc(typeRef): IrTypeRef typeParams: List(String) -> String = [
    baseId = typeRef typeId goNormalizeTypeId
    goType = typeRef toGoType: this
    isNative = .goEqIsNative: typeRef eqTypeIds: symbols eqTypeIds
    // a generic type's function takes more args, so it's wrapped like any other
    hasOwnFunc = (symbols eqTypeIds contains: baseId) && (.needsGoNullablePointerFor: typeRef, not) && typeRef args isEmpty
    ^ | true
      | typeRef isGoTypeParam => (typeParams any: [it == baseId]),
                                    ifTrue: [baseId goEqParam]
                                    ifFalse: ["core.EqAny[$goType]"]
      | isNative => "core.Eq[$goType]"
      | hasOwnFunc => (.goTypeNameFor: baseId) + "__eq"
      |=> "func(a, b $goType) bool { return " + (.goEqExpr: typeRef a: "a" b: "b" :typeParams) + " }"
  ]

  // the compare function for an item of a collection, any when the item type is missing
  on goEqFunc(typeRef): IrTypeRef arg(i): Int typeParams: List(String) -> String =
    typeRef args count > i,
      ifTrue: [.goEqFunc: (typeRef args at: i) :typeParams]
      ifFalse: ["core.Eq[interface{}]"]

  // compares a field of a and b, a mut cell compares the value it holds
  on goFieldEqExpr(f): IrField typeParams: List(String) -> String = [
    fieldName = f name toSafeGoIdent
    a = "a.$fieldName"
    b = "b.$fieldName"
    ^ (f typeRef goIsMutBoxType: this),
      ifTrue: [
        .addImport: "niva_go/core"
        "core.Ptr__equals($a, $b, " + (.goEqFunc: f typeRef :typeParams) + ")"
      ]
      ifFalse: [.goEqExpr: f typeRef :a :b :typeParams]
  ]

  // the signature of a compare function, a generic one takes a compare function for each type param
  on goEqFuncHeader(name): String typeParams: List(String) -> String = [
    eqParams = typeParams map: [param ->
      eqParam = param goEqParam
      paramName = param toSafeGoIdent
      ", $eqParam func($paramName, $paramName) bool"
    ]
    goType = name + typeParams goTypeArgs
    funcName = name + "__eq" + typeParams goTypeParams
    eqParamsText = eqParams joinWith: ""
    ^ "func $funcName(a, b $goType$eqParamsText) bool {"
  ]

  // compares the fields go's == can compare first, then the ones that cost more
  on emitGoEqFunc(goType): String typeParams: List(String) fields: List(IrField) sb: StringBuilder -> Unit = [
    eqTypeIds = symbols eqTypeIds
    cheap = fields filter: [.goFieldEqIsNative: it typeRef :eqTypeIds]
    costly = fields filter: [.goFieldEqIsNative: it typeRef :eqTypeIds, not]
    compares = (cheap + costly) map: [.goFieldEqExpr: it :typeParams]
    sb appendLine: (.goEqFuncHeader: goType :typeParams)
    compareExpr = compares joinWith: " &&\n        "
    sb appendIndent: 1 line: "return $compareExpr"
    sb appendLine: "}"
    sb appendLine: ""
    ()
  ]

  // a union compares the branch first, then that branch's fields, branches go's == can compare are left to it, as is a generic branch of a union that isn't generic itself
  on emitGoUnionEqFunc(def): IrUnionDef sb: StringBuilder -> Unit = [
    name = .goTypeNameFor: def id
    typeParams = def typeParams
    branchIds = (symbols concreteUnionBranchTypeIds: def id) filter: [branchId ->
      branchParams = .goEqTypeParamsOf: branchId
      hasEqFunc = symbols eqTypeIds contains: branchId
      hasExtraTypeParam = branchParams any: [param -> (typeParams any: [it == param], not)]
      hasEqFunc && (hasExtraTypeParam, not)
    ], sortedBy: [it]
    sb appendLine: (.goEqFuncHeader: name :typeParams)
    sb appendIndent: 1 line: "switch x := a.(type) {"
    branchIds forEach: [branchId ->
      branchName = .goTypeNameFor: branchId
      branchParams = .goEqTypeParamsOf: branchId
      branchType = branchName + branchParams goTypeArgs
      eqArgs = {"x" "y"} + (branchParams map: [it goEqParam])
      eqFuncName = branchName + "__eq"
      sb appendIndent: 1 line: "case $branchType:"
      sb appendIndent: 2 line: "y, ok := b.($branchType)"
      sb appendIndent: 2 line: "return ok && $eqFuncName(" + (eqArgs joinWith: ", ") + ")"
    ]
    sb appendIndent: 1 line: "}"
    sb appendIndent: 1 line: "return a == b"
    sb appendLine: "}"
    sb appendLine: ""
    ()
  ]

  // the type params of a type or branch, in the order its go struct declares them
  on goEqTypeParamsOf(typeId): String -> List(String) = [
    names::mut List(String) = {}!
    seen::mut Set(String) = #()!
    fieldTypesMaybe = symbols constructorFieldTypes at: typeId
    | fieldTypesMaybe | null => []
    |=> fieldTypesMaybe forEach: [it collectGoTypeParamsInto: names :seen]
    ^ names toList
  ]
]

IrTypeRef isGoTypeParam -> Bool = (kind == IrTypeRefKind.Custom) && (typeId goNormalizeTypeId isGeneric)

// the name of the compare function a generic compare function takes for this type param
String goEqParam -> String = "eq" + this toSafeGoIdent

// the type == compares by, when go's own == doesn't compare it by content
IrOpBin goEqTypeRef(ctx): GoContext -> IrTypeRef? = [
  mut result::IrTypeRef? = null
  typeMaybe = this goEqOperandType: ctx
  | typeMaybe | null => []
  |=> [
    ctx goEqIsNative: typeMaybe eqTypeIds: ctx symbols eqTypeIds,
      ifFalse: [result <- typeMaybe]
  ]
  ^ result
]

// the operand type == compares by: a branch against its union compares as the union, a nullable pointer keeps go's == since a narrowed one is already read through
IrOpBin goEqOperandType(ctx): GoContext -> IrTypeRef? = [
  operands::List(IrExpr) = {left right}
  isEq = ((op == "==") || (op == "!=")) && (operands any: [it isGoNullLiteral], not)
  types = operands map: [it typeRef], filter: [ctx needsGoNullablePointerFor: it, not]
  unionTypes = types filter: [ctx isGoUnionType: it typeId]
  mut result::IrTypeRef? = null
  (isEq && types isNotEmpty),
    ifTrue: [
      result <- unionTypes isNotEmpty,
        ifTrue: [unionTypes first]
        ifFalse: [types first]
    ]
  ^ result
]

// collects the types compared with == or !=, as goEqOperandType picks them
IrBlock collectGoEqTypesInto(types): mut List(IrTypeRef) ctx: GoContext -> Unit = [
  stmts forEach: [it collectGoEqTypesInto: types :ctx]
  resultMaybe = result
  | resultMaybe | null => []
  |=> resultMaybe collectGoEqTypesInto: types :ctx
]

IrStmt collectGoEqTypesInto(types): mut List(IrTypeRef) ctx: GoContext -> Unit = [
  | this
  | IrLet => [
      valueMaybe = value
      | valueMaybe | null => []
      |=> valueMaybe collectGoEqTypesInto: types :ctx
    ]
  | IrSetLocal => [value collectGoEqTypesInto: types :ctx]
  | IrSetField => [
      receiver collectGoEqTypesInto: types :ctx
      value collectGoEqTypesInto: types :ctx
    ]
  | IrDestructure => [value collectGoEqTypesInto: types :ctx]
  | IrExprStmt => [expr collectGoEqTypesInto: types :ctx]
  | IrReturn => [
      exprMaybe = expr
      | exprMaybe | null => []
      |=> exprMaybe collectGoEqTypesInto: types :ctx
    ]
  | IrWhile => [
      cond collectGoEqTypesInto: types :ctx
      body collectGoEqTypesInto: types :ctx
    ]
  | IrThrow => [errExpr collectGoEqTypesInto: types :ctx]
]

IrExpr collectGoEqTypesInto(types): mut List(IrTypeRef) ctx: GoContext -> Unit = [
  | this
  | IrLiteralExpr | IrVarRef | IrThisRef | IrTypeRefExpr => []
  | IrFieldGet => [receiver collectGoEqTypesInto: types :ctx]
  | IrCall => [
      calleeMaybe = callee
      | calleeMaybe | null => []
      |=> calleeMaybe collectGoEqTypesInto: types :ctx
      args forEach: [it collectGoEqTypesInto: types :ctx]
    ]
  | IrLambda => [body collectGoEqTypesInto: types :ctx]
  | IrBlockExpr => [block collectGoEqTypesInto: types :ctx]
  | IrMatchExpr => [
      subject collectGoEqTypesInto: types :ctx
      cases forEach: [c ->
        c condition collectGoEqTypesInto: types :ctx
        c additionalConditions forEach: [it collectGoEqTypesInto: types :ctx]
        c body collectGoEqTypesInto: types :ctx
      ]
      elseBranch ifNotNull: [elseBlock -> elseBlock collectGoEqTypesInto: types :ctx]
    ]
  | IrNewExpr => [args forEach: [it collectGoEqTypesInto: types :ctx]]
  | IrCollectionLiteral => [items forEach: [it collectGoEqTypesInto: types :ctx]]
  | IrOpBin => [
      compareTypeMaybe = this goEqOperandType: ctx
      | compareTypeMaybe | null => []
      |=> [
        types add: compareTypeMaybe
        ()
      ]
      left collectGoEqTypesInto: types :ctx
      right collectGoEqTypesInto: types :ctx
    ]
]
