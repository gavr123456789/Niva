type GoBackend

type GoSymbolTable
   typeNames: Map(String, String)
   funcNames: Map(String, String)
packageNames: Map(String, String)
   fileNames: Map(String, String)
 fieldNames: Map(String, Set(String))
constructorFieldTypes: Map(String, List(IrTypeRef))
unionTypeIds: Set(String)
unionDefs: Map(String, IrUnionDef)

type GoImportPlan
  importsByFile: Map(String, Set(String))

type GoFragment
   pkgId: String
 fileKey: String
orderKey: String
 imports: List(String)
    code: String

type GoFragmentFrame
 ctx: GoContext
  sb: StringBuilder

type GoFile
       path: String
packageName: String
    imports: List(String)
       body: String

type GoIrError
  message: String

type GoContext
  symbols: GoSymbolTable
  imports: mut Set(String)

constructor GoContext forSymbols(symbols): GoSymbolTable -> GoContext =
  GoContext symbols: symbols imports: #()!

GoContext addImport(name): String -> Unit = [
  imports add: name
]

type GoScope
               locals: mut Set(String)
        pointerLocals: mut Set(String)
nullablePointerLocals: mut Set(String)
narrowedNullablePointerLocals: mut Set(String)
 implicitFields: mut Set(String)
implicitUnionFields: mut Set(String)
unitReturnValue: Bool

constructor GoScope new = GoScope locals: #()! pointerLocals: #()! nullablePointerLocals: #()! narrowedNullablePointerLocals: #()! implicitFields: #()! implicitUnionFields: #()! unitReturnValue: false

GoScope copy -> GoScope = [
  newLocals::mut Set(String) = #()!
  newPointers::mut Set(String) = #()!
  newNullablePointers::mut Set(String) = #()!
  newNarrowedNullablePointers::mut Set(String) = #()!
  newImplicitFields::mut Set(String) = #()!
  newImplicitUnionFields::mut Set(String) = #()!
  newUnitReturnValue = unitReturnValue
  newLocals addAll: locals
  newPointers addAll: pointerLocals
  newNullablePointers addAll: nullablePointerLocals
  newNarrowedNullablePointers addAll: narrowedNullablePointerLocals
  newImplicitFields addAll: implicitFields
  newImplicitUnionFields addAll: implicitUnionFields

  ^ GoScope locals: newLocals pointerLocals: newPointers nullablePointerLocals: newNullablePointers narrowedNullablePointerLocals: newNarrowedNullablePointers implicitFields: newImplicitFields implicitUnionFields: newImplicitUnionFields unitReturnValue: newUnitReturnValue
]

GoScope copyWithUnitReturnValue(value): Bool -> GoScope = [
  copied = this copy
  GoScope locals: copied locals pointerLocals: copied pointerLocals nullablePointerLocals: copied nullablePointerLocals narrowedNullablePointerLocals: copied narrowedNullablePointerLocals implicitFields: copied implicitFields implicitUnionFields: copied implicitUnionFields unitReturnValue: value
]

GoScope addGoArg(arg): IrArg ctx: GoContext -> Unit = [
  locals add: arg name
  (ctx needsGoNullablePointerFor: arg typeRef) ifTrue: [nullablePointerLocals add: arg name]
]

IrExpr goBlockMaybe -> IrBlock? =
  | this
  | IrBlockExpr => block
  |=> null

GoContext emitResult: IrExpr? sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  blockMaybe = | emitResult
    | null => null
    |=> emitResult goBlockMaybe
  | blockMaybe
  | null => [
    hasErrors = retType errors isNotEmpty
    retType isGoUnitType
      ifFalse: [
        | emitResult
        | null => [TO DO: "bug: Go emitResult: missing result for non-Unit return"]
        |=> [
          emitResult token printGoLine-intoSb: sb
          emitResult isGoBoolConditional ifTrue: [
            this emitBoolConditionalResult: emitResult sb: sb indent: indent retType: retType scope: scope
          ] ifFalse: [
            isNothingType = (emitResult typeRef typeId goNormalizeTypeId) == "core_Nothing"
            isNullValue = emitResult isGoNullLiteral
            isNothing = isNothingType && (isNullValue not)
            isNothing ifTrue: [
              sb appendIndent: indent line: (emitResult toGoStatement: this scope: scope returnType: retType)
              sb appendIndent: indent line: "panic(\"unreachable\")"
            ] ifFalse: [
              exprStr = (this needsGoNullablePointerFor: retType)
                ifTrue: [emitResult toGoNullableInitExpr: this scope: scope targetType: retType]
                ifFalse: [emitResult toGoExpr: this scope: scope]
              line = hasErrors
                ifTrue:  ["return " + exprStr + ", nil"]
               ifFalse: ["return " + exprStr]
              sb appendIndent: indent line: line
            ]
          ]
        ]
      ]
      ifTrue: [
        | emitResult
        | null => []
        |=> [
          emitResult token printGoLine-intoSb: sb
          sb appendIndent: indent
                 line: (emitResult toGoStatement: this scope: scope returnType: retType) ]
      ]
  ]
  |=> [
    blockScope = scope copyWithUnitReturnValue: false
    sb appendIndent: indent line: "{"
    blockMaybe blockToGoStatements: this scope: blockScope sb: sb indent: (indent + 1) returnType: retType
    blockResultMaybe = blockMaybe result
    | blockResultMaybe
    | null => [
      blockMaybe hasTrailingReturn ifFalse: [
        this emitResult: null sb: sb indent: (indent + 1) retType: retType scope: blockScope
      ]
    ]
    |=> [this emitResult: blockResultMaybe sb: sb indent: (indent + 1) retType: retType scope: blockScope]
    sb appendIndent: indent line: "}"
  ]
]

GoContext emitBlockResult(block): IrBlock sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  blockResult = block result
  hasTrailingReturn = block hasTrailingReturn
  | blockResult
  | null => [
      hasTrailingReturn ifFalse: [
        this emitResult: null sb: sb indent: indent retType: retType scope: scope
      ]
    ]
  |=> [this emitResult: blockResult sb: sb indent: indent retType: retType scope: scope]
]

GoContext emitBlockResultAndReturn(block): IrBlock sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope returnStmt: String -> Unit = [
  this emitBlockResult: block sb: sb indent: indent retType: retType scope: scope
  retType isGoUnitType ifTrue: [sb appendIndent: indent line: returnStmt]
]

extend String [
  on goNormalizeTypeId -> String = [
    hasGeneric = this contains: "__"
    result = hasGeneric
        ifTrue: [this substringBefore: "__"]
       ifFalse: [this]
    ^ result
  ]

]

IrTypeRef coreFuncNameFromCall(name): String forMut(isMutable): Bool -> String = [
  baseId = typeId goNormalizeTypeId
  recvBase = baseId stripPkgPrefix: "core"
  recvBaseSafe = recvBase toSafeGoIdent
  normalized = (isMutable ifTrue: ["mut_"] ifFalse: [""]) + (name goSanitizeIdent)

  // generics monomorphizes in nin, but Any__echo has a single impl, not Int__echo Person__echo for every type
  // this should be solved by lazily generating ?__echo methods for everything or something elce
  x = name == "echo"
        ifTrue: ["Any__echo"]
        ifFalse: [recvBaseSafe + "__" + normalized]

  ^ x

]

IrCall toGoTryExpr(ctx): GoContext scope: GoScope -> String = [
  input = args first
  inputType = input typeRef
  hasErrors = inputType errors isNotEmpty
  isNullable = inputType nullable
  msgNameMaybe = msgName
  isOrPanic = | msgNameMaybe
    | null => false
    |=> (msgNameMaybe == "orPANIC") || (msgNameMaybe == "unpackOrPANIC")
  inputHasNoValue = inputType isGoUnitType && (isNullable not)
  inputStr = input toGoExpr: ctx scope: scope
  outputType = typeRef
  outputHasErrors = outputType errors isNotEmpty

  sb = StringBuilder new
  sb append: "func()"
  sb append: (outputType goReturnTypes: ctx)
  sb appendLine: " {"

  valueName = "__tryValue"
  errName = "__tryErr"
  hasErrors ifTrue: [
    inputHasNoValue
      ifTrue: [sb appendIndent: 1 line: (errName + " := " + inputStr)]
      ifFalse: [sb appendIndent: 1 line: (valueName + ", " + errName + " := " + inputStr)]
    errorReturn = isOrPanic ifTrue: ["panic(" + errName + ")"] ifFalse: [
      outputType isGoUnitType
        ifTrue: ["return " + errName]
        ifFalse: ["return " + (outputType goZeroValue: ctx) + ", " + errName]
    ]
    sb appendIndent: 1 line: ("if " + errName + " != nil { " + errorReturn + " }")
  ] ifFalse: [
    sb appendIndent: 1 line: (valueName + " := " + inputStr)
  ]

  isNullable ifTrue: [
    sb appendIndent: 1 line: ("if " + valueName + " == nil { panic(\"try on null\") }")
    outputType isGoUnitType
      ifTrue: [sb appendIndent: 1 line: (outputHasErrors ifTrue: ["return nil"] ifFalse: ["return"])]
      ifFalse: [
        (ctx isGoNullableReferenceValue: inputType)
          ifTrue: [sb appendIndent: 1 line: ("return " + valueName + (outputHasErrors ifTrue: [", nil"] ifFalse: [""]))]
          ifFalse: [sb appendIndent: 1 line: ("return *" + valueName + (outputHasErrors ifTrue: [", nil"] ifFalse: [""]))]
      ]
  ] ifFalse: [
    outputType isGoUnitType
      ifTrue: [sb appendIndent: 1 line: (outputHasErrors ifTrue: ["return nil"] ifFalse: ["return"])]
      ifFalse: [sb appendIndent: 1 line: ("return " + valueName + (outputHasErrors ifTrue: [", nil"] ifFalse: [""]))]
  ]

  sb append: "}()"
  ^ sb toString
]

GoContext goTypeNameFor(typeId): String -> String = [
  baseId = typeId goNormalizeTypeId
  existing = symbols typeNames at: baseId
  ^ | existing
    | null => ""
    |=> existing
]

GoContext goFieldNamesFor(typeId): String -> Set(String) = [
  resultFields::mut Set(String) = #()!
  normalizedTypeId = typeId goNormalizeTypeId
  symbols fieldNames forEach: [key, names ->
    (key == normalizedTypeId) ifTrue: [resultFields addAll: names]
  ]
  ^ resultFields toSet
]

GoContext isGoUnionType(typeId): String -> Bool =
  symbols unionTypeIds contains: (typeId goNormalizeTypeId)

GoContext isGoNullableReferenceValue(typeRef): IrTypeRef -> Bool =
  (typeRef isGoNullableReferenceValue) ||
    ((typeRef kind == IrTypeRefKind.Custom) && (this isGoUnionType: typeRef typeId))

GoContext needsGoNullablePointerFor(typeRef): IrTypeRef -> Bool =
  typeRef nullable && ((this isGoNullableReferenceValue: typeRef) not)

GoContext goFieldGetterName(fieldName): String -> String =
  "nivaField__" + (fieldName toSafeGoIdent)

GoSymbolTable collectUnionBranchTypes(typeId): String seenUnions: mut Set(String) concreteTypes: mut Set(String) -> Unit = [
  normalizedTypeId = typeId goNormalizeTypeId
  (seenUnions contains: normalizedTypeId) ifFalse: [
    seenUnions add: normalizedTypeId
    unionMaybe = unionDefs at: normalizedTypeId
    | unionMaybe
    | null => [concreteTypes add: normalizedTypeId]
    |=> [
      unionMaybe branches forEach: [branch ->
        branchTypeId = unionMaybe pkgId + "_" + branch name
        branch isInclude
          ifTrue: [this collectUnionBranchTypes: branchTypeId seenUnions: seenUnions concreteTypes: concreteTypes]
          ifFalse: [concreteTypes add: (branchTypeId goNormalizeTypeId)]
      ]
    ]
  ]
]

GoSymbolTable concreteUnionBranchTypeIds(typeId): String -> List(String) = [
  seenUnions::mut Set(String) = #()!
  concreteTypes::mut Set(String) = #()!
  this collectUnionBranchTypes: typeId seenUnions: seenUnions concreteTypes: concreteTypes
  ^ concreteTypes toList
]

GoSymbolTable collectContainingUnionTypeIds(typeId): String seen: mut Set(String) result: mut Set(String) -> Unit = [
  normalizedTypeId = typeId goNormalizeTypeId
  (seen contains: normalizedTypeId) ifFalse: [
    seen add: normalizedTypeId
  unionDefs forEach: [parentId, parentDef ->
    includesType = parentDef branches any: [branch ->
      branch isInclude && ((parentDef pkgId + "_" + branch name goNormalizeTypeId) == normalizedTypeId)
    ]
    includesType ifTrue: [
      result add: parentId
      this collectContainingUnionTypeIds: parentId seen: seen result: result
    ]
  ]
  ]
]

GoSymbolTable containingUnionTypeIds(typeId): String -> List(String) = [
  seen::mut Set(String) = #()!
  result::mut Set(String) = #()!
  this collectContainingUnionTypeIds: typeId seen: seen result: result
  ^ result toList sortedBy: [it]
]

IrFunction goSymbolKey -> String = (id substringBefore: "__ctor_") + "__arity_" + (args count toString)

IrCall goSymbolKey(id): String -> String = [
  baseId = isConstructor ifTrue: [id substringBefore: "__ctor_"] ifFalse: [id]
  baseId + "__arity_" + (paramTypes count toString)
]

IrCall toGoNullableOptionExpr(ctx): GoContext call(callExpr): String -> String = [
  nullableGoType = typeRef toGoType: ctx
  baseGoType = typeRef goBaseType: ctx
  optionValue = (ctx needsGoNullablePointerFor: typeRef)
    ifTrue: ["core.NewNullable(" + baseGoType + "(__nivaOption.Value))"]
    ifFalse: ["__nivaOption.Value"]
  ^ "func() " + nullableGoType + " { __nivaOption := " + callExpr +
    "; if !__nivaOption.HasValue { return " + (typeRef goZeroValue: ctx) +
    " }; return " + optionValue + " }()"
]

IrFunction goFuncNameFromIr -> String = [
  recvId = receiverType typeId


  recvBase = pkgId != ""
              ifTrue:  [ recvId stripPkgPrefix: pkgId ]
             ifFalse: [ recvId ],
             goSanitizeIdent

  sel = name goSanitizeIdent

  full =
    pkgId != ""
      ifTrue: [ pkgId + "__" + recvBase + "__" + sel ]
     ifFalse: [ recvBase + "__" + sel ]

  ^ full toSafeGoIdent
]

extend GoContext [
  on goFuncNameForFn(fn): IrFunction -> String = [
    ^ this goFuncNameFor: (fn goSymbolKey)
  ]

  on goFuncNameFor(funcId): String -> String = [
    existing = symbols funcNames at: funcId
    ^ | existing
      | null => ""
      |=> existing
  ]

]

IrUnionDef goBranchTypeIds -> List(String) = [
  ids::mut List(String) = {}!
  branches forEach: [br ->
    br isInclude ifFalse: [
      ids add: (pkgId + "_" + br name)
    ]
  ]
  ^ ids toList
]

Int goIndent -> String = [
  sb = StringBuilder new
  mut i = 0
  [i < this] whileTrue: [
    sb append: "    "
    i <- i inc
  ]
  ^ sb toString
]

StringBuilder appendIndent(level): Int line: String -> Unit = [
  this append: (level goIndent)
  this appendLine: line
  ()
]

GoContext emitLambdaBranchResult(branch): IrExpr sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  | branch
  | IrLambda => [
    branchScope = scope copy
    branch args forEach: [arg -> branchScope addGoArg: arg ctx: this]
    branch body blockToGoStatements: this scope: branchScope sb: sb indent: indent returnType: retType
    branchResult = branch body result
    bodyHasTrailingReturn = branch body hasTrailingReturn
    | branchResult
    | null => [
      bodyHasTrailingReturn ifFalse: [
        retType isGoUnitType
          ifTrue: [sb appendIndent: indent line: "return"]
          ifFalse: [sb appendIndent: indent line: "panic(\"missing branch result\")"]
      ]
    ]
    |=> [
      this emitResult: branchResult sb: sb indent: indent retType: retType scope: branchScope
      (retType isGoUnitType && (bodyHasTrailingReturn not)) ifTrue: [
        sb appendIndent: indent line: "return"
      ]
    ]
  ]
  |=> sb appendIndent: indent line: "panic(\"invalid boolean branch\")"
]

GoContext emitBoolConditionalResult(call): IrExpr sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  | call
  | IrCall => [
    args = call args
    condition = args first toGoExpr: this scope: scope
    msgNameMaybe = call msgName
    msgNameLocal = | msgNameMaybe
      | null => ""
      |=> msgNameMaybe
    isFalseFirst = (msgNameLocal == "ifFalse_ifTrue") || (msgNameLocal == "ifFalse__ifTrue")
    trueBranch = isFalseFirst ifTrue: [args at: 2] ifFalse: [args at: 1]
    falseBranch = isFalseFirst ifTrue: [args at: 1] ifFalse: [args at: 2]
    sb appendIndent: indent line: ("if " + condition + " {")
    this emitLambdaBranchResult: trueBranch sb: sb indent: (indent + 1) retType: retType scope: scope
    sb appendIndent: indent line: "} else {"
    this emitLambdaBranchResult: falseBranch sb: sb indent: (indent + 1) retType: retType scope: scope
    sb appendIndent: indent line: "}"
  ]
  |=> []
]

GoContext emitBoolMatchBranch(branchCase): IrMatchCase sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope -> Unit = [
  branchScope = scope copy
  branchBlock = branchCase body
  branchBlock blockToGoStatements: this scope: branchScope sb: sb indent: indent returnType: returnType
  branchResultMaybe = branchBlock result
  | branchResultMaybe
  | null => []
  |=> branchResultMaybe emitAsStmt: this scope: branchScope sb: sb indent: indent returnType: returnType
]

GoContext emitBoolMatchStatement(matchExpr): IrMatchExpr sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope -> Unit = [
  mut trueCase::IrMatchCase? = null
  mut falseCase::IrMatchCase? = null
  matchExpr cases forEach: [branchCase ->
    conditionStr = branchCase condition toGoExpr: this scope: scope
    conditionStr == "true" ifTrue: [trueCase <- branchCase]
    conditionStr == "false" ifTrue: [falseCase <- branchCase]
  ]

  subjectExpr = matchExpr subject toGoExpr: this scope: scope
  trueCaseMaybe = trueCase
  falseCaseMaybe = falseCase
  elseBranchMaybe = matchExpr elseBranch

  trueCaseMaybe != null ifTrue: [
    trueBranchCase::IrMatchCase = | trueCaseMaybe
      | null => TO DO: "Missing true case in boolean match"
      |=> trueCaseMaybe
    sb appendIndent: indent line: ("if " + subjectExpr + " {")
    this emitBoolMatchBranch: trueBranchCase sb: sb indent: (indent + 1) returnType: returnType scope: scope
    falseCaseMaybe != null ifTrue: [
      falseBranchCase::IrMatchCase = | falseCaseMaybe
        | null => TO DO: "Missing false case in boolean match"
        |=> falseCaseMaybe
      sb appendIndent: indent line: "} else {"
      this emitBoolMatchBranch: falseBranchCase sb: sb indent: (indent + 1) returnType: returnType scope: scope
    ] ifFalse: [
      | elseBranchMaybe
      | null => []
      |=> [
        sb appendIndent: indent line: "} else {"
        elseScope = scope copy
        elseBranchMaybe blockToGoStatements: this scope: elseScope sb: sb indent: (indent + 1) returnType: returnType
        elseResultMaybe = elseBranchMaybe result
        | elseResultMaybe
        | null => []
        |=> elseResultMaybe emitAsStmt: this scope: elseScope sb: sb indent: (indent + 1) returnType: returnType
      ]
    ]
    sb appendIndent: indent line: "}"
  ] ifFalse: [
    falseCaseMaybe != null ifTrue: [
      falseBranchCase::IrMatchCase = | falseCaseMaybe
        | null => TO DO: "Missing false case in boolean match"
        |=> falseCaseMaybe
      sb appendIndent: indent line: ("if !(" + subjectExpr + ") {")
      this emitBoolMatchBranch: falseBranchCase sb: sb indent: (indent + 1) returnType: returnType scope: scope
      | elseBranchMaybe
      | null => []
      |=> [
        sb appendIndent: indent line: "} else {"
        elseScope = scope copy
        elseBranchMaybe blockToGoStatements: this scope: elseScope sb: sb indent: (indent + 1) returnType: returnType
        elseResultMaybe = elseBranchMaybe result
        | elseResultMaybe
        | null => []
        |=> elseResultMaybe emitAsStmt: this scope: elseScope sb: sb indent: (indent + 1) returnType: returnType
      ]
      sb appendIndent: indent line: "}"
    ]
  ]
]

IrExpr isGoBoolConditional -> Bool =
  | this
  | IrCall => [
    msgNameMaybe = msgName
    msgNameLocal = | msgNameMaybe
      | null => ""
      |=> msgNameMaybe
    ((msgNameLocal == "ifTrue__ifFalse") || (msgNameLocal == "ifFalse_ifTrue") ||
      (msgNameLocal == "ifFalse__ifTrue")) && (args count > 2)
  ]
  |=> false

GoImportPlan importsForFile(fileKey): String -> List(String) = [
  imports = importsByFile at: fileKey
  ^ | imports
    | null => {}
    |=> imports toList
]

extend IrTypeRef [

  on isGoNullableReferenceValue -> Bool =
    (kind == IrTypeRefKind.Function) ||
      ((kind == IrTypeRefKind.Builtin) && ((this isGoRefLike) || ((typeId goNormalizeTypeId) == "core_Any") || ((typeId goNormalizeTypeId) == "core_Error")))

  // Nullable simple types should be pointers in go
  // lists, maps, functions and interfaces can use nil
  on isGoUnitType -> Bool =
    typeId goNormalizeTypeId == "core_Unit"

  on goZeroValue(ctx): GoContext -> String = [
    ^ nullable ifTrue: ["nil"] ifFalse: [
      kind == IrTypeRefKind.Builtin ifTrue: [
          baseId = typeId goNormalizeTypeId
          isZeroNumber = (baseId == "core_Int") || (baseId == "core_Long") ||
            (baseId == "core_Int64") || (baseId == "core_Double") ||
            (baseId == "core_Float") || (baseId == "core_Char")
          isZeroNumber ifTrue: ["0"] ifFalse: [
            baseId == "core_String" ifTrue: ["\"\""] ifFalse: [
              baseId == "core_Bool" ifTrue: ["false"] ifFalse: [
                baseId == "core_Unit" ifTrue: ["core.UnitInstance"] ifFalse: ["nil"]
              ]
            ]
          ]
        ] ifFalse: [
        kind == IrTypeRefKind.Custom
          ifTrue: [(ctx goTypeNameFor: (typeId goNormalizeTypeId)) + "{}"]
          ifFalse: ["nil"]
      ]
    ]
  ]

  on goReturnTypes(ctx): GoContext -> String = [
    hasErr = errors isNotEmpty
    isUnit = this isGoUnitType
    ^ hasErr
        ifTrue: [
          isUnit ifTrue: [" error"] ifFalse: [" (" + (this toGoType: ctx) + ", error)"]
        ]
        ifFalse: [
          isUnit ifTrue: [""] ifFalse: [" " + (this toGoType: ctx)]
        ]
  ]

  on goBaseType(ctx): GoContext -> String = [
    baseId = typeId goNormalizeTypeId
    ^ kind == IrTypeRefKind.Function ifTrue: [
          argsStr = args joinWith: ", " transform: [it toGoParamType: ctx]
          retTypeMaybe = returnType
          retStr = | retTypeMaybe
                   | null => ""
                   |=> retTypeMaybe isGoUnitType ifTrue: [""] ifFalse: [retTypeMaybe toGoType: ctx]
          retStr == "" ifTrue: ["func(" + argsStr + ")"]
                      ifFalse: ["func(" + argsStr + ") " + retStr]
        ] ifFalse: [
      (baseId == "core_Unit") ifTrue: ["struct{}"] ifFalse: [
      kind == IrTypeRefKind.Builtin ifTrue: [
          (baseId == "core_Long") || (baseId == "core_Int64")
            ifTrue: ["int64"] ifFalse: [
          | baseId
          | "core_Int"     => "int"
          | "core_Double"  => "float64"
          | "core_Float"   => "float32"
          | "core_String"  => "string"
          | "core_Bool"    => "bool"
          | "core_Char"    => "rune"
          | "core_Unit"    => "struct{}"
          | "core_Any"     => "interface{}"
          | "core_Nothing" => "interface{}"
          | "core_Null"    => "interface{}"
          | "core_Error"   => "error"
          | "core_Compiler" => "struct{}"
          | "core_StringBuilder" => [
              ctx addImport: "niva_go/core"
              "*core.StringBuilder"
            ]
          | "core_List"    => [
              elem = args isNotEmpty ifTrue: [args first toGoType: ctx] ifFalse: ["interface{}"]
              "[]" + elem
            ]
          | "core_Set" => [
              elem = args isNotEmpty ifTrue: [args first toGoType: ctx] ifFalse: ["interface{}"]
              "map[" + elem + "]struct{}"
            ]
          | "core_Map" => [
              keyType = args count > 0 ifTrue: [args at: 0, toGoType: ctx] ifFalse: ["interface{}"]
              valType = args count > 1 ifTrue: [args at: 1, toGoType: ctx] ifFalse: ["interface{}"]
              "map[" + keyType + "]" + valType
            ]
          |=> ctx goTypeNameFor: baseId
          ]
        ] ifFalse: [
          baseId isGeneric ifTrue: [baseId toSafeGoIdent] ifFalse: [
          name = ctx goTypeNameFor: baseId
          argsStr = args isNotEmpty
            ifTrue: ["[" + (args joinWith: ", " transform: [it toGoType: ctx]) + "]"]
           ifFalse: [""]
          name + argsStr
          ]
        ]
      ]
      ]
  ]

  on toGoType(ctx): GoContext -> String = [
    base = this goBaseType: ctx
    ^ nullable
        ifTrue: [
          // already reference-like types can be nil without pointer
          isAny = base == "any"
          isIfaceStr = base == "interface{}"
          isIface = isAny || isIfaceStr

          isRefLike = (this isGoRefLike) || isIface || ((kind == IrTypeRefKind.Custom) && (ctx isGoUnionType: typeId))
          isRefLike ifTrue: [base] ifFalse: ["*" + base]
        ]
        ifFalse: [base]
  ]

  on toGoParamType(ctx): GoContext -> String =
    this isGoPointerParam,
      ifTrue: [
        (nullable && (typeId goNormalizeTypeId != "core_List"))
          ifTrue: [this toGoType: ctx]
          ifFalse: ["*" + (this goBaseType: ctx)]
      ]
      ifFalse: [this toGoType: ctx]

]

String goEscapeString -> String = [
  escapedSlashes = this replace: "\\" with: "\\\\"
  escapedQuotes = escapedSlashes replace: "\"" with: "\\\""
  escapedNewlines = escapedQuotes replace: "\n" with: "\\n"
  escapedReturns = escapedNewlines replace: "\r" with: "\\r"
  escapedTabs = escapedReturns replace: "\t" with: "\\t"
  ^ escapedTabs
]

IrLiteral toGoLiteral -> String = [
  kind == IrLiteralKind.Null ifTrue: ["nil"] ifFalse: [
    kind == IrLiteralKind.Unit ifTrue: ["core.UnitInstance"] ifFalse: [
      kind == IrLiteralKind.Bool ifTrue: [lexeme] ifFalse: [
        kind == IrLiteralKind.Int ifTrue: [lexeme] ifFalse: [
          kind == IrLiteralKind.Double ifTrue: [lexeme] ifFalse: [
            kind == IrLiteralKind.Float ifTrue: [
              lexeme endsWith: "f", ifTrue: [lexeme dropLast: 1] ifFalse: [lexeme]
            ] ifFalse: [
              kind == IrLiteralKind.Char ifTrue: [lexeme] ifFalse: [
                kind == IrLiteralKind.String ifTrue: [lexeme] ifFalse: [
                  kind == IrLiteralKind.RawString ifTrue: [
                    rawContent = (lexeme drop: 3) dropLast: 3
                    "\"" + (rawContent goEscapeString) + "\""
                  ] ifFalse: ["\"" + lexeme + "\""]
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ]
]

IrCall tryGoBindExpr(ctx): GoContext scope: GoScope -> String? = null

// collect all IrVarRef names from an IR block (for match alias usage check)
IrBlock collectIrRefNames -> mut Set(String) = [
  refs::mut Set(String) = #()!
  stmts forEach: [it collectIrStmtRefs: refs]
  resultMaybe = result
  | resultMaybe
  | null => []
  |=> resultMaybe collectIrExprRefs: refs
  ^ refs
]

IrStmt collectIrStmtRefs(refs): mut Set(String) -> Unit = [
  | this
  | IrLet      => [
      valueMaybe = value
      | valueMaybe
      | null => []
      |=> valueMaybe collectIrExprRefs: refs
    ]
  | IrSetLocal => [ value collectIrExprRefs: refs ]
  | IrSetField => [ receiver collectIrExprRefs: refs
                    value collectIrExprRefs: refs ]
  | IrDestructure => [ value collectIrExprRefs: refs ]
  | IrExprStmt    => [ expr collectIrExprRefs: refs ]
  | IrReturn      => [
      exprMaybe = expr
      | exprMaybe
      | null => []
      |=> exprMaybe collectIrExprRefs: refs
    ]
  | IrWhile       => [ cond collectIrExprRefs: refs
                       body collectIrExprRefs: refs ]
  | IrThrow       => [ errExpr collectIrExprRefs: refs ]
]

IrExpr collectIrExprRefs(refs): mut Set(String) -> Unit = [
  | this
  | IrVarRef      => refs add: name
  | IrLiteralExpr => []
  | IrThisRef     => []
  | IrFieldGet    => receiver collectIrExprRefs: refs
  | IrCall        => [
    calleeMaybe = callee
    | calleeMaybe
    | null => []
    |=> calleeMaybe collectIrExprRefs: refs
    args forEach: [it collectIrExprRefs: refs]
  ]
  | IrLambda    => body collectIrRefNames forEach: [refs add: it]
  | IrBlockExpr => block collectIrRefNames forEach: [refs add: it]
  | IrMatchExpr => [
    subject collectIrExprRefs: refs
    cases forEach: [c ->
      c condition collectIrExprRefs: refs
      c additionalConditions forEach: [it collectIrExprRefs: refs]
      c body collectIrRefNames forEach: [refs add: it]
    ]
    elseBranchMaybe = elseBranch
    | elseBranchMaybe
    | null => []
    |=> elseBranchMaybe collectIrRefNames forEach: [refs add: it]
  ]
  | IrNewExpr           => args forEach: [it collectIrExprRefs: refs]
  | IrCollectionLiteral => items forEach: [it collectIrExprRefs: refs]
  | IrOpBin             => [
    left collectIrExprRefs: refs
    right collectIrExprRefs: refs
  ]
  | IrTypeRefExpr => []
]


extend IrExpr [
  on goLocalVarName -> String? =
    | this
    | IrVarRef => name
    |=> null

  on isGoNullLiteral -> Bool =
    | this
    | IrLiteralExpr => literal kind == IrLiteralKind.Null
    |=> false

  on goIsPointerArg(scope): GoScope -> Bool =
    | this
    | IrVarRef => scope pointerLocals contains: name
    | IrThisRef => scope pointerLocals contains: "this"
    |=> false

  on toGoNullableInitExpr(ctx): GoContext scope: GoScope targetType: IrTypeRef -> String = [
    valueStr = this toGoExpr: ctx scope: scope
    isNull = this isGoNullLiteral

    result = (typeRef nullable || isNull) ifTrue: [valueStr] ifFalse: [
        ctx addImport: "niva_go/core"
        targetGoType = targetType goBaseType: ctx
        "core.NewNullable(" + targetGoType + "(" + valueStr + "))"
      ]
    ^ result
  ]

  on toGoLocalAssignExpr(ctx): GoContext scope: GoScope targetIsNullable: Bool -> String = [
    valueStr = this toGoExpr: ctx scope: scope
    isNull = this isGoNullLiteral
    sourceIsNullablePointer = ctx needsGoNullablePointerFor: typeRef
    result = targetIsNullable ifTrue: [
        sourceIsNullablePointer || isNull
          ifTrue: [valueStr]
          ifFalse: [
            ctx addImport: "niva_go/core"
            sourceGoType = typeRef goBaseType: ctx
            "core.NewNullable(" + sourceGoType + "(" + valueStr + "))"
          ]
      ]
      ifFalse: [
        (sourceIsNullablePointer && (isNull not)) ifTrue: ["*" + valueStr] ifFalse: [valueStr]
      ]
    ^ result
  ]

  on toGoArgExpr(ctx): GoContext scope: GoScope paramType: IrTypeRef -> String = [
    exprStr = | this
      | IrLambda => this toGoLambdaExpr: ctx scope: scope expectedType: paramType
      |=> this toGoExpr: ctx scope: scope
    sourceNullablePointer = ctx needsGoNullablePointerFor: typeRef
    targetNullablePointer = ctx needsGoNullablePointerFor: paramType
    isNull = this isGoNullLiteral
    sourceIsNullablePointerRef = | this
      | IrVarRef => (scope nullablePointerLocals contains: name) &&
        (scope narrowedNullablePointerLocals contains: name, not)
      |=> sourceNullablePointer
    isAddressable = | this
      | IrVarRef => true
      | IrThisRef => true
      |=> false
    valueExpr = sourceIsNullablePointerRef && (paramType nullable not)
      ifTrue: ["*" + exprStr]
      ifFalse: [
        (targetNullablePointer && (sourceNullablePointer not) && (isNull not))
          ifTrue: [
            isAddressable
              ifTrue: ["&" + exprStr]
              ifFalse: [
                targetGoType = paramType goBaseType: ctx
                "func() *" + targetGoType + " { __nivaArg := " + exprStr + "; return &__nivaArg }()"
              ]
          ]
          ifFalse: [exprStr]
      ]

    paramType needsGoAddressAtCall,
      ifTrue: [(this goIsPointerArg: scope) ifTrue: [valueExpr] ifFalse: ["&" + valueExpr]]
      ifFalse: [valueExpr]
  ]

  on toGoLambdaExpr(ctx): GoContext scope: GoScope expectedType: IrTypeRef -> String = [
    | this
    | IrLambda => [
    argsStr = args joinWith: ", " transform: [a -> (a name toSafeGoIdent) + " " + (a typeRef toGoParamType: ctx)]
    lambdaType = expectedType kind == IrTypeRefKind.Function ifTrue: [expectedType] ifFalse: [typeRef]
    retTypeMaybe = lambdaType returnType
    retType = | retTypeMaybe
      | null => typeRef
      |=> retTypeMaybe
    retStr = retType isGoUnitType ifTrue: [""] ifFalse: [" " + (retType toGoType: ctx)]
    sb = StringBuilder new
    sb append: "func("
    sb append: argsStr
    sb append: ")"
    sb append: retStr
    sb appendLine: " {"

    innerScope = scope copy
    args forEach: [arg -> innerScope addGoArg: arg ctx: ctx]
    body blockToGoStatements: ctx scope: innerScope sb: sb indent: 1 returnType: retType
    bodyResult = body result
    bodyHasTrailingReturn = body hasTrailingReturn
    retType isGoUnitType
      ifTrue: [
        ctx emitResult: bodyResult sb: sb indent: 1 retType: retType scope: innerScope
        retType errors isNotEmpty ifTrue: [
          bodyHasTrailingReturn ifFalse: [sb appendIndent: 1 line: "return nil"]
        ]
      ]
      ifFalse: [
        bodyResult == null
          ifTrue: [
            bodyHasTrailingReturn ifFalse: [
              ctx emitResult: null sb: sb indent: 1 retType: retType scope: innerScope
            ]
          ]
          ifFalse: [ctx emitResult: bodyResult sb: sb indent: 1 retType: retType scope: innerScope]
      ]
    sb append: "}"
    sb toString
    ]
    |=> this toGoExpr: ctx scope: scope
  ]

  on toGoExpr(ctx): GoContext scope: GoScope -> String =
    | this
    | IrLiteralExpr => [
        isEnumAtom = (literal kind == IrLiteralKind.Atom) &&
                     (typeRef kind == IrTypeRefKind.Custom)
        isEnumAtom
          ifTrue: [(ctx goTypeNameFor: typeRef typeId) + "_" + (literal lexeme toSafeGoIdent)]
          ifFalse: [literal toGoLiteral]
    ]
    | IrVarRef      => [
        goName = name toSafeGoIdent
        isLocal = scope locals contains: name
        isImplicitField = (scope implicitFields contains: name) && (isLocal not)
        isNarrowed = (scope nullablePointerLocals contains: name) &&
          (scope narrowedNullablePointerLocals contains: name)
        isImplicitUnionField = scope implicitUnionFields contains: name
        isImplicitField ifTrue: [
          isImplicitUnionField
            ifTrue: ["this." + (ctx goFieldGetterName: name) + "()"]
            ifFalse: ["this." + goName]
        ] ifFalse: [
          isNarrowed ifTrue: ["*" + goName] ifFalse: [goName]
        ]
      ]
    | IrThisRef  => "this"
  | IrFieldGet => [
    recv = receiver toGoExpr: ctx scope: scope
    isUnion = ctx isGoUnionType: receiver typeRef typeId
    isUnion
      ifTrue: ["(" + recv + ")." + (ctx goFieldGetterName: field) + "()"]
      ifFalse: ["(" + recv + ")." + (field toSafeGoIdent)]
      ]
    | IrTypeRefExpr => ref toGoType: ctx
    | IrOpBin       => [
        l = left toGoExpr: ctx scope: scope
        r = right toGoExpr: ctx scope: scope
        "(" + l + " " + op + " " + r + ")"
    ]
    | IrCall => [
        msgNameMaybe = msgName
    isTry = | msgNameMaybe
      | null => false
      |=> (msgNameMaybe == "try") || (msgNameMaybe == "orPANIC") || (msgNameMaybe == "unpackOrPANIC")
        isTry ifTrue: [this toGoTryExpr: ctx scope: scope] ifFalse: [

        // new bind design: inlineable bind plan attached during IR generation
        bindMaybe = bind
        bindOutput = | bindMaybe
          | null => ""
          |=> [
            | bindMaybe
          | IrBindByName => [
              ctx addImport: bindMaybe goPkg
              byNameArgs = args mapIndexed: [i, it ->
                paramType = paramTypes at: i
                it toGoArgExpr: ctx scope: scope paramType: paramType
              ], goCallArgs
              goName = bindMaybe isGoNameExplicit
                ifTrue: [bindMaybe goName]
                ifFalse: [bindMaybe goName bindCapitalizeFirst]
              (bindMaybe goPkg goPkgQualifier) + "." + goName + "(" + byNameArgs + ")"
            ]
          | IrBindEmit => [
              // emit templates import their declared package
              importPathsMaybe = bindMaybe goPkg
              | importPathsMaybe
              | null => []
              |=> (importPathsMaybe split: ",") forEach: [ctx addImport: it]
              // $0 = receiver/this, $1 = first keyword arg, ...
              emitArgVals = args mapIndexed: [i, it ->
                paramType = paramTypes at: i
                it toGoArgExpr: ctx scope: scope paramType: paramType
              ]
              bindMaybe template bindApply0: emitArgVals
            ]
          |=> ""
        ]
        bindMaybe != null ifTrue: [bindOutput] ifFalse: [

        bindExpr = this tryGoBindExpr: ctx scope: scope
        bindExprMaybe = bindExpr
        bindExprValue = | bindExprMaybe
          | null => ""
          |=> bindExprMaybe
        bindExprMaybe != null ifTrue: [bindExprValue] ifFalse: [
        receiverTypeMaybe = receiverType
        isErrorReceiver = | receiverTypeMaybe
          | null => false
          |=> receiverTypeMaybe typeId goNormalizeTypeId == "core_Error"
        isStaticCoreReceiver = isErrorReceiver || (| receiverTypeMaybe
          | null => false
          |=> receiverTypeMaybe typeId goNormalizeTypeId == "core_Compiler")
        callArgs = isStaticCoreReceiver ifTrue: [args drop: 1] ifFalse: [args]
        argsStr = callArgs mapIndexed: [i, it ->
          paramIndex = isStaticCoreReceiver ifTrue: [i + 1] ifFalse: [i]
          paramType = paramTypes at: paramIndex
          it toGoArgExpr: ctx scope: scope paramType: paramType
        ], goCallArgs
        funcIdLocal = funcId
        | funcIdLocal
        | null => [
            calleeLocal = callee
            | calleeLocal
            | null => "panic(\"IrCall without funcId must have callee\")"
            |=> [
              calleeExpr = calleeLocal
              callExpr = "(" + (calleeExpr toGoExpr: ctx scope: scope) + ")(" + argsStr + ")"
              (typeRef isGoUnitType && typeRef errors isEmpty)
                ifTrue: ["func() struct{} { " + callExpr + "; return struct{}{} }()"]
                ifFalse: [callExpr]
            ]
          ]
        |=> [
            // if its from core => generate core.Type__funcname, if not then Pkg__
            declPkgMaybe = declPkg
            declPkgLocal = | declPkgMaybe
              | null => ""
              |=> declPkgMaybe
            declPkgLocal == "core"
              ifTrue: [
                ctx addImport: "niva_go/core"
                msgNameMaybe = msgName
                msgNameLocal = | msgNameMaybe
                  | null => ""
                  |=> msgNameMaybe
                recvTypeMaybe = receiverType
                recvTypeLocal = | recvTypeMaybe
                  | null => typeRef
                  |=> recvTypeMaybe
                mutReceiver = paramTypes isNotEmpty && (paramTypes first isMut)
                baseCoreFn = recvTypeLocal coreFuncNameFromCall: msgNameLocal forMut: mutReceiver
                isUnitBranch = (recvTypeLocal typeId goNormalizeTypeId == "core_Bool") &&
                  (typeRef isGoUnitType) &&
                  ((msgNameLocal == "ifTrue__ifFalse") || (msgNameLocal == "ifFalse_ifTrue") ||
                    (msgNameLocal == "ifFalse__ifTrue"))
                coreFn = isUnitBranch ifTrue: [baseCoreFn + "Unit"] ifFalse: [baseCoreFn]
                isMutListCall = coreFn startsWith: "List__mut_"
                coreArgs = isMutListCall
                  ifTrue: [
                    args mapIndexed: [i, it ->
                      paramType = paramTypes at: i
                      isListReceiver = i == 0
                      isListReceiver ifTrue: [
                        argStr = it toGoExpr: ctx scope: scope
                        (it goIsPointerArg: scope) ifTrue: [argStr] ifFalse: ["&" + argStr]
                      ] ifFalse: [it toGoArgExpr: ctx scope: scope paramType: paramType]
                    ], goCallArgs
                  ]
                  ifFalse: [argsStr]
                coreCall = "core." + coreFn + "(" + coreArgs + ")"
                receiverBaseId = recvTypeLocal typeId goNormalizeTypeId
                isListNullableCall = (receiverBaseId == "core_List") &&
                  ((msgNameLocal == "find") || (msgNameLocal == "firstOrNull") || (msgNameLocal == "lastOrNull"))
                isMapNullableCall = (receiverBaseId == "core_Map") && (msgNameLocal == "at")
                (isListNullableCall || isMapNullableCall)
                  ifTrue: [this toGoNullableOptionExpr: ctx call: coreCall]
                  ifFalse: [coreCall]
              ]
              ifFalse: [
                callKey = this goSymbolKey: funcIdLocal
                fn = ctx goFuncNameFor: callKey
                fn + "(" + argsStr + ")"
              ]
          ]
        ]
        ]
        ]
      ]
    | IrLambda => this toGoLambdaExpr: ctx scope: scope expectedType: typeRef
    | IrBlockExpr => block blockToGoExpr: ctx scope: scope
    | IrMatchExpr => this matchToGoExpr: ctx scope: scope
    | IrNewExpr   => [
        (typeId goNormalizeTypeId) == "core_StringBuilder" ifTrue: [
          ctx addImport: "niva_go/core"
          "core.NewStringBuilder()"
        ] ifFalse: [
        // adding [int] to tests_Box[int]{42}
        name = (typeRef kind == IrTypeRefKind.Custom)
          ifTrue: [typeRef toGoType: ctx]
          ifFalse: [ctx goTypeNameFor: (typeId goNormalizeTypeId)]
        fieldTypesMaybe = ctx symbols constructorFieldTypes at: (typeId goNormalizeTypeId)
        argsStr = | fieldTypesMaybe
          | null => args joinWith: ", " transform: [it toGoExpr: ctx scope: scope]
          |=> (args mapIndexed: [i, arg ->
            fieldType = fieldTypesMaybe at: i
            argExpr = arg toGoLocalAssignExpr: ctx scope: scope targetIsNullable: (ctx needsGoNullablePointerFor: fieldType)
            (fieldType isMut && (arg goIsPointerArg: scope)) ifTrue: ["*" + argExpr] ifFalse: [argExpr]
          ]) joinWith: ", "
        argsStr == "" ifTrue: [name + "{}"] ifFalse: [name + "{" + argsStr + "}"]
        ]
      ]
    | IrCollectionLiteral => this collectionToGoExpr: ctx scope: scope

  on isGoCallLike -> Bool =
    | this
    | IrCall      => true
    | IrBlockExpr => true
    | IrMatchExpr => true
    |=> false

  on emitGoPropagatingCall(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef bindTo: String -> String? = [
    callStr = this toGoExpr: ctx scope: scope
    errName = "__err" uniqueName: scope locals
    retIsUnit = typeRef isGoUnitType
    errReturn = returnType isGoUnitType ifTrue: ["return " + errName] ifFalse: ["return " + (returnType goZeroValue: ctx) + ", " + errName]
    boundName = bindTo
    mut resultName::String? = null

    boundName == "" ifTrue: [
      retIsUnit
        ifTrue: [
          sb appendIndent: indent line: (errName + " := " + callStr)
          ()
        ]
        ifFalse: [
          tmpName = "__callResult" uniqueName: scope locals
          sb appendIndent: indent line: (tmpName + ", " + errName + " := " + callStr)
          sb appendIndent: indent line: ("if " + errName + " != nil { " + errReturn + " }")
          resultName <- tmpName
          ()
        ]
    ] ifFalse: [
      retIsUnit
        ifTrue: [
          sb appendIndent: indent line: ("var " + boundName + " " + (typeRef toGoType: ctx) + " = " + (typeRef goZeroValue: ctx))
          sb appendIndent: indent line: (errName + " := " + callStr)
          resultName <- boundName
          ()
        ]
        ifFalse: [
          sb appendIndent: indent line: (boundName + ", " + errName + " := " + callStr)
          resultName <- boundName
          ()
        ]
    ]

    sb appendIndent: indent line: ("if " + errName + " != nil { " + errReturn + " }")
    ^ resultName
  ]

  on emitReturn(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    hasErrors = returnType errors isNotEmpty
    doPropagate = | this
      | IrCall => propagatingErrVar != null
      |=> false
    doPropagate ifTrue: [
      resultName = this emitGoPropagatingCall: ctx scope: scope sb: sb indent: indent returnType: returnType bindTo: ""
      resultNameMaybe = resultName
      | resultNameMaybe
      | null => [
        line = hasErrors ifTrue: ["return nil"] ifFalse: ["return"]
        sb appendIndent: indent line: line
      ]
      |=> [
        line = hasErrors
          ifTrue: ["return " + resultNameMaybe + ", nil"]
         ifFalse: ["return " + resultNameMaybe]
        sb appendIndent: indent line: line
      ]
    ] ifFalse: [
      isNothingType = (typeRef typeId goNormalizeTypeId) == "core_Nothing"
      isNullValue = this isGoNullLiteral
      isNothing = isNothingType && (isNullValue not)
      isNothing ifTrue: [
        sb appendIndent: indent line: (this toGoStatement: ctx scope: scope returnType: returnType)
        sb appendIndent: indent line: "panic(\"unreachable\")"
      ] ifFalse: [
        returnType isGoUnitType ifTrue: [
          sb appendIndent: indent line: (this toGoStatement: ctx scope: scope returnType: returnType)
          returnLine = hasErrors ifTrue: ["return nil"] ifFalse: [
            scope unitReturnValue ifTrue: ["return struct{}{}"] ifFalse: ["return"]
          ]
          sb appendIndent: indent line: returnLine
        ] ifFalse: [
          exprStr = (ctx needsGoNullablePointerFor: returnType)
            ifTrue: [this toGoNullableInitExpr: ctx scope: scope targetType: returnType]
            ifFalse: [this toGoExpr: ctx scope: scope]
          line = hasErrors ifTrue: ["return " + exprStr + ", nil"] ifFalse: ["return " + exprStr]
          sb appendIndent: indent line: line
        ]
      ]
    ]
  ]

  on emitAsStmt(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    doPropagate = | this
      | IrCall => propagatingErrVar != null
      |=> false
    doPropagate ifTrue: [
      this emitGoPropagatingCall: ctx scope: scope sb: sb indent: indent returnType: returnType bindTo: ""
      ()
  ] ifFalse: [
      | this
      | IrMatchExpr => [
        matchKind = kind
        matchKind == IrMatchKind.ByBool ifTrue: [
          ctx emitBoolMatchStatement: this sb: sb indent: indent returnType: returnType scope: scope
        ] ifFalse: [
          stmtStr = this toGoStatement: ctx scope: scope returnType: returnType
          sb appendIndent: indent line: stmtStr
        ]
      ]
      | IrBlockExpr => [
        blockScope = scope copyWithUnitReturnValue: false
        sb appendIndent: indent line: "{"
        block blockToGoStatements: ctx scope: blockScope sb: sb indent: (indent + 1) returnType: returnType
        blockResultMaybe = block result
        | blockResultMaybe
        | null => []
        |=> blockResultMaybe emitAsStmt: ctx scope: blockScope sb: sb indent: (indent + 1) returnType: returnType
        sb appendIndent: indent line: "}"
      ]
      |=> [
        stmtStr = this toGoStatement: ctx scope: scope returnType: returnType
        sb appendIndent: indent line: stmtStr
      ]
    ]
  ]

  on toGoStatement(ctx): GoContext scope: GoScope returnType: IrTypeRef -> String = [
    | this
    | IrCall => [
      msgNameMaybe = msgName
      msgNameLocal = | msgNameMaybe
        | null => ""
        |=> msgNameMaybe
      receiverTypeMaybe = receiverType
      receiverTypeId = | receiverTypeMaybe
        | null => ""
        |=> receiverTypeMaybe typeId goNormalizeTypeId
      isBoolBranch = (receiverTypeId == "core_Bool") &&
        ((msgNameLocal == "ifTrue") || (msgNameLocal == "ifFalse"))
      isBoolBranch && (args count > 1) ifTrue: [
        branch = args at: 1
        | branch
        | IrLambda => [
          condition = args first toGoExpr: ctx scope: scope
          branchCondition = msgNameLocal == "ifFalse"
            ifTrue: ["!(" + condition + ")"]
            ifFalse: [condition]
          innerScope = scope copy
          branch args forEach: [arg -> innerScope addGoArg: arg ctx: ctx]
          sb = StringBuilder new
          sb appendLine: ("if " + branchCondition + " {")
          branch body blockToGoStatements: ctx scope: innerScope sb: sb indent: 1 returnType: returnType
          bodyResult = branch body result
          | bodyResult
          | null => []
          |=> bodyResult emitAsStmt: ctx scope: innerScope sb: sb indent: 1 returnType: returnType
          sb appendLine: "}"
          sb toString
        ]
        |=> this toGoExpr: ctx scope: scope
      ] ifFalse: [this toGoExpr: ctx scope: scope]
    ]
    |=> [
      exprStr = this toGoExpr: ctx scope: scope
      isCallLike = this isGoCallLike
      isCallLike ifTrue: [exprStr] ifFalse: ["_ = " + exprStr]
    ]
  ]
]

IrCollectionLiteral collectionToGoExpr(ctx): GoContext scope: GoScope -> String = [
  elemType = typeRef args isNotEmpty ifTrue: [(typeRef args first) toGoType: ctx] ifFalse: ["interface{}"]
  ^ kind == IrCollectionKind.List ifTrue: [
      elems = items joinWith: ", " transform: [it toGoExpr: ctx scope: scope]
      "[]" + elemType + "{" + elems + "}"
    ] ifFalse: [
    kind == IrCollectionKind.Set ifTrue: [
      pairs = items joinWith: ", " transform: [(it toGoExpr: ctx scope: scope) + ": struct{}{}"]
      "map[" + elemType + "]struct{}{ " + pairs + " }"
    ] ifFalse: [
      elems = items
      pairParts::mut List(String) = {}!
      elems forEachIndexed: [i, key ->
        i % 2 == 0 ifTrue: [
          value = elems at: (i + 1)
          keyStr = key toGoExpr: ctx scope: scope
          valueStr = value toGoExpr: ctx scope: scope
          pairParts add: (keyStr + ": " + valueStr)
        ]
      ]
      pairs = pairParts joinWith: ", "
      keyType = typeRef args count > 0 ifTrue: [(typeRef args at: 0) toGoType: ctx] ifFalse: ["interface{}"]
      valType = typeRef args count > 1 ifTrue: [(typeRef args at: 1) toGoType: ctx] ifFalse: ["interface{}"]
      "map[" + keyType + "]" + valType + "{" + pairs + "}"
    ]
    ]
]

IrMatchExpr matchToGoExpr(ctx): GoContext scope: GoScope -> String = [
  retType = typeRef
  retErrors = typeRef errors
  retStr = retType goReturnTypes: ctx
  sb = StringBuilder new
  sb append: "func()"
  sb append: retStr
  sb appendLine: " {"

  innerScope = scope copy
  subjectName = "__matchSubject"
  subjectExpr = subject toGoExpr: ctx scope: innerScope
  kind != IrMatchKind.ByError ifTrue: [
      kind == IrMatchKind.ByType
      ifTrue: [sb appendIndent: 1 line: ("var " + subjectName + " interface{} = " + subjectExpr)]
     ifFalse: [sb appendIndent: 1 line: ("" + subjectName + " := " + subjectExpr)]
  ]
  elseBranchLocal = elseBranch
  hasElse = | elseBranchLocal
            | null => false
            |=> true
  hasNullCase = cases any: [c -> c condition isGoNullLiteral]
  subjectForName = subject
  subjectLocalNameMaybe = subjectForName goLocalVarName
  subjectLocalName = | subjectLocalNameMaybe
    | null => ""
    |=> subjectLocalNameMaybe

  isByError = kind == IrMatchKind.ByError
  isByType = kind == IrMatchKind.ByType
  isByError ifTrue: [
      valueName = "__matchValue"
      errName = "__matchErr"
      subjectIsUnit
        ifTrue: [
          sb appendIndent: 1 line: (errName + " := " + subjectExpr)
        ]
        ifFalse: [
          sb appendIndent: 1 line: (valueName + ", " + errName + " := " + subjectExpr)
        ]

      sb appendIndent: 1 line: ("if " + errName + " != nil {")
      sb appendIndent: 2 line: ("switch " + errName + ".(type) {")
      cases forEach: [c ->
        assertedTypeMaybe = c assertedTypeRef
        typeStr = | assertedTypeMaybe
          | null => c condition toGoExpr: ctx scope: innerScope
          |=> assertedTypeMaybe toGoType: ctx
        sb appendIndent: 2 line: ("case " + typeStr + ":")
        caseScope = innerScope copy
        typeAliasMaybe = typeAlias
        aliasStr = | typeAliasMaybe
          | null => "it"
          |=> typeAliasMaybe
        caseScope locals add: aliasStr
        sb appendIndent: 3 line: (aliasStr + " := " + errName + ".(" + typeStr + ")")
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 3 returnType: retType
        ctx emitBlockResultAndReturn: (c body) sb: sb indent: 3 retType: retType scope: caseScope
          returnStmt: (retErrors isNotEmpty ifTrue: ["return nil"] ifFalse: ["return"])
      ]
      sb appendIndent: 2 line: "default:"
      retType isGoUnitType
        ifTrue: [sb appendIndent: 3 line: (retErrors isEmpty ifTrue: ["return"] ifFalse: ["return " + errName])]
        ifFalse: [
          retErrors isEmpty
            ifTrue: [sb appendIndent: 3 line: ("return " + (retType goZeroValue: ctx))]
            ifFalse: [sb appendIndent: 3 line: ("return " + (retType goZeroValue: ctx) + ", " + errName)]
        ]
      sb appendIndent: 2 line: "}"
      sb appendIndent: 1 line: "}"

      | elseBranchLocal
      | null => [
        retType isGoUnitType
          ifTrue: [
            retErrors isNotEmpty
              ifTrue: [sb appendIndent: 1 line: "return nil"]
             ifFalse: [sb appendIndent: 1 line: "return"]
          ]
          ifFalse: [
            subjectIsUnit
              ifTrue: [sb appendIndent: 1 line: ("return " + (retType goZeroValue: ctx))]
             ifFalse: [
                retErrors isNotEmpty
                  ifTrue: [sb appendIndent: 1 line: ("return " + valueName + ", nil")]
                 ifFalse: [sb appendIndent: 1 line: ("return " + valueName)]
              ]
          ]
      ]
      |=> [
        elseBlock = elseBranchLocal
        elseScope = innerScope copy
        typeAliasMaybe = typeAlias
        aliasStr = | typeAliasMaybe
          | null => "it"
          |=> typeAliasMaybe
        elseScope locals add: aliasStr
        subjectIsUnit ifFalse: [
          sb appendIndent: 1 line: (aliasStr + " := " + valueName)
        ]
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 1 returnType: retType
        ctx emitBlockResultAndReturn: elseBlock sb: sb indent: 1 retType: retType scope: elseScope
          returnStmt: (retErrors isNotEmpty ifTrue: ["return nil"] ifFalse: ["return"])
      ]
    ] ifFalse: [
    isByType ifTrue: [
      sb appendIndent: 1 line: ("switch " + subjectName + ".(type) {")
      cases forEach: [c ->
        assertedTypeMaybe = c assertedTypeRef
        typeStr = | assertedTypeMaybe
          | null => c condition toGoExpr: ctx scope: innerScope
          |=> assertedTypeMaybe toGoType: ctx
        sb appendIndent: 1 line: ("case " + typeStr + ":")
        caseScope = innerScope copy
        aliasNameMaybe = typeAlias
        | aliasNameMaybe
        | null => []
        |=> [
          caseRefNames = c body collectIrRefNames
          sb appendIndent: 2 line: (aliasNameMaybe + " := " + subjectName + ".(" + typeStr + ")")
          (caseRefNames contains: aliasNameMaybe) ifFalse: [
            sb appendIndent: 2 line: ("_ = " + aliasNameMaybe)
          ]
          caseScope locals add: aliasNameMaybe
          caseScope nullablePointerLocals remove: aliasNameMaybe
          caseScope narrowedNullablePointerLocals remove: aliasNameMaybe
          ()
        ]
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 2 returnType: retType
        ctx emitBlockResultAndReturn: (c body) sb: sb indent: 2 retType: retType scope: caseScope returnStmt: "return"
      ]
      | elseBranchLocal
      | null => [
        sb appendIndent: 1 line: "default:"
        sb appendIndent: 2 line: "panic(\"invalid type assertion\")"
      ]
      |=> [
        elseBlock = elseBranchLocal
        sb appendIndent: 1 line: "default:"
        elseScope = innerScope copy
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 2 returnType: retType
        ctx emitBlockResultAndReturn: elseBlock sb: sb indent: 2 retType: retType scope: elseScope returnStmt: "return"
      ]
      sb appendIndent: 1 line: "}"
    ] ifFalse: [
      // ByValue or ByBool -> if/else chain
      casesCount = cases count
      cases forEachIndexed: [i, c ->
        isFirst = i == 0
        isLast = i == (casesCount - 1)
        cond = c condition toGoExpr: ctx scope: innerScope
        additionalConditions = c additionalConditions
        fullCond = additionalConditions isNotEmpty
          ifTrue: [
            additionalConditionsStr = additionalConditions joinWith: " || " transform: [condition ->
              "(" + subjectName + " == " + (condition toGoExpr: ctx scope: innerScope) + ")"
            ]
            "((" + subjectName + " == " + cond + ") || " + additionalConditionsStr + ")"
          ]
          ifFalse: ["(" + subjectName + " == " + cond + ")"]
        kw = isFirst ifTrue: ["if "] ifFalse: ["} else if "]
        sb appendIndent: 1 line: (kw + fullCond + " {")
        caseScope = innerScope copy
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 2 returnType: retType
        ctx emitBlockResultAndReturn: (c body) sb: sb indent: 2 retType: retType scope: caseScope returnStmt: "return"
        isLast && (hasElse not) ifTrue: [
          sb appendIndent: 1 line: "} else {"
          sb appendIndent: 2 line: "panic(\"unmatched value\")"
          sb appendIndent: 1 line: "}"
        ]
      ]
      | elseBranchLocal
      | null => []
      |=> [
        elseBlock = elseBranchLocal
        sb appendIndent: 1 line: "} else {"
        elseScope = innerScope copy
        ((subjectLocalName != "") && hasNullCase) ifTrue: [
          elseScope narrowedNullablePointerLocals add: subjectLocalName
        ]
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 2 returnType: retType
        ctx emitBlockResultAndReturn: elseBlock sb: sb indent: 2 retType: retType scope: elseScope returnStmt: "return"
        sb appendIndent: 1 line: "}"
      ]
    ]
    ]

  sb append: "}()"
  ^ sb toString
]

IrStmt toGoStmt(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
  token printGoLine-intoSb: sb
  | this
  | IrLet => [
      goName = name toSafeGoIdent
      scope locals add: name
      (ctx needsGoNullablePointerFor: typeRef) ifTrue: [scope nullablePointerLocals add: name]
      valueLocal = value
      typeStr = typeRef toGoType: ctx
      | valueLocal
      | null => [sb appendIndent: indent line: ("var " + goName + " " + typeStr)]
      |=> [
        valueExpr = valueLocal
        doProp = | valueExpr | IrCall => (valueExpr propagatingErrVar != null) |=> false
        doProp
          ifTrue: [
            valueExpr emitGoPropagatingCall: ctx scope: scope sb: sb indent: indent returnType: returnType bindTo: goName
            ()
          ]
          ifFalse: [
            valueStr = valueExpr toGoLocalAssignExpr: ctx scope: scope targetIsNullable: (scope nullablePointerLocals contains: name)
            sb appendIndent: indent line: ("var " + goName + " " + typeStr + " = " + valueStr)
          ]
      ]
      isUsed ifFalse: [
        sb appendIndent: indent line: ("_ = " + goName)
      ]
    ]
  | IrSetLocal => [
      goName = name toSafeGoIdent
      valueStr = value toGoLocalAssignExpr: ctx scope: scope targetIsNullable: (scope nullablePointerLocals contains: name)
      sb appendIndent: indent line: (goName + " = " + valueStr)
  ]
  | IrSetField => [
      recvStr = receiver toGoExpr: ctx scope: scope
      valueStr = value toGoExpr: ctx scope: scope
      sb appendIndent: indent line: ("(" + recvStr + ")." + (field toSafeGoIdent) + " = " + valueStr)
  ]
  | IrDestructure => [
      tmpName = "__destructTmp" uniqueName: scope locals
      valueStr = value toGoExpr: ctx scope: scope
      sb appendIndent: indent line: (tmpName + " := " + valueStr)
      bindings forEach: [b ->
        goName = b name toSafeGoIdent
        scope locals add: b name
        sb appendIndent: indent line: ("var " + goName + " " + (b typeRef toGoType: ctx) + " = " + tmpName + "." + (b fieldName toSafeGoIdent))
        b isUsed ifFalse: [
          sb appendIndent: indent line: ("_ = " + goName)
        ]
      ]
  ]
  | IrExprStmt => [
      expr emitAsStmt: ctx scope: scope sb: sb indent: indent returnType: returnType
  ]
  | IrReturn => [
      exprLocal = expr
      hasErrors = returnType errors isNotEmpty
      | exprLocal
      | null => [
        hasErrors
          ifTrue: [sb appendIndent: indent line: "return nil"]
         ifFalse: [
           scope unitReturnValue
             ifTrue: [sb appendIndent: indent line: "return struct{}{}"]
             ifFalse: [sb appendIndent: indent line: "return"]
         ]
      ]
      |=> [
        exprVal = exprLocal
        exprVal emitReturn: ctx scope: scope sb: sb indent: indent returnType: returnType
      ]
  ]
  | IrWhile => [
      condLocal = cond
      bodyLocal = body
      sb appendIndent: indent line: "for {"

      | condLocal
      | IrLambda => [
        condScope = scope copy
        condLocal args forEach: [arg -> condScope addGoArg: arg ctx: ctx]
        sb appendIndent: (indent + 1) line: "{"
        condBody = condLocal body
        condBody blockToGoStatements: ctx scope: condScope sb: sb indent: (indent + 2) returnType: returnType
        condResultMaybe = condBody result
        | condResultMaybe
        | null => [sb appendIndent: (indent + 2) line: "if !(false) { break }"]
        |=> [
          condResult = condResultMaybe toGoExpr: ctx scope: condScope
          sb appendIndent: (indent + 2) line: ("if !(" + condResult + ") { break }")
        ]
        sb appendIndent: (indent + 1) line: "}"
      ]
      |=> [
        condExpr = condLocal toGoExpr: ctx scope: scope
        sb appendIndent: (indent + 1) line: ("if !(" + condExpr + ") { break }")
      ]

      | bodyLocal
      | IrLambda => [
        bodyScope = scope copy
        bodyLocal args forEach: [arg -> bodyScope addGoArg: arg ctx: ctx]
        sb appendIndent: (indent + 1) line: "{"
        bodyBlock = bodyLocal body
        bodyBlock blockToGoStatements: ctx scope: bodyScope sb: sb indent: (indent + 2) returnType: returnType
        bodyResultMaybe = bodyBlock result
        | bodyResultMaybe
        | null => []
        |=> bodyResultMaybe emitAsStmt: ctx scope: bodyScope sb: sb indent: (indent + 2) returnType: returnType
        sb appendIndent: (indent + 1) line: "}"
      ]
      |=> [
        bodyExpr = bodyLocal toGoExpr: ctx scope: scope
        sb appendIndent: (indent + 1) line: bodyExpr
      ]
      sb appendIndent: indent line: "}"
  ]
  | IrThrow => [
      throwErrExpr = errExpr
      errStr = | throwErrExpr
        | IrTypeRefExpr => [
            ctx addImport: "fmt"
            "fmt.Errorf(\"" + (throwErrExpr ref typeId goNormalizeTypeId) + "\")"
          ]
        |=> throwErrExpr toGoExpr: ctx scope: scope
      returnLine = returnType isGoUnitType
        ifTrue: ["return " + errStr]
        ifFalse: ["return " + (returnType goZeroValue: ctx) + ", " + errStr]
      sb appendIndent: indent line: returnLine
  ]
]

extend IrBlock [
  on blockToGoExpr(ctx): GoContext scope: GoScope -> String = [
    retType = resultType
    retStr = " " + (retType toGoType: ctx)
    sb = StringBuilder new
    sb append: "func()"
    sb append: retStr
    sb appendLine: " {"

    innerScope = scope copyWithUnitReturnValue: true
    this blockToGoStatements: ctx scope: innerScope sb: sb indent: 1 returnType: retType
    hasTrailingReturn = this hasTrailingReturn
    hasTrailingReturn ifFalse: [
      ctx emitResult: result sb: sb indent: 1 retType: retType scope: innerScope
      retType isGoUnitType ifTrue: [
        sb appendIndent: 1 line: ("return " + (retType toGoType: ctx) + "{}")
      ]
    ]

    sb append: "}()"
    ^ sb toString
  ]

  on blockToGoStatements(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    stmts forEach: [st -> st toGoStmt: ctx scope: scope sb: sb indent: indent returnType: returnType]
    // return handling is done by caller
  ]

  on hasTrailingReturn -> Bool = [
    ^ stmts isEmpty ifTrue: [false] ifFalse: [
      lastStmt = stmts last
      | lastStmt
      | IrReturn | IrThrow => true
      |=> false
    ]
  ]
]

List(String) goTypeParams -> String =
  this isEmpty  ifTrue: [""]
           ifFalse: [ "[" + (this joinWith: ", " transform: [it toSafeGoIdent + " any"]) + "]" ]

List(String) goTypeArgs -> String =
  this isEmpty  ifTrue: [""]
           ifFalse: [ "[" + (this joinWith: ", " transform: [it toSafeGoIdent]) + "]" ]

IrTypeRef collectGoTypeParamsInto(names): mut List(String) seen: mut Set(String) -> Unit = [
  baseId = typeId goNormalizeTypeId
  ((kind == IrTypeRefKind.Custom) && (baseId isGeneric)) ifTrue: [
    seen contains: baseId, ifFalse: [
      seen add: baseId
      names add: baseId
    ]
  ]
  args forEach: [it collectGoTypeParamsInto: names seen: seen]
  returnTypeMaybe = returnType
  | returnTypeMaybe
  | null => []
  |=> returnTypeMaybe collectGoTypeParamsInto: names seen: seen
  errors forEach: [it collectGoTypeParamsInto: names seen: seen]
]

List(IrField) goTypeParamsFromFields -> List(String) = [
  names::mut List(String) = {}!
  seen::mut Set(String) = #()!
  this forEach: [field -> field typeRef collectGoTypeParamsInto: names seen: seen]
  ^ names toList
]

List(String) goCallArgs -> String = [
  ^ this isEmpty ifTrue: [""] ifFalse: [this joinWith: ", "]
]
