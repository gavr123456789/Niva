type GoBackend

type GoSymbolTable
   typeNames: Map(String, String)
   funcNames: Map(String, String)
packageNames: Map(String, String)
   fileNames: Map(String, String)

type GoImportPlan
  importsByFile: Map(String, Set(String))

type GoFragment
   pkgId: String
 fileKey: String
orderKey: String
 imports: List(String)
    code: String

type GoFragmentFrame
 ctx: GoContext
  sb: StringBuilder

type GoFile
       path: String
packageName: String
    imports: List(String)
       body: String

type GoIrError
  message: String

type GoContext
  symbols: GoSymbolTable
  imports: mut Set(String)

constructor GoContext forSymbols(symbols): GoSymbolTable -> GoContext =
  GoContext symbols: symbols imports: #()!

GoContext addImport(name): String -> Unit = [
  imports add: name
]

type GoScope
       locals: mut Set(String)
pointerLocals: mut Set(String)

constructor GoScope new = GoScope locals: #()! pointerLocals: #()!

GoScope copy -> GoScope = [
  newLocals::mut Set(String) = #()!
  newPointers::mut Set(String) = #()!
  newLocals addAll: locals
  newPointers addAll: pointerLocals

  ^ GoScope locals: newLocals pointerLocals: newPointers
]

GoContext emitResult: IrExpr? sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  hasErrors = retType errors isNotEmpty
  retType isGoUnitType
    ifFalse: [
      | emitResult
      | null => [TO DO: "bug: Go emitResult: missing result for non-Unit return"]
      |=> [
        emitResult token printGoLine-intoSb: sb
        exprStr = emitResult toGoExpr: this :scope
        line = hasErrors
          ifTrue:  ["return " + exprStr + ", nil"]
         ifFalse: ["return " + exprStr]
        sb appendIndent: indent line: line
      ]
    ]
    ifTrue: [
      | emitResult
      | null => []
      |=> [
        emitResult token printGoLine-intoSb: sb
        sb appendIndent: indent
               line: (emitResult toGoStatement: this :scope) ]
    ]
]

extend String [
  on goNormalizeTypeId -> String = [
    hasGeneric = .contains: "__"
    result = hasGeneric
        ifTrue: [.substringBefore: "__"]
       ifFalse: [this]
    this == result ifFalse: [
      "goNormalizeTypeId: before = $this, after = $result" // log
    ]
    ^ result
  ]

  on stripPkgPrefix(prefix): String -> String = [
    pre = prefix + "_"
    preLen = pre count
    ^ (.count >= preLen && ((.slice: 0..<preLen) == pre))
        ifTrue:  [.slice: preLen..< .count]
       ifFalse: [this]
  ]

  on hasPrefix(prefix): String -> Bool = [
    prefixLen = prefix count
    ^ (.count >= prefixLen) && ((.slice: 0..<prefixLen) == prefix)
  ]

  on addToGoImports(imports): mut Set(String) -> Unit = [
    imports add: this
  ]

]

IrTypeRef coreFuncNameFromCall(name): String -> String = [
  baseId = typeId goNormalizeTypeId
  recvBase = baseId stripPkgPrefix: "core"
  recvBaseSafe = recvBase toSafeGoIdent
  normalized = name goSanitizeIdent

  // generics monomorphizes in nin, but Any__echo has a single impl, not Int__echo Person__echo for every type
  // this should be solved by lazily generating ?__echo methods for everything or something elce
  x = name == "echo"
        ifTrue: ["Any__echo"]
        ifFalse: [recvBaseSafe + "__" + normalized]

  name == x ifFalse: [
    "coreFuncNameFromCall: was: $name became $x"// log
  ] ifTrue: ["coreFuncNameFromCall: no changes" //log
            ]

  ^ x

]

GoContext goTypeNameFor(typeId): String -> String = [
  baseId = typeId goNormalizeTypeId
  existing = symbols typeNames at: baseId
  ^ | existing
    | null => [TO DO: "Go typeId not registered in symbol table: " + baseId]
    |=> existing
]

IrFunction goFuncNameFromIr -> String = [
  recvId = receiverType typeId


  recvBase = pkgId != ""
              ifTrue:  [ recvId stripPkgPrefix: pkgId ]
             ifFalse: [ recvId ],
             goSanitizeIdent

  sel = name goSanitizeIdent

  full =
    pkgId != ""
      ifTrue: [ pkgId + "__" + recvBase + "__" + sel ]
     ifFalse: [ recvBase + "__" + sel ]

  ^ full toSafeGoIdent
]

extend GoContext [
  on goFuncNameForFn(fn): IrFunction -> String = [
    ^ this goFuncNameFor: fn id
  ]

  on goFuncNameFor(funcId): String -> String = [
    existing = symbols funcNames at: funcId
    ^ | existing
      | null => [TO DO: "Go funcId not registered: " + funcId]
      |=> existing
  ]

]

IrUnionDef goBranchTypeIds -> List(String) = [
  ids::mut List(String) = {}!
  branches forEach: [br ->
    br isInclude ifFalse: [
      ids add: (pkgId + "_" + br name)
    ]
  ]
  ^ ids toList
]

Int goIndent -> String = [
  sb = StringBuilder new
  mut i = 0
  [i < this] whileTrue: [
    sb append: "    "
    i <- i inc
  ]
  ^ sb toString
]

StringBuilder appendIndent(level): Int line: String -> Unit = [
  this append: (level goIndent)
  this appendLine: line
]

GoImportPlan importsForFile(fileKey): String -> List(String) = [
  imports = importsByFile at: fileKey
  ^ imports unpack: [it toList] or: {}
]

extend IrTypeRef [

  on isGoUnitType -> Bool =
    (kind == IrTypeRefKind.Builtin) && (typeId goNormalizeTypeId == "core_Unit")

  on hasGoErrors -> Bool = errors isNotEmpty

  on goZeroValue(ctx): GoContext -> String = [
    ^ nullable ifTrue: ["nil"] ifFalse: [
      | kind
      | IrTypeRefKind.Builtin => [
          baseId = typeId goNormalizeTypeId
          | baseId
          | "core_Int" | "core_Double" | "core_Float" | "core_Char" => "0"
          | "core_String"                                           => "\"\""
          | "core_Bool"                                             => "false"
          | "core_Unit"                                             => "core.UnitInstance"
          |=> "nil"
        ]
      | IrTypeRefKind.Custom   => (ctx goTypeNameFor: (typeId goNormalizeTypeId)) + "{}"
      | IrTypeRefKind.Function => "nil"
    ]
  ]

  on goReturnTypes(ctx): GoContext -> String = [
    hasErr = errors isNotEmpty
    isUnit = .isGoUnitType
    ^ hasErr
        ifTrue: [
          isUnit ifTrue: [" error"] ifFalse: [" (" + (this toGoType: ctx) + ", error)"]
        ]
        ifFalse: [
          isUnit ifTrue: [""] ifFalse: [" " + (this toGoType: ctx)]
        ]
  ]

  on goBaseType(ctx): GoContext -> String = [
    baseId = typeId goNormalizeTypeId
    ^ | kind
      | IrTypeRefKind.Function => [
          argsStr = args joinWith: ", " transform: [it toGoParamType: ctx]
          retTypeMaybe = returnType
          retStr = | retTypeMaybe
                   | null => ""
                   |=> retTypeMaybe toGoType: ctx
          retStr == "" ifTrue: ["func(" + argsStr + ")"]
                      ifFalse: ["func(" + argsStr + ") " + retStr]
        ]
      | IrTypeRefKind.Builtin => [
          | baseId
          | "core_Int"     => "int"
          | "core_Double"  => "float64"
          | "core_Float"   => "float32"
          | "core_String"  => "string"
          | "core_Bool"    => "bool"
          | "core_Char"    => "rune"
          | "core_Unit"    => "struct{}"
          | "core_Any"     => "any"
          | "core_Nothing" => "any"
          | "core_Null"    => "any"
          | "core_Error"   => "error"
          | "core_List"    => [
              elem = args isNotEmpty ifTrue: [args first toGoType: ctx] ifFalse: ["any"]
              "[]" + elem
            ]
          | "core_Set" => [
              elem = args isNotEmpty ifTrue: [args first toGoType: ctx] ifFalse: ["any"]
              "map[" + elem + "]struct{}"
            ]
          | "core_Map" => [
              keyType = args count > 0 ifTrue: [args at: 0, toGoType: ctx] ifFalse: ["any"]
              valType = args count > 1 ifTrue: [args at: 1, toGoType: ctx] ifFalse: ["any"]
              "map[" + keyType + "]" + valType
            ]
          |=> ctx goTypeNameFor: baseId
        ]
      | IrTypeRefKind.Custom => [
          baseId isGeneric ifTrue: [^ baseId toSafeGoIdent]
          name = ctx goTypeNameFor: baseId
          argsStr = args isNotEmpty
            ifTrue: ["[" + (args joinWith: ", " transform: [it toGoType: ctx]) + "]"]
           ifFalse: [""]
          name + argsStr
        ]
  ]

  on toGoType(ctx): GoContext -> String = [
    base = .goBaseType: ctx
    ^ nullable
        ifTrue: [
          // already reference-like types can be nil without pointer
          isAny = base == "any"
          isIfaceStr = base == "interface{}"
          isIface = isAny || isIfaceStr

          isRefLike = (.isGoRefLike) || isIface
          isRefLike ifTrue: [base] ifFalse: ["*" + base]
        ]
        ifFalse: [base]
  ]

  on toGoParamType(ctx): GoContext -> String =
    .isGoPointerParam,
      ifTrue: [ nullable ifTrue:  [.toGoType: ctx]
                         ifFalse: ["*" + (.goBaseType: ctx)] ]
      ifFalse: [.toGoType: ctx]

]

IrLiteral toGoLiteral -> String =
  | kind
  | IrLiteralKind.Null   => "nil"
  | IrLiteralKind.Unit   => "core.UnitInstance"
  | IrLiteralKind.Bool   => lexeme
  | IrLiteralKind.Int    => lexeme
  | IrLiteralKind.Double => lexeme
  | IrLiteralKind.Float  => lexeme endsWith: "f",
                                  ifTrue:  [lexeme dropLast: 1]
                                 ifFalse: [lexeme]
  | IrLiteralKind.Char   => lexeme
  | IrLiteralKind.String    => lexeme
  // backtick literals for raw strings
  | IrLiteralKind.RawString => "`" + ((lexeme drop: 3) dropLast: 3) + "`"
  | IrLiteralKind.Atom   => "\"" + lexeme + "\""

IrCall tryGoBindExpr(ctx): GoContext scope: GoScope -> String? = [
  r = receiverType
  | r
  | null => [^ null]
  |=> r typeId == "core_Bind"
        ifFalse: [^ null]


  msgNameLocalMaybe = msgName
  | msgNameLocalMaybe
  | null => [^ null]
  |=> [
    msgNameLocal = msgNameLocalMaybe
    ^ | msgNameLocal
    | "emit" | "goCode" => [
      templateExpr = args first
      templateVal = templateExpr irStringLiteralValue
      | templateVal
      | null => (templateExpr toGoExpr: ctx scope: scope)
      |=> templateVal
    ]
    | "emit__args" => [
      templateExpr = args first
      argsListExpr = args at: 1
      template = templateExpr irStringLiteralValue unpackOrPANIC
      items = argsListExpr irListLiteralItems
      argsValues = items map: [it toGoExpr: ctx scope: scope]
      template bindApply: argsValues
    ]
    | "emit__backend" => [
      templateExpr = args first
      backendExpr = args at: 1
      backendName = backendExpr irStringLiteralValue unpackOrPANIC
      backendName != "go" ifTrue: [^ ""]
      templateVal = templateExpr irStringLiteralValue
      | templateVal
      | null => (templateExpr toGoExpr: ctx scope: scope)
      |=> templateVal
    ]
    | "emit__backend__args" => [
      templateExpr = args first
      backendExpr = args at: 1
      argsListExpr = args at: 2
      backendName = backendExpr irStringLiteralValue unpackOrPANIC
      backendName != "go" ifTrue: [^ ""]
      template = templateExpr irStringLiteralValue unpackOrPANIC
      items = argsListExpr irListLiteralItems
      argsValues = items map: [it toGoExpr: ctx scope: scope]
      template bindApply: argsValues
    ]
    | "addImport" => [
      importExpr = args first
      importName = importExpr irStringLiteralValue unpackOrPANIC
      ctx addImport: importName
      ""
    ]
    | "addImport__backend" => [
      importExpr = args first
      backendExpr = args at: 1
      isGo = backendExpr irStringLiteralValue unpackOrPANIC == "go"
      isGo ifFalse: [^ ""]
      importName = importExpr irStringLiteralValue unpackOrPANIC
      ctx addImport: importName
      ""
    ]
    |=> null
  ]
]

// Collect all IrVarRef names from an IR block (for match alias usage check)
IrBlock collectIrRefNames -> mut Set(String) = [
  refs::mut Set(String) = #()!
  stmts forEach: [it collectIrStmtRefs: refs]
  result unpack: [it collectIrExprRefs: refs]
  ^ refs
]

IrStmt collectIrStmtRefs(refs): mut Set(String) -> Unit = [
  | this
  | IrLet      => [ value unpack: [it collectIrExprRefs: refs] ]
  | IrSetLocal => [ value collectIrExprRefs: refs ]
  | IrSetField => [ receiver collectIrExprRefs: refs
                    value collectIrExprRefs: refs ]
  | IrDestructure => [ value collectIrExprRefs: refs ]
  | IrExprStmt    => [ expr collectIrExprRefs: refs ]
  | IrReturn      => [ expr unpack: [it collectIrExprRefs: refs] ]
  | IrWhile       => [ cond collectIrExprRefs: refs
                       body collectIrExprRefs: refs ]
  | IrThrow       => [ errExpr collectIrExprRefs: refs ]
]

IrExpr collectIrExprRefs(refs): mut Set(String) -> Unit = [
  | this
  | IrVarRef      => refs add: name
  | IrLiteralExpr => []
  | IrThisRef     => []
  | IrFieldGet    => receiver collectIrExprRefs: refs
  | IrCall        => [
    callee unpack: [it collectIrExprRefs: refs]
    args forEach: [it collectIrExprRefs: refs]
  ]
  | IrLambda    => body collectIrRefNames forEach: [refs add: it]
  | IrBlockExpr => block collectIrRefNames forEach: [refs add: it]
  | IrMatchExpr => [
    subject collectIrExprRefs: refs
    cases forEach: [c ->
      c condition collectIrExprRefs: refs
      c additionalConditions forEach: [it collectIrExprRefs: refs]
      c body collectIrRefNames forEach: [refs add: it]
    ]
    elseBranch unpack: [it collectIrRefNames forEach: [refs add: it]]
  ]
  | IrNewExpr           => args forEach: [it collectIrExprRefs: refs]
  | IrCollectionLiteral => items forEach: [it collectIrExprRefs: refs]
  | IrOpBin             => [
    left collectIrExprRefs: refs
    right collectIrExprRefs: refs
  ]
  | IrTypeRefExpr => []
]


extend IrExpr [
  on toGoArgExpr(ctx): GoContext scope: GoScope paramType: IrTypeRef -> String = [
    exprStr = this toGoExpr: ctx scope: scope
    paramType needsGoAddressAtCall ifFalse: [^ exprStr]

    alreadyPointer =
      | this
      | IrVarRef  => scope pointerLocals contains: name
      | IrThisRef => scope pointerLocals contains: "this"
      |=> false

    ^ alreadyPointer ifTrue: [exprStr] ifFalse: ["&" + exprStr]
  ]

  on toGoExpr(ctx): GoContext scope: GoScope -> String =
    | this
    | IrLiteralExpr => literal toGoLiteral
    | IrVarRef      => name toSafeGoIdent
    | IrThisRef  => "this"
    | IrFieldGet => [
        recv = receiver toGoExpr: ctx scope: scope
        recv + "." + (field toSafeGoIdent)
      ]
    | IrTypeRefExpr => ref toGoType: ctx
    | IrOpBin       => [
        l = left toGoExpr: ctx scope: scope
        r = right toGoExpr: ctx scope: scope
        "(" + l + " " + op + " " + r + ")"
      ]
    | IrCall => [
        // new bind design: inlineable bind plan attached during IR generation
        bind unpack: [bp ->
          | bp
          | IrBindByName => [
              ctx addImport: bp goPkg
              byNameArgs = args mapIndexed: [i, it ->
                paramType = paramTypes at: i
                it toGoArgExpr: ctx scope: scope paramType: paramType
              ], goCallArgs
              ^ (bp goPkg goPkgQualifier) + "." + (bp goName bindCapitalizeFirst) + "(" + byNameArgs + ")"
            ]
          | IrBindEmit => [
              // emits from a .bind.niva file auto-import that Go package
              bp goPkg unpack: [ctx addImport: it]
              // $0 = receiver/this, $1 = first keyword arg, ...
              emitArgVals = args map: [it toGoExpr: ctx scope: scope]
              ^ bp template bindApply0: emitArgVals
            ]
        ]

        bindExpr = this tryGoBindExpr: ctx scope: scope
        bindExpr != null ifTrue: [^ bindExpr unpackOrPANIC]
        argsStr = args mapIndexed: [i, it ->
          paramType = paramTypes at: i
          it toGoArgExpr: ctx scope: scope paramType: paramType
        ], goCallArgs
        funcIdLocal = funcId
        | funcIdLocal
        | null => [
            calleeLocal = callee
            | calleeLocal
            | null => TO DO: "IrCall without funcId must have callee"
            |=> [
              calleeExpr = calleeLocal
              "(" + (calleeExpr toGoExpr: ctx scope: scope) + ")(" + argsStr + ")"
            ]
          ]
        |=> [
            // if its from core => generate core.Type__funcname, if not then Pkg__
            declPkgLocal = declPkg unpackOrPANIC
            declPkgLocal == "core"
              ifTrue: [
                ctx addImport: "niva_go/core"
                msgNameLocal = msgName unpackOrPANIC
                recvTypeLocal = receiverType unpackOrPANIC
                coreFn = recvTypeLocal coreFuncNameFromCall: msgNameLocal
                "core." + coreFn + "(" + argsStr + ")"
              ]
              ifFalse: [
                fn = ctx goFuncNameFor: funcIdLocal
                fn + "(" + argsStr + ")"
              ]
          ]
      ]
    | IrLambda => [
        argsStr = args joinWith: ", " transform: [a -> (a name toSafeGoIdent) + " " + (a typeRef toGoParamType: ctx)]
        retTypeMaybe = typeRef returnType
        retType = | retTypeMaybe
                  | null => typeRef
                  |=> retTypeMaybe
        retStr = retType isGoUnitType ifTrue: [""] ifFalse: [" " + (retType toGoType: ctx)]
        sb = StringBuilder new
        sb append: "func("
        sb append: argsStr
        sb append: ")"
        sb append: retStr
        sb appendLine: " {"

        innerScope = scope copy
        args forEach: [innerScope locals add: it name]
        body blockToGoStatements: ctx scope: innerScope sb: sb indent: 1 returnType: retType
        ctx emitResult: (body result) sb: sb indent: 1 retType: retType scope: innerScope
        sb append: "}"
        sb toString
      ]
    | IrBlockExpr => block blockToGoExpr: ctx scope: scope
    | IrMatchExpr => this matchToGoExpr: ctx scope: scope
    | IrNewExpr   => [
        // adding [int] to tests_Box[int]{42}
        name = | typeRef kind
               | IrTypeRefKind.Custom => typeRef toGoType: ctx
               |=> ctx goTypeNameFor: (typeId goNormalizeTypeId)
        argsStr = args joinWith: ", " transform: [it toGoExpr: ctx scope: scope]
        argsStr == "" ifTrue: [name + "{}"] ifFalse: [name + "{" + argsStr + "}"]
      ]
    | IrCollectionLiteral => this collectionToGoExpr: ctx scope: scope

  on isGoCallLike -> Bool =
    | this
    | IrCall      => true
    | IrBlockExpr => true
    | IrMatchExpr => true
    |=> false

  on emitGoPropagatingCall(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef bindTo: String? -> String? = [
    callStr = this toGoExpr: ctx scope: scope
    errName = "__err" uniqueName: scope locals
    retIsUnit = typeRef isGoUnitType
    errReturn = returnType isGoUnitType ifTrue: ["return " + errName] ifFalse: ["return " + (returnType goZeroValue: ctx) + ", " + errName]
    boundName = bindTo

    | boundName
    | null => [
      retIsUnit
        ifTrue: [sb appendIndent: indent line: (errName + " := " + callStr)]
        ifFalse: [
          tmpName = "__callResult" uniqueName: scope locals
          sb appendIndent: indent line: (tmpName + ", " + errName + " := " + callStr)
          sb appendIndent: indent line: ("if " + errName + " != nil { " + errReturn + " }")
          ^ tmpName
        ]
    ]
    |=> [
      retIsUnit
        ifTrue: [
          sb appendIndent: indent line: ("var " + boundName + " " + (typeRef toGoType: ctx) + " = " + (typeRef goZeroValue: ctx))
          sb appendIndent: indent line: (errName + " := " + callStr)
        ]
        ifFalse: [sb appendIndent: indent line: (boundName + ", " + errName + " := " + callStr)]
    ]

    sb appendIndent: indent line: ("if " + errName + " != nil { " + errReturn + " }")
    ^ boundName
  ]

  on emitReturn(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    hasErrors = returnType errors isNotEmpty
    | this | IrCall => [
      propagatingErrVar unpack: [
        resultName = this emitGoPropagatingCall: ctx :scope :sb :indent :returnType bindTo: null
        resultName unpack: [
          line = hasErrors
            ifTrue: ["return " + it + ", nil"]
           ifFalse: ["return " + it]
          sb appendIndent: indent line: line
        ]
        ^ Unit
      ]
    ] |=> []

    exprStr = this toGoExpr: ctx scope: scope
    line =
      hasErrors
        ifTrue: [
          returnType isGoUnitType
            ifTrue: ["return nil"]
           ifFalse: ["return " + exprStr + ", nil"]
        ]
        ifFalse: ["return " + exprStr]
    sb appendIndent: indent line: line
  ]

  on emitAsStmt(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    | this | IrCall => [
      propagatingErrVar unpack: [
        this emitGoPropagatingCall: ctx scope: scope sb: sb indent: indent returnType: returnType bindTo: null
        ^ Unit
      ]
    ] |=> []
    stmtStr = this toGoStatement: ctx scope: scope
    sb appendIndent: indent line: stmtStr
  ]

  on toGoStatement(ctx): GoContext scope: GoScope -> String = [
    exprStr = this toGoExpr: ctx scope: scope
    isCallLike = this isGoCallLike
    ^ isCallLike ifTrue: [exprStr] ifFalse: ["_ = " + exprStr]
  ]
]

IrCollectionLiteral collectionToGoExpr(ctx): GoContext scope: GoScope -> String = [
  elemType = typeRef args isNotEmpty ifTrue: [(typeRef args first) toGoType: ctx] ifFalse: ["any"]
  ^ | this kind
  | IrCollectionKind.List => [
      elems = items joinWith: ", " transform: [it toGoExpr: ctx scope: scope]
      "[]" + elemType + "{" + elems + "}"
    ]
  | IrCollectionKind.Set => [
      pairs = items joinWith: ", " transform: [(it toGoExpr: ctx scope: scope) + ": struct{}{}"]
      "map[" + elemType + "]struct{}{ " + pairs + " }"
    ]
  | IrCollectionKind.Map => [
      elems = items
      elems count % 2 != 0 ifTrue: [TO DO: "Map should contain even number of elements"]
      pairs = elems asSequence
                chunked: 2, joinTransform: [
                  key = it at: 0
                  value = it at: 1
                  keyStr = key toGoExpr: ctx scope: scope
                  valueStr = value toGoExpr: ctx scope: scope
                  keyStr + ": " + valueStr
                ]
      keyType = typeRef args count > 0 ifTrue: [(typeRef args at: 0) toGoType: ctx] ifFalse: ["any"]
      valType = typeRef args count > 1 ifTrue: [(typeRef args at: 1) toGoType: ctx] ifFalse: ["any"]
      "map[" + keyType + "]" + valType + "{" + pairs + "}"
    ]
]

IrMatchExpr matchToGoExpr(ctx): GoContext scope: GoScope -> String = [
  retType = typeRef
  retErrors = typeRef errors
  retStr = retType goReturnTypes: ctx
  sb = StringBuilder new
  sb append: "func()"
  sb append: retStr
  sb appendLine: " {"

  innerScope = scope copy
  subjectName = "__matchSubject"
  subjectExpr = subject toGoExpr: ctx scope: innerScope
  kind != IrMatchKind.ByError ifTrue: [
    kind == IrMatchKind.ByType
      ifTrue: [sb appendIndent: 1 line: ("var " + subjectName + " any = " + subjectExpr)]
     ifFalse: [sb appendIndent: 1 line: ("" + subjectName + " := " + subjectExpr)]
  ]
  elseBranchLocal = elseBranch
  hasElse = | elseBranchLocal
            | null => false
            |=> true

  | kind
  | IrMatchKind.ByError => [
      valueName = "__matchValue"
      errName = "__matchErr"
      subjectIsUnit
        ifTrue: [
          sb appendIndent: 1 line: (errName + " := " + subjectExpr)
        ]
        ifFalse: [
          sb appendIndent: 1 line: (valueName + ", " + errName + " := " + subjectExpr)
        ]

      sb appendIndent: 1 line: ("if " + errName + " != nil {")
      sb appendIndent: 2 line: ("switch " + errName + ".(type) {")
      cases forEach: [c ->
        typeStr = c assertedTypeRef unpack: [it toGoType: ctx] or: (c condition toGoExpr: ctx scope: innerScope)
        sb appendIndent: 2 line: ("case " + typeStr + ":")
        caseScope = innerScope copy
        aliasStr = typeAlias unpackOrValue: "it"
        caseScope locals add: aliasStr
        sb appendIndent: 3 line: (aliasStr + " := " + errName + ".(" + typeStr + ")")
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 3 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (c body result) sb: sb indent: 3 retType: retType scope: caseScope
            retErrors isNotEmpty
              ifTrue: [sb appendIndent: 3 line: "return nil"]
             ifFalse: [sb appendIndent: 3 line: "return"]
          ]
          ifFalse: [
            ctx emitResult: (c body result) sb: sb indent: 3 retType: retType scope: caseScope
          ]
      ]
      sb appendIndent: 2 line: "default:"
      sb appendIndent: 3 line: (retType isGoUnitType ifTrue: ["return " + errName] ifFalse: ["return " + (retType goZeroValue: ctx) + ", " + errName])
      sb appendIndent: 2 line: "}"
      sb appendIndent: 1 line: "}"

      | elseBranchLocal
      | null => [
        retType isGoUnitType
          ifTrue: [
            retErrors isNotEmpty
              ifTrue: [sb appendIndent: 1 line: "return nil"]
             ifFalse: [sb appendIndent: 1 line: "return"]
          ]
          ifFalse: [
            subjectIsUnit
              ifTrue: [sb appendIndent: 1 line: ("return " + (retType goZeroValue: ctx))]
             ifFalse: [
                retErrors isNotEmpty
                  ifTrue: [sb appendIndent: 1 line: ("return " + valueName + ", nil")]
                 ifFalse: [sb appendIndent: 1 line: ("return " + valueName)]
              ]
          ]
      ]
      |=> [
        elseBlock = elseBranchLocal
        elseScope = innerScope copy
        aliasStr = typeAlias unpackOrValue: "it"
        elseScope locals add: aliasStr
        subjectIsUnit ifFalse: [
          sb appendIndent: 1 line: (aliasStr + " := " + valueName)
        ]
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 1 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (elseBlock result) sb: sb indent: 1 retType: retType scope: elseScope
            retErrors isNotEmpty
              ifTrue: [sb appendIndent: 1 line: "return nil"]
             ifFalse: [sb appendIndent: 1 line: "return"]
          ]
          ifFalse: [
            ctx emitResult: (elseBlock result) sb: sb indent: 1 retType: retType scope: elseScope
          ]
      ]
    ]
  | IrMatchKind.ByType => [
      sb appendIndent: 1 line: ("switch " + subjectName + ".(type) {")
      cases forEach: [c ->
        typeStr = c assertedTypeRef unpack: [it toGoType: ctx] or: (c condition toGoExpr: ctx scope: innerScope)
        sb appendIndent: 1 line: ("case " + typeStr + ":")
        caseScope = innerScope copy
        typeAlias unpack: [aliasName ->
          caseRefNames = c body collectIrRefNames
          sb appendIndent: 2 line: (aliasName + " := " + subjectName + ".(" + typeStr + ")")
          (caseRefNames contains: aliasName) ifFalse: [
            sb appendIndent: 2 line: ("_ = " + aliasName)
          ]
          caseScope locals add: aliasName
        ]
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 2 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (c body result) sb: sb indent: 2 retType: retType scope: caseScope
            sb appendIndent: 2 line: "return"
          ]
          ifFalse: [
            ctx emitResult: (c body result) sb: sb indent: 2 retType: retType scope: caseScope
          ]
      ]
      | elseBranchLocal
      | null => [
        sb appendIndent: 1 line: "default:"
        sb appendIndent: 2 line: "panic(\"invalid type assertion\")"
      ]
      |=> [
        elseBlock = elseBranchLocal
        sb appendIndent: 1 line: "default:"
        elseScope = innerScope copy
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 2 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (elseBlock result) sb: sb indent: 2 retType: retType scope: elseScope
            sb appendIndent: 2 line: "return"
          ]
          ifFalse: [
            ctx emitResult: (elseBlock result) sb: sb indent: 2 retType: retType scope: elseScope
          ]
      ]
      sb appendIndent: 1 line: "}"
    ]
  |=> [
      // ByValue or ByBool -> if/else chain
      casesCount = cases count
      cases forEachIndexed: [i, c ->
        isFirst = i == 0
        isLast = i == (casesCount - 1)
        cond = c condition toGoExpr: ctx scope: innerScope
        guardStr = c additionalConditions isNotEmpty
          ifTrue: [" && " + (c additionalConditions joinWith: " && " transform: [it toGoExpr: ctx scope: innerScope])]
         ifFalse: [""]
        fullCond = "(" + subjectName + " == " + cond + ")" + guardStr
        kw = isFirst ifTrue: ["if "] ifFalse: ["} else if "]
        sb appendIndent: 1 line: (kw + fullCond + " {")
        caseScope = innerScope copy
        c body blockToGoStatements: ctx scope: caseScope sb: sb indent: 2 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (c body result) sb: sb indent: 2 retType: retType scope: caseScope
            sb appendIndent: 2 line: "return"
          ]
          ifFalse: [
            ctx emitResult: (c body result) sb: sb indent: 2 retType: retType scope: caseScope
          ]
        isLast && (hasElse not) ifTrue: [
          sb appendIndent: 1 line: "}"
        ]
      ]
      | elseBranchLocal
      | null => []
      |=> [
        elseBlock = elseBranchLocal
        sb appendIndent: 1 line: "} else {"
        elseScope = innerScope copy
        elseBlock blockToGoStatements: ctx scope: elseScope sb: sb indent: 2 returnType: retType
        retType isGoUnitType
          ifTrue: [
            ctx emitResult: (elseBlock result) sb: sb indent: 2 retType: retType scope: elseScope
            sb appendIndent: 2 line: "return"
          ]
          ifFalse: [
            ctx emitResult: (elseBlock result) sb: sb indent: 2 retType: retType scope: elseScope
          ]
        sb appendIndent: 1 line: "}"
      ]
    ]

  sb appendLine: "}()"
  ^ sb toString
]

IrStmt toGoStmt(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
  token printGoLine-intoSb: sb
  | this
  | IrLet => [
      goName = name toSafeGoIdent
      scope locals add: name
      valueLocal = value
      typeStr = typeRef toGoType: ctx
      | valueLocal
      | null => [sb appendIndent: indent line: ("var " + goName + " " + typeStr)]
      |=> [
        valueExpr = valueLocal
        doProp = | valueExpr | IrCall => (valueExpr propagatingErrVar != null) |=> false
        doProp
          ifTrue: [
            valueExpr emitGoPropagatingCall: ctx scope: scope sb: sb indent: indent returnType: returnType bindTo: goName
            Unit
          ]
          ifFalse: [
            valueStr = valueExpr toGoExpr: ctx scope: scope
            sb appendIndent: indent line: ("var " + goName + " " + typeStr + " = " + valueStr)
          ]
      ]
      isUsed ifFalse: [
        sb appendIndent: indent line: ("_ = " + goName)
      ]
    ]
  | IrSetLocal => [
      goName = name toSafeGoIdent
      valueStr = value toGoExpr: ctx scope: scope
      sb appendIndent: indent line: (goName + " = " + valueStr)
  ]
  | IrSetField => [
      recvStr = receiver toGoExpr: ctx scope: scope
      valueStr = value toGoExpr: ctx scope: scope
      sb appendIndent: indent line: ("(" + recvStr + ")." + (field toSafeGoIdent) + " = " + valueStr)
  ]
  | IrDestructure => [
      tmpName = "__destructTmp" uniqueName: scope locals
      valueStr = value toGoExpr: ctx :scope
      sb appendIndent: indent line: (tmpName + " := " + valueStr)
      bindings forEach: [b ->
        goName = b name toSafeGoIdent
        scope locals add: b name
        sb appendIndent: indent line: ("var " + goName + " " + (b typeRef toGoType: ctx) + " = " + tmpName + "." + (b fieldName toSafeGoIdent))
        b isUsed ifFalse: [
          sb appendIndent: indent line: ("_ = " + goName)
        ]
      ]
  ]
  | IrExprStmt => [
      expr emitAsStmt: ctx scope: scope sb: sb indent: indent returnType: returnType
  ]
  | IrReturn => [
      exprLocal = expr
      hasErrors = returnType errors isNotEmpty
      | exprLocal
      | null => [
        hasErrors
          ifTrue: [sb appendIndent: indent line: "return nil"]
         ifFalse: [sb appendIndent: indent line: "return"]
      ]
      |=> [
        exprVal = exprLocal
        exprVal emitReturn: ctx scope: scope sb: sb indent: indent returnType: returnType
      ]
  ]
  | IrWhile => [
      condExpr = cond toGoExpr: ctx scope: scope
      bodyExpr = body toGoExpr: ctx scope: scope

      // whileTrue: is typically used as `[cond] whileTrue: [body]`, which arrives as IrLambda
      // for both parts, so we must invoke lambdas to preserve semantics.
      condStr = cond isIrLambda ifTrue: ["(" + condExpr + ")()"] ifFalse: [condExpr]
      bodyStr = body isIrLambda ifTrue: ["(" + bodyExpr + ")()"] ifFalse: [bodyExpr]
      sb appendIndent: indent line: "for {"
      sb appendIndent: (indent + 1) line: ("if !(" + condStr + ") { break }")
      sb appendIndent: (indent + 1) line: bodyStr
      sb appendIndent: indent line: "}"
  ]
  | IrThrow => [
      throwErrExpr = errExpr
      errStr = | throwErrExpr
        | IrTypeRefExpr => [
            ctx addImport: "fmt"
            "fmt.Errorf(\"" + (throwErrExpr ref typeId goNormalizeTypeId) + "\")"
          ]
        |=> throwErrExpr toGoExpr: ctx scope: scope
      returnLine = returnType isGoUnitType
        ifTrue: ["return " + errStr]
        ifFalse: ["return " + (returnType goZeroValue: ctx) + ", " + errStr]
      sb appendIndent: indent line: returnLine
  ]
]

extend IrBlock [
  on blockToGoExpr(ctx): GoContext scope: GoScope -> String = [
    retType = resultType
    retStr = retType isGoUnitType ifTrue: [""] ifFalse: [" " + (retType toGoType: ctx)]
    sb = StringBuilder new
    sb append: "func()"
    sb append: retStr
    sb appendLine: " {"

    innerScope = scope copy
    this blockToGoStatements: ctx scope: innerScope sb: sb indent: 1 returnType: retType
    ctx emitResult: result sb: sb indent: 1 retType: retType scope: innerScope

    sb appendLine: "}()"
    ^ sb toString
  ]

  on blockToGoStatements(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    stmts forEach: [st -> st toGoStmt: ctx scope: scope sb: sb indent: indent returnType: returnType]
    // return handling is done by caller
  ]

  on hasTrailingReturn -> Bool = [
    stmts isEmpty ifTrue: [^ false]
    lastStmt = stmts last
    ^ | lastStmt
      | IrReturn | IrThrow => true
      |=> false
  ]
]

List(String) goTypeParams -> String =
  .isEmpty  ifTrue: [""]
           ifFalse: [ "[" + (.joinWith: ", " transform: [it toSafeGoIdent + " any"]) + "]" ]

List(String) goTypeArgs -> String =
  .isEmpty  ifTrue: [""]
           ifFalse: [ "[" + (.joinWith: ", " transform: [it toSafeGoIdent]) + "]" ]

IrTypeRef collectGoTypeParamsInto(names): mut List(String) seen: mut Set(String) -> Unit = [
  baseId = typeId goNormalizeTypeId
  ((kind == IrTypeRefKind.Custom) && (baseId isGeneric)) ifTrue: [
    seen contains: baseId, ifFalse: [
      seen add: baseId
      names add: baseId
    ]
  ]
  args forEach: [it collectGoTypeParamsInto: names :seen]
  returnType unpack: [it collectGoTypeParamsInto: names :seen]
  errors forEach: [it collectGoTypeParamsInto: names :seen]
]

List(IrField) goTypeParamsFromFields -> List(String) = [
  names::mut List(String) = {}!
  seen::mut Set(String) = #()!
  .forEach: [field -> field typeRef collectGoTypeParamsInto: names :seen]
  ^ names toList
]

List(String) goCallArgs -> String = [
  .isEmpty ifTrue: [^ ""]
  ^ .joinWith: ", "
]
