type GoBackend



type GoSymbolTable
   typeNames: Map(String, String)
   funcNames: Map(String, String)
packageNames: Map(String, String)
   fileNames: Map(String, String)
 fieldNames: Map(String, Set(String))
constructorFieldTypes: Map(String, List(IrTypeRef))
fieldTypesByName: Map(String, Map(String, IrTypeRef))
unionTypeIds: Set(String)
unionDefs: Map(String, IrUnionDef)
// types whose == is a generated compare function, see goEquality.niva
eqTypeIds: Set(String)

type GoImportPlan
  importsByFile: Map(String, Set(String))

type GoFragment
   pkgId: String
 fileKey: String
orderKey: String
 imports: List(String)
    code: String

type GoFragmentFrame
 ctx: GoContext
  sb: StringBuilder

type GoFile
       path: String
packageName: String
    imports: List(String)
       body: String

type GoIrError
  message: String

type GoContext
  symbols: GoSymbolTable
  imports: mut Set(String)

constructor GoContext forSymbols(symbols): GoSymbolTable -> GoContext =
  GoContext :symbols imports: #()!

GoContext addImport(name): String -> Unit = [
  imports add: name
]

type GoScope
               locals: mut Set(String)
        pointerLocals: mut Set(String)
nullablePointerLocals: mut Set(String)
narrowedNullablePointerLocals: mut Set(String)
 implicitFields: mut Set(String)
implicitUnionFields: mut Set(String)
          mutLocals: mut Set(String)
unitReturnValue: Bool
receiverTypeRefHolder: mut List(IrTypeRef)

constructor GoScope new = GoScope locals: #()! pointerLocals: #()! nullablePointerLocals: #()! narrowedNullablePointerLocals: #()! implicitFields: #()! implicitUnionFields: #()! mutLocals: #()! unitReturnValue: false receiverTypeRefHolder: {}!

GoScope copy -> GoScope = [
  newLocals::mut Set(String) = #()!
  newPointers::mut Set(String) = #()!
  newNullablePointers::mut Set(String) = #()!
  newNarrowedNullablePointers::mut Set(String) = #()!
  newImplicitFields::mut Set(String) = #()!
  newImplicitUnionFields::mut Set(String) = #()!
  newMutLocals::mut Set(String) = #()!
  newReceiverTypeRefHolder::mut List(IrTypeRef) = {}!
  newReceiverTypeRefHolder addAll: receiverTypeRefHolder
  newUnitReturnValue = unitReturnValue
  newLocals addAll: locals
  newPointers addAll: pointerLocals
  newNullablePointers addAll: nullablePointerLocals
  newNarrowedNullablePointers addAll: narrowedNullablePointerLocals
  newImplicitFields addAll: implicitFields
  newImplicitUnionFields addAll: implicitUnionFields
  newMutLocals addAll: mutLocals

  ^ GoScope locals: newLocals pointerLocals: newPointers nullablePointerLocals: newNullablePointers narrowedNullablePointerLocals: newNarrowedNullablePointers implicitFields: newImplicitFields implicitUnionFields: newImplicitUnionFields mutLocals: newMutLocals unitReturnValue: newUnitReturnValue receiverTypeRefHolder: newReceiverTypeRefHolder
]

GoScope copyWithUnitReturnValue(value): Bool -> GoScope = [
  copied = this copy
  ^ copied unitReturnValue: value
]

GoScope addGoArg(arg): IrArg ctx: GoContext -> Unit = [
  locals add: arg name
  (ctx needsGoNullablePointerFor: arg typeRef) ifTrue: [nullablePointerLocals add: arg name]
  (arg typeRef goIsMutBoxType: ctx) ifTrue: [pointerLocals add: arg name]
]

// choose the effective type of a receiver because match narrowing does not
// update the ir type of this
IrExpr goReceiverTypeRef(ctx): GoContext scope: GoScope -> IrTypeRef? =
  | this
  | IrThisRef => scope receiverTypeRefHolder first
  |=> typeRef

IrExpr goBlockMaybe -> IrBlock? =
  | this
  | IrBlockExpr => block
  |=> null

GoContext emitResult: IrExpr? sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  blockMaybe = | emitResult
    | null => null
    |=> emitResult goBlockMaybe
  | blockMaybe
  | null => [
    hasErrors = retType errors isNotEmpty
    retType isGoUnitType
      ifTrue: [
        | emitResult
        | null => []
        |=> [
          emitResult token printGoLine-intoSb: sb
          emitResult emitAsUnusedValue: this :scope :sb :indent returnType: retType ]
      ]
      ifFalse: [
        | emitResult
        | null => [TO DO: "bug: Go emitResult: missing result for non-Unit return"]
        |=> [
          emitResult token printGoLine-intoSb: sb
          // a match returns from each branch
          emitResult goNeedsStatements ifTrue: [
            (emitResult goReturningResult) emitAsStmt: this :scope :sb :indent returnType: retType
          ] ifFalse: [
            lifted = emitResult goLiftedOperands: this :scope :sb :indent returnType: retType
            lifted isGoBoolConditional ifTrue: [
              this emitBoolConditionalResult: lifted :sb :indent :retType :scope
            ] ifFalse: [
              isNothingType = (lifted typeRef typeId goNormalizeTypeId) == "core_Nothing"
              isNothing = isNothingType && (lifted isGoNullLiteral not)
              isNothing ifTrue: [
                sb appendIndent: indent line: (lifted toGoStatement: this :scope returnType: retType)
                sb appendIndent: indent line: "panic(\"unreachable\")"
              ] ifFalse: [
                exprStr = (this needsGoNullablePointerFor: retType)
                  ifTrue: [lifted toGoNullableInitExpr: this :scope targetType: retType]
                  ifFalse: [lifted toGoValueExpr: this :scope]
                line = hasErrors
                  ifTrue:  ["return " + exprStr + ", nil"]
                 ifFalse: ["return " + exprStr]
                sb appendIndent: indent :line
              ]
            ]
          ]
        ]
      ]
  ]
  |=> [
    blockScope = scope copyWithUnitReturnValue: false
    sb appendIndent: indent line: "{"
    blockMaybe blockToGoStatements: this scope: blockScope :sb indent: (indent + 1) returnType: retType
    blockResultMaybe = blockMaybe result
    | blockResultMaybe
    | null => [
      blockMaybe hasTrailingReturn ifFalse: [
        this emitResult: null :sb indent: (indent + 1) :retType scope: blockScope
      ]
    ]
    |=> [
      this emitResult: blockResultMaybe :sb indent: (indent + 1) :retType scope: blockScope
    ]
    sb appendIndent: indent line: "}"
  ]
]

extend String [
  on goNormalizeTypeId -> String = [
    hasGeneric = this contains: "__"
    result = hasGeneric
        ifTrue: [this substringBefore: "__"]
       ifFalse: [this]
    ^ result
  ]

]

IrTypeRef coreFuncNameFromCall(name): String forMut(isMutable): Bool -> String = [
  baseId = typeId goNormalizeTypeId
  recvBase = baseId stripPkgPrefix: "core"
  recvBaseSafe = recvBase toSafeGoIdent
  normalized = (isMutable ifTrue: ["mut_"] ifFalse: [""]) + (name goSanitizeIdent)

  // generics monomorphizes in nin, but Any__echo has a single impl, not Int__echo Person__echo for every type
  // this should be solved by lazily generating ?__echo methods for everything or something elce
  x = name == "echo"
        ifTrue: ["Any__echo"]
        ifFalse: [recvBaseSafe + "__" + normalized]

  ^ x

]

IrCall toGoTryExpr(ctx): GoContext scope: GoScope -> String = [
  input = args first
  inputType = input typeRef
  hasErrors = inputType errors isNotEmpty
  isNullable = inputType nullable
  msgNameLocal = this msgNameOrEmpty
  isOrPanic = (msgNameLocal == "orPANIC") || (msgNameLocal == "unpackOrPANIC")
  inputHasNoValue = inputType isGoUnitType && (isNullable not)
  inputStr = input toGoExpr: ctx :scope
  outputType = typeRef
  outputHasErrors = outputType errors isNotEmpty

  sb = StringBuilder new
  sb append: "func()"
  sb append: (outputType goReturnTypes: ctx)
  sb appendLine: " {"

  valueName = "__tryValue"
  errName = "__tryErr"
  hasErrors ifTrue: [
    inputHasNoValue
      ifTrue: [sb appendIndent: 1 line: (errName + " := " + inputStr)]
      ifFalse: [sb appendIndent: 1 line: (valueName + ", " + errName + " := " + inputStr)]
    errorReturn = isOrPanic
      ifTrue: ["panic(" + errName + ")"]
      ifFalse: [outputType goReturnError: errName :ctx]
    sb appendIndent: 1 line: ("if " + errName + " != nil { " + errorReturn + " }")
  ] ifFalse: [
    sb appendIndent: 1 line: (valueName + " := " + inputStr)
  ]

  isNullable ifTrue: [
    sb appendIndent: 1 line: ("if " + valueName + " == nil { panic(\"try on null\") }")
  ]
  deref = isNullable ifTrue: [
      (ctx isGoNullableReferenceValue: inputType) ifTrue: [""] ifFalse: ["*"]
    ] ifFalse: [""]
  sb appendIndent: 1 line: (outputType goReturnResult: (deref + valueName) withError: outputHasErrors)

  sb append: "}()"
  ^ sb toString
]

GoContext goTypeNameFor(typeId): String -> String = [
  baseId = typeId goNormalizeTypeId
  existing = symbols typeNames at: baseId
  ^ existing orElse: ""
]

GoContext goFieldNamesFor(typeId): String -> Set(String) = [
  resultFields::mut Set(String) = #()!
  normalizedTypeId = typeId goNormalizeTypeId
  symbols fieldNames forEach: [key, names ->
    (key == normalizedTypeId) ifTrue: [resultFields addAll: names]
  ]
  ^ resultFields toSet
]

GoContext isGoUnionType(typeId): String -> Bool =
  symbols unionTypeIds contains: (typeId goNormalizeTypeId)

GoContext isGoNullableReferenceValue(typeRef): IrTypeRef -> Bool =
  (typeRef isGoNullableReferenceValue) ||
    ((typeRef kind == IrTypeRefKind.Custom) && (this isGoUnionType: typeRef typeId))

GoContext needsGoNullablePointerFor(typeRef): IrTypeRef -> Bool =
  typeRef nullable && ((this isGoNullableReferenceValue: typeRef) not)

GoContext goFieldGetterName(fieldName): String -> String =
  "nivaField__" + (fieldName toSafeGoIdent)

GoSymbolTable irFieldTypeOf(receiverTypeRef): IrTypeRef field(fieldName): String -> IrTypeRef? = [
  key = receiverTypeRef typeId goNormalizeTypeId
  fieldMapMaybe = fieldTypesByName at: key
  mut directMaybe::IrTypeRef? = null
  | fieldMapMaybe
  | null => ()
  |=> [
    directMaybe <- (fieldMapMaybe at: fieldName)
    ()
  ]
  ^ | directMaybe
    | null => [
        unionMaybe = unionDefs at: key
        | unionMaybe
        | null => null
        |=> this branchFieldTypeOf: unionMaybe field: fieldName
      ]
    |=> directMaybe
]

// field type from any union branch including included unions
GoSymbolTable branchFieldTypeOf(unionDef): IrUnionDef field(fieldName): String -> IrTypeRef? = [
  mut result::IrTypeRef? = null
  unionDef branches forEach: [branch ->
    (result == null) ifTrue: [
      branchKey = ((unionDef pkgId + "_" + branch name) goNormalizeTypeId)
      fieldMapMaybe = fieldTypesByName at: branchKey
      | fieldMapMaybe
      | null => ()
      |=> [
        result <- (fieldMapMaybe at: fieldName)
        ()
      ]
    ]
  ]
  ^ result
]

GoSymbolTable collectUnionBranchTypes(typeId): String seenUnions: mut Set(String) concreteTypes: mut Set(String) -> Unit = [
  normalizedTypeId = typeId goNormalizeTypeId
  (seenUnions contains: normalizedTypeId) ifFalse: [
    seenUnions add: normalizedTypeId
    unionMaybe = unionDefs at: normalizedTypeId
    | unionMaybe
    | null => [concreteTypes add: normalizedTypeId]
    |=> [
      unionMaybe branches forEach: [branch ->
        branchTypeId = unionMaybe pkgId + "_" + branch name
        branch isInclude
          ifTrue: [this collectUnionBranchTypes: branchTypeId :seenUnions :concreteTypes]
          ifFalse: [concreteTypes add: (branchTypeId goNormalizeTypeId)]
      ]
    ]
  ]
]

GoSymbolTable concreteUnionBranchTypeIds(typeId): String -> List(String) = [
  seenUnions::mut Set(String) = #()!
  concreteTypes::mut Set(String) = #()!
  this collectUnionBranchTypes: typeId :seenUnions :concreteTypes
  ^ concreteTypes toList
]

GoSymbolTable collectContainingUnionTypeIds(typeId): String seen: mut Set(String) result: mut Set(String) -> Unit = [
  normalizedTypeId = typeId goNormalizeTypeId
  (seen contains: normalizedTypeId) ifFalse: [
    seen add: normalizedTypeId
  unionDefs forEach: [parentId, parentDef ->
    includesType = parentDef branches any: [branch ->
      branch isInclude && ((parentDef pkgId + "_" + branch name goNormalizeTypeId) == normalizedTypeId)
    ]
    includesType ifTrue: [
      result add: parentId
      this collectContainingUnionTypeIds: parentId :seen :result
    ]
  ]
  ]
]

GoSymbolTable containingUnionTypeIds(typeId): String -> List(String) = [
  seen::mut Set(String) = #()!
  result::mut Set(String) = #()!
  this collectContainingUnionTypeIds: typeId :seen :result
  ^ result toList sortedBy: [it]
]

IrFunction goSymbolKey -> String = (id substringBefore: "__ctor_") + "__arity_" + (args count toString)

IrCall goSymbolKey(id): String -> String = [
  baseId = isConstructor ifTrue: [id substringBefore: "__ctor_"] ifFalse: [id]
  baseId + "__arity_" + (paramTypes count toString)
]

IrCall toGoNullableOptionExpr(ctx): GoContext call(callExpr): String -> String = [
  nullableGoType = typeRef toGoType: ctx
  baseGoType = typeRef goBaseType: ctx
  optionValue = (ctx needsGoNullablePointerFor: typeRef)
    ifTrue: ["core.NewNullable(" + baseGoType + "(__nivaOption.Value))"]
    ifFalse: ["__nivaOption.Value"]
  ^ "func() " + nullableGoType + " { __nivaOption := " + callExpr +
    "; if !__nivaOption.HasValue { return " + (typeRef goZeroValue: ctx) +
    " }; return " + optionValue + " }()"
]

IrFunction goFuncNameFromIr -> String = [
  recvId = receiverType typeId


  recvBase = pkgId != ""
              ifTrue:  [ recvId stripPkgPrefix: pkgId ]
             ifFalse: [ recvId ],
             goSanitizeIdent

  sel = name goSanitizeIdent

  full =
    pkgId != ""
      ifTrue: [ pkgId + "__" + recvBase + "__" + sel ]
     ifFalse: [ recvBase + "__" + sel ]

  ^ full toSafeGoIdent
]

extend GoContext [
  on goFuncNameForFn(fn): IrFunction -> String = [
    ^ this goFuncNameFor: (fn goSymbolKey)
  ]

  on goFuncNameFor(funcId): String -> String = [
    existing = symbols funcNames at: funcId
    ^ existing orElse: ""
  ]

]

IrUnionDef goBranchTypeIds -> List(String) = [
  ids::mut List(String) = {}!
  branches forEach: [br ->
    br isInclude ifFalse: [
      ids add: (pkgId + "_" + br name)
    ]
  ]
  ^ ids toList
]

Int goIndent -> String = [
  sb = StringBuilder new
  mut i = 0
  [i < this] whileTrue: [
    sb append: "    "
    i <- i inc
  ]
  ^ sb toString
]

StringBuilder appendIndent(level): Int line: String -> Unit = [
  this append: (level goIndent)
  this appendLine: line
  ()
]

GoContext emitLambdaBranchResult(branch): IrExpr sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  | branch
  | IrLambda => [
    branchScope = scope copy
    branch args forEach: [arg -> branchScope addGoArg: arg ctx: this]
    branch body blockToGoStatements: this scope: branchScope :sb :indent returnType: retType
    branchResult = branch body result
    bodyHasTrailingReturn = branch body hasTrailingReturn
    | branchResult
    | null => [
      bodyHasTrailingReturn ifFalse: [
        retType isGoUnitType
          ifTrue: [sb appendIndent: indent line: "return"]
          ifFalse: [sb appendIndent: indent line: "panic(\"missing branch result\")"]
      ]
    ]
    |=> [
      this emitResult: branchResult :sb :indent :retType scope: branchScope
      (retType isGoUnitType && (bodyHasTrailingReturn not)) ifTrue: [
        sb appendIndent: indent line: "return"
      ]
    ]
  ]
  |=> sb appendIndent: indent line: "panic(\"invalid boolean branch\")"
]

GoContext emitBoolConditionalResult(call): IrExpr sb: StringBuilder indent: Int retType: IrTypeRef scope: GoScope -> Unit = [
  | call
  | IrCall => [
    args = call args
    condition = args first toGoValueExpr: this :scope
    msgNameLocal = call msgNameOrEmpty
    isFalseFirst = (msgNameLocal == "ifFalse_ifTrue") || (msgNameLocal == "ifFalse__ifTrue")
    trueBranch = isFalseFirst ifTrue: [args at: 2] ifFalse: [args at: 1]
    falseBranch = isFalseFirst ifTrue: [args at: 1] ifFalse: [args at: 2]
    sb appendIndent: indent line: ("if " + condition + " {")
    this emitLambdaBranchResult: trueBranch :sb indent: (indent + 1) :retType :scope
    sb appendIndent: indent line: "} else {"
    this emitLambdaBranchResult: falseBranch :sb indent: (indent + 1) :retType :scope
    sb appendIndent: indent line: "}"
  ]
  |=> []
]

GoContext emitBoolMatchBranch(branchCase): IrMatchCase sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope -> Unit = [
  branchScope = scope copy
  branchBlock = branchCase body
  branchBlock blockToGoStatements: this scope: branchScope :sb :indent :returnType
  branchResultMaybe = branchBlock result
  | branchResultMaybe
  | null => []
  |=> branchResultMaybe emitAsStmt: this scope: branchScope :sb :indent :returnType
]

GoContext emitGoElseBlock(elseBranch): IrBlock sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope -> Unit = [
  sb appendIndent: indent line: "} else {"
  elseScope = scope copy
  elseBranch blockToGoStatements: this scope: elseScope :sb indent: (indent + 1) :returnType
  elseResultMaybe = elseBranch result
  | elseResultMaybe
  | null => []
  |=> elseResultMaybe emitAsStmt: this scope: elseScope :sb indent: (indent + 1) :returnType
]

GoContext emitBoolMatchStatement(matchExpr): IrMatchExpr sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope -> Unit = [
  mut trueCase::IrMatchCase? = null
  mut falseCase::IrMatchCase? = null
  matchExpr cases forEach: [branchCase ->
    conditionStr = branchCase condition toGoExpr: this :scope
    conditionStr == "true" ifTrue: [trueCase <- branchCase]
    conditionStr == "false" ifTrue: [falseCase <- branchCase]
  ]

  subjectExpr = matchExpr subject toGoValueExpr: this :scope
  trueCaseMaybe = trueCase
  falseCaseMaybe = falseCase
  elseBranchMaybe = matchExpr elseBranch

  trueCaseMaybe != null ifTrue: [
    trueBranchCase::IrMatchCase = trueCaseMaybe expect: "Missing true case in boolean match"
    sb appendIndent: indent line: ("if " + subjectExpr + " {")
    this emitBoolMatchBranch: trueBranchCase :sb indent: (indent + 1) :returnType :scope
    falseCaseMaybe != null ifTrue: [
      falseBranchCase::IrMatchCase = falseCaseMaybe expect: "Missing false case in boolean match"
      sb appendIndent: indent line: "} else {"
      this emitBoolMatchBranch: falseBranchCase :sb indent: (indent + 1) :returnType :scope
    ] ifFalse: [
      elseBranchMaybe ifNotNull: [elseBranchValue ->
        this emitGoElseBlock: elseBranchValue :sb :indent :returnType :scope
      ]
    ]
    sb appendIndent: indent line: "}"
  ] ifFalse: [
    falseCaseMaybe != null ifTrue: [
      falseBranchCase::IrMatchCase = falseCaseMaybe expect: "Missing false case in boolean match"
      sb appendIndent: indent line: ("if !(" + subjectExpr + ") {")
      this emitBoolMatchBranch: falseBranchCase :sb indent: (indent + 1) :returnType :scope
      elseBranchMaybe ifNotNull: [elseBranchValue ->
        this emitGoElseBlock: elseBranchValue :sb :indent :returnType :scope
      ]
      sb appendIndent: indent line: "}"
    ]
  ]
]

// match as a statement must be inlined instead of becoming an anonymous
// go function, so a non-local return (^) works
GoContext emitMatchStatement(matchExpr): IrMatchExpr sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope -> Unit = [
  matchKind = matchExpr kind
  // the value of a mut cell, not the cell
  subjectExpr = matchExpr subject toGoValueExpr: this :scope
  | matchKind
  | IrMatchKind.ByError => [
    this emitMatchErrorStatement: matchExpr :sb :indent :returnType :scope subjectCode: subjectExpr
  ]
  | IrMatchKind.ByType => [
    subjectName = "__matchSubject" uniqueName: scope locals
    sb appendIndent: indent line: ("var " + subjectName + " interface{} = " + subjectExpr)
    this emitMatchTypeStatement: matchExpr :sb :indent :returnType :scope :subjectName
  ]
  |=> [
    subjectName = "__matchSubject" uniqueName: scope locals
    sb appendIndent: indent line: (subjectName + " := " + subjectExpr)
    this emitMatchValueStatement: matchExpr :sb :indent :returnType :scope :subjectName
  ]
]

// branch statements plus the discarded branch result for an inlined match
GoContext emitMatchBlockStatements(block): IrBlock sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope -> Unit = [
  block blockToGoStatements: this :scope :sb :indent :returnType
  blockResultMaybe = block result
  | blockResultMaybe
  | null => []
  |=> blockResultMaybe emitAsStmt: this :scope :sb :indent :returnType
]

GoContext emitMatchValueStatement(matchExpr): IrMatchExpr sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope subjectName: String -> Unit = [
  elseBranchLocal = matchExpr elseBranch
  hasElse = elseBranchLocal ifSome: [it -> true]
  hasNullCase = matchExpr cases any: [c -> c condition isGoNullLiteral]
  subjectLocalNameMaybe = matchExpr subject goLocalVarName
  subjectLocalName = subjectLocalNameMaybe orElse: ""
  casesCount = matchExpr cases count
  matchExpr cases forEachIndexed: [i, c ->
    isFirst = i == 0
    isLast = i == (casesCount - 1)
    cond = c condition toGoExpr: this :scope
    additionalConditions = c additionalConditions
    fullCond = additionalConditions isNotEmpty
      ifTrue: [
        additionalConditionsStr = additionalConditions joinWith: " || " transform: [condition ->
          "(" + subjectName + " == " + (condition toGoExpr: this :scope) + ")"
        ]
        "((" + subjectName + " == " + cond + ") || " + additionalConditionsStr + ")"
      ]
      ifFalse: ["(" + subjectName + " == " + cond + ")"]
    kw = isFirst ifTrue: ["if "] ifFalse: ["} else if "]
    sb appendIndent: indent line: (kw + fullCond + " {")
    caseScope = scope copy
    this emitMatchBlockStatements: (c body) :sb indent: (indent + 1) :returnType scope: caseScope
    isLast && (hasElse not) ifTrue: [
      sb appendIndent: indent line: "} else {"
      sb appendIndent: (indent + 1) line: "panic(\"unmatched value\")"
      sb appendIndent: indent line: "}"
    ]
  ]
  elseBranchLocal ifNotNull: [elseBranchLocalValue ->
    sb appendIndent: indent line: "} else {"
    elseScope = scope copy
    ((subjectLocalName != "") && hasNullCase) ifTrue: [
      elseScope narrowedNullablePointerLocals add: subjectLocalName
    ]
    this emitMatchBlockStatements: elseBranchLocalValue :sb indent: (indent + 1) :returnType scope: elseScope
    sb appendIndent: indent line: "}"
  ]
]

GoContext emitMatchTypeStatement(matchExpr): IrMatchExpr sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope subjectName: String -> Unit = [
  sb appendIndent: indent line: ("switch " + subjectName + ".(type) {")
  matchExpr cases forEach: [c ->
    (c goCaseTypeStrs: this :scope) forEach: [typeStr ->
      sb appendIndent: indent line: ("case " + typeStr + ":")
      caseScope = scope copy
      aliasNameMaybe = matchExpr typeAlias
      aliasNameMaybe ifNotNull: [aliasNameValue ->
        caseRefNames = c body collectIrRefNames
        sb appendIndent: (indent + 1) line: (aliasNameValue + " := " + subjectName + ".(" + typeStr + ")")
        (caseRefNames contains: aliasNameValue) ifFalse: [
          sb appendIndent: (indent + 1) line: ("_ = " + aliasNameValue)
        ]
        caseScope locals add: aliasNameValue
        caseScope nullablePointerLocals remove: aliasNameValue
        caseScope narrowedNullablePointerLocals remove: aliasNameValue
        (aliasNameValue == "this") ifTrue: [
          c assertedTypeRef ifNotNull: [narrowedType ->
            caseScope receiverTypeRefHolder clear
            caseScope receiverTypeRefHolder add: narrowedType
            narrowedKey = narrowedType typeId goNormalizeTypeId
            isNarrowedUnion = this isGoUnionType: narrowedKey
            narrowedNamesMaybe = this symbols fieldNames at: narrowedKey
            | narrowedNamesMaybe
            | null => ()
            |=> [
              mut targetSet = caseScope implicitUnionFields
              isNarrowedUnion ifFalse: [targetSet <- caseScope implicitFields]
              targetSet addAll: narrowedNamesMaybe
              ()
            ]
          ]
        ]
        ()
      ]
      this emitMatchBlockStatements: (c body) :sb indent: (indent + 1) :returnType scope: caseScope
    ]
  ]
  elseBranchLocal = matchExpr elseBranch
  | elseBranchLocal
  | null => [
    sb appendIndent: indent line: "default:"
    sb appendIndent: (indent + 1) line: "panic(\"invalid type assertion\")"
  ]
  |=> [
    sb appendIndent: indent line: "default:"
    elseScope = scope copy
    this emitMatchBlockStatements: elseBranchLocal :sb indent: (indent + 1) :returnType scope: elseScope
  ]
  sb appendIndent: indent line: "}"
]

GoContext emitMatchErrorStatement(matchExpr): IrMatchExpr sb: StringBuilder indent: Int returnType: IrTypeRef scope: GoScope subjectCode: String -> Unit = [
  subjectIsUnit = matchExpr subjectIsUnit
  valueName = "__matchValue" uniqueName: scope locals
  errName = "__matchErr" uniqueName: scope locals
  subjectIsUnit
    ifTrue: [sb appendIndent: indent line: (errName + " := " + subjectCode)]
    ifFalse: [sb appendIndent: indent line: (valueName + ", " + errName + " := " + subjectCode)]
  sb appendIndent: indent line: ("if " + errName + " != nil {")
  sb appendIndent: (indent + 1) line: ("switch " + errName + ".(type) {")
  matchExpr cases forEach: [c ->
    typeStr = c goCaseTypeStr: this :scope
    sb appendIndent: (indent + 1) line: ("case " + typeStr + ":")
    caseScope = scope copy
    aliasStr = matchExpr goMatchAliasOrIt
    caseScope locals add: aliasStr
    sb appendIndent: (indent + 2) line: (aliasStr + " := " + errName + ".(" + typeStr + ")")
    (c body collectIrRefNames contains: aliasStr) ifFalse: [
      sb appendIndent: (indent + 2) line: ("_ = " + aliasStr)
    ]
    this emitMatchBlockStatements: (c body) :sb indent: (indent + 2) :returnType scope: caseScope
  ]
  sb appendIndent: (indent + 1) line: "default:"
  sb appendIndent: (indent + 2) line: "panic(\"unmatched error\")"
  sb appendIndent: (indent + 1) line: "}"
  elseBranchLocal = matchExpr elseBranch
  | elseBranchLocal
  | null => [
    sb appendIndent: indent line: "}"
    subjectIsUnit ifFalse: [sb appendIndent: indent line: ("_ = " + valueName)]
  ]
  |=> [
    elseScope = scope copy
    aliasStr = matchExpr goMatchAliasOrIt
    elseScope locals add: aliasStr
    // only when there's no error, and in a block of its own, so the next
    // match on errors can declare its alias too
    sb appendIndent: indent line: "} else {"
    subjectIsUnit ifFalse: [
      sb appendIndent: (indent + 1) line: (aliasStr + " := " + valueName)
      (elseBranchLocal collectIrRefNames contains: aliasStr) ifFalse: [
        sb appendIndent: (indent + 1) line: ("_ = " + aliasStr)
      ]
    ]
    this emitMatchBlockStatements: elseBranchLocal :sb indent: (indent + 1) :returnType scope: elseScope
    sb appendIndent: indent line: "}"
  ]
]

IrExpr isGoPropagatingCall -> Bool = | this | IrCall => propagatingErrVar != null |=> false

// go type text for a match case
IrMatchCase goCaseTypeStr(ctx): GoContext scope: GoScope -> String = [
  asserted = this assertedTypeRef
  ^ | asserted
    | null => this condition toGoExpr: ctx :scope
    |=> asserted toGoType: ctx
]

// all types a case matches on, the first pattern and every pattern after it
IrMatchCase goCaseTypeStrs(ctx): GoContext scope: GoScope -> List(String) = [
  assertedTypeMaybe = this assertedTypeRef
  firstTypeStr = | assertedTypeMaybe
    | null => condition toGoExpr: ctx :scope
    |=> assertedTypeMaybe toGoType: ctx
  typeStrs::mut List(String) = {firstTypeStr}!
  additionalConditions forEach: [alt ->
    | alt
    | IrTypeRefExpr => [
      typeStrs add: (alt ref toGoType: ctx)
      ()
    ]
    |=> []
  ]
  ^ typeStrs toList
]

// alias name for match branches
IrMatchExpr goMatchAliasOrIt -> String = [
  alias = this typeAlias
  ^ alias orElse: "it"
]

IrExpr isGoBoolConditional -> Bool =
  | this
  | IrCall => [
    msgNameLocal = this msgNameOrEmpty
    ((msgNameLocal == "ifTrue__ifFalse") || (msgNameLocal == "ifFalse_ifTrue") ||
      (msgNameLocal == "ifFalse__ifTrue")) && (args count > 2)
  ]
  |=> false

GoImportPlan importsForFile(fileKey): String -> List(String) = [
  imports = importsByFile at: fileKey
  ^ | imports
    | null => {}
    |=> imports toList
]

extend IrTypeRef [

  on isGoNullableReferenceValue -> Bool =
    (kind == IrTypeRefKind.Function) ||
      ((kind == IrTypeRefKind.Builtin) && ((this isGoRefLike) || ((typeId goNormalizeTypeId) == "core_Any") || ((typeId goNormalizeTypeId) == "core_Error")))

  // Nullable simple types should be pointers in go
  // lists, maps, functions and interfaces can use nil
  on isGoUnitType -> Bool =
    typeId goNormalizeTypeId == "core_Unit"

  on goZeroValue(ctx): GoContext -> String = [
    ^ nullable ifTrue: ["nil"] ifFalse: [
      baseId = typeId goNormalizeTypeId
      | kind
      | IrTypeRefKind.Builtin => [
          | baseId
          | "core_Int" | "core_Long" | "core_Int64" | "core_Double" | "core_Float" | "core_Char" => "0"
          | "core_String" => "\"\""
          | "core_Bool" => "false"
          | "core_Unit" => "core.UnitInstance"
          |=> "nil"
        ]
      | IrTypeRefKind.Custom => (ctx goTypeNameFor: baseId) + "{}"
      |=> "nil"
    ]
  ]

  // go return when we propagate the error itself
  on goReturnError(errName): String ctx: GoContext -> String = [
    ^ this isGoUnitType
      ifTrue: ["return " + errName]
      ifFalse: ["return " + (this goZeroValue: ctx) + ", " + errName]
  ]

  // go return when no result value is available and we fall back to the zero value
  on goReturnZero(ctx): GoContext err(errName): String withError(hasError): Bool -> String = [
    ^ this isGoUnitType
      ifTrue: [hasError ifTrue: ["return " + errName] ifFalse: ["return"]]
      ifFalse: [
        zero = this goZeroValue: ctx
        hasError ifTrue: ["return " + zero + ", " + errName] ifFalse: ["return " + zero]
      ]
  ]

  // go return when the result value is ready
  on goReturnResult(value): String withError(hasError): Bool -> String = [
    ^ this isGoUnitType
      ifTrue: [hasError ifTrue: ["return nil"] ifFalse: ["return"]]
      ifFalse: [hasError ifTrue: ["return " + value + ", nil"] ifFalse: ["return " + value]]
  ]

  on goReturnTypes(ctx): GoContext -> String = [
    hasErr = errors isNotEmpty
    isUnit = this isGoUnitType
    ^ hasErr
        ifTrue: [
          isUnit ifTrue: [" error"] ifFalse: [" (" + (this toGoType: ctx) + ", error)"]
        ]
        ifFalse: [
          isUnit ifTrue: [""] ifFalse: [" " + (this toGoType: ctx)]
        ]
  ]

  on goBaseType(ctx): GoContext -> String = [
    baseId = typeId goNormalizeTypeId
    ^ | kind
      | IrTypeRefKind.Function => [
          argsStr = args joinWith: ", " transform: [it toGoParamType: ctx]
          retTypeMaybe = returnType
          retStr = | retTypeMaybe
                   | null => ""
                   |=> retTypeMaybe isGoUnitType ifTrue: [""] ifFalse: [retTypeMaybe toGoType: ctx]
          retStr == "" ifTrue: ["func(" + argsStr + ")"]
                      ifFalse: ["func(" + argsStr + ") " + retStr]
        ]
      |=> (baseId == "core_Unit") ifTrue: ["struct{}"] ifFalse: [
        | kind
        | IrTypeRefKind.Builtin => [
            (baseId == "core_Long") || (baseId == "core_Int64")
              ifTrue: ["int64"] ifFalse: [
            | baseId
            | "core_Int"     => "int"
            | "core_Double"  => "float64"
            | "core_Float"   => "float32"
            | "core_String"  => "string"
            | "core_Bool"    => "bool"
            | "core_Char"    => "rune"
            | "core_Unit"    => "struct{}"
            | "core_Any" | "core_Nothing" | "core_Null" => "interface{}"
            | "core_Error"   => "error"
            | "core_Compiler" => "struct{}"
            | "core_StringBuilder" => [
                ctx addImport: "niva_go/core"
                "*core.StringBuilder"
              ]
            | "core_List"    => [
                elem = args isNotEmpty ifTrue: [args first toGoType: ctx] ifFalse: ["interface{}"]
                "[]" + elem
              ]
            | "core_Set" => [
                elem = args isNotEmpty ifTrue: [args first toGoType: ctx] ifFalse: ["interface{}"]
                "map[" + elem + "]struct{}"
              ]
            | "core_Map" => [
                keyType = args count > 0 ifTrue: [args at: 0, toGoType: ctx] ifFalse: ["interface{}"]
                valType = args count > 1 ifTrue: [args at: 1, toGoType: ctx] ifFalse: ["interface{}"]
                "map[" + keyType + "]" + valType
              ]
            |=> ctx goTypeNameFor: baseId
            ]
          ]
        |=> [
            baseId isGeneric ifTrue: [baseId toSafeGoIdent] ifFalse: [
            name = ctx goTypeNameFor: baseId
            argsStr = args isNotEmpty
              ifTrue: ["[" + (args joinWith: ", " transform: [it toGoType: ctx]) + "]"]
             ifFalse: [""]
            name + argsStr
            ]
          ]
        ]
  ]

  on toGoType(ctx): GoContext -> String = [
    base = this goBaseType: ctx
    ^ nullable
        ifTrue: [
          // already reference-like types can be nil without pointer
          isAny = base == "any"
          isIfaceStr = base == "interface{}"
          isIface = isAny || isIfaceStr

          isRefLike = (this isGoRefLike) || isIface || ((kind == IrTypeRefKind.Custom) && (ctx isGoUnionType: typeId))
          isRefLike ifTrue: [base] ifFalse: ["*" + base]
        ]
        ifFalse: [base]
  ]

  on toGoParamType(ctx): GoContext -> String =
    this isGoPointerParam,
      ifTrue: [
        (nullable && (typeId goNormalizeTypeId != "core_List"))
          ifTrue: [this toGoType: ctx]
          ifFalse: ["*" + (this goBaseType: ctx)]
      ]
      ifFalse: [this toGoType: ctx]

  // mut values of boxable types live as go pointers so struct copies share
  // the same cell this mirrors the reference semantics of jvm and clojure
  on goIsMutBoxType(ctx): GoContext -> Bool = [
    baseId = typeId goNormalizeTypeId
    isRefLikeGo = (kind == IrTypeRefKind.Function) ||
      ((kind == IrTypeRefKind.Builtin) && ((baseId == "core_StringBuilder") || (baseId == "core_Any") || (baseId == "core_Nothing") || (baseId == "core_Null") || (baseId == "core_Error") || (baseId == "core_Unit")))
    isUnionCustom = (kind == IrTypeRefKind.Custom) && (ctx isGoUnionType: typeId)
    ^ isMut && (nullable not) && (isRefLikeGo not) && (isUnionCustom not)
  ]

  // struct field declaration type boxes mut values into pointers
  on toGoFieldType(ctx): GoContext -> String =
    (this goIsMutBoxType: ctx)
      ifTrue: ["*" + (this goBaseType: ctx)]
      ifFalse: [this toGoType: ctx]

]

String goEscapeString -> String = [
  escapedSlashes = this replace: "\\" with: "\\\\"
  escapedQuotes = escapedSlashes replace: "\"" with: "\\\""
  escapedNewlines = escapedQuotes replace: "\n" with: "\\n"
  escapedReturns = escapedNewlines replace: "\r" with: "\\r"
  escapedTabs = escapedReturns replace: "\t" with: "\\t"
  ^ escapedTabs
]

IrLiteral toGoLiteral -> String = [
  ^ | kind
    | IrLiteralKind.Null => "nil"
    | IrLiteralKind.Unit => "core.UnitInstance"
    | IrLiteralKind.Bool | IrLiteralKind.Int | IrLiteralKind.Double | IrLiteralKind.Char | IrLiteralKind.String => lexeme
    | IrLiteralKind.Float => lexeme endsWith: "f", ifTrue: [lexeme dropLast: 1] ifFalse: [lexeme]
    | IrLiteralKind.RawString => [
        rawContent = (lexeme drop: 3) dropLast: 3
        "\"" + (rawContent goEscapeString) + "\""
      ]
    |=> "\"" + lexeme + "\""
]

IrCall tryGoBindExpr(ctx): GoContext scope: GoScope -> String? = null

// collect all IrVarRef names from an IR block (for match alias usage check)
IrBlock collectIrRefNames -> mut Set(String) = [
  refs::mut Set(String) = #()!
  stmts forEach: [it collectIrStmtRefs: refs]
  resultMaybe = result
  | resultMaybe
  | null => []
  |=> resultMaybe collectIrExprRefs: refs
  ^ refs
]

IrStmt collectIrStmtRefs(refs): mut Set(String) -> Unit = [
  | this
  | IrLet      => [
      valueMaybe = value
      | valueMaybe
      | null => []
      |=> valueMaybe collectIrExprRefs: refs
    ]
  | IrSetLocal => [ value collectIrExprRefs: refs ]
  | IrSetField => [ receiver collectIrExprRefs: refs
                    value collectIrExprRefs: refs ]
  | IrDestructure => [ value collectIrExprRefs: refs ]
  | IrExprStmt    => [ expr collectIrExprRefs: refs ]
  | IrReturn      => [
      exprMaybe = expr
      | exprMaybe
      | null => []
      |=> exprMaybe collectIrExprRefs: refs
    ]
  | IrWhile       => [ cond collectIrExprRefs: refs
                       body collectIrExprRefs: refs ]
  | IrThrow       => [ errExpr collectIrExprRefs: refs ]
]

IrExpr collectIrExprRefs(refs): mut Set(String) -> Unit = [
  | this
  | IrVarRef      => refs add: name
  | IrLiteralExpr | IrThisRef => []
  | IrFieldGet    => receiver collectIrExprRefs: refs
  | IrCall        => [
    calleeMaybe = callee
    | calleeMaybe
    | null => []
    |=> calleeMaybe collectIrExprRefs: refs
    args forEach: [it collectIrExprRefs: refs]
  ]
  | IrLambda    => body collectIrRefNames forEach: [refs add: it]
  | IrBlockExpr => block collectIrRefNames forEach: [refs add: it]
  | IrMatchExpr => [
    subject collectIrExprRefs: refs
    cases forEach: [c ->
      c condition collectIrExprRefs: refs
      c additionalConditions forEach: [it collectIrExprRefs: refs]
      c body collectIrRefNames forEach: [refs add: it]
    ]
    elseBranch ifNotNull: [elseBranchMaybe ->
      elseBranchMaybe collectIrRefNames forEach: [refs add: it]
    ]
  ]
  | IrNewExpr           => args forEach: [it collectIrExprRefs: refs]
  | IrCollectionLiteral => items forEach: [it collectIrExprRefs: refs]
  | IrOpBin             => [
    left collectIrExprRefs: refs
    right collectIrExprRefs: refs
  ]
  | IrTypeRefExpr => []
]


extend IrExpr [
  on goLocalVarName -> String? =
    | this
    | IrVarRef => name
    | IrThisRef => "this"
    |=> null

  on isGoNullLiteral -> Bool =
    | this
    | IrLiteralExpr => literal kind == IrLiteralKind.Null
    |=> false

  on isGoBoolLiteral -> Bool =
    | this
    | IrLiteralExpr => literal kind == IrLiteralKind.Bool
    |=> false

  // mut values whose type is boxable live as go pointers so struct copies
  // share the same cell this mirrors the reference semantics of the jvm and
  // clojure backends
  on isGoPointerValue(ctx): GoContext scope: GoScope -> Bool =
    | this
    | IrVarRef => [
        (scope pointerLocals contains: name) ifTrue: [true] ifFalse: [
          isImplicit = (scope implicitFields contains: name) || (scope implicitUnionFields contains: name)
          isImplicit ifFalse: [false] ifTrue: [
            recvType = scope receiverTypeRefHolder first
            ftMaybe = ctx symbols irFieldTypeOf: recvType field: name
            ftMaybe ifSome: [it -> it goIsMutBoxType: ctx]
          ]
        ]
      ]
    | IrThisRef => scope pointerLocals contains: "this"
    | IrFieldGet => this isGoMutBoxRead: ctx :scope
    |=> false

  // this can be narrowed in a match so its fields are resolved from the
  // receiver holder rather than the original union type
  on isGoMutBoxRead(ctx): GoContext scope: GoScope -> Bool =
    | this
    | IrFieldGet => [
        recvTypeMaybe = receiver goReceiverTypeRef: ctx :scope
        recvType = recvTypeMaybe orElse: typeRef
        ftMaybe = ctx symbols irFieldTypeOf: recvType :field
        ftMaybe ifSome: [it -> it goIsMutBoxType: ctx]
      ]
    |=> false

  // plain value form of an expression dereferences mut cells
  on toGoValueExpr(ctx): GoContext scope: GoScope -> String = [
    valueStr = this toGoExpr: ctx :scope
    (this isGoPointerValue: ctx :scope) ifTrue: ["*" + valueStr] ifFalse: [valueStr]
  ]

  on toGoNullableInitExpr(ctx): GoContext scope: GoScope targetType: IrTypeRef -> String = [
    valueStr = this toGoExpr: ctx :scope
    isNull = this isGoNullLiteral

    result = (typeRef nullable || isNull) ifTrue: [valueStr] ifFalse: [
        ctx addImport: "niva_go/core"
        targetGoType = targetType goBaseType: ctx
        "core.NewNullable(" + targetGoType + "(" + valueStr + "))"
      ]
    ^ result
  ]

  on toGoLocalAssignExpr(ctx): GoContext scope: GoScope targetIsNullable: Bool targetIsMutPointer: Bool -> String = [
    valueStr = this toGoExpr: ctx :scope
    isNull = this isGoNullLiteral
    sourceIsNullablePointer = ctx needsGoNullablePointerFor: typeRef
    sourceIsCell = this isGoPointerValue: ctx :scope
    result = targetIsNullable ifTrue: [
        sourceIsNullablePointer || isNull
          ifTrue: [valueStr]
          ifFalse: [
            ctx addImport: "niva_go/core"
            sourceGoType = typeRef goBaseType: ctx
            "core.NewNullable(" + sourceGoType + "(" + valueStr + "))"
          ]
      ]
      ifFalse: [
        (sourceIsNullablePointer && (isNull not)) ifTrue: ["*" + valueStr] ifFalse: [
            targetIsMutPointer ifTrue: [
                sourceIsCell ifTrue: [valueStr] ifFalse: [
                    | this
                    | IrNewExpr => ["&" + valueStr]
                    |=> [
                        targetGoType = typeRef goBaseType: ctx
                        "func() *" + targetGoType + " { __nivaCell := " + valueStr + "; return &__nivaCell }()"
                    ]
                ]
            ] ifFalse: [
                sourceIsCell ifTrue: ["*" + valueStr] ifFalse: [valueStr]
            ]
        ]
      ]
    ^ result
  ]

  on toGoArgExpr(ctx): GoContext scope: GoScope paramType: IrTypeRef -> String = [
    exprStr = | this
      | IrLambda => this toGoLambdaExpr: ctx :scope expectedType: paramType
      |=> this toGoExpr: ctx :scope
    sourceNullablePointer = ctx needsGoNullablePointerFor: typeRef
    targetNullablePointer = ctx needsGoNullablePointerFor: paramType
    isNull = this isGoNullLiteral
    sourceIsNullablePointerRef = | this
      | IrVarRef => (scope nullablePointerLocals contains: name) &&
        (scope narrowedNullablePointerLocals contains: name, not)
      | IrThisRef => (scope nullablePointerLocals contains: "this") &&
        (scope narrowedNullablePointerLocals contains: "this", not)
      |=> sourceNullablePointer
    isAddressable = | this
      | IrVarRef | IrThisRef => true
      |=> false
    valueExpr = sourceIsNullablePointerRef && (paramType nullable not)
      ifTrue: ["*" + exprStr]
      ifFalse: [
        (targetNullablePointer && (sourceNullablePointer not) && (isNull not))
          ifTrue: [
            isAddressable
              ifTrue: ["&" + exprStr]
              ifFalse: [
                targetGoType = paramType goBaseType: ctx
                "func() *" + targetGoType + " { __nivaArg := " + exprStr + "; return &__nivaArg }()"
              ]
          ]
          ifFalse: [exprStr]
      ]

    mut valueExpr2 = valueExpr
    ((this isGoPointerValue: ctx :scope) && (paramType isGoPointerParam not)) ifTrue: [
      valueExpr2 <- "*" + valueExpr
    ]
    paramType needsGoAddressAtCall,
      ifTrue: [(this isGoPointerValue: ctx :scope) ifTrue: [valueExpr2] ifFalse: ["&" + valueExpr2]]
      ifFalse: [valueExpr2]
  ]

  on toGoLambdaExpr(ctx): GoContext scope: GoScope expectedType: IrTypeRef -> String = [
    | this
    | IrLambda => [
    argsStr = args joinWith: ", " transform: [a -> (a name toSafeGoIdent) + " " + (a typeRef toGoParamType: ctx)]
    lambdaType = expectedType kind == IrTypeRefKind.Function ifTrue: [expectedType] ifFalse: [typeRef]
    retTypeMaybe = lambdaType returnType
    retType = retTypeMaybe orElse: typeRef
    retStr = retType isGoUnitType ifTrue: [""] ifFalse: [" " + (retType toGoType: ctx)]
    sb = StringBuilder new
    sb append: "func("
    sb append: argsStr
    sb append: ")"
    sb append: retStr
    sb appendLine: " {"

    innerScope = scope copy
    args forEach: [arg -> innerScope addGoArg: arg :ctx]
    body blockToGoStatements: ctx scope: innerScope :sb indent: 1 returnType: retType
    bodyResult = body result
    bodyHasTrailingReturn = body hasTrailingReturn
    retType isGoUnitType
      ifTrue: [
        ctx emitResult: bodyResult :sb indent: 1 :retType scope: innerScope
        retType errors isNotEmpty ifTrue: [
          bodyHasTrailingReturn ifFalse: [sb appendIndent: 1 line: "return nil"]
        ]
      ]
      ifFalse: [
        bodyResult == null
          ifTrue: [
            bodyHasTrailingReturn ifFalse: [
              ctx emitResult: null :sb indent: 1 :retType scope: innerScope
            ]
          ]
          ifFalse: [ctx emitResult: bodyResult :sb indent: 1 :retType scope: innerScope]
      ]
    sb append: "}"
    sb toString
    ]
    |=> this toGoExpr: ctx :scope
  ]

  on toGoExpr(ctx): GoContext scope: GoScope -> String =
    | this
    | IrLiteralExpr => [
        isEnumAtom = (literal kind == IrLiteralKind.Atom) &&
                     (typeRef kind == IrTypeRefKind.Custom)
        isEnumAtom
          ifTrue: [(ctx goTypeNameFor: typeRef typeId) + "_" + (literal lexeme toSafeGoIdent)]
          ifFalse: [literal toGoLiteral]
    ]
    | IrVarRef      => [
        goName = name toSafeGoIdent
        isLocal = scope locals contains: name
        isImplicitField = (scope implicitFields contains: name) && (isLocal not)
        isNarrowed = (scope nullablePointerLocals contains: name) &&
          (scope narrowedNullablePointerLocals contains: name)
        isImplicitUnionField = scope implicitUnionFields contains: name
        isImplicitField ifTrue: [
          isImplicitUnionField
            ifTrue: ["this." + (ctx goFieldGetterName: name) + "()"]
            ifFalse: ["this." + goName]
        ] ifFalse: [
          isNarrowed ifTrue: ["*" + goName] ifFalse: [goName]
        ]
      ]
    | IrThisRef  => [
        isNarrowedThis = (scope nullablePointerLocals contains: "this") &&
          (scope narrowedNullablePointerLocals contains: "this")
        isNarrowedThis ifTrue: ["*this"] ifFalse: ["this"]
      ]
  | IrFieldGet => [
    recv = receiver toGoExpr: ctx :scope
    isUnion = ctx isGoUnionType: receiver typeRef typeId
    isUnion
      ifTrue: ["(" + recv + ")." + (ctx goFieldGetterName: field) + "()"]
      ifFalse: ["(" + recv + ")." + (field toSafeGoIdent)]
      ]
    | IrTypeRefExpr => ref toGoType: ctx
    | IrOpBin       => [
        l = left toGoValueExpr: ctx :scope
        r = right toGoValueExpr: ctx :scope
        eqTypeMaybe = this goEqTypeRef: ctx
        | eqTypeMaybe
        | null => "(" + l + " " + op + " " + r + ")"
        |=> [
          eq = ctx goEqExpr: eqTypeMaybe a: l b: r typeParams: {}
          op == "!=" ifTrue: ["(!" + eq + ")"] ifFalse: [eq]
        ]
    ]
    | IrCall => [
        msgNameMaybe = msgName
    isTry = msgNameMaybe ifSome: [it ->
      (it == "try") || (it == "orPANIC") || (it == "unpackOrPANIC")
    ]
        isTry ifTrue: [this toGoTryExpr: ctx :scope] ifFalse: [

        // new bind design: inlineable bind plan attached during IR generation
        bindMaybe = bind
        bindOutput = | bindMaybe
          | null => ""
          |=> [
            | bindMaybe
          | IrBindByName => [
              ctx addImport: bindMaybe pkg
              byNameArgs = args mapIndexed: [i, it ->
                paramType = paramTypes at: i
                it toGoArgExpr: ctx :scope :paramType
              ], goCallArgs
              (bindMaybe pkg goImportQualifier) + "." + bindMaybe name + "(" + byNameArgs + ")"
            ]
          | IrBindEmit => [
              bindMaybe imports forEach: [ctx addImport: it]
              // $0 = receiver/this, $1 = first keyword arg, ...
              emitArgVals = args mapIndexed: [i, it ->
                paramType = paramTypes at: i
                it toGoArgExpr: ctx :scope :paramType
              ]
              bindMaybe template bindApply0: emitArgVals
            ]
          |=> ""
        ]
        bindMaybe != null ifTrue: [bindOutput] ifFalse: [

        bindExpr = this tryGoBindExpr: ctx :scope
        bindExprMaybe = bindExpr
        bindExprValue = bindExprMaybe orElse: ""
        bindExprMaybe != null ifTrue: [bindExprValue] ifFalse: [
        receiverTypeMaybe = receiverType
        isErrorReceiver = receiverTypeMaybe ifSome: [it ->
          (it typeId goNormalizeTypeId) == "core_Error"
        ]
        isStaticCoreReceiver = isErrorReceiver || (receiverTypeMaybe ifSome: [it ->
          (it typeId goNormalizeTypeId) == "core_Compiler"
        ])
        callArgs = isStaticCoreReceiver ifTrue: [args drop: 1] ifFalse: [args]
        argsStr = callArgs mapIndexed: [i, it ->
          paramIndex = isStaticCoreReceiver ifTrue: [i + 1] ifFalse: [i]
          paramType = paramTypes at: paramIndex
          it toGoArgExpr: ctx :scope :paramType
        ], goCallArgs
        funcIdLocal = funcId
        | funcIdLocal
        | null => [
            calleeLocal = callee
            | calleeLocal
            | null => "panic(\"IrCall without funcId must have callee\")"
            |=> [
              calleeExpr = calleeLocal
              callExpr = "(" + (calleeExpr toGoExpr: ctx :scope) + ")(" + argsStr + ")"
              (typeRef isGoUnitType && typeRef errors isEmpty)
                ifTrue: ["func() struct{} { " + callExpr + "; return struct{}{} }()"]
                ifFalse: [callExpr]
            ]
          ]
        |=> [
            // if its from core => generate core.Type__funcname, if not then Pkg__
            declPkgMaybe = declPkg
            declPkgLocal = declPkgMaybe orElse: ""
            declPkgLocal == "core"
              ifTrue: [
                ctx addImport: "niva_go/core"
                msgNameMaybe = msgName
                msgNameLocal = msgNameMaybe orElse: ""
                recvTypeMaybe = receiverType
                recvTypeLocal = recvTypeMaybe orElse: typeRef
                mutReceiver = paramTypes isNotEmpty && (paramTypes first isMut)
                baseCoreFn = recvTypeLocal coreFuncNameFromCall: msgNameLocal forMut: mutReceiver
                isUnitBranch = (recvTypeLocal typeId goNormalizeTypeId == "core_Bool") &&
                  (typeRef isGoUnitType) &&
                  ((msgNameLocal == "ifTrue__ifFalse") || (msgNameLocal == "ifFalse_ifTrue") ||
                    (msgNameLocal == "ifFalse__ifTrue"))
                coreFn = isUnitBranch ifTrue: [baseCoreFn + "Unit"] ifFalse: [baseCoreFn]
                isMutListCall = coreFn startsWith: "List__mut_"
                coreArgs = isMutListCall
                  ifTrue: [
                    args mapIndexed: [i, it ->
                      paramType = paramTypes at: i
                      isListReceiver = i == 0
                      isListReceiver ifTrue: [
                        argStr = it toGoExpr: ctx :scope
                        (it isGoPointerValue: ctx :scope) ifTrue: [argStr] ifFalse: ["&" + argStr]
                      ] ifFalse: [it toGoArgExpr: ctx :scope :paramType]
                    ], goCallArgs
                  ]
                  ifFalse: [argsStr]
                coreTypeArgs = genericArgs isNotEmpty
                  ifTrue: ["[" + (genericArgs joinWith: ", " transform: [it toGoType: ctx]) + "]"]
                  ifFalse: [""]
                coreCall = "core." + coreFn + coreTypeArgs + "(" + coreArgs + ")"
                receiverBaseId = recvTypeLocal typeId goNormalizeTypeId
                isListNullableCall = (receiverBaseId == "core_List") &&
                  ((msgNameLocal == "find") || (msgNameLocal == "firstOrNull") || (msgNameLocal == "lastOrNull"))
                isMapNullableCall = (receiverBaseId == "core_Map") && (msgNameLocal == "at")
                (isListNullableCall || isMapNullableCall)
                  ifTrue: [this toGoNullableOptionExpr: ctx call: coreCall]
                  ifFalse: [coreCall]
              ]
              ifFalse: [
                callKey = this goSymbolKey: funcIdLocal
                fn = ctx goFuncNameFor: callKey
                fn + "(" + argsStr + ")"
              ]
          ]
        ]
        ]
        ]
      ]
    | IrLambda => this toGoLambdaExpr: ctx :scope expectedType: typeRef
    | IrBlockExpr => block blockToGoExpr: ctx :scope
    | IrMatchExpr => TO DO: "go backend: a match used as a value is lifted out of its statement before it's emitted"
    | IrNewExpr   => [
        (typeId goNormalizeTypeId) == "core_StringBuilder" ifTrue: [
          ctx addImport: "niva_go/core"
          "core.NewStringBuilder()"
        ] ifFalse: [
        // adding [int] to tests_Box[int]{42}
        name = (typeRef kind == IrTypeRefKind.Custom)
          ifTrue: [typeRef toGoType: ctx]
          ifFalse: [ctx goTypeNameFor: (typeId goNormalizeTypeId)]
        fieldTypesMaybe = ctx symbols constructorFieldTypes at: (typeId goNormalizeTypeId)
        argsStr = | fieldTypesMaybe
          | null => args joinWith: ", " transform: [it toGoExpr: ctx :scope]
          |=> (args mapIndexed: [i, arg ->
            fieldType = fieldTypesMaybe at: i
            arg toGoLocalAssignExpr: ctx :scope targetIsNullable: (ctx needsGoNullablePointerFor: fieldType) targetIsMutPointer: (fieldType goIsMutBoxType: ctx)
          ]) joinWith: ", "
        argsStr == "" ifTrue: [name + "{}"] ifFalse: [name + "{" + argsStr + "}"]
        ]
      ]
    | IrCollectionLiteral => this collectionToGoExpr: ctx :scope

  on isGoCallLike -> Bool =
    | this
    | IrCall | IrBlockExpr | IrMatchExpr => true
    |=> false

  on emitGoPropagatingCall(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef bindTo: String -> String? = [
    callStr = this toGoExpr: ctx :scope
    errName = "__err" uniqueName: scope locals
    retIsUnit = typeRef isGoUnitType
    errReturn = returnType goReturnError: errName :ctx
    boundName = bindTo
    mut resultName::String? = null

    boundName == "" ifTrue: [
      retIsUnit
        ifTrue: [
          sb appendIndent: indent line: (errName + " := " + callStr)
          ()
        ]
        ifFalse: [
          tmpName = "__callResult" uniqueName: scope locals
          sb appendIndent: indent line: (tmpName + ", " + errName + " := " + callStr)
          sb appendIndent: indent line: ("if " + errName + " != nil { " + errReturn + " }")
          resultName <- tmpName
          ()
        ]
    ] ifFalse: [
      retIsUnit
        ifTrue: [
          sb appendIndent: indent line: ("var " + boundName + " " + (typeRef toGoType: ctx) + " = " + (typeRef goZeroValue: ctx))
          sb appendIndent: indent line: (errName + " := " + callStr)
          resultName <- boundName
          ()
        ]
        ifFalse: [
          sb appendIndent: indent line: (boundName + ", " + errName + " := " + callStr)
          resultName <- boundName
          ()
        ]
    ]

    sb appendIndent: indent line: ("if " + errName + " != nil { " + errReturn + " }")
    ^ resultName
  ]

  on emitReturn(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    hasErrors = returnType errors isNotEmpty
    doPropagate = this isGoPropagatingCall
    doPropagate ifTrue: [
      resultNameMaybe = this emitGoPropagatingCall: ctx :scope :sb :indent :returnType bindTo: ""
      resultNameMaybe ifNotNull: [resultName ->
        sb appendIndent: indent line: (returnType goReturnResult: resultName withError: hasErrors)
      ]
      (resultNameMaybe == null) ifTrue: [
        sb appendIndent: indent line: (returnType goReturnResult: "nil" withError: hasErrors)
      ]
    ] ifFalse: [
      isNothingType = (typeRef typeId goNormalizeTypeId) == "core_Nothing"
      isNullValue = this isGoNullLiteral
      isNothing = isNothingType && (isNullValue not)
      isNothing ifTrue: [
        sb appendIndent: indent line: (this toGoStatement: ctx :scope :returnType)
        sb appendIndent: indent line: "panic(\"unreachable\")"
      ] ifFalse: [
        returnType isGoUnitType ifTrue: [
          sb appendIndent: indent line: (this toGoStatement: ctx :scope :returnType)
          returnLine = hasErrors ifTrue: ["return nil"] ifFalse: [
            scope unitReturnValue ifTrue: ["return struct{}{}"] ifFalse: ["return"]
          ]
          sb appendIndent: indent line: returnLine
        ] ifFalse: [
          exprStr = (ctx needsGoNullablePointerFor: returnType)
            ifTrue: [this toGoNullableInitExpr: ctx :scope targetType: returnType]
            ifFalse: [this toGoValueExpr: ctx :scope]
          line = returnType goReturnResult: exprStr withError: hasErrors
          sb appendIndent: indent :line
        ]
      ]
    ]
  ]

  on emitAsStmt(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    doPropagate = this isGoPropagatingCall
    doPropagate ifTrue: [
      lifted = this goLiftedOperands: ctx :scope :sb :indent :returnType
      lifted emitGoPropagatingCall: ctx :scope :sb :indent :returnType bindTo: ""
      ()
  ] ifFalse: [
      | this
      | IrMatchExpr => [
        // the subject runs first. A match on errors needs the call itself
        liftedSubject = kind == IrMatchKind.ByError
          ifTrue: [subject goLiftedOperands: ctx :scope :sb :indent :returnType]
          ifFalse: [subject goLifted: ctx :scope :sb :indent :returnType]
        matchExpr = this subject: liftedSubject
        // ifTrue: and ifFalse: are matches with the cases true and false. A match
        // on true whose cases are conditions is an if else chain, like a match on a value
        isIfTrueIfFalse = (kind == IrMatchKind.ByBool) && (cases any: [it condition isGoBoolLiteral not]) not
        isIfTrueIfFalse
          ifTrue: [ctx emitBoolMatchStatement: matchExpr :sb :indent :returnType :scope]
          ifFalse: [ctx emitMatchStatement: matchExpr :sb :indent :returnType :scope]
      ]
      | IrBlockExpr => [
        blockScope = scope copyWithUnitReturnValue: false
        sb appendIndent: indent line: "{"
        block blockToGoStatements: ctx scope: blockScope :sb indent: (indent + 1) :returnType
        blockResultMaybe = block result
        | blockResultMaybe
        | null => []
        |=> blockResultMaybe emitAsStmt: ctx scope: blockScope :sb indent: (indent + 1) :returnType
        sb appendIndent: indent line: "}"
      ]
      |=> [
        lifted = this goLiftedOperands: ctx :scope :sb :indent :returnType
        stmtStr = lifted toGoStatement: ctx :scope :returnType
        sb appendIndent: indent line: stmtStr
      ]
    ]
  ]

  on toGoStatement(ctx): GoContext scope: GoScope returnType: IrTypeRef -> String = [
    | this
    | IrCall => [
      msgNameLocal = this msgNameOrEmpty
      receiverTypeMaybe = receiverType
      receiverTypeId = | receiverTypeMaybe
        | null => ""
        |=> receiverTypeMaybe typeId goNormalizeTypeId
      isBoolBranch = (receiverTypeId == "core_Bool") &&
        ((msgNameLocal == "ifTrue") || (msgNameLocal == "ifFalse"))
      isBoolBranch && (args count > 1) ifTrue: [
        branch = args at: 1
        | branch
        | IrLambda => [
          condition = args first toGoValueExpr: ctx :scope
          branchCondition = msgNameLocal == "ifFalse"
            ifTrue: ["!(" + condition + ")"]
            ifFalse: [condition]
          innerScope = scope copy
          branch args forEach: [arg -> innerScope addGoArg: arg :ctx]
          sb = StringBuilder new
          sb appendLine: ("if " + branchCondition + " {")
          branch body blockToGoStatements: ctx scope: innerScope :sb indent: 1 :returnType
          bodyResult = branch body result
          | bodyResult
          | null => []
          |=> bodyResult emitAsStmt: ctx scope: innerScope :sb indent: 1 :returnType
          sb appendLine: "}"
          sb toString
        ]
        |=> this toGoExpr: ctx :scope
      ] ifFalse: [this toGoExpr: ctx :scope]
    ]
    |=> [
      exprStr = this toGoExpr: ctx :scope
      isCallLike = this isGoCallLike
      isCallLike ifTrue: [exprStr] ifFalse: ["_ = " + exprStr]
    ]
  ]
]

IrCollectionLiteral collectionToGoExpr(ctx): GoContext scope: GoScope -> String = [
  elemType = typeRef args isNotEmpty ifTrue: [(typeRef args first) toGoType: ctx] ifFalse: ["interface{}"]
  ^ | kind
    | IrCollectionKind.List => [
        elems = items joinWith: ", " transform: [it toGoValueExpr: ctx :scope]
        "[]" + elemType + "{" + elems + "}"
      ]
    | IrCollectionKind.Set => [
        pairs = items joinWith: ", " transform: [(it toGoValueExpr: ctx :scope) + ": struct{}{}"]
        "map[" + elemType + "]struct{}{ " + pairs + " }"
      ]
    |=> [
        elems = items
        pairParts::mut List(String) = {}!
        elems forEachIndexed: [i, key ->
          i % 2 == 0 ifTrue: [
            value = elems at: (i + 1)
            keyStr = key toGoValueExpr: ctx :scope
            valueStr = value toGoValueExpr: ctx :scope
            pairParts add: (keyStr + ": " + valueStr)
          ]
        ]
        pairs = pairParts joinWith: ", "
        keyType = typeRef args count > 0 ifTrue: [(typeRef args at: 0) toGoType: ctx] ifFalse: ["interface{}"]
        valType = typeRef args count > 1 ifTrue: [(typeRef args at: 1) toGoType: ctx] ifFalse: ["interface{}"]
        "map[" + keyType + "]" + valType + "{" + pairs + "}"
      ]
]

// transforms matchExpr (not statement) from
//   x = (1 > 2 ifTrue: [^ 2] ifFalse: [2]) + 2
// to
//   var __matchValue int
//   if (1 > 2) {
//       return 2
//   } else {
//       __matchValue = 2
//   }
//   var x int = (__matchValue + 2)
// A block used as a value, like the body of a ^= method, stays an anonymous function: a ^ in it gives the block's value
extend IrExpr [
  on goNeedsStatements -> Bool =
    | this
    | IrMatchExpr => true
    |=> false

  // a match in this value, but not in a lambda or a block, which are go functions of their own
  on goHasMatchInside -> Bool =
    | this
    | IrMatchExpr => true
    | IrBlockExpr => false
    |=> this goOperands any: [it goHasMatchInside]

  // what this expression evaluates before itself, in order
  on goOperands -> List(IrExpr) =
    | this
    | IrFieldGet => {receiver}
    | IrCall => [
      calleeMaybe = callee
      | calleeMaybe
      | null => args
      |=> {calleeMaybe} + args
    ]
    | IrNewExpr => args
    | IrCollectionLiteral => items
    | IrOpBin => {left right}
    |=> {}

  on goWithOperands(operands): List(IrExpr) -> IrExpr =
    | this
    | IrFieldGet => this receiver: operands first
    | IrCall => [
      calleeMaybe = callee
      | calleeMaybe
      | null => this args: operands
      |=> [
        withCallee = this callee: operands first
        withCallee args: (operands drop: 1)
      ]
    ]
    | IrNewExpr => this args: operands
    | IrCollectionLiteral => this items: operands
    | IrOpBin => [
      withLeft = this left: (operands at: 0)
      withLeft right: (operands at: 1)
    ]
    |=> this

  // an operand the call writes through, like the list of add:, is passed by
  // its address, so a copy in a temp won't do
  on goOperandIsPlace(i): Int -> Bool =
    | this
    | IrCall => [
      paramIndex = callee == null ifTrue: [i] ifFalse: [i - 1]
      (paramIndex >= 0) && (paramIndex < paramTypes count) && (paramTypes at: paramIndex, isMut)
    ]
    |=> false

  // an operand evaluated before a lifted match reads the same after it
  on goReadsTheSameLater(scope): GoScope -> Bool =
    | this
    | IrLiteralExpr | IrTypeRefExpr | IrLambda => true
    | IrVarRef => ((scope mutLocals contains: name) || (scope pointerLocals contains: name)) not
    | IrThisRef => (scope pointerLocals contains: "this") not
    |=> false

  // a value a go variable can't hold: no value, or a value with its error
  on goCannotBeTemp -> Bool =
    (typeRef isGoUnitType) || ((typeRef errors isNotEmpty) && (this isGoPropagatingCall not))

  // declares a temp with this value, and refers to it
  on goToTemp(name): String ctx: GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> IrExpr = [
    tempName = name uniqueName: scope locals
    temp::IrStmt = IrLet :token name: tempName :typeRef value: this isMut: false isUsed: true
    temp toGoStmt: ctx :scope :sb :indent :returnType
    IrVarRef :typeRef :token name: tempName
  ]

  // this value with each match in it emitted first, as statements assigning a temp that takes its place
  on goLifted(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> IrExpr =
    | this
    | IrMatchExpr => this goToTemp: "__matchValue" :ctx :scope :sb :indent :returnType
    |=> this goLiftedOperands: ctx :scope :sb :indent :returnType

  // the same for what's inside this expression, but not for itself, the operands evaluated before the last lifted one are kept in temps first
  on goLiftedOperands(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> IrExpr = [
    operands = this goOperands
    mut lastLifted = -1
    operands forEachIndexed: [i, operand ->
      operand goHasMatchInside ifTrue: [lastLifted <- i]
    ]
    | true
    | lastLifted == -1 => this
    | this goHasShortCircuitMatch => this goShortCircuitAsMatch goLifted: ctx :scope :sb :indent :returnType
    |=> this goWithOperands: (operands mapIndexed: [i, operand ->
      | true
      | i < lastLifted => [
        lifted = operand goLifted: ctx :scope :sb :indent :returnType
        keepsPlace = (lifted goReadsTheSameLater: scope) || (this goOperandIsPlace: i) || lifted goCannotBeTemp
        keepsPlace ifTrue: [lifted] ifFalse: [lifted goToTemp: "__operand" :ctx :scope :sb :indent :returnType]
      ]
      | i == lastLifted => operand goLifted: ctx :scope :sb :indent :returnType
      |=> operand
    ])
  ]

  // && and || run their right side only when the left doesn't decide
  on goHasShortCircuitMatch -> Bool =
    | this
    | IrOpBin => ((op == "&&") || (op == "||")) && right goHasMatchInside
    |=> false

  // l && r as | l | true => r |=> false, and l || r as | l | true => true |=> r
  on goShortCircuitAsMatch -> IrExpr =
    | this
    | IrOpBin => [
      isAnd = op == "&&"
      whenTrue = isAnd ifTrue: [right] ifFalse: [this goBoolLiteral: true]
      otherwise = isAnd ifTrue: [this goBoolLiteral: false] ifFalse: [right]
      trueCase = IrMatchCase
        condition: (this goBoolLiteral: true)
        additionalConditions: {}
        body: (IrBlock stmts: {} result: whenTrue resultType: typeRef)
        assertedTypeRef: null
      IrMatchExpr
        :typeRef
        :token
        kind: IrMatchKind.ByBool
        subject: left
        cases: {trueCase}
        elseBranch: (IrBlock stmts: {} result: otherwise resultType: typeRef)
        typeAlias: null
        subjectIsUnit: false
    ]
    |=> this

  on goBoolLiteral(value): Bool -> IrExpr =
    IrLiteralExpr :typeRef :token literal: (IrLiteral kind: IrLiteralKind.Bool lexeme: (value ifTrue: ["true"] ifFalse: ["false"]))

  // a value nothing uses, as statements
  on emitAsUnusedValue(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit =
    this goNeedsStatements
      ifTrue: [this emitAsStmt: ctx :scope :sb :indent :returnType]
      ifFalse: [
        lifted = this goLiftedOperands: ctx :scope :sb :indent :returnType
        sb appendIndent: indent line: (lifted toGoStatement: ctx :scope :returnType)
      ]

  // the match as statements, each branch ending by assigning its value to
  // bindTo, or by returning it when bindTo is ""
  on goEndingBranches(bindTo): String -> IrExpr =
    | this
    | IrMatchExpr => [
      // a match without a value runs its branches as statements
      hasValue = typeRef isGoUnitType not
      newCases = cases map: [c ->
        IrMatchCase
          condition: c condition
          additionalConditions: c additionalConditions
          body: (c body goEndingWith: bindTo :token :hasValue)
          assertedTypeRef: c assertedTypeRef
      ]
      // a match on errors with no else branch has the subject's value
      elseBranchMaybe = elseBranch
      hasValueWithoutElse = (elseBranchMaybe == null) && (kind == IrMatchKind.ByError) && (subjectIsUnit not)
      mut newElse::IrBlock? = null
      hasValueWithoutElse ifTrue: [
        valueRef = IrVarRef typeRef: subject typeRef :token name: this goMatchAliasOrIt
        newElse <- (IrBlock stmts: {} result: valueRef resultType: typeRef) goEndingWith: bindTo :token :hasValue
      ]
      elseBranchMaybe ifNotNull: [elseBlock ->
        newElse <- elseBlock goEndingWith: bindTo :token :hasValue
      ]
      IrMatchExpr
        :typeRef
        :token
        :kind
        :subject
        cases: newCases
        elseBranch: newElse
        :typeAlias
        :subjectIsUnit
    ]
    |=> this

  on goAssigningResultTo(name): String -> IrExpr = this goEndingBranches: name

  on goReturningResult -> IrExpr = this goEndingBranches: ""

  // the statement that ends a branch with this value
  on goBranchEnd(bindTo): String hasValue: Bool -> IrStmt = [
    isNothing = ((typeRef typeId goNormalizeTypeId) == "core_Nothing") && (this isGoNullLiteral not)
    | true
    | bindTo == "" => IrReturn :token expr: this
    | isNothing || hasValue not => IrExprStmt :token expr: this
    |=> IrSetLocal :token name: bindTo value: this
  ]
]

extend IrBlock [
  on goEndingWith(bindTo): String token: Token hasValue: Bool -> IrBlock = [
    resultMaybe = result
    | resultMaybe
    | null => [
      // returning, a branch with no value still has to return, like the empty else of ifTrue:
      needsReturn = (bindTo == "") && (this hasTrailingReturn not)
      emptyReturn::IrStmt = IrReturn :token expr: null
      needsReturn
        ifTrue: [IrBlock stmts: stmts + {emptyReturn} result: null :resultType]
        ifFalse: [this]
    ]
    |=> IrBlock stmts: stmts + {(resultMaybe goBranchEnd: bindTo :hasValue)} result: null :resultType
  ]
]

IrStmt toGoStmt(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
  token printGoLine-intoSb: sb
  | this
  | IrLet => [
      goName = name toSafeGoIdent
      scope locals add: name
      (ctx needsGoNullablePointerFor: typeRef) ifTrue: [scope nullablePointerLocals add: name]
      valueLocal = value
      mut targetIsMutPtr = (isMut || (typeRef isMut)) && (typeRef goIsMutBoxType: ctx)
      | valueLocal
      | null => ()
      |=> [
        vv = valueLocal
        cellSource = vv isGoPointerValue: ctx :scope
        cellSource ifTrue: [targetIsMutPtr <- true]
      ]
      targetIsMutPtr ifTrue: [scope pointerLocals add: name]
      scope mutLocals remove: name
      isMut ifTrue: [scope mutLocals add: name]
      typeStr = targetIsMutPtr ifTrue: ["*" + (typeRef goBaseType: ctx)] ifFalse: [typeRef toGoType: ctx]
      | valueLocal
      | null => [sb appendIndent: indent line: ("var " + goName + " " + typeStr)]
      |=> [
        valueExpr = valueLocal
        doProp = valueExpr isGoPropagatingCall
        doProp
          ifTrue: [
            lifted = valueExpr goLiftedOperands: ctx :scope :sb :indent :returnType
            lifted emitGoPropagatingCall: ctx :scope :sb :indent :returnType bindTo: goName
            ()
          ]
          ifFalse: [
            valueExpr goNeedsStatements
              ifTrue: [
                sb appendIndent: indent line: ("var " + goName + " " + typeStr)
                // each branch assigns its value, as to a mut local
                scope mutLocals add: name
                (valueExpr goAssigningResultTo: name) emitAsStmt: ctx :scope :sb :indent :returnType
                isMut ifFalse: [scope mutLocals remove: name]
              ]
              ifFalse: [
                lifted = valueExpr goLiftedOperands: ctx :scope :sb :indent :returnType
                valueStr = lifted toGoLocalAssignExpr: ctx :scope targetIsNullable: (scope nullablePointerLocals contains: name) targetIsMutPointer: targetIsMutPtr
                sb appendIndent: indent line: ("var " + goName + " " + typeStr + " = " + valueStr)
              ]
          ]
      ]
      isUsed ifFalse: [
        sb appendIndent: indent line: ("_ = " + goName)
      ]
    ]
  | IrSetLocal => [
      value goNeedsStatements
        ifTrue: [(value goAssigningResultTo: name) emitAsStmt: ctx :scope :sb :indent :returnType]
        ifFalse: [
          goName = name toSafeGoIdent
          (scope mutLocals contains: name) ifFalse: [
            TO DO: "go backend: assignment to non mut var " + name
            ()
          ]
          isPtrTarget = scope pointerLocals contains: name
          lifted = value goLiftedOperands: ctx :scope :sb :indent :returnType
          valueStr = lifted toGoLocalAssignExpr: ctx :scope targetIsNullable: (scope nullablePointerLocals contains: name) targetIsMutPointer: isPtrTarget
          sb appendIndent: indent line: (goName + " = " + valueStr)
        ]
  ]
  | IrSetField => [
      // the receiver is where the value goes, so it isn't kept in a temp before the value
      liftedReceiver = receiver goLifted: ctx :scope :sb :indent :returnType
      liftedValue = value goLifted: ctx :scope :sb :indent :returnType
      recvStr = liftedReceiver toGoExpr: ctx :scope
      recvTypeMaybe = receiver goReceiverTypeRef: ctx :scope
      recvType = recvTypeMaybe orElse: receiver typeRef
      ftMaybe = ctx symbols irFieldTypeOf: recvType :field
      fieldIsBoxed = ftMaybe ifSome: [it -> it goIsMutBoxType: ctx]
      valueStr = liftedValue toGoValueExpr: ctx :scope
      fieldIsBoxed ifTrue: [
        sb appendIndent: indent line: ("*((" + recvStr + ")." + (field toSafeGoIdent) + ") = " + valueStr)
      ] ifFalse: [
        sb appendIndent: indent line: ("(" + recvStr + ")." + (field toSafeGoIdent) + " = " + valueStr)
      ]
  ]
  | IrDestructure => [
      tmpName = "__destructTmp" uniqueName: scope locals
      valueStr = (value goLifted: ctx :scope :sb :indent :returnType) toGoValueExpr: ctx :scope
      sb appendIndent: indent line: (tmpName + " := " + valueStr)
      bindings forEach: [b ->
        goName = b name toSafeGoIdent
        scope locals add: b name
        sb appendIndent: indent line: ("var " + goName + " " + (b typeRef toGoType: ctx) + " = " + tmpName + "." + (b fieldName toSafeGoIdent))
        b isUsed ifFalse: [
          sb appendIndent: indent line: ("_ = " + goName)
        ]
      ]
  ]
  | IrExprStmt => [
      expr emitAsStmt: ctx :scope :sb :indent :returnType
  ]
  | IrReturn => [
      exprLocal = expr
      hasErrors = returnType errors isNotEmpty
      | exprLocal
      | null => [
        hasErrors
          ifTrue: [sb appendIndent: indent line: "return nil"]
         ifFalse: [
           scope unitReturnValue
             ifTrue: [sb appendIndent: indent line: "return struct{}{}"]
             ifFalse: [sb appendIndent: indent line: "return"]
         ]
      ]
      |=> [
        exprVal = exprLocal
        exprVal goNeedsStatements
          ifTrue: [(exprVal goReturningResult) emitAsStmt: ctx :scope :sb :indent :returnType]
          ifFalse: [(exprVal goLiftedOperands: ctx :scope :sb :indent :returnType) emitReturn: ctx :scope :sb :indent :returnType]
      ]
  ]
  | IrWhile => [
      condLocal = cond
      bodyLocal = body
      sb appendIndent: indent line: "for {"

      | condLocal
      | IrLambda => [
        condScope = scope copy
        condLocal args forEach: [arg -> condScope addGoArg: arg :ctx]
        sb appendIndent: (indent + 1) line: "{"
        condBody = condLocal body
        condBody blockToGoStatements: ctx scope: condScope :sb indent: (indent + 2) :returnType
        condResultMaybe = condBody result
        | condResultMaybe
        | null => [sb appendIndent: (indent + 2) line: "if !(false) { break }"]
        |=> [
          // lifted inside the loop, so a match runs on every iteration
          lifted = condResultMaybe goLifted: ctx scope: condScope :sb indent: (indent + 2) :returnType
          condResult = lifted toGoValueExpr: ctx scope: condScope
          sb appendIndent: (indent + 2) line: ("if !(" + condResult + ") { break }")
        ]
        sb appendIndent: (indent + 1) line: "}"
      ]
      |=> [
        loopScope = scope copy
        lifted = condLocal goLifted: ctx scope: loopScope :sb indent: (indent + 1) :returnType
        condExpr = lifted toGoValueExpr: ctx scope: loopScope
        sb appendIndent: (indent + 1) line: ("if !(" + condExpr + ") { break }")
      ]

      | bodyLocal
      | IrLambda => [
        bodyScope = scope copy
        bodyLocal args forEach: [arg -> bodyScope addGoArg: arg :ctx]
        sb appendIndent: (indent + 1) line: "{"
        bodyBlock = bodyLocal body
        bodyBlock blockToGoStatements: ctx scope: bodyScope :sb indent: (indent + 2) :returnType
        bodyResultMaybe = bodyBlock result
        | bodyResultMaybe
        | null => []
        |=> bodyResultMaybe emitAsStmt: ctx scope: bodyScope :sb indent: (indent + 2) :returnType
        sb appendIndent: (indent + 1) line: "}"
      ]
      |=> [
        bodyExpr = bodyLocal toGoExpr: ctx :scope
        sb appendIndent: (indent + 1) line: bodyExpr
      ]
      sb appendIndent: indent line: "}"
  ]
  | IrThrow => [
      throwErrExpr = errExpr
      errStr = | throwErrExpr
        | IrTypeRefExpr => [
            ctx addImport: "fmt"
            "fmt.Errorf(\"" + (throwErrExpr ref typeId goNormalizeTypeId) + "\")"
          ]
        |=> (throwErrExpr goLifted: ctx :scope :sb :indent :returnType) toGoExpr: ctx :scope
      returnLine = returnType isGoUnitType
        ifTrue: ["return " + errStr]
        ifFalse: ["return " + (returnType goZeroValue: ctx) + ", " + errStr]
      sb appendIndent: indent line: returnLine
  ]
]

extend IrBlock [
  on blockToGoExpr(ctx): GoContext scope: GoScope -> String = [
    retType = resultType
    retStr = " " + (retType toGoType: ctx)
    sb = StringBuilder new
    sb append: "func()"
    sb append: retStr
    sb appendLine: " {"

    innerScope = scope copyWithUnitReturnValue: true
    this blockToGoStatements: ctx scope: innerScope :sb indent: 1 returnType: retType
    hasTrailingReturn = this hasTrailingReturn
    hasTrailingReturn ifFalse: [
      ctx emitResult: result :sb indent: 1 :retType scope: innerScope
      retType isGoUnitType ifTrue: [
        sb appendIndent: 1 line: ("return " + (retType toGoType: ctx) + "{}")
      ]
    ]

    sb append: "}()"
    ^ sb toString
  ]

  on blockToGoStatements(ctx): GoContext scope: GoScope sb: StringBuilder indent: Int returnType: IrTypeRef -> Unit = [
    stmts forEach: [st -> st toGoStmt: ctx :scope :sb :indent :returnType]
    // return handling is done by caller
  ]

  on hasTrailingReturn -> Bool = [
    ^ stmts isEmpty ifTrue: [false] ifFalse: [
      lastStmt = stmts last
      | lastStmt
      | IrReturn | IrThrow => true
      |=> false
    ]
  ]
]

List(String) goTypeParams -> String =
  this isEmpty  ifTrue: [""]
           ifFalse: [ "[" + (this joinWith: ", " transform: [it toSafeGoIdent + " any"]) + "]" ]

List(String) goTypeArgs -> String =
  this isEmpty  ifTrue: [""]
           ifFalse: [ "[" + (this joinWith: ", " transform: [it toSafeGoIdent]) + "]" ]

IrTypeRef collectGoTypeParamsInto(names): mut List(String) seen: mut Set(String) -> Unit = [
  baseId = typeId goNormalizeTypeId
  ((kind == IrTypeRefKind.Custom) && (baseId isGeneric)) ifTrue: [
    seen contains: baseId, ifFalse: [
      seen add: baseId
      names add: baseId
    ]
  ]
  args forEach: [it collectGoTypeParamsInto: names :seen]
  returnType ifNotNull: [returnTypeMaybe ->
    returnTypeMaybe collectGoTypeParamsInto: names :seen
  ]
  errors forEach: [it collectGoTypeParamsInto: names :seen]
]

List(IrField) goTypeParamsFromFields -> List(String) = [
  names::mut List(String) = {}!
  seen::mut Set(String) = #()!
  this forEach: [field -> field typeRef collectGoTypeParamsInto: names :seen]
  ^ names toList
]

List(String) goCallArgs -> String = [
  ^ this isEmpty ifTrue: [""] ifFalse: [this joinWith: ", "]
]
