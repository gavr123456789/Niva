type Program
  io: IO_Container


type NivaSourceFile
  path: String
  relativePath: String

type IO_Container
  readFile:   [String -> String]
  writeFile:  [String, String -> Unit]
  exists:     [String -> Bool]
  walkDir:    [String -> List(NivaSourceFile)]
  getParent:  [String -> String]
  createDirectories: [String -> Unit]
  delete: [String -> Unit]
  deleteRecursively: [String -> Unit]
  moveFrom: [String, String -> Unit]
  currentDir: String
  runProgram: [List(String) -> Int]
  runProgramFromPath: [String, List(String) -> Int]


constructor IO_Container new -> IO_Container = [
  readFile::[String -> String] = [path::String ->
    FileSystem read: (path toPath)
  ]

  writeFile = [path: String, fileContent: String ->
    FileSystem write: path toPath
               content: fileContent
    ()
  ]

  exists::[String -> Bool] = [path::String ->
    FileSystem exists: (path toPath)
  ]

  walkDir::[String -> List(NivaSourceFile)] = [path: String ->
    pathValue = path toPath
    root = pathValue normalized
    // Okio keeps `.` as a path segment after normalization. Recursive entries
    // do not contain that segment, so dropping it used to turn a root-level
    // `main.niva` into an empty relative path and `.niva_clj/main.niva` into
    // `main.niva`.
    rootSegmentCount = root toString == "."
      ifTrue: [0]
      ifFalse: [root segments count]
    x = FileSystem listRecursively: root

    x map: [
      normalized = it normalized
      relativePath = (normalized segments drop: rootSegmentCount) joinWith: "/"
      NivaSourceFile path: normalized toString :relativePath
    ]
  ]

  getParent = [path: String ->
    pathValue = path toPath
    pathValue parent toString
  ]

  createDirectories = [path: String ->
    FileSystem createDirectories: (path toPath)
    ()
  ]

  delete = [path: String ->
    FileSystem delete: (path toPath)
    ()
  ]

  deleteRecursively = [path: String ->
    FileSystem deleteRecursively: (path toPath)
    ()
  ]

  moveFrom = [source: String, destination: String ->
    FileSystem moveFrom: source toPath to: destination toPath
    ()
  ]

  runProgram = [args: List(String) ->
    ProcessRunner run: args dir: null
  ]

  runProgramFromPath = [path: String, args: List(String) ->
    ProcessRunner run: args dir: path
  ]

  ^ IO_Container :readFile :writeFile :exists :walkDir :getParent
    :createDirectories :delete :deleteRecursively :moveFrom
    currentDir: System currentDir :runProgram :runProgramFromPath
]



compilerTry = [
  path = Compiler cliArgs
  NivaCompiler runArgs: path withIO: IO_Container new measureTime: false
] do

compilerTry2 = [
  cliArgs = Compiler cliArgs
  path = cliArgs isEmpty
    ifTrue: [{"run" ".niva_go/main.niva" "--backend=go"}]
    ifFalse: [cliArgs]
  NivaCompiler runArgs: path withIO: IO_Container new measureTime: false
]
