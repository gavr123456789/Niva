extend IrExpr [

  on irStringLiteralValue -> String? = | this
    | IrLiteralExpr => [
        | literal kind
        | IrLiteralKind.String => literal lexeme unquoteLiteral
        | IrLiteralKind.RawString => literal lexeme unquoteRawLiteral
        |=> null
      ]
    |=> null

  on isIrLambda = | this | IrLambda => true |=> false


]
