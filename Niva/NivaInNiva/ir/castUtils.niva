extend IrExpr [

  on irStringLiteralValue -> String? = | this
    | IrLiteralExpr => [
        ^ | literal kind
          | IrLiteralKind.String | IrLiteralKind.RawString => literal lexeme unquoteLiteral
          |=> null
      ]
    |=> null

  on irListLiteralItems -> List(IrExpr) = | this
    | IrCollectionLiteral => [
        kind == IrCollectionKind.List ifTrue: [items] ifFalse: [TO DO: "Bind emit:args: expects List literal as second argument"]
    ]
    |=> [TO DO: "Bind emit:args: expects List literal as second argument"]

  on isIrLambda = | this | IrLambda => true |=> false


]
