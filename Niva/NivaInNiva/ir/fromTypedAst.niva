extend NivaType [
  // this is a stupid hack, since String builder constructed not via record, but via java
  // since for now its only one such case, I will leave it as is
  on irConstructorBind -> IrConstructorBind? = [
    typeId = this toMangledName
    mut result::IrConstructorBind? = null
    | typeId
      | "core_StringBuilder" => result <- IrConstructorBindEmit
                                    backend: "clojure"
                                    template: "(StringBuilder.)"
      |=> []
    ^ result
  ]

  on isIrBuiltin -> Bool = [
    ^ | this
      | UnresolvedGenericT | FuntionT => false
      | NullableT => [
        nullableInner = this unwrapNullable
        nullableInner isIrBuiltin
      ]
      |=> pkgName == "core"
  ]

  on toIrType-immut-no-errors = this toIrTypeRefWithMutErrors: false errorsList: {}
  on toIrTypeRefWithMutErrors(isMut): Bool errorsList: List(NivaType) -> IrTypeRef = [
    nullable = this isNullableType
    base = this unwrapNullable

    kind = | base
           | FuntionT => IrTypeRefKind.Function
           |=> (base isIrBuiltin ifTrue:  [IrTypeRefKind.Builtin]
                                 ifFalse: [IrTypeRefKind.Custom])

    typeId = base toMangledName

    args::List(IrTypeRef) = | base
           | ListT => { (base t toIrType-immut-no-errors) }
           | SetT => { (base t toIrType-immut-no-errors) }
           | MapT => { (base k toIrType-immut-no-errors) (base v toIrType-immut-no-errors) }
           | TypeT => base genericArgs map: [it toIrType-immut-no-errors]
           | FuntionT => base fields map: [it typeT toIrTypeRefWithMutErrors: it isMut errorsList: {}]
           |=> {}

    returnType = | base
                 | FuntionT => base returnType toIrTypeRefWithMutErrors: false errorsList: base returnErrors
                 |=> null

    errRefs = errorsList map: [it toIrType-immut-no-errors]

    IrTypeRef :kind :typeId ownerPkg: base pkgName :args :returnType :isMut :nullable errors: errRefs
  ]
]


extend TypeInfo [
  on toIrTypeRef -> IrTypeRef = t toIrTypeRefWithMutErrors: isMut errorsList: listOfErrors
]

// new Bind design https://github.com/gavr123456789/Niva/issues/418#issuecomment-4822453495

extend Expr [
  on bindCallArgs -> List(NameAndExpr) = [
    | this
    | KeywordMsg => [
      recv = receiver
      | recv
      | Identifier => recv name == "Bind" ifTrue: [args] ifFalse: [{}]
      | KeywordMsg => [
        nestedArgs = recv bindCallArgs
        nestedArgs + args
      ]
      |=> {}
    ]
    |=> {}
  ]
]

extend MessageDecl [
  // message name is stored joined by "__"; take the first keyword part
  on bindFirstKey -> String = (name split: "__") first

  on bindIsEmptyBody -> Bool = (isSingleExpr not) && (body unTypedBody isEmpty)

  // bind emit templates may include imports
  on bindEmitTemplate -> String? = [
    exprs = body unTypedBody
    first = exprs count == 1 ifTrue: [exprs first] ifFalse: [null]
    firstMaybe = first
    firstExpr = | firstMaybe
      | null => null
      |=> [
        | firstMaybe
        | ReturnStatement => [
          returnValueMaybe = firstMaybe value
          | returnValueMaybe
          | null => firstMaybe
          |=> returnValueMaybe
        ]
        |=> firstMaybe
      ]
    | firstExpr
    | null => null
    |=> [
      | firstExpr
      | KeywordMsg => [
        callArgs = firstExpr bindCallArgs
        callArgs isEmpty ifTrue: [^ null]
          emitArg = callArgs find: [it name name == "emit"]
          hasSupportedArgs = (callArgs count == 1) ||
            ((callArgs count == 2) &&
              (callArgs any: [it name name == "imports"]))
          hasSupportedArgs ifFalse: [^ null]
          emitArgMaybe = emitArg
          | emitArgMaybe
          | null => null
          |=> [
            emitValue = emitArgMaybe expr
            | emitValue
            | StringExpr => [
              tok = emitValue token
              tok kind == TokenType.RawString
                ifTrue: [tok lexeme unquoteRawLiteral]
                ifFalse: [tok lexeme unquoteLiteral]
            ]
            |=> null
          ]
      ]
      |=> null
    ]
  ]

  on bindConfigArg(name): String -> String? = [
    exprs = body unTypedBody
    exprs count == 1 ifFalse: [^ null]
    firstExpr = exprs first
    | firstExpr
    | KeywordMsg => [
      callArgs = firstExpr bindCallArgs
      callArgs isEmpty ifTrue: [^ null]
      nameLocal = name
      arg = callArgs find: [it name name == nameLocal]
      argMaybe = arg
      | argMaybe
      | null => null
      |=> [
        value = argMaybe expr
        | value
        | StringExpr => [
          tok = value token
          tok kind == TokenType.RawString ifTrue: [tok lexeme unquoteRawLiteral] ifFalse: [tok lexeme unquoteLiteral]
        ]
        |=> null
      ]
    ]
    |=> null
  ]

  on bindImports -> Set(String)? = [
    exprs = body unTypedBody
    exprs count == 1 ifFalse: [^ null]
    firstExpr = exprs first
    | firstExpr
    | KeywordMsg => [
      callArgs = firstExpr bindCallArgs
      importsArg = callArgs find: [it name name == "imports"]
      importsArgMaybe = importsArg
      | importsArgMaybe
      | null => null
      |=> [
        importsValue = importsArgMaybe expr
        | importsValue
        | CollectionLiteral => [
          values::mut List(String) = {}!
          importsValue elements unTypedBody forEach: [entry ->
            | entry
            | StringExpr => [
              tok = entry token
              values add: (tok kind == TokenType.RawString ifTrue: [tok lexeme unquoteRawLiteral] ifFalse: [tok lexeme unquoteLiteral])
            ]
            |=> TO DO: "Bind imports must contain only strings"
          ]
          values toSet
        ]
        |=> TO DO: "Bind imports must be a string collection"
      ]
    ]
    |=> null
  ]

  on bindPlanWith(db): TyperDB -> IrBind? = [
    isBind = db isBindMessageDecl: this
    isBind ifFalse: [^ null]

    this bindIsEmptyBody ifTrue: [
      TO DO: "empty Bind declarations must specify pkg and name"
      ^ null
    ]
    mut bindPlanResult::IrBind? = null
    explicitName = this bindConfigArg: "name"
    | explicitName
      | null => [
        tmplMaybe = this bindEmitTemplate
        tmplMaybe ifNotNull: [tmplValue ->
          importsMaybe = this bindImports
          emptyImports::mut List(String) = {}!
          mut imports::Set(String) = emptyImports toSet
          | importsMaybe
          | null => ()
          |=> imports <- importsMaybe
          bindPlanResult <- IrBindEmit template: tmplValue :imports
            hasImports: (importsMaybe != null)
          ()
        ]
      ]
      |=> [
      pkgMaybe = this bindConfigArg: "pkg"
      pkgMaybe ifNotNull: [pkgValue ->
        pkgValue isEmpty ifTrue: [TO DO: "Bind pkg must not be empty"]
        explicitName isEmpty ifTrue: [TO DO: "Bind name must not be empty"]
        bindPlanResult <- IrBindByName pkg: pkgValue name: explicitName isStatic: isConstructor
        ()
      ]
      ()
      ]
    bindPlanResult
  ]
]

extend TypeTField [
  on toIrTypeRef -> IrTypeRef = typeT toIrTypeRefWithMutErrors: isMut errorsList: {}
]

NivaMethod toCanonicalIrFunctionId(db): TyperDB -> String = [
  declVal = decl
  nameLocal = name
  | declVal
    | null => [
      receiverTypeLocal = receiverType
      mut ownerMethod::NivaMethod? = null

      getConstructorFromType = [t::NivaType ->
        constructorsMaybe = db constructorsTypeToMethodNameToMethod at: (t toMangledName)
        | constructorsMaybe
        | null => null
        |=> [
          constructors::mut Map(String, NivaMethod) = constructorsMaybe
          constructors at: nameLocal
        ]
      ]

      getMethodFromType = [t::NivaType ->
        methodsMaybe = db typeToMethodBuckets at: (t toMangledName)
        | methodsMaybe
        | null => getConstructorFromType :t
        |=> [
            methodMaybe = methodsMaybe methodAt: this methodBucketKind name: nameLocal
            | methodMaybe
            | null => getConstructorFromType :t
            |=> methodMaybe
          ]
      ]

      | receiverTypeLocal
      | TypeT => [
        chain = db unionAncestorChain: receiverTypeLocal
        findOwner = [declOnly::Bool ->
          mut found::NivaMethod? = null
          chain forEach: [t ->
            found == null ifTrue: [
              m = getMethodFromType :t
              mMaybe::NivaMethod? = m
              mMaybe ifNotNull: [mMaybeValue ->
                declOnly ifTrue: [(mMaybeValue decl) != null ifTrue: [found <- mMaybeValue]]
                declOnly ifFalse: [found <- mMaybeValue]
                ()
              ]
            ]
          ]
          found
        ]
        foundWithDecl = findOwner declOnly: true
        | foundWithDecl
        | null => [ownerMethod <- findOwner declOnly: false]
        |=> [ownerMethod <- foundWithDecl]
      ]
      |=> [
        ownerMethod <- (getMethodFromType t: receiverTypeLocal)
      ]

      ownerMethod == null ifTrue: [
        any = db dtc any
        ownerMethod <- (getMethodFromType t: any)
      ]

      ownerMethodMaybe = ownerMethod
      ownerMethodVal = ownerMethodMaybe orElse: this
      ^ ownerMethodVal toIrFunctionId
    ]
    |=> [
      // after specialization the method has a concrete receiver, but decl
      // still points to the original generic declaration. use that
      // declaration as the function owner, otherwise the call and the
      // generated function get different ids.
      ownerFromDecl = db declToMethod at: (declVal messageDeclKey)
      | ownerFromDecl
      | null => this toIrFunctionId
      |=> ownerFromDecl toIrFunctionId
    ]
]

LiteralExprT toIrLiteralKind -> IrLiteralKind =
  | this
  | CharExprT => IrLiteralKind.Char
  | IntExprT => IrLiteralKind.Int
  | FloatExprT => IrLiteralKind.Float
  | DoubleExprT => IrLiteralKind.Double
  | StringExprT => token kind == TokenType.RawString
                    ifTrue: [IrLiteralKind.RawString]
                    ifFalse: [IrLiteralKind.String]
  | BooleanExprT => IrLiteralKind.Bool
  | NullExprT => IrLiteralKind.Null
  | UnitExprT => IrLiteralKind.Unit
  | AtomExprT => IrLiteralKind.Atom

LiteralExprT toIrLiteral -> IrLiteral = [
  // atoms carry the bare identifier (no leading '#') as their lexeme; other
  // literals keep the raw token text.
  lex = | this
    | AtomExprT => name
    |=> token lexeme
  IrLiteral
    kind: (this toIrLiteralKind)
    lexeme: lex
]

Bool toIrBoolLiteralExpr(db): TyperDB -> IrExpr = [
  lex = this ifTrue: ["true"] ifFalse: ["false"]
  lit = IrLiteral kind: IrLiteralKind.Bool lexeme: lex
  boolRef = db dtc bool toIrTypeRefWithMutErrors: false errorsList: {}
  IrLiteralExpr typeRef: boolRef token: (Token fake) literal: lit
]

TypedExpr2 toIrBlockExprWrappingStmt(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? blkType: IrTypeRef token: Token -> IrExpr = [
  stmt = this toIrStmt: db :currentPkg :typeFieldsById :thisTypeRef
  block = IrBlock stmts: {stmt} result: null resultType: blkType
  ^ IrBlockExpr typeRef: blkType :token :block
]

TypedExpr2 toIrExpr(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrExpr = [
  exprType = (this typeInfo) toIrTypeRef
  exprToken = this token
  | this
    | LiteralExprT => [
      IrLiteralExpr typeRef: exprType token: exprToken literal: (this toIrLiteral)
    ]
    | IdentifierT => [
      // `Color.Red` is identifier with dotted path so last path component is the enum value
      pathMaybe = path
      isEnumValue = isNameOfTheType && (| pathMaybe
        | null => false
        |=> pathMaybe count > 1)
      isEnumValue ifTrue: [
        ^ IrLiteralExpr
            typeRef: exprType
            token: exprToken
            literal: (IrLiteral kind: IrLiteralKind.Atom lexeme: (| pathMaybe
              | null => TO DO: "Enum value has no path"
              |=> pathMaybe last))
      ]
      isNameOfTheType
        ifTrue: [IrTypeRefExpr typeRef: exprType token: exprToken ref: exprType]
        ifFalse: [
          name == "this"
            ifTrue: [
              receiverTypeRefMaybe = thisTypeRef
              receiverTypeRef = | receiverTypeRefMaybe
                | null => (Unknown new) toIrTypeRefWithMutErrors: false errorsList: {}
                |=> receiverTypeRefMaybe
              IrThisRef typeRef: receiverTypeRef token: exprToken
            ]
            ifFalse: [IrVarRef typeRef: exprType token: exprToken :name]
        ]
    ]
    | ExprInBracketsT => value toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
    | VarDeclarationT | AssignT | DestructingAssignT | ReturnStatementT => this toIrBlockExprWrappingStmt: db :currentPkg :typeFieldsById :thisTypeRef blkType: exprType token: exprToken
    | CollectionLiteralT => [
      items = elements v map: [it toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef]
      kind = | exprToken kind
        | TokenType.OpenBrace => IrCollectionKind.List
        | TokenType.OpenParenHash => IrCollectionKind.Set
        | TokenType.OpenBraceHash => IrCollectionKind.Map
        |=> TO DO: "Unexpected collection literal token"
      IrCollectionLiteral typeRef: exprType token: exprToken :kind :items
    ]
    | MessageSendT => this toIrExprFromMsg: db :currentPkg :typeFieldsById :thisTypeRef
    | CodeBlockT => this toIrLambdaExpr: db :currentPkg :typeFieldsById :thisTypeRef
    | MatchT => this toIrMatchExpr: db :currentPkg :typeFieldsById :thisTypeRef
]

TypedExpr2 toIrStmt(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrStmt = [
  | this
  | VarDeclarationT => [
    astTypeMaybe = astType
    declaredInfo = | astTypeMaybe
      | null => value typeInfo
      |=> astTypeMaybe toTypeInfoFromDb: db inPkg: null
    IrLet
      :token
      :name
      typeRef: (declaredInfo toIrTypeRef)
      value: (value toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef)
      :isMut
      :isUsed
  ]
  | AssignT => [
    valExpr = value toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
    | kind
    | AssignKind.TO_THIS_FIELD => IrSetField
        :token
        receiver: (IrThisRef
          typeRef: (| thisTypeRef
            | null => (Unknown new) toIrTypeRefWithMutErrors: false errorsList: {}
            |=> thisTypeRef)
          :token)
        field: name
        value: valExpr
    | AssignKind.TO_LOCAL_MUT => IrSetLocal :token :name value: valExpr
  ]
  | DestructingAssignT => [
    valueExpr = value toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
    valueType = value typeInfo t
    irBindings = bindings map: [binding ->
      fieldName = binding fieldName
      field = valueType findField: fieldName
      fieldMaybe = field
      fieldType = | fieldMaybe
        | null => Unknown new
        |=> fieldMaybe typeT
      IrDestructureBinding
        name: binding localName
        :fieldName
        typeRef: (fieldType toIrTypeRefWithMutErrors: false errorsList: {})
        isUsed: binding isUsed
    ]
    IrDestructure
      :token
      bindings: irBindings
      value: valueExpr
  ]
  | ReturnStatementT => [
    valueMaybe = value
    expr = | valueMaybe
      | null => null
      |=> valueMaybe toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
    IrReturn :token :expr
  ]
  | MessageSendT => [
    // whileTrue: as statement we keep IrWhile without extra block wrapper
    whileStmt = this toIrWhileStmt: db :currentPkg :typeFieldsById :thisTypeRef
    | whileStmt
    | null => [
      irExpr = this toIrExprFromMsg: db :currentPkg :typeFieldsById :thisTypeRef
      | irExpr
      | IrCall => [
          isThrow = irExpr isCoreThrowCall
          isThrow
            ifTrue: [IrThrow :token errExpr: (irExpr args first)]
            ifFalse: [IrExprStmt :token expr: irExpr]
        ]
      |=> IrExprStmt :token expr: irExpr
    ]
    |=> whileStmt
  ]
  |=> [
    IrExprStmt :token expr: (this toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef)
  ]
]


// true for a core throw call
IrCall isCoreThrowCall -> Bool = [
  m = this msgName
  p = this declPkg
  isThrowMsg = | m
    | null => false
    |=> m == "throw"
  isCorePkg = | p
    | null => false
    |=> p == "core"
  ^ isThrowMsg && isCorePkg
]

CodeBlockT toIrLambdaExpr(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrExpr = [
  argsList::List(IrArg) = args isNotEmpty
    ifTrue: [
      args map: [arg ->
        argTypeInfo = arg astType toTypeInfoFromDb: db inPkg: null
        typeRef = argTypeInfo toIrTypeRef
        IrArg name: arg name :typeRef needsGoPointer: typeRef isGoPointerParam
      ]
    ] ifFalse: [
      typedArgs isNotEmpty
        ifTrue: [
          typedArgs map: [a ->
            typeRef = a typeInfo toIrTypeRef
            IrArg name: a name :typeRef needsGoPointer: typeRef isGoPointerParam
          ]
        ]
        ifFalse: [
          lambdaType = typeInfo t
          | lambdaType
          | FuntionT => [
              lambdaType fields map: [f ->
                argName = f name == "" ifTrue: ["it"] ifFalse: [f name]
                IrArg name: argName typeRef: (f typeT toIrType-immut-no-errors) needsGoPointer: false
              ]
            ]
          |=> {}
        ]
    ]

  bodyBlock = body toIrBlock: db :currentPkg :typeFieldsById :thisTypeRef
  exprType = typeInfo toIrTypeRef
  IrLambda typeRef: exprType :token args: argsList body: bodyBlock
]

TypedExpr2 toIrBoolMatchCase(cond): Bool db: TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrMatchCase =
  IrMatchCase
    condition: (cond toIrBoolLiteralExpr: db)
    additionalConditions: {}
    body: (this toIrBlockFromExpr: db :currentPkg :typeFieldsById :thisTypeRef)
    assertedTypeRef: null

TypedExpr2 toIrBlockFromExpr(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrBlock = [
  | this
  | CodeBlockT => this body toIrBlock: db :currentPkg :typeFieldsById :thisTypeRef
  |=> [
    irExpr = this toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
    IrBlock stmts: {} result: irExpr resultType: irExpr typeRef
  ]
]

MatchT toIrMatchExpr(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrExpr = [
  subjectExpr = subject toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
  subjectType = subject typeInfo t

  mut allTypeBranches = true
  branches forEach: [br ->
    condExpr = br condition
    | condExpr
    | IdentifierT => [
      condPathMaybe = condExpr path
      isEnumValue = | condPathMaybe
        | null => false
        |=> condPathMaybe count > 1
      (condExpr isNameOfTheType && (isEnumValue not)) ifFalse: [allTypeBranches <- false]
    ]
    |=> allTypeBranches <- false
  ]

  kind = allTypeBranches
    ifTrue: [
      subject typeInfo listOfErrors isNotEmpty
        ifTrue: [IrMatchKind.ByError]
        ifFalse: [IrMatchKind.ByType]
    ]
    ifFalse: [
      subjectType isBoolType
        ifTrue: [IrMatchKind.ByBool]
        ifFalse: [IrMatchKind.ByValue]
    ]

  typeAlias = | kind
    | IrMatchKind.ByError => "it"
    | IrMatchKind.ByType => [
      | subjectExpr
      | IrThisRef => "this"
      | IrVarRef => subjectExpr name
      |=> null
    ]
    |=> null
  subjectIsUnit = subjectType isCoreTypeNamed: "Unit"

  cases = branches map: [br ->
    condExpr = | kind
      | IrMatchKind.ByType => [
        | br condition
        | IdentifierT => IrTypeRefExpr typeRef: (br condition typeInfo toIrTypeRef) token: br condition token ref: (br condition typeInfo toIrTypeRef)
        |=> br condition toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
      ]
      |=> br condition toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef

    addConds = br additionalConditions v map: [it toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef]
    bodyBlock = br body toIrBlock: db :currentPkg :typeFieldsById :thisTypeRef
    asserted = | condExpr | IrTypeRefExpr => condExpr ref |=> null

    IrMatchCase condition: condExpr additionalConditions: addConds body: bodyBlock assertedTypeRef: asserted
  ]

  elseBranchMaybe = elseBranch
  elseBlock = | elseBranchMaybe
    | null => null
    |=> elseBranchMaybe toIrBlock: db :currentPkg :typeFieldsById :thisTypeRef

  exprType = typeInfo toIrTypeRef
  IrMatchExpr typeRef: exprType :token :kind subject: subjectExpr :cases elseBranch: elseBlock :typeAlias :subjectIsUnit
]

MessageSendT toIrInlineIterationWithLambda(callback): IrLambda db: TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrExpr = [
  callbackArgs = callback args
  isIndexed = (dbMsg name == "forEachIndexed") || (dbMsg name == "forEachIndexed:")
  receiverType = receiver typeInfo t

  receiverIr = receiver toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
  receiverTypeRef = receiverType toIrTypeRefWithMutErrors: false errorsList: {}
  intTypeRef = (db dtc int) toIrTypeRefWithMutErrors: false errorsList: {}
  boolTypeRef = (db dtc bool) toIrTypeRefWithMutErrors: false errorsList: {}
  unitTypeRef = (db dtc unit) toIrTypeRefWithMutErrors: false errorsList: {}

  site = token line toString + "_" + token start toString
  receiverName = "__niva_inline_source_" + site
  countName = "__niva_inline_count_" + site
  indexName = "__niva_inline_index_" + site
  receiverRef = IrVarRef typeRef: receiverTypeRef :token name: receiverName
  countRef = IrVarRef typeRef: intTypeRef :token name: countName
  indexRef = IrVarRef typeRef: intTypeRef :token name: indexName
  receiverArg::IrExpr = receiverRef
  indexArgExpr::IrExpr = indexRef
  countArgs::List(IrExpr) = {receiverArg}
  atArgs::List(IrExpr) = {receiverArg indexArgExpr}

  countCall = IrCall
    typeRef: intTypeRef :token
    funcId: (receiverType toIrFunctionId: "count" declPkg: "core")
    callee: null args: countArgs paramTypes: {receiverTypeRef}
    genericArgs: (receiverType typeArgsForComparison map: [it toIrType-immut-no-errors])
    isConstructor: false isBindCall: false isInline: false
    msgName: "count" declPkg: "core" receiverType: receiverTypeRef
    propagatingErrVar: null bind: null

  atCall = IrCall
    typeRef: (callbackArgs last typeRef) :token
    funcId: (receiverType toIrFunctionId: "at" declPkg: "core")
    callee: null args: atArgs paramTypes: {receiverTypeRef intTypeRef}
    genericArgs: (receiverType typeArgsForComparison map: [it toIrType-immut-no-errors])
    isConstructor: false isBindCall: false isInline: false
    msgName: "at" declPkg: "core" receiverType: receiverTypeRef
    propagatingErrVar: null bind: null

  zero = IrLiteralExpr typeRef: intTypeRef :token
    literal: (IrLiteral kind: IrLiteralKind.Int lexeme: "0")
  one = IrLiteralExpr typeRef: intTypeRef :token
    literal: (IrLiteral kind: IrLiteralKind.Int lexeme: "1")
  condition = IrOpBin typeRef: boolTypeRef :token op: "<" left: indexRef right: countRef
  incrementValue = IrOpBin typeRef: intTypeRef :token op: "+" left: indexRef right: one

  callbackStatements::mut List::IrStmt = {}!
  isIndexed ifTrue: [
    indexArg = callbackArgs first
    indexLet::IrStmt = IrLet :token name: indexArg name typeRef: indexArg typeRef value: indexRef isMut: false isUsed: true
    callbackStatements add: indexLet
  ]
  itemArg = callbackArgs last
  itemLet::IrStmt = IrLet :token name: itemArg name typeRef: itemArg typeRef value: atCall isMut: false isUsed: true
  callbackStatements add: itemLet
  callbackStatements addAll: (callback body stmts)
  callbackResult = callback body result
  | callbackResult
  | null => ()
  |=> [
    resultStmt::IrStmt = IrExprStmt :token expr: callbackResult
    callbackStatements add: resultStmt
    ()
  ]

  callbackBlock = IrBlock stmts: callbackStatements toList result: null resultType: unitTypeRef
  callbackScopeExpr = IrBlockExpr typeRef: unitTypeRef :token block: callbackBlock
  callbackStmt::IrStmt = IrExprStmt :token expr: callbackScopeExpr
  bodyStatements::mut List::IrStmt = {callbackStmt}!
  incrementStmt::IrStmt = IrSetLocal :token name: indexName value: incrementValue
  bodyStatements add: incrementStmt

  loopBody = IrBlock stmts: bodyStatements toList result: null resultType: unitTypeRef
  loopType = IrTypeRef kind: IrTypeRefKind.Function typeId: "core_Function" ownerPkg: "core"
    args: {} returnType: unitTypeRef isMut: false nullable: false errors: {}
  loopLambda = IrLambda typeRef: loopType :token args: {} body: loopBody
  loop = IrWhile :token cond: condition body: loopLambda

  sourceLet = IrLet :token name: receiverName typeRef: receiverTypeRef value: receiverIr isMut: false isUsed: true
  countLet = IrLet :token name: countName typeRef: intTypeRef value: countCall isMut: false isUsed: true
  indexLet = IrLet :token name: indexName typeRef: intTypeRef value: zero isMut: true isUsed: true
  inlineBlock = IrBlock stmts: {sourceLet countLet indexLet loop} result: null resultType: unitTypeRef
  IrBlockExpr typeRef: unitTypeRef :token block: inlineBlock
]

MessageSendT toIrInlineIteration(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrExpr? = [
  isInline = dbMsg isInline
  msgName = dbMsg name
  isIndexed = (msgName == "forEachIndexed") || (msgName == "forEachIndexed:")
  isForEach = (msgName == "forEach") || (msgName == "forEach:")
  (isInline && (isForEach || isIndexed)) ifFalse: [^ null]

  receiverType = receiver typeInfo t
  supportedReceiver = | receiverType
    | ListT | StringT => true
    |=> false
  (supportedReceiver && ((isIndexed && ((| receiverType | ListT => true |=> false) not)) not)) ifFalse: [^ null]

  // the callback arrives as a typed code block so it becomes an ir lambda first
  blockMaybe = | this
    | KeywordMsgT => args first expr
    |=> null
  mut inlineExpr::IrExpr? = null
  | blockMaybe
  | CodeBlockT => [
    irLambda = blockMaybe toIrLambdaExpr: db :currentPkg
      :typeFieldsById :thisTypeRef
    | irLambda
    | IrLambda => [
      callbackArgs = irLambda args
      expectedArgCount = isIndexed ifTrue: [2] ifFalse: [1]
      callbackArgs count == expectedArgCount ifTrue: [
        inlineExpr <- this toIrInlineIterationWithLambda: irLambda :db
          :currentPkg :typeFieldsById :thisTypeRef
      ]
      ()
    ]
    |=> []
  ]
  |=> []
  inlineExpr
]

// a binary method declared in niva code, on the type or a union it's a branch of
TyperDB declaredBinary(op): String forType(t): NivaType -> NivaMethod? = [
  mut result = this declaredBinary: op onlyForType: t
  | t
  | TypeT => (this unionAncestorChain: t) forEach: [ancestor ->
      result == null ifTrue: [result <- this declaredBinary: op onlyForType: ancestor]
    ]
  |=> []
  ^ result
]

TyperDB declaredBinary(op): String onlyForType(t): NivaType -> NivaMethod? = [
  mut result::NivaMethod? = null
  methodsMaybe = typeToMethodBuckets at: (t toMangledName)
  | methodsMaybe
  | null => []
  |=> [
    methodMaybe = methodsMaybe methodAt: MethodBucketKind.Binary name: op
    | methodMaybe
    | null => []
    |=> [(methodMaybe decl != null) ifTrue: [result <- methodMaybe]]
  ]
  ^ result
]

// an operator both backends have, but == and != call the type's own when it declares one, as the jvm compiler does, and != negates its == when it has no !=
TyperDB irOp(op): String left: IrExpr right: IrExpr leftType: NivaType typeRef: IrTypeRef token: Token -> IrExpr = [
  mut ownMaybe::NivaMethod? = null
  ((op == "==") || (op == "!=")) ifTrue: [ownMaybe <- this declaredBinary: op forType: leftType]
  ((op == "!=") && (ownMaybe == null)) ifTrue: [ownMaybe <- this declaredBinary: "==" forType: leftType]
  own = ownMaybe
  ^ | own
    | null => IrOpBin :typeRef :token :op :left :right
    |=> [
      receiverParam = own receiverType toIrTypeRefWithMutErrors: own forMut errorsList: {}
      ownReceiver = own receiverType toIrTypeRefWithMutErrors: false errorsList: {}
      call = IrCall :typeRef :token funcId: (own toCanonicalIrFunctionId: this) callee: null args: {left right} paramTypes: {receiverParam (own args first toIrTypeRef)} genericArgs: (own genericTypeArgs map: [it toIrType-immut-no-errors]) isConstructor: false isBindCall: false isInline: false msgName: own name declPkg: own pkgName receiverType: ownReceiver propagatingErrVar: null bind: null
      own name == op
        ifTrue: [call]
        ifFalse: [IrOpBin :typeRef :token op: "==" left: call right: (false toIrBoolLiteralExpr: this)]
    ]
]

MessageSendT toIrExprFromMsg(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrExpr = [
  receiverExpr = receiver toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
  receiverType = receiver typeInfo t
  receiverTypeRef = receiverType toIrTypeRefWithMutErrors: false errorsList: {}
  methodReceiverTypeRef = dbMsg receiverType toIrTypeRefWithMutErrors: false errorsList: {}
  methodReceiverParamTypeRef = dbMsg receiverType toIrTypeRefWithMutErrors: (dbMsg forMut) errorsList: {}
  methodArgParamTypes = dbMsg args map: [it toIrTypeRef]
  genericArgs = dbMsg genericTypeArgs map: [it toIrType-immut-no-errors]
  exprType = typeInfo toIrTypeRef

  isDefaultCtor = dbMsg kind == MessageSendKind.DefaultConstructor
  isCtor = (dbMsg kind == MessageSendKind.DefaultConstructor) || (dbMsg kind == MessageSendKind.CustomConstructor)
  baseReceiverType = receiverType unwrapNullable
  isBindReceiver = (baseReceiverType toMangledName) == "core_Bind"
  useNewCtor = isDefaultCtor && (dbMsg decl == null) && (isBindReceiver not)
  // inlineable bind plan for this call (null for ordinary calls); computed once here
  dbMsgDeclMaybe = dbMsg decl
  bindPlan = | dbMsgDeclMaybe
    | null => null
    |=> dbMsgDeclMaybe bindPlanWith: db
  isReceiverFunction = | receiverType
    | FuntionT => true
    |=> false
  functionParamTypes::List(IrTypeRef) = | receiverType
    | FuntionT => receiverType fields map: [it toIrTypeRef]
    |=> {}
  msgName = dbMsg name
  isIfTrue = (msgName == "ifTrue:") || (msgName == "ifTrue")
  isIfFalse = (msgName == "ifFalse:") || (msgName == "ifFalse")
  isIfTrueIfFalse = (msgName == "ifTrue:ifFalse:") || (msgName == "ifTrue__ifFalse")
  isIfFalseIfTrue = (msgName == "ifFalse:ifTrue:") || (msgName == "ifFalse__ifTrue")
  condIf = isIfTrue || isIfFalse || isIfTrueIfFalse || isIfFalseIfTrue

  mut result::IrExpr? = null

  // ifTrue / ifFalse / ifTrue:ifFalse:
  condIf ifTrue: [
    mut trueCase::IrMatchCase? = null
    mut falseCase::IrMatchCase? = null

    argsList::List(NameAndExprT) = | this
               | KeywordMsgT => args
               |=> {}

    isIfTrue ifTrue: [
      argExpr = argsList first expr
      trueCase <- argExpr toIrBoolMatchCase: true :db :currentPkg :typeFieldsById :thisTypeRef
    ]

    isIfFalse ifTrue: [
      argExpr = argsList first expr
      falseCase <- argExpr toIrBoolMatchCase: false :db :currentPkg :typeFieldsById :thisTypeRef
    ]

    isIfTrueIfFalse ifTrue: [
      argTrue = argsList at: 0, expr
      argFalse = argsList at: 1, expr
      trueCase <- argTrue toIrBoolMatchCase: true :db :currentPkg :typeFieldsById :thisTypeRef
      falseCase <- argFalse toIrBoolMatchCase: false :db :currentPkg :typeFieldsById :thisTypeRef
    ]

    isIfFalseIfTrue ifTrue: [
      argFalse = argsList at: 0, expr
      argTrue = argsList at: 1, expr
      trueCase <- argTrue toIrBoolMatchCase: true :db :currentPkg :typeFieldsById :thisTypeRef
      falseCase <- argFalse toIrBoolMatchCase: false :db :currentPkg :typeFieldsById :thisTypeRef
    ]

    cases::mut List::IrMatchCase = {}!
    trueCase ifNotNull: [trueCaseValue ->
      cases add: trueCaseValue
      ()
    ]
    falseCase ifNotNull: [falseCaseValue ->
      cases add: falseCaseValue
      ()
    ]

    mut fallbackBranch::IrBlock? = null
    (isIfTrue || isIfFalse) ifTrue: [
      fallbackBranch <- IrBlock stmts: {} result: null resultType: exprType
    ]

    result <- IrMatchExpr
      typeRef: exprType
      :token
      kind: IrMatchKind.ByBool
      subject: receiverExpr
      cases: cases toList
      elseBranch: fallbackBranch
      typeAlias: null
      subjectIsUnit: false
  ]

  result == null ifTrue: [
    inlineIterationMaybe = this toIrInlineIteration: db :currentPkg
      :typeFieldsById :thisTypeRef
    | inlineIterationMaybe
    | null => []
    |=> result <- inlineIterationMaybe
  ]

  result == null ifTrue: [
    // whileTrue: as expression we must return IrExpr, so wrap stmt into IrBlockExpr
    whileStmt = this toIrWhileStmt: db :currentPkg :typeFieldsById :thisTypeRef
    whileStmtMaybe = whileStmt
    | whileStmtMaybe
    | null => ()
    |=> [
      block = IrBlock stmts: {whileStmtMaybe} result: null resultType: exprType
      result <- IrBlockExpr typeRef: exprType :token :block
    ]
  ]

  result == null ifTrue: [
    result <- | this
      | UnaryMsgT => [
        dbMsg kind == MessageSendKind.Getter
          ifTrue: [
            IrFieldGet typeRef: exprType :token receiver: receiverExpr field: selector name
          ]
          ifFalse: [
            isReceiverFunction && (selector name == "do")
                  ifTrue: [
                    propagatingErrVar = exprType errors isNotEmpty ifTrue: ["__err"] ifFalse: [null]
                    IrCall typeRef: exprType :token funcId: null callee: receiverExpr args: {} paramTypes: {} genericArgs: {} isConstructor: false isBindCall: false isInline: false msgName: null declPkg: null receiverType: null :propagatingErrVar bind: null
                  ]
                  ifFalse: [
                    isCtor ifTrue: [
                             useNewCtor ifTrue: [IrNewExpr typeRef: exprType :token typeId: (receiverType toIrTypeId) args: {}
                                                  constructorBind: receiverType irConstructorBind
                                                  ]
                                        ifFalse: [
                                          callId = dbMsg toCanonicalIrFunctionId: db
                                          IrCall typeRef: exprType :token funcId: callId callee: null args: {} paramTypes: {} genericArgs: genericArgs isConstructor: true isBindCall: false isInline: false msgName: (dbMsg name) declPkg: (dbMsg pkgName) receiverType: methodReceiverTypeRef propagatingErrVar: null bind: bindPlan
                                        ]
                           ]
                           ifFalse: [
                             callId = dbMsg toCanonicalIrFunctionId: db
                             propagatingErrVar = exprType errors isNotEmpty ifTrue: ["__err"] ifFalse: [null]
                             IrCall typeRef: exprType :token funcId: callId callee: null args: {receiverExpr} paramTypes: {methodReceiverParamTypeRef} genericArgs: genericArgs isConstructor: false isBindCall: isBindReceiver isInline: dbMsg isInline msgName: (dbMsg name) declPkg: (dbMsg pkgName) receiverType: methodReceiverTypeRef :propagatingErrVar bind: bindPlan
                           ]
                  ]
          ]
      ]
      | BinaryMsgT => [
        mut currentExpr = receiverExpr
        mut currentType = receiver typeInfo t
        args forEachIndexed: [i, arg ->
          op = arg name name
          argExpr = arg expr toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
          argType = arg expr typeInfo t

          isLast = i == (args count - 1)

          isNum = currentType isNumericType && argType isNumericType
          isStr = currentType isStringType && argType isStringType
          isBool = currentType isBoolType && argType isBoolType

          opIsComparison = (op == "==") || (op == "!=") || (op == ">") ||
            (op == "<") || (op == ">=") || (op == "<=")
          opIsBoolean = (op == "||") || (op == "&&")
          opIsArithmetic = (op == "-") || (op == "*") || (op == "/") || (op == "%")
          opIsPlus = op == "+"
          opIsNative = opIsComparison || (opIsPlus && (isNum || isStr)) ||
            (opIsArithmetic && isNum) || (opIsBoolean && isBool)

          opResultType = (opIsComparison || opIsBoolean) ifTrue: [db dtc bool] ifFalse: [
            op == "+" ifTrue: [
              isStr ifTrue: [db dtc str] ifFalse: [currentType]
            ] ifFalse: [
              opIsArithmetic ifTrue: [currentType]
                ifFalse: [isLast ifTrue: [typeInfo t] ifFalse: [currentType]]
            ]
          ]

          newTypeRef = opResultType toIrTypeRefWithMutErrors: false errorsList: {}

          opIsNative
            ifTrue: [
              currentExpr <- db irOp: op left: currentExpr right: argExpr leftType: currentType typeRef: newTypeRef :token
            ]
            ifFalse: [
              // fix custom binary methods
              // binary methods for core types can belong to the current package
              // so use the receiver type while MessageDeclT keeps the declaration package
              methodsMaybe = db typeToMethodBuckets at: (currentType toMangledName)
              methodPkg = | methodsMaybe
                | null => currentPkg
                |=> [
                  methodMaybe = methodsMaybe methodAt: MethodBucketKind.Binary name: op
                  | methodMaybe
                  | null => currentPkg
                  |=> methodMaybe pkgName
                ]
              callId = currentType toIrFunctionId: op declPkg: methodPkg
              currentTypeRef = currentType toIrTypeRefWithMutErrors: false errorsList: {}
              binaryMethodMaybe = arg dbMsg
              binaryGenericArgs::List(IrTypeRef) = | binaryMethodMaybe
                | null => {}
                |=> (binaryMethodMaybe genericTypeArgs map: [it toIrType-immut-no-errors])
              currentExpr <- IrCall typeRef: newTypeRef :token funcId: callId callee: null args: {currentExpr argExpr} paramTypes: {methodReceiverParamTypeRef (arg expr typeInfo toIrTypeRef)} genericArgs: binaryGenericArgs isConstructor: false isBindCall: false isInline: false msgName: op declPkg: methodPkg receiverType: currentTypeRef propagatingErrVar: (newTypeRef errors isNotEmpty ifTrue: ["__err"] ifFalse: [null]) bind: null
            ]

          currentType <- opResultType
        ]

        currentExpr
      ]
      | KeywordMsgT => [
        shadowCopy = dbMsg kind == MessageSendKind.ShadowCopy
        shadowCopy
          ifTrue: [
            shadowType = dbMsg receiverType
            fields = shadowType collectFields
            argsByName::mut Map(String, IrExpr) = #{}!
            args forEach: [arg ->
              argsByName at: (arg name name) put: (arg expr toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef)
            ]
            argsExprs = fields map: [field ->
              argExpr = argsByName at: field name
              | argExpr
              | null => [
                fieldTypeRef = field typeT toIrTypeRefWithMutErrors: false errorsList: {}
                IrFieldGet typeRef: fieldTypeRef :token receiver: receiverExpr field: field name
              ]
              |=> argExpr
            ]
            IrNewExpr typeRef: exprType :token typeId: (shadowType toIrTypeId) args: argsExprs
              constructorBind: shadowType irConstructorBind
          ]
          ifFalse: [
            isReceiverFunction
              ifTrue: [
                argsExprs = args map: [it expr toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef]
                IrCall typeRef: exprType :token funcId: null callee: receiverExpr args: argsExprs paramTypes: functionParamTypes genericArgs: {} isConstructor: false isBindCall: false isInline: false msgName: null declPkg: null receiverType: null propagatingErrVar: (exprType errors isNotEmpty ifTrue: ["__err"] ifFalse: [null]) bind: null
              ]
              ifFalse: [
                argsExprs = args map: [it expr toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef]
                isCtor
                  ifTrue: [
                    useNewCtor
                      ifTrue: [IrNewExpr typeRef: exprType :token typeId: (receiverType toIrTypeId) args: argsExprs
                                constructorBind: receiverType irConstructorBind
                                ]
                      ifFalse: [
                        callId = dbMsg toCanonicalIrFunctionId: db
                        IrCall typeRef: exprType :token funcId: callId callee: null args: argsExprs paramTypes: methodArgParamTypes genericArgs: genericArgs isConstructor: true isBindCall: false isInline: false msgName: (dbMsg name) declPkg: (dbMsg pkgName) receiverType: methodReceiverTypeRef propagatingErrVar: null bind: bindPlan
                      ]
                  ]
                  ifFalse: [
                    callId = dbMsg toCanonicalIrFunctionId: db
                    IrCall typeRef: exprType :token funcId: callId callee: null args: ({receiverExpr} + argsExprs) paramTypes: ({methodReceiverParamTypeRef} + methodArgParamTypes) genericArgs: genericArgs isConstructor: false isBindCall: isBindReceiver isInline: dbMsg isInline msgName: (dbMsg name) declPkg: (dbMsg pkgName) receiverType: methodReceiverTypeRef propagatingErrVar: (exprType errors isNotEmpty ifTrue: ["__err"] ifFalse: [null]) bind: bindPlan
                  ]
              ]
          ]
      ]
  ]

  resultMaybe = result
  ^ | resultMaybe
    | null => TO DO: "Failed to lower message send to IR"
    |=> resultMaybe
]

MessageSendT toIrWhileStmt(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrStmt? = [
  isWhile = (dbMsg name == "whileTrue") || (dbMsg name == "whileTrue:")
  mut whileResult::IrStmt? = null
  isWhile ifTrue: [
    | this
    | KeywordMsgT => [
      condExpr = receiver toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
      bodyExpr = (args first expr) toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
      whileResult <- IrWhile :token cond: condExpr body: bodyExpr
      ()
    ]
    |=> []
  ] ifFalse: [()]
  ^ whileResult
]


TypedBody toIrBlock(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrBlock = [
  this toIrBlockWithPrefix: {} :db :currentPkg :typeFieldsById :thisTypeRef
]

TypedBody toIrBlockWithPrefix(prefix): List::IrStmt db: TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) thisTypeRef: IrTypeRef? -> IrBlock = [
  exprs = v
  stmts::mut List::IrStmt = prefix toMutableList
  mut resultExpr::IrExpr? = null

  exprs isNotEmpty ifTrue: [
    lastIndex = exprs count - 1
    exprs forEachIndexed: [i, bodyExpr ->
      isLast = i == lastIndex
      // a statement in brackets, like (^ x), is still a statement
      expr = bodyExpr withoutBrackets
      | expr
      | VarDeclarationT
      | AssignT
      | DestructingAssignT
      | ReturnStatementT => [
        stmt = expr toIrStmt: db :currentPkg :typeFieldsById :thisTypeRef
        stmts add: stmt
        isLast ifTrue: [resultExpr <- null]
      ]
      |=> [
        isLast ifTrue: [
          irExpr = expr toIrExpr: db :currentPkg :typeFieldsById :thisTypeRef
          exprIsUnit = expr typeInfo t isCoreTypeNamed: "Unit"
          exprIsUnit ifTrue: [
            | irExpr
            | IrCall => [
                isThrow = irExpr isCoreThrowCall
                isThrow
                  ifTrue: [
                    throwStmt::IrStmt = IrThrow token: expr token errExpr: (irExpr args first)
                    stmts add: throwStmt
                  ]
                  ifFalse: [
                    exprStmt::IrStmt = IrExprStmt token: expr token expr: irExpr
                    stmts add: exprStmt
                  ]
              ]
            |=> [
              exprStmt::IrStmt = IrExprStmt token: expr token expr: irExpr
              stmts add: exprStmt
            ]
          ]
          exprIsUnit ifFalse: [
            resultExpr <- irExpr
          ]
        ]
        isLast ifFalse: [
          stmts add: (expr toIrStmt: db :currentPkg :typeFieldsById :thisTypeRef)
        ]
      ]
    ]
  ]

  blockType = t toIrTypeRefWithMutErrors: false errorsList: {}
  IrBlock stmts: stmts toList result: resultExpr resultType: blockType
]

TypeFieldT toIrField -> IrField = IrField :name typeRef: (typeInfo toIrTypeRef)

UnionBranchT toIrUnionBranch -> IrUnionBranch =
  IrUnionBranch :name fields: (fields map: [it toIrField]) :isInclude :token

MessageDeclT toIrFunction(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) -> IrFunction = [
  receiverType = receiver
  receiverTypeRef = receiverType toIrTypeRefWithMutErrors: false errorsList: {}

  // lookup mut receiver requirement
  mut requiresMutReceiver = false
  methodsMaybe::MethodBuckets? = isConstructor
    ifTrue: [null]
    ifFalse: [db typeToMethodBuckets at: (receiverType toMangledName)]

  | methodsMaybe
  | null => ()
  |=> [
    methodBucket = args isEmpty
      ifTrue: [MethodBucketKind.Unary]
      ifFalse: [name isBinaryOperator ifTrue: [MethodBucketKind.Binary] ifFalse: [MethodBucketKind.Keyword]]
    methodMaybe = methodsMaybe methodAt: methodBucket name: name
    | methodMaybe
    | null => []
    |=> [
      requiresMutReceiver <- methodMaybe forMut
      ()
    ]
    ()
  ]

  constructorMaybe::NivaMethod? = isConstructor
    ifFalse: [null]
    ifTrue: [
      constructorsMaybe = db constructorsTypeToMethodNameToMethod at: (receiverType toMangledName)
      | constructorsMaybe
      | null => null
      |=> constructorsMaybe at: name
    ]
  | constructorMaybe
  | null => ()
  |=> [
    requiresMutReceiver <- constructorMaybe forMut
    ()
  ]

  argsList = args map: [a ->
    typeRef = a typeInfo toIrTypeRef
    IrArg name: a name :typeRef needsGoPointer: typeRef isGoPointerParam
  ]
  receiverArgTypeRef = receiverType toIrTypeRefWithMutErrors: requiresMutReceiver errorsList: {}
  finalArgs = isConstructor
    ifTrue: [argsList]
    ifFalse: [{(IrArg name: "this" typeRef: receiverArgTypeRef needsGoPointer: receiverArgTypeRef isGoPointerParam)} + argsList]

  // inject field aliases as IrLet bindings at the top of the method body
  receiverTypeId = receiverType toIrTypeId
  aliasFields = typeFieldsById at: receiverTypeId
  aliasLetStmts::mut List(IrStmt) = {}!
  isConstructor ifFalse: [
    aliasFieldsMaybe = aliasFields
    | aliasFieldsMaybe
    | null => ()
    |=> [
      aliasFieldsMaybe forEach: [field ->
        argShadowsField = args any: [arg -> arg name == field name]
        argShadowsField ifFalse: [
          aliasStmt::IrStmt = IrLet
            token: (Token fake)
            name: field name
            typeRef: field typeRef
            value: (IrFieldGet
              typeRef: field typeRef
              token: (Token fake)
              receiver: (IrThisRef typeRef: receiverArgTypeRef token: (Token fake))
              field: field name)
            isMut: false
            isUsed: false
          aliasLetStmts add: aliasStmt
        ]
      ]
      ()
    ]
  ]

  rawBodyBlock = body toIrBlock: db :currentPkg :typeFieldsById thisTypeRef: receiverArgTypeRef
  bodyBlock = aliasLetStmts isEmpty
    ifTrue: [rawBodyBlock]
    ifFalse: [IrBlock stmts: (aliasLetStmts toList + rawBodyBlock stmts) result: rawBodyBlock result resultType: rawBodyBlock resultType]

  returnTypeRef = returnType toIrTypeRef
  mut functionId = receiverType toIrFunctionId: name declPkg: currentPkg
  isConstructor ifTrue: [functionId <- functionId + "__ctor_" + (args count toString)]

  genericTypes = {receiverType} + (args map: [it typeInfo t]) + {(returnType t)}

  genericsSet::mut Set(String) = #()!
  genericsList::mut List(String) = {}!
  genericTypes forEach: [t ->
    t collectUnresolvedGenerics forEach: [g ->
      genericsSet contains: g name, ifFalse: [
        genericsSet add: g name
        genericsList add: g name
      ]
    ]
  ]

  IrFunction
    id: functionId
    pkgId: currentPkg
    :name
    receiverType: receiverTypeRef
    args: finalArgs
    returnType: returnTypeRef
    :requiresMutReceiver
    generics: genericsList toList
    instantiations: {}
    body: bodyBlock
    :token
]

TypedStatement toIrFunctions(db): TyperDB currentPkg: String typeFieldsById: Map(String, List(IrField)) -> List::IrFunction =
  | this
  | MessageDeclT => [
      {(this toIrFunction: db :currentPkg :typeFieldsById)}
    ]
  | ExtendDeclT => messages map: [it toIrFunction: db :currentPkg :typeFieldsById]
  |=> [empty::List(IrFunction) = {}
       empty]

TypedStatement toIrTypes(db): TyperDB currentPkg: String typeFieldsById: mut Map(String, List(IrField)) -> List(IrTypeDef) =
  | this
  | TypeDeclT => [
    typeFromDb = db findByTypeName: name inPkg: currentPkg
    typeParams::List(String) = | typeFromDb
      | TypeT => typeFromDb genericArgs map: [it name]
      |=> {}
    fieldsIr = fields map: [it toIrField]
    typeId = typeFromDb toIrTypeId
    typeFieldsById at: typeId put: fieldsIr
    {(IrTypeDef id: typeId pkgId: currentPkg :name :typeParams fields: fieldsIr :token)}
  ]
  |=> [empty::List(IrTypeDef) = {}
       empty]

TypedStatement toIrUnions(db): TyperDB currentPkg: String typeFieldsById: mut Map(String, List(IrField)) -> List(IrUnionDef) =
  | this
  | UnionDeclT => [
    rootType = db findByTypeName: name inPkg: currentPkg
    rootTypeId = rootType toIrTypeId
    typeParams::List(String) = | rootType
      | TypeT => rootType genericArgs map: [it name]
      |=> {}

    commonFieldsIr = commonUnionFields map: [it toIrField]
    typeFieldsById at: rootTypeId put: commonFieldsIr

    branchesIr = branches map: [b ->
      branchIr = b toIrUnionBranch

      branchType = db findByTypeName: b name inPkg: currentPkg
      branchTypeId = branchType toIrTypeId
      combinedFields = commonFieldsIr + (branchIr fields)
      typeFieldsById at: branchTypeId put: combinedFields

      branchIr
    ]

    {(IrUnionDef
      id: rootTypeId
      pkgId: currentPkg
      :name
      :typeParams
      commonFields: commonFieldsIr
      branches: branchesIr
      isErrorDomain: (token kind == TokenType.ErrorDomain)
      :token
    )}
  ]
  |=> [empty::List(IrUnionDef) = {}
       empty]

TypedStatement toIrEnums(db): TyperDB currentPkg: String -> List(IrEnumDef) =
  | this
  | EnumDeclT => [
    enumType = db findByTypeName: name inPkg: currentPkg
    enumId = enumType toIrTypeId
    {(IrEnumDef id: enumId pkgId: currentPkg :name :values :token)}
  ]
  |=> [empty::List(IrEnumDef) = {}
       empty]

IrTypeRef toKeyPart -> String = [
  argsKey = args isNotEmpty
    ifTrue: ["(" + (args joinWith: "," transform: [it toKeyPart]) + ")"]
    ifFalse: [""]
  typeId + argsKey + (nullable ifTrue: ["?"] ifFalse: [""])
]

IrInstantiation toKey -> String = [
  argKey = argTypes isNotEmpty
    ifTrue: [argTypes joinWith: "," transform: [it toKeyPart]]
    ifFalse: [""]
  receiverType toKeyPart + "|" + argKey + "|" + returnType toKeyPart
]

TypedExpr2 collectInstantiationsFromExpr(db): TyperDB currentPkg: String instMap: mut Map(String, mut List::IrInstantiation) specializationUses: mut Map(String, mut Set(String)) -> Unit = [
  | this
  | MessageSendT => [
    funcId = this dbMsg toCanonicalIrFunctionId: db

    receiverType = this receiver typeInfo t
    argExprs::List(TypedExpr2) = | this
               | UnaryMsgT => {}
               | BinaryMsgT => [args map: [it expr]]
               | KeywordMsgT => [args map: [it expr]]

    argTypes = argExprs map: [it typeInfo t]
    returnType = this dbMsg returnType

    instListMaybe = instMap at: funcId
    instList::mut List::IrInstantiation = | instListMaybe
      | null => [
        newInstList::mut List::IrInstantiation = {}!
        instMap at: funcId put: newInstList
        newInstList
      ]
      |=> instListMaybe

    inst = IrInstantiation
      receiverType: (receiverType toIrTypeRefWithMutErrors: false errorsList: {})
      argTypes: (argTypes map: [it toIrTypeRefWithMutErrors: false errorsList: {}])
      returnType: (returnType toIrTypeRefWithMutErrors: false errorsList: {})

    exists = instList any: [it toKey == inst toKey]
    exists ifFalse: [instList add: inst]

    specializationId = this dbMsg pkgName + "|" + funcId + "|" + inst toKey
    contributorsMaybe = specializationUses at: specializationId
    contributors::mut Set(String) = | contributorsMaybe
      | null => [
        newContributors::mut Set(String) = #()!
        specializationUses at: specializationId put: newContributors
        newContributors
      ]
      |=> contributorsMaybe
    contributors add: currentPkg

    receiver collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses
    argExprs forEach: [it collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses]
  ]
  | VarDeclarationT => value collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses
  | AssignT => value collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses
  | DestructingAssignT => value collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses
  | ReturnStatementT => [
    valueMaybe = value
    | valueMaybe
    | null => []
    |=> valueMaybe collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses
  ]
  | CodeBlockT =>         body v forEach: [it collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses]
  | MatchT => [
    subject collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses
    branches forEach: [br ->
      br condition collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses
      br additionalConditions v forEach: [it collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses]
      br body v forEach: [it collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses]
    ]
    elseBranchMaybe = elseBranch
    | elseBranchMaybe
    | null => []
    |=> elseBranchMaybe v forEach: [it collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses]
  ]
  | CollectionLiteralT => elements v forEach: [it collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses]
  | ExprInBracketsT =>    value collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses
  |=> []
]

List(TypedStatement) collectInstantiationsFromStatements(db): TyperDB currentPkg: String instMap: mut Map(String, mut List::IrInstantiation) specializationUses: mut Map(String, mut Set(String)) -> Unit = [
  this forEach: [st ->
    | st
    | MessageDeclT => st body v forEach: [it collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses]
    | ExtendDeclT =>  st messages forEach: [msg ->
        msg body v forEach: [it collectInstantiationsFromExpr: db :currentPkg :instMap :specializationUses]
      ]
    |=> []
  ]
]

ResolverHelper specializationUses -> Map(String, Set(String)) = [
  instMap::mut Map(String, mut List::IrInstantiation) = #{}!
  uses::mut Map(String, mut Set(String)) = #{}!
  fileToStatements forEach: [file, statements ->
    statements collectInstantiationsFromStatements: db currentPkg: file :instMap specializationUses: uses
  ]
  entryPointExpressions forEach: [
    it collectInstantiationsFromExpr: db currentPkg: entryPointName :instMap specializationUses: uses
  ]
  uses
]

ResolverHelper toIrModuleUncheckedFromEntryLine(startLine): Int -> IrModule = [
  resolverDb = this db
  packages = resolverDb packages

  typeFieldsById::mut Map(String, List(IrField)) = #{}!
  types::mut List::IrTypeDef = {}!
  unions::mut List::IrUnionDef = {}!
  enums::mut List::IrEnumDef = {}!
  functions::mut List::IrFunction = {}!

  // fileToStatements keys are pkg names (file names), not filesystem paths
  fileToStatements forEach: [file, statements ->
    statements forEach: [st ->
      types addAll: (st toIrTypes: resolverDb currentPkg: file :typeFieldsById)
      unions addAll: (st toIrUnions: resolverDb currentPkg: file :typeFieldsById)
      enums addAll: (st toIrEnums: resolverDb currentPkg: file)
      functions addAll: (st toIrFunctions: resolverDb currentPkg: file :typeFieldsById)
    ]
  ]

  instMap::mut Map(String, mut List::IrInstantiation) = #{}!
  specializationUses::mut Map(String, mut Set(String)) = #{}!

  fileToStatements forEach: [file, statements ->
    statements collectInstantiationsFromStatements: resolverDb currentPkg: file :instMap :specializationUses
  ]

  // entry point
  entryExprs = entryPointExpressions filter: [it token line >= startLine]
  entryType = entryExprs isEmpty
    ifTrue: [resolverDb dtc unit]
    ifFalse: [(entryExprs last) typeInfo t]

  entryBody = TypedBody v: entryExprs t: entryType listOfErrors: {}
  // top-level expressions are not MessageDeclT, so collect their generic
  // method instantiations separately.
  entryExprs forEach: [it collectInstantiationsFromExpr: resolverDb
                                      currentPkg: entryPointName
                                      :instMap
                                      :specializationUses]
  rawEntryBlock = entryBody toIrBlock: resolverDb currentPkg: entryPointName :typeFieldsById thisTypeRef: null

  // lift entry mutations into persistent state definitions
  stateDefs::mut List::IrStateDef = {}!
  executableEntryStmts::mut List::IrStmt = {}!
  rawEntryBlock stmts forEach: [stmt ->
    | stmt
    | IrLet => [
        typedStmt::IrStmt = stmt
        stmt isMut ifTrue: [stateDefs add: (IrStateDef
            name: stmt name
            typeRef: stmt typeRef
            initializer: stmt value
            token: stmt token)]
      executableEntryStmts add: typedStmt
      ]
    |=> [executableEntryStmts add: stmt]
  ]
  entryBlock = IrBlock
    stmts: executableEntryStmts toList
    result: rawEntryBlock result
    resultType: rawEntryBlock resultType

  // attach instantiations
  functionsWithInst = functions map: [f ->
    instForFn = instMap at: f id
    emptyInstantiations::List(IrInstantiation) = {}
    instList = | instForFn
      | null => emptyInstantiations
      |=> instForFn toList
    IrFunction
      id: f id
      pkgId: f pkgId
      name: f name
      receiverType: f receiverType
      args: f args
      returnType: f returnType
      requiresMutReceiver: f requiresMutReceiver
      generics: f generics
      instantiations: instList
      body: f body
      token: f token
  ]

  typesByPkg::mut Map(String, mut List::IrTypeDef)      = #{}!
  unionsByPkg::mut Map(String, mut List::IrUnionDef)    = #{}!
  enumsByPkg::mut Map(String, mut List::IrEnumDef)      = #{}!
  functionsByPkg::mut Map(String, mut List::IrFunction) = #{}!

  types forEach: [t ->
    listMaybe = typesByPkg at: t pkgId
    list::mut List::IrTypeDef = | listMaybe
      | null => {}!
      |=> listMaybe
    list add: t
    typesByPkg at: t pkgId put: list
  ]
  unions forEach: [u ->
    listMaybe = unionsByPkg at: u pkgId
    list::mut List::IrUnionDef = | listMaybe
      | null => {}!
      |=> listMaybe
    list add: u
    unionsByPkg at: u pkgId put: list
  ]
  enums forEach: [e ->
    listMaybe = enumsByPkg at: e pkgId
    list::mut List::IrEnumDef = | listMaybe
      | null => {}!
      |=> listMaybe
    list add: e
    enumsByPkg at: e pkgId put: list
  ]
  functionsWithInst forEach: [f ->
    listMaybe = functionsByPkg at: f pkgId
    list::mut List::IrFunction = | listMaybe
      | null => {}!
      |=> listMaybe
    list add: f
    functionsByPkg at: f pkgId put: list
  ]

  packagesIr::mut List::IrPackage = {}!
  // preserve per-pkg imports and membership
  fileToStatements forEach: [file, statements ->
    pkgMaybe = packages at: file
    pkg = pkgMaybe expect: "Missing IR package $file"
    pkgImports = (pkg imports toList map: [IrImport name: it kind: IrImportKind.Local]) +
      (pkg packageImports toList map: [IrImport name: it kind: IrImportKind.Package])

    typesMaybe = typesByPkg at: file
    typesList::List(IrTypeDef) = | typesMaybe | null => {} |=> typesMaybe toList
    unionsMaybe = unionsByPkg at: file
    unionsList::List(IrUnionDef) = | unionsMaybe | null => {} |=> unionsMaybe toList
    enumsMaybe = enumsByPkg at: file
    enumsList::List(IrEnumDef) = | enumsMaybe | null => {} |=> enumsMaybe toList
    functionsMaybe = functionsByPkg at: file
    functionsList::List(IrFunction) = | functionsMaybe | null => {} |=> functionsMaybe toList

    packagesIr add: (IrPackage
      name: file
      imports: pkgImports
      dependencies: {}
      types: typesList
      unions: unionsList
      enums: enumsList
      stateDefs: (file == entryPointName ifTrue: [stateDefs toList] ifFalse: [{}])
      functions: functionsList)
  ]

  rawModule = IrModule
      version: "nir/v0"
      pkg: entryPointName
      packages: packagesIr toList
      entry: entryBlock

  // dependencies are computed from the original call graph then `^=` methods
  // are expanded at their call sites
  (rawModule withNormalizedDependencies) inlineExpandModule
]

ResolverHelper toIrModule -> IrModule =
  this toIrModuleUncheckedFromEntryLine: 0, validateNoDependencyCycles

ResolverHelper toIrModuleForGo -> IrModule =
  this toIrModuleUncheckedFromEntryLine: 0

ResolverHelper toIrModuleFromEntryLine(startLine): Int -> IrModule =
  this toIrModuleUncheckedFromEntryLine: startLine, validateNoDependencyCycles
