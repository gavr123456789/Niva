type System

constructor System currentTimeMillis -> Long =
  Bind imports: #("time") emit: "time.Now().UnixMilli()"

constructor System nanoTime -> Long =
  Bind imports: #("time") emit: "time.Now().UnixNano()"

constructor System currentDir -> String =
  Bind imports: #("os") emit: """(func() string { dir, err := os.Getwd(); if err != nil { panic(err) }; return dir })()"""

constructor System exitWith::Int -> Unit =
  Bind imports: #("os") emit: """(func() core.Unit { os.Exit($0); return core.UnitInstance })()"""
