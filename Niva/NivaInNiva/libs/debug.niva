/// `x debug` will print "x = 42"
String debug -> String = [
  codePlace = "COMPILE TIME REFLECTION TODO"

  codePlace cyan + " COMPILE TIME REFLECTION TODO = $this", echo
  ^ this
]

T log -> T = [
  codePlace = "COMPILE TIME REFLECTION TODO"
  codePlace red + " " + (this toString), echo
  ^ this
]
