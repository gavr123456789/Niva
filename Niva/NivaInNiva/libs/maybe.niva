T? orElse(dflt): T -> T = [
  | this
  | null => dflt
  |=> this
]

T? expect(msg): String -> T = [
  | this
  | null => TO DO: msg
  |=> this
]

T? ifNotNull(action): [T -> Unit] -> Unit = [
  | this
  | null => ()
  |=> action value: this
]

T? ifSome(action): [T -> Bool] -> Bool =
  | this
  | null => false
  |=> action value: this
