type ArgParser
type ArgsParsed
  path: String?
  option: CompilerOption
  backend: CompilerBackend
  // flags
  verbose: Bool
  debug: Bool
  repl: Bool
  replLine: Int
  nativeBuild: Bool

constructor ArgsParsed help = ArgsParsed path: null option: CompilerOption.Help backend: CompilerBackend.Js verbose: false debug: false repl: false replLine: 0 nativeBuild: false

/// prints help if its explicit
/// if there a mistake in args, returns Help flag
constructor ArgParser args::List(String) -> ArgsParsed = [
  help = """
      Usage:
        niva — compile and run main.niva
        niva run [FILE] [OPTIONS]
        niva build [FILE] [OPTIONS]
        niva ir [FILE] [OPTIONS]
        niva info — print packages, types, fields, and methods as Markdown
        niva info PACKAGE.TYPE — print information about one type

      FILE defaults to main.niva.

      Options:
        --backend=go|js|clj|lsp — select backend (default: clj)
        --debug — include Niva stack traces in the Clojure backend
        --repl — emit a loadable Clojure REPL module without -main (build + Clojure only)
        --repl-line=N — emit entry expressions starting at source line N
        --native — compile a Clojure build to a native executable with GraalVM native-image
        --verbose
        --help
    """ trimIndent

  command = args isEmpty ifTrue: ["run"] ifFalse: [args first]
  command == "--help" ifTrue: [
    help echo
    ^ ArgsParsed help
  ]

  option = | command
    | "run" => CompilerOption.Run
    | "build" => CompilerOption.Build
    | "ir" => CompilerOption.Ir
    | "info" => CompilerOption.Info
    |=> CompilerOption.Help

  option == CompilerOption.Help ifTrue: [
    "$command arg is unknown" echo
    ^ ArgsParsed help
  ]

  mut verbose = false
  mut debug = false
  mut repl = false
  mut replLine = 0
  mut nativeBuild = false
  mut backend = CompilerBackend.Clj
  mut path::String? = null
  mut optionStart = 1
  mut invalid = false
  mut explicitHelp = false

  args count > 1 ifTrue: [
    second = args at: 1
    second startsWith: "--", ifFalse: [
      path <- second
      optionStart <- 2
    ]
  ]

  args forEachIndexed: [i, arg ->
    i >= optionStart ifTrue: [
        | arg
        | "--verbose" => verbose <- true
        | "--debug" => debug <- true
        | "--repl" => repl <- true
        | "--native" => nativeBuild <- true
        | "--help" => explicitHelp <- true
        |=> [
          arg startsWith: "--backend=", ifTrue: [
            backendValue = arg substringAfter: "="
            | backendValue
            | "go" => backend <- CompilerBackend.Go
            | "js" => backend <- CompilerBackend.Js
            | "clj" | "clojure" => backend <- CompilerBackend.Clj
            | "lsp" => backend <- CompilerBackend.Lsp
            |=> invalid <- true
          ] ifFalse: [
            arg startsWith: "--repl-line=",
              ifTrue: [replLine <- (arg substringAfter: "=") toInt]
              ifFalse: [invalid <- true]
          ]
        ]
    ]
  ]

  explicitHelp ifTrue: [help echo; ^ ArgsParsed help]
  invalid ifTrue: [^ ArgsParsed help]
  ^ ArgsParsed :path :option :backend :verbose :debug :repl replLine: replLine nativeBuild: nativeBuild
]

enum CompilerOption = Run | Build | Ir | Daemon | RunTests | Info | Help
enum CompilerBackend = Go | Js | Clj | Lsp
