Test cliArgs = [
  args = {"run" "--verbose"} toList
  result = ArgParser args: args
  Assert that: (result option) equals: CompilerOption.Run
  Assert that: (result verbose) equals: true
  Assert that: result backend equals: CompilerBackend.Js
]


Test cliArgsHelp = [
  args = {"--help"} toList
  result = ArgParser args: args
  Assert that: result option equals: CompilerOption.Help
]

Test cliArgsRunGoBackend = [
  args = {"run" ".niva_go/testss.niva" "--backend" "go"} toList
  result = ArgParser args: args
  Assert that: result option equals: CompilerOption.Run
  Assert that: result path equals: ".niva_go/testss.niva"
  Assert that: result backend equals: CompilerBackend.Go
]

Test cliArgsReplEmission = [
  args = {"build" "main.niva" "--backend" "clojure" "--repl" "--repl-line" "7"} toList
  result = ArgParser args: args
  Assert that: result option equals: CompilerOption.Build
  Assert that: result backend equals: CompilerBackend.Clj
  Assert that: result repl equals: true
  Assert that: result replLine equals: 7
]

Test cliArgsNativeCljBuild = [
  args = {"build" "main.niva" "--backend" "clj" "--native"} toList
  result = ArgParser args: args
  Assert that: result option equals: CompilerOption.Build
  Assert that: result backend equals: CompilerBackend.Clj
  Assert that: result nativeBuild equals: true
]

Test cliArgsInfoTypePath = [
  result = ArgParser args: {"info" "main.Person"} toList
  Assert that: result option equals: CompilerOption.Info
  Assert that: result path equals: "main.Person"
]
