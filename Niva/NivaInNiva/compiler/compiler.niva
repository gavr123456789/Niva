/// takes main/entry file and collects all the files for compilation
type NivaBuildSystem

String nivaModuleIdFromRelativePath -> String = [
  normalized = this replace: "\\" with: "/"
  fileName = normalized substringAfterLast: "/"
  withoutKotlinSuffix = (fileName endsWith: ".kotlin.bind.niva")
    ifTrue: [(normalized substringBeforeLast: ".kotlin.bind.niva") + ".bind.niva"]
    ifFalse: [normalized]
  withoutPlatformSuffix = (fileName endsWith: ".go.bind.niva")
    ifTrue: [(normalized substringBeforeLast: ".go.bind.niva") + ".bind.niva"]
    ifFalse: [withoutKotlinSuffix]
  modulePath = withoutPlatformSuffix dropLast: ".niva" count
  ^ modulePath replace: "/" with: "."
]

String nivaModuleCollisionKey -> String =
  this lowercase, replace: "-" with: "_"

String isHiddenPath -> Bool = [
  segments = this replace: "\\" with: "/", split: "/"
  directories = segments dropLast: 1
  directories any: [it startsWith: "."]
]

String isTestSource -> Bool = [
  normalized = (this replace: "\\" with: "/") lowercase
  fileName = normalized substringAfterLast: "/"
  inTestsDirectory = normalized contains: "/tests/"
  namedTest = (fileName endsWith: "test.niva") || (fileName endsWith: "tests.niva")
  inTestsDirectory || namedTest
]

NivaSourceFile nivaModuleId -> String =
  relativePath nivaModuleIdFromRelativePath

String nivaFileName -> String =
  (this replace: "\\" with: "/") substringAfterLast: "/"

String nivaCommonSource -> Bool = [
  fileName = this nivaFileName
  isBinding = (fileName endsWith: ".bind.niva")
  (fileName endsWith: ".niva") && (isBinding not)
]

String isBindingFile -> Bool =
  (this nivaFileName) endsWith: ".bind.niva"

List(NivaSourceInput) nivaInputCollisionError -> String? = [
  seen::mut Map(String, String) = #{}!
  mut collisionError::String? = null
  this sortedBy: [it relativePath], forEach: [source ->
    collisionKey = source moduleId nivaModuleCollisionKey
    existingPath = seen at: collisionKey
    | existingPath
    | null => [seen at: collisionKey put: source relativePath]
    |=> [
      existingPath != source relativePath ifTrue: [
        collisionError <- "Niva module id collision: `" + existingPath + "` and `" +
          source relativePath + "` both normalize to `" + collisionKey + "`"
      ]
    ]
  ]
  ^ collisionError
]

type NivaBindingProvider
  backend: String
  moduleId: String
  relativePath: String

String toNivaBindingProvider -> NivaBindingProvider = [
  fields = this split: "|"
  fields count == 3 ifFalse: [
    TO DO: "invalid niva.bindings row: " + this
    NivaBindingProvider backend: "" moduleId: "" relativePath: ""
  ]
  NivaBindingProvider backend: (fields at: 0) moduleId: (fields at: 1) relativePath: (fields at: 2)
]

String parseNivaBindingManifest -> List(NivaBindingProvider) = [
  providers::mut List(NivaBindingProvider) = {}!
  (this split: "\n") forEach: [line ->
    trimmed = line
    trimmed isEmpty ifFalse: [providers add: (trimmed toNivaBindingProvider)]
  ]
  ^ providers toList
]

type NivaBindingInterface
  backend: String
  moduleId: String
  relativePath: String
  signature: String

NivaBindingProvider bindingInterface(files): List(NivaSourceFile) withIO(io): IO_Container -> NivaBindingInterface = [
  sourceMaybe = files find: [it relativePath == relativePath]
  | sourceMaybe
  | null => TO DO: "binding manifest source not found: " + relativePath
  |=> [
    source = sourceMaybe
    content = io readFile path: source path
    sourceFile = SourceFile path: source path
    tokens = Lexer get-tokens: content file: sourceFile
    parsed = Parser newParseTokens: tokens
    statements = parsed statements
    signatures = statements map: [it interfaceCanonical],
                            filter: [it isNotEmpty],
                            sortedBy: [it]
    NivaBindingInterface :backend :moduleId :relativePath
      signature: (signatures joinWith: "\n")
  ]
]

constructor NivaBuildSystem [
    on findAllFilesFrom(path): String? withIO(io): IO_Container backend: String -> List(NivaSourceInput) = [
        bindingMismatch = NivaBuildSystem bindingInterfaceMismatch: path withIO: io
        bindingMismatch ifNotNull: [mismatch -> TO DO: mismatch]

        // path is to main.niva, need to get its paret to start search
        p = | path
            | null => io currentDir
            |=> io getParent :path

        walkedFiles = io walkDir path: p,
            filter: [
              (it relativePath endsWith: ".niva") &&
                ((it relativePath isTestSource) not)
            ],
            sortedBy: [it relativePath]

        manifestPath = p + "/niva.bindings"
        hasBindingManifest = (io exists path: manifestPath)
        providers = hasBindingManifest
          ifTrue: [(io readFile path: manifestPath) parseNivaBindingManifest]
          ifFalse: [{}]
        providerPaths = (providers map: [it relativePath]) toSet

        walkedFiles forEach: [source ->
          ((source relativePath isHiddenPath) not) &&
            (source relativePath isBindingFile) &&
            ((providerPaths contains: source relativePath) not) ifTrue: [
            ("Skipping binding file without a provider in niva.bindings: " +
              source relativePath) echo
            ()
          ]
        ]

        files = walkedFiles filter: [source ->
          isVisible = (source relativePath isHiddenPath) not
          isListedProvider = providerPaths contains: source relativePath
          isVisible && (isListedProvider not) && (source relativePath nivaCommonSource)
        ]

        sources::mut List(NivaSourceInput) = {}!
        files forEach: [source ->
            content = io readFile path: source path
            sources add: (NivaSourceInput
              moduleId: source nivaModuleId
              relativePath: source relativePath
              path: source path
              :content)
        ]

        (providers filter: [it backend == backend]) forEach: [provider ->
          selectedFile = walkedFiles find: [it relativePath == provider relativePath]
          selectedFileMaybe = selectedFile
          | selectedFileMaybe
          | null => [TO DO: "binding manifest source not found: " + provider relativePath
            ()
          ]
          |=> [
            sources add: (NivaSourceInput
              moduleId: provider moduleId
              relativePath: selectedFileMaybe relativePath
              path: selectedFileMaybe path
              content: (io readFile path: selectedFileMaybe path))
            ()
          ]
        ]

        collisionError = sources nivaInputCollisionError
        | collisionError
        | null => []
        |=> [TO DO: collisionError
          ()
        ]

        sources toList
    ]

    on bindingInterfaceMismatch(path): String? withIO(io): IO_Container -> String? = [
        root = | path
               | null => io currentDir
               |=> io getParent :path
        manifestPath = root + "/niva.bindings"
        (io exists path: manifestPath) ifFalse: [^ null]

        providers = (io readFile path: manifestPath) parseNivaBindingManifest
        files = io walkDir path: root,
          filter: [
            (it relativePath endsWith: ".niva") &&
              ((it relativePath isTestSource) not)
          ],
          sortedBy: [it relativePath]

        groups::mut Map(String, mut List::NivaBindingProvider) = #{}!
        providers forEach: [provider ->
          existingMaybe = groups at: provider moduleId
          mut group::mut List::NivaBindingProvider = {}!
          | existingMaybe
          | null => ()
          |=> group <- existingMaybe
          group add: provider
          groups at: provider moduleId put: group
        ]

        mut mismatch::String? = null
        groups forEach: [moduleId, variants ->
          backends = (variants map: [it backend]) toSet
          backends count > 1 ifTrue: [
            baseline = (variants first) bindingInterface: files withIO: io
            (variants drop: 1) forEach: [provider ->
              provider backend != baseline backend ifTrue: [
                candidate = provider bindingInterface: files withIO: io
                ((mismatch == null) && (candidate signature != baseline signature)) ifTrue: [
                  mismatch <- "binding interface mismatch for " + moduleId +
                    " between " + baseline backend + " (" + baseline relativePath +
                    ") and " + candidate backend + " (" + candidate relativePath + ")\n" +
                    baseline signature + "\n---\n" + candidate signature
                ]
              ]
            ]
          ]
        ]
        mismatch
    ]
]


/// takes fileNames to Content
type NivaCompiler

// the dependency files are niva-owned: write them when missing and overwrite
// them while they still hold a generated variant (so switching between run and
// watch refreshes them), but keep any user edits untouched
IO_Container cljDepsFileNeedsWrite(file): String -> Bool = [
  (this exists path: file) ifFalse: [true] ifTrue: [
    existing = this readFile path: file
    (existing == (CompilerConstants cljProjectDepsSource)) ||
      (existing == (CompilerConstants cljPlainDepsSource))
  ]
]

IO_Container ensureCljProjectAt(root): String hotReload: Bool -> Unit = [
  this createDirectories path: (root + "/niva")
  depsContent = hotReload
    ifTrue: [CompilerConstants cljProjectDepsSource]
    ifFalse: [CompilerConstants cljPlainDepsSource]
  (this cljDepsFileNeedsWrite: root + "/bb.edn") ifTrue: [
    this writeFile file: root + "/bb.edn" content: depsContent
  ]
  (this cljDepsFileNeedsWrite: root + "/deps.edn") ifTrue: [
    this writeFile file: root + "/deps.edn" content: depsContent
  ]
  .exists path: (root + "/niva/core.clj"),
    ifFalse: [.writeFile file: root + "/niva/core.clj" content: (CompilerConstants nivaCoreSource)]
  hotReload
    ifTrue: [.createDirectories path: root + "/niva/hot_reload"
             .writeFile file: root + "/niva/hot_reload/host.clj" content: (CompilerConstants jvmHostSource)]
]

IO_Container initializeGoProjectAt(root): String -> Unit = [
  this deleteRecursively path: root
  this createDirectories path: root + "/core"
  this writeFile file: root + "/go.mod" content: (GoRuntimeSources moduleSource)
  this writeFile file: root + "/core/core.go" content: (GoRuntimeSources coreSource)
  ()
]

type WatchChangeBatch
  paths: Set(String)

constructor WatchChangeBatch empty -> WatchChangeBatch = WatchChangeBatch paths: #()!

WatchChangeBatch add(path): String -> WatchChangeBatch = [
  updated::mut Set(String) = paths toMutableSet
  updated add: path
  WatchChangeBatch paths: updated
]

WatchChangeBatch count -> Int = paths count

type WatchQueueState
  building: Bool
  pending: Bool

type JvmReloadHost

constructor WatchQueueState empty -> WatchQueueState =
  WatchQueueState building: false pending: false

WatchQueueState event -> WatchQueueState =
  | true
  | building => WatchQueueState building: true pending: true
  |=> WatchQueueState building: true pending: false

WatchQueueState buildFinished -> WatchQueueState =
  | true
  | pending => WatchQueueState building: true pending: false
  |=> WatchQueueState building: false pending: false

type CljGenerationResult
  generationId: String
  published: Bool
  generatedRoot: String
  manifestPath: String

constructor CljGenerationResult notPublished -> CljGenerationResult =
  CljGenerationResult generationId: "" published: false generatedRoot: "" manifestPath: ""

CljOutput publishTo(root): String withIO(io): IO_Container hotReload: Bool -> CljGenerationResult = [
  generationId = (System currentTimeMillis toString) + "-" + (System nanoTime toString)
  stagingRoot = root + "/staging/" + generationId
  stagingGenerated = stagingRoot + "/generated"
  backupGenerated = stagingRoot + "/previous-generated"
  publishedGenerated = root + "/generated"
  stagingManifest = stagingRoot + "/manifest.edn"
  stagingShim = stagingRoot + "/main.clj"
  stagingDeps = stagingRoot + "/deps.edn"
  stagingBbDeps = stagingRoot + "/bb.edn"
  publishedDeps = root + "/deps.edn"
  publishedBbDeps = root + "/bb.edn"
  legacyGenerated = root + "/niva/generated"
  hostPath = root + "/niva/hot_reload/host.clj"

  io createDirectories path: stagingGenerated
  files forEach: [relativePath, content ->
    destination = stagingGenerated + "/" + relativePath
    io createDirectories path: (io getParent path: destination)
    io writeFile file: destination :content
  ]

  io writeFile file: stagingManifest content: manifest edn
  io writeFile file: stagingShim content: this legacyMainShim
  depsContent = hotReload
    ifTrue: [CompilerConstants cljProjectDepsSource]
    ifFalse: [CompilerConstants cljPlainDepsSource]
  needsPublishedDeps = io cljDepsFileNeedsWrite: publishedDeps
  needsPublishedBbDeps = io cljDepsFileNeedsWrite: publishedBbDeps
  needsPublishedDeps ifTrue: [
    io writeFile file: stagingDeps content: depsContent
  ]
  needsPublishedBbDeps ifTrue: [
    io writeFile file: stagingBbDeps content: depsContent
  ]

  // publish only fully written staging content
  hadPublishedGenerated = (io exists path: publishedGenerated)
  hadPublishedGenerated ifTrue: [
    io moveFrom from: publishedGenerated to: backupGenerated
  ]
  io moveFrom from: stagingGenerated to: publishedGenerated
  io moveFrom from: stagingManifest to: root + "/manifest.edn"
  io moveFrom from: stagingShim to: root + "/main.clj"
  needsPublishedDeps ifTrue: [
    io moveFrom from: stagingDeps to: publishedDeps
  ]
  needsPublishedBbDeps ifTrue: [
    io moveFrom from: stagingBbDeps to: publishedBbDeps
  ]
  hadPublishedGenerated ifTrue: [
    io deleteRecursively path: backupGenerated
  ]
  hadLegacyGenerated = (io exists path: legacyGenerated)
  hadLegacyGenerated ifTrue: [
    io deleteRecursively path: legacyGenerated
  ]
  hotReloadDir = root + "/niva/hot_reload"
  hotReload ifTrue: [
    io createDirectories path: (io getParent path: hostPath)
    io writeFile file: hostPath content: (CompilerConstants jvmHostSource)
  ] ifFalse: [
    (io exists path: hotReloadDir) ifTrue: [
      io deleteRecursively path: hotReloadDir
    ]
  ]
  io deleteRecursively path: stagingRoot

  CljGenerationResult :generationId published: true
    generatedRoot: publishedGenerated manifestPath: root + "/manifest.edn"
]

constructor NivaCompiler [
    on runArgs: List(String) withIO: IO_Container = [
      NivaCompiler :runArgs :withIO measureTime: false
      ()
    ]
    on runArgs(args): List(String) withIO(io): IO_Container measureTime: Bool = [ // enable time
        t1 = System currentTimeMillis

        measureTimeFrom = [from: Long, text: String ->
                            measureTime ifTrue: [
                                            now = System currentTimeMillis
                                            time = text + ": " + (now - from) toString
                                            time debug
                                            now]
                                        ifFalse: [0 toLong]]



        argsParsed = ArgParser :args
        {option path backend runtime target debug repl replLine nativeBuild} = argsParsed
        cljTarget = target == CompilerTarget.Bb
          ifTrue: [CljTarget.Bb]
          ifFalse: [CljTarget.Jvm]
        // the Go backend runs either as a native binary (go) or interpreted (ixgo)
        goInterprets = target == CompilerTarget.Ixgo

        nativeBuild ifTrue: [
          ((option != CompilerOption.Build) || (backend != CompilerBackend.Clj)) ifTrue: [
            TO DO: "--native is only supported for Clojure builds"
            ()
          ]
          repl ifTrue: [TO DO: "--native cannot be combined with --repl"
            ()
          ]
          target == CompilerTarget.Bb ifTrue: [
            TO DO: "--native requires --target jvm"
            ()
          ]
        ]

        option == CompilerOption.Watch ifTrue: [
          backend != CompilerBackend.Clj
            ifTrue: [TO DO: "watch is only supported for the Clojure backend"]
          repl && (runtime != CompilerRuntime.Jvm)
            ifTrue: [TO DO: "--repl requires --runtime=jvm"]
        ]


        realIrPath = io currentDir + "/.niva_ir"
        realGoPath = io currentDir + "/.niva_go/build"
        realCljPath = io currentDir + "/.niva_clj"

        generateIrFromResolver = [res::ResolverHelper ->
            io createDirectories path: realIrPath
            irModule = res toIrModule
            irContent = irModule toDebugString
            destanation = realIrPath + "/" + (res entryPointName) + ".nir"
            io writeFile file: destanation content: irContent
        ]

        generateGoFromResolver = [res::ResolverHelper ->
            irModule = res toIrModuleForGo
            goContent = GoBackend fullFromIrModule: irModule
            io initializeGoProjectAt: realGoPath
            destanation = realGoPath + "/main.go"
            io writeFile file: destanation content: goContent
        ]

        buildGoProject = [
          buildResult = io runProgramFromPath path: realGoPath
            args: {"go" "build" "-o" "niva_go" "."}
          buildResult != 0 ifTrue: [
            TO DO: "Go build failed"
            ()
          ]
        ]

        generateCljFromResolver = [res: ResolverHelper ->
            io ensureCljProjectAt: realCljPath hotReload: false
            io createDirectories path: realCljPath
            irModule = repl
              ifTrue:  [res toIrModuleFromEntryLine: replLine]
              ifFalse: [res toIrModule]
            mode = repl ifTrue: [CljEmitMode.Repl] ifFalse: [CljEmitMode.Program]
            repl ifTrue: [
              cljContent = CljBackend fullFromIrModule: irModule :debug :mode
              io writeFile file: realCljPath + "/main.clj" content: cljContent
            ] ifFalse: [
              output = CljBackend fullOutputFromIrModuleForTarget: irModule
                :debug :mode target: cljTarget
              output publishTo: realCljPath withIO: io hotReload: false
              ()
            ]
        ]

        backendStr = backend == CompilerBackend.Go ifTrue: ["go"] ifFalse: [
          backend == CompilerBackend.Clj ifTrue: ["clj"] ifFalse: [
            TO DO: "no lsp binary"
            "lsp"
          ]
        ]

        // for `info package.Type`, we always start from main
        // path arg in info mode is PKG.TYPE
        rootFile = option == CompilerOption.Info
          ifTrue: ["main.niva"]
          ifFalse: [
            pathMaybe = path
            pathMaybe orElse: "main.niva"
          ]
        rootPath = rootFile toPath
        entryPoint = rootPath name substringBeforeLast: "."
        //t2 = measureTimeFrom from: t1 text: "arg-parsed"

        runOrBuild = [

          sources = NivaBuildSystem findAllFilesFrom: path withIO: io backend: backendStr
          //t3 = measureTimeFrom from: t2 text: "collect-files"

          resolver = ResolverHelper resolveSources: sources :entryPoint backend: backendStr
          resolverErrors = (resolver db listOfErrors) + (resolver db nonInlineReturnErrors values toList)
          allResolverErrors = resolverErrors
          allResolverErrors isNotEmpty ifTrue: [
            resolver_errors = allResolverErrors joinWith: "\n" transform: [ it toConsoleMsg ]
            TO DO: "Resolver errors: " + resolver_errors
            System exitWith: 1
            ()
          ]

          resolver
        ]

        runWatch = [
          watchPathMaybe = path
          rootFile = watchPathMaybe orElse: "main.niva"
          projectRoot = io getParent path: rootFile
          rootPath = rootFile toPath
          entryPoint = rootPath name substringBeforeLast: "."
          watchRuntime = runtime == CompilerRuntime.Bb ifTrue: ["bb"] ifFalse: ["jvm"]
          config = CompilerConfigFingerprint
            compilerVersion: "nin-watch" irSchema: "nir/v0" backend: "clj"
            target: watchRuntime abiOptions: "" hotReload: true coreAbiHash: ""
          mut session = CompilerSession empty
          mut replSession = CompilerSession empty
          mut replHistory = ""
          mut pendingHistory = ""
          mut pendingResult::CompilerCompilationResult? = null
          mut requestVersion = 0
          mut entryNamespace = repl
            ifTrue: [CompilerConstants cljReplNamespace]
            ifFalse: ["niva.generated." + entryPoint]

          compileRepl = [code: String ->
            requestVersion <- requestVersion + 1
            sources = NivaBuildSystem findAllFilesFrom: watchPathMaybe withIO: io backend: "clj"
            entrySourceMaybe = sources find: [it moduleId == entryPoint]
            entrySource = entrySourceMaybe expect: "REPL entry source is missing"
            prefix = entrySource content + "\n" + replHistory
            startLine = (prefix split: "\n") count
            combined = prefix + code + "\n"
            replSources = sources map: [source ->
              source moduleId == entryPoint
                ifTrue: [NivaSourceInput moduleId: source moduleId relativePath: source relativePath
                                             path: source path          content: combined]
                ifFalse: [source]
            ]
            snapshot = WorkspaceSnapshot fromSources: replSources revision: requestVersion
                                         :entryPoint              documentVersions: #{}
            result = replSession compileSnapshot: snapshot :config
                                 :requestVersion cancelled: false incremental: true
            result commitReady
              ifFalse: ["error\n" + (result diagnostics joinWith: "\n" transform: [it message])]
              ifTrue: [
                candidate = result candidate expect: "REPL compilation has no candidate"
                ir = candidate irModule fromEntryLine: startLine
                clj = CljBackend fullFromIrModule: ir :debug mode: CljEmitMode.Repl
                tokens = Lexer get-tokens: code file: (SourceFile path: rootFile)
                parsed = Parser newParseTokens: tokens
                keepsContext = parsed statements any: [statement ->
                  | statement
                  | VarDeclaration | DestructingAssign | TypeDecl | EnumDecl | UnionDecl | ExtendDecl | MessageDecl => true
                  |=> false
                ]
                pendingHistory <- keepsContext ifTrue: [replHistory + code + "\n"] ifFalse: [replHistory]
                pendingResult <- result
                "ok\n" + clj
              ]
          ]

          compileAndPublish = [
            mut publishedOk = false
            requestVersion <- requestVersion + 1
            sources = NivaBuildSystem findAllFilesFrom: watchPathMaybe withIO: io backend: "clj"
            snapshot = WorkspaceSnapshot fromSources: sources revision: requestVersion
              :entryPoint documentVersions: #{}
            result = session compileSnapshot: snapshot :config
              :requestVersion cancelled: false incremental: true
            result commitReady ifFalse: [
              result diagnostics forEach: [diagnostic ->
                (diagnostic path + ": " + diagnostic message) echo
                ()
              ]
            ] ifTrue: [
              artifactMaybe = result backendArtifact
              artifact = | artifactMaybe
                | null => [
                  TO DO: "Clj build completed without a backend artifact"
                  CompilerBackendArtifact
                    backend: "clj" target: watchRuntime content: "" cljOutput: null
                ]
                |=> artifactMaybe
              cljOutputMaybe = artifact cljOutput
              cljOutput = | cljOutputMaybe
                | null => [
                  TO DO: "Clj backend artifact has no output"
                  CljOutput
                    files: #{}!
                    entryNamespace: ""
                    manifest: (CljManifest
                      version: 0 entryNamespace: "" modules: {} stateVars: {} typeShapes: {})
                    target: CljTarget.Jvm
                ]
                |=> cljOutputMaybe
              output = repl ifTrue: [
                candidate = result candidate expect: "REPL compilation has no candidate"
                clj = CljBackend fullFromIrModule: candidate irModule :debug mode: CljEmitMode.ReplWatch
                manifest = cljOutput manifest
                modules = manifest modules map: [module ->
                  CljModuleManifest moduleId: module moduleId file: "niva/repl/session.clj" deps: module deps
                ]
                CljOutput files: #{"niva/repl/session.clj" clj}
                  entryNamespace: (CompilerConstants cljReplNamespace)
                  manifest: (CljManifest version: manifest version
                    entryNamespace: (CompilerConstants cljReplNamespace)
                    :modules stateVars: manifest stateVars typeShapes: manifest typeShapes)
                  target: CljTarget.Jvm
              ] ifFalse: [cljOutput]
              entryNamespace <- output entryNamespace
              published = output publishTo: realCljPath withIO: io hotReload: true
              published published ifTrue: [
                session <- session commitResult: result incremental: true
                repl && (replSession revision == 0) && (pendingResult == null),
                  ifTrue: [replSession <- session]
                publishedOk <- true
              ]
            ]
            publishedOk
          ]

          io ensureCljProjectAt: realCljPath hotReload: true
          mut initialReady = false
          JvmReloadHost runProtected: [initialReady <- compileAndPublish do]
          JvmReloadHost start: projectRoot generatedDir: realCljPath + "/generated"
            :entryNamespace runtime: watchRuntime :repl :initialReady onChange: [
              JvmReloadHost runProtected: [
                changed = compileAndPublish do
                changed ifTrue: [io writeFile file: realCljPath + "/niva-reload.signal"
                                              content: (System nanoTime toString)]
              ]
            ] onTick: [
              JvmReloadHost runProtected: [
                ackPath = realCljPath + "/repl-ack"
                requestPath = realCljPath + "/repl-request"
                responsePath = realCljPath + "/repl-response"
                (io exists path: ackPath) ifTrue: [
                  ack = io readFile path: ackPath
                  io delete path: ackPath
                  ready = pendingResult
                  (ack == "ok") && (ready != null) ifTrue: [
                    ready ifNotNull: [result -> replSession <- replSession commitResult: result incremental: true]
                    replHistory <- pendingHistory
                  ]
                  pendingResult <- null
                ]
                (io exists path: requestPath) ifTrue: [
                  code = io readFile path: requestPath
                  io delete path: requestPath
                  response = JvmReloadHost captureError: [compileRepl code: code]
                  tempPath = responsePath + ".tmp"
                  io writeFile file: tempPath content: response
                  io moveFrom from: tempPath to: responsePath
                ]
              ]
              ()
            ]
          ()
        ]

        option == CompilerOption.Watch ifTrue: [
          runWatch do
          ()
        ]
        ((option == CompilerOption.Run) || (option == CompilerOption.Build)) ifTrue: [
            t3 = System currentTimeMillis

            resolver = runOrBuild do
            //t4 = measureTimeFrom from: t3 text: "resolve"

            backend == CompilerBackend.Go ifTrue: [
                generateGoFromResolver res: resolver
                t5 = measureTimeFrom from: t1 text: "full niva until go generated"

                option == CompilerOption.Run ifTrue: [
                  goInterprets
                    ifTrue: [
                      // ixgo interprets the generated Go source directly
                      runResult = io runProgramFromPath path: realGoPath args: {"ixgo" "run" "."}
                      System exitWith: runResult
                    ]
                    ifFalse: [
                      buildGoProject do
                      t6 = measureTimeFrom from: t5 text: "go build"
                      binaryPath = realGoPath + "/niva_go"
                      runResult = io runProgram args: {binaryPath}
                      t7 = measureTimeFrom from: t6 text: "run binary"
                      System exitWith: runResult
                    ]
                ] ifFalse: [option == CompilerOption.Build ifTrue: [
                  goInterprets
                    ifTrue: [
                      io runProgramFromPath path: realGoPath args: {"ixgo" "build" "."}
                      ()
                    ]
                    ifFalse: [buildGoProject do]
                ]]
                ()
            ] ifFalse: [backend == CompilerBackend.Clj ifTrue: [
                t5 = measureTimeFrom from: t1 text: "full niva until IR"
                generateCljFromResolver res: resolver
                option == CompilerOption.Run ifTrue: [
                  t6 = measureTimeFrom from: t5 text: "IR + codegen"
                  generatedPath = realCljPath + "/generated"
                  // repl modules have no -main: load the emitted module into a
                  // fresh repl session instead of invoking the program entry
                  replNamespace = CompilerConstants cljReplNamespace
                  runtime == CompilerRuntime.Jvm ifTrue: [
                    cljRunArgs = repl
                      ifTrue: [{"clojure" "-M" "-i" "main.clj" "-e" ("(do (in-ns '" + replNamespace + ") nil)") "-r"}]
                      ifFalse: [{"clojure" "-M" "-m" "main"}]
                    io runProgramFromPath path: realCljPath args: cljRunArgs
                    ()
                  ] ifFalse: [
                    repl ifTrue: [
                      // babashka always opens its repl in `user`, so load the
                      // module and refer its vars into `user` via an init file
                      initPath = realCljPath + "/repl_init.clj"
                      initSource = "(load-file \"main.clj\")\n(refer '" + replNamespace + ")\n"
                      io writeFile file: initPath content: initSource
                      io runProgramFromPath path: realCljPath
                        args: {"bb" "-cp" (generatedPath + ":" + realCljPath) "--init" "repl_init.clj" "repl"}
                      ()
                    ] ifFalse: [
                      io runProgram args: {"bb" "-cp" (generatedPath + ":" + realCljPath) "-m" "main" }
                      ()
                    ]
                  ]

                  t7 = measureTimeFrom from: t6 text: "run binary"
                ]
                option == CompilerOption.Build ifTrue: [
                  // REPL builds intentionally only emit a loadable Clojure module.
                  repl ifFalse: [
                    nativeBuild ifTrue: [
                      nativeImageVersionResult = io runProgram args: {"sh" "-c" "native-image --version"}
                      nativeImageVersionResult != 0 ifTrue: [
                        TO DO: "native-image is not installed or unavailable in PATH"
                        ()
                      ]
                    ]

                    nativeBuild
                      ifTrue: [
                      // native-image needs JVM bytecode, while `bb uberjar` contains
                      // Babashka-loadable Clojure sources only. Use Babashka to invoke
                      // a small tools.build AOT build for the native-image input JAR.
                      nativeBuildScript = CompilerConstants nativeBuildSource
                      io writeFile file: realCljPath + "/build.clj" content: nativeBuildScript

                      nativeDeps = CompilerConstants cljNativeDepsSource
                      jarBuildResult = io runProgramFromPath path: realCljPath args: {"bb" "clojure" "-Sdeps" nativeDeps "-T:build" "native-jar"}
                      jarBuildResult != 0 ifTrue: [
                        TO DO: "Babashka failed to build the JVM main.jar"
                        ()
                      ]

                      nativeBuildResult = io runProgram args: {
                        "native-image"
                        "--initialize-at-build-time"
                        "-H:IncludeResources=.*\\.(clj|cljc|edn)$"
                        "-jar" "main.jar" "main"
                      }
                      nativeBuildResult != 0 ifTrue: [
                        TO DO: "native-image failed to build main"
                        ()
                      ]
                    ] ifFalse: [
                      buildResult = io runProgram args: {"bb" "-cp" realCljPath "uberjar" "main.jar" "-m" "main"}
                      buildResult != 0 ifTrue: [
                        TO DO: "Babashka failed to build main.jar"
                        ()
                      ]
                    ]
                  ]
                ]
                ()
            ] ifFalse: [()]]
            ()
        ]
        option == CompilerOption.Ir ifTrue: [
            resolver = runOrBuild do
            generateIrFromResolver res: resolver
            ()
        ]
        option == CompilerOption.Info ifTrue: [
            resolver = runOrBuild do
            pathMaybe = path
            info = | pathMaybe
              | null => resolver db structureInfo
              |=> resolver db structureInfoFor: pathMaybe
            info echo
            ()
        ]

    ]
]
