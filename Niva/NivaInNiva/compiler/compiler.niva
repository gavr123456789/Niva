/// takes main/entry file and collects all the files for compilation
type NivaBuildSystem

String nivaModuleIdFromRelativePath -> String =
  .replace: "\\" with: "/"
  ,dropLast: ".niva" count
  ,replace: "/" with: "."

String nivaModuleCollisionKey -> String =
  .lowercase, replace: "-" with: "_"

NivaSourceFile nivaModuleId -> String =
  relativePath nivaModuleIdFromRelativePath

List(NivaSourceFile) nivaModuleCollisionError -> String? = [
  seen::mut Map(String, String) = #{}!
  this sortedBy: [it relativePath], forEach: [source ->
    moduleId = source nivaModuleId
    collisionKey = moduleId nivaModuleCollisionKey
    existingPath = seen at: collisionKey
    | existingPath
    | null => [seen at: collisionKey put: source relativePath]
    |=> [
      existingPath != source relativePath ifTrue: [
        ^ "Niva module id collision: `" + existingPath + "` and `" +
          source relativePath + "` both normalize to `" + collisionKey + "`"
      ]
    ]
  ]
  ^ null
]

constructor NivaBuildSystem [
    on findAllFilesFrom(path): String? withIO(io): IO_Container -> List(NivaSourceInput) = [
        // path is to main.niva, need to get its paret to start search
        p = path unpack: [str -> io getParent path: str]
                 or: io currentDir

        files = io walkDir path: p,
            filter: [it relativePath endsWith: ".niva"],
            sortedBy: [it relativePath]

        files nivaModuleCollisionError unpack: [TO DO: it]

        sources::mut List(NivaSourceInput) = {}!
        files forEach: [source ->
            content = io readFile path: source path
            sources add: (NivaSourceInput
              moduleId: source nivaModuleId
              relativePath: source relativePath
              path: source path
              content: content)
        ]

        ^ sources toList
    ]
]


/// takes fileNames to Content
type NivaCompiler

static JVM_HOST_SOURCE = """
(ns niva.hot-reload.host
  (:require [clj-reload.core :as reload]))

(defonce runtime
  (atom {:initialized? false
         :initial-loaded? false
         :entry-executed? false
         :entry-namespace nil
         :watch-service nil
         :watch-stop nil}))

(defn- print-error! [prefix error]
  (binding [*out* *err*]
    (println prefix)
    (println (or (ex-message error) error))
    (when-let [trace (seq (.getStackTrace error))]
      (doseq [line (take 8 trace)]
        (println "  at" line)))))

(defn init! [generated-dir entry-namespace]
  (when-not (:initialized? @runtime)
    (reload/init
     {:dirs [generated-dir]
      :no-reload '#{niva.hot-reload.host}
      :output :quieter})
    (swap! runtime assoc
           :initialized? true
           :entry-namespace entry-namespace)))

(defn- invoke-entry! []
  (let [entry-symbol (symbol (:entry-namespace @runtime))
        entry-ns (or (find-ns entry-symbol)
                     (do (require entry-symbol) (find-ns entry-symbol)))
        entry-var (or (requiring-resolve
                       (symbol (:entry-namespace @runtime) "__niva_entry!"))
                      (and entry-ns (ns-resolve entry-ns '__niva_entry!)))]
    (when-not entry-var
      (throw (ex-info "generated entry hook is missing"
                      {:namespace entry-symbol})))
    (entry-var)
    (swap! runtime assoc :entry-executed? true)))

(defn initial-load! []
  (try
    (reload/reload {:only :all})
    (when-not (:entry-executed? @runtime)
      (invoke-entry!))
    (swap! runtime assoc :initial-loaded? true)
    {:ok true}
    (catch Throwable error
      (print-error! "Clojure initial load failed" error)
      {:ok false :error error})))

(defn reload-changed! []
  (try
    (reload/reload {:only :changed})
    (when-not (:entry-executed? @runtime)
      (invoke-entry!))
    (swap! runtime assoc :initial-loaded? true)
    {:ok true}
    (catch Throwable error
      (print-error! "Clojure reload failed" error)
      {:ok false :error error})))

(defn- java-class [name]
  (Class/forName name))

(defn- invoke-static-no-args [class-name method-name]
  (.invoke (.getMethod (java-class class-name) method-name (make-array Class 0))
           nil
           (object-array 0)))

(defn- enum-value [class-name value]
  (some #(when (= value (.name %)) %)
        (.getEnumConstants (java-class class-name))))

(defn- watch-kind [name]
  (.get (.getField (java-class "java.nio.file.StandardWatchEventKinds") name) nil))

(defn- project-directory? [^java.io.File file]
  (and (.isDirectory file)
       (not-any? #{".git" ".niva_clj" ".niva_cache" "build" "target"}
                 (map #(.getName %) (take-while some? (iterate #(.getParentFile %) file))))))

(defn- register-directory! [directory watch-service]
  (.register directory watch-service
             (into-array
                         [(watch-kind "ENTRY_CREATE")
                          (watch-kind "ENTRY_MODIFY")
                          (watch-kind "ENTRY_DELETE")])))

(defn- register-tree! [^java.io.File root watch-service]
  (doseq [file (file-seq root)
          :when (project-directory? file)]
    (register-directory! (.toPath file) watch-service)))

(defn- event-is-source? [event]
  (let [context (.context event)]
    (try
      (.endsWith (str context) ".niva")
      (catch Throwable _ false))))

(defn- drain-key! [key root watch-service]
  (let [events (.pollEvents key)]
    (doseq [event events]
      (when (= (watch-kind "ENTRY_CREATE") (.kind event))
        (let [child (.resolve (.watchable key) (.context event))]
          (when (.isDirectory (.toFile child))
            (register-tree! (.toFile child) watch-service)))))
    (boolean (some event-is-source? events))))

(defn- wait-for-debounced-batch! [watch-service first-key]
  (loop [source-event? (drain-key! first-key nil watch-service)]
    (if-let [next-key (.poll watch-service 150
                              (enum-value "java.util.concurrent.TimeUnit" "MILLISECONDS"))]
      (let [next-source? (drain-key! next-key nil watch-service)]
        (.reset next-key)
        (recur (or source-event? next-source?)))
      source-event?)))

(defn- watch-jvm! [project-root on-change]
  (let [watch-service (.newWatchService
                       (invoke-static-no-args "java.nio.file.FileSystems" "getDefault"))
        root-file (java.io.File. project-root)
        shutdown-hook (Thread. #(try (.close watch-service) (catch Throwable _)))]
    (swap! runtime assoc :watch-service watch-service)
    (.addShutdownHook (Runtime/getRuntime) shutdown-hook)
    (try
      (register-tree! root-file watch-service)
      (loop []
        (when-let [key (try (.take watch-service)
                            (catch Throwable _ nil))]
          (when (wait-for-debounced-batch! watch-service key)
            (try (on-change)
                 (catch Throwable error
                   (print-error! "watch build callback failed" error))))
          (.reset key)
          (recur)))
      (finally
        (swap! runtime assoc :watch-service nil)
        (try (.removeShutdownHook (Runtime/getRuntime) shutdown-hook) (catch Throwable _))
        (try (.close watch-service) (catch Throwable _))))))

(defn- bb-source-event? [event]
  (let [path (:path event)]
    (and path (.endsWith (str path) ".niva"))))

(defn- watch-bb! [project-root on-change]
  (let [load-pod (requiring-resolve 'babashka.pods/load-pod)
        _ (load-pod 'org.babashka/fswatcher "0.0.7")
        watch (requiring-resolve 'pod.babashka.fswatcher/watch)
        stopped (promise)
        callback-lock (Object.)
        stop! #(deliver stopped true)
        shutdown-hook (Thread. stop!)]
    (swap! runtime assoc :watch-stop stop!)
    (.addShutdownHook (Runtime/getRuntime) shutdown-hook)
    (try
      (watch project-root
        (fn [event]
          (when (bb-source-event? event)
            (locking callback-lock
              (try (on-change)
                   (catch Throwable error
                     (print-error! "watch build callback failed" error))))))
        {:delay-ms 200 :recursive true})
      (println "Watching...")
      @stopped
      (finally
        (swap! runtime assoc :watch-stop nil)
        (try (.removeShutdownHook (Runtime/getRuntime) shutdown-hook) (catch Throwable _))))))

(defn stop-watch! []
  (when-let [stop! (:watch-stop @runtime)]
    (stop!)))

(defn watch! [project-root on-change runtime-name]
  (if (= runtime-name "bb")
    (watch-bb! project-root on-change)
    (watch-jvm! project-root on-change)))

(defn start! [project-root generated-dir entry-namespace runtime-name on-change]
  (init! generated-dir entry-namespace)
  (initial-load!)
  (watch! project-root on-change runtime-name))
"""

type WatchChangeBatch
  paths: Set(String)

constructor WatchChangeBatch empty -> WatchChangeBatch = WatchChangeBatch paths: #()!

WatchChangeBatch add(path): String -> WatchChangeBatch = [
  updated = paths toMutableSet
  updated add: path
  ^ WatchChangeBatch paths: updated
]

WatchChangeBatch count -> Int = paths count

type WatchQueueState
  building: Bool
  pending: Bool

constructor WatchQueueState empty -> WatchQueueState =
  WatchQueueState building: false pending: false

WatchQueueState event -> WatchQueueState = [
  building ifTrue: [^ WatchQueueState building: true pending: true]
  ^ WatchQueueState building: true pending: false
]

WatchQueueState buildFinished -> WatchQueueState = [
  pending ifTrue: [^ WatchQueueState building: true pending: false]
  ^ WatchQueueState building: false pending: false
]

type JvmReloadHost

static JvmReloadHost start(projectRoot): String generatedDir: String
    entryNamespace(entryNamespace): String runtime(runtime): String
    onChange(onChange): [Unit -> Unit] -> Unit = []

static JvmReloadHost reloadChanged -> Unit = []

type CljGenerationResult
  generationId: String
  published: Bool
  generatedRoot: String
  manifestPath: String

constructor CljGenerationResult notPublished -> CljGenerationResult =
  CljGenerationResult generationId: "" published: false generatedRoot: "" manifestPath: ""

CljOutput publishTo(root): String withIO(io): IO_Container -> CljGenerationResult = [
  generationId = (System currentTimeMillis toString) + "-" + (System nanoTime toString)
  stagingRoot = root + "/staging/" + generationId
  stagingGenerated = stagingRoot + "/generated"
  backupGenerated = stagingRoot + "/previous-generated"
  publishedGenerated = root + "/generated"
  stagingManifest = stagingRoot + "/manifest.edn"
  stagingShim = stagingRoot + "/main.clj"
  stagingDeps = stagingRoot + "/deps.edn"
  stagingBbDeps = stagingRoot + "/bb.edn"
  legacyGenerated = root + "/niva/generated"
  hostPath = root + "/niva/hot_reload/host.clj"

  FileSystem createDirectories: stagingGenerated toPath
  files forEach: [relativePath, content ->
    destination = stagingGenerated + "/" + relativePath
    FileSystem createDirectories: (io getParent path: destination) toPath
    io writeFile file: destination content: content
  ]

  io writeFile file: stagingManifest content: manifest edn
  io writeFile file: stagingShim content: this legacyMainShim
  io writeFile file: stagingDeps content: "{:paths [\"generated\" \".\"] :deps {io.github.tonsky/clj-reload {:mvn/version \"1.0.0\"}}}\n"
  io writeFile file: stagingBbDeps content: "{:paths [\"generated\" \".\"] :deps {io.github.tonsky/clj-reload {:mvn/version \"1.0.0\"}}}\n"

  // publish only fully written staging content
  hadPublishedGenerated = FileSystem exists: (publishedGenerated toPath)
  hadPublishedGenerated ifTrue: [
    FileSystem moveFrom: publishedGenerated toPath to: backupGenerated toPath
  ]
  FileSystem moveFrom: stagingGenerated toPath to: publishedGenerated toPath
  FileSystem moveFrom: stagingManifest toPath to: (root + "/manifest.edn") toPath
  FileSystem moveFrom: stagingShim toPath to: (root + "/main.clj") toPath
  FileSystem moveFrom: stagingDeps toPath to: (root + "/deps.edn") toPath
  FileSystem moveFrom: stagingBbDeps toPath to: (root + "/bb.edn") toPath
  hadPublishedGenerated ifTrue: [
    FileSystem deleteRecursively: backupGenerated toPath
  ]
  hadLegacyGenerated = FileSystem exists: (legacyGenerated toPath)
  hadLegacyGenerated ifTrue: [
    FileSystem deleteRecursively: legacyGenerated toPath
  ]
  FileSystem createDirectories: (io getParent path: hostPath) toPath
  io writeFile file: hostPath content: JVM_HOST_SOURCE
  FileSystem deleteRecursively: stagingRoot toPath

  ^ CljGenerationResult generationId: generationId published: true
    generatedRoot: publishedGenerated manifestPath: root + "/manifest.edn"
]

constructor NivaCompiler [
    on runArgs: List(String) withIO: IO_Container = NivaCompiler :runArgs :withIO measureTime: false
    on runArgs(args): List(String) withIO(io): IO_Container measureTime: Bool = [ // enable time
        t1 = System currentTimeMillis

        measureTimeFrom = [from: Long, text: String ->
                            measureTime ifTrue: [
                                            now = System currentTimeMillis
                                            time = text + ": " + (now - from) toString
                                            time debug
                                            now]
                                        ifFalse: [0 toLong]]



        argsParsed = ArgParser args: args
        {option path backend runtime target debug repl replLine nativeBuild} = argsParsed
        cljTarget = target == CompilerTarget.Bb
          ifTrue: [CljTarget.Bb]
          ifFalse: [CljTarget.Jvm]

        nativeBuild ifTrue: [
          ((option != CompilerOption.Build) || (backend != CompilerBackend.Clj)) ifTrue: [
            TO DO: "--native is only supported for Clojure builds"
          ]
          repl ifTrue: [TO DO: "--native cannot be combined with --repl"]
          target == CompilerTarget.Bb ifTrue: [
            TO DO: "--native requires --target jvm"
          ]
        ]

        option == CompilerOption.Watch ifTrue: [
          backend != CompilerBackend.Clj ifTrue: [
            TO DO: "watch is only supported for the Clojure backend"
          ]
        ]


        realJSPath = io currentDir + "/.niva_js"
        realIrPath = io currentDir + "/.niva_ir"
        realGoPath = io currentDir + "/.niva_go"
        realCljPath = io currentDir + "/.niva_clj"

        generateJsFromResolver = [res::ResolverHelper ->
            FileSystem createDirectories: (realJSPath toPath)
            TO DO: "JS backend temporarily disabled"
            //fileToJSCOntent = TypeScript fullFromResolver: res

            //fileToJSCOntent forEach: [file, jsContent ->
            //    destanation = realJSPath + "/" + file + ".js"
            //    io writeFile file: destanation content: jsContent
            //]
        ]

        generateIrFromResolver = [res::ResolverHelper ->
            FileSystem createDirectories: (realIrPath toPath)
            irModule = res toIrModule
            irContent = irModule toDebugString
            destanation = realIrPath + "/" + (res entryPointName) + ".nir"
            io writeFile file: destanation content: irContent
        ]

        generateGoFromResolver = [res::ResolverHelper ->
            FileSystem createDirectories: (realGoPath toPath)
            irModule = res toIrModule
            goContent = GoBackend fullFromIrModule: irModule
            destanation = realGoPath + "/main.go"
            io writeFile file: destanation content: goContent
        ]

        generateCljFromResolver = [res: ResolverHelper ->
            FileSystem createDirectories: realCljPath toPath
            irModule = repl
              ifTrue:  [res toIrModuleFromEntryLine: replLine]
              ifFalse: [res toIrModule]
            mode = repl ifTrue: [CljEmitMode.Repl] ifFalse: [CljEmitMode.Program]
            repl ifTrue: [
              cljContent = CljBackend fullFromIrModule: irModule debug: debug mode: mode
              io writeFile file: realCljPath + "/main.clj" content: cljContent
            ] ifFalse: [
              output = CljBackend fullOutputFromIrModuleForTarget: irModule
                debug: debug mode: mode target: cljTarget
              output publishTo: realCljPath withIO: io
              ()
            ]
        ]

        backendStr =
          | backend
          | CompilerBackend.Go => "go"
          | CompilerBackend.Js => "js"
          | CompilerBackend.Clj => "clj"
          | CompilerBackend.Lsp => TO DO: "no lsp binary"

        // for `info package.Type`, we always start from main
        // path arg in info mode is PKG.TYPE
        rootFile = option == CompilerOption.Info
          ifTrue: ["main.niva"]
          ifFalse: [path unpackOrValue: "main.niva"]
        entryPoint = rootFile toPath name substringBeforeLast: "."
        //t2 = measureTimeFrom from: t1 text: "arg-parsed"

        runOrBuild = [

          sources = NivaBuildSystem findAllFilesFrom: rootFile withIO: io
          //t3 = measureTimeFrom from: t2 text: "collect-files"

          resolver = ResolverHelper resolveSources: sources entryPoint: entryPoint backend: backendStr
          resolver db listOfErrors isNotEmpty ifTrue: [
            resolver_errors = resolver db listOfErrors joinWith: "\n" transform: [ it toConsoleMsg ]
            TO DO: "Resolver errors: " + resolver_errors
          ]

          resolver
        ]

        runWatch = [
          rootFile = path unpackOrValue: "main.niva"
          projectRoot = io getParent path: rootFile
          entryPoint = rootFile toPath name substringBeforeLast: "."
          watchRuntime = runtime == CompilerRuntime.Bb ifTrue: ["bb"] ifFalse: ["jvm"]
          config = CompilerConfigFingerprint
            compilerVersion: "nin-watch" irSchema: "nir/v0" backend: "clj"
            target: watchRuntime abiOptions: "" coreAbiHash: ""
          mut session = CompilerSession empty
          mut requestVersion = 0
          mut entryNamespace = "niva.generated." + entryPoint

          compileAndPublish = [
            mut publishedOk = false
            requestVersion <- requestVersion + 1
            sources = NivaBuildSystem findAllFilesFrom: rootFile withIO: io
            snapshot = WorkspaceSnapshot fromSources: sources revision: requestVersion
              entryPoint: entryPoint documentVersions: #{}
            result = session compileSnapshot: snapshot config: config
              requestVersion: requestVersion cancelled: false incremental: true
            result commitReady ifFalse: [
              result diagnostics forEach: [diagnostic ->
                (diagnostic path + ": " + diagnostic message) echo
              ]
            ] ifTrue: [
              artifact = result backendArtifact unpackOrPANIC
              cljOutput = artifact cljOutput unpackOrPANIC
              entryNamespace <- cljOutput entryNamespace
              published = result publishCljOutput: realCljPath withIO: io
              published published ifTrue: [
                session <- session commitResult: result incremental: true
                publishedOk <- true
              ]
            ]
            publishedOk
          ]

          // publish a first good generation before asking clj-reload to load it
          compileAndPublish do
          JvmReloadHost start: projectRoot generatedDir: realCljPath + "/generated"
            entryNamespace: entryNamespace runtime: watchRuntime onChange: [
              changed = compileAndPublish do
              changed ifTrue: [JvmReloadHost reloadChanged]
              ()
            ]
          ()
        ]

        | option
        | CompilerOption.Watch => [runWatch do]
        | CompilerOption.Run | CompilerOption.Build => [
            t3 = System currentTimeMillis

            resolver = runOrBuild do
            //t4 = measureTimeFrom from: t3 text: "resolve"

            | backend
            | CompilerBackend.Go => [
                generateGoFromResolver res: resolver
                t5 = measureTimeFrom from: t1 text: "full niva until go generated"

                option == CompilerOption.Run ifTrue: [
                  pathToEntryPoint = realGoPath //+ "/main.go"
                  //run-code = io runProgramFromPath path: pathToEntryPoint args: {"ixgo" "run" "."}
                  t6 = measureTimeFrom from: t5 text: "go build"

                  //run-code == 0 ifTrue: [io runProgram args: {"./.niva_go/niva_go"}]
                  io runProgram args: {"ixgo" "run" pathToEntryPoint}
                  t7 = measureTimeFrom from: t6 text: "run binary"

                ]

                //t6 = System currentTimeMillis
                //t-full-run-go = t6 - t5
                //t-full-run-go debug
              ]
            | CompilerBackend.Js => [
                generateJsFromResolver res: resolver
                option == CompilerOption.Run ifTrue: [
                  // run with bun
                  pathToEntryPoint = realJSPath + "/" + entryPoint + ".js"
                  io runProgram args: {"bun" pathToEntryPoint}
                ]
              ]
            | CompilerBackend.Clj => [
                t5 = measureTimeFrom from: t1 text: "full niva until IR"
                generateCljFromResolver res: resolver
                option == CompilerOption.Run ifTrue: [
                  t6 = measureTimeFrom from: t5 text: "IR + codegen"
                  generatedPath = realCljPath + "/generated"
                  runtime == CompilerRuntime.Jvm ifTrue: [
                    io runProgramFromPath path: realCljPath
                      args: {"clojure" "-M" "-m" "main"}
                  ] ifFalse: [
                    io runProgram args: {"bb" "-cp" (generatedPath + ":" + realCljPath) "-m" "main" }
                  ]

                  t7 = measureTimeFrom from: t6 text: "run binary"
                ]
                option == CompilerOption.Build ifTrue: [
                  // REPL builds intentionally only emit a loadable Clojure module.
                  repl ifFalse: [
                    nativeBuild ifTrue: [
                      nativeImageVersionResult = io runProgram args: {"sh" "-c" "native-image --version"}
                      nativeImageVersionResult != 0 ifTrue: [
                        TO DO: "native-image is not installed or unavailable in PATH"
                      ]
                    ]

                    nativeBuild
                      ifTrue: [
                      // native-image needs JVM bytecode, while `bb uberjar` contains
                      // Babashka-loadable Clojure sources only. Use Babashka to invoke
                      // a small tools.build AOT build for the native-image input JAR.
                      nativeBuildScript = """
                        (ns build (:require [clojure.tools.build.api :as b]))

                        (def class-dir "target/classes")
                        (def basis (delay (b/create-basis {})))

                        (defn native-jar [_]
                          (b/delete {:path "target"})
                          (b/copy-dir {:src-dirs ["."] :target-dir class-dir})
                          (b/compile-clj {:basis @basis
                                          :src-dirs ["generated" "."]
                                          :class-dir class-dir
                                          :ns-compile '[main]})
                          (b/uber {:class-dir class-dir
                                   :uber-file "../main.jar"
                                   :basis @basis
                                   :main 'main}))
                      """ trimIndent
                      io writeFile file: realCljPath + "/build.clj" content: nativeBuildScript

                      nativeDeps = "{:paths [\".\"] :deps {org.clojure/clojure {:mvn/version \"1.12.2\"}} :aliases {:build {:deps {io.github.clojure/tools.build {:mvn/version \"0.10.9\"}} :ns-default build}}}"
                      jarBuildResult = io runProgramFromPath path: realCljPath args: {"bb" "clojure" "-Sdeps" nativeDeps "-T:build" "native-jar"}
                      jarBuildResult != 0 ifTrue: [TO DO: "Babashka failed to build the JVM main.jar"]

                      nativeBuildResult = io runProgram args: {
                        "native-image"
                        "--initialize-at-build-time"
                        "-H:IncludeResources=.*\\.(clj|cljc|edn)$"
                        "-jar" "main.jar" "main"
                      }
                      nativeBuildResult != 0 ifTrue: [TO DO: "native-image failed to build main"]
                    ] ifFalse: [
                      buildResult = io runProgram args: {"bb" "-cp" realCljPath "uberjar" "main.jar" "-m" "main"}
                      buildResult != 0 ifTrue: [TO DO: "Babashka failed to build main.jar"]
                    ]
                  ]
                ]
              ]
            | CompilerBackend.Lsp => []
        ]
        | CompilerOption.Ir => [
            resolver = runOrBuild do
            generateIrFromResolver res: resolver
        ]
        | CompilerOption.Help => []
        | CompilerOption.Daemon => []
        | CompilerOption.RunTests => []
        | CompilerOption.Info => [
            resolver = runOrBuild do
            info = path unpack: [resolver db structureInfoFor: it]
                        or: resolver db structureInfo
            info echo
            ()
        ]

    ]
]
