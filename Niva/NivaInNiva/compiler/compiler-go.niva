// start the runtime as a child process and watch the sources
static JvmReloadHost start(projectRoot): String generatedDir: String
    entryNamespace: String runtime: String repl: Bool initialReady: Bool
    onChange: [ -> Unit] onTick: [ -> Unit] -> Unit =
  Bind imports: #("fmt" "niva_go/core" "os" "os/exec" "path/filepath" "sort" "strings" "strconv" "time") emit: """(func() core.Unit {
  nivaWatchRoot := $0
  if nivaWatchRoot == "" { nivaWatchRoot = "." }
  nivaWatchGenerated := $1
  nivaWatchEntry := $2
  nivaWatchRuntime := $3
  nivaWatchRepl := $4
  nivaWatchReady := strconv.FormatBool($5)
  nivaWatchOnChange := $6
  nivaWatchOnTick := $7
  nivaWatchSessionRoot := filepath.Dir(nivaWatchGenerated)
  nivaWatchCommand := []string{"bb", "-m", "niva.hot-reload.host", "runtime-loop", nivaWatchGenerated, nivaWatchEntry, nivaWatchReady}
  if nivaWatchRuntime != "bb" {
    nivaWatchCommand = []string{"clojure", "-M", "-m", "niva.hot-reload.host", "runtime-loop", nivaWatchGenerated, nivaWatchEntry, nivaWatchReady}
  }
  if nivaWatchRepl {
    nivaWatchAbsoluteRoot, nivaWatchRootErr := filepath.Abs(nivaWatchRoot)
    if nivaWatchRootErr != nil { panic(nivaWatchRootErr) }
    nivaWatchCommand = []string{"clojure", "-Sdeps", "{:deps {nrepl/nrepl {:mvn/version \"1.3.1\"}}}", "-M", "-m", "niva.hot-reload.host", "repl-runtime", nivaWatchGenerated, nivaWatchEntry, nivaWatchAbsoluteRoot, strconv.Itoa(os.Getpid()), nivaWatchReady}
  }
  nivaWatchCmd := exec.Command(nivaWatchCommand[0], nivaWatchCommand[1:]...)
  nivaWatchCmd.Dir = nivaWatchSessionRoot
  nivaWatchCmd.Stdout = os.Stdout
  nivaWatchCmd.Stderr = os.Stderr
  var nivaWatchStdin interface{}
  if nivaWatchRepl {
    nivaWatchCmd.Stdin = os.Stdin
  } else {
    nivaWatchPipe, nivaWatchStdinErr := nivaWatchCmd.StdinPipe()
    if nivaWatchStdinErr != nil { panic(nivaWatchStdinErr) }
    nivaWatchStdin = nivaWatchPipe
  }
  if nivaWatchStartErr := nivaWatchCmd.Start(); nivaWatchStartErr != nil { panic(nivaWatchStartErr) }
  nivaWatchDone := make(chan struct{})
  go func() { _ = nivaWatchCmd.Wait(); close(nivaWatchDone) }()
  defer nivaWatchCmd.Process.Kill()
  nivaWatchFingerprint := func(nivaWatchDir string) string {
    nivaWatchItems := []string{}
    _ = filepath.Walk(nivaWatchDir, func(nivaWatchPath string, nivaWatchInfo os.FileInfo, nivaWatchErr error) error {
      if nivaWatchErr != nil { return nil }
      nivaWatchName := nivaWatchInfo.Name()
      if nivaWatchInfo.IsDir() {
        if nivaWatchPath != nivaWatchDir && strings.HasPrefix(nivaWatchName, ".") { return filepath.SkipDir }
        return nil
      }
      if !nivaWatchInfo.Mode().IsRegular() { return nil }
      if !strings.HasSuffix(nivaWatchName, ".niva") { return nil }
      if strings.HasPrefix(nivaWatchName, ".") { return nil }
      nivaWatchItems = append(nivaWatchItems, nivaWatchPath + "@" + strconv.FormatInt(nivaWatchInfo.ModTime().UnixMilli(), 10))
      return nil
    })
    sort.Strings(nivaWatchItems)
    return strings.Join(nivaWatchItems, ";")
  }
  fmt.Println("Watching for niva changes")
  nivaWatchLast := nivaWatchFingerprint(nivaWatchRoot)
  for {
    select { case <-nivaWatchDone: return core.UnitInstance; default: }
    time.Sleep(200 * time.Millisecond)
    nivaWatchCurrent := nivaWatchFingerprint(nivaWatchRoot)
    if nivaWatchCurrent != nivaWatchLast {
      nivaWatchLast = nivaWatchCurrent
      nivaWatchOnChange()
    }
    if nivaWatchRepl { nivaWatchOnTick() }
    _ = nivaWatchStdin
  }
})()"""

static JvmReloadHost runProtected(cb): [ -> Unit] -> Unit =
  Bind imports: #("fmt" "niva_go/core") emit: """(func() core.Unit {
  defer func() {
    if err := recover(); err != nil {
      message := []rune(fmt.Sprint(err))
      if len(message) > 400 { message = message[:400] }
      fmt.Println("recompile failed")
      fmt.Println(string(message))
    }
  }()
  $0()
  return core.UnitInstance
})()"""

static JvmReloadHost captureError(cb): [ -> String] -> String =
  Bind imports: #("fmt") emit: """(func() (result string) {
  defer func() {
    if err := recover(); err != nil { result = "error\n" + fmt.Sprint(err) }
  }()
  return $0()
})()"""
