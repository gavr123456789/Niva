Test nestedSourcePathBecomesStableModuleId = [
  moduleId = "model/user.niva" nivaModuleIdFromRelativePath
  Assert that: moduleId equals: "model.user"

  windowsModuleId = "model\\user.niva" nivaModuleIdFromRelativePath
  Assert that: windowsModuleId equals: "model.user"
]

Test hiddenDirectoriesAreNotSourcePaths = [
  Assert that: ".niva_clj/main.niva" isHiddenPath equals: true
  Assert that: ".git/hooks/main.niva" isHiddenPath equals: true
  Assert that: "src/.private/main.niva" isHiddenPath equals: true
  Assert that: "src\\.private\\main.niva" isHiddenPath equals: true
  Assert that: "src/public/main.niva" isHiddenPath equals: false
  Assert that: ".hidden.niva" isHiddenPath equals: false
  Assert that: "main.niva" isHiddenPath equals: false
]

Test moduleCollisionNormalizationIsExplicit = [
  files = {
    (NivaSourceFile path: "/project/Foo-Bar.niva" relativePath: "Foo-Bar.niva")
    (NivaSourceFile path: "/project/foo_bar.niva" relativePath: "foo_bar.niva")
  }

  inputs = files map: [source ->
    NivaSourceInput
      moduleId: (source nivaModuleId)
      relativePath: source relativePath
      path: source path
      content: ""
  ]
  collision = inputs nivaInputCollisionError
  Assert that: (collision != null) equals: true
  collisionMaybe = collision
  collisionMaybe ifNotNull: [collisionValue ->
    Assert that: (collisionValue contains: "foo_bar") equals: true
    Assert that: (collisionValue contains: "Foo-Bar.niva") equals: true
    Assert that: (collisionValue contains: "foo_bar.niva") equals: true
  ]
]

Test sameBasenameInDifferentDirectoriesHasDistinctModuleIds = [
  first = NivaSourceFile path: "/project/model/user.niva" relativePath: "model/user.niva"
  second = NivaSourceFile path: "/project/admin/user.niva" relativePath: "admin/user.niva"

  Assert that: first nivaModuleId equals: "model.user"
  Assert that: second nivaModuleId equals: "admin.user"
  inputs = {first second} map: [source ->
    NivaSourceInput
      moduleId: (source nivaModuleId)
      relativePath: source relativePath
      path: source path
      content: ""
  ]
  Assert that: (inputs nivaInputCollisionError) equals: null
]

Test bindingManifestParsesUnmarkedProviderPaths = [
  providers = "go|io.bind|providers/io.niva\n" parseNivaBindingManifest

  Assert that: providers count equals: 1
  Assert that: (providers first backend) equals: "go"
  Assert that: (providers first moduleId) equals: "io.bind"
  Assert that: (providers first relativePath) equals: "providers/io.niva"
]

Test platformBindingSuffixKeepsLogicalModuleId = [
  common = "libs/binds/io.niva" nivaModuleIdFromRelativePath
  kotlin = "libs/binds/okio.kotlin.bind.niva" nivaModuleIdFromRelativePath
  go = "libs/binds/okio.go.bind.niva" nivaModuleIdFromRelativePath
  old = "libs/binds/okio.bind.niva" nivaModuleIdFromRelativePath

  Assert that: common equals: "libs.binds.io"
  Assert that: kotlin equals: "libs.binds.okio.bind"
  Assert that: go equals: "libs.binds.okio.bind"
  Assert that: old equals: "libs.binds.okio.bind"
  Assert that: (old parseBindFileName) equals: "libs/binds/okio"
]

Test buildLoaderFiltersBindingsBeforeParsing = [
  io = IO_Container new
  root = ".niva_go/binding-loader-tests"
  io deleteRecursively path: root
  io createDirectories path: root
  io writeFile file: root + "/main.niva" content: "1 echo"
  io writeFile file: root + "/shared.niva" content: "type Shared value: String"
  io writeFile file: root + "/io.niva" content: "type SharedPath value: String"
  io createDirectories path: root + "/folder.go.bind"
  io writeFile file: root + "/folder.go.bind/common.niva" content: "type NestedSource value: String"
  io writeFile file: root + "/okio.go.bind.niva" content: "String trim -> String = []"
  io writeFile file: root + "/kotlinOnly.kotlin.bind.niva" content: "not valid Niva {{{"
  io writeFile file: root + "/legacy.bind.niva" content: "not valid Niva {{{"
  io writeFile file: root + "/niva.bindings"
    content: "go|okio.bind|okio.go.bind.niva\n"

  goSources = NivaBuildSystem findAllFilesFrom: root + "/main.niva"
    withIO: io backend: "go"
  Assert that: goSources count equals: 5
  goBindings = goSources filter: [it relativePath == "okio.go.bind.niva"]
  Assert that: goBindings count equals: 1
  Assert that: (goBindings first moduleId) equals: "okio.bind"
  Assert that: (goSources any: [it relativePath == "shared.niva"]) equals: true
  Assert that: (goSources any: [it relativePath == "io.niva"]) equals: true
  Assert that: (goSources any: [it relativePath == "folder.go.bind/common.niva"]) equals: true
  goResolved = ResolverHelper resolveSources: goSources entryPoint: "main" backend: "go"
  Assert that: goResolved db listOfErrors count equals: 0

  commonSources = NivaBuildSystem findAllFilesFrom: root + "/main.niva"
    withIO: io backend: "clj"
  Assert that: commonSources count equals: 4
  Assert that: (commonSources any: [it relativePath == "shared.niva"]) equals: true
  Assert that: (commonSources any: [it relativePath == "io.niva"]) equals: true
  Assert that: (commonSources any: [it relativePath == "folder.go.bind/common.niva"]) equals: true
  cljResolved = ResolverHelper resolveSources: commonSources entryPoint: "main" backend: "clj"
  Assert that: cljResolved db listOfErrors count equals: 0
  io deleteRecursively path: root
]

Test buildLoaderUsesBindingManifest = [
  io = IO_Container new
  root = ".niva_go/binding-manifest-tests"
  io deleteRecursively path: root
  io createDirectories path: root + "/providers"
  io writeFile file: root + "/main.niva" content: "1 echo"
  io writeFile file: root + "/shared.niva" content: "type Shared value: String"
  io writeFile file: root + "/providers/io.niva"
    content: "String trim -> String = Bind goPkg: \"strings\" emit: \"strings.TrimSpace($0)\""
  io writeFile file: root + "/unlisted.go.bind.niva" content: "not valid Niva {{{"
  io writeFile file: root + "/niva.bindings"
    content: "go|provider.bound|providers/io.niva\n"

  goSources = NivaBuildSystem findAllFilesFrom: root + "/main.niva"
    withIO: io backend: "go"
  Assert that: goSources count equals: 3
  providerSource = goSources filter: [it moduleId == "provider.bound"]
  Assert that: providerSource count equals: 1
  Assert that: (providerSource first relativePath) equals: "providers/io.niva"
  Assert that: (goSources any: [it relativePath == "unlisted.go.bind.niva"]) equals: false

  cljSources = NivaBuildSystem findAllFilesFrom: root + "/main.niva"
    withIO: io backend: "clj"
  Assert that: (cljSources any: [it relativePath == "providers/io.niva"]) equals: false
  io deleteRecursively path: root
]

Test goProjectGenerationCreatesCleanModule = [
  io = IO_Container new
  root = ".niva_go/go-project-tests"
  io createDirectories path: root
  io writeFile file: root + "/stale.go" content: "package stale"

  io initializeGoProjectAt: root

  Assert that: (io readFile path: root + "/go.mod") equals: (GoRuntimeSources moduleSource)
  coreSource = io readFile path: root + "/core/core.go"
  Assert that: (coreSource contains: "package core") equals: true
  Assert that: (FileSystem exists: ((root + "/stale.go") toPath)) equals: false

  io deleteRecursively path: root
]

Test goRuntimeRepresentationIsStable = [
  source = GoRuntimeSources coreSource

  Assert that: (source contains: "type Unit struct{}") equals: true
  Assert that: (source contains: "func NewNullable[T any](value T) *T") equals: true
  Assert that: (source contains: "type Option[T any] struct") equals: true
  Assert that: (source contains: "HasValue bool") equals: true
  Assert that: (source contains: "func List__toMutableList[T any](s []T) []T { return List__toList(s) }") equals: true
  Assert that: (source contains: "func List__mut_clear[T any](s *[]T)") equals: true
  Assert that: (source contains: "func Set__mut_add[T comparable](s map[T]struct{}") equals: true
  Assert that: (source contains: "func Map__at[K comparable, V any](s map[K]V, k K) Option[V]") equals: true
  Assert that: (source contains: "func Error__throwWithMessage(msg string)") equals: true
  Assert that: (source contains: "(any, error)") equals: true
]

Test resolverKeepsRealSourcePath = [
  realPath = "/project/model/user.niva"
  sources = {
    (NivaSourceInput
      moduleId: "model.user"
      relativePath: "model/user.niva"
      path: realPath
      content: "type User name: String")
  }

  result = ResolverHelper resolveSources: sources entryPoint: "model.user" backend: "clj"
  statements = result fileToStatements at: "model.user"
  statement = | statements
    | null => TO DO: "Missing model user statements"
    |=> statements first

  | statement
  | TypeDeclT => Assert that: statement token file path equals: realPath
  |=> [TO DO: "Expected TypeDeclT"]
]

constructor CompilerConfigFingerprint incrementalTest -> CompilerConfigFingerprint =
  CompilerConfigFingerprint compilerVersion: "test-compiler"
    irSchema: "nir/v0" backend: "clj" target: "jvm"
    abiOptions: "" hotReload: false coreAbiHash: "test-core"

Map(String, String) incrementalTestSnapshot(revision): Int -> WorkspaceSnapshot =
  WorkspaceSnapshot fromSources: (this toNivaSourceInputs) :revision

Test sha256BindingIsDeterministic = [
  Assert that: (Sha256 digest: "abc") equals:
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
]

Test apiHashExcludesFunctionBodies = [
  first = ResolverHelper resolve: #{
    "main" "Int doubled -> Int = [^ this + this]"
  } entryPoint: "main"
  second = ResolverHelper resolve: #{
    "main" "Int doubled -> Int = [^ this * 2]"
  } entryPoint: "main"

  firstPkg = first toIrModule packages first
  secondPkg = second toIrModule packages first
  Assert that: firstPkg apiHash equals: secondPkg apiHash
]

Test incrementalBodyChangeDoesNotInvalidateDependants = [
  initialSources = #{
    "model" """
      type Person name: String
      Person label -> String = [^ name]
    """
    "service" "type View person: Person"
    "main" "type App view: View"
  }
  changedSources = #{
    "model" """
      type Person name: String
      Person label -> String = [^ name + name]
    """
    "service" "type View person: Person"
    "main" "type App view: View"
  }

  initialResolver = ResolverHelper resolve: initialSources entryPoint: "main"
  empty = CompilerSession empty
  firstCandidate = empty prepareCandidate: (initialSources incrementalTestSnapshot: 1)
    resolver: initialResolver config: CompilerConfigFingerprint incrementalTest
  committed = empty commit: firstCandidate

  changedResolver = ResolverHelper resolve: changedSources entryPoint: "main"
  candidate = committed prepareCandidate: (changedSources incrementalTestSnapshot: 2)
    resolver: changedResolver config: CompilerConfigFingerprint incrementalTest

  Assert that: candidate sourceInvalidated equals: #( "model" )
  Assert that: candidate interfaceInvalidated count equals: 0
  Assert that: candidate bodyInvalidated equals: #( "model" )
  Assert that: (candidate bodyInvalidated contains: "service") equals: false
  Assert that: (candidate bodyInvalidated contains: "main") equals: false
]

Test incrementalApiChangeInvalidatesTransitiveDependants = [
  initialSources = #{
    "model" "type Person name: String"
    "service" "type View person: Person"
    "main" "type App view: View"
  }
  changedSources = #{
    "model" "type Person name: String age: Int"
    "service" "type View person: Person"
    "main" "type App view: View"
  }

  empty = CompilerSession empty
  firstResolver = ResolverHelper resolve: initialSources entryPoint: "main"
  first = empty prepareCandidate: (initialSources incrementalTestSnapshot: 1)
    resolver: firstResolver config: CompilerConfigFingerprint incrementalTest
  committed = empty commit: first

  changedResolver = ResolverHelper resolve: changedSources entryPoint: "main"
  candidate = committed prepareCandidate: (changedSources incrementalTestSnapshot: 2)
    resolver: changedResolver config: CompilerConfigFingerprint incrementalTest

  Assert that: candidate interfaceInvalidated equals: #( "model" )
  Assert that: candidate bodyInvalidated equals: #( "main" "model" "service" )
]

Test staleIncrementalCandidateCannotCommit = [
  initialSources = #{"main" "Int value -> Int = [^ this]"}
  firstChanged = #{"main" "Int value -> Int = [^ this + 1]"}
  staleChanged = #{"main" "Int value -> Int = [^ this + 2]"}

  empty = CompilerSession empty
  initialResolver = ResolverHelper resolve: initialSources entryPoint: "main"
  initial = empty prepareCandidate: (initialSources incrementalTestSnapshot: 1)
    resolver: initialResolver config: CompilerConfigFingerprint incrementalTest
  committed = empty commit: initial

  firstResolver = ResolverHelper resolve: firstChanged entryPoint: "main"
  firstCandidate = committed prepareCandidate: (firstChanged incrementalTestSnapshot: 2)
    resolver: firstResolver config: CompilerConfigFingerprint incrementalTest
  staleResolver = ResolverHelper resolve: staleChanged entryPoint: "main"
  staleCandidate = committed prepareCandidate: (staleChanged incrementalTestSnapshot: 2)
    resolver: staleResolver config: CompilerConfigFingerprint incrementalTest

  newest = committed commit: firstCandidate
  afterStaleCommit = newest commit: staleCandidate
  Assert that: afterStaleCommit revision equals: newest revision
  snapshotMaybe = afterStaleCommit committedSnapshot
  finalSnapshot = snapshotMaybe expect: "Missing committed snapshot"
  Assert that: finalSnapshot revision equals: 2
  newestMainMaybe = newest modules at: "main"
  newestMain = newestMainMaybe expect: "Missing newest main module"
  finalMainMaybe = afterStaleCommit modules at: "main"
  finalMain = finalMainMaybe expect: "Missing final main module"
  Assert that: finalMain sourceHash equals: newestMain sourceHash
]

Test specializationUseIndexTracksContributingModule = [
  sources = #{
    "box" """
      type Box(T) value: T
      Box(T) unwrap -> T = [^ value]
    """
    "main" """
      box = Box value: 1
      box unwrap
    """
  }
  resolver = ResolverHelper resolve: sources entryPoint: "main"
  empty = CompilerSession empty
  candidate = empty prepareCandidate: (sources incrementalTestSnapshot: 1)
    :resolver config: CompilerConfigFingerprint incrementalTest
  uses = candidate specializationUses
  mut found = false
  uses forEach: [key, contributors ->
    ((key startsWith: "box|") && (contributors contains: "main")) ifTrue: [found <- true]
  ]
  Assert that: found equals: true
]

Test incrementalRemovalUpdatesBothGraphDirections = [
  initialSources = #{
    "model" "type Person name: String"
    "service" "type View person: Person"
    "main" "type App view: View"
  }
  removedSources = #{
    "model" "type Person name: String"
    "main" "type App name: String"
  }

  empty = CompilerSession empty
  initialResolver = ResolverHelper resolve: initialSources entryPoint: "main"
  initial = empty prepareCandidate: (initialSources incrementalTestSnapshot: 1)
    resolver: initialResolver config: CompilerConfigFingerprint incrementalTest
  committed = empty commit: initial

  removedResolver = ResolverHelper resolve: removedSources entryPoint: "main"
  candidate = committed prepareCandidate: (removedSources incrementalTestSnapshot: 2)
    resolver: removedResolver config: CompilerConfigFingerprint incrementalTest

  Assert that: (candidate modules at: "service") equals: null
  Assert that: (candidate dependencies at: "service") equals: null
  modelDependantsMaybe = candidate reverseDependencies at: "model"
  modelDependants = modelDependantsMaybe expect: "Missing model dependants"
  Assert that: modelDependants values count equals: 0
]

Test resolverInterfacePassStopsBeforeBodies = [
  sources = #{
    "main" """
      type Person name: String
      Person greeting -> String = [^ name + name]
    """
  }
  interfaceSnapshot = ResolverInterfaceSnapshot
    collectSources: sources toNivaSourceInputs entryPoint: "main" backend: "clj"

  personType = interfaceSnapshot lookupEnvironment findByTypeName: "Person" inPkg: "main"
  Assert that: personType name equals: "Person"

  firstResolver = interfaceSnapshot resolveBodies
  secondResolver = interfaceSnapshot resolveBodies
  Assert that: firstResolver db typedBodiesCache count equals: 1
  Assert that: secondResolver db typedBodiesCache count equals: 1
  Assert that: firstResolver db == secondResolver db equals: false
  freshDb = interfaceSnapshot lookupEnvironment newTyperDB
  Assert that: freshDb typedBodiesCache count equals: 0
  Assert that: freshDb generatedMessageDecls count equals: 0
  Assert that: firstResolver toIrModule packages count equals: 1
  Assert that: secondResolver toIrModule packages count equals: 1
]

Test interfaceApiHashIsAvailableBeforeBodyResolution = [
  firstSources = #{
    "model" "type Person name: String\nPerson label -> String = [^ name]"
    "main" "type App person: Person"
  }
  changedSources = #{
    "model" "type Person name: String\nPerson label -> String = [^ name + name]"
    "main" "type App person: Person"
  }

  firstInterface = ResolverInterfaceSnapshot
    collectSources: firstSources toNivaSourceInputs entryPoint: "main" backend: "clj"
  changedInterface = ResolverInterfaceSnapshot
    collectSources: changedSources toNivaSourceInputs entryPoint: "main" backend: "clj"

  firstHashes = firstInterface interfaceApiHashes
  changedHashes = changedInterface interfaceApiHashes
  Assert that: (firstHashes at: "model") equals: (changedHashes at: "model")
  Assert that: (firstHashes at: "main") equals: (changedHashes at: "main")

  // Only the selected module gets a body cache entry.  In particular, the
  // dependant is not type-checked merely because its source is present.
  selected = changedInterface resolveBodiesFor: #( "model" )
  Assert that: selected db typedBodiesCache count equals: 1
  Assert that: (selected fileToStatements at: "main") equals: null
]

Test sessionResolvesOnlyInvalidatedBodyFrontier = [
  initialSources = #{
    "model" "type Person name: String\nPerson label -> String = [^ name]"
    "service" "type View person: Person"
    "main" "type App view: View"
  }
  changedSources = #{
    "model" "type Person name: String\nPerson label -> String = [^ name + name]"
    "service" "type View person: Person"
    "main" "type App view: View"
  }
  config = CompilerConfigFingerprint incrementalTest

  firstInterface = ResolverInterfaceSnapshot
    collectSources: initialSources toNivaSourceInputs entryPoint: "main" backend: "clj"
  empty = CompilerSession empty
  initial = empty prepareCandidate: (initialSources incrementalTestSnapshot: 1)
    interfaceSnapshot: firstInterface :config
  committed = empty commit: initial

  changedInterface = ResolverInterfaceSnapshot
    collectSources: changedSources toNivaSourceInputs entryPoint: "main" backend: "clj"
  candidate = committed prepareCandidate: (changedSources incrementalTestSnapshot: 2)
    interfaceSnapshot: changedInterface :config

  Assert that: candidate sourceInvalidated equals: #( "model" )
  Assert that: candidate interfaceInvalidated count equals: 0
  Assert that: candidate bodyInvalidated equals: #( "model" )
  // The cached dependant is present, but it was not rebuilt by the selected
  // body pass.
  Assert that: (candidate modules at: "service") != null equals: true
]

Test compilationResultVersionsDiagnosticsAndCancellation = [
  goodSources = #{"main" "Int value -> Int = [^ this]"}
  badSources = #{"main" "Int value -> Int = [^ \"wrong\"]"}
  config = CompilerConfigFingerprint incrementalTest
  goodInterface = ResolverInterfaceSnapshot
    collectSources: goodSources toNivaSourceInputs entryPoint: "main" backend: "clj"
  badInterface = ResolverInterfaceSnapshot
    collectSources: badSources toNivaSourceInputs entryPoint: "main" backend: "clj"

  empty = CompilerSession empty
  good = empty compileCandidate: (goodSources incrementalTestSnapshot: 1)
    interfaceSnapshot: goodInterface :config requestVersion: 11 cancelled: false
  Assert that: good cancelled equals: false
  Assert that: good diagnostics count equals: 0
  candidateMaybe = good candidate
  goodCandidate = candidateMaybe expect: "Missing good candidate"
  committed = empty commit: goodCandidate

  failed = committed compileCandidate: (badSources incrementalTestSnapshot: 2)
    interfaceSnapshot: badInterface :config requestVersion: 12 cancelled: false
  Assert that: failed candidate equals: null
  Assert that: failed diagnostics count > 0 equals: true
  diagnostic = failed diagnostics first
  Assert that: diagnostic requestVersion equals: 12
  Assert that: committed revision equals: 1

  cancelled = committed compileCandidate: (badSources incrementalTestSnapshot: 2)
    interfaceSnapshot: badInterface :config requestVersion: 13 cancelled: true
  Assert that: cancelled cancelled equals: true
  Assert that: cancelled candidate equals: null
  Assert that: cancelled diagnostics count equals: 0
]

Test incompatibleReloadShapeRequiresHardRestart = [
  initialSources = #{"main" "type Person name: String"}
  changedSources = #{"main" "type Person name: String age: Int"}
  config = CompilerConfigFingerprint incrementalTest
  initialSnapshot = WorkspaceSnapshot fromSources: (initialSources toNivaSourceInputs)
    revision: 1 entryPoint: "main" documentVersions: #{}
  changedSnapshot = WorkspaceSnapshot fromSources: (changedSources toNivaSourceInputs)
    revision: 2 entryPoint: "main" documentVersions: #{}

  session = CompilerSession empty
  initial = session compileSnapshot: initialSnapshot :config
    requestVersion: 1 cancelled: false incremental: true
  committed = session commitResult: initial incremental: true
  changed = committed compileSnapshot: changedSnapshot :config
    requestVersion: 2 cancelled: false incremental: true

  Assert that: changed candidate equals: null
  Assert that: changed diagnostics count equals: 1
  diagnostic = changed diagnostics first
  Assert that: (diagnostic message contains: "hard restart required") equals: true
  Assert that: (diagnostic message contains: "automatic state migration is not supported") equals: true
  manifestMaybe = committed cljManifest
  manifest = manifestMaybe expect: "Missing clojure manifest"
  Assert that: (manifest canonical contains: "main/main_Person") equals: true
]

Test sessionCompileSnapshotIsEntryPointAwareAndTransactional = [
  sources = #{"app.main" "1 echo"}
  snapshot = WorkspaceSnapshot fromSources: (sources toNivaSourceInputs)
    revision: 7 entryPoint: "app.main" documentVersions: #{"app.main" 3}
  config = CompilerConfigFingerprint incrementalTest
  session = CompilerSession empty

  result = session compileSnapshot: snapshot :config requestVersion: 31 cancelled: false
  Assert that: result requestVersion equals: 31
  Assert that: result diagnostics count equals: 0
  candidateMaybe = result candidate
  candidate = candidateMaybe expect: "Missing compile candidate"
  Assert that: candidate snapshot entryPoint equals: "app.main"
  Assert that: (candidate snapshot documentVersions at: "app.main") equals: 3

  committed = session commitResult: result
  Assert that: committed revision equals: 1
  committedSnapshotMaybe = committed committedSnapshot
  committedSnapshot = committedSnapshotMaybe expect: "Missing committed snapshot"
  Assert that: committedSnapshot entryPoint equals: "app.main"

  cancelled = committed compileSnapshot: snapshot :config requestVersion: 32 cancelled: true
  Assert that: cancelled cancelled equals: true
  Assert that: cancelled candidate equals: null
  Assert that: (committed commitResult: cancelled) revision equals: committed revision

  failedSources = #{"app.main" "Int value -> Int = [^ \"bad\"]"}
  failedSnapshot = WorkspaceSnapshot fromSources: (failedSources toNivaSourceInputs)
    revision: 8 entryPoint: "app.main" documentVersions: #{"app.main" 4}
  failedInterface = ResolverInterfaceSnapshot
    collectSources: failedSnapshot sources entryPoint: failedSnapshot entryPoint backend: config backend
  failed = committed compileCandidate: failedSnapshot interfaceSnapshot: failedInterface
    :config requestVersion: 33 cancelled: false
  afterFailed = committed commitResult: failed
  Assert that: afterFailed revision equals: committed revision
]

Test compileSnapshotFlagSelectsPersistentOrCleanSession = [
  initialSources = #{
    "person" "type Person name: String\nPerson greet -> String = [^ name]"
    "main" "alice = Person name: \"Ada\"\nalice greet"
  }
  changedSources = #{
    "person" "type Person name: String\nPerson greet -> String = [^ name + name]"
    "main" "alice = Person name: \"Ada\"\nalice greet"
  }
  config = CompilerConfigFingerprint incrementalTest
  empty = CompilerSession empty
  initialSnapshot = WorkspaceSnapshot fromSources: (initialSources toNivaSourceInputs)
    revision: 1 entryPoint: "main" documentVersions: #{}
  initial = empty compileSnapshot: initialSnapshot :config
    requestVersion: 1 cancelled: false incremental: true
  committed = empty commitResult: initial
  changedSnapshot = WorkspaceSnapshot fromSources: (changedSources toNivaSourceInputs)
    revision: 2 entryPoint: "main" documentVersions: #{}

  incremental = committed compileSnapshot: changedSnapshot :config
    requestVersion: 2 cancelled: false incremental: true
  clean = committed compileSnapshot: changedSnapshot :config
    requestVersion: 2 cancelled: false incremental: false
  incrementalCandidateMaybe = incremental candidate
  incrementalCandidate = incrementalCandidateMaybe expect: "Missing incremental candidate"
  cleanCandidateMaybe = clean candidate
  cleanCandidate = cleanCandidateMaybe expect: "Missing clean candidate"

  Assert that: incrementalCandidate bodyInvalidated equals: #( "person" )
  Assert that: cleanCandidate bodyInvalidated equals: #( "main" "person" )
  incrementalArtifactMaybe = incremental backendArtifact
  incrementalArtifact = incrementalArtifactMaybe expect: "Missing incremental backend artifact"
  cleanArtifactMaybe = clean backendArtifact
  cleanArtifact = cleanArtifactMaybe expect: "Missing clean backend artifact"
  Assert that: incrementalArtifact backend equals: cleanArtifact backend
  Assert that: incrementalArtifact target equals: cleanArtifact target
  Assert that: incrementalArtifact content equals: cleanArtifact content
  Assert that: cleanCandidate baseRevision equals: 0
  incrementalSession = committed commitResult: incremental incremental: true
  cleanSession = committed commitResult: clean incremental: false
  Assert that: incrementalSession revision equals: 2
  Assert that: cleanSession revision equals: 0
]

Test incrementalBackendOutputMatchesCleanCompilation = [
  initialSources = #{
    "person" """
      type Person name: String
      Person greet -> String = [^ name]
    """
    "main" """
      alice = Person name: "Ada"
      alice greet
    """
  }
  changedSources = #{
    "person" """
      type Person name: String
      Person greet -> String = [^ name + name]
    """
    "main" """
      alice = Person name: "Ada"
      alice greet
    """
  }
  config = CompilerConfigFingerprint incrementalTest

  initialClean = ResolverHelper resolve: initialSources entryPoint: "main" backend: "clj"
  initialCleanOutput = CljBackend fullFromIrModule: initialClean toIrModule
  initialInterface = ResolverInterfaceSnapshot
    collectSources: initialSources toNivaSourceInputs entryPoint: "main" backend: "clj"
  empty = CompilerSession empty
  initialResult = empty compileCandidate: (initialSources incrementalTestSnapshot: 1)
    interfaceSnapshot: initialInterface :config requestVersion: 1 cancelled: false
  initialArtifactMaybe = initialResult backendArtifact
  initialArtifact = initialArtifactMaybe expect: "Missing initial backend artifact"
  Assert that: initialArtifact content equals: initialCleanOutput

  initialCandidateMaybe = initialResult candidate
  initialCandidate = initialCandidateMaybe expect: "Missing initial candidate"
  committed = empty commit: initialCandidate
  changedClean = ResolverHelper resolve: changedSources entryPoint: "main" backend: "clj"
  changedCleanOutput = CljBackend fullFromIrModule: changedClean toIrModule
  changedInterface = ResolverInterfaceSnapshot
    collectSources: changedSources toNivaSourceInputs entryPoint: "main" backend: "clj"
  changedResult = committed compileCandidate: (changedSources incrementalTestSnapshot: 2)
    interfaceSnapshot: changedInterface :config requestVersion: 2 cancelled: false
  changedCandidateMaybe = changedResult candidate
  changedCandidate = changedCandidateMaybe expect: "Missing changed candidate"
  changedArtifactMaybe = changedResult backendArtifact
  changedArtifact = changedArtifactMaybe expect: "Missing changed backend artifact"

  Assert that: changedCandidate bodyInvalidated equals: #( "person" )
  Assert that: changedArtifact content equals: changedCleanOutput
  changedOutputMaybe = changedArtifact cljOutput
  changedOutput = changedOutputMaybe expect: "Missing changed clojure output"
  cleanOutput = CljBackend fullOutputFromIrModule: (changedClean toIrModule)
    debug: false mode: CljEmitMode.Program
  Assert that: changedOutput files equals: cleanOutput files
  Assert that: changedOutput manifest canonical equals: cleanOutput manifest canonical
]

Test cljPublishingUsesGenerationDirectory = [
  io = IO_Container new
  root = ".niva_clj/publish-tests/success"
  io deleteRecursively path: root

  result = ResolverHelper resolve: #{"main" "1 echo"} entryPoint: "main" backend: "clj"
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  published = output publishTo: root withIO: io hotReload: true

  Assert that: published published equals: true
  Assert that: (published generationId count > 0) equals: true
  Assert that: (io readFile path: root + "/manifest.edn") equals: output manifest edn
  Assert that: (io readFile path: root + "/main.clj") equals: output legacyMainShim
  host = io readFile path: root + "/niva/hot_reload/host.clj"
  Assert that: (host contains: "(reload/reload {:only :all :log-fn quiet-reload-log})") equals: true
  Assert that: (host contains: "(reload/reload {:only :changed :log-fn quiet-reload-log})") equals: true
  Assert that: ((io readFile path: root + "/deps.edn")
    contains: "io.github.tonsky/clj-reload") equals: true
  Assert that: ((io readFile path: root + "/bb.edn")
    contains: "io.github.tonsky/clj-reload") equals: true
  generatedFiles = io walkDir path: root + "/generated"
  Assert that: (generatedFiles any: [it relativePath == "niva/generated/main.clj"]) equals: true

  io deleteRecursively path: ".niva_clj/publish-tests"
]

Test cljPublishingWithoutHotReloadOmitsReloadArtifacts = [
  io = IO_Container new
  root = ".niva_clj/publish-tests/plain"
  io deleteRecursively path: root
  // seed artifacts left behind by a previous watch run
  io createDirectories path: (root + "/niva/hot_reload")
  io writeFile file: root + "/niva/hot_reload/host.clj" content: "stale host"
  io writeFile file: root + "/deps.edn" content: (CompilerConstants cljProjectDepsSource)
  io writeFile file: root + "/bb.edn" content: (CompilerConstants cljProjectDepsSource)

  result = ResolverHelper resolve: #{"main" "1 echo"} entryPoint: "main" backend: "clj"
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  published = output publishTo: root withIO: io hotReload: false

  Assert that: published published equals: true
  Assert that: (io readFile path: root + "/deps.edn") equals: (CompilerConstants cljPlainDepsSource)
  Assert that: (io readFile path: root + "/bb.edn") equals: (CompilerConstants cljPlainDepsSource)
  Assert that: ((io readFile path: root + "/deps.edn") contains: "clj-reload") equals: false
  hostExists = FileSystem exists: ((root + "/niva/hot_reload/host.clj") toPath)
  Assert that: hostExists equals: false
  hotReloadExists = FileSystem exists: ((root + "/niva/hot_reload") toPath)
  Assert that: hotReloadExists equals: false
  generatedFiles = io walkDir path: root + "/generated"
  Assert that: (generatedFiles any: [it relativePath == "niva/generated/main.clj"]) equals: true

  io deleteRecursively path: ".niva_clj/publish-tests"
]

Test cljProjectBootstrapCreatesMissingRuntimeFiles = [
  io = IO_Container new
  root = ".niva_clj/bootstrap-tests"
  io deleteRecursively path: root

  io ensureCljProjectAt: root hotReload: true

  Assert that: (io readFile path: root + "/bb.edn") equals: (CompilerConstants cljProjectDepsSource)
  Assert that: (io readFile path: root + "/deps.edn") equals: (CompilerConstants cljProjectDepsSource)
  Assert that: (io readFile path: root + "/niva/core.clj") equals: (CompilerConstants nivaCoreSource)

  // switching to plain generation refreshes niva-owned dependency files
  io ensureCljProjectAt: root hotReload: false
  Assert that: (io readFile path: root + "/deps.edn") equals: (CompilerConstants cljPlainDepsSource)
  Assert that: (io readFile path: root + "/bb.edn") equals: (CompilerConstants cljPlainDepsSource)

  io writeFile file: root + "/deps.edn" content: "preserved"
  io writeFile file: root + "/bb.edn" content: "also preserved"
  io ensureCljProjectAt: root hotReload: false
  Assert that: (io readFile path: root + "/deps.edn") equals: "preserved"
  Assert that: (io readFile path: root + "/bb.edn") equals: "also preserved"

  io deleteRecursively path: root
]

Test cljPublishingPreservesProjectDependencyFiles = [
  io = IO_Container new
  root = ".niva_clj/publish-tests/preserve-deps"
  io deleteRecursively path: root
  io createDirectories path: root
  io writeFile file: root + "/deps.edn" content: "{:deps {my/app {:local/root \"app\"}}}\n"
  io writeFile file: root + "/bb.edn" content: "{:tasks {run {:task \"my-task\"}}}\n"

  result = ResolverHelper resolve: #{"main" "1 echo"} entryPoint: "main" backend: "clj"
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  published = output publishTo: root withIO: io hotReload: false

  Assert that: published published equals: true
  Assert that: (io readFile path: root + "/deps.edn")
    equals: "{:deps {my/app {:local/root \"app\"}}}\n"
  Assert that: (io readFile path: root + "/bb.edn")
    equals: "{:tasks {run {:task \"my-task\"}}}\n"
  generatedFiles = io walkDir path: root + "/generated"
  Assert that: (generatedFiles any: [it relativePath == "niva/generated/main.clj"]) equals: true

  io deleteRecursively path: root
]

Test cljEmptyProgramProducesLoadableEntryModule = [
  result = ResolverHelper resolve: #{"main" ""} entryPoint: "main" backend: "clj"
  output = CljBackend fullOutputFromIrModuleForTarget: (result toIrModule)
    debug: false mode: CljEmitMode.Program target: CljTarget.Bb

  generated = output files at: "niva/generated/main.clj"
  Assert that: (generated != null) equals: true
  generatedMaybe = generated
  generatedMaybe ifNotNull: [generatedValue ->
    Assert that: (generatedValue contains: "(ns niva.generated.main)") equals: true
    Assert that: (generatedValue contains: "(defn __niva_entry!") equals: true
  ]
  Assert that: (output manifest edn contains: "\"main\"") equals: true
]

Test cljPublishingRemovesStaleGeneratedFiles = [
  io = IO_Container new
  root = ".niva_clj/publish-tests/stale"
  io deleteRecursively path: root
  io createDirectories path: (root + "/generated/niva/generated")
  io createDirectories path: (root + "/niva/generated")
  io writeFile file: root + "/generated/niva/generated/stale.clj" content: "stale"
  io writeFile file: root + "/niva/generated/legacy-stale.clj" content: "legacy stale"

  result = ResolverHelper resolve: #{"main" "1 echo"} entryPoint: "main" backend: "clj"
  output = CljBackend fullOutputFromIrModule: (result toIrModule)
    debug: false mode: CljEmitMode.Program
  published = output publishTo: root withIO: io hotReload: false

  Assert that: published published equals: true
  generatedFiles = io walkDir path: root + "/generated"
  Assert that: (generatedFiles any: [it relativePath == "niva/generated/stale.clj"]) equals: false
  Assert that: (generatedFiles any: [it relativePath == "niva/generated/main.clj"]) equals: true
  allFiles = io walkDir path: root
  Assert that: (allFiles any: [it relativePath == "niva/generated/legacy-stale.clj"]) equals: false

  io deleteRecursively path: ".niva_clj/publish-tests"
]

Test failedCljCompilationDoesNotReplacePublishedOutput = [
  io = IO_Container new
  root = ".niva_clj/publish-tests/failed"
  io deleteRecursively path: root
  io createDirectories path: (root + "/generated/niva/generated")
  io writeFile file: root + "/generated/niva/generated/main.clj" content: "old output"
  io writeFile file: root + "/manifest.edn" content: "old manifest"

  failed = CompilerCompilationResult requestVersion: 9 candidate: null
    backendArtifact: null diagnostics: {(CompilerDiagnostic requestVersion: 9
      path: "main.niva" message: "compile error")} cancelled: false
  publishResult = failed publishCljOutput: root withIO: io hotReload: true

  Assert that: publishResult published equals: false
  Assert that: (io readFile path: root + "/generated/niva/generated/main.clj") equals: "old output"
  Assert that: (io readFile path: root + "/manifest.edn") equals: "old manifest"

  io deleteRecursively path: ".niva_clj/publish-tests"
]

Test watchDebouncesAndPreservesDistinctFiles = [
  empty = WatchChangeBatch empty
  batch1 = empty add: "main.niva"
  batch2 = batch1 add: "main.niva"
  batch3 = batch2 add: "model.niva"

  Assert that: batch3 count equals: 2
  Assert that: (batch3 paths contains: "main.niva") equals: true
  Assert that: (batch3 paths contains: "model.niva") equals: true
]

Test watchQueueSerializesBuildsAndKeepsPendingEvents = [
  empty = WatchQueueState empty
  building = empty event
  pending = building event
  next = pending buildFinished
  idle = next buildFinished

  Assert that: building building equals: true
  Assert that: building pending equals: false
  Assert that: pending building equals: true
  Assert that: pending pending equals: true
  Assert that: next building equals: true
  Assert that: next pending equals: false
  Assert that: idle building equals: false
  Assert that: idle pending equals: false
]

Test jvmHostHasReloadSafeLifecycle = [
  Assert that: ((CompilerConstants jvmHostSource) contains: "(reload/init") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "{:only :all :log-fn") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "{:only :changed :log-fn") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "requiring-resolve") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "__niva_entry!") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: ":entry-executed?") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "(catch Throwable _ nil)") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "150") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "org.babashka/fswatcher") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "runtime-name") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "niva-reload.signal") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "locking reload-lock") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "read-syntax-sweep") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "rerun-entry") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "quiet-reload-log") equals: true
  Assert that: ((CompilerConstants jvmHostSource) contains: "(declare print-error!") equals: true
]

Test jvmHostDoesNotRequireGeneratedNamespaces = [
  Assert that: ((CompilerConstants jvmHostSource) contains: "(:require [niva.generated") equals: false
  Assert that: ((CompilerConstants jvmHostSource) contains: ":no-reload '#{niva.hot-reload.host}") equals: true
]

Test babashkaHostLoadsRecoversAndWatchesSources = [
  io = IO_Container new
  root = ".niva_clj/babashka-host"
  setupExit = io runProgram args: {"sh" "-c"
    "rm -rf .niva_clj/babashka-host babashka-watch-project && mkdir -p .niva_clj/babashka-host/generated/niva/generated .niva_clj/babashka-host/niva/hot_reload babashka-watch-project"}
  Assert that: setupExit equals: 0

  initialSource = """
    (ns niva.generated.main)
    (def ^:clj-reload/keep state (atom 0))
    (def ^:clj-reload/keep entries (atom 0))
    (defn __niva_entry! [] (swap! entries inc) (reset! state 7))
    (defn value [] 1)
  """ trimIndent
  changedSource = """
    (ns niva.generated.main)
    (def ^:clj-reload/keep state (atom 0))
    (def ^:clj-reload/keep entries (atom 0))
    (defn __niva_entry! [] (swap! entries inc) (reset! state 7))
    (defn value [] 2)
  """ trimIndent
  brokenSource = """
    (ns niva.generated.main)
    (defn broken [)
  """ trimIndent
  recoveredSource = """
    (ns niva.generated.main)
    (def ^:clj-reload/keep state (atom 0))
    (def ^:clj-reload/keep entries (atom 0))
    (defn __niva_entry! [] (swap! entries inc) (reset! state 7))
    (defn value [] 3)
  """ trimIndent
  hostTest = """
    (ns host-test
      (:require [niva.hot-reload.host :as host]))

    (defn value-of [name]
      (deref (deref (requiring-resolve (symbol "niva.generated.main" name)))))

    (defn call-value []
      ((requiring-resolve 'niva.generated.main/value)))

    (defn print-state [result]
      (println (:ok result) (value-of "state") (value-of "entries") (call-value)))

    (defn -main [& _]
      (host/init! "generated" "niva.generated.main")
      (print-state (host/initial-load!))
      (Thread/sleep 1100)
      (spit "generated/niva/generated/main.clj" (slurp "changed.clj"))
      (print-state (host/reload-changed!))
      (Thread/sleep 1100)
      (spit "generated/niva/generated/main.clj" (slurp "broken.clj"))
      (println (:ok (host/reload-changed!)))
      (Thread/sleep 1100)
      (spit "generated/niva/generated/main.clj" (slurp "recovered.clj"))
      (print-state (host/reload-changed!))
        (let [ready (promise)
            worker (future
                     (host/watch! "../../babashka-watch-project"
                       #(deliver ready true) "bb"))]
        (Thread/sleep 300)
        (spit "../../babashka-watch-project/change.niva" "")
        (println "watch" (deref ready 5000 false))
        (host/stop-watch!)
        (let [watch-stopped? (not= ::timeout (deref worker 5000 ::timeout))]
          (println "watch-stopped" watch-stopped?))))
  """ trimIndent

  io writeFile file: root + "/generated/niva/generated/main.clj" content: initialSource
  io writeFile file: root + "/changed.clj" content: changedSource
  io writeFile file: root + "/broken.clj" content: brokenSource
  io writeFile file: root + "/recovered.clj" content: recoveredSource
  io writeFile file: root + "/host_test.clj" content: hostTest
  io writeFile file: root + "/niva/hot_reload/host.clj" content: (CompilerConstants jvmHostSource)
  io writeFile file: root + "/deps.edn"
    content: "{:paths [\"generated\" \".\"] :deps {io.github.tonsky/clj-reload {:mvn/version \"1.0.0\"}}}\n"
  io writeFile file: root + "/bb.edn"
    content: "{:paths [\"generated\" \".\"] :deps {io.github.tonsky/clj-reload {:mvn/version \"1.0.0\"}}}\n"

  runExit = io runProgramFromPath path: root args: {"sh" "-c"
    "bb -m host-test > result.txt"}
  Assert that: runExit equals: 0
  result = io readFile path: root + "/result.txt"
  Assert that: (result contains: "true 7 1 1") equals: true
  Assert that: (result contains: "true 7 2 2") equals: true
  Assert that: (result contains: "false") equals: true
  Assert that: (result contains: "true 7 3 3") equals: true
  Assert that: (result contains: "watch true") equals: true
  Assert that: (result contains: "watch-stopped true") equals: true

  io deleteRecursively path: root
]
