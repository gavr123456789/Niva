// in-memory-module-level incremental compilation state
// all values returned from this file are fresh snapshots committed sessions are never mutated

type WorkspaceSnapshot
  revision: Int
  sources: List(NivaSourceInput)
  documentVersions: Map(String, Int)
  entryPoint: String

constructor WorkspaceSnapshot fromSources(sources): List(NivaSourceInput) revision: Int -> WorkspaceSnapshot =
  WorkspaceSnapshot fromSources: sources revision: revision
    entryPoint: "main" documentVersions: #{}

constructor WorkspaceSnapshot fromSources(sources): List(NivaSourceInput) revision: Int
    entryPoint(entryPoint): String documentVersions(documentVersions): Map(String, Int)
    -> WorkspaceSnapshot =
  WorkspaceSnapshot revision: revision sources: (sources sortedBy: [it moduleId])
    documentVersions: documentVersions entryPoint: entryPoint

WorkspaceSnapshot sourceFor(moduleId): String -> NivaSourceInput? =
  sources find: [it moduleId == moduleId]

type CompilerConfigFingerprint
  compilerVersion: String
  irSchema: String
  backend: String
  target: String
  abiOptions: String
  hotReload: Bool
  coreAbiHash: String

CompilerConfigFingerprint resolutionKey -> String =
  compilerVersion + "|" + irSchema + "|" + coreAbiHash

CompilerConfigFingerprint backendKey -> String =
  this resolutionKey + "|" + backend + "|" + target + "|" + abiOptions +
    "|" + (hotReload ifTrue: ["hot-reload"] ifFalse: ["program"])

IrTypeRefKind incrementalStableName -> String =
  this == IrTypeRefKind.Builtin ifTrue: ["builtin"] ifFalse: [
    this == IrTypeRefKind.Custom ifTrue: ["custom"] ifFalse: ["function"]
  ]

IrTypeRef canonicalInterfaceString -> String = [
  argsPart = args joinWith: "," transform: [it canonicalInterfaceString]
  returnTypeMaybe = returnType
  returnPart = | returnTypeMaybe
    | null => "-"
    |=> returnTypeMaybe canonicalInterfaceString
  errorsPart = errors map: [it canonicalInterfaceString], sortedBy: [it], joinWith: ","
  kind incrementalStableName + ":" + ownerPkg + ":" + typeId +
    "<" + argsPart + ">->" + returnPart + "!" + errorsPart +
    (isMut ifTrue: [":mut"] ifFalse: [":val"]) +
    (nullable ifTrue: ["?"] ifFalse: [""])
]

IrField canonicalInterfaceString -> String =
  name + ":" + typeRef canonicalInterfaceString

IrTypeDef canonicalInterfaceString -> String =
  "type|" + id + "|" + (typeParams joinWith: ",") + "|" +
    (fields joinWith: "," transform: [it canonicalInterfaceString])

IrUnionBranch canonicalInterfaceString -> String =
  name + (isInclude ifTrue: ["+"] ifFalse: ["="]) +
    "(" + (fields joinWith: "," transform: [it canonicalInterfaceString]) + ")"

IrUnionDef canonicalInterfaceString -> String =
  "union|" + id + "|" + (typeParams joinWith: ",") + "|" +
    (commonFields joinWith: "," transform: [it canonicalInterfaceString]) + "|" +
    (branches joinWith: "," transform: [it canonicalInterfaceString]) + "|" +
    (isErrorDomain ifTrue: ["error"] ifFalse: ["plain"])

IrEnumDef canonicalInterfaceString -> String =
  "enum|" + id + "|" + (values joinWith: ",")

IrStateDef canonicalInterfaceString -> String =
  "state|" + name + "|" + typeRef canonicalInterfaceString

IrFunction canonicalInterfaceString -> String =
  "fn|" + id + "|" + (generics joinWith: ",") + "|" +
    receiverType canonicalInterfaceString + "|" +
    (args joinWith: "," transform: [it name + ":" + it typeRef canonicalInterfaceString]) +
    "|" + returnType canonicalInterfaceString + "|" +
    (requiresMutReceiver ifTrue: ["mut"] ifFalse: ["val"])

IrPackage canonicalInterfaceString -> String = [
  parts::mut List(String) = {}!
  types map: [it canonicalInterfaceString], sortedBy: [it], forEach: [parts add: it]
  unions map: [it canonicalInterfaceString], sortedBy: [it], forEach: [parts add: it]
  enums map: [it canonicalInterfaceString], sortedBy: [it], forEach: [parts add: it]
  stateDefs map: [it canonicalInterfaceString], sortedBy: [it], forEach: [parts add: it]
  functions map: [it canonicalInterfaceString], sortedBy: [it], forEach: [parts add: it]
  parts joinWith: "\n"
]

IrPackage apiHash -> String = Sha256 digest: (this canonicalInterfaceString)

type IncrementalModuleState
  moduleId: String
  sourceHash: String
  apiHash: String
  dependencyApiHash: String
  dependencies: List(String)
  specializationHash: String
  irPackage: IrPackage

type IncrementalDependencyTargets
  values: List(String)

type CompilerSession
  revision: Int
  committedSnapshot: WorkspaceSnapshot?
  modules: Map(String, IncrementalModuleState)
  entry: IrBlock?
  dependencies: Map(String, IncrementalDependencyTargets)
  reverseDependencies: Map(String, IncrementalDependencyTargets)
  specializationUses: Map(String, Set(String))
  compilerConfig: CompilerConfigFingerprint?
  cljManifest: CljManifest?

constructor CompilerSession empty -> CompilerSession =
  CompilerSession revision: 0 committedSnapshot: null modules: #{} entry: null
    dependencies: #{} reverseDependencies: #{} specializationUses: #{}
    compilerConfig: null cljManifest: null

Map(String, IncrementalDependencyTargets) incrementalReverseGraph -> Map(String, IncrementalDependencyTargets) = [
  reverseLists::mut Map(String, IncrementalDependencyTargets) = #{}!
  this forEach: [moduleId, targets ->
    (reverseLists containsKey: moduleId) ifFalse: [
      reverseLists at: moduleId put: (IncrementalDependencyTargets values: {})
    ]
    targets values forEach: [target ->
      dependantsMaybe = reverseLists at: target
      dependants::List(String) =
        | dependantsMaybe
        | null => {}
        |=> dependantsMaybe values
      newValues = (dependants + {moduleId}) toSet toList sortedBy: [it]
      reverseLists at: target put: (IncrementalDependencyTargets values: newValues)
    ]
  ]
  ^ reverseLists
]

Set(String) incrementalTransitiveDependants(reverseGraph): Map(String, IncrementalDependencyTargets) -> Set(String) = [
  result::mut Set(String) = #()!
  queue::mut List(String) = this toList, sortedBy: [it], toMutableList
  mut index = 0
  [index < queue count] whileTrue: [
    current = queue at: index
    index <- index + 1
    dependantsMaybe = reverseGraph at: current
    dependantsMaybe ifNotNull: [dependantsValue ->
      dependantsValue values sortedBy: [it], forEach: [dependant ->
        result contains: dependant, ifFalse: [
          result add: dependant
          queue add: dependant
        ]
      ]
    ]
  ]
  result
]

CompilerSession bodyModulesFor(snapshot): WorkspaceSnapshot apiHashes(apiHashes): Map(String, String) config(config): CompilerConfigFingerprint -> Set(String) = [
  result::mut Set(String) = #()!

  apiHashes forEach: [moduleId, newApiHash ->
    source = snapshot sourceFor: moduleId
    sourceHash = | source
      | null => Sha256 digest: ""
      |=> Sha256 digest: source content
    old = modules at: moduleId
    | old
    | null => result add: moduleId
    |=> [
      old sourceHash != sourceHash ifTrue: [result add: moduleId]
      old apiHash != newApiHash ifTrue: [result add: moduleId]
    ]
  ]

  // A first candidate has no reusable body cache.  Resolution must therefore
  // cover every source, while later candidates can stop at the changed API
  // frontier and its old reverse dependants.
  modules isEmpty ifTrue: [
    apiHashes forEach: [moduleId, ignored -> result add: moduleId]
  ]

  changedInterfaces::mut Set(String) = #()!
  apiHashes forEach: [moduleId, newApiHash ->
    old = modules at: moduleId
    | old
    | null => []
    |=> old apiHash != newApiHash ifTrue: [changedInterfaces add: moduleId]
  ]
  result addAll: (changedInterfaces incrementalTransitiveDependants: reverseDependencies)

  compilerConfigMaybe = compilerConfig
  resolutionChanged = | compilerConfigMaybe
    | null => true
    |=> compilerConfigMaybe resolutionKey != config resolutionKey
  resolutionChanged ifTrue: [apiHashes forEach: [moduleId, ignored -> result add: moduleId]]
  result
]

type CompilerCandidate
  baseRevision: Int
  snapshot: WorkspaceSnapshot
  modules: Map(String, IncrementalModuleState)
  irModule: IrModule
  dependencies: Map(String, IncrementalDependencyTargets)
  reverseDependencies: Map(String, IncrementalDependencyTargets)
  specializationUses: Map(String, Set(String))
  compilerConfig: CompilerConfigFingerprint
  sourceInvalidated: Set(String)
  interfaceInvalidated: Set(String)
  bodyInvalidated: Set(String)
  outputInvalidated: Set(String)
  cljManifest: CljManifest?

type CompilerBackendArtifact
  backend: String
  target: String
  content: String
  cljOutput: CljOutput?

CompilerCandidate emitBackend -> CompilerBackendArtifact = [
  backend = compilerConfig backend
  cljMode = compilerConfig hotReload
    ifTrue: [CljEmitMode.HotReload]
    ifFalse: [CljEmitMode.Program]
  content = backend == "clj" ifTrue: [
    CljBackend fullFromIrModule: irModule debug: false mode: cljMode
  ] ifFalse: [
    TO DO: "incremental backend is not available for " + backend
    ""
  ]
  cljTarget = compilerConfig target == "bb"
    ifTrue: [CljTarget.Bb]
    ifFalse: [CljTarget.Jvm]
  mut output::CljOutput? = null
  backend == "clj" ifTrue: [
    output <- CljBackend fullOutputFromIrModuleForTarget: irModule
      debug: false mode: cljMode target: cljTarget
  ]
  CompilerBackendArtifact
    backend: backend
    target: compilerConfig target
    content: content
    cljOutput: output
]

CompilerSession prepareCandidate(snapshot): WorkspaceSnapshot ir(ir): IrModule specializationUses(candidateSpecializationUses): Map(String, Set(String)) apiHashes(apiHashes): Map(String, String) config(config): CompilerConfigFingerprint -> CompilerCandidate = [
  newDependencies::mut Map(String, IncrementalDependencyTargets) = #{}!
  ir packages forEach: [pkg ->
    newDependencies at: pkg name put: (IncrementalDependencyTargets values: pkg dependencyPackageNames)
  ]
  newReverse = newDependencies incrementalReverseGraph

  newApiHashes = apiHashes

  sourceInvalidated::mut Set(String) = #()!
  interfaceInvalidated::mut Set(String) = #()!
  specializationInvalidated::mut Set(String) = #()!

  compilerConfigMaybe = compilerConfig
  configResolutionChanged = | compilerConfigMaybe
    | null => true
    |=> compilerConfigMaybe resolutionKey != config resolutionKey
  configBackendChanged = | compilerConfigMaybe
    | null => true
    |=> compilerConfigMaybe backendKey != config backendKey

  ir packages forEach: [pkg ->
    sourceMaybe = snapshot sourceFor: pkg name
    sourceHash = | sourceMaybe
      | null => Sha256 digest: ""
      |=> Sha256 digest: sourceMaybe content
    oldState = modules at: pkg name
    | oldState
    | null => [
        sourceInvalidated add: pkg name
        interfaceInvalidated add: pkg name
      ]
    |=> [
      oldState sourceHash != sourceHash ifTrue: [sourceInvalidated add: pkg name]
      currentApiMaybe = newApiHashes at: pkg name
      currentApi = | currentApiMaybe
        | null => [
          TO DO: "Missing API hash for $pkg name"
          ""
        ]
        |=> currentApiMaybe
      oldState apiHash != currentApi ifTrue: [interfaceInvalidated add: pkg name]
    ]
  ]

  modules forEach: [moduleId, old ->
    (newApiHashes at: moduleId) == null ifTrue: [
      sourceInvalidated add: moduleId
      interfaceInvalidated add: moduleId
    ]
  ]

  specializationKeys::mut Set(String) = #()!
  candidateSpecializationUses forEach: [key, contributors -> specializationKeys add: key]
  this specializationUses forEach: [key, contributors -> specializationKeys add: key]
  specializationKeys forEach: [key ->
    oldContributorsMaybe = this specializationUses at: key
    oldContributors::List(String) = | oldContributorsMaybe
      | null => {}
      |=> oldContributorsMaybe toList sortedBy: [it]
    newContributorsMaybe = candidateSpecializationUses at: key
    newContributors::List(String) = | newContributorsMaybe
      | null => {}
      |=> newContributorsMaybe toList sortedBy: [it]
    (oldContributors toString) != (newContributors toString) ifTrue: [
      owner = key substringBefore: "|"
      specializationInvalidated add: owner
    ]
  ]

  allReverse::mut Map(String, IncrementalDependencyTargets) = #{}!
  reverseDependencies forEach: [key, values -> allReverse at: key put: values]
  newReverse forEach: [key, values ->
    combinedMaybe = allReverse at: key
    combined::List(String) =
      | combinedMaybe
      | null => {}
      |=> combinedMaybe values
    allReverse at: key put: (IncrementalDependencyTargets
      values: ((combined + values values) toSet toList sortedBy: [it]))
  ]
  transitive = interfaceInvalidated incrementalTransitiveDependants: allReverse

  bodyInvalidated::mut Set(String) = #()!
  bodyInvalidated addAll: sourceInvalidated
  bodyInvalidated addAll: transitive
  configResolutionChanged ifTrue: [ir packages forEach: [bodyInvalidated add: it name]]

  outputInvalidated::mut Set(String) = #()!
  outputInvalidated addAll: bodyInvalidated
  outputInvalidated addAll: specializationInvalidated
  configBackendChanged ifTrue: [ir packages forEach: [outputInvalidated add: it name]]

  newModules::mut Map(String, IncrementalModuleState) = #{}!
  ir packages forEach: [pkg ->
    sourceMaybe = snapshot sourceFor: pkg name
    sourceHash = | sourceMaybe
      | null => Sha256 digest: ""
      |=> Sha256 digest: sourceMaybe content
    depApi = pkg dependencyPackageNames map: [dep ->
      depApiMaybe = newApiHashes at: dep
      depApiMaybe orElse: "<missing>"
    ], joinWith: "|"
    currentApiMaybe = newApiHashes at: pkg name
    currentApi = | currentApiMaybe
      | null => [
        TO DO: "Missing API hash for $pkg name"
        ""
      ]
      |=> currentApiMaybe
    specializationParts::mut List(String) = {}!
    candidateSpecializationUses forEach: [key, contributors ->
      key startsWith: (pkg name + "|"), ifTrue: [
        specializationParts add: (key + "=" + (contributors toList sortedBy: [it], joinWith: ","))
      ]
    ]
    state = IncrementalModuleState
      moduleId: pkg name
      sourceHash: sourceHash
      apiHash: currentApi
      dependencyApiHash: (Sha256 digest: depApi)
      dependencies: pkg dependencyPackageNames
      specializationHash: (Sha256 digest: (specializationParts sortedBy: [it], joinWith: "|"))
      irPackage: pkg
    oldState = modules at: pkg name
    canReuse = (outputInvalidated contains: pkg name, not) && (oldState != null)
    canReuse
      ifTrue: [
        oldStateMaybe = oldState
        | oldStateMaybe
        | null => [
          TO DO: "Missing prior module state for $pkg name"
          ()
        ]
        |=> newModules at: pkg name put: oldStateMaybe
      ]
      ifFalse: [newModules at: pkg name put: state]
  ]

  mut cljManifestMaybe::CljManifest? = null
  config backend == "clj" ifTrue: [
    cljManifestMaybe <- CljBackend manifestFromIrModule: ir
  ]

  CompilerCandidate
    baseRevision: revision snapshot: snapshot modules: newModules irModule: ir
    dependencies: newDependencies reverseDependencies: newReverse
    specializationUses: candidateSpecializationUses compilerConfig: config
    sourceInvalidated: sourceInvalidated interfaceInvalidated: interfaceInvalidated
    bodyInvalidated: bodyInvalidated outputInvalidated: outputInvalidated
    cljManifest: cljManifestMaybe
]

CompilerSession commit(candidate): CompilerCandidate -> CompilerSession =
  | true
  | candidate baseRevision != revision => this
  |=> CompilerSession
    revision: revision + 1
    committedSnapshot: candidate snapshot
    modules: candidate modules
    entry: candidate irModule entry
    dependencies: candidate dependencies
    reverseDependencies: candidate reverseDependencies
    specializationUses: candidate specializationUses
    compilerConfig: candidate compilerConfig
    cljManifest: candidate cljManifest

type CompilerDiagnostic
  requestVersion: Int
  path: String
  message: String

type CompilerCompilationResult
  requestVersion: Int
  candidate: CompilerCandidate?
  backendArtifact: CompilerBackendArtifact?
  diagnostics: List(CompilerDiagnostic)
  cancelled: Bool

constructor CompilerCompilationResult cancelled(version): Int -> CompilerCompilationResult =
  CompilerCompilationResult requestVersion: version candidate: null backendArtifact: null diagnostics: {} cancelled: true

CompilerCompilationResult commitReady -> Bool =
  (cancelled not) && diagnostics isEmpty && (candidate != null)

CompilerSession compilationFailure(requestVersion): Int diagnostics: List(CompilerDiagnostic) -> CompilerCompilationResult =
  CompilerCompilationResult
    requestVersion: requestVersion candidate: null backendArtifact: null
    diagnostics: diagnostics cancelled: false

CompilerCompilationResult publishCljOutput(root): String withIO(io): IO_Container hotReload(hotReload): Bool -> CljGenerationResult = [
  | true
  | this commitReady not => CljGenerationResult notPublished
  |=> [
    artifactMaybe = backendArtifact
    | artifactMaybe
    | null => [
      TO DO: "Clj compilation result has no backend artifact"
      CljGenerationResult notPublished
    ]
    |=> [
      cljOutputMaybe = artifactMaybe cljOutput
      | cljOutputMaybe
      | null => [
        TO DO: "Clj backend artifact has no output"
        CljGenerationResult notPublished
      ]
      |=> cljOutputMaybe publishTo: root withIO: io hotReload: hotReload
    ]
  ]
]

CompilerSession commitResult(result): CompilerCompilationResult -> CompilerSession =
  | true
  | result commitReady not => this
  |=> [
    candidateMaybe = result candidate
    | candidateMaybe
    | null => [
      TO DO: "Ready compiler result has no candidate"
      this
    ]
    |=> this commit: candidateMaybe
  ]

CompilerSession commitResult(result): CompilerCompilationResult incremental(incremental): Bool -> CompilerSession =
  | true
  | incremental not => CompilerSession empty
  |=> this commitResult: result

CompilerSession prepareCandidate(snapshot): WorkspaceSnapshot resolver(resolver): ResolverHelper config(config): CompilerConfigFingerprint -> CompilerCandidate = [
  ir = resolver toIrModule
  genericFunctionIds = ir functions filter: [it generics isNotEmpty], map: [it id]
  genericUses::mut Map(String, Set(String)) = #{}!
  resolver specializationUses forEach: [key, contributors ->
    isGeneric = genericFunctionIds any: [key contains: ("|" + it + "|")]
    isGeneric ifTrue: [genericUses at: key put: contributors]
  ]
  this prepareCandidate: snapshot ir: ir specializationUses: genericUses
      apiHashes: resolver interfaceApiHashes config: config
]

CompilerSession prepareCandidate(snapshot): WorkspaceSnapshot interfaceSnapshot(interfaceSnapshot): ResolverInterfaceSnapshot bodyResolver(bodyResolver): ResolverHelper bodyModules(bodyModules): Set(String) config(config): CompilerConfigFingerprint -> CompilerCandidate = [
  apiHashes = interfaceSnapshot interfaceApiHashes
  bodyIr = bodyResolver toIrModule

  // Keep the last typed/IR result for modules outside the body frontier.  The
  // new resolver contains only the selected packages, so a changed body
  // cannot accidentally type-check an unchanged dependant.
  merged::mut Map(String, IrPackage) = #{}!
  modules forEach: [moduleId, state -> merged at: moduleId put: state irPackage]
  bodyIr packages forEach: [pkg -> merged at: pkg name put: pkg]

  mergedPackages = merged values toList sortedBy: [it name]
  mergedEntry = (bodyModules contains: interfaceSnapshot entryPointName)
    ifTrue: [bodyIr entry]
    ifFalse: [entry]
  mergedIr = IrModule
    version: bodyIr version
    pkg: interfaceSnapshot entryPointName
    packages: mergedPackages
    entry: mergedEntry

  mergedSpecializationUses::mut Map(String, Set(String)) = #{}!
  specializationUses forEach: [key, contributors ->
    kept::mut Set(String) = #()!
    contributors forEach: [moduleId ->
      bodyModules contains: moduleId, ifFalse: [kept add: moduleId]
    ]
    (kept count > 0) ifTrue: [mergedSpecializationUses at: key put: kept]
  ]
  bodyResolver specializationUses forEach: [key, contributors ->
    existing = mergedSpecializationUses at: key
    | existing
    | null => mergedSpecializationUses at: key put: contributors toSet
    |=> [
      updated::mut Set(String) = existing toMutableSet
      contributors forEach: [it -> updated add: it]
      mergedSpecializationUses at: key put: updated
    ]
  ]

  this prepareCandidate: snapshot ir: mergedIr
      specializationUses: mergedSpecializationUses
      apiHashes: apiHashes config: config
]

CompilerSession prepareCandidate(snapshot): WorkspaceSnapshot interfaceSnapshot(interfaceSnapshot): ResolverInterfaceSnapshot config(config): CompilerConfigFingerprint -> CompilerCandidate = [
  apiHashes = interfaceSnapshot interfaceApiHashes
  bodyModules = this bodyModulesFor: snapshot apiHashes: apiHashes config: config
  bodyResolver = interfaceSnapshot resolveBodiesFor: bodyModules
  this prepareCandidate: snapshot interfaceSnapshot: interfaceSnapshot
      bodyResolver: bodyResolver bodyModules: bodyModules config: config
]

CompilerSession compileCandidate(snapshot): WorkspaceSnapshot interfaceSnapshot(interfaceSnapshot): ResolverInterfaceSnapshot config(config): CompilerConfigFingerprint requestVersion(requestVersion): Int cancelled(cancelled): Bool -> CompilerCompilationResult = [
  | true
  | cancelled => CompilerCompilationResult cancelled: requestVersion
  |=> [
    apiHashes = interfaceSnapshot interfaceApiHashes
    bodyModules = this bodyModulesFor: snapshot apiHashes: apiHashes config: config
    bodyResolver = interfaceSnapshot resolveBodiesFor: bodyModules

    diagnostics::mut List(CompilerDiagnostic) = {}!
    // A working TyperDB starts with the declaration-pass errors, so reading it
    // once avoids publishing duplicate diagnostics for the same source token.
    bodyResolver db listOfErrors forEach: [error ->
      diagnostics add: (CompilerDiagnostic requestVersion: requestVersion
        path: error tok file path message: error toConsoleMsg)
    ]
    diagnostics isEmpty ifFalse: [
      this compilationFailure: requestVersion diagnostics: diagnostics toList
    ] ifTrue: [
      candidate = this prepareCandidate: snapshot interfaceSnapshot: interfaceSnapshot
        bodyResolver: bodyResolver bodyModules: bodyModules config: config
      artifact = candidate emitBackend
      currentManifestMaybe = candidate cljManifest
      previousManifestMaybe = cljManifest
      shapeChanges::mut List(String) = {}!
      config backend == "clj" ifTrue: [
        currentManifestMaybe ifNotNull: [currentManifestValue ->
          | previousManifestMaybe
          | null => []
          |=> [
            shapeChanges addAll: (currentManifestValue incompatibleChanges: previousManifestMaybe)
            ()
          ]
        ]
      ]
      shapeChanges forEach: [change ->
        diagnostics add: (CompilerDiagnostic requestVersion: requestVersion
          path: snapshot entryPoint + ".niva"
          message: "hard restart required: " + change +
            "; automatic state migration is not supported")
      ]
      diagnostics isEmpty ifFalse: [
        this compilationFailure: requestVersion diagnostics: diagnostics toList
      ] ifTrue: [
        CompilerCompilationResult requestVersion: requestVersion candidate: candidate
          backendArtifact: artifact diagnostics: {} cancelled: false
      ]
    ]
  ]
]

// entry point for watch and lsp clients
CompilerSession compileSnapshot(snapshot): WorkspaceSnapshot config(config): CompilerConfigFingerprint
    requestVersion(requestVersion): Int cancelled(cancelled): Bool -> CompilerCompilationResult = [
  | true
  | cancelled => CompilerCompilationResult cancelled: requestVersion
  |=> [
    interfaceSnapshot = ResolverInterfaceSnapshot
      collectSources: snapshot sources entryPoint: snapshot entryPoint backend: config backend
    this compileCandidate: snapshot interfaceSnapshot: interfaceSnapshot
      config: config requestVersion: requestVersion cancelled: false
  ]
]

// shared routing point for future watch and lsp adapters
CompilerSession compileSnapshot(snapshot): WorkspaceSnapshot config(config): CompilerConfigFingerprint
    requestVersion(requestVersion): Int cancelled(cancelled): Bool incremental(incremental): Bool -> CompilerCompilationResult = [
  activeSession = incremental ifTrue: [this] ifFalse: [CompilerSession empty]
  activeSession compileSnapshot: snapshot config: config
    requestVersion: requestVersion cancelled: cancelled
]
